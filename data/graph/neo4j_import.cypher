 thông tin được ';
MERGE (n:Disease {id: 'D2727'}) SET n.id = 'D2727', n.name = 'Nhỏ so với tuổi thai (SGA)', n.name_en = 'Small for gestational age (SGA)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002302.htm', n.overview = 'Siêu âm được sử dụng để tìm hiểu xem thai nhi có nhỏ hơn bình thường so với tuổi của chúng hay không. Tình trạng này được gọi là hạn chế tăng trưởng trong tử cung. Định nghĩa phổ biến nhất về tình trạ';
MERGE (n:Disease {id: 'D2728'}) SET n.id = 'D2728', n.name = 'Sự phát triển quá mức của vi khuẩn đường ruột nhỏ (SIBO)', n.name_en = 'Small intestinal bacterial overgrowth (SIBO)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/small-intestinal-bacterial-overgrowth/symptoms-causes/syc-20370168', n.overview = 'xảy ra khi có sự gia tăng bất thường về tổng thể vi khuẩn trong ruột non - đặc biệt là các loại vi khuẩn không thường thấy ở phần đó của đường tiêu hóa. Tình trạng này đôi khi được gọi là hội chứng vò', n.when_to_see = 'Đầy hơi, buồn nôn và tiêu chảy là dấu hiệu và triệu chứng của nhiều vấn đề về đường ruột. Hãy đến gặp bác sĩ để được đánh giá đầy đủ - đặc biệt nếu bạn đã phẫu thuật vùng bụng - nếu bạn bị: Tiêu chảy ';
MERGE (n:Disease {id: 'D2729'}) SET n.id = 'D2729', n.name = 'Thiếu máu cục bộ và nhồi máu ruột non', n.name_en = 'Small intestinal ischemia and infarction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001151.htm', n.prognosis = 'Tổn thương hoặc chết mô ruột là một tình trạng nghiêm trọng. Điều này có thể dẫn đến tử vong nếu không được điều trị ngay lập tức. Triển vọng phụ thuộc vào nguyên nhân. Điều trị kịp thời có thể dẫn đế', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị đau bụng dữ dội.';
MERGE (n:Disease {id: 'D2730'}) SET n.id = 'D2730', n.name = 'U lympho tế bào lympho nhỏ', n.name_en = 'Small lymphocytic lymphoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/small-lymphocytic-lymphoma/symptoms-causes/syc-20590910', n.overview = '(SLL) là một loại ung thư hạch. Ung thư hạch là bệnh ung thư ảnh hưởng đến hệ bạch huyết. Hệ bạch huyết được tạo thành từ các cơ quan, tuyến, mạch dạng ống và cụm tế bào gọi là hạch bạch huyết. Nó là ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2731'}) SET n.id = 'D2731', n.name = 'Bệnh mạch máu nhỏ', n.name_en = 'Small vessel disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/small-vessel-disease/symptoms-causes/syc-20352117', n.overview = 'là tình trạng thành của các động mạch nhỏ trong tim không hoạt động bình thường. Điều này làm giảm lưu lượng máu giàu oxy đến tim, gây đau ngực (đau thắt ngực), khó thở và các dấu hiệu và triệu chứng ', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế khẩn cấp nếu bạn bị đau ngực và các dấu hiệu, triệu chứng khác như khó thở, đổ mồ hôi, buồn nôn, chóng mặt hoặc đau lan ra ngoài ngực đến một hoặc cả hai cánh tay hoặc đế';
MERGE (n:Disease {id: 'D2732'}) SET n.id = 'D2732', n.name = 'Bệnh đậu mùa', n.name_en = 'Smallpox', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/smallpox/symptoms-causes/syc-20353027 | https://medlineplus.gov/ency/article/001356.htm', n.overview = 'là một bệnh nhiễm virus nghiêm trọng và thường gây tử vong. Nó dễ lây lan, có nghĩa là nó lây lan từ người này sang người khác. Nó có thể để lại sẹo suốt đời và ảnh hưởng đến ngoại hình. Bệnh đậu mùa ', n.prognosis = 'Ngày xưa đây là một căn bệnh nặng. Nguy cơ tử vong cao tới 30%.', n.when_to_see = 'Nếu bạn cho rằng mình có thể đã tiếp xúc với bệnh đậu mùa, hãy liên hệ ngay với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Việc tiếp xúc với vi-rút rất khó xảy ra trừ khi bạn đã làm việc với vi-r';
MERGE (n:Disease {id: 'D2733'}) SET n.id = 'D2733', n.name = 'Vắc xin đậu mùa/đậu khỉ (JYNNEOS) - những điều bạn cần biết', n.name_en = 'Smallpox/monkeypox vaccine (JYNNEOS) - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007786.htm', n.overview = 'Tại sao phải tiêm vắc xin? Vắc-xin bệnh đậu mùa/thủy đậu khỉ (JYNNEOSTM) có thể giúp bảo vệ chống lại bệnh đậu mùa, bệnh đậu mùa và các bệnh khác do orthopoxvirus gây ra, bao gồm cả vi-rút vaccinia. B';
MERGE (n:Disease {id: 'D2734'}) SET n.id = 'D2734', n.name = 'Ngón tay bị đập vỡ', n.name_en = 'Smashed fingers', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000018.htm', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế ngay lập tức nếu có bất kỳ trường hợp nào sau đây: Ngón tay bị cong và bạn không thể duỗi thẳng. Da bị cắt ra và xương lộ ra. Bạn không thể di chuyển hoặc cảm nhận được đ';
MERGE (n:Disease {id: 'D2735'}) SET n.id = 'D2735', n.name = 'Suy giảm khứu giác', n.name_en = 'Smell - impaired', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003052.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Tình trạng mất khứu giác vẫn tiếp tục hoặc ngày càng trầm trọng hơn. Bạn có các triệu chứng khác không giải thích được.';
MERGE (n:Disease {id: 'D2736'}) SET n.id = 'D2736', n.name = 'Thuốc cai thuốc lá', n.name_en = 'Smoking cessation medications', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007439.htm', n.overview = 'Thuốc cai thuốc lá có thể giúp: Giảm cảm giác thèm thuốc lá Giảm các triệu chứng cai thuốc Giúp bạn không bắt đầu sử dụng lại thuốc lá Giống như các phương pháp điều trị khác, những loại thuốc này hoạ';
MERGE (n:Disease {id: 'D2737'}) SET n.id = 'D2737', n.name = 'Rắn cắn', n.name_en = 'Snake bites', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000031.htm', n.when_to_see = 'Hãy gọi 911 hoặc số điện thoại khẩn cấp tại địa phương nếu có người bị rắn cắn. Nếu có thể, hãy gọi trước đến phòng cấp cứu để chuẩn bị sẵn thuốc kháng nọc độc khi người đó đến. Bạn có thể liên hệ trự';
MERGE (n:Disease {id: 'D2738'}) SET n.id = 'D2738', n.name = 'Hắt hơi', n.name_en = 'Sneezing', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003060.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu hắt hơi ảnh hưởng đến cuộc sống của bạn và các biện pháp khắc phục tại nhà không có tác dụng. Đồng thời liên hệ với nhà cung cấp dịch';
MERGE (n:Disease {id: 'D2739'}) SET n.id = 'D2739', n.name = 'Ngáy', n.name_en = 'Snoring', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/snoring/symptoms-causes/syc-20377694', n.overview = 'là âm thanh khàn hoặc chói tai xảy ra khi không khí đi qua các mô thư giãn trong cổ họng của bạn, khiến các mô rung lên khi bạn thở. Gần như tất cả mọi người thỉnh thoảng đều ngáy, nhưng đối với một s', n.when_to_see = 'Hãy đi khám bác sĩ nếu bạn có bất kỳ triệu chứng nào ở trên. Những điều này có thể cho thấy chứng ngáy của bạn có liên quan đến chứng ngưng thở khi ngủ do tắc nghẽn (OSA). Nếu con bạn ngáy, hãy hỏi bá';
MERGE (n:Disease {id: 'D2740'}) SET n.id = 'D2740', n.name = 'Rối loạn lo âu xã hội', n.name_en = 'Social anxiety disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000957.htm', n.prognosis = 'Kết quả điều trị thường tốt. Thuốc chống trầm cảm cũng có thể có hiệu quả.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu nỗi sợ hãi đang ảnh hưởng đến công việc và mối quan hệ của bạn với người khác.';
MERGE (n:Disease {id: 'D2741'}) SET n.id = 'D2741', n.name = 'Rối loạn lo âu xã hội (ám ảnh xã hội)', n.name_en = 'Social anxiety disorder (social phobia)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/social-anxiety-disorder/symptoms-causes/syc-20353561', n.overview = 'Việc cảm thấy lo lắng trong một số tình huống xã hội là điều bình thường. Ví dụ, đi hẹn hò hoặc thuyết trình có thể gây ra cảm giác bồn chồn trong bụng. Nhưng trong chứng rối loạn lo âu xã hội, còn gọ', n.when_to_see = 'Hãy gặp bác sĩ hoặc chuyên gia sức khỏe tâm thần nếu bạn sợ hãi và tránh né các tình huống xã hội thông thường vì chúng gây bối rối, lo lắng hoặc hoảng sợ. Yêu cầu một cuộc hẹn Có vấn đề với
 thông ti';
MERGE (n:Disease {id: 'D2742'}) SET n.id = 'D2742', n.name = 'Ngộ độc natri bisulfate', n.name_en = 'Sodium bisulfate poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002548.htm', n.prognosis = 'Tình trạng của một người tốt như thế nào phụ thuộc vào tốc độ pha loãng và trung hòa natri bisulfate. Có cơ hội phục hồi tốt nếu được điều trị thích hợp ngay sau khi nuốt phải chất độc. Nếu không được';
MERGE (n:Disease {id: 'D2743'}) SET n.id = 'D2743', n.name = 'Ngộ độc natri cacbonat', n.name_en = 'Sodium carbonate poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002486.htm', n.prognosis = 'Natri cacbonat thường không độc lắm khi dùng với số lượng nhỏ. Tuy nhiên, nếu nuốt một lượng lớn, bạn có thể có các triệu chứng. Trong tình huống hiếm gặp này, những ảnh hưởng lâu dài, thậm chí tử von';
MERGE (n:Disease {id: 'D2744'}) SET n.id = 'D2744', n.name = 'Ngộ độc natri hydroxit', n.name_en = 'Sodium hydroxide poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002487.htm', n.prognosis = 'Sức khỏe của một người tốt như thế nào phụ thuộc vào tốc độ pha loãng và trung hòa chất độc. Có thể bị tổn thương nặng ở miệng, cổ họng, mắt, phổi, thực quản, mũi và dạ dày. Kết quả lâu dài phụ thuộc ';
MERGE (n:Disease {id: 'D2745'}) SET n.id = 'D2745', n.name = 'Ngộ độc natri hypochlorite', n.name_en = 'Sodium hypochlorite poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002488.htm', n.prognosis = 'Nuốt, ngửi hoặc chạm vào một lượng nhỏ thuốc tẩy gia dụng có thể sẽ không gây ra bất kỳ vấn đề đáng kể nào. Tuy nhiên, các vấn đề nghiêm trọng hơn có thể xảy ra với thuốc tẩy công nghiệp hoặc do trộn ';
MERGE (n:Disease {id: 'D2746'}) SET n.id = 'D2746', n.name = 'Ung thư vòm miệng mềm', n.name_en = 'Soft palate cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/soft-palate-cancer/symptoms-causes/syc-20354183', n.overview = 'Vòm miệng mềm ở phía sau răng. Ung thư vòm miệng mềm là bệnh ung thư bắt đầu từ sự phát triển của các tế bào trên vòm miệng mềm. Vòm miệng mềm nằm ở phần trên của miệng, phía sau răng. Ung thư vòm miệ', n.when_to_see = 'Hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thô';
MERGE (n:Disease {id: 'D2747'}) SET n.id = 'D2747', n.name = 'Sarcoma mô mềm', n.name_en = 'Soft tissue sarcoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/soft-tissue-sarcoma/symptoms-causes/syc-20377725', n.overview = 'là nghệ thuật trong các mô mềm của cơ thể. Hình minh họa này cho thấy sarcoma mô mềm của cơ đùi ngay phía trên đầu gối. Sarcoma mô mềm là một loại ung thư hiếm gặp bắt đầu từ sự phát triển của các tế ', n.when_to_see = 'Hãy hẹn gặp nhóm chăm sóc sức khỏe của bạn nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin được';
MERGE (n:Disease {id: 'D2748'}) SET n.id = 'D2748', n.name = 'Ngộ độc chất hàn', n.name_en = 'Solder poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002822.htm', n.prognosis = 'Sức khỏe của người đó phụ thuộc vào lượng chất độc nuốt phải và việc điều trị được thực hiện nhanh chóng như thế nào. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Kết quả phụ thuộc vào lo';
MERGE (n:Disease {id: 'D2749'}) SET n.id = 'D2749', n.name = 'Khối u sợi đơn độc', n.name_en = 'Solitary fibrous tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000116.htm', n.prognosis = 'Kết quả dự kiến ​​sẽ tốt nếu được điều trị kịp thời. Trong một số ít trường hợp, khối u có thể quay trở lại.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn để lấy hẹn nếu bạn nhận thấy các triệu chứng của SFT.';
MERGE (n:Disease {id: 'D2750'}) SET n.id = 'D2750', n.name = 'Nốt phổi đơn độc', n.name_en = 'Solitary pulmonary nodule', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000071.htm', n.prognosis = 'Triển vọng thường tốt nếu nốt sần lành tính. Nếu nốt sần không phát triển lớn hơn trong khoảng thời gian 2 năm thì thường không cần phải làm gì thêm.';
MERGE (n:Disease {id: 'D2751'}) SET n.id = 'D2751', n.name = 'Hội chứng loét trực tràng đơn độc', n.name_en = 'Solitary rectal ulcer syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/rectal-ulcer/symptoms-causes/syc-20377749', n.overview = 'là tình trạng một hoặc nhiều vết loét hở, được gọi là loét, hình thành ở trực tràng. Trực tràng là một ống cơ nối với phần cuối của đại tràng. Phân đi qua trực tràng trên đường ra khỏi cơ thể. Hội chứ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn nhận thấy bất kỳ triệu chứng nào khiến bạn lo lắng. Một số tình trạng khác có thể gây ra các triệu chứng tương tự như hội chứng loét trực tràng đơn độc';
MERGE (n:Disease {id: 'D2752'}) SET n.id = 'D2752', n.name = 'Rối loạn triệu chứng cơ thể', n.name_en = 'Somatic symptom disorder', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/somatic-symptom-disorder/symptoms-causes/syc-20377776 | https://medlineplus.gov/ency/article/000955.htm', n.overview = 'liên quan đến việc tập trung quá nhiều vào các triệu chứng thực thể như đau đớn hoặc mệt mỏi. Sự tập trung này gây ra đau khổ lớn về mặt cảm xúc và khiến nó khó hoạt động. Bạn có thể có hoặc không có ', n.when_to_see = 'Bạn nên liên hệ với nhà cung cấp dịch vụ của mình nếu bạn: Cảm thấy lo lắng về các triệu chứng thể chất đến mức bạn không thể hoạt động Có các triệu chứng lo âu hoặc trầm cảm Nếu bạn hoặc ai đó bạn bi';
MERGE (n:Disease {id: 'D2753'}) SET n.id = 'D2753', n.name = 'Đau họng', n.name_en = 'Sore throat', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sore-throat/symptoms-causes/syc-20351635', n.overview = 'Đau họng là tình trạng đau hoặc rát ở cổ họng. Nuốt thường làm cho cảm giác tồi tệ hơn. Nguyên nhân phổ biến nhất gây đau họng, còn gọi là viêm họng, là do nhiễm virus, chẳng hạn như cảm lạnh hoặc cúm', n.when_to_see = 'Hãy đưa con bạn đến gặp chuyên gia chăm sóc sức khỏe nếu cơn đau họng không biến mất sau khi uống nước vào buổi sáng. Lời khuyên này là của Học viện Nhi khoa Hoa Kỳ. Hãy chăm sóc ngay lập tức cho trẻ ';
MERGE (n:Disease {id: 'D2754'}) SET n.id = 'D2754', n.name = 'Chứng khó phát âm co thắt', n.name_en = 'Spasmodic dysphonia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000753.htm', n.prognosis = 'Chứng khó phát âm co thắt là một tình trạng suốt đời (mãn tính). Việc điều trị có thể làm giảm các triệu chứng của bạn nhưng tác dụng thường chỉ là tạm thời.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy những thay đổi trong giọng nói của mình tái diễn.';
MERGE (n:Disease {id: 'D2755'}) SET n.id = 'D2755', n.name = 'Co thắt hạt', n.name_en = 'Spasmus nutans', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001409.htm', n.prognosis = 'Thông thường, chứng rối loạn này sẽ tự khỏi trong vòng 1 đến 2 năm mà không cần điều trị. Một số trẻ có các triệu chứng còn sót lại ở mắt cần được chăm sóc theo dõi.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu con bạn có cử động mắt nhanh hoặc gật đầu nhanh. Nhà cung cấp của bạn sẽ cần thực hiện một cuộc kiểm tra để kiểm tra các nguyên n';
MERGE (n:Disease {id: 'D2756'}) SET n.id = 'D2756', n.name = 'Co cứng', n.name_en = 'Spasticity', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003297.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Tình trạng co cứng trở nên trầm trọng hơn Bạn nhận thấy các vùng bị ảnh hưởng bị biến dạng';
MERGE (n:Disease {id: 'D2757'}) SET n.id = 'D2757', n.name = 'Nỗi ám ảnh cụ thể', n.name_en = 'Specific phobias', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/specific-phobias/symptoms-causes/syc-20355156', n.overview = 'là nỗi sợ hãi tột độ đối với các đồ vật hoặc tình huống ít hoặc không gây nguy hiểm nhưng khiến bạn vô cùng lo lắng. Vì thế bạn hãy cố gắng tránh xa những điều này. Không giống như sự lo lắng ngắn ngủ';
MERGE (n:Disease {id: 'D2758'}) SET n.id = 'D2758', n.name = 'Rối loạn ngôn ngữ - trẻ em', n.name_en = 'Speech disorders - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001430.htm', n.prognosis = 'Triển vọng phụ thuộc vào nguyên nhân gây ra rối loạn. Lời nói thường có thể được cải thiện bằng liệu pháp ngôn ngữ. Điều trị sớm có thể sẽ có kết quả tốt hơn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Khả năng nói của con bạn không phát triển theo các mốc bình thường. Bạn cho rằng con bạn thuộc nhóm có nguy cơ cao. Con bạn đang có dấu hiệu rối loạn ngôn ngữ';
MERGE (n:Disease {id: 'D2759'}) SET n.id = 'D2759', n.name = 'Suy giảm khả năng nói ở người lớn', n.name_en = 'Speech impairment in adults', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003204.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Suy giảm hoặc mất khả năng giao tiếp xảy ra đột ngột Có bất kỳ sự suy giảm khả năng nói hoặc ngôn ngữ viết nào không giải thích được';
MERGE (n:Disease {id: 'D2760'}) SET n.id = 'D2760', n.name = 'Spermatocele', n.name_en = 'Spermatocele', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/spermatocele/symptoms-causes/syc-20377829', n.overview = 'Spermatocele (SPUR-muh-toe-seel) là một túi (u nang) bất thường phát triển trong mào tinh hoàn - ống nhỏ, cuộn nằm ở tinh hoàn trên để thu thập và vận chuyển tinh trùng. Không gây ung thư và thường kh', n.when_to_see = 'Vì sa tinh trùng thường không gây ra triệu chứng nên bạn chỉ có thể phát hiện ra nó khi tự kiểm tra tinh hoàn hoặc bác sĩ có thể phát hiện ra nó khi khám sức khỏe định kỳ. Bạn nên nhờ bác sĩ đánh giá ';
MERGE (n:Disease {id: 'D2761'}) SET n.id = 'D2761', n.name = 'U mạch máu hình nhện', n.name_en = 'Spider angioma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001095.htm', n.prognosis = 'U mạch mạng nhện ở trẻ em có thể biến mất sau tuổi dậy thì và thường biến mất sau khi phụ nữ sinh con. Nếu không được điều trị, u mạch hình nhện có xu hướng kéo dài ở người lớn. Điều trị thường thành ', n.when_to_see = 'Hãy cho nhà cung cấp dịch vụ của bạn biết nếu bạn có u mạch máu hình nhện mới để họ có thể kiểm tra các tình trạng bệnh lý liên quan khác.';
MERGE (n:Disease {id: 'D2762'}) SET n.id = 'D2762', n.name = 'Vết cắn của nhện', n.name_en = 'Spider bites', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/spider-bites/symptoms-causes/syc-20352371', n.overview = 'thường vô hại và nhện thường không cắn trừ khi bị đe dọa. Vết cắn của nhện có thể gây mẩn đỏ, đau và sưng tấy hoặc bạn có thể không nhận thấy chúng. Nhiều vết côn trùng cắn và lở loét trên da gây tấy ', n.when_to_see = 'Tìm kiếm sự chăm sóc y tế ngay lập tức nếu: Bạn bị cắn bởi một con nhện nguy hiểm, chẳng hạn như góa phụ hoặc người ẩn dật. Bạn không chắc liệu vết cắn có phải là của một con nhện nguy hiểm hay không.';
MERGE (n:Disease {id: 'D2763'}) SET n.id = 'D2763', n.name = 'Spina bifida', n.name_en = 'Spina bifida', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/spina-bifida/symptoms-causes/syc-20377860', n.overview = 'là tình trạng xảy ra khi cột sống và tủy sống không hình thành đúng cách. Đó là một loại khuyết tật ống thần kinh. Ống thần kinh là cấu trúc trong phôi đang phát triển mà sau này trở thành não, tủy số', n.when_to_see = 'Thông thường, thoát vị tủy màng não được chẩn đoán trước hoặc ngay sau khi sinh, khi có dịch vụ chăm sóc y tế. Trẻ em được chẩn đoán mắc bệnh này phải được theo dõi bởi một đội ngũ chuyên gia chăm sóc';
MERGE (n:Disease {id: 'D2764'}) SET n.id = 'D2764', n.name = 'Gây tê ngoài màng cứng và gây tê ngoài màng cứng', n.name_en = 'Spinal and epidural anesthesia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007413.htm', n.overview = 'Nhà cung cấp dịch vụ chăm sóc sức khỏe thực hiện gây tê ngoài màng cứng hoặc gây tê tủy sống cho bạn được gọi là bác sĩ gây mê. Trong một số trường hợp, việc này có thể được thực hiện bởi y tá gây mê ', n.prognosis = 'Hầu hết mọi người không cảm thấy đau khi gây tê tủy sống và ngoài màng cứng và hồi phục hoàn toàn.';
MERGE (n:Disease {id: 'D2765'}) SET n.id = 'D2765', n.name = 'Dị tật động tĩnh mạch cột sống (AVM)', n.name_en = 'Spinal arteriovenous malformation (AVM)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/spinal-arteriovenous-malformation/symptoms-causes/syc-20355613', n.overview = 'Dị tật động tĩnh mạch cột sống (AVM) là tình trạng rối loạn các mạch máu trên, trong hoặc gần tủy sống. Dị tật động tĩnh mạch cột sống (AVM) là tình trạng rối loạn các mạch máu hình thành trên, trong ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn gặp các triệu chứng của AVM cột sống. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2766'}) SET n.id = 'D2766', n.name = 'Áp xe tủy sống', n.name_en = 'Spinal cord abscess', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001405.htm', n.prognosis = 'Mức độ khỏe mạnh của một người sau khi điều trị là khác nhau. Một số người hồi phục hoàn toàn. Áp xe tủy sống không được điều trị có thể dẫn đến chèn ép tủy sống. Nó có thể gây tê liệt vĩnh viễn, nghi', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn có triệu chứng áp xe tủy sống.';
MERGE (n:Disease {id: 'D2767'}) SET n.id = 'D2767', n.name = 'Chấn thương tủy sống', n.name_en = 'Spinal cord injury', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/spinal-cord-injury/symptoms-causes/syc-20377890', n.overview = 'Chấn thương tủy sống liên quan đến tổn thương ở bất kỳ bộ phận nào của tủy sống. Nó cũng có thể bao gồm tổn thương dây thần kinh ở cuối tủy sống, được gọi là đuôi ngựa. Tủy sống gửi và nhận tín hiệu g', n.when_to_see = 'Bất kỳ ai bị thương ở đầu hoặc cổ đều cần được đánh giá y tế ngay lập tức. An toàn nhất là cho rằng người đó bị chấn thương cột sống cho đến khi được chứng minh ngược lại. Điều này quan trọng vì: Chấn';
MERGE (n:Disease {id: 'D2768'}) SET n.id = 'D2768', n.name = 'Kích thích tủy sống', n.name_en = 'Spinal cord stimulation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007560.htm', n.overview = 'Một điện cực thử nghiệm sẽ được đặt vào vị trí trước tiên để xem liệu nó có giúp giảm đau cho bạn hay không. Da của bạn sẽ được gây tê cục bộ. Dây điện (dây dẫn) sẽ được đặt dưới da của bạn và kéo dài', n.prognosis = 'Sau khi thực hiện thủ thuật, bạn có thể bớt đau lưng hơn và không cần dùng nhiều thuốc giảm đau. Tuy nhiên, việc điều trị không chữa khỏi cơn đau lưng hoặc điều trị nguyên nhân gây đau. Chất kích thíc';
MERGE (n:Disease {id: 'D2769'}) SET n.id = 'D2769', n.name = 'Khối u tủy sống', n.name_en = 'Spinal cord tumor', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/spinal-cord-tumor/symptoms-causes/syc-20350103', n.overview = 't hình thành trong hoặc xung quanh tủy sống. Khối u tủy sống là sự phát triển của các tế bào hình thành trong hoặc xung quanh tủy sống. Tủy sống kéo dài xuống từ đáy não. Nó được tạo thành từ các tế b', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
';
MERGE (n:Disease {id: 'D2770'}) SET n.id = 'D2770', n.name = 'Hợp nhất cột sống', n.name_en = 'Spinal fusion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002968.htm', n.overview = 'Bạn sẽ được gây mê toàn thân, đưa bạn vào giấc ngủ sâu để không cảm thấy đau khi phẫu thuật. Bác sĩ phẫu thuật sẽ thực hiện một vết cắt phẫu thuật (vết mổ) để xem cột sống. Các cuộc phẫu thuật khác, c', n.prognosis = 'Phẫu thuật không phải lúc nào cũng cải thiện cơn đau và trong một số trường hợp, có thể khiến tình trạng trở nên tồi tệ hơn. Tuy nhiên, ở một số người, phẫu thuật có thể có hiệu quả đối với những cơn ';
MERGE (n:Disease {id: 'D2771'}) SET n.id = 'D2771', n.name = 'Đau đầu cột sống', n.name_en = 'Spinal headaches', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/spinal-headaches/symptoms-causes/syc-20377913', n.overview = 'là một biến chứng khá phổ biến ở những người trải qua phẫu thuật chọc dò tủy sống (thủng tủy sống) hoặc gây tê tủy sống. Cả hai thủ tục đều yêu cầu chọc thủng màng bao quanh tủy sống và ở phần dưới cộ', n.when_to_see = 'Hãy cho nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn biết nếu bạn bị đau đầu sau khi gây tê tủy sống hoặc gây tê tủy sống - đặc biệt nếu cơn đau đầu trở nên tồi tệ hơn khi bạn ngồi dậy hoặc đứng.';
MERGE (n:Disease {id: 'D2772'}) SET n.id = 'D2772', n.name = 'Chấn thương cột sống', n.name_en = 'Spinal injury', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000029.htm', n.when_to_see = 'Hãy gọi số khẩn cấp tại địa phương (chẳng hạn như 911) nếu bạn cho rằng ai đó bị chấn thương tủy sống. Không di chuyển người đó trừ khi có nguy hiểm khẩn cấp.';
MERGE (n:Disease {id: 'D2773'}) SET n.id = 'D2773', n.name = 'Teo cơ cột sống', n.name_en = 'Spinal muscular atrophy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000996.htm', n.prognosis = 'Nếu không điều trị, trẻ mắc SMA loại I hiếm khi sống được quá 2 đến 3 năm vì các vấn đề về hô hấp và nhiễm trùng. Thời gian sống sót của bệnh loại II dài hơn nhưng căn bệnh này giết chết hầu hết những', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn: Có vẻ yếu Có bất kỳ triệu chứng nào khác của bệnh SMA Khó ăn Khó thở có thể nhanh chóng trở thành một tình trạng khẩn cấp.';
MERGE (n:Disease {id: 'D2774'}) SET n.id = 'D2774', n.name = 'Hẹp cột sống', n.name_en = 'Spinal stenosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/spinal-stenosis/symptoms-causes/syc-20352961 | https://medlineplus.gov/ency/article/000441.htm', n.overview = 'xảy ra khi không gian bên trong xương sống quá nhỏ. Điều này có thể gây áp lực lên tủy sống và các dây thần kinh đi qua cột sống. Hẹp cột sống xảy ra thường xuyên nhất ở vùng lưng dưới và cổ. Một số n', n.prognosis = 'Nhiều người bị hẹp cột sống vẫn có thể hoạt động tích cực với tình trạng này, mặc dù họ có thể cần thực hiện một số thay đổi trong hoạt động hoặc công việc của mình. Phẫu thuật cột sống thường sẽ làm ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng hẹp ống sống. Các triệu chứng nghiêm trọng hơn cần được chú ý kịp thời bao gồm: Khó khăn hoặc mất thăng bằng khi đi lại Tê và yế';
MERGE (n:Disease {id: 'D2775'}) SET n.id = 'D2775', n.name = 'Khối u cột sống', n.name_en = 'Spinal tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001403.htm', n.prognosis = 'Kết quả khác nhau tùy thuộc vào khối u. Chẩn đoán và điều trị sớm thường dẫn đến kết quả tốt hơn. Tổn thương thần kinh thường tiếp tục xảy ra, ngay cả sau khi phẫu thuật. Mặc dù có khả năng xảy ra một', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có tiền sử bệnh ung thư và bị đau lưng dữ dội đột ngột hoặc trở nên trầm trọng hơn. Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phươ';
MERGE (n:Disease {id: 'D2776'}) SET n.id = 'D2776', n.name = 'Khối u cột sống và khối cột sống', n.name_en = 'Spinal tumor and spinal mass', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/spinal-tumor/symptoms-causes/syc-20591793', n.overview = 'Khối u cột sống là sự phát triển bắt đầu trong hoặc xung quanh cột sống, bao gồm cột sống, tủy sống và dây thần kinh. Những khối u này chỉ chiếm 2% đến 4% tổng số khối u nguyên phát của hệ thần kinh t';
MERGE (n:Disease {id: 'D2777'}) SET n.id = 'D2777', n.name = 'Cắt bỏ lá lách', n.name_en = 'Spleen removal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002944.htm', n.overview = 'Lá lách được cắt bỏ trong khi bạn đang được gây mê toàn thân (ngủ và không đau). Bác sĩ phẫu thuật của bạn có thể thực hiện phẫu thuật cắt lách mở, cắt lách nội soi hoặc cắt lách bằng robot. Trong quá', n.prognosis = 'Kết quả của cuộc phẫu thuật này phụ thuộc vào bệnh tật hoặc thương tích mà bạn hoặc con bạn mắc phải. Những người không có vết thương nghiêm trọng hoặc các vấn đề y tế khác thường hồi phục sau cuộc ph';
MERGE (n:Disease {id: 'D2778'}) SET n.id = 'D2778', n.name = 'Nhồi máu lách', n.name_en = 'Splenic infarction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001293.htm';
MERGE (n:Disease {id: 'D2779'}) SET n.id = 'D2779', n.name = 'Lách to', n.name_en = 'Splenomegaly', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003276.htm', n.when_to_see = 'Lá lách to thường không có triệu chứng. Tìm kiếm sự trợ giúp y tế ngay lập tức nếu cơn đau bụng dữ dội hoặc trở nên tồi tệ hơn khi bạn hít một hơi thật sâu.';
MERGE (n:Disease {id: 'D2780'}) SET n.id = 'D2780', n.name = 'Xuất huyết dưới mảnh vụn', n.name_en = 'Splinter hemorrhages', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003283.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy xuất huyết dưới mảnh vụn và gần đây bạn không có bất kỳ vết thương nào ở móng. Xuất huyết mảnh thường xuất hiện muộn tr';
MERGE (n:Disease {id: 'D2781'}) SET n.id = 'D2781', n.name = 'Loại bỏ dằm', n.name_en = 'Splinter removal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002137.htm', n.overview = 'Để loại bỏ dằm, trước tiên hãy rửa tay bằng xà phòng và nước. Dùng nhíp để lấy dằm. Cẩn thận kéo nó ra theo đúng góc mà nó đã đâm vào. Nếu chiếc dằm nằm dưới da hoặc khó lấy: Khử trùng ghim hoặc kim b';
MERGE (n:Disease {id: 'D2782'}) SET n.id = 'D2782', n.name = 'Trượt đốt sống', n.name_en = 'Spondylolisthesis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001260.htm', n.prognosis = 'Các bài tập và thay đổi trong hoạt động rất hữu ích cho hầu hết những người bị trượt đốt sống nhẹ.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Lưng của bạn có vẻ bị cong nghiêm trọng Bạn bị đau lưng hoặc cứng khớp không biến mất Bạn bị đau ở đùi và mông không biến mất Bạn bị tê và yếu ở chân ';
MERGE (n:Disease {id: 'D2783'}) SET n.id = 'D2783', n.name = 'Bóc tách động mạch vành tự phát (SCAD)', n.name_en = 'Spontaneous coronary artery dissection (SCAD)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/spontaneous-coronary-artery-dissection/symptoms-causes/syc-20353711', n.overview = 'Bóc tách động mạch vành tự phát là một tình trạng cấp cứu. Nó xảy ra khi một vết rách hình thành trên thành động mạch tim. Tình trạng này còn được gọi là SCAD. SCAD có thể làm chậm hoặc chặn lưu lượng', n.when_to_see = 'Hãy gọi 911 hoặc số điện thoại cấp cứu tại địa phương nếu bạn bị đau ngực hoặc nghĩ rằng mình có thể đang bị đau tim. Nếu bạn không thể tiếp cận các dịch vụ y tế khẩn cấp, hãy nhờ ai đó đưa bạn đến bệ';
MERGE (n:Disease {id: 'D2784'}) SET n.id = 'D2784', n.name = 'Bào tử', n.name_en = 'Spores', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002307.htm', n.overview = 'Chất khử trùng hóa học có thể tiêu diệt vi khuẩn nhưng không tiêu diệt được bào tử của chúng. Một quá trình gọi là khử trùng sẽ tiêu diệt bào tử và vi khuẩn. Nó được thực hiện ở nhiệt độ cao và dưới á';
MERGE (n:Disease {id: 'D2785'}) SET n.id = 'D2785', n.name = 'Bệnh Sporotrichosis', n.name_en = 'Sporotrichosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001338.htm', n.prognosis = 'Với việc điều trị, khả năng hồi phục hoàn toàn là có thể. Bệnh bào tử lan tỏa khó điều trị hơn và cần điều trị vài tháng. Bệnh bào tử lan tỏa có thể đe dọa tính mạng đối với những người có hệ miễn dịc', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn phát triển các khối u trên da dai dẳng hoặc vết loét da không biến mất. Hãy cho nhà cung cấp dịch vụ của bạn biết nếu bạn biết rằng bạn đã tiếp xúc';
MERGE (n:Disease {id: 'D2786'}) SET n.id = 'D2786', n.name = 'Quá liều kem thể thao', n.name_en = 'Sports cream overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002583.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào lượng chất độc trong cơ thể và tốc độ điều trị được tiếp nhận. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Có khả năng ph';
MERGE (n:Disease {id: 'D2787'}) SET n.id = 'D2787', n.name = 'Bong gân mắt cá chân', n.name_en = 'Sprained ankle', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sprained-ankle/symptoms-causes/syc-20353225', n.overview = 'Bong gân mắt cá chân là một chấn thương xảy ra khi bạn lăn, vặn hoặc xoay mắt cá chân một cách bất tiện. Điều này có thể làm căng hoặc rách các dải mô cứng (dây chằng) giúp giữ xương mắt cá chân của b', n.when_to_see = 'Gọi cho bác sĩ nếu bạn bị đau và sưng ở mắt cá chân và bạn nghi ngờ bị bong gân. Các biện pháp tự chăm sóc có thể là tất cả những gì bạn cần, nhưng hãy nói chuyện với bác sĩ để thảo luận xem bạn có nê';
MERGE (n:Disease {id: 'D2788'}) SET n.id = 'D2788', n.name = 'Bong gân', n.name_en = 'Sprains', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/sprains/symptoms-causes/syc-20377938 | https://medlineplus.gov/ency/article/000041.htm', n.overview = 'Bong gân là tình trạng căng hoặc rách dây chằng - những dải mô sợi cứng nối hai xương với nhau trong khớp của bạn. Vị trí bong gân phổ biến nhất là ở mắt cá chân của bạn. Điều trị ban đầu bao gồm nghỉ', n.when_to_see = 'Hãy đến bệnh viện ngay hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu: Bạn nghĩ mình bị gãy xương. Khớp có vẻ lệch khỏi vị trí. Bạn bị chấn thương nghiêm trọng hoặc đau dữ dội. Bạn nghe thấy tiếng bố';
MERGE (n:Disease {id: 'D2789'}) SET n.id = 'D2789', n.name = 'Ung thư biểu mô tế bào vảy của da', n.name_en = 'Squamous cell carcinoma of the skin', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/squamous-cell-carcinoma/symptoms-causes/syc-20352480', n.overview = 'những vùng da bị tổn thương như môi dưới và tai có nhiều khả năng phát triển ung thư biểu mô tế bào vảy trên da nhất. Ung thư biểu mô tế bào vảy của da là một loại ung thư bắt đầu từ sự phát triển của', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu vết loét hoặc vảy không lành trong khoảng hai tháng hoặc một mảng da có vảy phẳng không biến mất. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi ch';
MERGE (n:Disease {id: 'D2790'}) SET n.id = 'D2790', n.name = 'Ung thư da tế bào vảy', n.name_en = 'Squamous cell skin cancer', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000829.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào nhiều thứ, bao gồm thời gian ung thư được chẩn đoán, vị trí và liệu hệ thống miễn dịch của bạn có bị suy yếu hay không. Hầu hết các bệnh ung thư này đều', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để lấy hẹn nếu vết loét hoặc vết đốm trên da thay đổi về: Ngoại hình Màu sắc Kích thước Kết cấu Đồng thời liên hệ với nhà cung cấp dịch vụ của bạn nếu vết ';
MERGE (n:Disease {id: 'D2791'}) SET n.id = 'D2791', n.name = 'Đau thắt ngực ổn định', n.name_en = 'Stable angina', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000198.htm', n.prognosis = 'Chứng đau thắt ngực ổn định thường cải thiện hơn khi dùng thuốc.', n.when_to_see = 'Nhận trợ giúp y tế ngay lập tức nếu bạn bị đau hoặc tức ngực mới, không rõ nguyên nhân. Nếu bạn đã bị đau thắt ngực trước đó, hãy liên hệ với nhà cung cấp của bạn. Gọi 911 hoặc số cấp cứu tại địa phươ';
MERGE (n:Disease {id: 'D2792'}) SET n.id = 'D2792', n.name = 'Ung thư ruột kết giai đoạn 4 (di căn)', n.name_en = 'Stage 4 (metastatic) colon cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/stage-4-colon-cancer/symptoms-causes/syc-20584697', n.overview = 'Ung thư ruột kết giai đoạn 4 là ung thư bắt đầu ở ruột kết và lan sang các bộ phận khác của cơ thể. Ung thư đại tràng giai đoạn 4 còn được gọi là ung thư đại tràng di căn, giai đoạn cuối hoặc ung thư ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Nếu trước đây bạn đã được điều trị ung thư ruột kết, hãy nói với chuyên gia chăm sóc sức ';
MERGE (n:Disease {id: 'D2793'}) SET n.id = 'D2793', n.name = 'Nhiễm tụ cầu khuẩn', n.name_en = 'Staph infections', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/staph-infections/symptoms-causes/syc-20356221', n.overview = 'đều do vi khuẩn tụ cầu gây ra. Những vi trùng này có thể được tìm thấy trên da hoặc trong mũi của nhiều người và không gây hại. Nếu chúng gây hại, vi khuẩn tụ cầu thường gây ngộ độc thực phẩm hoặc nhi', n.when_to_see = 'Nếu bạn có các triệu chứng nhiễm trùng huyết hoặc sốc nhiễm trùng, hãy chăm sóc khẩn cấp ngay lập tức. Nhiễm tụ cầu khuẩn có thể gây ra nhiều loại nhiễm trùng huyết khác nhau, nhưng các triệu chứng có';
MERGE (n:Disease {id: 'D2794'}) SET n.id = 'D2794', n.name = 'Viêm màng não do tụ cầu', n.name_en = 'Staphylococcal meningitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000613.htm', n.prognosis = 'Điều trị sớm sẽ cải thiện kết quả. Tuy nhiên, một số người không thể sống sót. Trẻ nhỏ và người lớn trên 50 tuổi có nguy cơ tử vong cao nhất. Viêm màng não do tụ cầu thường cải thiện nhanh hơn, ít biế', n.when_to_see = 'Hãy gọi 911 hoặc số điện thoại cấp cứu tại địa phương hoặc đến phòng cấp cứu nếu bạn nghi ngờ trẻ nhỏ bị viêm màng não có các triệu chứng sau: Khó ăn Khóc the thé Khó chịu Sốt dai dẳng, không rõ nguyê';
MERGE (n:Disease {id: 'D2795'}) SET n.id = 'D2795', n.name = 'Ngộ độc tinh bột', n.name_en = 'Starch poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002741.htm', n.prognosis = 'Một người có khỏe mạnh hay không phụ thuộc vào lượng tinh bột họ nuốt vào và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Tinh bột nấu ăn nói chung không có hại v';
MERGE (n:Disease {id: 'D2796'}) SET n.id = 'D2796', n.name = 'Viêm da ứ đọng và loét', n.name_en = 'Stasis dermatitis and ulcers', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000834.htm', n.prognosis = 'Viêm da ứ đọng thường là một tình trạng lâu dài ( mãn tính ). Việc chữa lành liên quan đến việc điều trị thành công nguyên nhân, yếu tố gây loét và ngăn ngừa biến chứng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị sưng chân hoặc có triệu chứng viêm da ứ đọng. Theo dõi các dấu hiệu nhiễm trùng, chẳng hạn như: Dịch tiết ra giống như mủ Vết loét da hở (loét) ';
MERGE (n:Disease {id: 'D2797'}) SET n.id = 'D2797', n.name = 'Ngộ độc chất tẩy rửa bàn ủi hơi nước', n.name_en = 'Steam iron cleaner poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002742.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất tẩy rửa bàn ủi hơi nước mà họ nuốt và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Máy làm sạch bàn ủi hơi nước có';
MERGE (n:Disease {id: 'D2798'}) SET n.id = 'D2798', n.name = 'Stent', n.name_en = 'Stent', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002303.htm', n.overview = 'Khi một ống đỡ động mạch được đặt vào cơ thể, quy trình này được gọi là đặt ống đỡ động mạch. Có nhiều loại stent khác nhau. Hầu hết đều được làm bằng vật liệu giống như lưới kim loại hoặc nhựa. Tuy n';
MERGE (n:Disease {id: 'D2799'}) SET n.id = 'D2799', n.name = 'Phẫu thuật xạ trị lập thể - CyberKnife', n.name_en = 'Stereotactic radiosurgery - CyberKnife', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007274.htm', n.overview = 'SRS nhắm mục tiêu và điều trị các vùng bất thường trên cơ thể. Sử dụng nhiều chùm tia cực nhỏ, bức xạ tập trung chặt chẽ vào khối u, giúp giảm thiểu thiệt hại cho các mô khỏe mạnh gần đó. Trong thời g', n.prognosis = 'Hiệu quả của việc điều trị bằng CyberKnife có thể mất vài tuần hoặc vài tháng mới thấy được. Tiên lượng phụ thuộc vào tình trạng đang được điều trị. Nhà cung cấp của bạn có thể sẽ theo dõi tiến trình ';
MERGE (n:Disease {id: 'D2800'}) SET n.id = 'D2800', n.name = 'Xạ phẫu lập thể - Gamma Knife', n.name_en = 'Stereotactic radiosurgery - Gamma Knife', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007577.htm', n.overview = 'Hệ thống xạ phẫu Gamma Knife được sử dụng để điều trị ung thư hoặc các khối u ở vùng đầu hoặc vùng cột sống phía trên. Đối với các bệnh ung thư hoặc khối u phát triển ở phía dưới cột sống hoặc bất kỳ ', n.prognosis = 'Hiệu quả của xạ phẫu bằng dao Gamma Knife có thể mất vài tuần hoặc vài tháng mới thấy được. Tiên lượng phụ thuộc vào tình trạng đang được điều trị. Nhà cung cấp của bạn sẽ theo dõi tiến trình của bạn ';
MERGE (n:Disease {id: 'D2801'}) SET n.id = 'D2801', n.name = 'Rối loạn vận động rập khuôn', n.name_en = 'Stereotypic movement disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001548.htm', n.prognosis = 'Triển vọng phụ thuộc vào nguyên nhân. Các cử động rập khuôn do thuốc thường tự hết sau vài giờ. Sử dụng lâu dài các chất kích thích có thể dẫn đến hành vi vận động rập khuôn trong thời gian dài hơn. C', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn lặp đi lặp lại những cử động kỳ lạ kéo dài hơn một vài giờ.';
MERGE (n:Disease {id: 'D2802'}) SET n.id = 'D2802', n.name = 'Phẫu thuật triệt sản - đưa ra quyết định', n.name_en = 'Sterilization surgery - making a decision', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002138.htm', n.overview = 'Phẫu thuật triệt sản là một thủ thuật nhằm ngăn chặn vĩnh viễn khả năng sinh sản. Phẫu thuật ở phụ nữ được gọi là thắt ống dẫn trứng. Phẫu thuật ở nam giới được gọi là thắt ống dẫn tinh. Những người k';
MERGE (n:Disease {id: 'D2803'}) SET n.id = 'D2803', n.name = 'Thăm dò hoặc đóng xương ức', n.name_en = 'Sternal exploration or closure', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007626.htm', n.overview = 'Để điều trị biến chứng, bác sĩ phẫu thuật sẽ mở lại khu vực đã được phẫu thuật. Thủ tục được thực hiện trong phòng phẫu thuật. Bác sĩ phẫu thuật: Tháo các dây giữ xương ức lại với nhau. Kiểm tra da và', n.prognosis = 'Những biến chứng này có thể gây ra các vấn đề như: Thành ngực yếu Đau lâu dài (mãn tính) Suy giảm chức năng phổi Tăng nguy cơ tử vong Nhiễm trùng nhiều hơn Cần lặp lại hoặc sửa lại quy trình';
MERGE (n:Disease {id: 'D2804'}) SET n.id = 'D2804', n.name = 'Tiêm steroid - gân, bao hoạt dịch, khớp', n.name_en = 'Steroid injections - tendon, bursa, joint', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007678.htm', n.overview = 'Nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn chèn một cây kim nhỏ và tiêm thuốc vào vùng bị đau và bị viêm. Tùy thuộc vào vị trí, nhà cung cấp dịch vụ của bạn có thể sử dụng tia X hoặc siêu âm để xe', n.prognosis = 'Bạn có thể nhận thấy cơn đau của mình giảm đi trong vài giờ đầu sau khi tiêm. Điều này là do thuốc gây tê. Tuy nhiên, hiệu ứng này sẽ biến mất. Sau khi thuốc gây tê hết tác dụng, cơn đau tương tự như ';
MERGE (n:Disease {id: 'D2805'}) SET n.id = 'D2805', n.name = 'Hội chứng Stevens-Johnson', n.name_en = 'Stevens-Johnson syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/stevens-johnson-syndrome/symptoms-causes/syc-20355936', n.overview = '(SJS) là một rối loạn nghiêm trọng, hiếm gặp ở da và niêm mạc. Đó thường là phản ứng với thuốc, bắt đầu bằng các triệu chứng giống cúm, sau đó là phát ban đau đớn lan rộng và phồng rộp. Sau đó, lớp da', n.when_to_see = 'Hội chứng Stevens-Johnson cần được chăm sóc y tế ngay lập tức. Tìm kiếm sự chăm sóc y tế khẩn cấp nếu bạn gặp các dấu hiệu và triệu chứng của tình trạng này. Phản ứng do thuốc có thể xảy ra trong quá ';
MERGE (n:Disease {id: 'D2806'}) SET n.id = 'D2806', n.name = 'Cá đuối', n.name_en = 'Stingray', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002853.htm', n.prognosis = 'Kết quả thường phụ thuộc vào lượng nọc độc xâm nhập vào cơ thể, vị trí vết đốt và thời gian người đó được điều trị. Tình trạng tê hoặc ngứa ran có thể kéo dài vài tuần sau khi bị đốt. Vết đốt sâu có t';
MERGE (n:Disease {id: 'D2807'}) SET n.id = 'D2807', n.name = 'Ngộ độc dung môi Stoddard', n.name_en = 'Stoddard solvent poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002907.htm', n.prognosis = 'Sức khỏe của người đó phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải những chất độc như vậy có thể gây ảnh';
MERGE (n:Disease {id: 'D2808'}) SET n.id = 'D2808', n.name = 'Ung thư dạ dày', n.name_en = 'Stomach cancer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/stomach-cancer/symptoms-causes/syc-20352438 | https://medlineplus.gov/ency/article/000223.htm', n.overview = 'Ung thư dạ dày là gì? Chuyên gia của Mayo Clinic giải thích Tìm hiểu thêm về bệnh ung thư dạ dày từ bác sĩ ung thư Mohamad (Bassam) Sonbol, M.D. Hiển thị bản ghi cho video Ung thư dạ dày là gì? Chuyên', n.prognosis = 'Triển vọng của bạn thay đổi tùy theo mức độ lan rộng của bệnh ung thư tính đến thời điểm chẩn đoán. Các khối u ở dạ dày dưới thường được chữa khỏi hơn so với các khối u ở dạ dày trên. Cơ hội chữa khỏi', n.when_to_see = 'Nếu bạn có các dấu hiệu và triệu chứng khiến bạn lo lắng, hãy đặt lịch hẹn với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Nhiều tình trạng có thể gây ra các triệu chứng giống như triệu chứng do u';
MERGE (n:Disease {id: 'D2809'}) SET n.id = 'D2809', n.name = 'Polyp dạ dày', n.name_en = 'Stomach polyps', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/stomach-polyps/symptoms-causes/syc-20377992', n.overview = 'là sự phát triển bất thường của các tế bào hình thành trên lớp niêm mạc bên trong dạ dày. Những polyp này rất hiếm và thường không gây ra bất kỳ triệu chứng nào. Polyp dạ dày còn được gọi là polyp dạ ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn có máu trong phân hoặc các triệu chứng khác của polyp dạ dày.';
