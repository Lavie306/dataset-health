MERGE (n:Disease {id: 'D2185'}) SET n.id = 'D2185', n.name = 'Nang giả tụy', n.name_en = 'Pancreatic pseudocyst', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000272.htm', n.prognosis = 'Kết quả điều trị nói chung là tốt. Điều quan trọng là phải đảm bảo rằng không phải ung thư tuyến tụy bắt đầu từ một u nang, gây ra hậu quả tồi tệ hơn.', n.when_to_see = 'Nếu bạn được biết là có nang giả, việc vỡ nang giả là một trường hợp cấp cứu y tế. Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn có các triệu chứng chảy máu hoặc sốc, chẳng';
MERGE (n:Disease {id: 'D2186'}) SET n.id = 'D2186', n.name = 'Viêm tụy', n.name_en = 'Pancreatitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pancreatitis/symptoms-causes/syc-20360227', n.overview = 'do sỏi mật là nguyên nhân phổ biến gây viêm tụy. Sỏi mật được tạo ra trong túi mật có thể trượt ra khỏi túi mật và làm tắc ống mật. Điều này ngăn chặn các enzyme tuyến tụy di chuyển đến ruột non và bu', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị đau bụng đột ngột hoặc đau bụng không cải thiện. Tìm kiếm sự trợ giúp y tế ngay lập tức nếu cơn đau của bạn nghiêm trọng đến mức bạn không t';
MERGE (n:Disease {id: 'D2187'}) SET n.id = 'D2187', n.name = 'Viêm tụy - trẻ em', n.name_en = 'Pancreatitis - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007679.htm', n.prognosis = 'Hầu hết các trường hợp sẽ khỏi sau một tuần. Trẻ em thường hồi phục hoàn toàn. Viêm tụy mãn tính hiếm khi gặp ở trẻ em. Khi nó xảy ra, thường là do khiếm khuyết di truyền hoặc dị tật bẩm sinh của tuyế', n.when_to_see = 'Hãy liên hệ với nhà cung cấp nếu con bạn có triệu chứng viêm tụy. Đồng thời, hãy liên hệ với nhà cung cấp dịch vụ nếu con bạn có các triệu chứng sau: Đau bụng dữ dội, liên tục Phát triển các triệu chứ';
MERGE (n:Disease {id: 'D2188'}) SET n.id = 'D2188', n.name = 'Các cơn hoảng loạn và rối loạn hoảng sợ', n.name_en = 'Panic attacks and panic disorder', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/panic-attacks/symptoms-causes/syc-20376021', n.overview = 'Cơn hoảng loạn là một giai đoạn sợ hãi mãnh liệt đột ngột gây ra các phản ứng thể chất nghiêm trọng khi không có mối nguy hiểm thực sự hoặc nguyên nhân rõ ràng. Các cuộc tấn công hoảng loạn có thể rất', n.when_to_see = 'Nếu bạn có các triệu chứng hoảng loạn, hãy tìm sự trợ giúp y tế càng sớm càng tốt. Các cơn hoảng loạn, mặc dù cực kỳ khó chịu nhưng không nguy hiểm. Nhưng các cơn hoảng loạn khó có thể tự kiểm soát đư';
MERGE (n:Disease {id: 'D2189'}) SET n.id = 'D2189', n.name = 'Rối loạn hoảng sợ', n.name_en = 'Panic disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000924.htm', n.prognosis = 'Rối loạn hoảng sợ có thể kéo dài và khó điều trị. Một số người mắc chứng rối loạn này có thể không được chữa khỏi. Nhưng hầu hết mọi người sẽ khỏe hơn khi được điều trị đúng cách. Những người mắc chứn', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn để đặt lịch hẹn nếu cơn hoảng loạn đang cản trở công việc, các mối quan hệ hoặc lòng tự trọng của bạn. Nếu bạn hoặc ai đó bạn biết đang nghĩ đến việc tự tử, hãy gọ';
MERGE (n:Disease {id: 'D2190'}) SET n.id = 'D2190', n.name = 'Phẫu thuật cắt bỏ mỡ', n.name_en = 'Panniculectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007739.htm', n.overview = 'Cuộc phẫu thuật sẽ diễn ra tại bệnh viện hoặc trung tâm phẫu thuật. Phẫu thuật này có thể mất vài giờ. Bạn sẽ được gây mê toàn thân. Điều này sẽ giúp bạn ngủ ngon và không bị đau trong suốt quá trình.', n.prognosis = 'Kết quả của phẫu thuật cắt bỏ mô mỡ thường tốt. Hầu hết mọi người đều hài lòng với diện mạo mới của mình.';
MERGE (n:Disease {id: 'D2191'}) SET n.id = 'D2191', n.name = 'Axit para-aminobenzoic', n.name_en = 'Para-aminobenzoic acid', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002518.htm', n.prognosis = 'Khả năng phục hồi của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải sản phẩm chống nắng có chứa PABA hiếm khi ';
MERGE (n:Disease {id: 'D2192'}) SET n.id = 'D2192', n.name = 'Ngộ độc paradichlorobenzen', n.name_en = 'Paradichlorobenzene poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002902.htm', n.prognosis = 'Loại ngộ độc này thường không xảy ra đe dọa tính mạng. Sẽ có rất ít khả năng xảy ra nếu con bạn vô tình cho một viên băng phiến vào miệng, ngay cả khi nuốt phải, trừ khi nó gây nghẹn. Băng phiến có mù';
MERGE (n:Disease {id: 'D2193'}) SET n.id = 'D2193', n.name = 'Ngộ độc paraffin', n.name_en = 'Paraffin poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002731.htm', n.prognosis = 'Paraffin thường không độc hại (không có hại) nếu nuốt phải với lượng nhỏ. Có khả năng phục hồi. Người đó có thể sẽ được yêu cầu uống một lượng lớn chất lỏng để giúp di chuyển parafin qua ruột. Số tiền';
MERGE (n:Disease {id: 'D2194'}) SET n.id = 'D2194', n.name = 'U cận hạch', n.name_en = 'Paraganglioma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/paraganglioma/symptoms-causes/syc-20575682', n.overview = 'U cận hạch là sự phát triển của các tế bào có thể xảy ra ở những nơi khác nhau trong cơ thể. Sự tăng trưởng, được gọi là khối u, hình thành từ một loại tế bào thần kinh quan trọng được tìm thấy trên k', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn lo lắng rằng mình có thể có các triệu chứng u cận hạch. Điều này rất quan trọng nếu bạn có nhiều triệu chứng u cận hạch cùng một lúc. ';
MERGE (n:Disease {id: 'D2195'}) SET n.id = 'D2195', n.name = 'Parainfluenza', n.name_en = 'Parainfluenza', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001370.htm', n.prognosis = 'Hầu hết các bệnh nhiễm trùng ở người lớn và trẻ lớn đều ở mức độ nhẹ và quá trình hồi phục diễn ra mà không cần điều trị, trừ khi người đó rất già hoặc có hệ thống miễn dịch bất thường. Can thiệp y tế', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn hoặc con bạn bị viêm thanh quản, thở khò khè hoặc bất kỳ loại khó thở nào khác. Trẻ dưới 18 tháng tuổi có bất kỳ loại triệu chứng hô hấp trên nào.';
MERGE (n:Disease {id: 'D2196'}) SET n.id = 'D2196', n.name = 'Hội chứng cận ung thư của hệ thần kinh', n.name_en = 'Paraneoplastic syndromes of the nervous system', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/paraneoplastic-syndromes/symptoms-causes/syc-20355687', n.overview = 'là một nhóm các tình trạng hiếm gặp phát triển ở một số người mắc bệnh ung thư. Ngoài hệ thần kinh, hội chứng cận ung thư còn có thể ảnh hưởng đến các hệ cơ quan khác bao gồm hormone, da, máu và khớp.', n.when_to_see = 'Các triệu chứng của hội chứng cận ung thư của hệ thần kinh tương tự như triệu chứng của nhiều bệnh lý, bao gồm ung thư, biến chứng ung thư và một số phương pháp điều trị ung thư. Nhưng nếu bạn có bất ';
MERGE (n:Disease {id: 'D2197'}) SET n.id = 'D2197', n.name = 'Rối loạn nhân cách hoang tưởng', n.name_en = 'Paranoid personality disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000938.htm', n.prognosis = 'Outlook thường phụ thuộc vào việc người đó có sẵn sàng chấp nhận trợ giúp hay không. Liệu pháp nói chuyện và dùng thuốc đôi khi có thể làm giảm chứng hoang tưởng và hạn chế tác động của nó đến hoạt độ', n.when_to_see = 'Hãy gặp nhà cung cấp hoặc chuyên gia sức khỏe tâm thần nếu những nghi ngờ đang cản trở các mối quan hệ hoặc công việc của bạn.';
MERGE (n:Disease {id: 'D2198'}) SET n.id = 'D2198', n.name = 'Paraphimosis', n.name_en = 'Paraphimosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001281.htm', n.prognosis = 'Kết quả có thể sẽ tốt nếu tình trạng bệnh được chẩn đoán và điều trị nhanh chóng.', n.when_to_see = 'Hãy đến phòng cấp cứu tại địa phương nếu điều này xảy ra.';
MERGE (n:Disease {id: 'D2199'}) SET n.id = 'D2199', n.name = 'Tràn dịch màng phổi cận viêm phổi', n.name_en = 'Parapneumonic pleural effusion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000139.htm', n.prognosis = 'Tình trạng này được cải thiện khi tình trạng viêm phổi được cải thiện.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng tràn dịch màng phổi. Liên hệ với nhà cung cấp của bạn hoặc đến phòng cấp cứu nếu tình trạng hụt hơi hoặc khó thở xảy ra ngay sau';
MERGE (n:Disease {id: 'D2200'}) SET n.id = 'D2200', n.name = 'Ngộ độc paraquat', n.name_en = 'Paraquat poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007834.htm', n.prognosis = 'Kết quả phụ thuộc vào lượng paraquat được hấp thụ. Nuốt phải ngay cả một lượng nhỏ cũng có thể gây tử vong. Những người bị phơi nhiễm nhẹ có thể hồi phục hoàn toàn, nhưng những người nuốt phải chất độ';
MERGE (n:Disease {id: 'D2201'}) SET n.id = 'D2201', n.name = 'U tuyến cận giáp', n.name_en = 'Parathyroid adenoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001188.htm', n.prognosis = 'Khi được điều trị, triển vọng nhìn chung là tốt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng của tình trạng này.';
MERGE (n:Disease {id: 'D2202'}) SET n.id = 'D2202', n.name = 'Ung thư tuyến cận giáp', n.name_en = 'Parathyroid cancer', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007264.htm', n.prognosis = 'Ung thư tuyến cận giáp đang phát triển chậm. Phẫu thuật có thể giúp kéo dài sự sống ngay cả khi ung thư lan rộng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn cảm thấy có khối u ở cổ hoặc gặp các triệu chứng tăng canxi máu.';
MERGE (n:Disease {id: 'D2203'}) SET n.id = 'D2203', n.name = 'Cắt bỏ tuyến cận giáp', n.name_en = 'Parathyroid gland removal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002931.htm', n.overview = 'Bạn sẽ được gây mê toàn thân (ngủ và không đau) cho ca phẫu thuật này. Thông thường, tuyến cận giáp sẽ được cắt bỏ bằng cách phẫu thuật cắt từ 2 đến 4 inch (in) hoặc 5 đến 10 cm (cm) trên cổ của bạn. ', n.prognosis = 'Mọi người thường hồi phục sớm sau cuộc phẫu thuật này. Phục hồi có thể nhanh hơn khi sử dụng các kỹ thuật ít xâm lấn hơn. Đôi khi, cần phải thực hiện một cuộc phẫu thuật khác để cắt bỏ nhiều tuyến cận';
MERGE (n:Disease {id: 'D2204'}) SET n.id = 'D2204', n.name = 'Tăng sản tuyến cận giáp', n.name_en = 'Parathyroid hyperplasia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001189.htm', n.prognosis = 'Sau phẫu thuật, nồng độ canxi trong máu cao có thể tồn tại hoặc quay trở lại. Phẫu thuật đôi khi có thể gây ra chứng suy tuyến cận giáp, khiến nồng độ canxi trong máu quá thấp.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có bất kỳ triệu chứng tăng canxi máu nào Bạn có tiền sử gia đình mắc hội chứng MEN';
MERGE (n:Disease {id: 'D2205'}) SET n.id = 'D2205', n.name = 'Hội chứng mắt-mắt Parinaud', n.name_en = 'Parinaud oculoglandular syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000736.htm', n.prognosis = 'Triển vọng phụ thuộc vào nguyên nhân lây nhiễm. Nói chung, nếu chẩn đoán được thực hiện sớm và bắt đầu điều trị ngay thì kết quả của POS có thể rất tốt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu mắt bạn bị đỏ, khó chịu và đau.';
MERGE (n:Disease {id: 'D2206'}) SET n.id = 'D2206', n.name = 'Bệnh Parkinson', n.name_en = 'Parkinson disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000755.htm', n.prognosis = 'Thuốc có thể giúp ích cho hầu hết những người mắc bệnh Parkinson. Mức độ thuốc làm giảm triệu chứng tốt như thế nào và thuốc làm giảm triệu chứng trong bao lâu có thể khác nhau ở mỗi người. Chứng rối ', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Bạn có các triệu chứng của bệnh Parkinson Các triệu chứng của bạn trở nên trầm trọng hơn Các triệu chứng mới xuất hiện Nếu bạn dùng thuốc điều trị bệnh Parkinson,';
MERGE (n:Disease {id: 'D2207'}) SET n.id = 'D2207', n.name = 'Paronychia', n.name_en = 'Paronychia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001444.htm', n.prognosis = 'Paronychia thường đáp ứng tốt với việc điều trị. Tuy nhiên, nhiễm nấm có thể kéo dài trong vài tháng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Các triệu chứng paronychia vẫn tiếp tục mặc dù đã điều trị Các triệu chứng trở nên trầm trọng hơn hoặc các triệu chứng mới phát triển';
MERGE (n:Disease {id: 'D2208'}) SET n.id = 'D2208', n.name = 'Khối u tuyến mang tai', n.name_en = 'Parotid tumors', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/parotid-tumor/symptoms-causes/syc-20578986', n.overview = 'Video liên quan Xem các chuyên gia của Mayo Clinic thảo luận về khối u tuyến mang tai trên YouTube. Tuyến mang tai ở phía trước tai. Có một tuyến mang tai ở mỗi bên của khuôn mặt. Ngoài ra còn có nhiề', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D2209'}) SET n.id = 'D2209', n.name = 'Bệnh tiểu huyết sắc tố do lạnh kịch phát (PCH)', n.name_en = 'Paroxysmal cold hemoglobinuria (PCH)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000557.htm', n.prognosis = 'Những người mắc bệnh này thường khỏi bệnh nhanh chóng và không có triệu chứng giữa các đợt. Trong hầu hết các trường hợp, các cuộc tấn công kết thúc ngay khi các tế bào bị tổn thương ngừng di chuyển k', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của chứng rối loạn này. Nhà cung cấp của bạn có thể kiểm tra các nguyên nhân khác gây ra các triệu chứng và qu';
MERGE (n:Disease {id: 'D2210'}) SET n.id = 'D2210', n.name = 'Tiểu huyết sắc tố kịch phát về đêm (PNH)', n.name_en = 'Paroxysmal nocturnal hemoglobinuria (PNH)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000534.htm', n.prognosis = 'Kết quả sẽ khác nhau. Hầu hết mọi người sống sót trong hơn 10 năm sau khi chẩn đoán. Tử vong có thể do các biến chứng như hình thành cục máu đông (huyết khối) hoặc chảy máu. Trong một số ít trường hợp', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn thấy có máu trong nước tiểu, nếu các triệu chứng trở nên trầm trọng hơn hoặc không cải thiện khi điều trị hoặc nếu các triệu chứng mới phát triển.';
MERGE (n:Disease {id: 'D2211'}) SET n.id = 'D2211', n.name = 'Nhịp tim nhanh kịch phát trên thất (PSVT)', n.name_en = 'Paroxysmal supraventricular tachycardia (PSVT)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000183.htm', n.prognosis = 'PSVT nói chung không đe dọa đến tính mạng. Nếu có các rối loạn tim khác, nó có thể dẫn đến suy tim sung huyết hoặc đau thắt ngực.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn có cảm giác tim mình đập nhanh và các triệu chứng không tự hết sau vài phút. Bạn có tiền sử PSVT và đợt bệnh không biến mất khi ';
MERGE (n:Disease {id: 'D2212'}) SET n.id = 'D2212', n.name = 'Xạ trị áp sát một phần vú', n.name_en = 'Partial breast brachytherapy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007692.htm', n.overview = 'Xạ trị áp sát áp sát trực tiếp vào vị trí có tế bào ung thư bên trong vú. Nó có thể liên quan đến việc đặt nguồn phóng xạ vào vị trí phẫu thuật sau khi bác sĩ phẫu thuật cắt bỏ khối u ở vú. Bức xạ chỉ', n.prognosis = 'Các nghiên cứu đã chỉ ra rằng nếu mọi người được lựa chọn cẩn thận thì kết quả tổng thể đều như nhau cho dù mọi người được xạ trị một phần vú hay toàn bộ vú.';
MERGE (n:Disease {id: 'D2213'}) SET n.id = 'D2213', n.name = 'Xạ trị một phần vú - chùm tia ngoài', n.name_en = 'Partial breast radiation therapy - external beam', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007693.htm', n.overview = 'Xạ trị thường được thực hiện trên cơ sở ngoại trú, ngoại trừ xạ trị trong phẫu thuật. Hai kỹ thuật phổ biến được sử dụng để điều trị bằng bức xạ chùm tia bên ngoài một phần vú: Bức xạ chùm tia bên ngo', n.prognosis = 'Xạ trị một phần vú sau liệu pháp bảo tồn vú làm giảm nguy cơ ung thư tái phát và thậm chí có thể tử vong do ung thư vú.';
MERGE (n:Disease {id: 'D2214'}) SET n.id = 'D2214', n.name = 'Phẫu thuật thay khớp gối một phần', n.name_en = 'Partial knee replacement', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007256.htm', n.overview = 'sẽ loại bỏ mô và xương bị tổn thương ở khớp gối. Nó được thực hiện khi bệnh viêm khớp chủ yếu chỉ ảnh hưởng đến một phần của đầu gối. Các khu vực này được thay thế bằng cấy ghép nhân tạo, được gọi là ', n.prognosis = 'Hầu hết mọi người hồi phục nhanh chóng và ít đau hơn nhiều so với trước khi phẫu thuật. Những người được thay khớp gối một phần sẽ hồi phục nhanh hơn những người được thay khớp gối toàn bộ. Nhiều ngườ';
MERGE (n:Disease {id: 'D2215'}) SET n.id = 'D2215', n.name = 'Nhiễm Parvovirus', n.name_en = 'Parvovirus infection', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/parvovirus-infection/symptoms-causes/syc-20376085', n.overview = 'Nhiễm parvovirus là một căn bệnh do một loại virus có tên là parvovirus B19 gây ra. Bệnh thường gặp nhất ở trẻ em. Người lớn cũng có thể nhiễm parvovirus nếu họ không nhiễm virus khi còn nhỏ. Virus lâ', n.when_to_see = 'Hầu hết những người bị nhiễm parvovirus nhẹ không cần gặp chuyên gia chăm sóc sức khỏe. Nhưng một số người có những tình trạng có thể làm cho bệnh nặng hơn hoặc dẫn đến các vấn đề y tế khác. Kiểm tra ';
MERGE (n:Disease {id: 'D2216'}) SET n.id = 'D2216', n.name = 'Màu da loang lổ', n.name_en = 'Patchy skin color', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003224.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có bất kỳ sự thay đổi màu da kéo dài nào mà không xác định được nguyên nhân Bạn nhận thấy một nốt ruồi mới hoặc sự phát triển khác Sự phát triển h';
MERGE (n:Disease {id: 'D2217'}) SET n.id = 'D2217', n.name = 'Viêm gân bánh chè', n.name_en = 'Patellar tendinitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/patellar-tendinitis/symptoms-causes/syc-20376113', n.overview = 'là một chấn thương ở gân nối xương bánh chè, còn được gọi là xương bánh chè, với xương ống chân. Gân bánh chè hoạt động cùng với các cơ ở phía trước đùi để làm thẳng đầu gối. Viêm gân bánh chè còn đượ', n.when_to_see = 'Để bị đau đầu gối, trước tiên hãy thử các biện pháp tự chăm sóc. Chúng bao gồm chườm lạnh vùng đó và giảm hoặc không thực hiện các hoạt động gây ra các triệu chứng của bạn trong một thời gian. Gọi cho';
MERGE (n:Disease {id: 'D2218'}) SET n.id = 'D2218', n.name = 'Hội chứng đau xương bánh chè', n.name_en = 'Patellofemoral pain syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/patellofemoral-pain-syndrome/symptoms-causes/syc-20350792', n.overview = 'Hội chứng đau xương bánh chè (puh-tel-o-FEM-uh-rul) là đau ở phía trước đầu gối, xung quanh xương bánh chè. Xương bánh chè còn được gọi là xương bánh chè. Hội chứng đau xương bánh chè đôi khi được gọi';
MERGE (n:Disease {id: 'D2219'}) SET n.id = 'D2219', n.name = 'Còn ống động mạch', n.name_en = 'Patent ductus arteriosus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001560.htm', n.prognosis = 'Nếu một chiếc PDA nhỏ vẫn mở, em bé cuối cùng có thể phát triển các triệu chứng về tim. Trẻ sơ sinh có PDA lớn hơn có thể mắc các vấn đề về tim như suy tim, huyết áp cao ở động mạch phổi hoặc nhiễm tr', n.when_to_see = 'Tình trạng này thường được chẩn đoán bởi bác sĩ khám cho trẻ sơ sinh của bạn. Các vấn đề về hô hấp và ăn uống ở trẻ sơ sinh đôi khi có thể là do PDA chưa được chẩn đoán.';
MERGE (n:Disease {id: 'D2220'}) SET n.id = 'D2220', n.name = 'Còn ống động mạch (PDA)', n.name_en = 'Patent ductus arteriosus (PDA)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/patent-ductus-arteriosus/symptoms-causes/syc-20376145', n.overview = 'Còn ống động mạch mở liên tục giữa hai mạch máu chính rời khỏi tim. Những mạch đó là động mạch chủ và động mạch phổi. Tình trạng này xuất hiện ngay từ khi sinh ra, có nghĩa là nó là một khuyết tật tim', n.when_to_see = 'Hãy liên hệ với chuyên gia chăm sóc sức khỏe nếu con bạn hoặc trẻ lớn hơn: Dễ mệt mỏi khi ăn hoặc chơi. Không tăng cân. Trở nên khó thở khi ăn hoặc khóc. Luôn thở nhanh hoặc hụt ​​hơi. Yêu cầu một cuộ';
MERGE (n:Disease {id: 'D2221'}) SET n.id = 'D2221', n.name = 'Lỗ bầu dục còn sót lại', n.name_en = 'Patent foramen ovale', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/patent-foramen-ovale/symptoms-causes/syc-20353487 | https://medlineplus.gov/ency/article/001113.htm', n.overview = 'Lỗ bầu dục còn sót lại (PFO) là một lỗ trong tim không hoạt động như bình thường sau khi sinh. Lỗ này là một lỗ nhỏ giống như cái nắp giữa các buồng tim phía trên. Các buồng trên của tim được gọi là t', n.prognosis = 'Một trẻ sơ sinh không mắc các dị tật tim khác sẽ có sức khỏe và tuổi thọ bình thường.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn chuyển sang màu xanh khi khóc hoặc đi tiêu, khó bú hoặc có biểu hiện kém phát triển.';
MERGE (n:Disease {id: 'D2222'}) SET n.id = 'D2222', n.name = 'Phẫu thuật chỉnh hình ống niệu rốn bằng sáng chế', n.name_en = 'Patent urachus repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002993.htm', n.overview = 'Trẻ em thực hiện phẫu thuật này sẽ được gây mê toàn thân (ngủ và không đau). Bác sĩ phẫu thuật sẽ rạch một đường ở bụng dưới của trẻ. Tiếp theo, bác sĩ phẫu thuật sẽ tìm ống niệu rốn và cắt bỏ nó. Việ', n.prognosis = 'Kết quả thường rất xuất sắc.';
MERGE (n:Disease {id: 'D2223'}) SET n.id = 'D2223', n.name = 'Dị ứng đậu phộng', n.name_en = 'Peanut allergy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/peanut-allergy/symptoms-causes/syc-20376175', n.overview = 'là tình trạng khiến hệ thống miễn dịch chống vi trùng của cơ thể phản ứng với đậu phộng. Đây là một trong những nguyên nhân phổ biến nhất gây ra phản ứng dị ứng đe dọa tính mạng với thực phẩm. Phản ứn', n.when_to_see = 'Hãy nói chuyện với nhóm chăm sóc của bạn nếu bạn có bất kỳ dấu hiệu hoặc triệu chứng nào của dị ứng đậu phộng. Tìm cách điều trị khẩn cấp nếu bạn có phản ứng nặng với đậu phộng. Gọi hoặc nhờ người khá';
MERGE (n:Disease {id: 'D2224'}) SET n.id = 'D2224', n.name = 'Pectus carinatum', n.name_en = 'Pectus carinatum', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003321.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy ngực của con bạn có hình dạng bất thường.';
MERGE (n:Disease {id: 'D2225'}) SET n.id = 'D2225', n.name = 'Xương ức', n.name_en = 'Pectus excavatum', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/pectus-excavatum/symptoms-causes/syc-20355483 | https://medlineplus.gov/ency/article/003320.htm', n.overview = 'bị lõm vào ngực. Nếu tình trạng rất nghiêm trọng, nó có thể ảnh hưởng đến hoạt động của tim và phổi theo thời gian. Pectus khai mạc là tình trạng xương ức bị lõm vào ngực. Xương ức bị trũng thường có ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn hoặc con bạn có bất kỳ triệu chứng nào của bệnh lõm ngực. Đây là điều quan trọng nếu các triệu chứng trở nên tồi tệ hơn hoặc nếu ngực ngày càng trũng xuống';
MERGE (n:Disease {id: 'D2226'}) SET n.id = 'D2226', n.name = 'Sửa chữa vết lõm ngực', n.name_en = 'Pectus excavatum repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002949.htm', n.overview = 'Có hai loại phẫu thuật để khắc phục tình trạng này -- phẫu thuật mở và phẫu thuật kín (xâm lấn tối thiểu). Phẫu thuật được thực hiện khi trẻ đang ngủ sâu và không bị đau do gây mê toàn thân. Phẫu thuậ', n.prognosis = 'Phẫu thuật thường dẫn đến những cải thiện về ngoại hình, nhịp thở và khả năng tập thể dục.';
MERGE (n:Disease {id: 'D2227'}) SET n.id = 'D2227', n.name = 'Khối u não ở trẻ em', n.name_en = 'Pediatric brain tumors', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pediatric-brain-tumor/symptoms-causes/syc-20361694', n.overview = 'Khối u não ở trẻ em ly giải bắt đầu từ tế bào não. Khi khối u phát triển, nó có thể tạo áp lực lên các mô não xung quanh. Điều này gây ra các triệu chứng của khối u não, chẳng hạn như đau đầu, buồn nô', n.when_to_see = 'Hẹn gặp bác sĩ của con bạn hoặc chuyên gia chăm sóc sức khỏe khác nếu con bạn có các triệu chứng khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập ';
MERGE (n:Disease {id: 'D2228'}) SET n.id = 'D2228', n.name = 'Phẫu thuật tim nhi khoa', n.name_en = 'Pediatric heart surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007363.htm', n.overview = 'Có rất nhiều loại dị tật tim. Một số là nhỏ, và một số khác nghiêm trọng hơn. Khiếm khuyết có thể xảy ra bên trong tim hoặc ở các mạch máu lớn bên ngoài tim. Một số khuyết tật về tim có thể cần phải p', n.prognosis = 'Kết quả của phẫu thuật tim phụ thuộc vào tình trạng của trẻ, loại khuyết tật và loại phẫu thuật đã được thực hiện. Nhiều trẻ em hồi phục hoàn toàn và có cuộc sống năng động, bình thường.';
MERGE (n:Disease {id: 'D2229'}) SET n.id = 'D2229', n.name = 'Ngưng thở khi ngủ do tắc nghẽn ở trẻ em', n.name_en = 'Pediatric obstructive sleep apnea', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pediatric-sleep-apnea/symptoms-causes/syc-20376196', n.overview = 'là tình trạng hơi thở của trẻ bị tắc nghẽn một phần hoặc hoàn toàn trong khi ngủ. Hơi thở có thể dừng lại trong thời gian ngắn và bắt đầu lại nhiều lần trong đêm. Tình trạng này xảy ra khi đường hô hấ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của con bạn nếu con bạn có bất kỳ triệu chứng nào của chứng ngưng thở khi ngủ do tắc nghẽn, bao gồm cả ngáy thường xuyên. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2230'}) SET n.id = 'D2230', n.name = 'Chứng ngưng thở khi ngủ ở trẻ em', n.name_en = 'Pediatric sleep apnea', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007660.htm', n.prognosis = 'Trong hầu hết các trường hợp, việc điều trị sẽ làm giảm hoàn toàn các triệu chứng và vấn đề do ngưng thở khi ngủ.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn nhận thấy các triệu chứng ngưng thở khi ngủ ở trẻ Các triệu chứng không cải thiện khi điều trị hoặc các triệu chứng mới phát triển';
MERGE (n:Disease {id: 'D2231'}) SET n.id = 'D2231', n.name = 'Rối loạn bạch cầu ở trẻ em', n.name_en = 'Pediatric white blood cell disorders', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pediatric-white-blood-cell-disorders/symptoms-causes/syc-20352674', n.overview = 'Trẻ em bị rối loạn bạch cầu ở trẻ em có quá ít hoặc quá nhiều bạch cầu. Các tế bào bạch cầu, được gọi là bạch cầu, là một phần của hệ thống miễn dịch. Chúng đến từ tủy xương và giúp chống nhiễm trùng.';
MERGE (n:Disease {id: 'D2232'}) SET n.id = 'D2232', n.name = 'Pellagra', n.name_en = 'Pellagra', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000342.htm', n.prognosis = 'Mọi người thường hồi phục tốt sau khi dùng niacin.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có bất kỳ triệu chứng nào của bệnh nấm.';
MERGE (n:Disease {id: 'D2233'}) SET n.id = 'D2233', n.name = 'Các bài tập rèn luyện cơ sàn chậu', n.name_en = 'Pelvic floor muscle training exercises', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003975.htm', n.overview = 'được khuyến khích cho: Phụ nữ mắc chứng tiểu không tự chủ do căng thẳng Nam giới bị tiểu không tự chủ do căng thẳng, thường gặp nhất là sau phẫu thuật tuyến tiền liệt Những người bị chứng són phân Các';
MERGE (n:Disease {id: 'D2234'}) SET n.id = 'D2234', n.name = 'Bệnh viêm vùng chậu (PID)', n.name_en = 'Pelvic inflammatory disease (PID)', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/pelvic-inflammatory-disease/symptoms-causes/syc-20352594 | https://medlineplus.gov/ency/article/000888.htm', n.overview = 'Bệnh viêm vùng chậu, còn gọi là PID, là một bệnh nhiễm trùng cơ quan sinh sản của những người được xác định là nữ khi mới sinh. Nó thường xảy ra nhất khi vi trùng lây truyền qua đường tình dục lây lan', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn ngay lập tức hoặc tìm kiếm sự chăm sóc khẩn cấp nếu bạn bị: Đau dữ dội. Đau bụng và nôn mửa. Nhiệt độ cao hơn 101 độ F (38,3 độ C). Ngay cả khi các triệu c';
MERGE (n:Disease {id: 'D2235'}) SET n.id = 'D2235', n.name = 'Nội soi vùng chậu', n.name_en = 'Pelvic laparoscopy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002916.htm', n.overview = 'Trong khi bạn đang ngủ sâu và không bị đau khi gây mê toàn thân, bác sĩ sẽ thực hiện một vết phẫu thuật dài nửa inch (1,25 cm) ở vùng da bên dưới rốn. Khí carbon dioxide được bơm vào bụng để giúp bác ';
MERGE (n:Disease {id: 'D2236'}) SET n.id = 'D2236', n.name = 'Sa cơ quan vùng chậu', n.name_en = 'Pelvic organ prolapse', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pelvic-organ-prolapse/symptoms-causes/syc-20360557', n.overview = 'là khi một hoặc nhiều cơ quan vùng chậu rơi khỏi vị trí của chúng. Điều này làm cho âm đạo phình ra, gọi là sa tử cung. Các cơ và mô liên kết của sàn chậu thường giữ các cơ quan vùng chậu ở đúng vị tr';
MERGE (n:Disease {id: 'D2237'}) SET n.id = 'D2237', n.name = 'Pemphigus', n.name_en = 'Pemphigus', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pemphigus/symptoms-causes/syc-20350404', n.overview = 'gây tổn thương da và niêm mạc. Loại phổ biến nhất là pemphigus Vulgaris, bao gồm các vết loét và mụn nước đau đớn trên da và trong miệng. Pemphigus foliaceus ct màng nhầy. Các mụn nước có thể bắt đầu ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn có vết phồng rộp không lành trong miệng, trên da hoặc màng nhầy sinh dục. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2238'}) SET n.id = 'D2238', n.name = 'Pemphigus Vulgaris', n.name_en = 'Pemphigus vulgaris', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000882.htm', n.prognosis = 'Nếu không điều trị, tình trạng này có thể đe dọa tính mạng. Nhiễm trùng nặng là nguyên nhân gây tử vong thường gặp nhất. Khi được điều trị, rối loạn có xu hướng trở thành mãn tính. Tác dụng phụ của đi', n.when_to_see = 'Nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nên kiểm tra bất kỳ vết phồng rộp nào không giải thích được. Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn đã được điều trị bệnh PV và bạn xuất hiện b';
MERGE (n:Disease {id: 'D2239'}) SET n.id = 'D2239', n.name = 'Nuốt tẩy bút chì', n.name_en = 'Pencil eraser swallowing', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002816.htm', n.prognosis = 'Vì tẩy bút chì được coi là khá không độc hại nên khả năng phục hồi là có thể.';
MERGE (n:Disease {id: 'D2240'}) SET n.id = 'D2240', n.name = 'Nuốt bút chì', n.name_en = 'Pencil swallowing', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002817.htm', n.prognosis = 'Recovery is likely.';
MERGE (n:Disease {id: 'D2241'}) SET n.id = 'D2241', n.name = 'Dị ứng penicillin', n.name_en = 'Penicillin allergy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/penicillin-allergy/symptoms-causes/syc-20376222', n.overview = 'là phản ứng của hệ thống miễn dịch với thuốc kháng sinh penicillin. Penicillin được sử dụng để điều trị nhiễm trùng do vi khuẩn. Dị ứng penicillin có thể gây nổi mề đay, phát ban và ngứa. Một phản ứng', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng kéo dài nào khiến bạn lo lắng. Điều quan trọng là phải hiểu và thảo luận về phản ứng dị ứng là gì, tác dụng phụ ';
MERGE (n:Disease {id: 'D2242'}) SET n.id = 'D2242', n.name = 'Ung thư dương vật', n.name_en = 'Penile cancer', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001276.htm', n.prognosis = 'Kết quả có thể tốt nếu được chẩn đoán và điều trị sớm. Chức năng tiểu tiện và tình dục thường có thể được duy trì.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu các triệu chứng của bệnh ung thư dương vật phát triển.';
MERGE (n:Disease {id: 'D2243'}) SET n.id = 'D2243', n.name = 'Dương vật', n.name_en = 'Penis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002279.htm', n.overview = 'Ở tuổi dậy thì, dương vật dài ra. Khả năng xuất tinh bắt đầu ở khoảng 12 đến 14 tuổi. Xuất tinh là sự giải phóng chất lỏng chứa tinh trùng từ dương vật khi đạt cực khoái. Các tình trạng của dương vật ';
MERGE (n:Disease {id: 'D2244'}) SET n.id = 'D2244', n.name = 'Đau dương vật', n.name_en = 'Penis pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003166.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy bất kỳ điều nào sau đây: Cương cứng không biến mất (priapism). Tìm kiếm sự chăm sóc y tế ngay lập tức. Cơn đau kéo dài ';
MERGE (n:Disease {id: 'D2245'}) SET n.id = 'D2245', n.name = 'Quá liều Pentazocine', n.name_en = 'Pentazocine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002519.htm', n.prognosis = 'Quá liều Pentazocine thường ít nghiêm trọng hơn nhiều so với các trường hợp quá liều thuốc opioid khác, chẳng hạn như heroin và morphin. Trong một số ít trường hợp, cần phải sử dụng thuốc giải độc. Có';
MERGE (n:Disease {id: 'D2246'}) SET n.id = 'D2246', n.name = 'Quá liều pentobarbital', n.name_en = 'Pentobarbital overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002508.htm', n.prognosis = 'Tình trạng của người đó khỏe mạnh như thế nào tùy thuộc vào lượng thuốc nuốt vào và tốc độ điều trị được tiếp nhận nhanh như thế nào. Nếu được điều trị thích hợp, mọi người có thể hồi phục sau 1 đến 5';
MERGE (n:Disease {id: 'D2247'}) SET n.id = 'D2247', n.name = 'Quá liều dầu bạc hà', n.name_en = 'Peppermint oil overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002685.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng dầu bạc hà nuốt vào và thời gian điều trị được tiếp nhận nhanh như thế nào. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Sống sót sau 48 giờ thư';
MERGE (n:Disease {id: 'D2248'}) SET n.id = 'D2248', n.name = 'Loét dạ dày', n.name_en = 'Peptic ulcer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/peptic-ulcer/symptoms-causes/syc-20354223 | https://medlineplus.gov/ency/article/000206.htm', n.overview = 'Loét ở phần trên của ruột non. Loét dạ dày tá tràng được gọi là loét dạ dày. Loét tá tràng là vết loét dạ dày xuất hiện ở phần đầu tiên của ruột non, được gọi là tá tràng. Loét dạ dày là vết loét hở ở', n.prognosis = 'Loét dạ dày tá tràng có xu hướng quay trở lại nếu không được điều trị. Rất có khả năng nhiễm H pylori sẽ được chữa khỏi nếu bạn dùng thuốc và làm theo lời khuyên của bác sĩ. Bạn sẽ ít có khả năng bị l', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn nôn ra máu, có máu sẫm màu trong phân hoặc cảm thấy chóng mặt. Đồng thời, hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn nếu thuốc kháng axit và ';
MERGE (n:Disease {id: 'D2249'}) SET n.id = 'D2249', n.name = 'Thủ thuật thận qua da', n.name_en = 'Percutaneous kidney procedures', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007375.htm', n.overview = 'Phẫu thuật cắt thận qua da là đặt một ống nhỏ, linh hoạt (ống thông) qua da vào thận để thoát nước tiểu. Nó được đưa vào qua lưng hoặc sườn của bạn. Phẫu thuật lấy sỏi thận qua da (hoặc phẫu thuật lấy', n.prognosis = 'Phẫu thuật lấy sỏi thận qua da hoặc lấy sỏi thận hầu như luôn giúp giảm bớt các triệu chứng của sỏi thận. Thông thường, bác sĩ phẫu thuật có thể loại bỏ hoàn toàn sỏi thận của bạn. Đôi khi bạn cần phả';
MERGE (n:Disease {id: 'D2250'}) SET n.id = 'D2250', n.name = 'Viêm mô tế bào liên cầu quanh hậu môn', n.name_en = 'Perianal streptococcal cellulitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001346.htm', n.prognosis = 'Trẻ em thường hồi phục nhanh chóng khi điều trị bằng kháng sinh. Điều quan trọng là liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu con bạn không sớm khỏi bệnh sau khi dùng kháng si', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu con bạn kêu đau ở vùng trực tràng, đau khi đi tiêu hoặc các triệu chứng khác của viêm mô tế bào liên cầu quanh hậu môn. Nếu con b';
MERGE (n:Disease {id: 'D2251'}) SET n.id = 'D2251', n.name = 'Tràn dịch màng ngoài tim', n.name_en = 'Pericardial effusion', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pericardial-effusion/symptoms-causes/syc-20353720', n.overview = '(per-e-KAHR-dee-ul uh-FU-zhun) là sự tích tụ quá nhiều chất lỏng trong túi quanh tim. Túi được gọi là màng ngoài tim. Nó có hai lớp. Khoảng trống giữa các lớp này thường có một lớp chất lỏng mỏng. Như', n.when_to_see = 'Hãy gọi 911 hoặc số điện thoại khẩn cấp tại địa phương nếu bạn bị: Đau ngực kéo dài hơn vài phút. Thở khó khăn hoặc đau đớn. Ngất xỉu không rõ nguyên nhân.';
MERGE (n:Disease {id: 'D2252'}) SET n.id = 'D2252', n.name = 'Viêm màng ngoài tim', n.name_en = 'Pericarditis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/pericarditis/symptoms-causes/syc-20352510 | https://medlineplus.gov/ency/article/000182.htm', n.overview = 'cho tim (màng ngoài tim). Tim bên phải có lớp niêm mạc bị sưng và nhiễm trùng (viêm màng ngoài tim). Viêm màng ngoài tim là tình trạng sưng tấy và kích ứng các mô mỏng, giống như túi bao quanh tim. Mô', n.prognosis = 'Viêm màng ngoài tim có thể từ bệnh nhẹ tự khỏi đến tình trạng đe dọa tính mạng. Chất lỏng tích tụ quanh tim và chức năng tim kém có thể làm phức tạp thêm tình trạng rối loạn. Kết quả sẽ tốt nếu viêm m', n.when_to_see = 'Nhận chăm sóc y tế ngay lập tức nếu bạn có triệu chứng đau ngực mới. Nhiều triệu chứng của viêm màng ngoài tim giống như các bệnh về tim và phổi khác. Điều quan trọng là phải được chuyên gia chăm sóc ';
MERGE (n:Disease {id: 'D2253'}) SET n.id = 'D2253', n.name = 'Viêm màng ngoài tim - sau cơn đau tim', n.name_en = 'Pericarditis - after heart attack', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000166.htm', n.prognosis = 'Tình trạng này có thể tái diễn trong một số trường hợp.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn xuất hiện các triệu chứng của viêm màng ngoài tim sau một cơn đau tim Bạn đã được chẩn đoán mắc bệnh viêm màng ngoài tim và các triệu chứng vẫn ti';
MERGE (n:Disease {id: 'D2254'}) SET n.id = 'D2254', n.name = 'Viêm màng ngoài tim - co thắt', n.name_en = 'Pericarditis - constrictive', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001103.htm', n.prognosis = 'Viêm màng ngoài tim co thắt có thể đe dọa tính mạng nếu không được điều trị. Tuy nhiên, phẫu thuật để điều trị tình trạng này có nguy cơ biến chứng cao. Vì lý do này, nó thường được thực hiện ở những ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của viêm màng ngoài tim co thắt.';
MERGE (n:Disease {id: 'D2255'}) SET n.id = 'D2255', n.name = 'Tiền mãn kinh', n.name_en = 'Perimenopause', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/perimenopause/symptoms-causes/syc-20354666', n.overview = 'là thời điểm trước khi mãn kinh khi cơ thể bạn đã sẵn sàng để ngừng kinh nguyệt. Tiền mãn kinh đôi khi được gọi là giai đoạn chuyển tiếp mãn kinh. Phụ nữ bắt đầu tiền mãn kinh ở các độ tuổi khác nhau.', n.when_to_see = 'Một số phụ nữ đến gặp chuyên gia chăm sóc sức khỏe để biết các triệu chứng tiền mãn kinh của họ. Nhưng những người khác lại chấp nhận những thay đổi hoặc không có những triệu chứng khiến họ bận tâm. B';
MERGE (n:Disease {id: 'D2256'}) SET n.id = 'D2256', n.name = 'Viêm nha chu', n.name_en = 'Periodontitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/periodontitis/symptoms-causes/syc-20354473 | https://medlineplus.gov/ency/article/001059.htm', n.overview = 'd đến mất răng, tiêu xương và các biến chứng nghiêm trọng khác về sức khỏe. Viêm nha chu (per-e-o-don-TIE-tis), còn gọi là bệnh nướu răng, là một bệnh nhiễm trùng nướu nghiêm trọng làm tổn thương mô m', n.prognosis = 'Một số người thấy việc loại bỏ mảng bám răng khỏi nướu bị viêm là rất khó chịu. Bạn có thể cần phải bị tê trong quá trình này. Chảy máu và đau nướu sẽ hết trong vòng 3 đến 4 tuần sau khi điều trị. Bạn', n.when_to_see = 'Gặp nha sĩ nếu bạn có dấu hiệu của bệnh nướu răng.';
MERGE (n:Disease {id: 'D2257'}) SET n.id = 'D2257', n.name = 'Viêm da quanh miệng', n.name_en = 'Perioral dermatitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001455.htm', n.prognosis = 'Viêm da quanh miệng cần điều trị vài tháng. Các vết sưng có thể quay trở lại. Tuy nhiên, tình trạng này không quay trở lại sau khi điều trị trong hầu hết các trường hợp. Phát ban có nhiều khả năng qua', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nhận thấy những vết sưng đỏ quanh miệng không biến mất.';
MERGE (n:Disease {id: 'D2258'}) SET n.id = 'D2258', n.name = 'Viêm mô tế bào quanh mắt', n.name_en = 'Periorbital cellulitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000976.htm', n.prognosis = 'Viêm mô tế bào quanh ổ mắt hầu như luôn được cải thiện khi điều trị. Trong một số ít trường hợp, nhiễm trùng lan vào hốc mắt, dẫn đến viêm mô tế bào hốc mắt.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn ngay lập tức nếu: Mắt trở nên đỏ hoặc sưng Các triệu chứng trở nên tồi tệ hơn sau khi điều trị Sốt phát triển cùng với các triệu chứng ở mắt Rất khó hoặc đau khi di ch';
MERGE (n:Disease {id: 'D2259'}) SET n.id = 'D2259', n.name = 'Bệnh cơ tim chu sinh', n.name_en = 'Peripartum cardiomyopathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000188.htm', n.prognosis = 'Có một số kết quả có thể xảy ra đối với bệnh cơ tim chu sinh. Một số phụ nữ vẫn ổn định trong thời gian dài, trong khi những người khác lại trở nên tồi tệ hơn từ từ. Những người khác trở nên tồi tệ hơ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hiện đang mang thai hoặc mới sinh con và cho rằng bạn có thể có các dấu hiệu của bệnh cơ tim. Nhận trợ giúp y tế ngay lập tức nếu';
MERGE (n:Disease {id: 'D2260'}) SET n.id = 'D2260', n.name = 'Phẫu thuật bắc cầu động mạch ngoại biên - chân', n.name_en = 'Peripheral artery bypass - leg', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007394.htm', n.overview = 'Phẫu thuật bắc cầu động mạch ngoại biên có thể được thực hiện ở một hoặc nhiều mạch máu sau: Động mạch chủ (động mạch chính xuất phát từ tim của bạn) Động mạch ở hông Động mạch ở đùi Động mạch phía sa', n.prognosis = 'Phẫu thuật bắc cầu giúp cải thiện lưu lượng máu trong động mạch cho hầu hết mọi người. Bạn có thể không còn triệu chứng nữa, ngay cả khi bạn đi bộ. Nếu bạn vẫn còn các triệu chứng, bạn có thể đi bộ xa';
MERGE (n:Disease {id: 'D2261'}) SET n.id = 'D2261', n.name = 'Bệnh động mạch ngoại biên (PAD)', n.name_en = 'Peripheral artery disease (PAD)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/peripheral-artery-disease/symptoms-causes/syc-20350557', n.overview = 'Đau cách hồi khi đi bộ hoặc sử dụng tay. Cơn đau xảy ra do lưu lượng máu đến chân hoặc cánh tay quá ít. Đau cách hồi thường là triệu chứng của bệnh động mạch ngoại biên, trong đó các động mạch cung cấ', n.when_to_see = 'Hãy hẹn khám sức khỏe nếu bạn bị đau chân, tay hoặc các triệu chứng khác của bệnh động mạch ngoại biên. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông ';
MERGE (n:Disease {id: 'D2262'}) SET n.id = 'D2262', n.name = 'Bệnh động mạch ngoại biên - chân', n.name_en = 'Peripheral artery disease - legs', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000170.htm', n.prognosis = 'Hầu hết các trường hợp PAD ở chân có thể được kiểm soát mà không cần phẫu thuật. Mặc dù phẫu thuật giúp giảm triệu chứng tốt trong những trường hợp nặng, nhưng các thủ thuật nong mạch và đặt stent đan', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Chân hoặc bàn chân trở nên mát khi chạm vào, nhợt nhạt, xanh hoặc tê Đau ngực hoặc khó thở kèm theo đau chân Đau chân không biến mất, ngay cả khi b';
MERGE (n:Disease {id: 'D2263'}) SET n.id = 'D2263', n.name = 'Đường truyền tĩnh mạch ngoại vi - trẻ sơ sinh', n.name_en = 'Peripheral intravenous line - infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007245.htm', n.overview = 'TẠI SAO SỬ DỤNG PIV? Nhà cung cấp sử dụng PIV để truyền chất lỏng hoặc thuốc cho em bé. PIV ĐƯỢC ĐẶT NHƯ THẾ NÀO? Nhà cung cấp của bạn sẽ: Làm sạch da. Cắm ống thông nhỏ có đầu kim xuyên qua da vào tĩ';
MERGE (n:Disease {id: 'D2264'}) SET n.id = 'D2264', n.name = 'Chấn thương dây thần kinh ngoại biên', n.name_en = 'Peripheral nerve injuries', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/peripheral-nerve-injuries/symptoms-causes/syc-20355631', n.overview = 'Dây thần kinh ngoại biên gửi thông điệp từ não và tủy sống đến phần còn lại của cơ thể. Chúng giúp làm những việc như di chuyển các cơ của cơ thể để đi lại và cảm nhận bàn chân lạnh. Các dây thần kinh', n.when_to_see = 'Nếu bạn thấy yếu, ngứa ran, tê hoặc mất cảm giác hoàn toàn, hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn để tìm ra nguyên nhân. Điều quan trọng là phải điều trị sớm chấn thương dây thần kinh ngoại';
MERGE (n:Disease {id: 'D2265'}) SET n.id = 'D2265', n.name = 'Khối u thần kinh ngoại biên', n.name_en = 'Peripheral nerve tumors', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/peripheral-nerve-tumors/symptoms-causes/syc-20355070', n.overview = 'Schwannoma ở cơ và xương chân. Hình minh họa này cho thấy u schwannoma của dây thần kinh chày ở chân. Khối u quả tạ hape của một quả tạ. Loại khối u này xảy ra ở cột sống và vùng bụng dưới và đan xen ', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ triệu chứng nào được liệt kê, đặc biệt nếu bạn có khối u phát triển nhanh chóng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2266'}) SET n.id = 'D2266', n.name = 'Bệnh lý thần kinh ngoại biên', n.name_en = 'Peripheral neuropathy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/peripheral-neuropathy/symptoms-causes/syc-20352061 | https://medlineplus.gov/ency/article/000593.htm', n.overview = 'xảy ra khi các dây thần kinh nằm bên ngoài não và tủy sống (dây thần kinh ngoại biên) bị tổn thương. Tình trạng này thường gây ra tình trạng yếu, tê và đau, thường ở tay và chân. Nó cũng có thể ảnh hư', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào nguyên nhân và thời gian tổn thương thần kinh. Một số vấn đề liên quan đến thần kinh không ảnh hưởng tới cuộc sống hàng ngày. Những người khác trở nên tồi tệ nhan', n.when_to_see = 'Tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn nhận thấy ngứa ran, yếu hoặc đau bất thường ở tay hoặc chân. Chẩn đoán và điều trị sớm mang lại cho bạn cơ hội tốt nhất để kiểm soát các triệu chứng và n';
MERGE (n:Disease {id: 'D2267'}) SET n.id = 'D2267', n.name = 'Ung thư hạch tế bào T ngoại vi', n.name_en = 'Peripheral T-cell lymphoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/peripheral-t-cell-lymphoma/symptoms-causes/syc-20599094', n.overview = '(PTCL) là một loại ung thư hạch phát triển nhanh. Ung thư hạch là một loại ung thư ảnh hưởng đến tế bào lympho, một loại tế bào bạch cầu. Các tế bào bạch cầu là một phần của hệ thống miễn dịch chống v', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng hoặc không biến mất. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2268'}) SET n.id = 'D2268', n.name = 'Nhiễm trùng quanh khớp giả (PJI)', n.name_en = 'Periprosthetic joint infection (PJI)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/periprosthetic-joint-infection/symptoms-causes/syc-20597706', n.overview = 'Nhiễm trùng quanh khớp giả (PJI) xảy ra khi vi khuẩn hoặc các vi sinh vật khác lây nhiễm vào khu vực trong và xung quanh khớp cấy ghép. Điều này có thể bao gồm nhiễm trùng quanh khớp háng, đầu gối, va', n.when_to_see = 'Hãy gọi cho bác sĩ phẫu thuật của bạn hoặc tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn đã được thay khớp và nhận thấy những dấu hiệu nhiễm trùng nghiêm trọng sau: Sốt cộng với đau khớp, sưng và nón';
MERGE (n:Disease {id: 'D2269'}) SET n.id = 'D2269', n.name = 'Áp xe quanh thận', n.name_en = 'Perirenal abscess', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001274.htm', n.prognosis = 'Nói chung, chẩn đoán và điều trị nhanh chóng áp xe quanh thận sẽ mang lại kết quả tốt. Sỏi thận phải được điều trị để tránh nhiễm trùng thêm. Trong một số ít trường hợp, nhiễm trùng có thể lan ra ngoà', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có tiền sử sỏi thận và phát triển: Đau bụng Nóng rát khi đi tiểu Ớn lạnh Sốt Nhiễm trùng đường tiết niệu';
MERGE (n:Disease {id: 'D2270'}) SET n.id = 'D2270', n.name = 'Ung thư biểu mô phúc mạc', n.name_en = 'Peritoneal carcinomatosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/peritoneal-carcinomatosis/symptoms-causes/syc-20585171', n.overview = 'là một tình trạng nghiêm trọng xảy ra khi ung thư lan đến niêm mạc bụng, gọi là phúc mạc. Ung thư biểu mô phúc mạc thường xuất phát từ bệnh ung thư bắt đầu ở các cơ quan khác, chẳng hạn như đại tràng,';
MERGE (n:Disease {id: 'D2271'}) SET n.id = 'D2271', n.name = 'Viêm phúc mạc', n.name_en = 'Peritonitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/peritonitis/symptoms-causes/syc-20376247 | https://medlineplus.gov/ency/article/001335.htm', n.overview = 'là một tình trạng nghiêm trọng bắt đầu từ bụng. Đó là vùng cơ thể nằm giữa ngực và xương chậu. Viêm phúc mạc xảy ra khi lớp mô mỏng bên trong bụng bị viêm. Lớp mô được gọi là phúc mạc. Viêm phúc mạc t', n.when_to_see = 'Viêm phúc mạc có thể nguy hiểm đến tính mạng nếu bạn không được điều trị nhanh chóng. Gọi cho chuyên gia chăm sóc sức khỏe của bạn ngay lập tức nếu bạn bị đau dữ dội hoặc đau bụng, đầy hơi hoặc cảm gi';
MERGE (n:Disease {id: 'D2272'}) SET n.id = 'D2272', n.name = 'Viêm phúc mạc - thứ phát', n.name_en = 'Peritonitis - secondary', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000651.htm', n.prognosis = 'Kết quả có thể từ hồi phục hoàn toàn đến nhiễm trùng nặng và tử vong. Các yếu tố quyết định kết quả bao gồm: Các triệu chứng xuất hiện bao lâu trước khi bắt đầu điều trị Sức khỏe tổng quát của người đ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng viêm phúc mạc. Đây là một tình trạng nghiêm trọng. Nó cần điều trị khẩn cấp trong hầu hết các trường hợp.';
MERGE (n:Disease {id: 'D2273'}) SET n.id = 'D2273', n.name = 'Viêm phúc mạc - vi khuẩn tự phát', n.name_en = 'Peritonitis - spontaneous bacterial', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000648.htm', n.prognosis = 'Trong hầu hết các trường hợp, nhiễm trùng có thể được điều trị. Tuy nhiên, bệnh thận hoặc gan có thể hạn chế khả năng phục hồi.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng viêm phúc mạc. Đây có thể là một tình huống cấp cứu y tế.';
MERGE (n:Disease {id: 'D2274'}) SET n.id = 'D2274', n.name = 'Áp xe quanh amiđan', n.name_en = 'Peritonsillar abscess', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000986.htm', n.prognosis = 'Trong hầu hết các trường hợp, áp xe quanh amiđan sẽ biến mất sau khi điều trị. Nhiễm trùng có thể quay trở lại trong tương lai.', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị viêm amiđan và xuất hiện các triệu chứng của áp xe quanh amiđan. Nhận trợ giúp y tế ngay lập tức nếu bạn gặp: Khó thở Âm ';
MERGE (n:Disease {id: 'D2275'}) SET n.id = 'D2275', n.name = 'Bệnh bạch cầu quanh não thất', n.name_en = 'Periventricular leukomalacia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007232.htm', n.prognosis = 'PVL thường dẫn đến các vấn đề về hệ thần kinh và phát triển ở trẻ đang lớn. Những vấn đề này thường xảy ra nhất trong năm đầu tiên đến năm thứ hai của cuộc đời. Nó có thể gây ra bệnh bại não (CP), đặc';
MERGE (n:Disease {id: 'D2276'}) SET n.id = 'D2276', n.name = 'Thiếu máu ác tính', n.name_en = 'Pernicious anemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000569.htm', n.prognosis = 'Hầu hết mọi người thường làm tốt việc điều trị. Điều quan trọng là phải bắt đầu điều trị sớm. Tổn thương thần kinh có thể là vĩnh viễn nếu việc điều trị không bắt đầu trong vòng 6 tháng kể từ khi có t', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có triệu chứng thiếu vitamin B12.';
MERGE (n:Disease {id: 'D2277'}) SET n.id = 'D2277', n.name = 'Rối loạn trầm cảm dai dẳng', n.name_en = 'Persistent depressive disorder', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/persistent-depressive-disorder/symptoms-causes/syc-20350929 | https://medlineplus.gov/ency/article/000918.htm', n.overview = 'là một dạng trầm cảm kéo dài, liên tục. Bạn có thể cảm thấy buồn bã và trống rỗng, mất hứng thú với các hoạt động hàng ngày và gặp khó khăn trong việc hoàn thành công việc. Bạn cũng có thể có lòng tự ', n.prognosis = 'PDD là một tình trạng mãn tính có thể kéo dài nhiều năm. Nhiều người hồi phục hoàn toàn trong khi những người khác tiếp tục có một số triệu chứng, ngay cả khi được điều trị. PDD cũng làm tăng nguy cơ ', n.when_to_see = 'Nếu những cảm xúc này đã diễn ra trong một thời gian dài, bạn có thể nghĩ rằng chúng sẽ luôn là một phần trong cuộc sống của bạn. Nhưng nếu bạn có bất kỳ triệu chứng rối loạn trầm cảm dai dẳng nào, hã';
MERGE (n:Disease {id: 'D2278'}) SET n.id = 'D2278', n.name = 'Các triệu chứng sau chấn động dai dẳng (Hội chứng sau chấn động)', n.name_en = 'Persistent post-concussive symptoms (Post-concussion syndrome)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/post-concussion-syndrome/symptoms-causes/syc-20353352', n.overview = 'Các triệu chứng sau chấn động dai dẳng là triệu chứng của chấn thương sọ não nhẹ thường kéo dài hơn ba tháng. Các triệu chứng sau chấn động dai dẳng còn được gọi là hội chứng sau chấn động. Các triệu ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn bị chấn thương đầu gây lú lẫn, mất trí nhớ, thay đổi thị lực, buồn nôn, nôn mửa hoặc đau đầu dữ dội đột ngột. Nhận trợ giúp y tế ngay cả khi bạn chưa bao g';
MERGE (n:Disease {id: 'D2279'}) SET n.id = 'D2279', n.name = 'Rối loạn nhân cách', n.name_en = 'Personality disorders', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/personality-disorders/symptoms-causes/syc-20354463 | https://medlineplus.gov/ency/article/000939.htm', n.overview = 'Con người có những tính cách độc đáo được tạo thành từ sự kết hợp phức tạp của nhiều đặc điểm khác nhau. Đặc điểm tính cách ảnh hưởng đến cách mọi người hiểu và liên hệ với thế giới xung quanh, cũng n', n.prognosis = 'Triển vọng sẽ khác nhau. Một số chứng rối loạn nhân cách được cải thiện đáng kể ở tuổi trung niên mà không cần điều trị. Những người khác chỉ cải thiện chậm hoặc không hề cải thiện, ngay cả khi được đ', n.when_to_see = 'Nếu bạn có bất kỳ triệu chứng nào của rối loạn nhân cách, hãy đến gặp bác sĩ hoặc chuyên gia sức khỏe tâm thần. Khi rối loạn nhân cách không được điều trị, chúng có thể gây ra những vấn đề nghiêm trọn';
MERGE (n:Disease {id: 'D2280'}) SET n.id = 'D2280', n.name = 'Ho gà', n.name_en = 'Pertussis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001561.htm', n.prognosis = 'Ở trẻ lớn hơn, triển vọng thường rất tốt. Trẻ sơ sinh có nguy cơ tử vong cao nhất và cần được theo dõi cẩn thận.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc con bạn xuất hiện các triệu chứng ho gà. Gọi 911 hoặc số điện thoại khẩn cấp tại địa phương hoặc đến phòng cấp cứu nếu người đó có bất kỳ triệ';
MERGE (n:Disease {id: 'D2281'}) SET n.id = 'D2281', n.name = 'Dị ứng vật nuôi', n.name_en = 'Pet allergy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pet-allergy/symptoms-causes/syc-20352192', n.overview = 'là phản ứng dị ứng với protein có trong tế bào da, nước bọt hoặc nước tiểu của động vật. Các triệu chứng dị ứng với vật nuôi bao gồm những triệu chứng thường gặp ở bệnh sốt cỏ khô, chẳng hạn như hắt h', n.when_to_see = 'Nếu các triệu chứng của bạn nghiêm trọng - đường mũi có cảm giác bị tắc hoàn toàn, thở khò khè và khó ngủ - hãy gọi cho chuyên gia chăm sóc sức khỏe. Tìm kiếm sự chăm sóc khẩn cấp nếu thở khò khè hoặc';
MERGE (n:Disease {id: 'D2282'}) SET n.id = 'D2282', n.name = 'Quá liều dầu hỏa', n.name_en = 'Petroleum jelly overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002525.htm', n.prognosis = 'Thạch dầu được coi là không độc hại. Có khả năng phục hồi. Các vấn đề về phổi nghiêm trọng hơn có thể dẫn đến việc tiếp xúc lâu dài với các giọt dầu hỏa hít vào.';
MERGE (n:Disease {id: 'D2283'}) SET n.id = 'D2283', n.name = 'Thú cưng và người bị suy giảm miễn dịch', n.name_en = 'Pets and the immunocompromised person', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003967.htm', n.overview = 'Một số người có hệ miễn dịch yếu có thể được khuyên nên từ bỏ thú cưng của mình để tránh mắc bệnh từ động vật. Những người thuộc nhóm này bao gồm những người dùng steroid liều cao hoặc từ 65 tuổi trở ';
MERGE (n:Disease {id: 'D2284'}) SET n.id = 'D2284', n.name = 'Hội chứng Peutz-Jeghers', n.name_en = 'Peutz-Jeghers syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/peutz-jeghers-syndrome/symptoms-causes/syc-20595244 | https://medlineplus.gov/ency/article/000244.htm', n.overview = '(hội chứng POOTZ-JAH-erz) là một tình trạng di truyền hiếm gặp gây ra các khối mô nhỏ gọi là polyp trong đường tiêu hóa. Nó còn gây ra các đốm đen trên môi, miệng, bộ phận sinh dục, bàn tay và bàn châ', n.prognosis = 'Những polyp này có nguy cơ cao trở thành ung thư. Một số nghiên cứu liên kết PJS với bệnh ung thư đường tiêu hóa, phổi, vú, tử cung và buồng trứng.', n.when_to_see = 'Hãy chăm sóc cẩn thận nếu các đốm đen mới xuất hiện trên môi, xung quanh hoặc bên trong miệng, trên bộ phận sinh dục hoặc trên tay hoặc chân, đặc biệt là ở trẻ em. Đây có thể là dấu hiệu ban đầu của P';
MERGE (n:Disease {id: 'D2285'}) SET n.id = 'D2285', n.name = 'Bệnh Peyronie', n.name_en = 'Peyronie\'s disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/peyronies-disease/symptoms-causes/syc-20353468', n.overview = 'Bệnh Peyronie (pay-roe-NEEZ) là tình trạng mô sẹo xơ hình thành ở các mô sâu hơn dưới da dương vật. Điều này gây ra sự cương cứng cong và đau đớn. Nó cũng có thể làm cho dương vật ngắn hơn khi cương c', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn nhận thấy các triệu chứng của bệnh Peyronie. Điều trị sớm mang lại cho bạn cơ hội tốt nhất để cải thiện tình trạng hoặc giữ cho bệnh không trở nên tồi tệ h';
MERGE (n:Disease {id: 'D2286'}) SET n.id = 'D2286', n.name = 'Dược động học', n.name_en = 'Pharmacogenetics', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007794.htm', n.overview = 'là một loại thuốc chính xác. Y học chính xác sử dụng thông tin về gen, môi trường và lối sống của một người để giúp chẩn đoán, ngăn ngừa và điều trị bệnh đặc biệt cho người đó. Dược động học sử dụng t';
MERGE (n:Disease {id: 'D2287'}) SET n.id = 'D2287', n.name = 'Viêm họng - đau họng', n.name_en = 'Pharyngitis - sore throat', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000655.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị đau họng không khỏi sau vài ngày Bạn bị sốt cao, sưng hạch ở cổ hoặc phát ban Hãy tìm kiếm sự chăm sóc y tế ngay nếu bạn bị đau họng và khó thở';
MERGE (n:Disease {id: 'D2288'}) SET n.id = 'D2288', n.name = 'Viêm họng - do vi-rút', n.name_en = 'Pharyngitis - viral', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001392.htm', n.prognosis = 'Các triệu chứng thường biến mất trong vòng 7 đến 10 ngày.', n.when_to_see = 'Hãy hẹn gặp nhà cung cấp dịch vụ của bạn nếu các triệu chứng kéo dài hơn dự kiến ​​hoặc không cải thiện khi tự chăm sóc. Luôn tìm kiếm sự chăm sóc y tế nếu bạn bị đau họng và cực kỳ khó chịu hoặc khó ';
MERGE (n:Disease {id: 'D2289'}) SET n.id = 'D2289', n.name = 'Quá liều Phencyclidine', n.name_en = 'Phencyclidine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002526.htm', n.prognosis = 'Kết quả phụ thuộc vào một số yếu tố, bao gồm: Lượng PCP trong cơ thể Thời gian từ khi dùng thuốc đến khi được điều trị Quá trình phục hồi khỏi trạng thái loạn thần có thể mất vài tuần. Người đó nên ở ';
MERGE (n:Disease {id: 'D2290'}) SET n.id = 'D2290', n.name = 'Quá liều pheniramine', n.name_en = 'Pheniramine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002529.htm', n.prognosis = 'Nếu người đó sống sót sau 24 giờ đầu, cơ hội phục hồi là rất tốt. Rất ít người chết vì dùng thuốc kháng histamine quá liều. Với liều lượng thuốc kháng histamine cực cao, rối loạn nhịp tim nghiêm trọng';
MERGE (n:Disease {id: 'D2291'}) SET n.id = 'D2291', n.name = 'Quá liều phenobarbital', n.name_en = 'Phenobarbital overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002530.htm', n.prognosis = 'Tình trạng sức khỏe của người đó phụ thuộc vào mức độ nghiêm trọng của quá liều và tốc độ điều trị được tiếp nhận. Nếu được điều trị thích hợp, mọi người có thể hồi phục sau 1 đến 5 ngày. Những người ';
MERGE (n:Disease {id: 'D2292'}) SET n.id = 'D2292', n.name = 'Quá liều phenothiazine', n.name_en = 'Phenothiazine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002597.htm', n.prognosis = 'Phenothiazin khá an toàn. Rất có thể, quá liều sẽ chỉ gây buồn ngủ và một số tác dụng phụ như cử động không kiểm soát của môi, mắt, đầu và cổ trong thời gian ngắn. Những chuyển động này có thể tiếp tụ';
MERGE (n:Disease {id: 'D2293'}) SET n.id = 'D2293', n.name = 'Phenylketonuria', n.name_en = 'Phenylketonuria', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001166.htm', n.prognosis = 'Kết quả dự kiến ​​sẽ rất tốt nếu chế độ ăn kiêng được tuân thủ chặt chẽ, bắt đầu ngay sau khi trẻ chào đời. Nếu điều trị bị trì hoãn hoặc tình trạng vẫn không được điều trị, tổn thương não sẽ xảy ra. ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu trẻ sơ sinh của bạn chưa được xét nghiệm PKU. Điều này đặc biệt quan trọng nếu có ai trong gia đình bạn mắc chứng rối loạn này.';
MERGE (n:Disease {id: 'D2294'}) SET n.id = 'D2294', n.name = 'Phenylketonuria (PKU)', n.name_en = 'Phenylketonuria (PKU)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/phenylketonuria/symptoms-causes/syc-20376302', n.overview = 'Phenylketonuria (fen-ul-key-toe-NU-ree-uh), còn được gọi là PKU, là một chứng rối loạn di truyền hiếm gặp khiến một loại axit amin gọi là phenylalanine tích tụ trong cơ thể. PKU được gây ra bởi sự tha', n.when_to_see = 'Nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn trong những tình huống sau: Trẻ sơ sinh. Nếu các xét nghiệm sàng lọc trẻ sơ sinh định kỳ cho thấy con bạn có thể bị PKU, nhà cung cấp dịch';
MERGE (n:Disease {id: 'D2295'}) SET n.id = 'D2295', n.name = 'Quá liều phenytoin', n.name_en = 'Phenytoin overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002533.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào mức độ nghiêm trọng của quá liều và tốc độ điều trị được tiếp nhận nhanh như thế nào. Nếu hôn mê kéo dài, suy hô hấp và sốc (tổn thương nhiều cơ quan nội tạng), hậ';
MERGE (n:Disease {id: 'D2296'}) SET n.id = 'D2296', n.name = 'U tế bào ưa crom', n.name_en = 'Pheochromocytoma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/pheochromocytoma/symptoms-causes/syc-20355367 | https://medlineplus.gov/ency/article/000340.htm', n.overview = 'và huyết áp không đều. U tế bào ưa crom có ​​thể gây ra những thay đổi lớn về huyết áp. Khi điều đó xảy ra, nó được gọi là bùa chú. Huyết áp có thể trở lại mức bình thường giữa các đợt. Điều đó có thể', n.prognosis = 'Hầu hết những người có khối u không phải ung thư được cắt bỏ bằng phẫu thuật vẫn còn sống sau 5 năm. Các khối u quay trở lại ở một số người. Mức độ hormone norepinephrine và epinephrine trở lại bình t', n.when_to_see = 'Huyết áp cao là một trong những triệu chứng chính của u tủy thượng thận. Nhưng hầu hết những người bị huyết áp cao đều không có khối u tuyến thượng thận. Nói chuyện với chuyên gia chăm sóc sức khỏe củ';
MERGE (n:Disease {id: 'D2297'}) SET n.id = 'D2297', n.name = 'Ngộ độc Philodendron', n.name_en = 'Philodendron poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002872.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào lượng chất độc nuốt vào và tốc độ điều trị. Bạn nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Trong một số ít trường hợp, tình trạng sưng tấy n';
MERGE (n:Disease {id: 'D2298'}) SET n.id = 'D2298', n.name = 'Phlegmasia cerulea dolens', n.name_en = 'Phlegmasia cerulea dolens', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000200.htm', n.when_to_see = 'Hãy tìm kiếm sự trợ giúp y tế ngay lập tức nếu cánh tay hoặc chân bị sưng tấy, xanh xao hoặc đau đớn nghiêm trọng.';
MERGE (n:Disease {id: 'D2299'}) SET n.id = 'D2299', n.name = 'Nỗi ám ảnh - đơn giản/cụ thể', n.name_en = 'Phobia - simple/specific', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000956.htm', n.prognosis = 'Nỗi ám ảnh có xu hướng tiếp diễn nhưng chúng có thể đáp ứng với việc điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn để đặt lịch hẹn nếu nỗi ám ảnh đó cản trở các hoạt động trong cuộc sống.';
MERGE (n:Disease {id: 'D2300'}) SET n.id = 'D2300', n.name = 'Rối loạn âm vị', n.name_en = 'Phonological disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001541.htm', n.prognosis = 'Kết quả phụ thuộc vào độ tuổi bắt đầu mắc chứng rối loạn và mức độ nghiêm trọng của nó. Nhiều trẻ sẽ tiếp tục phát triển khả năng nói gần như bình thường.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn: Vẫn khó hiểu trước 4 tuổi Vẫn không thể phát ra một số âm thanh nhất định trước 6 tuổi Bỏ đi, thay đổi hoặc thay thế một số âm thanh nhất định';
MERGE (n:Disease {id: 'D2301'}) SET n.id = 'D2301', n.name = 'Ngộ độc thuốc cố định khi chụp ảnh', n.name_en = 'Photographic fixative poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002732.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc được nuốt vào và tốc độ người đó được trợ giúp y tế. Nuốt phải những sản phẩm này có thể gây ra những ảnh hưởng nghiêm trọng ở nhiều bộ phận trên cơ';
MERGE (n:Disease {id: 'D2302'}) SET n.id = 'D2302', n.name = 'Chứng sợ ánh sáng', n.name_en = 'Photophobia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003041.htm', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Độ nhạy sáng nghiêm trọng hoặc đau đớn. (Ví dụ: bạn cần đeo kính râm trong nhà.) Nhạy cảm xảy ra kèm theo đau đầu, đỏ mắt hoặc mờ mắt hoặc không biến mất sau một ';
MERGE (n:Disease {id: 'D2303'}) SET n.id = 'D2303', n.name = 'Hoạt động thể chất', n.name_en = 'Physical activity', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001941.htm', n.overview = 'Một chương trình tập luyện hiệu quả cần phải mang lại niềm vui và giúp bạn có động lực. Nó giúp để có một mục tiêu. Mục tiêu của bạn có thể là: Quản lý tình trạng sức khỏe Giảm căng thẳng Cải thiện sứ';
MERGE (n:Disease {id: 'D2304'}) SET n.id = 'D2304', n.name = 'Tần suất khám sức khỏe', n.name_en = 'Physical exam frequency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002125.htm', n.overview = 'Tất cả người lớn thỉnh thoảng nên đến gặp nhà cung cấp dịch vụ của mình, ngay cả khi họ khỏe mạnh. Mục đích của những lần khám này là: Sàng lọc bệnh Đánh giá và giúp giảm nguy cơ mắc các vấn đề y tế t';
MERGE (n:Disease {id: 'D2305'}) SET n.id = 'D2305', n.name = 'Vật lý trị liệu và phục hồi chức năng', n.name_en = 'Physical medicine and rehabilitation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007448.htm', n.overview = 'Nhiều chấn thương hoặc tình trạng y tế có thể ảnh hưởng đến khả năng hoạt động của bạn, bao gồm: Rối loạn não, chẳng hạn như đột quỵ, bệnh đa xơ cứng hoặc bại não Chấn thương não Đau lâu dài (mãn tính';
MERGE (n:Disease {id: 'D2306'}) SET n.id = 'D2306', n.name = 'Pica', n.name_en = 'Pica', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001538.htm', n.prognosis = 'Mức độ thành công của việc điều trị là khác nhau. Trong nhiều trường hợp, chứng rối loạn này kéo dài vài tháng rồi tự biến mất. Trong một số trường hợp, tình trạng này có thể tiếp tục kéo dài đến tuổi', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn nhận thấy con bạn (hoặc người lớn) đang ăn các nguyên liệu phi thực phẩm.';
MERGE (n:Disease {id: 'D2307'}) SET n.id = 'D2307', n.name = 'Trình tự Pierre Robin', n.name_en = 'Pierre Robin sequence', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001607.htm', n.prognosis = 'Các vấn đề về nghẹn và bú có thể tự hết trong vài năm đầu khi hàm dưới phát triển đến kích thước bình thường hơn. Có nguy cơ cao xảy ra vấn đề nếu đường thở của trẻ không được bảo vệ khỏi bị tắc nghẽn', n.when_to_see = 'Trẻ sinh ra mắc chứng bệnh này thường được chẩn đoán khi mới sinh. Liên hệ với nhà cung cấp của bạn nếu con bạn bị nghẹn hoặc khó thở. Sự tắc nghẽn đường thở có thể gây ra tiếng ồn the thé khi trẻ hít';
MERGE (n:Disease {id: 'D2308'}) SET n.id = 'D2308', n.name = 'U tế bào hình sao Pilocytic', n.name_en = 'Pilocytic astrocytoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pilocytic-astrocytoma/symptoms-causes/syc-20587366', n.overview = '(py-loh-SIT-ik as-troh-sih-TOH-muh) là một khối u não phát triển chậm thường ảnh hưởng đến trẻ em và thanh thiếu niên. Thuật ngữ "pilocytic" dùng để chỉ hình dạng dài giống như sợi tóc của tế bào khi ';
MERGE (n:Disease {id: 'D2309'}) SET n.id = 'D2309', n.name = 'U nang lông', n.name_en = 'Pilonidal cyst', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pilonidal-cyst/symptoms-causes/syc-20376329', n.overview = 'thường chứa các mảnh vụn tóc và da. U nang lông hầu như luôn ở gần xương cụt ở phía trên mông. U nang lông (pie-low-NIE-dul) là một túi bất thường trên da thường chứa lông và mảnh vụn da. U nang hầu n', n.when_to_see = 'Nếu bạn nhận thấy bất kỳ triệu chứng nào của u nang lông, hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cậ';
MERGE (n:Disease {id: 'D2310'}) SET n.id = 'D2310', n.name = 'Bệnh xoang lông tơ', n.name_en = 'Pilonidal sinus disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003253.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy bất kỳ điều nào sau đây xung quanh u nang lông: Chảy mủ Đỏ Sưng tấy Đau nhức';
MERGE (n:Disease {id: 'D2311'}) SET n.id = 'D2311', n.name = 'Dây thần kinh bị chèn ép', n.name_en = 'Pinched nerve', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pinched-nerve/symptoms-causes/syc-20354746', n.overview = 'Dây thần kinh bị chèn ép xảy ra khi có quá nhiều áp lực được tác động lên dây thần kinh bởi các mô xung quanh, chẳng hạn như xương, sụn, cơ hoặc gân. Áp lực này có thể gây đau, ngứa ran, tê hoặc yếu. ', n.when_to_see = 'Các biện pháp tự chăm sóc như nghỉ ngơi và dùng thuốc giảm đau không cần kê đơn có thể giải quyết các triệu chứng của dây thần kinh bị chèn ép. Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu các tri';
MERGE (n:Disease {id: 'D2312'}) SET n.id = 'D2312', n.name = 'Ngộ độc dầu thông', n.name_en = 'Pine oil poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002733.htm', n.prognosis = 'Một người khỏe mạnh như thế nào phụ thuộc vào lượng chất độc nuốt phải và tốc độ điều trị. Nuốt phải dầu thông có thể gây ảnh hưởng nghiêm trọng đến nhiều bộ phận trên cơ thể. Trong hầu hết các trường';
MERGE (n:Disease {id: 'D2313'}) SET n.id = 'D2313', n.name = 'Khối u tuyến tùng', n.name_en = 'Pineal gland tumor', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pineal-gland-tumor/symptoms-causes/syc-20595264', n.overview = 'Khối u tuyến tùng là một khối u hình thành trong tuyến tùng, một cấu trúc nhỏ nằm sâu trong trung tâm não. Tuyến tùng giúp kiểm soát giấc ngủ bằng cách giải phóng một loại hormone gọi là melatonin. Kh';
MERGE (n:Disease {id: 'D2314'}) SET n.id = 'D2314', n.name = 'U nguyên bào thông', n.name_en = 'Pineoblastoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pineoblastoma/symptoms-causes/syc-20577723', n.overview = 'là một loại ung thư bắt đầu từ tuyến tùng của não. Tuyến tùng nằm ở trung tâm của não. Tuyến này tạo ra một loại hormone gọi là melatonin. Melatonin đóng một vai trò trong chu kỳ đánh thức giấc ngủ tự', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn hoặc con bạn có các triệu chứng khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2315'}) SET n.id = 'D2315', n.name = 'Pinguecula', n.name_en = 'Pinguecula', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001025.htm', n.prognosis = 'Tình trạng này không phải ung thư ( lành tính ) và tiên lượng tốt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu màng tế bào thay đổi về kích thước, hình dạng hoặc màu sắc hoặc nếu bạn muốn loại bỏ nó.';
MERGE (n:Disease {id: 'D2316'}) SET n.id = 'D2316', n.name = 'Mắt hồng (viêm kết mạc)', n.name_en = 'Pink eye (conjunctivitis)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pink-eye/symptoms-causes/syc-20376355', n.overview = 'Các dấu hiệu có thể có của bệnh viêm kết mạc mắt hồng (viêm kết mạc)) Mắt hồng là tình trạng viêm hoặc nhiễm trùng màng trong suốt dọc mí mắt và nhãn cầu của bạn. Các triệu chứng điển hình bao gồm đỏ ', n.when_to_see = 'Có những tình trạng nghiêm trọng về mắt có thể gây đỏ mắt. Những tình trạng này có thể gây đau mắt, cảm giác có vật gì đó mắc kẹt trong mắt, mờ mắt và nhạy cảm với ánh sáng. Nếu bạn gặp những triệu ch';
MERGE (n:Disease {id: 'D2317'}) SET n.id = 'D2317', n.name = 'Nhiễm giun kim', n.name_en = 'Pinworm infection', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pinworm/symptoms-causes/syc-20376382', n.overview = 'Nhiễm giun kim là một trong những bệnh nhiễm giun phổ biến nhất trên toàn thế giới. Giun kim mỏng và có màu trắng. Chúng dài khoảng 1/4 đến 1/2 inch - khoảng 6 đến 13 mm. Nhiễm giun kim là do nuốt hoặ', n.when_to_see = 'Hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn bị ngứa hậu môn nghiêm trọng, đặc biệt là vào ban đêm.';
MERGE (n:Disease {id: 'D2318'}) SET n.id = 'D2318', n.name = 'Giun kim', n.name_en = 'Pinworms', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001152.htm', n.prognosis = 'Nhiễm giun kim hoàn toàn có thể điều trị được bằng thuốc tẩy giun.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để lấy hẹn nếu: Bạn hoặc con bạn có các triệu chứng nhiễm giun kim Bạn đã thấy con mình bị nhiễm giun kim';
MERGE (n:Disease {id: 'D2319'}) SET n.id = 'D2319', n.name = 'Piperonyl butoxide với ngộ độc pyrethrins', n.name_en = 'Piperonyl butoxide with pyrethrins poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002589.htm', n.prognosis = 'Hầu hết các triệu chứng đều gặp ở những người bị dị ứng với pyrethrins. Piperonyl butoxide không độc lắm nhưng phơi nhiễm quá mức có thể dẫn đến các triệu chứng nghiêm trọng hơn.';
MERGE (n:Disease {id: 'D2320'}) SET n.id = 'D2320', n.name = 'Quá liều piroxicam', n.name_en = 'Piroxicam overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002534.htm', n.prognosis = 'Có thể hồi phục bằng điều trị y tế kịp thời, ngoại trừ khi dùng quá liều rất lớn. Một số người có thể bị tổn thương gan hoặc thận mãn tính.';
MERGE (n:Disease {id: 'D2321'}) SET n.id = 'D2321', n.name = 'Ngập máu tuyến yên', n.name_en = 'Pituitary apoplexy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001167.htm', n.prognosis = 'Chứng tắc tuyến yên cấp tính có thể đe dọa tính mạng. Triển vọng tốt cho những người bị suy tuyến yên lâu dài (mãn tính) được chẩn đoán và điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có bất kỳ triệu chứng nào của bệnh suy tuyến yên mãn tính. Hãy đến phòng cấp cứu hoặc gọi số cấp cứu tại địa phương (chẳng hạn như 911) nếu bạn có ';
MERGE (n:Disease {id: 'D2322'}) SET n.id = 'D2322', n.name = 'Khối u tuyến yên', n.name_en = 'Pituitary tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000704.htm', n.prognosis = 'Nếu khối u có thể được phẫu thuật cắt bỏ thì tiên lượng từ khá đến tốt, tùy thuộc vào việc liệu toàn bộ khối u có được cắt bỏ hay không.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn phát triển bất kỳ triệu chứng nào của khối u tuyến yên.';
MERGE (n:Disease {id: 'D2323'}) SET n.id = 'D2323', n.name = 'Khối u tuyến yên và u tuyến', n.name_en = 'Pituitary tumors and adenomas', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pituitary-tumors/symptoms-causes/syc-20350548', n.overview = 'Khối u tuyến yên tuyến yên gần não. Những khối u này có thể gây ra sự thay đổi nồng độ hormone. Hình minh họa này cho thấy một khối u nhỏ hơn, được gọi là u tuyến nhỏ. Khối u tuyến yên là sự tăng trưở', n.when_to_see = 'Nếu bạn nhận thấy các triệu chứng có thể liên quan đến khối u tuyến yên, hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn. Điều trị thường xuyên có thể đưa hormone trở lại mức khỏe mạnh và giảm bớt cá';
MERGE (n:Disease {id: 'D2324'}) SET n.id = 'D2324', n.name = 'Bệnh vảy phấn alba', n.name_en = 'Pityriasis alba', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001463.htm', n.prognosis = 'Bệnh vảy phấn trắng thường tự biến mất với các mảng trở lại sắc tố bình thường trong nhiều tháng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn có các mảng da bị giảm sắc tố.';
MERGE (n:Disease {id: 'D2325'}) SET n.id = 'D2325', n.name = 'Bệnh vảy phấn hồng', n.name_en = 'Pityriasis rosea', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/pityriasis-rosea/symptoms-causes/syc-20376405 | https://medlineplus.gov/ency/article/000871.htm', n.overview = 'là bệnh phát ban thường bắt đầu bằng một đốm hình bầu dục trên mặt, ngực, bụng hoặc lưng. Đây được gọi là miếng vá báo trước và có thể có chiều ngang lên tới 4 inch (10 cm). Sau đó, bạn có thể có nhữn', n.prognosis = 'Bệnh vảy phấn hồng thường khỏi trong vòng 4 đến 8 tuần. Nó thường không quay trở lại.', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị phát ban nặng hơn hoặc không khỏi trong ba tháng.';
MERGE (n:Disease {id: 'D2326'}) SET n.id = 'D2326', n.name = 'Pityrheim rubra pilaris', n.name_en = 'Pityriasis rubra pilaris', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001471.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn xuất hiện các triệu chứng của PRP. Đồng thời liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có tình trạng và các triệu chứng trở nên tồi tệ hơn.';
MERGE (n:Disease {id: 'D2327'}) SET n.id = 'D2327', n.name = 'Nhau thai accreta', n.name_en = 'Placenta accreta', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/placenta-accreta/symptoms-causes/syc-20376431', n.overview = 'là một tình trạng thai kỳ nghiêm trọng xảy ra khi nhau thai phát triển quá sâu vào thành tử cung. Thông thường, nhau thai sẽ bong ra khỏi thành tử cung sau khi sinh con. Với nhau thai cài răng lược, m';
MERGE (n:Disease {id: 'D2328'}) SET n.id = 'D2328', n.name = 'Nhau tiền đạo', n.name_en = 'Placenta previa', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/placenta-previa/symptoms-causes/syc-20352768 | https://medlineplus.gov/ency/article/000900.htm', n.overview = '(pluh-SEN-tuh PREH-vee-uh) là một vấn đề khi mang thai khi nhau thai che phủ hoàn toàn hoặc một phần lỗ mở tử cung (cổ tử cung). Nhau thai tiền đạo Nhau thai là một cơ quan phát triển trong tử cung kh', n.prognosis = 'Nguy cơ lớn nhất là chảy máu nghiêm trọng có thể đe dọa tính mạng của mẹ và bé. Nếu bạn bị chảy máu nghiêm trọng, em bé của bạn có thể cần được sinh sớm trước khi các cơ quan quan trọng như phổi phát ', n.when_to_see = 'Nếu bạn bị chảy máu âm đạo trong tam cá nguyệt thứ hai hoặc thứ ba, hãy gọi ngay cho nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Nếu chảy máu nghiêm trọng, hãy tìm kiếm sự chăm sóc y tế khẩn cấp.';
MERGE (n:Disease {id: 'D2329'}) SET n.id = 'D2329', n.name = 'Nhau bong non', n.name_en = 'Placental abruption', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/placental-abruption/symptoms-causes/syc-20376458', n.overview = '(nhau bong non) là một biến chứng hiếm gặp nhưng nghiêm trọng trong thai kỳ. Nhau thai phát triển trong tử cung khi mang thai. Nó bám vào thành tử cung và cung cấp chất dinh dưỡng và oxy cho em bé. Nh', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc khẩn cấp nếu bạn có các dấu hiệu hoặc triệu chứng của nhau thai bong non.';
MERGE (n:Disease {id: 'D2330'}) SET n.id = 'D2330', n.name = 'Suy nhau thai', n.name_en = 'Placental insufficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001485.htm', n.prognosis = 'Các vấn đề về nhau thai có thể ảnh hưởng đến sự phát triển của thai nhi. Em bé không thể lớn lên và phát triển bình thường trong bụng mẹ nếu không được cung cấp đủ oxy và chất dinh dưỡng.';
MERGE (n:Disease {id: 'D2331'}) SET n.id = 'D2331', n.name = 'Bệnh dịch hạch', n.name_en = 'Plague', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/plague/symptoms-causes/syc-20351291 | https://medlineplus.gov/ency/article/000596.htm', n.overview = 'là một căn bệnh nghiêm trọng do một loại vi trùng có tên Yersinia pestis gây ra. Vi trùng chủ yếu sống ở loài gặm nhấm nhỏ và bọ chét của chúng. Cách phổ biến nhất để con người mắc bệnh dịch hạch là b', n.prognosis = 'Trước khi có kháng sinh, 60% số người mắc bệnh dịch hạch ở Hoa Kỳ đã tử vong. Hiện nay bệnh dịch hạch có thể được điều trị bằng kháng sinh, tỷ lệ tử vong chung là 6%. Hầu như tất cả mọi người mắc bệnh', n.when_to_see = 'Hãy được chăm sóc ngay lập tức nếu bạn bị sốt cao đột ngột. Nhận dịch vụ chăm sóc khẩn cấp nếu bạn bị sốt cao đột ngột hoặc có các triệu chứng khác và bạn sống ở khu vực đã từng có trường hợp mắc bệnh';
MERGE (n:Disease {id: 'D2332'}) SET n.id = 'D2332', n.name = 'Ngộ độc phân bón thực vật', n.name_en = 'Plant fertilizer poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002841.htm', n.prognosis = 'Phân bón có thể nguy hiểm với số lượng lớn. Chúng sẽ ảnh hưởng đến lượng oxy mà não và các cơ quan khác của bạn nhận được. Tình trạng một người khỏe mạnh như thế nào tùy thuộc vào mức độ nghiêm trọng ';
MERGE (n:Disease {id: 'D2333'}) SET n.id = 'D2333', n.name = 'Viêm cân gan chân', n.name_en = 'Plantar fasciitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/plantar-fasciitis/symptoms-causes/syc-20354846 | https://medlineplus.gov/ency/article/007021.htm', n.overview = 'mô sợi (mân gan chân) dọc theo lòng bàn chân nối xương gót chân với ngón chân của bạn. Viêm cân gan chân có thể gây đau gót chân dữ dội. Viêm cân gan chân (PLAN-tur fas-e-I-tis) là một trong những ngu', n.prognosis = 'Các phương pháp điều trị không phẫu thuật hầu như luôn cải thiện cơn đau. Việc điều trị có thể kéo dài từ vài tháng đến 2 năm trước khi các triệu chứng thuyên giảm. Hầu hết mọi người cảm thấy tốt hơn ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh viêm cân gan chân.';
MERGE (n:Disease {id: 'D2334'}) SET n.id = 'D2334', n.name = 'Mũ mụn cóc Plantar', n.name_en = 'Plantar warts', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/plantar-warts/symptoms-causes/syc-20352691', n.overview = 'gây ra mụn cóc trên bàn tay và ngón tay của bạn. Tuy nhiên, vì vị trí của chúng, chúng có thể gây đau đớn. Mụn cóc Plantar là những khối u nhỏ, thô ráp ở bàn chân. Chúng thường xuất hiện ở mu bàn chân', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn để biết sự phát triển trên bàn chân của bạn nếu: Sự phát triển gây chảy máu, đau đớn hoặc thay đổi về hình dạng hoặc màu sắc Bạn đã cố gắng điều ';
MERGE (n:Disease {id: 'D2335'}) SET n.id = 'D2335', n.name = 'Mảng bám và cao răng trên răng', n.name_en = 'Plaque and tartar on teeth', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002044.htm', n.overview = 'Nha sĩ hoặc chuyên viên vệ sinh răng miệng của bạn sẽ chỉ cho bạn cách chải và dùng chỉ nha khoa đúng cách. Phòng ngừa là chìa khóa cho sức khỏe răng miệng. Chải ít nhất hai lần một ngày, mỗi lần ít n';
MERGE (n:Disease {id: 'D2336'}) SET n.id = 'D2336', n.name = 'Ngộ độc nhựa đúc nhựa', n.name_en = 'Plastic casting resin poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002734.htm', n.prognosis = 'Sức khỏe của một người khỏe mạnh như thế nào tùy thuộc vào lượng chất độc họ nuốt vào và tốc độ họ được điều trị. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải n';
MERGE (n:Disease {id: 'D2337'}) SET n.id = 'D2337', n.name = 'Ngộ độc chất làm cứng nhựa nhựa', n.name_en = 'Plastic resin hardener poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002735.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào hoặc hít vào và tốc độ điều trị được tiếp nhận như thế nào. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt';
MERGE (n:Disease {id: 'D2338'}) SET n.id = 'D2338', n.name = 'Tràn dịch màng phổi', n.name_en = 'Pleural effusion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000086.htm', n.prognosis = 'Kết quả phụ thuộc vào căn bệnh tiềm ẩn.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn hoặc đến phòng cấp cứu nếu bạn có: Các triệu chứng tràn dịch màng phổi Khó thở hoặc khó thở ngay sau khi chọc dịch màng phổi';
MERGE (n:Disease {id: 'D2339'}) SET n.id = 'D2339', n.name = 'Bệnh viêm màng phổi', n.name_en = 'Pleurisy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/pleurisy/symptoms-causes/syc-20351863 | https://medlineplus.gov/ency/article/001371.htm', n.overview = 'các mô ngăn cách phổi với thành ngực của bạn - bị viêm, gây đau ngực. Bệnh màng phổi (PLOOR-ih-see) là tình trạng màng phổi - hai lớp mô lớn, mỏng ngăn cách phổi với thành ngực - bị viêm. Còn được gọi', n.prognosis = 'Cơ hội phục hồi tùy thuộc vào nguyên nhân gây ra bệnh viêm màng phổi và tình trạng sức khỏe chung của bạn.', n.when_to_see = 'Hãy gọi cho nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn hoặc tìm kiếm sự chăm sóc khẩn cấp ngay lập tức nếu bạn cảm thấy đau ngực dữ dội, không rõ nguyên nhân khi thở. Bạn có thể gặp vấn đề với phổ';
MERGE (n:Disease {id: 'D2340'}) SET n.id = 'D2340', n.name = 'U xơ thần kinh dạng đám rối', n.name_en = 'Plexiform neurofibroma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/plexiform-neurofibroma/symptoms-causes/syc-20587495', n.overview = 'còn được gọi là PN hoặc PNF. Đó là một loại khối u không phải ung thư được gọi là u xơ thần kinh hình thành trong hoặc xung quanh dây thần kinh. U xơ thần kinh phát triển trên lớp vỏ bảo vệ xung quanh';
MERGE (n:Disease {id: 'D2341'}) SET n.id = 'D2341', n.name = 'Hội chứng Plummer-Vinson', n.name_en = 'Plummer-Vinson syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001158.htm', n.prognosis = 'Những người mắc bệnh này thường đáp ứng với điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Thức ăn bị kẹt sau khi bạn nuốt. Bạn cảm thấy mệt mỏi và suy nhược nghiêm trọng';
MERGE (n:Disease {id: 'D2342'}) SET n.id = 'D2342', n.name = 'Vắc xin liên hợp phế cầu khuẩn - những điều bạn cần biết', n.name_en = 'Pneumococcal conjugate vaccine - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007605.htm', n.overview = '1. Tại sao phải tiêm phòng? Vắc xin liên hợp phế cầu khuẩn có thể ngăn ngừa bệnh phế cầu khuẩn. Bệnh phế cầu khuẩn đề cập đến bất kỳ bệnh nào do vi khuẩn phế cầu khuẩn gây ra. Những vi khuẩn này có th';
MERGE (n:Disease {id: 'D2343'}) SET n.id = 'D2343', n.name = 'Viêm màng não do phế cầu khuẩn', n.name_en = 'Pneumococcal meningitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000607.htm', n.prognosis = 'Viêm màng não là một bệnh nhiễm trùng nguy hiểm và có thể gây tử vong. Càng điều trị sớm thì cơ hội phục hồi của bạn càng cao. Trẻ nhỏ và người lớn trên 50 tuổi có nguy cơ tử vong cao nhất.', n.when_to_see = 'Gọi 911 hoặc số cấp cứu tại địa phương hoặc đến phòng cấp cứu nếu bạn nghi ngờ viêm màng não ở trẻ nhỏ có các triệu chứng sau: Vấn đề về ăn uống Khóc the thé Khó chịu Sốt dai dẳng không rõ nguyên nhân';
MERGE (n:Disease {id: 'D2344'}) SET n.id = 'D2344', n.name = 'Vắc xin polysaccharide phế cầu khuẩn (PPSV23) - những điều bạn cần biết', n.name_en = 'Pneumococcal polysaccharide vaccine (PPSV23) - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007607.htm', n.overview = '1. Tại sao phải tiêm phòng? Vắc-xin polysaccharide phế cầu khuẩn (PPSV23) có thể ngăn ngừa bệnh phế cầu khuẩn. Bệnh phế cầu khuẩn đề cập đến bất kỳ bệnh nào do vi khuẩn phế cầu khuẩn gây ra. Những vi ';
MERGE (n:Disease {id: 'D2345'}) SET n.id = 'D2345', n.name = 'Viêm phổi do Pneumocystis jirovecii', n.name_en = 'Pneumocystis jirovecii pneumonia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000671.htm', n.prognosis = 'Viêm phổi do Pneumocystis có thể đe dọa tính mạng. Nó có thể gây suy hô hấp dẫn đến tử vong. Những người mắc bệnh này cần được điều trị sớm và hiệu quả. Đối với bệnh viêm phổi do pneumocystis từ trung', n.when_to_see = 'Nếu bạn có hệ miễn dịch suy yếu do AIDS, ung thư, cấy ghép hoặc sử dụng corticosteroid, hãy liên hệ với nhà cung cấp của bạn nếu bạn phát triển ho, sốt hoặc khó thở.';
MERGE (n:Disease {id: 'D2346'}) SET n.id = 'D2346', n.name = 'Tràn khí trung thất', n.name_en = 'Pneumomediastinum', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000084.htm', n.prognosis = 'Triển vọng phụ thuộc vào bệnh hoặc các biến cố gây ra tràn khí trung thất.', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn bị đau ngực dữ dội hoặc khó thở.';
MERGE (n:Disease {id: 'D2347'}) SET n.id = 'D2347', n.name = 'Viêm phổi', n.name_en = 'Pneumonia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pneumonia/symptoms-causes/syc-20354204', n.overview = 'và khả năng phòng vệ tự nhiên của phổi của bạn bị suy giảm sẽ cho phép vi trùng xâm nhập và nhân lên trong phổi của bạn. Để tiêu diệt các sinh vật tấn công, các tế bào bạch cầu nhanh chóng tích tụ. Cù', n.when_to_see = 'Hãy đến gặp bác sĩ nếu bạn khó thở, đau ngực, sốt dai dẳng từ 102 F (39 C) trở lên hoặc ho dai dẳng, đặc biệt nếu bạn ho ra mủ. Điều đặc biệt quan trọng là những người thuộc nhóm nguy cơ cao này phải ';
MERGE (n:Disease {id: 'D2348'}) SET n.id = 'D2348', n.name = 'Viêm phổi - hệ thống miễn dịch suy yếu', n.name_en = 'Pneumonia - weakened immune system', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000093.htm', n.prognosis = 'Các yếu tố có thể dẫn đến kết quả tồi tệ hơn bao gồm: Bệnh viêm phổi do nấm gây ra. Người có hệ thống miễn dịch rất yếu.', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu bạn có hệ thống miễn dịch suy yếu và có các triệu chứng của bệnh viêm phổi.';
MERGE (n:Disease {id: 'D2349'}) SET n.id = 'D2349', n.name = 'Viêm phổi ở trẻ em - mắc phải tại cộng đồng', n.name_en = 'Pneumonia in children - community acquired', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007690.htm', n.prognosis = 'Hầu hết trẻ em sẽ cải thiện tình trạng sau 7 đến 10 ngày điều trị. Trẻ bị viêm phổi nặng có biến chứng có thể cần điều trị từ 2 đến 3 tuần. Trẻ có nguy cơ bị viêm phổi nặng bao gồm: Trẻ có hệ miễn dịc', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn có các triệu chứng sau: Ho nặng Khó thở ( thở khò khè, càu nhàu, thở nhanh) Nôn Chán ăn Sốt và ớn lạnh Các triệu chứng thở (hô hấp) trở nên tồi tệ ';
MERGE (n:Disease {id: 'D2350'}) SET n.id = 'D2350', n.name = 'Tràn khí màng phổi', n.name_en = 'Pneumothorax', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pneumothorax/symptoms-causes/syc-20350367', n.overview = 'Phổi xẹp và bình thường m phổi rò rỉ vào khoang ngực. Ví dụ được hiển thị là tràn khí màng phổi trái hoàn toàn. Tràn khí màng phổi (noo-moe-THOR-aks) là tình trạng phổi bị xẹp. Tràn khí màng phổi xảy ', n.when_to_see = 'Các triệu chứng của tràn khí màng phổi có thể do nhiều vấn đề sức khỏe khác nhau gây ra và một số có thể đe dọa tính mạng, vì vậy hãy tìm kiếm sự chăm sóc y tế. Nếu cơn đau ngực của bạn trầm trọng hoặ';
MERGE (n:Disease {id: 'D2351'}) SET n.id = 'D2351', n.name = 'Tràn khí màng phổi - trẻ sơ sinh', n.name_en = 'Pneumothorax - infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007312.htm', n.prognosis = 'Một số rò rỉ khí sẽ biến mất trong vòng vài ngày mà không cần xử lý. Trẻ sơ sinh được rút khí bằng kim hoặc ống thông thường hồi phục tốt sau khi điều trị nếu không có vấn đề gì khác về phổi.', n.when_to_see = 'Tràn khí màng phổi thường được phát hiện ngay sau khi sinh. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu trẻ sơ sinh của bạn có triệu chứng tràn khí màng phổi.';
MERGE (n:Disease {id: 'D2352'}) SET n.id = 'D2352', n.name = 'Hội chứng POEMS', n.name_en = 'POEMS syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/poems-syndrome/symptoms-causes/syc-20352678', n.overview = 'là một chứng rối loạn máu hiếm gặp gây tổn thương dây thần kinh và ảnh hưởng đến các bộ phận khác của cơ thể. POEMS là viết tắt của các triệu chứng của tình trạng này. Các triệu chứng có thể bao gồm y', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có bất kỳ triệu chứng nào của hội chứng POEMS.';
MERGE (n:Disease {id: 'D2353'}) SET n.id = 'D2353', n.name = 'Tiếp xúc với cây trạng nguyên', n.name_en = 'Poinsettia plant exposure', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002885.htm', n.prognosis = 'Tình trạng sức khỏe của người đó phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Người đó nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Cây này không được c';
MERGE (n:Disease {id: 'D2354'}) SET n.id = 'D2354', n.name = 'Cây thường xuân độc - cây sồi - cây thù du', n.name_en = 'Poison ivy - oak - sumac', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002886.htm', n.prognosis = 'Các phản ứng nguy hiểm đến tính mạng có thể xảy ra nếu nuốt phải hoặc hít phải các thành phần độc hại (có thể xảy ra khi thực vật bị đốt cháy). Phát ban da điển hình thường biến mất mà không có bất kỳ';
MERGE (n:Disease {id: 'D2355'}) SET n.id = 'D2355', n.name = 'Cây thường xuân độc - cây sồi - cây thù du phát ban', n.name_en = 'Poison ivy - oak - sumac rash', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000027.htm', n.when_to_see = 'Được điều trị y tế khẩn cấp ngay lập tức nếu: Người đó đang bị phản ứng dị ứng nghiêm trọng, chẳng hạn như sưng tấy hoặc khó thở hoặc đã từng bị phản ứng nặng trước đây. Người đó đã tiếp xúc với khói ';
MERGE (n:Disease {id: 'D2356'}) SET n.id = 'D2356', n.name = 'Phát ban do cây thường xuân độc', n.name_en = 'Poison ivy rash', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/poison-ivy/symptoms-causes/syc-20376485', n.overview = 'Viêm da tiếp xúc không có màu da. Viêm da tiếp xúc có thể xuất hiện dưới dạng phát ban ngứa. Phát ban do cây thường xuân độc gây ra do phản ứng dị ứng với một loại nhựa nhờn có tên là urushiol (u-ROO-', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế khẩn cấp nếu: Bạn hít phải khói từ cây thường xuân độc đang cháy và khó thở Hãy gặp bác sĩ nếu: Phản ứng nghiêm trọng hoặc lan rộng Da của bạn tiếp tục sưng tấy Phát ban ';
