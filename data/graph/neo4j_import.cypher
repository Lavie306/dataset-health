MERGE (n:Disease {id: 'D1956'}) SET n.id = 'D1956', n.name = 'Chuyển động - không kiểm soát hoặc chậm', n.name_en = 'Movement - uncontrolled or slow', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003197.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn có những cử động không giải thích được mà bạn không thể kiểm soát Vấn đề ngày càng trầm trọng hơn Những cử động không kiểm soát được xảy ra cùng với các t';
