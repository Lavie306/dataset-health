MERGE (n:Disease {id: 'D1963'}) SET n.id = 'D1963', n.name = 'Nhiễm trùng MRSA', n.name_en = 'MRSA infection', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mrsa/symptoms-causes/syc-20375336', n.overview = 'Nhiễm trùng tụ cầu vàng kháng Methicillin (MRSA) là do một loại vi khuẩn tụ cầu khuẩn trở nên kháng nhiều loại kháng sinh dùng để điều trị nhiễm trùng tụ cầu khuẩn thông thường. Nhiễm trùng MRSA xảy r', n.when_to_see = 'Hãy để ý đến các vấn đề nhỏ về da như mụn nhọt, vết côn trùng cắn hoặc vết cắt và vết xước. Điều này đặc biệt quan trọng đối với trẻ em. Nếu vết thương có vẻ bị nhiễm trùng hoặc có vết thương và sốt, ';
MERGE (n:Disease {id: 'D1964'}) SET n.id = 'D1964', n.name = 'Triệu chứng phức tạp của bột ngọt', n.name_en = 'MSG symptom complex', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001126.htm', n.prognosis = 'Hầu hết mọi người đều hồi phục sau khi nhận thấy triệu chứng phức tạp của MSG mà không cần điều trị và không gặp vấn đề gì lâu dài.', n.when_to_see = 'Nhận trợ giúp y tế khẩn cấp ngay lập tức nếu bạn có dấu hiệu của phản ứng dị ứng hoặc bệnh nghiêm trọng khác, bao gồm: Đau ngực Tim đập nhanh Khó thở Sưng môi hoặc cổ họng';
MERGE (n:Disease {id: 'D1965'}) SET n.id = 'D1965', n.name = 'Mucopolysaccharides', n.name_en = 'Mucopolysaccharides', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002263.htm', n.overview = 'Khi cơ thể không thể phân hủy mucopolysaccharides, một tình trạng gọi là mucopolysaccharidoses (MPS) sẽ xảy ra. MPS đề cập đến một nhóm các rối loạn chuyển hóa di truyền. Những người bị MPS không có b';
MERGE (n:Disease {id: 'D1966'}) SET n.id = 'D1966', n.name = 'Mucopolysaccharidosis loại I', n.name_en = 'Mucopolysaccharidosis type I', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001204.htm', n.prognosis = 'Trẻ bị MPS nặng tôi thường làm không tốt. Vấn đề sức khỏe của họ trở nên tồi tệ hơn theo thời gian, dẫn đến tử vong ở tuổi 10. Trẻ em bị MPS suy yếu (nhẹ hơn) I gặp ít vấn đề về sức khỏe hơn, nhiều em', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn có tiền sử gia đình mắc bệnh MPS I và đang cân nhắc việc có con Con bạn bắt đầu xuất hiện các triệu chứng của MPS I';
MERGE (n:Disease {id: 'D1967'}) SET n.id = 'D1967', n.name = 'Mucopolysaccharidosis type II', n.name_en = 'Mucopolysaccharidosis type II', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001203.htm', n.prognosis = 'Những người mắc bệnh khởi phát sớm (nặng) thường sống được từ 10 đến 20 năm. Những người mắc bệnh khởi phát muộn (nhẹ) thường sống được từ 20 đến 60 năm.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn hoặc con bạn có một nhóm các triệu chứng này Bạn biết mình là người mang gen và đang cân nhắc việc có con';
MERGE (n:Disease {id: 'D1968'}) SET n.id = 'D1968', n.name = 'Mucopolysaccharidosis type III', n.name_en = 'Mucopolysaccharidosis type III', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001210.htm', n.prognosis = 'MPS III gây ra các triệu chứng nghiêm trọng về hệ thần kinh, bao gồm cả khuyết tật trí tuệ nghiêm trọng. Hầu hết những người mắc MPS III đều sống ở tuổi thiếu niên. Một số sống lâu hơn, trong khi nhữn', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu con bạn có vẻ không tăng trưởng và phát triển bình thường. Hãy gặp nhà cung cấp dịch vụ của bạn nếu bạn dự định có con và gia đìn';
MERGE (n:Disease {id: 'D1969'}) SET n.id = 'D1969', n.name = 'Mucopolysaccharidosis loại IV', n.name_en = 'Mucopolysaccharidosis type IV', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001206.htm', n.prognosis = 'Chức năng nhận thức (khả năng suy nghĩ rõ ràng) thường bình thường ở những người mắc MPS IV. Các vấn đề về xương có thể dẫn đến các vấn đề sức khỏe nghiêm trọng. Ví dụ, các xương nhỏ ở đỉnh cổ có thể ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu xuất hiện các triệu chứng của MPS IV.';
MERGE (n:Disease {id: 'D1970'}) SET n.id = 'D1970', n.name = 'Bệnh nấm nhầy', n.name_en = 'Mucormycosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000649.htm', n.prognosis = 'Mucormycosis có tỷ lệ tử vong rất cao, ngay cả khi thực hiện phẫu thuật tích cực. Nguy cơ tử vong phụ thuộc vào vùng cơ thể liên quan và sức khỏe tổng thể của bạn.', n.when_to_see = 'Những người có hệ thống miễn dịch yếu và rối loạn miễn dịch (bao gồm cả bệnh tiểu đường) nên tìm kiếm sự chăm sóc y tế nếu họ phát triển: Sốt Đau đầu Đau xoang Sưng mắt Bất kỳ triệu chứng nào khác đượ';
MERGE (n:Disease {id: 'D1971'}) SET n.id = 'D1971', n.name = 'Nhịp tim nhanh nhĩ đa ổ', n.name_en = 'Multifocal atrial tachycardia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000186.htm', n.prognosis = 'MAT có thể được kiểm soát nếu tình trạng gây ra nhịp tim nhanh được điều trị và kiểm soát.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn có nhịp tim nhanh hoặc không đều kèm theo các triệu chứng MAT khác Bạn bị MAT và các triệu chứng của bạn trở nên tồi tệ hơn, khô';
MERGE (n:Disease {id: 'D1972'}) SET n.id = 'D1972', n.name = 'Đa u tân sinh nội tiết (MEN) I', n.name_en = 'Multiple endocrine neoplasia (MEN) I', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000398.htm', n.prognosis = 'Các khối u tuyến yên và tuyến cận giáp thường không phải là ung thư ( lành tính ), nhưng một số khối u tuyến tụy có thể trở thành ung thư (ác tính) và lan đến gan. Những điều này có thể làm giảm tuổi ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nhận thấy các triệu chứng của MEN I hoặc có tiền sử gia đình mắc bệnh này.';
MERGE (n:Disease {id: 'D1973'}) SET n.id = 'D1973', n.name = 'Bệnh đa u nội tiết (MEN) II', n.name_en = 'Multiple endocrine neoplasia (MEN) II', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000399.htm', n.prognosis = 'Pheochromocytoma thường không phải là ung thư (lành tính). Ung thư biểu mô tủy tuyến giáp là một loại ung thư rất nguy hiểm và có khả năng gây tử vong, nhưng việc chẩn đoán và phẫu thuật sớm thường có', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nhận thấy các triệu chứng của MEN II hoặc nếu ai đó trong gia đình bạn nhận được chẩn đoán như vậy.';
MERGE (n:Disease {id: 'D1974'}) SET n.id = 'D1974', n.name = 'Đa u tân sinh nội tiết, loại 1 (MEN 1)', n.name_en = 'Multiple endocrine neoplasia, type 1 (MEN 1)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/men-1/symptoms-causes/syc-20353064', n.overview = 'là một tình trạng hiếm gặp. Nó chủ yếu gây ra các khối u ở các tuyến sản xuất và giải phóng hormone. Chúng được gọi là các tuyến nội tiết. Tình trạng này cũng có thể gây ra các khối u ở ruột non và dạ';
MERGE (n:Disease {id: 'D1975'}) SET n.id = 'D1975', n.name = 'Đa tân sinh nội tiết, loại 2 (MEN 2)', n.name_en = 'Multiple endocrine neoplasia, type 2 (MEN 2)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/men-2/symptoms-causes/syc-20540486', n.overview = 'Đa tân sinh nội tiết, loại 2, còn được gọi là MEN 2, là một tình trạng hiếm gặp. Nó gây ra các khối u ở tuyến giáp và tuyến cận giáp, tuyến thượng thận, môi, miệng, mắt và đường tiêu hóa. Xét nghiệm d', n.when_to_see = 'Nếu bạn gặp bất kỳ triệu chứng nào trong số này, hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1976'}) SET n.id = 'D1976', n.name = 'Bệnh đa dây thần kinh', n.name_en = 'Multiple mononeuropathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000782.htm', n.prognosis = 'Có thể phục hồi hoàn toàn nếu nguyên nhân được tìm ra và điều trị cũng như nếu tổn thương thần kinh được hạn chế. Một số người không có khuyết tật. Những người khác bị mất một phần hoặc toàn bộ khả nă', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nhận thấy các dấu hiệu của bệnh đa dây thần kinh.';
MERGE (n:Disease {id: 'D1977'}) SET n.id = 'D1977', n.name = 'Đa u tủy', n.name_en = 'Multiple myeloma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/multiple-myeloma/symptoms-causes/syc-20353378 | https://medlineplus.gov/ency/article/000583.htm', n.overview = 'là một loại ung thư hình thành trong một loại tế bào bạch cầu gọi là tế bào plasma. Các tế bào plasma khỏe mạnh giúp chống lại nhiễm trùng bằng cách tạo ra các protein gọi là kháng thể. Kháng thể tìm ', n.prognosis = 'Triển vọng tùy thuộc vào độ tuổi của người đó và giai đoạn bệnh. Trong một số trường hợp, bệnh tiến triển rất nhanh. Trong những trường hợp khác, phải mất nhiều năm các triệu chứng mới xuất hiện. Nói ', n.when_to_see = 'Hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có các triệu chứng khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin ';
MERGE (n:Disease {id: 'D1978'}) SET n.id = 'D1978', n.name = 'Bệnh đa xơ cứng', n.name_en = 'Multiple sclerosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/multiple-sclerosis/symptoms-causes/syc-20350269 | https://medlineplus.gov/ency/article/000737.htm', n.overview = 'Bệnh đa xơ cứng là gì? Một chuyên gia giải thích Tìm hiểu thêm từ nhà thần kinh học Oliver Tobin, M.B., B.Ch., B.A.O., Ph.D. Hiển thị bản ghi cho video Bệnh đa xơ cứng là gì? Một chuyên gia giải thích', n.prognosis = 'Kết quả khác nhau và khó dự đoán. Mặc dù chứng rối loạn này kéo dài suốt đời (mãn tính) và không thể chữa khỏi nhưng tuổi thọ có thể bình thường hoặc gần như bình thường. Hầu hết những người bị MS đều', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Thêm thông tin Chăm sóc bệnh đa xơ cứng tại Mayo Clinic Bệnh đa xơ cứng: Có gây co giật k';
MERGE (n:Disease {id: 'D1979'}) SET n.id = 'D1979', n.name = 'Bệnh teo đa hệ thống', n.name_en = 'Multiple system atrophy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/multiple-system-atrophy/symptoms-causes/syc-20356153', n.overview = ', còn được gọi là MSA, khiến con người mất khả năng phối hợp và giữ thăng bằng hoặc trở nên chậm chạp và cứng nhắc. Nó cũng gây ra những thay đổi trong lời nói và mất kiểm soát các chức năng cơ thể kh', n.when_to_see = 'Nếu bạn phát triển bất kỳ triệu chứng nào của bệnh teo đa hệ thống, hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn. Nếu bạn đã được chẩn đoán mắc MSA, hãy liên hệ với chuyên gia chăm sóc sức khỏe củ';
MERGE (n:Disease {id: 'D1980'}) SET n.id = 'D1980', n.name = 'Teo nhiều hệ thống - tiểu não', n.name_en = 'Multiple system atrophy - cerebellar subtype', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000758.htm', n.prognosis = 'MSA-C dần trở nên tồi tệ hơn và không có cách chữa trị. Triển vọng nói chung là kém. Tuy nhiên, có thể phải mất nhiều năm nữa mới có người bị khuyết tật nặng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ triệu chứng nào của MSA-C. Bạn sẽ cần được khám bởi một nhà thần kinh học. Đây là một chuyên gia điều trị các vấn đề về';
MERGE (n:Disease {id: 'D1981'}) SET n.id = 'D1981', n.name = 'Teo nhiều hệ thống - bệnh Parkinson', n.name_en = 'Multiple system atrophy - parkinsonian type', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000757.htm', n.prognosis = 'Kết quả của MSA rất kém. Mất chức năng tinh thần và thể chất dần dần trở nên tồi tệ hơn. Có khả năng tử vong sớm. Mọi người thường sống từ 7 đến 9 năm sau khi chẩn đoán.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn xuất hiện các triệu chứng của chứng rối loạn này. Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn đã được chẩn đoán mắc MSA và c';
MERGE (n:Disease {id: 'D1982'}) SET n.id = 'D1982', n.name = 'Quá liều nhiều vitamin', n.name_en = 'Multiple vitamin overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002596.htm', n.prognosis = 'Nếu được điều trị y tế nhanh chóng, những người bị dùng quá liều sắt và canxi thường hồi phục. Dùng quá liều sắt gây hôn mê hoặc huyết áp thấp đôi khi có thể gây tử vong. Quá liều sắt có thể gây hậu q';
MERGE (n:Disease {id: 'D1983'}) SET n.id = 'D1983', n.name = 'Hội chứng viêm đa hệ thống ở trẻ em (MIS-C) và COVID-19', n.name_en = 'Multisystem inflammatory syndrome in children (MIS-C) and COVID-19', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mis-c-in-kids-covid-19/symptoms-causes/syc-20502550', n.overview = 'Hội chứng viêm đa hệ thống ở trẻ em (MIS-C) là một nhóm các triệu chứng liên quan đến tình trạng sưng tấy, gọi là viêm, các cơ quan hoặc mô. Những người mắc MIS-C cần được chăm sóc tại bệnh viện. MIS-', n.when_to_see = 'Nếu con bạn có bất kỳ dấu hiệu cảnh báo khẩn cấp nào được liệt kê ở trên hoặc bị bệnh nặng kèm theo các triệu chứng khác, hãy chăm sóc ngay lập tức. Đưa con bạn đến phòng cấp cứu gần nhất hoặc gọi 911';
MERGE (n:Disease {id: 'D1984'}) SET n.id = 'D1984', n.name = 'Quai bị', n.name_en = 'Mumps', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/mumps/symptoms-causes/syc-20375361 | https://medlineplus.gov/ency/article/001557.htm', n.overview = 'là bệnh do virus gây ra. Nó thường ảnh hưởng đến các tuyến ở mỗi bên của khuôn mặt. Những tuyến này, được gọi là tuyến mang tai, tạo ra nước bọt. Các tuyến bị sưng có thể mềm hoặc đau. Tuyến nước bọt ', n.prognosis = 'Những người mắc bệnh này hầu hết đều có kết quả tốt, ngay cả khi có liên quan đến các cơ quan khác ngoài tuyến nước bọt. Sau khi hết bệnh (thường là khoảng 7 ngày), trẻ sẽ có được khả năng miễn dịch v', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn có các triệu chứng của bệnh quai bị. Quai bị lây lan rất dễ dàng trong khoảng năm ngày sau khi bắt đầu sưng tấy. Nếu bạn cho';
MERGE (n:Disease {id: 'D1985'}) SET n.id = 'D1985', n.name = 'Hội chứng Munchausen do proxy', n.name_en = 'Munchausen syndrome by proxy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001555.htm', n.when_to_see = 'Nếu bạn cho rằng một đứa trẻ đang bị lạm dụng, hãy liên hệ với nhà cung cấp, cảnh sát hoặc các dịch vụ bảo vệ trẻ em. Gọi 911 hoặc số điện thoại khẩn cấp tại địa phương cho bất kỳ đứa trẻ nào đang gặp';
MERGE (n:Disease {id: 'D1986'}) SET n.id = 'D1986', n.name = 'Đau cơ', n.name_en = 'Muscle aches', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003178.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Cơn đau cơ của bạn kéo dài hơn 3 ngày. Bạn bị đau dữ dội, không rõ nguyên nhân. Bạn có bất kỳ dấu hiệu nhiễm trùng nào, chẳng hạn như sưng hoặc đỏ xun';
MERGE (n:Disease {id: 'D1987'}) SET n.id = 'D1987', n.name = 'Teo cơ', n.name_en = 'Muscle atrophy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003188.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để lấy hẹn nếu bạn bị mất cơ lâu dài hoặc không rõ nguyên nhân. Bạn có thể thường thấy điều này khi so sánh tay, cánh tay hoặc chân này với tay kia.';
MERGE (n:Disease {id: 'D1988'}) SET n.id = 'D1988', n.name = 'Chuột rút cơ', n.name_en = 'Muscle cramp', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/muscle-cramp/symptoms-causes/syc-20350820', n.overview = 'Chuột rút cơ là tình trạng một hoặc nhiều cơ bị co thắt đột ngột, bất ngờ. Đôi khi được gọi là chuột rút, chuột rút cơ có thể rất đau đớn. Tập thể dục hoặc làm việc chăm chỉ, đặc biệt là khi trời nóng', n.when_to_see = 'Chứng chuột rút thường tự biến mất. Họ thường không cần chăm sóc y tế. Tuy nhiên, hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bị chuột rút: Gây khó chịu nghiêm trọng. Bị sưng chân, tấy đỏ h';
MERGE (n:Disease {id: 'D1989'}) SET n.id = 'D1989', n.name = 'Chuột rút cơ bắp', n.name_en = 'Muscle cramps', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003193.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu chứng chuột rút cơ bắp của bạn: Nghiêm trọng Không biến mất chỉ bằng cách giãn cơ đơn giản Tiếp tục tái phát Kéo dài';
MERGE (n:Disease {id: 'D1990'}) SET n.id = 'D1990', n.name = 'Rối loạn cơ', n.name_en = 'Muscle disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001220.htm';
MERGE (n:Disease {id: 'D1991'}) SET n.id = 'D1991', n.name = 'Mất chức năng cơ', n.name_en = 'Muscle function loss', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003190.htm', n.when_to_see = 'Liệt cơ luôn cần được chăm sóc y tế ngay lập tức. Nếu bạn nhận thấy cơ bắp yếu đi dần dần hoặc có vấn đề với cơ, hãy đi khám càng sớm càng tốt.';
MERGE (n:Disease {id: 'D1992'}) SET n.id = 'D1992', n.name = 'Căng cơ', n.name_en = 'Muscle strains', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/muscle-strains/symptoms-causes/syc-20450507', n.overview = 'Căng cơ là một chấn thương ở cơ hoặc gân - mô sợi nối cơ với xương. Những vết thương nhỏ chỉ có thể làm cơ hoặc gân bị căng quá mức, trong khi những vết thương nặng hơn có thể khiến các mô này bị rách';
MERGE (n:Disease {id: 'D1993'}) SET n.id = 'D1993', n.name = 'Co giật cơ', n.name_en = 'Muscle twitching', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003296.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị co giật cơ lâu dài hoặc dai dẳng hoặc nếu bị co giật xảy ra với sự yếu hoặc mất cơ.';
MERGE (n:Disease {id: 'D1994'}) SET n.id = 'D1994', n.name = 'Bệnh loạn dưỡng cơ', n.name_en = 'Muscular dystrophy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/muscular-dystrophy/symptoms-causes/syc-20375388 | https://medlineplus.gov/ency/article/001190.htm', n.overview = 'là nhóm bệnh khiến cơ trở nên yếu hơn và mất khối lượng theo thời gian. Tình trạng này xảy ra do những thay đổi trong gen tạo ra protein cần thiết để hình thành cơ bắp khỏe mạnh. Có nhiều loại bệnh lo', n.prognosis = 'Mức độ nghiêm trọng của tình trạng khuyết tật tùy thuộc vào loại MD. Tất cả các loại MD dần dần trở nên tồi tệ hơn, nhưng tốc độ xảy ra của bệnh này rất khác nhau. Một số loại MD, chẳng hạn như chứng ', n.when_to_see = 'Hãy nhận lời khuyên y tế nếu bạn nhận thấy các triệu chứng yếu cơ ở bản thân hoặc con bạn. Các triệu chứng có thể bao gồm chậm phát triển, vụng về hơn bình thường và té ngã.';
MERGE (n:Disease {id: 'D1995'}) SET n.id = 'D1995', n.name = 'Viêm não tủy/hội chứng mệt mỏi mãn tính (ME/CFS)', n.name_en = 'Myalgic encephalomyelitis/chronic fatigue syndrome (ME/CFS)', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/chronic-fatigue-syndrome/symptoms-causes/syc-20360490 | https://medlineplus.gov/ency/article/001244.htm', n.overview = 'Viêm não tủy/hội chứng mệt mỏi mãn tính, còn gọi là ME/CFS, là một tình trạng phức tạp. Nó gây ra tình trạng mệt mỏi cực độ kéo dài ít nhất sáu tháng. Các triệu chứng trở nên trầm trọng hơn khi hoạt đ', n.prognosis = 'Triển vọng dài hạn của những người mắc ME/CFS là khác nhau. Thật khó để dự đoán vào thời điểm các triệu chứng đầu tiên bắt đầu. Một số người hồi phục hoàn toàn sau 6 tháng đến một năm. Khoảng 1 trong ', n.when_to_see = 'Mệt mỏi có thể là triệu chứng của nhiều bệnh. Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn cảm thấy mệt mỏi kéo dài hoặc quá mức. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu';
MERGE (n:Disease {id: 'D1996'}) SET n.id = 'D1996', n.name = 'Bệnh nhược cơ', n.name_en = 'Myasthenia gravis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/myasthenia-gravis/symptoms-causes/syc-20352036 | https://medlineplus.gov/ency/article/000712.htm', n.overview = 'là tình trạng xảy ra khi sự giao tiếp giữa dây thần kinh và cơ bị gián đoạn. Điều này khiến cơ bắp cảm thấy yếu và nhanh chóng mệt mỏi. Tình trạng này có thể ảnh hưởng đến bất kỳ cơ nào bạn kiểm soát,', n.prognosis = 'Không có cách chữa trị nhưng có thể thuyên giảm lâu dài. Bạn có thể phải hạn chế một số hoạt động hàng ngày. Những người chỉ có các triệu chứng về mắt (nhược cơ mắt) có thể phát triển bệnh nhược cơ to', n.when_to_see = 'Nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu bạn gặp khó khăn với bất kỳ điều nào sau đây: Hơi thở. Tầm nhìn. Nuốt. Nhai. Đi bộ. Sử dụng cánh tay hoặc bàn tay của bạn. Giữ đầu của bạn. Yêu ';
MERGE (n:Disease {id: 'D1997'}) SET n.id = 'D1997', n.name = 'Viêm phổi do Mycoplasma', n.name_en = 'Mycoplasma pneumonia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000082.htm', n.prognosis = 'Hầu hết mọi người đều hồi phục hoàn toàn mà không cần dùng kháng sinh, mặc dù thuốc kháng sinh có thể tăng tốc độ hồi phục. Ở người lớn không được điều trị, ho và suy nhược có thể kéo dài đến một thán', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị sốt, ho hoặc khó thở. Có nhiều nguyên nhân gây ra những triệu chứng này. Nhà cung cấp sẽ cần kiểm tra bệnh viêm phổi. Ngoài ra, hãy liên hệ với ';
MERGE (n:Disease {id: 'D1998'}) SET n.id = 'D1998', n.name = 'Bệnh liên quan đến kháng thể glycoprotein myelin oligodendrocyte (MOGAD)', n.name_en = 'Myelin oligodendrocyte glycoprotein antibody-associated disease (MOGAD)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mogad/symptoms-causes/syc-20560476', n.overview = 'Bệnh liên quan đến kháng thể glycoprotein myelin oligodendrocyte, còn được gọi là MOGAD, là một bệnh viêm hiếm gặp ảnh hưởng đến hệ thần kinh trung ương. Trong MOGAD, hệ thống miễn dịch tấn công chất ', n.when_to_see = 'Hãy gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn gặp bất kỳ triệu chứng nào ở trên mà không rõ lý do. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1999'}) SET n.id = 'D1999', n.name = 'Hội chứng rối loạn sinh tủy', n.name_en = 'Myelodysplastic syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007716.htm', n.prognosis = 'Triển vọng sẽ phụ thuộc vào loại MDS của bạn, tính di truyền của các tế bào bất thường và mức độ nghiêm trọng của các triệu chứng. Sức khỏe tổng thể của bạn cũng có thể ảnh hưởng đến cơ hội phục hồi c', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn: Cảm thấy yếu và mệt mỏi Hầu hết thời gian Bầm tím hoặc dễ chảy máu, chảy máu nướu hoặc chảy máu cam thường xuyên Bạn nhận thấy các đốm chảy máu màu đỏ';
MERGE (n:Disease {id: 'D2000'}) SET n.id = 'D2000', n.name = 'Myelofibrosis', n.name_en = 'Myelofibrosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/myelofibrosis/symptoms-causes/syc-20355057 | https://medlineplus.gov/ency/article/000531.htm', n.overview = 'là một loại ung thư tủy xương. Tủy xương là chất mềm bên trong xương, nơi tạo ra các tế bào máu. Myelofibrosis gây ra sẹo trong tủy xương. Điều này khiến tủy xương khó tạo ra các tế bào máu khỏe mạnh.', n.prognosis = 'Khi bệnh nặng hơn, tủy xương từ từ ngừng hoạt động. Số lượng tiểu cầu thấp dẫn đến dễ chảy máu. Sưng lá lách có thể trở nên tồi tệ hơn cùng với tình trạng thiếu máu. Thời gian sống sót trung bình của ', n.when_to_see = 'Hãy hẹn gặp nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của chứng rối loạn này. Tìm kiếm sự chăm sóc y tế ngay lập tức nếu chảy máu không kiểm soát, khó thở hoặc vàng da (da vàng và lòng t';
MERGE (n:Disease {id: 'D2001'}) SET n.id = 'D2001', n.name = 'Thoát vị tủy xương', n.name_en = 'Myelomeningocele', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001558.htm', n.prognosis = 'Thoát vị tủy màng não thường có thể được điều trị bằng phẫu thuật nhưng các dây thần kinh bị ảnh hưởng có thể vẫn không hoạt động bình thường. Vị trí khuyết tật trên lưng của trẻ càng cao thì dây thần', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Có một túi hoặc vùng hở trên cột sống của trẻ sơ sinh Con bạn chậm biết đi hoặc bò Các triệu chứng của não úng thủy phát triển, bao gồm phồng điểm mềm, kh';
MERGE (n:Disease {id: 'D2002'}) SET n.id = 'D2002', n.name = 'Đụng dập cơ tim', n.name_en = 'Myocardial contusion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000202.htm', n.prognosis = 'Những người bị giập cơ tim nhẹ sẽ hồi phục hoàn toàn hầu hết thời gian. Chấn thương tim nghiêm trọng có thể làm tăng nguy cơ suy tim hoặc các vấn đề về nhịp tim.';
MERGE (n:Disease {id: 'D2003'}) SET n.id = 'D2003', n.name = 'Thiếu máu cơ tim', n.name_en = 'Myocardial ischemia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/myocardial-ischemia/symptoms-causes/syc-20375417', n.overview = 'xảy ra khi lưu lượng máu đến tim của bạn bị giảm, khiến cơ tim không nhận đủ oxy. Lưu lượng máu giảm thường là kết quả của sự tắc nghẽn một phần hoặc toàn bộ động mạch tim (động mạch vành). Nguyên nhâ', n.when_to_see = 'Nhận trợ giúp khẩn cấp nếu bạn bị đau ngực dữ dội hoặc đau ngực không thuyên giảm.';
MERGE (n:Disease {id: 'D2004'}) SET n.id = 'D2004', n.name = 'Viêm cơ tim', n.name_en = 'Myocarditis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/myocarditis/symptoms-causes/syc-20352539 | https://medlineplus.gov/ency/article/000149.htm', n.overview = 'ham muốn cho thấy cơ tim điển hình so với cơ tim bị tổn thương do viêm. Viêm cơ tim là tình trạng viêm cơ tim, được gọi là cơ tim. Tình trạng này có thể làm giảm khả năng bơm máu của tim. Viêm cơ tim ', n.prognosis = 'Kết quả có thể khác nhau, tùy thuộc vào nguyên nhân của vấn đề và sức khỏe tổng thể của một người. Một số người có thể hồi phục hoàn toàn. Những người khác có thể bị suy tim kéo dài.', n.when_to_see = 'Liên hệ với chuyên gia chăm sóc sức khỏe nếu bạn có triệu chứng viêm cơ tim. Các triệu chứng của viêm cơ tim có thể giống như một cơn đau tim. Nhận trợ giúp y tế khẩn cấp nếu bạn bị đau ngực không rõ ';
MERGE (n:Disease {id: 'D2005'}) SET n.id = 'D2005', n.name = 'Viêm cơ tim - nhi khoa', n.name_en = 'Myocarditis - pediatric', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007307.htm', n.prognosis = 'Việc phục hồi sau viêm cơ tim phụ thuộc vào nguyên nhân của vấn đề và sức khỏe tổng thể của trẻ. Hầu hết trẻ em hồi phục hoàn toàn nếu được điều trị thích hợp. Tuy nhiên, một số có thể mắc bệnh tim vĩ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu có dấu hiệu hoặc triệu chứng của tình trạng này.';
MERGE (n:Disease {id: 'D2006'}) SET n.id = 'D2006', n.name = 'Myoclonus', n.name_en = 'Myoclonus', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/myoclonus/symptoms-causes/syc-20350459', n.overview = 'đề cập đến chuyển động giật nhanh mà bạn không thể kiểm soát. Nấc cụt là một dạng rung giật cơ, cũng như những cơn giật đột ngột hoặc "bắt đầu giấc ngủ" mà bạn có thể cảm thấy ngay trước khi chìm vào ', n.when_to_see = 'Nếu các triệu chứng rung giật cơ của bạn trở nên thường xuyên và dai dẳng, hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn về các lựa chọn chẩn đoán và điều trị. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2007'}) SET n.id = 'D2007', n.name = 'Hội chứng đau cân cơ', n.name_en = 'Myofascial pain syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/myofascial-pain-syndrome/symptoms-causes/syc-20375444', n.overview = 'là tình trạng đau kéo dài. Nó liên quan đến một số cơ và lớp mô mỏng giữ cơ tại chỗ, được gọi là màng cơ. Áp lực lên những khu vực này, được gọi là điểm kích hoạt, gây đau. Đôi khi, cơn đau được cảm n', n.when_to_see = 'Hầu hết mọi người đều có lúc bị đau cơ. Nhưng nếu cơn đau cơ của bạn không biến mất khi nghỉ ngơi, xoa bóp và các biện pháp tự chăm sóc khác, hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn. Yêu cầu ';
MERGE (n:Disease {id: 'D2008'}) SET n.id = 'D2008', n.name = 'Myotonia congenita', n.name_en = 'Myotonia congenita', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001424.htm', n.prognosis = 'Những người mắc bệnh này có thể hồi phục tốt. Các triệu chứng chỉ xảy ra khi bắt đầu chuyển động lần đầu tiên. Sau một vài lần lặp lại, cơ sẽ thư giãn và chuyển động trở nên bình thường.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn có các triệu chứng của chứng tăng trương lực cơ bẩm sinh.';
MERGE (n:Disease {id: 'D2009'}) SET n.id = 'D2009', n.name = 'Ngộ độc dầu myristica', n.name_en = 'Myristica oil poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002899.htm', n.prognosis = 'Một người khỏe mạnh như thế nào tùy thuộc vào lượng dầu myristica được nuốt vào và tốc độ điều trị được tiếp nhận như thế nào. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Ảo giác, lo lắn';
MERGE (n:Disease {id: 'D2010'}) SET n.id = 'D2010', n.name = 'Myxofibrosarcoma', n.name_en = 'Myxofibrosarcoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/myxofibrosarcoma/symptoms-causes/syc-20577507', n.overview = 'là một loại ung thư bắt đầu ở mô liên kết. Nó có xu hướng xảy ra ở cánh tay và chân. Myxofibrosarcoma bắt đầu bằng sự phát triển của các tế bào có thể phát triển thành mô cơ thể khỏe mạnh. Myxofibrosa', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2011'}) SET n.id = 'D2011', n.name = 'U nang nabothian', n.name_en = 'Nabothian cyst', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001514.htm', n.prognosis = 'U nang Nabothian không gây hại gì. Chúng là một tình trạng lành tính.', n.when_to_see = 'Hầu hết, tình trạng này được phát hiện khi khám phụ khoa định kỳ.';
MERGE (n:Disease {id: 'D2012'}) SET n.id = 'D2012', n.name = 'Những bất thường ở móng', n.name_en = 'Nail abnormalities', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003247.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Móng tay màu xanh Móng tay nhọn Móng tay biến dạng Đường vân ngang Móng tay nhợt nhạt Đường trắng dưới móng tay Màu trắng dưới móng tay Lột món';
MERGE (n:Disease {id: 'D2013'}) SET n.id = 'D2013', n.name = 'Nấm móng', n.name_en = 'Nail fungus', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/nail-fungus/symptoms-causes/syc-20353294', n.overview = 'và bị đổi màu. Móng bị nhiễm trùng có thể tách ra khỏi giường móng. Nấm móng tay là một bệnh nhiễm trùng phổ biến ở móng tay. Nó bắt đầu như một đốm trắng hoặc nâu vàng dưới đầu móng tay hoặc móng châ', n.when_to_see = 'Bạn có thể muốn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe nếu các bước tự chăm sóc không giúp ích gì và móng ngày càng bị đổi màu, dày lên hoặc biến dạng. Đồng thời, hãy nói chuyện với nhà cung cấp d';
MERGE (n:Disease {id: 'D2014'}) SET n.id = 'D2014', n.name = 'Ngộ độc sơn móng tay', n.name_en = 'Nail polish poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002722.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận như thế nào. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Sơn móng tay có x';
MERGE (n:Disease {id: 'D2015'}) SET n.id = 'D2015', n.name = 'Ngộ độc Naphthalene', n.name_en = 'Naphthalene poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002477.htm', n.prognosis = 'Có thể mất vài tuần hoặc lâu hơn để hồi phục sau một số tác động của chất độc. Nếu người đó bị co giật và hôn mê thì tiên lượng sẽ không tốt.';
MERGE (n:Disease {id: 'D2016'}) SET n.id = 'D2016', n.name = 'Quá liều natri naproxen', n.name_en = 'Naproxen sodium overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002507.htm', n.prognosis = 'Recovery is likely.';
MERGE (n:Disease {id: 'D2017'}) SET n.id = 'D2017', n.name = 'Rối loạn nhân cách tự ái', n.name_en = 'Narcissistic personality disorder', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/narcissistic-personality-disorder/symptoms-causes/syc-20366662 | https://medlineplus.gov/ency/article/000934.htm', n.overview = 'là một tình trạng sức khỏe tâm thần trong đó mọi người có ý thức cao một cách vô lý về tầm quan trọng của bản thân. Họ cần và tìm kiếm quá nhiều sự chú ý và muốn mọi người ngưỡng mộ họ. Những người mắ', n.prognosis = 'Kết quả điều trị phụ thuộc vào mức độ nghiêm trọng của chứng rối loạn và mức độ sẵn sàng thay đổi của người đó.', n.when_to_see = 'Những người mắc chứng rối loạn nhân cách tự ái có thể không muốn nghĩ rằng có điều gì đó không ổn nên họ thường không tìm cách điều trị. Nếu họ tìm cách điều trị, nhiều khả năng đó là do các triệu chứ';
MERGE (n:Disease {id: 'D2018'}) SET n.id = 'D2018', n.name = 'Chứng ngủ rũ', n.name_en = 'Narcolepsy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/narcolepsy/symptoms-causes/syc-20375497 | https://medlineplus.gov/ency/article/000802.htm', n.overview = 'là tình trạng khiến con người rất buồn ngủ vào ban ngày và có thể khiến họ chìm vào giấc ngủ đột ngột. Một số người còn có các triệu chứng khác, chẳng hạn như yếu cơ khi họ có cảm xúc mạnh. Các triệu ', n.prognosis = 'Chứng ngủ rũ là một tình trạng kéo dài suốt đời. Có thể nguy hiểm nếu các cơn xảy ra khi lái xe, vận hành máy móc hoặc thực hiện các hoạt động tương tự. Chứng ngủ rũ thường có thể được kiểm soát bằng ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn cảm thấy buồn ngủ ban ngày ảnh hưởng đến cuộc sống cá nhân hoặc nghề nghiệp của bạn. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu';
MERGE (n:Disease {id: 'D2019'}) SET n.id = 'D2019', n.name = 'Các khối u ở mũi và cạnh mũi', n.name_en = 'Nasal and paranasal tumors', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/nasal-paranasal-tumors/symptoms-causes/syc-20354136', n.overview = 'là những khối u bắt đầu ở trong và xung quanh đường đi trong mũi. Các khối u ở mũi bắt đầu ở lối đi chính trong mũi, được gọi là khoang mũi. Các khối u cạnh mũi bắt đầu trong các khoang chứa đầy không', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D2020'}) SET n.id = 'D2020', n.name = 'Phình mũi', n.name_en = 'Nasal flaring', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003055.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Có bất kỳ hiện tượng sổ mũi dai dẳng, không rõ nguyên nhân, đặc biệt là ở trẻ nhỏ. Màu hơi xanh phát triển ở môi, giường móng hoặc d';
MERGE (n:Disease {id: 'D2021'}) SET n.id = 'D2021', n.name = 'Polyp mũi', n.name_en = 'Nasal polyps', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/nasal-polyps/symptoms-causes/syc-20351888 | https://medlineplus.gov/ency/article/001641.htm', n.overview = 'e hoặc các khoảng trống bên trong mũi, được gọi là xoang. Polyp mũi không phải là ung thư Polyp mũi thường mọc thành từng nhóm giống như quả nho trên thân. Polyp mũi là sự phát triển không đau bên tro', n.prognosis = 'Loại bỏ polyp bằng phẫu thuật thường giúp bạn thở bằng mũi dễ dàng hơn. Tuy nhiên, theo thời gian, polyp mũi thường quay trở lại. Mất mùi hoặc vị không phải lúc nào cũng cải thiện sau khi điều trị bằn', n.when_to_see = 'Gặp nhà cung cấp dịch vụ chăm sóc sức khỏe để biết các triệu chứng kéo dài hơn 10 ngày. Các triệu chứng của viêm xoang mãn tính và polyp mũi cũng giống như nhiều bệnh khác, bao gồm cả cảm lạnh thông t';
MERGE (n:Disease {id: 'D2022'}) SET n.id = 'D2022', n.name = 'Tụ máu vách ngăn mũi', n.name_en = 'Nasal septal hematoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001292.htm', n.prognosis = 'Bạn sẽ lành hẳn nếu vết thương được điều trị nhanh chóng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu có bất kỳ chấn thương mũi nào dẫn đến nghẹt mũi hoặc đau mũi. Bạn có thể được giới thiệu đến bác sĩ chuyên khoa tai mũi họng (ENT).';
MERGE (n:Disease {id: 'D2023'}) SET n.id = 'D2023', n.name = 'Ung thư biểu mô vòm họng', n.name_en = 'Nasopharyngeal carcinoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/nasopharyngeal-carcinoma/symptoms-causes/syc-20375529', n.overview = 'Các bộ phận của ống họng (họng) chạy từ sau mũi xuống cổ. Cổ họng còn được gọi là họng. Nó bao gồm ba phần: vòm họng, hầu họng và thanh quản. Thanh quản còn được gọi là hạ họng. Ung thư biểu mô vòm họ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
';
MERGE (n:Disease {id: 'D2024'}) SET n.id = 'D2024', n.name = 'Răng sơ sinh', n.name_en = 'Natal teeth', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003268.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu trẻ sơ sinh có răng sơ sinh bị đau lưỡi hoặc miệng hoặc các triệu chứng khác.';
MERGE (n:Disease {id: 'D2025'}) SET n.id = 'D2025', n.name = 'Người ngủ ngắn tự nhiên', n.name_en = 'Natural short sleeper', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000804.htm';
MERGE (n:Disease {id: 'D2026'}) SET n.id = 'D2026', n.name = 'Buồn nôn và nôn - người lớn', n.name_en = 'Nausea and vomiting – adults', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003117.htm', n.when_to_see = 'Gọi 911 hoặc số cấp cứu tại địa phương hoặc đến phòng cấp cứu nếu bạn: Nghĩ rằng nôn mửa là do ngộ độc Chú ý đến máu hoặc màu sẫm, chất màu cà phê trong chất nôn Liên hệ với nhà cung cấp của bạn ngay ';
MERGE (n:Disease {id: 'D2027'}) SET n.id = 'D2027', n.name = 'Cận thị', n.name_en = 'Nearsightedness', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/nearsightedness/symptoms-causes/syc-20375556 | https://medlineplus.gov/ency/article/001023.htm', n.overview = 'trên võng mạc. Khi cận thị, tiêu điểm nằm ở phía trước võng mạc, làm cho các vật ở xa trông mờ đi. Cận thị là một tình trạng thị lực phổ biến, trong đó các vật thể nhìn rõ nhưng các vật ở xa trông mờ.', n.prognosis = 'Việc chẩn đoán sớm bệnh cận thị là rất quan trọng. Một đứa trẻ có thể gặp khó khăn về mặt xã hội và giáo dục do không thể nhìn rõ ở khoảng cách xa.', n.when_to_see = 'Hãy hẹn gặp bác sĩ chuyên khoa mắt nếu con bạn có bất kỳ dấu hiệu nào về vấn đề về thị lực hoặc nếu giáo viên báo cáo các vấn đề có thể xảy ra. Hãy tự đặt lịch hẹn nếu bạn nhận thấy có sự thay đổi về ';
MERGE (n:Disease {id: 'D2028'}) SET n.id = 'D2028', n.name = 'Phẫu tích cổ', n.name_en = 'Neck dissection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007573.htm', n.overview = 'là một cuộc phẫu thuật lớn được thực hiện để loại bỏ các hạch bạch huyết có thể chứa ung thư. Nó được thực hiện trong bệnh viện. Trước khi phẫu thuật, bạn sẽ được gây mê toàn thân. Điều này sẽ khiến b', n.prognosis = 'Thời gian lành vết thương phụ thuộc vào lượng mô được loại bỏ.';
MERGE (n:Disease {id: 'D2029'}) SET n.id = 'D2029', n.name = 'Khối u ở cổ', n.name_en = 'Neck lump', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003098.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn bị sưng cổ hoặc có khối u bất thường ở cổ.';
MERGE (n:Disease {id: 'D2030'}) SET n.id = 'D2030', n.name = 'Đau cổ', n.name_en = 'Neck pain', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/neck-pain/symptoms-causes/syc-20375581 | https://medlineplus.gov/ency/article/003025.htm', n.overview = 'là chuyện thường gặp. Tư thế xấu - dù nghiêng người trước máy tính hay khom người trên bàn làm việc - đều làm căng cơ cổ. Viêm xương khớp cũng là nguyên nhân phổ biến gây đau cổ. Hiếm khi, đau cổ có t', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc ngay lập tức nếu chứng đau cổ nghiêm trọng do chấn thương, chẳng hạn như tai nạn xe cơ giới, tai nạn lặn hoặc té ngã. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu đa';
MERGE (n:Disease {id: 'D2031'}) SET n.id = 'D2031', n.name = 'Necrobiosis lipoidica diseaseorum', n.name_en = 'Necrobiosis lipoidica diabeticorum', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007742.htm', n.prognosis = 'NLD là một căn bệnh lâu dài. Các vết thương không lành và có thể tái phát. Vết loét rất khó điều trị. Vẻ ngoài của da có thể mất nhiều thời gian để trở lại bình thường, ngay cả sau khi điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn mắc bệnh tiểu đường và nhận thấy các tổn thương không lành trên cơ thể, đặc biệt là ở phần dưới của chân.';
MERGE (n:Disease {id: 'D2032'}) SET n.id = 'D2032', n.name = 'Viêm ruột hoại tử', n.name_en = 'Necrotizing enterocolitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001148.htm', n.prognosis = 'NEC là một căn bệnh nghiêm trọng. Có tới 40% trẻ sơ sinh mắc NEC tử vong vì bệnh này. Điều trị sớm, tích cực có thể giúp cải thiện kết quả.', n.when_to_see = 'Được chăm sóc y tế khẩn cấp nếu có bất kỳ triệu chứng nào của viêm ruột hoại tử phát triển. Trẻ sơ sinh nhập viện vì bệnh tật hoặc sinh non có nguy cơ mắc NEC cao hơn. Họ được theo dõi chặt chẽ về vấn';
MERGE (n:Disease {id: 'D2033'}) SET n.id = 'D2033', n.name = 'Nhiễm trùng mô mềm hoại tử', n.name_en = 'Necrotizing soft tissue infection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001443.htm', n.prognosis = 'Sức khỏe tổng thể của bạn phụ thuộc vào: Sức khỏe tổng thể của bạn (đặc biệt nếu bạn mắc bệnh tiểu đường) Bạn được chẩn đoán nhanh như thế nào và bạn được điều trị nhanh như thế nào Loại vi khuẩn gây ', n.when_to_see = 'Chứng rối loạn này nghiêm trọng và có thể đe dọa tính mạng. Liên hệ với nhà cung cấp của bạn ngay lập tức nếu các triệu chứng nhiễm trùng xảy ra xung quanh vết thương trên da, bao gồm: Chảy mủ hoặc má';
MERGE (n:Disease {id: 'D2034'}) SET n.id = 'D2034', n.name = 'Viêm mạch hoại tử', n.name_en = 'Necrotizing vasculitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000432.htm', n.prognosis = 'Viêm mạch hoại tử có thể là căn bệnh nghiêm trọng và đe dọa tính mạng. Kết quả phụ thuộc vào vị trí của viêm mạch và mức độ nghiêm trọng của tổn thương mô. Các biến chứng có thể xảy ra do bệnh và do t', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng viêm mạch hoại tử. Các triệu chứng khẩn cấp bao gồm: Các vấn đề ở nhiều bộ phận cơ thể như đột quỵ, viêm khớp, phát ban da nghiê';
MERGE (n:Disease {id: 'D2035'}) SET n.id = 'D2035', n.name = 'Hội chứng kiêng khem ở trẻ sơ sinh', n.name_en = 'Neonatal abstinence syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007313.htm', n.prognosis = 'Điều trị giúp giảm các triệu chứng cai nghiện. Ngay cả sau khi quá trình điều trị NAS kết thúc và trẻ xuất viện, chúng có thể cần thêm "TLC" trong nhiều tuần hoặc nhiều tháng.', n.when_to_see = 'Hãy đảm bảo rằng nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn biết về tất cả các loại thuốc, chất bổ sung và thuốc bạn dùng trong thời kỳ mang thai. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏ';
MERGE (n:Disease {id: 'D2036'}) SET n.id = 'D2036', n.name = 'Viêm kết mạc sơ sinh', n.name_en = 'Neonatal conjunctivitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001606.htm', n.prognosis = 'Chẩn đoán và điều trị nhanh chóng thường mang lại kết quả tốt.', n.when_to_see = 'Hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn đã sinh con (hoặc sắp sinh con) ở nơi không thường xuyên nhỏ thuốc kháng sinh hoặc bạc nitrat vào mắt trẻ sơ sinh. Một ví dụ l';
MERGE (n:Disease {id: 'D2037'}) SET n.id = 'D2037', n.name = 'Suy giáp ở trẻ sơ sinh', n.name_en = 'Neonatal hypothyroidism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001193.htm', n.prognosis = 'Được chẩn đoán sớm thường mang lại kết quả tốt. Trẻ sơ sinh được chẩn đoán và điều trị trong khoảng tháng đầu tiên thường có trí thông minh bình thường. Suy giáp nhẹ không được điều trị có thể dẫn đến', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn cảm thấy trẻ sơ sinh của mình có dấu hiệu hoặc triệu chứng của bệnh suy giáp Bạn đang mang thai và đã tiếp xúc với các loại thuố';
MERGE (n:Disease {id: 'D2038'}) SET n.id = 'D2038', n.name = 'Hội chứng suy hô hấp ở trẻ sơ sinh', n.name_en = 'Neonatal respiratory distress syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001563.htm', n.prognosis = 'Tình trạng này thường trở nên nặng hơn trong 2 đến 4 ngày sau khi sinh và cải thiện dần dần sau đó. Một số trẻ sơ sinh mắc hội chứng suy hô hấp nặng sẽ tử vong. Điều này thường xảy ra nhất từ ​​ngày t', n.when_to_see = 'Hầu hết, vấn đề này phát triển ngay sau khi sinh trong khi em bé vẫn còn nằm viện. Nếu bạn sinh con tại nhà hoặc bên ngoài trung tâm y tế, hãy nhận trợ giúp khẩn cấp nếu con bạn có vấn đề về hô hấp.';
MERGE (n:Disease {id: 'D2039'}) SET n.id = 'D2039', n.name = 'Nhiễm trùng sơ sinh', n.name_en = 'Neonatal sepsis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007303.htm', n.prognosis = 'Nhiều bé bị nhiễm khuẩn sẽ khỏi hoàn toàn và không gặp vấn đề gì khác. Tuy nhiên, nhiễm trùng sơ sinh là nguyên nhân hàng đầu gây tử vong ở trẻ sơ sinh. Trẻ sơ sinh được điều trị càng nhanh thì kết qu', n.when_to_see = 'Tìm kiếm sự trợ giúp y tế ngay lập tức đối với trẻ sơ sinh có triệu chứng nhiễm trùng sơ sinh.';
MERGE (n:Disease {id: 'D2040'}) SET n.id = 'D2040', n.name = 'Tăng cân và dinh dưỡng cho trẻ sơ sinh', n.name_en = 'Neonatal weight gain and nutrition', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007302.htm', n.overview = 'Trẻ sinh ra ở tuần thai dưới 37 tuần (sinh non) có nhu cầu dinh dưỡng khác với trẻ sinh đủ tháng (từ 39 tuần trở lên). Trẻ sinh non thường sẽ ở trong phòng chăm sóc đặc biệt dành cho trẻ sơ sinh (NICU';
MERGE (n:Disease {id: 'D2041'}) SET n.id = 'D2041', n.name = 'Sơ sinh', n.name_en = 'Neonate', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002271.htm', n.overview = 'Trẻ sơ sinh còn được gọi là trẻ sơ sinh. Thời kỳ sơ sinh là 4 tuần đầu tiên trong cuộc đời của trẻ. Đó là thời điểm mà những thay đổi diễn ra rất nhanh chóng. Nhiều sự kiện quan trọng có thể xảy ra tr';
MERGE (n:Disease {id: 'D2042'}) SET n.id = 'D2042', n.name = 'Bệnh canxi hóa thận', n.name_en = 'Nephrocalcinosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000492.htm', n.prognosis = 'Điều gì sẽ xảy ra tùy thuộc vào các biến chứng và nguyên nhân của tình trạng này. Điều trị thích hợp có thể giúp ngăn ngừa sự lắng đọng thêm ở thận. Trong hầu hết các trường hợp, không có cách nào để ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn biết mình mắc chứng rối loạn gây ra lượng canxi cao trong máu và nước tiểu. Đồng thời liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn phát triển c';
MERGE (n:Disease {id: 'D2043'}) SET n.id = 'D2043', n.name = 'Bệnh đái tháo nhạt do thận', n.name_en = 'Nephrogenic diabetes insipidus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000511.htm', n.prognosis = 'Nếu một người uống đủ nước, tình trạng này sẽ không ảnh hưởng nhiều đến sự cân bằng chất lỏng hoặc điện giải của cơ thể. Đôi khi, đi tiểu nhiều trong thời gian dài có thể gây ra các vấn đề về điện giả', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn hoặc con bạn có các triệu chứng của chứng rối loạn này.';
MERGE (n:Disease {id: 'D2044'}) SET n.id = 'D2044', n.name = 'Xơ hóa hệ thống do thận', n.name_en = 'Nephrogenic systemic fibrosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/nephrogenic-systemic-fibrosis/symptoms-causes/syc-20352299', n.overview = 'là một căn bệnh hiếm gặp, xảy ra chủ yếu ở những người bị suy thận nặng có hoặc không chạy thận nhân tạo. Xơ hóa hệ thống do thận có thể giống với các bệnh về da, chẳng hạn như xơ cứng bì và phù xơ cứ';
MERGE (n:Disease {id: 'D2045'}) SET n.id = 'D2045', n.name = 'Hội chứng thận hư', n.name_en = 'Nephrotic syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/nephrotic-syndrome/symptoms-causes/syc-20375608 | https://medlineplus.gov/ency/article/000490.htm', n.overview = 'là một chứng rối loạn thận khiến cơ thể bạn thải quá nhiều protein qua nước tiểu. Hội chứng thận hư thường do tổn thương các cụm mạch máu nhỏ trong thận có chức năng lọc chất thải và nước dư thừa từ m', n.prognosis = 'Kết quả sẽ khác nhau. Một số người hồi phục sau tình trạng này. Những người khác phát triển bệnh thận lâu dài và cuối cùng có thể cần phải lọc máu và ghép thận.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn hoặc con bạn có các triệu chứng của hội chứng thận hư, bao gồm sưng mặt, bụng, cánh tay và chân, hoặc lở loét trên da Bạn hoặc con bạn đang được điều ';
MERGE (n:Disease {id: 'D2046'}) SET n.id = 'D2046', n.name = 'Khối u vỏ thần kinh', n.name_en = 'Nerve sheath tumors', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/nerve-sheath-tumors/symptoms-causes/syc-20594703', n.overview = 'Schwannoma tiền đình hay còn gọi là u dây thần kinh thính giác, là một khối u lành tính phát triển trên dây thần kinh thăng bằng và thính giác dẫn từ tai trong đến não. Những dây thần kinh này xoắn lạ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào được liệt kê, đặc biệt nếu bạn có khối u phát triển nhanh chóng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2047'}) SET n.id = 'D2047', n.name = 'Đau dây thần kinh', n.name_en = 'Neuralgia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001407.htm', n.prognosis = 'Hầu hết các chứng đau dây thần kinh không đe dọa tính mạng và không phải là dấu hiệu của các rối loạn đe dọa tính mạng khác. Đối với cơn đau dữ dội không cải thiện, hãy đến gặp bác sĩ chuyên khoa về đ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn phát triển bệnh zona Bạn có các triệu chứng đau dây thần kinh, đặc biệt nếu thuốc giảm đau không kê đơn không làm giảm cơn đau của bạn Bạn bị đau ';
MERGE (n:Disease {id: 'D2048'}) SET n.id = 'D2048', n.name = 'U nguyên bào thần kinh', n.name_en = 'Neuroblastoma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/neuroblastoma/symptoms-causes/syc-20351017 | https://medlineplus.gov/ency/article/001408.htm', n.overview = 'Tuyến thượng thận tạo ra các hormone giúp điều hòa quá trình trao đổi chất, hệ thống miễn dịch, huyết áp và các chức năng quan trọng khác. Mặc dù nhỏ nhưng những tuyến này kiểm soát phần lớn những gì ', n.prognosis = 'Kết quả sẽ khác nhau. Ở trẻ nhỏ, khối u có thể tự biến mất mà không cần điều trị. Hoặc, các mô của khối u có thể trưởng thành và phát triển thành khối u không gây ung thư (lành tính) được gọi là u hạc', n.when_to_see = 'Hãy liên hệ với chuyên gia chăm sóc sức khỏe của con bạn nếu con bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Đề cập đến bất kỳ thay đổi nào trong hành vi, thói quen hoặc ngoại hình của con bạn. Y';
MERGE (n:Disease {id: 'D2049'}) SET n.id = 'D2049', n.name = 'Rối loạn nhận thức thần kinh', n.name_en = 'Neurocognitive disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001401.htm', n.prognosis = 'Một số rối loạn có tính chất ngắn hạn và có thể hồi phục được. Nhưng nhiều trường hợp là lâu dài hoặc trở nên tồi tệ hơn theo thời gian.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn đã được chẩn đoán mắc chứng rối loạn nhận thức thần kinh và bạn không chắc chắn về chứng rối loạn chính xác. Bạn có các triệu ch';
MERGE (n:Disease {id: 'D2050'}) SET n.id = 'D2050', n.name = 'Thoái hóa thần kinh do tích tụ sắt trong não (NBIA)', n.name_en = 'Neurodegeneration with brain iron accumulation (NBIA)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001225.htm', n.prognosis = 'NBIA làm tổn thương dây thần kinh theo thời gian và các triệu chứng trở nên tồi tệ hơn. Nó dẫn đến việc thiếu khả năng vận động và thường tử vong ở tuổi trưởng thành sớm.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn phát triển: Tăng độ cứng ở tay hoặc chân Các vấn đề gia tăng ở trường Chuyển động bất thường';
MERGE (n:Disease {id: 'D2051'}) SET n.id = 'D2051', n.name = 'Viêm da thần kinh', n.name_en = 'Neurodermatitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/neurodermatitis/symptoms-causes/syc-20375634', n.overview = 'd do ngứa hoặc đóng vảy mãn tính. Bạn sẽ nhận thấy những vùng da nổi lên, thô ráp, ngứa ngáy - thường ở cổ, cổ tay, cẳng tay, chân hoặc vùng háng. Viêm da thần kinh là một tình trạng da bắt đầu bằng m', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu các biện pháp khắc phục tại nhà không giúp ích sau hai ngày và: Bạn thấy mình liên tục gãi cùng một mảng da Ngứa khiến bạn không thể ngủ hoặc';
MERGE (n:Disease {id: 'D2052'}) SET n.id = 'D2052', n.name = 'Các khối u thần kinh nội tiết', n.name_en = 'Neuroendocrine tumors', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/neuroendocrine-tumors/symptoms-causes/syc-20354132', n.overview = 'là những bệnh ung thư bắt đầu từ các tế bào thần kinh nội tiết. Các tế bào thần kinh nội tiết có những đặc điểm tương tự như các tế bào thần kinh, gửi và nhận tín hiệu từ não, và các tế bào nội tiết, ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
';
MERGE (n:Disease {id: 'D2053'}) SET n.id = 'D2053', n.name = 'U xơ thần kinh', n.name_en = 'Neurofibroma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/neurofibroma/symptoms-causes/syc-20573693', n.overview = 'U xơ thần kinh là một loại khối u thần kinh ngoại biên tạo thành một vết sưng mềm trên hoặc dưới da. Khối u có thể phát triển bên trong dây thần kinh lớn hoặc nhỏ ở bất kỳ vị trí nào trong cơ thể. Loạ';
MERGE (n:Disease {id: 'D2054'}) SET n.id = 'D2054', n.name = 'Neurofibromatosis 2', n.name_en = 'Neurofibromatosis 2', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000795.htm';
MERGE (n:Disease {id: 'D2055'}) SET n.id = 'D2055', n.name = 'Neurofibromatosis type 1', n.name_en = 'Neurofibromatosis type 1', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/neurofibromatosis-type-1/symptoms-causes/syc-20350490', n.overview = '(NF1) là một tình trạng di truyền gây ra những thay đổi về sắc tố da và các khối u trên mô thần kinh. Những thay đổi về da bao gồm các đốm phẳng, màu nâu nhạt và tàn nhang ở nách và háng. Các khối u c', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu con bạn có các triệu chứng của bệnh u xơ thần kinh loại 1. Các khối u thường không phải là ung thư và phát triển chậm nhưng có thể kiểm soát được các biến chứn';
MERGE (n:Disease {id: 'D2056'}) SET n.id = 'D2056', n.name = 'Neurofibromatosis-1', n.name_en = 'Neurofibromatosis-1', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000847.htm', n.prognosis = 'Nếu không có biến chứng thì tuổi thọ của người mắc bệnh NF1 gần như bình thường. Với nền giáo dục phù hợp, những người mắc bệnh NF1 có thể sống một cuộc sống bình thường. Mặc dù suy giảm tâm thần nói ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn nhận thấy có nhiều đốm màu cà phê sữa trên da của con bạn hoặc bất kỳ triệu chứng nào khác của tình trạng này. Bạn có tiền sử gia đình mắc bệnh NF1 và đan';
MERGE (n:Disease {id: 'D2057'}) SET n.id = 'D2057', n.name = 'Bàng quang thần kinh', n.name_en = 'Neurogenic bladder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000754.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn: Không thể làm trống bàng quang Có dấu hiệu nhiễm trùng bàng quang (sốt, nóng rát khi đi tiểu, đi tiểu thường xuyên) Đi tiểu một lượn';
MERGE (n:Disease {id: 'D2058'}) SET n.id = 'D2058', n.name = 'Viêm dây thần kinh thị giác', n.name_en = 'Neuromyelitis optica', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/neuromyelitis-optica/symptoms-causes/syc-20375652 | https://medlineplus.gov/ency/article/007809.htm', n.overview = ', còn được gọi là NMO, là một rối loạn hệ thần kinh trung ương gây viêm dây thần kinh mắt và tủy sống. NMO còn được gọi là rối loạn phổ viêm tủy thị thần kinh (NMOSD) và bệnh Devic. Nó xảy ra khi hệ t', n.prognosis = 'NMO là một căn bệnh mãn tính. Hầu hết mọi người đều gặp phải các cuộc tấn công NMO định kỳ (tái phát) trong khi một số người có thể bị tấn công một lần (đơn pha). Chẩn đoán sớm và điều trị kịp thời bằ', n.when_to_see = 'Nếu bạn được chẩn đoán mắc NMO, bạn nên giữ liên lạc với nhà cung cấp của mình để tránh bất kỳ sự tiến triển nào thêm của tình trạng này. Liên hệ với nhà cung cấp dịch vụ của bạn ngay lập tức nếu bạn ';
MERGE (n:Disease {id: 'D2059'}) SET n.id = 'D2059', n.name = 'Lipofuscinoses ceroid thần kinh (NCL)', n.name_en = 'Neuronal ceroid lipofuscinoses (NCL)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001613.htm', n.prognosis = 'Người càng trẻ khi bệnh xuất hiện thì nguy cơ tàn tật và tử vong sớm càng lớn. Những người phát bệnh sớm có thể gặp các vấn đề về thị lực dẫn đến mù lòa và các vấn đề về chức năng tâm thần trở nên tồi', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu con bạn có các triệu chứng mù lòa hoặc thiểu năng trí tuệ.';
MERGE (n:Disease {id: 'D2060'}) SET n.id = 'D2060', n.name = 'Bệnh lý thần kinh thứ phát do thuốc', n.name_en = 'Neuropathy secondary to drugs', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000700.htm', n.prognosis = 'Nhiều người có thể trở lại một phần hoặc toàn bộ chức năng bình thường của mình. Chứng rối loạn này thường không gây ra các biến chứng đe dọa tính mạng nhưng có thể gây khó chịu hoặc gây tàn tật.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị mất cảm giác hoặc cử động ở bất kỳ vùng nào trên cơ thể trong khi dùng bất kỳ loại thuốc nào.';
MERGE (n:Disease {id: 'D2061'}) SET n.id = 'D2061', n.name = 'Bệnh sarcoid thần kinh', n.name_en = 'Neurosarcoidosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000720.htm', n.prognosis = 'Đối với một số người, các triệu chứng của bệnh sarcoid thần kinh sẽ tự biến mất sau 4 đến 6 tháng. Những người khác tiếp tục lặp đi lặp lại trong suốt quãng đời còn lại của con người. Neurosarcoidosis', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn mắc bệnh sarcoidosis và có bất kỳ triệu chứng thần kinh nào xảy ra. Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa ph';
MERGE (n:Disease {id: 'D2062'}) SET n.id = 'D2062', n.name = 'Khoa học thần kinh', n.name_en = 'Neurosciences', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007456.htm', n.overview = 'Nhiều tình trạng y tế khác nhau có thể ảnh hưởng đến hệ thần kinh, bao gồm: Rối loạn mạch máu trong não, bao gồm dị tật động tĩnh mạch và phình động mạch não Khối u, lành tính và ác tính (ung thư) Bện';
MERGE (n:Disease {id: 'D2063'}) SET n.id = 'D2063', n.name = 'Bệnh giang mai thần kinh', n.name_en = 'Neurosyphilis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000703.htm', n.prognosis = 'Giang mai thần kinh là một biến chứng nguy hiểm đến tính mạng của bệnh giang mai. Tình trạng của bạn tốt như thế nào tùy thuộc vào mức độ nghiêm trọng của bệnh giang mai thần kinh trước khi điều trị. ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu trước đây bạn đã mắc bệnh giang mai và hiện có dấu hiệu của các vấn đề về hệ thần kinh.';
MERGE (n:Disease {id: 'D2064'}) SET n.id = 'D2064', n.name = 'Giảm bạch cầu - trẻ sơ sinh', n.name_en = 'Neutropenia - infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007230.htm', n.prognosis = 'Triển vọng của em bé phụ thuộc vào nguyên nhân gây giảm bạch cầu. Một số bệnh nhiễm trùng và các tình trạng khác ở trẻ sơ sinh có thể đe dọa tính mạng. Tuy nhiên, hầu hết các bệnh nhiễm trùng không gâ';
MERGE (n:Disease {id: 'D2065'}) SET n.id = 'D2065', n.name = 'Hội chứng ung thư biểu mô tế bào đáy Nevoid', n.name_en = 'Nevoid basal cell carcinoma syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001452.htm', n.prognosis = 'Việc theo dõi thường xuyên với nhiều chuyên gia khác nhau là điều quan trọng để có được kết quả tốt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn hoặc bất kỳ thành viên nào trong gia đình mắc hội chứng ung thư biểu mô tế bào đáy, đặc biệt nếu bạn đang có kế hoạch sinh con. ';
MERGE (n:Disease {id: 'D2066'}) SET n.id = 'D2066', n.name = 'Khuôn đầu trẻ sơ sinh', n.name_en = 'Newborn head molding', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002270.htm', n.overview = 'Xương sọ của trẻ sơ sinh mềm và dẻo, có khoảng trống giữa các tấm xương. Khoảng trống giữa các tấm xương của hộp sọ được gọi là khớp sọ. Thóp trước (trước) và thóp sau (sau) là 2 khoảng trống đặc biệt';
MERGE (n:Disease {id: 'D2067'}) SET n.id = 'D2067', n.name = 'Bệnh vàng da sơ sinh', n.name_en = 'Newborn jaundice', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001559.htm', n.prognosis = 'Bệnh vàng da sơ sinh hầu như không có hại. Đối với hầu hết trẻ sơ sinh, bệnh vàng da sẽ thuyên giảm nếu không cần điều trị trong vòng 1 đến 2 tuần. Nồng độ bilirubin rất cao có thể gây tổn thương não.', n.when_to_see = 'Tất cả trẻ sơ sinh nên được bác sĩ khám trong 5 ngày đầu đời để kiểm tra bệnh vàng da: Trẻ sơ sinh nằm viện dưới 24 giờ nên được khám trước 72 giờ. Trẻ sơ sinh được gửi về nhà trong khoảng thời gian t';
MERGE (n:Disease {id: 'D2068'}) SET n.id = 'D2068', n.name = 'Bệnh schwannomatosis liên quan đến NF2 (bệnh u xơ thần kinh loại 2)', n.name_en = 'NF2-related schwannomatosis (neurofibromatosis type 2)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/neurofibromatosis-type-2/symptoms-causes/syc-20594157', n.overview = 'Bệnh schwannomatosis liên quan đến NF2 (NF2) là một tình trạng di truyền hiếm gặp. Nó khiến các khối u phát triển trên cơ quan thính giác và cân bằng dây thần kinh, thường gặp nhất ở cả hai tai, có th';
MERGE (n:Disease {id: 'D2069'}) SET n.id = 'D2069', n.name = 'Dị ứng niken', n.name_en = 'Nickel allergy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/nickel-allergy/symptoms-causes/syc-20351529', n.overview = 'là một phản ứng của hệ thống miễn dịch đối với niken và thường gây phát ban ngứa khi kim loại tiếp xúc với da. Dị ứng niken thường liên quan đến bông tai và đồ trang sức khác. Nhưng niken có thể được ', n.when_to_see = 'Hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu bạn không biết mình bị phát ban trên da như thế nào hoặc nếu các triệu chứng của bạn không thuyên giảm bằng các phương pháp điều trị mà bạn ';
MERGE (n:Disease {id: 'D2070'}) SET n.id = 'D2070', n.name = 'Nicotine và thuốc lá', n.name_en = 'Nicotine and tobacco', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000953.htm', n.prognosis = 'Những người đang cố gắng cai thuốc thường trở nên chán nản khi lần đầu không thành công. Nghiên cứu cho thấy rằng bạn càng cố gắng nhiều lần thì bạn càng có nhiều khả năng thành công. Nếu bạn bắt đầu ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn muốn ngừng hút thuốc hoặc đã làm như vậy và đang có các triệu chứng cai thuốc. Nhà cung cấp của bạn có thể giúp đề xuất phương pháp điều trị.';
MERGE (n:Disease {id: 'D2071'}) SET n.id = 'D2071', n.name = 'Sự phụ thuộc vào nicotine', n.name_en = 'Nicotine dependence', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/nicotine-dependence/symptoms-causes/syc-20351584', n.overview = 'xảy ra khi cơ thể bạn thèm nicotin và bạn không thể ngừng sử dụng nó. Nicotine là chất hóa học có trong thuốc lá hút thuốc gây ra cảm giác thèm thuốc. Chất hóa học mang lại cảm giác dễ chịu nhưng nhữn', n.when_to_see = 'Hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu bạn đã cố gắng ngừng hút thuốc nhưng không thể ngừng hẳn. Hầu hết những người hút thuốc đều cố gắng bỏ thuốc lá nhiều lần trước khi họ có th';
MERGE (n:Disease {id: 'D2072'}) SET n.id = 'D2072', n.name = 'Ngộ độc nicotin', n.name_en = 'Nicotine poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002510.htm', n.prognosis = 'Sức khỏe của một người khỏe mạnh như thế nào tùy thuộc vào lượng chất độc nuốt vào và việc điều trị được tiếp nhận nhanh chóng như thế nào. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục';
MERGE (n:Disease {id: 'D2073'}) SET n.id = 'D2073', n.name = 'Liệu pháp thay thế nicotin', n.name_en = 'Nicotine replacement therapy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007438.htm', n.overview = 'Trước khi bạn bắt đầu sử dụng sản phẩm thay thế nicôtin, đây là một số điều cần biết: Bạn hút càng nhiều thuốc lá thì bạn có thể cần phải bắt đầu với liều lượng càng cao. Thêm một chương trình tư vấn ';
MERGE (n:Disease {id: 'D2074'}) SET n.id = 'D2074', n.name = 'Chuyên gia tư vấn và nhân viên hỗ trợ của NICU', n.name_en = 'NICU consultants and support staff', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007249.htm', n.overview = 'CHUYÊN VIÊN ÂM THANH Một chuyên gia thính học được đào tạo để kiểm tra thính giác của trẻ và cung cấp dịch vụ chăm sóc theo dõi cho những trẻ có vấn đề về thính giác. Hầu hết trẻ sơ sinh đều được kiểm';
MERGE (n:Disease {id: 'D2075'}) SET n.id = 'D2075', n.name = 'Bệnh Niemann-Pick', n.name_en = 'Niemann-Pick disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/niemann-pick/symptoms-causes/syc-20355887 | https://medlineplus.gov/ency/article/001207.htm', n.overview = 'là một nhóm các bệnh hiếm gặp được di truyền trong gia đình. Các tình trạng này ảnh hưởng đến khả năng phân hủy và sử dụng chất béo của cơ thể, chẳng hạn như cholesterol và lipid, bên trong tế bào. Do', n.prognosis = 'NPD loại A là một căn bệnh nặng. Nó thường dẫn đến tử vong ở độ tuổi 2 hoặc 3. Những người mắc bệnh loại B có thể sống đến tuổi thơ ấu hoặc tuổi trưởng thành. Một đứa trẻ có dấu hiệu thuộc loại C trướ', n.when_to_see = 'Hẹn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có tiền sử gia đình mắc bệnh Niemann-Pick và bạn dự định có con. Tư vấn và sàng lọc di truyền được khuyến khích. Hãy liên hệ với nhà cung';
MERGE (n:Disease {id: 'D2076'}) SET n.id = 'D2076', n.name = 'Nỗi kinh hoàng về đêm ở trẻ em', n.name_en = 'Night terrors in children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000809.htm', n.prognosis = 'Hầu hết trẻ em đều vượt qua nỗi sợ hãi ban đêm. Các đợt bệnh thường giảm sau 10 tuổi.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn để lấy hẹn nếu: Nỗi kinh hoàng về đêm xảy ra thường xuyên. Họ làm gián đoạn giấc ngủ một cách thường xuyên. Các triệu chứng khác xảy ra cùng với nỗi kinh hoàng về ';
MERGE (n:Disease {id: 'D2077'}) SET n.id = 'D2077', n.name = 'Rối loạn ác mộng', n.name_en = 'Nightmare disorder', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/nightmare-disorder/symptoms-causes/syc-20353515', n.overview = 'Ác mộng là một giấc mơ đáng lo ngại liên quan đến những cảm giác tiêu cực, chẳng hạn như lo lắng hoặc sợ hãi khiến bạn thức giấc. Ác mộng là hiện tượng thường gặp ở trẻ em nhưng có thể xảy ra ở mọi lứ', n.when_to_see = 'Những cơn ác mộng thường xuyên không phải là nguyên nhân đáng lo ngại. Nếu con bạn gặp ác mộng, bạn có thể chỉ cần đề cập đến chúng khi khám sức khỏe định kỳ cho trẻ. Tuy nhiên, hãy tham khảo ý kiến b';
MERGE (n:Disease {id: 'D2078'}) SET n.id = 'D2078', n.name = 'Ác mộng', n.name_en = 'Nightmares', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003209.htm', n.when_to_see = 'Hãy cho nhà cung cấp dịch vụ của bạn biết nếu những cơn ác mộng của bạn bắt đầu ngay sau khi bạn bắt đầu dùng một loại thuốc mới. Họ sẽ cho bạn biết liệu bạn có nên ngừng dùng thuốc đó hay không. Đừng';
MERGE (n:Disease {id: 'D2079'}) SET n.id = 'D2079', n.name = 'Dấu hiệu Nikolsky', n.name_en = 'Nikolsky sign', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003285.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc con bạn xuất hiện tình trạng da bị giãn, tấy đỏ và phồng rộp đau đớn mà bạn không biết nguyên nhân (ví dụ: bỏng da).';
MERGE (n:Disease {id: 'D2080'}) SET n.id = 'D2080', n.name = 'Dịch tiết núm vú', n.name_en = 'Nipple discharge', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001515.htm', n.prognosis = 'Hầu hết các vấn đề về núm vú không phải là ung thư vú. Những vấn đề này sẽ biến mất nếu được điều trị đúng cách hoặc có thể được theo dõi chặt chẽ theo thời gian.', n.when_to_see = 'Yêu cầu nhà cung cấp dịch vụ của bạn đánh giá bất kỳ dịch tiết nào ở núm vú.';
MERGE (n:Disease {id: 'D2081'}) SET n.id = 'D2081', n.name = 'Ngộ độc axit nitric', n.name_en = 'Nitric acid poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002478.htm', n.prognosis = 'Sức khoẻ của một người phụ thuộc vào lượng chất độc nuốt vào, nồng độ chất độc như thế nào và tốc độ điều trị được tiếp nhận như thế nào. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục h';
MERGE (n:Disease {id: 'D2082'}) SET n.id = 'D2082', n.name = 'Quá liều nitroglycerin', n.name_en = 'Nitroglycerin overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002587.htm', n.prognosis = 'Đã xảy ra trường hợp tử vong do quá liều nitroglycerin, nhưng rất hiếm. Huyết áp rất thấp có thể là do dùng nitroglycerin cùng với các loại thuốc khác có tác dụng làm giảm huyết áp, chẳng hạn như thuố';
MERGE (n:Disease {id: 'D2083'}) SET n.id = 'D2083', n.name = 'Nhiễm Nocardia', n.name_en = 'Nocardia infection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000679.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào sức khỏe tổng thể của bạn và các bộ phận cơ thể liên quan. Nhiễm trùng ảnh hưởng đến nhiều vùng trên cơ thể rất khó điều trị và một số người có thể không hồi phục', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có bất kỳ triệu chứng nào của bệnh nhiễm trùng này. Chúng là những triệu chứng không đặc hiệu và có thể do nhiều nguyên nhân khác.';
MERGE (n:Disease {id: 'D2084'}) SET n.id = 'D2084', n.name = 'Noma', n.name_en = 'Noma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001342.htm', n.prognosis = 'Trong một số trường hợp, tình trạng này có thể gây tử vong nếu không được điều trị. Những lần khác, tình trạng này có thể lành theo thời gian, thậm chí không cần điều trị. Tuy nhiên, nó có thể gây ra ', n.when_to_see = 'Cần phải chăm sóc y tế nếu vết loét và viêm miệng xảy ra và kéo dài hoặc trầm trọng hơn.';
MERGE (n:Disease {id: 'D2085'}) SET n.id = 'D2085', n.name = 'Đuối nước không gây tử vong', n.name_en = 'Non-fatal drowning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000046.htm', n.when_to_see = 'Hãy gọi 911 hoặc số điện thoại khẩn cấp tại địa phương nếu bạn không thể cứu người chết đuối mà không khiến bản thân gặp nguy hiểm. Nếu bạn được huấn luyện và có khả năng cứu người, hãy làm như vậy nh';
MERGE (n:Disease {id: 'D2086'}) SET n.id = 'D2086', n.name = 'Ung thư hạch không Hodgkin', n.name_en = 'Non-Hodgkin lymphoma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/non-hodgkins-lymphoma/symptoms-causes/syc-20375680 | https://medlineplus.gov/ency/article/000581.htm', n.overview = 'Các bộ phận của hệ thống miễn dịch trong hệ thống miễn dịch của cơ thể, có chức năng bảo vệ chống lại nhiễm trùng và bệnh tật. Hệ thống bạch huyết bao gồm lá lách, tuyến ức, hạch bạch huyết và các kên', n.prognosis = 'NHL mức độ thấp thường không thể chữa khỏi chỉ bằng hóa trị. NHL mức độ thấp tiến triển chậm và có thể mất nhiều năm trước khi bệnh trở nặng hoặc thậm chí cần phải điều trị. Nhu cầu điều trị thường đư', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin được đ';
MERGE (n:Disease {id: 'D2087'}) SET n.id = 'D2087', n.name = 'Ung thư hạch không Hodgkin ở trẻ em', n.name_en = 'Non-Hodgkin lymphoma in children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007686.htm', n.prognosis = 'Hầu hết các dạng NHL đều có thể chữa được. Ngay cả giai đoạn cuối của NHL cũng có thể chữa được ở trẻ em. Con bạn sẽ cần được khám và xét nghiệm hình ảnh thường xuyên trong nhiều năm sau khi điều trị ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu con bạn bị sưng hạch bạch huyết kèm theo sốt không rõ nguyên nhân mà không biến mất hoặc có các triệu chứng khác của NHL. Liên hệ';
MERGE (n:Disease {id: 'D2088'}) SET n.id = 'D2088', n.name = 'Ung thư phổi không phải tế bào nhỏ', n.name_en = 'Non-small cell lung cancer', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007194.htm', n.prognosis = 'Triển vọng khác nhau. Thông thường, NSCLC phát triển chậm. Trong một số trường hợp, nó có thể phát triển và lây lan nhanh chóng và gây tử vong nhanh chóng. Ung thư có thể lan sang các bộ phận khác của', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh ung thư phổi, đặc biệt nếu bạn hút thuốc.';
MERGE (n:Disease {id: 'D2089'}) SET n.id = 'D2089', n.name = 'Bệnh gan nhiễm mỡ không do rượu', n.name_en = 'Nonalcoholic fatty liver disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007657.htm', n.prognosis = 'Nhiều người mắc NAFLD không có vấn đề gì về sức khỏe và không tiếp tục phát triển NASH. Giảm cân và lựa chọn lối sống lành mạnh có thể giúp ngăn ngừa các vấn đề nghiêm trọng hơn. Không rõ tại sao một ', n.when_to_see = 'Hầu hết những người bị NAFLD không biết họ mắc bệnh này. Hãy gặp bác sĩ nếu bạn bắt đầu có các triệu chứng bất thường như mệt mỏi hoặc đau bụng.';
MERGE (n:Disease {id: 'D2090'}) SET n.id = 'D2090', n.name = 'Viêm mũi không dị ứng', n.name_en = 'Nonallergic rhinitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/nonallergic-rhinitis/symptoms-causes/syc-20351229', n.overview = 'liên quan đến hắt hơi hoặc nghẹt mũi, chảy nước mũi. Nó có thể là một vấn đề lâu dài và không có nguyên nhân rõ ràng. Các triệu chứng giống như sốt cỏ khô, còn gọi là viêm mũi dị ứng. Nhưng viêm mũi k', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn: Có các triệu chứng nghiêm trọng. Không thấy thuyên giảm nhờ các biện pháp điều trị tại nhà hoặc thuốc mua ở cửa hàng mà không cần kê đơn';
MERGE (n:Disease {id: 'D2091'}) SET n.id = 'D2091', n.name = 'Bệnh mũi không dị ứng', n.name_en = 'Nonallergic rhinopathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001648.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn cho rằng mình có các triệu chứng của bệnh viêm mũi không dị ứng.';
MERGE (n:Disease {id: 'D2092'}) SET n.id = 'D2092', n.name = 'Ung thư da không phải khối u ác tính', n.name_en = 'Nonmelanoma skin cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/nonmelanoma-skin-cancer/symptoms-causes/syc-20355397', n.overview = 'đề cập đến tất cả các loại ung thư xảy ra ở da không phải là khối u ác tính. Một số loại ung thư da thuộc loại ung thư da không phải khối u ác tính. Hầu như tất cả các bệnh ung thư da không phải u hắc', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn thấy bất kỳ thay đổi nào trên da khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2093'}) SET n.id = 'D2093', n.name = 'Hội chứng Noonan', n.name_en = 'Noonan syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/noonan-syndrome/symptoms-causes/syc-20354422 | https://medlineplus.gov/ency/article/001656.htm', n.overview = 'là một tình trạng di truyền làm ngừng sự phát triển điển hình ở nhiều bộ phận khác nhau của cơ thể. Nó có thể ảnh hưởng đến một người theo nhiều cách, bao gồm các đặc điểm bất thường trên khuôn mặt, c', n.when_to_see = 'Đôi khi có thể khó nhận thấy các triệu chứng của hội chứng Noonan. Nếu bạn nghi ngờ bạn hoặc con bạn có thể mắc phải tình trạng này, hãy đến gặp chuyên gia chăm sóc chính hoặc bác sĩ nhi khoa của con ';
MERGE (n:Disease {id: 'D2094'}) SET n.id = 'D2094', n.name = 'Hội chứng Noonan với nhiều nốt ruồi', n.name_en = 'Noonan syndrome with multiple lentigines', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001473.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu có các triệu chứng của chứng rối loạn này. Liên hệ với nhà cung cấp của bạn để lấy hẹn nếu bạn có tiền sử gia đình mắc chứng rối loạn này và dự định có con.';
MERGE (n:Disease {id: 'D2095'}) SET n.id = 'D2095', n.name = 'Não úng thủy áp lực bình thường', n.name_en = 'Normal pressure hydrocephalus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000752.htm', n.prognosis = 'Nếu không điều trị, các triệu chứng thường nặng hơn và có thể dẫn đến tử vong. Phẫu thuật cải thiện triệu chứng ở một số người. Những người có triệu chứng nhẹ có kết quả tốt nhất. Đi bộ là triệu chứng', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn hoặc người thân đang ngày càng gặp vấn đề về trí nhớ, đi lại hoặc tiểu không tự chủ. Một người bị NPH trở nên trầm trọng hơn đến mức bạn không thể tự mình';
MERGE (n:Disease {id: 'D2096'}) SET n.id = 'D2096', n.name = 'Nhiễm Norovirus', n.name_en = 'Norovirus infection', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/norovirus/symptoms-causes/syc-20355296', n.overview = 'có thể gây nôn mửa và tiêu chảy nghiêm trọng, khởi phát đột ngột. Norovirus rất dễ lây lan. Chúng thường lây lan qua thực phẩm hoặc nước bị ô nhiễm trong quá trình chuẩn bị hoặc qua các bề mặt bị ô nh', n.when_to_see = 'Tìm kiếm sự chăm sóc y tế nếu bạn bị tiêu chảy không hết trong vòng vài ngày. Đồng thời gọi cho nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị nôn mửa dữ dội, phân có máu, đau dạ dày hoặc m';
MERGE (n:Disease {id: 'D2097'}) SET n.id = 'D2097', n.name = 'Gãy xương mũi', n.name_en = 'Nose fracture', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000061.htm', n.when_to_see = 'Nhận trợ giúp y tế ngay lập tức nếu: Chảy máu không ngừng Chất lỏng trong suốt chảy ra từ mũi Bạn nghi ngờ có cục máu đông trong vách ngăn Bạn nghi ngờ bị chấn thương ở cổ hoặc đầu Mũi trông bị biến d';
MERGE (n:Disease {id: 'D2098'}) SET n.id = 'D2098', n.name = 'Chảy máu cam', n.name_en = 'Nosebleed', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003106.htm', n.when_to_see = 'Được chăm sóc khẩn cấp nếu: Chảy máu không ngừng sau 20 phút. Chảy máu mũi xảy ra sau chấn thương đầu. Điều này có thể gợi ý gãy xương sọ và nên chụp X-quang hoặc các hình ảnh khác. Mũi của bạn có thể';
MERGE (n:Disease {id: 'D2099'}) SET n.id = 'D2099', n.name = 'Tê và ngứa ran', n.name_en = 'Numbness and tingling', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003206.htm', n.when_to_see = 'Đến bệnh viện hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu: Bạn bị yếu hoặc không thể di chuyển, cùng với tê hoặc ngứa ran Tê hoặc ngứa ran xảy ra ngay sau khi bị chấn thương ở đầu, cổ hoặc lưng Bạ';
MERGE (n:Disease {id: 'D2100'}) SET n.id = 'D2100', n.name = 'Bệnh chàm đồng tiền', n.name_en = 'Nummular eczema', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000870.htm', n.prognosis = 'Bệnh chàm thể đồng tiền là một tình trạng lâu dài (mãn tính). Điều trị y tế và tránh các chất kích thích có thể giúp giảm triệu chứng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng của tình trạng này. Đồng thời, hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Các triệu chứng vẫn tiếp tục mặc dù đã điều trị Bạn có ';
MERGE (n:Disease {id: 'D2101'}) SET n.id = 'D2101', n.name = 'Y tá hành nghề (NP)', n.name_en = 'Nurse practitioner (NP)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001934.htm', n.overview = 'NP được phép cung cấp nhiều loại dịch vụ chăm sóc sức khỏe, có thể bao gồm: Lấy bệnh sử của người đó, khám sức khỏe và yêu cầu các xét nghiệm và thủ thuật trong phòng thí nghiệm Chẩn đoán, điều trị và';
MERGE (n:Disease {id: 'D2102'}) SET n.id = 'D2102', n.name = 'Khuỷu tay của Nursemaid', n.name_en = 'Nursemaid\'s elbow', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000983.htm', n.prognosis = 'Nếu khuỷu tay của người bảo mẫu không được điều trị, trẻ có thể vĩnh viễn không thể cử động hoàn toàn khuỷu tay. Với việc điều trị, thường không có tổn thương vĩnh viễn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nghi ngờ con mình bị trật khớp khuỷu tay hoặc từ chối sử dụng cánh tay.';
MERGE (n:Disease {id: 'D2103'}) SET n.id = 'D2103', n.name = 'Dị ứng quả hạch', n.name_en = 'Nut allergies', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007805.htm', n.prognosis = 'Dị ứng hạt thường kéo dài suốt đời. Chỉ có khoảng 10% số người sẽ hết dị ứng hạt cây. Khoảng 20% ​​số người bị dị ứng đậu phộng sẽ khỏi bệnh khi lớn lên.', n.when_to_see = 'Bất kỳ ai từng bị dị ứng với bất kỳ loại hạt nào đều nên đến gặp bác sĩ chuyên khoa dị ứng. Các bước cần thực hiện khi xảy ra phản ứng dị ứng với các loại hạt: Gọi 911 hoặc số cấp cứu tại địa phương n';
MERGE (n:Disease {id: 'D2104'}) SET n.id = 'D2104', n.name = 'Rung giật nhãn cầu', n.name_en = 'Nystagmus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003037.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng rung giật nhãn cầu hoặc nghĩ rằng mình có thể mắc phải tình trạng này.';
MERGE (n:Disease {id: 'D2105'}) SET n.id = 'D2105', n.name = 'Béo phì', n.name_en = 'Obesity', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/obesity/symptoms-causes/syc-20375742 | https://medlineplus.gov/ency/article/007297.htm', n.overview = 'là một căn bệnh phức tạp liên quan đến việc cơ thể có quá nhiều mỡ. Bạn có thể nghĩ béo phì là một vấn đề về thẩm mỹ. Nhưng đó là một tình trạng bệnh lý làm tăng nguy cơ mắc nhiều bệnh và tình trạng s', n.when_to_see = 'Nếu bạn lo lắng về cân nặng hoặc tình trạng sức khỏe liên quan đến cân nặng của mình, hãy hỏi chuyên gia chăm sóc sức khỏe của bạn về cách quản lý béo phì. Bạn và nhóm chăm sóc sức khỏe của bạn có thể';
MERGE (n:Disease {id: 'D2106'}) SET n.id = 'D2106', n.name = 'Hội chứng giảm thông khí do béo phì (OHS)', n.name_en = 'Obesity hypoventilation syndrome (OHS)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000085.htm', n.prognosis = 'Nếu không được điều trị, OHS có thể dẫn đến các vấn đề nghiêm trọng về tim và mạch máu, tàn tật nặng hoặc tử vong.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn rất mệt mỏi trong ngày hoặc có bất kỳ triệu chứng nào khác gợi ý OHS.';
MERGE (n:Disease {id: 'D2107'}) SET n.id = 'D2107', n.name = 'Rối loạn ám ảnh cưỡng chế', n.name_en = 'Obsessive-compulsive disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000929.htm', n.prognosis = 'OCD là một căn bệnh lâu dài (mãn tính) với các giai đoạn xuất hiện các triệu chứng nghiêm trọng, sau đó là các giai đoạn cải thiện. Một khoảng thời gian hoàn toàn không có triệu chứng là điều bất thườ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn để lấy hẹn nếu các triệu chứng của bạn ảnh hưởng đến cuộc sống hàng ngày, công việc hoặc các mối quan hệ.';
MERGE (n:Disease {id: 'D2108'}) SET n.id = 'D2108', n.name = 'Rối loạn ám ảnh cưỡng chế (OCD)', n.name_en = 'Obsessive-compulsive disorder (OCD)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/obsessive-compulsive-disorder/symptoms-causes/syc-20354432', n.overview = 'có một dạng suy nghĩ và nỗi sợ hãi không mong muốn được gọi là nỗi ám ảnh. Những nỗi ám ảnh này khiến bạn thực hiện những hành vi lặp đi lặp lại, còn gọi là hành vi cưỡng chế. Những nỗi ám ảnh và sự é', n.when_to_see = 'Có sự khác biệt giữa việc là người cầu toàn - người cần kết quả hoặc hiệu suất hoàn hảo - và mắc chứng OCD. Suy nghĩ OCD không chỉ đơn giản là những lo lắng quá mức về các vấn đề thực tế trong cuộc số';
MERGE (n:Disease {id: 'D2109'}) SET n.id = 'D2109', n.name = 'Rối loạn nhân cách ám ảnh cưỡng chế', n.name_en = 'Obsessive-compulsive personality disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000942.htm', n.prognosis = 'Triển vọng của OCPD có xu hướng tốt hơn so với các chứng rối loạn nhân cách khác. Sự cứng nhắc và kiểm soát của OCPD có thể ngăn ngừa nhiều biến chứng, chẳng hạn như rối loạn sử dụng chất gây nghiện, ', n.when_to_see = 'Hãy gặp nhà cung cấp hoặc chuyên gia sức khỏe tâm thần nếu bạn hoặc ai đó bạn biết có các triệu chứng của OCPD.';
MERGE (n:Disease {id: 'D2110'}) SET n.id = 'D2110', n.name = 'Chứng ngưng thở khi ngủ do tắc nghẽn', n.name_en = 'Obstructive sleep apnea', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/obstructive-sleep-apnea/symptoms-causes/syc-20352090', n.overview = 'khi các cơ nâng đỡ các mô mềm trong cổ họng của bạn, chẳng hạn như lưỡi và vòm miệng mềm, hãy thư giãn trong giây lát. Khi các cơ này thư giãn, đường thở của bạn bị thu hẹp hoặc đóng lại và hơi thở bị', n.when_to_see = 'Hãy tham khảo ý kiến ​​chuyên gia chăm sóc sức khỏe nếu bạn có hoặc nếu đối tác của bạn nhận thấy những điều sau: Ngáy đủ lớn để làm phiền giấc ngủ của bạn hoặc giấc ngủ của người khác. Thức dậy thở h';
MERGE (n:Disease {id: 'D2111'}) SET n.id = 'D2111', n.name = 'Chứng ngưng thở khi ngủ do tắc nghẽn - người lớn', n.name_en = 'Obstructive sleep apnea - adults', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000811.htm', n.prognosis = 'Nếu không được điều trị, chứng ngưng thở khi ngủ có thể gây ra: Lo lắng và trầm cảm Mất hứng thú với tình dục Hiệu suất kém ở nơi làm việc hoặc ở trường Buồn ngủ ban ngày do ngưng thở khi ngủ có thể l', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Bạn cảm thấy rất mệt mỏi và buồn ngủ trong ngày Bạn hoặc gia đình bạn nhận thấy các triệu chứng của OSA Các triệu chứng không cải thiện khi điều trị hoặc các triệ';
MERGE (n:Disease {id: 'D2112'}) SET n.id = 'D2112', n.name = 'Bệnh tiết niệu tắc nghẽn', n.name_en = 'Obstructive uropathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000507.htm', n.prognosis = 'Nếu tắc nghẽn xảy ra đột ngột, tổn thương thận sẽ ít xảy ra hơn nếu vấn đề được phát hiện và điều trị ngay lập tức. Thông thường, tổn thương ở thận sẽ biến mất. Tổn thương lâu dài ở thận có thể xảy ra', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh tắc nghẽn đường tiết niệu.';
MERGE (n:Disease {id: 'D2113'}) SET n.id = 'D2113', n.name = 'Hen suyễn nghề nghiệp', n.name_en = 'Occupational asthma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/occupational-asthma/symptoms-causes/syc-20375772 | https://medlineplus.gov/ency/article/000110.htm', n.overview = 'là một loại hen suyễn do hít phải khói, khí, bụi hoặc các chất khác trong khi làm việc. Những chất này có thể kích hoạt phản ứng của hệ thống miễn dịch làm thay đổi cách hoạt động của phổi. Hen suyễn ', n.prognosis = 'Hen suyễn nghề nghiệp có thể trở nên tồi tệ hơn nếu bạn tiếp tục tiếp xúc với chất gây ra vấn đề, ngay cả khi thuốc cải thiện các triệu chứng của bạn. Bạn có thể cần phải thay đổi công việc. Đôi khi, ', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng hen suyễn. Trao đổi với nhà cung cấp dịch vụ của bạn về việc mắc bệnh cúm, viêm phổi (phế cầu khuẩn), COVID-19 và các loại vắc xin khác. Nếu';
MERGE (n:Disease {id: 'D2114'}) SET n.id = 'D2114', n.name = 'Mất thính lực nghề nghiệp', n.name_en = 'Occupational hearing loss', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001048.htm', n.prognosis = 'Mất thính lực thường là vĩnh viễn. Sự mất mát có thể trở nên tồi tệ hơn nếu bạn không thực hiện các biện pháp để ngăn ngừa thiệt hại thêm.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn bị mất thính lực Tình trạng mất thính lực trở nên trầm trọng hơn Bạn xuất hiện các triệu chứng mới khác';
MERGE (n:Disease {id: 'D2115'}) SET n.id = 'D2115', n.name = 'Bệnh rosacea mắt', n.name_en = 'Ocular rosacea', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ocular-rosacea/symptoms-causes/syc-20375798', n.overview = '(roe-ZAY-she-uh) là tình trạng viêm gây đỏ, rát và ngứa mắt. Nó thường phát triển ở những người mắc bệnh rosacea, một tình trạng da mãn tính ảnh hưởng đến khuôn mặt. Đôi khi bệnh rosacea ở mắt (mắt) l', n.when_to_see = 'Hãy hẹn khám bác sĩ nếu bạn có các dấu hiệu và triệu chứng của bệnh trứng cá đỏ ở mắt, chẳng hạn như khô mắt, rát hoặc ngứa mắt, đỏ mắt hoặc mờ mắt. Nếu bạn đã được chẩn đoán mắc bệnh trứng cá đỏ trên';
MERGE (n:Disease {id: 'D2116'}) SET n.id = 'D2116', n.name = 'Ngộ độc sơn gốc dầu', n.name_en = 'Oil-based paint poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002730.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận như thế nào. Sống sót sau 48 giờ thường là dấu hiệu tốt cho thấy người đó sẽ hồi phục. Nếu xảy ra bất kỳ ';
MERGE (n:Disease {id: 'D2117'}) SET n.id = 'D2117', n.name = 'Tóc dầu', n.name_en = 'Oily hair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002042.htm', n.overview = 'Dưới đây là một số mẹo ngăn ngừa và điều trị tóc dầu: Gội đầu mỗi ngày. Để dầu gội trên đầu ít nhất 5 phút trước khi xả sạch có thể giúp ích. Tránh chải tóc quá thường xuyên hoặc quá mạnh vì việc chải';
MERGE (n:Disease {id: 'D2118'}) SET n.id = 'D2118', n.name = 'Da dầu', n.name_en = 'Oily skin', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002043.htm', n.overview = 'Gen và hormone của bạn đóng vai trò quan trọng trong việc bạn có da nhờn hay không. Chế độ ăn uống có lẽ ít liên quan đến việc bạn có da nhờn hay không. Điều quan trọng nhất bạn có thể làm đối với da ';
MERGE (n:Disease {id: 'D2119'}) SET n.id = 'D2119', n.name = 'Ngộ độc cây trúc đào', n.name_en = 'Oleander poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002884.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào lượng chất độc nuốt vào và tốc độ điều trị. Bạn nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Các triệu chứng kéo dài từ 1 đến 3 ngày và có thể';
MERGE (n:Disease {id: 'D2120'}) SET n.id = 'D2120', n.name = 'Oligodendroglioma', n.name_en = 'Oligodendroglioma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/oligodendroglioma/symptoms-causes/syc-20576736', n.overview = 'là sự phát triển của các tế bào bắt đầu trong não hoặc tủy sống. Sự tăng trưởng, được gọi là khối u, bắt đầu trong các tế bào gọi là tế bào ít nhánh. Những tế bào này tạo ra một chất bảo vệ các tế bào', n.when_to_see = 'Nếu bạn nhận thấy các triệu chứng đang diễn ra khiến bạn lo lắng, hãy cân nhắc liên hệ với chuyên gia chăm sóc sức khỏe, phòng khám hoặc nguồn y tế cộng đồng đáng tin cậy để được tư vấn. Yêu cầu một c';
MERGE (n:Disease {id: 'D2121'}) SET n.id = 'D2121', n.name = 'Omphalocele', n.name_en = 'Omphalocele', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000994.htm', n.prognosis = 'Dự kiến ​​sẽ hồi phục hoàn toàn sau phẫu thuật thoát vị rốn. Tuy nhiên, thoát vị rốn thường xảy ra cùng với các dị tật bẩm sinh khác. Trẻ hoạt động tốt như thế nào sẽ phụ thuộc vào những tình trạng kh', n.when_to_see = 'Tình trạng này biểu hiện rõ ràng khi mới sinh và sẽ được phát hiện tại bệnh viện khi sinh nếu nó chưa được phát hiện qua các lần siêu âm thai nhi định kỳ trong thai kỳ. Nếu bạn sinh con tại nhà và con';
MERGE (n:Disease {id: 'D2122'}) SET n.id = 'D2122', n.name = 'Sửa chữa thoát vị rốn', n.name_en = 'Omphalocele repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002938.htm', n.overview = 'Mục tiêu của thủ thuật là đặt các cơ quan trở lại bụng của em bé và khắc phục khiếm khuyết. Việc sửa chữa có thể được thực hiện ngay sau khi em bé chào đời. Đây được gọi là sửa chữa chính. Hoặc, việc ', n.prognosis = 'Sau khi bạn về nhà, con bạn có thể bị tắc nghẽn trong ruột (tắc ruột) do đường gấp khúc hoặc vết sẹo trong ruột. Bác sĩ phẫu thuật của bạn có thể cho bạn biết điều này sẽ được điều trị như thế nào. Tr';
MERGE (n:Disease {id: 'D2123'}) SET n.id = 'D2123', n.name = 'Cắt bỏ túi mật mở', n.name_en = 'Open gallbladder removal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002930.htm', n.overview = 'Phẫu thuật được thực hiện trong khi bạn đang được gây mê toàn thân nên bạn sẽ ngủ và không đau. Để thực hiện phẫu thuật: Bác sĩ phẫu thuật sẽ rạch một đường ở phần trên bên phải của bụng, ngay dưới xư', n.prognosis = 'Hầu hết mọi người đều có kết quả tốt từ quy trình này. Sẽ mất vài tuần để vết mổ hở lành lại và lấy lại năng lượng bình thường.';
MERGE (n:Disease {id: 'D2124'}) SET n.id = 'D2124', n.name = 'Cai thuốc phiện và opioid', n.name_en = 'Opiate and opioid withdrawal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000949.htm', n.prognosis = 'Việc cai nghiện thuốc phiện rất đau đớn, nhưng thường không đe dọa đến tính mạng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn đang sử dụng hoặc cai nghiện thuốc phiện. Nếu bạn hoặc ai đó bạn biết đang nghĩ đến việc tự tử, hãy gọi hoặc nhắn tin tới 988 hoặc trò chuyện 988lifeline.o';
MERGE (n:Disease {id: 'D2125'}) SET n.id = 'D2125', n.name = 'Ngộ độc opioid', n.name_en = 'Opioid intoxication', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000948.htm', n.prognosis = 'Nhiều yếu tố quyết định kết quả ngắn hạn và dài hạn sau khi nhiễm độc opioid. Một số trong số đó là: Mức độ ngộ độc, ví dụ như nếu người đó ngừng thở và trong bao lâu Tần suất sử dụng thuốc Ảnh hưởng ';
MERGE (n:Disease {id: 'D2126'}) SET n.id = 'D2126', n.name = 'Opisthotonos', n.name_en = 'Opisthotonos', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003195.htm', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu xuất hiện các triệu chứng của bệnh opisthotonos. Thông thường, opisthotonos là triệu chứng của các tình trạng khác đủ nghiêm trọng';
MERGE (n:Disease {id: 'D2127'}) SET n.id = 'D2127', n.name = 'Rối loạn thách thức chống đối', n.name_en = 'Oppositional defiant disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001537.htm', n.prognosis = 'Một số trẻ đáp ứng tốt với điều trị, trong khi những trẻ khác thì không.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn lo ngại về sự phát triển hoặc hành vi của con bạn.';
MERGE (n:Disease {id: 'D2128'}) SET n.id = 'D2128', n.name = 'Rối loạn thách thức chống đối (ODD)', n.name_en = 'Oppositional defiant disorder (ODD)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/oppositional-defiant-disorder/symptoms-causes/syc-20375831', n.overview = 'Ngay cả những đứa trẻ cư xử tốt nhất đôi khi cũng có thể gặp khó khăn và thử thách. Nhưng chứng rối loạn thách thức chống đối (ODD) bao gồm biểu hiện thường xuyên và liên tục như tức giận, khó chịu, t', n.when_to_see = 'Con bạn sẽ không coi hành vi của mình là một vấn đề. Thay vào đó, con bạn có thể sẽ phàn nàn về những yêu cầu vô lý hoặc đổ lỗi cho người khác về vấn đề này. Nếu bạn cho rằng con mình có thể mắc chứng';
MERGE (n:Disease {id: 'D2129'}) SET n.id = 'D2129', n.name = 'U thần kinh đệm thị giác', n.name_en = 'Optic glioma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/optic-glioma/symptoms-causes/syc-20596768 | https://medlineplus.gov/ency/article/001024.htm', n.overview = 'U thần kinh đệm thị giác là một khối u hình thành dọc theo các dây thần kinh mang thông tin từ mắt đến não. Nó thường liên quan đến dây thần kinh thị giác, kết nối mắt với não. Khối u cũng có thể liên', n.prognosis = 'Triển vọng của mỗi người rất khác nhau. Điều trị sớm sẽ cải thiện cơ hội đạt được kết quả tốt. Việc theo dõi cẩn thận với đội ngũ chăm sóc có kinh nghiệm về loại khối u này là rất quan trọng. Một khi ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu có bất kỳ tình trạng mất thị lực, lồi mắt không đau hoặc các triệu chứng khác của tình trạng này.';
MERGE (n:Disease {id: 'D2130'}) SET n.id = 'D2130', n.name = 'Teo dây thần kinh thị giác', n.name_en = 'Optic nerve atrophy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001622.htm', n.prognosis = 'Thị lực bị mất do teo dây thần kinh thị giác không thể phục hồi được. Việc bảo vệ con mắt còn lại là rất quan trọng.', n.when_to_see = 'Những người mắc bệnh này cần được bác sĩ nhãn khoa có kinh nghiệm về các bệnh liên quan đến thần kinh kiểm tra thường xuyên. Hãy cho bác sĩ nhãn khoa của bạn biết ngay về bất kỳ thay đổi nào về thị lự';
MERGE (n:Disease {id: 'D2131'}) SET n.id = 'D2131', n.name = 'Nhiễm papillomavirus ở người qua đường miệng', n.name_en = 'Oral human papillomavirus infection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007762.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn ngay nếu bạn nhận thấy bất kỳ triệu chứng nào của bệnh ung thư miệng và cổ họng.';
MERGE (n:Disease {id: 'D2132'}) SET n.id = 'D2132', n.name = 'Quá liều thuốc hạ đường huyết đường uống', n.name_en = 'Oral hypoglycemics overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002588.htm', n.prognosis = 'Một số loại thuốc hạ đường huyết đường uống có thể tồn tại trong cơ thể trong thời gian dài, vì vậy người bệnh có thể phải nằm viện từ 24 giờ trở lên. Tổn thương não vĩnh viễn và tử vong có thể xảy ra';
MERGE (n:Disease {id: 'D2133'}) SET n.id = 'D2133', n.name = 'Lichen phẳng miệng', n.name_en = 'Oral lichen planus', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/oral-lichen-planus/symptoms-causes/syc-20350869', n.overview = 'bề mặt của má là điển hình của liken phẳng miệng. Lichen phẳng miệng (LIE-kun PLAY-nus) là một tình trạng viêm liên tục ảnh hưởng đến màng nhầy bên trong miệng. Có một số loại lichen phẳng khác nhau ả', n.when_to_see = 'Hãy gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào được liệt kê ở trên. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 t';
MERGE (n:Disease {id: 'D2134'}) SET n.id = 'D2134', n.name = 'U nang niêm mạc miệng', n.name_en = 'Oral mucous cyst', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001639.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn: Nhận thấy có u nang hoặc khối u trong miệng Khó nuốt hoặc nói Đây có thể là dấu hiệu của một vấn đề nghiêm trọng hơn, chẳng hạn như ung thư miệng.';
MERGE (n:Disease {id: 'D2135'}) SET n.id = 'D2135', n.name = 'Các mảng nấm miệng', n.name_en = 'Oral thrush', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/oral-thrush/symptoms-causes/syc-20353533', n.overview = 'trong miệng hoặc trên lưỡi của bạn. Bệnh tưa miệng, còn được gọi là bệnh nấm miệng (kan-dih-DIE-uh-sis), là tình trạng nấm Candida albicans tích tụ trong miệng. Việc candida, một loại nấm men, sống tr', n.when_to_see = 'Nếu bạn hoặc con bạn có những mảng hoặc đốm trắng bên trong miệng, hãy đến gặp chuyên gia y tế hoặc nha khoa. Bệnh tưa miệng không phổ biến ở trẻ lớn, thanh thiếu niên và người lớn khỏe mạnh. Vì vậy, ';
MERGE (n:Disease {id: 'D2136'}) SET n.id = 'D2136', n.name = 'Viêm mô tế bào quỹ đạo', n.name_en = 'Orbital cellulitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001012.htm', n.prognosis = 'Nếu được điều trị kịp thời, người bệnh có thể hồi phục hoàn toàn.', n.when_to_see = 'Viêm mô tế bào hốc mắt là một trường hợp cấp cứu y tế cần được điều trị ngay lập tức. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu có dấu hiệu sưng mí mắt, đặc biệt là kèm theo sốt.';
MERGE (n:Disease {id: 'D2137'}) SET n.id = 'D2137', n.name = 'Giả u hốc mắt', n.name_en = 'Orbital pseudotumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001623.htm', n.prognosis = 'Hầu hết các trường hợp đều nhẹ và kết quả tốt. Những trường hợp nặng có thể không đáp ứng tốt với điều trị và có thể bị mất thị lực. Giả u ổ mắt thường chỉ liên quan đến một mắt.', n.when_to_see = 'Những người mắc bệnh này cần được chăm sóc theo dõi thường xuyên với bác sĩ nhãn khoa, người quen với việc điều trị bệnh quỹ đạo. Liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn gặp bất kỳ vấn đ';
MERGE (n:Disease {id: 'D2138'}) SET n.id = 'D2138', n.name = 'Viêm tinh hoàn', n.name_en = 'Orchitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/orchitis/symptoms-causes/syc-20375860 | https://medlineplus.gov/ency/article/001280.htm', n.overview = '(hoặc-KIE-tis) đề cập đến nhiễm trùng hoặc sưng tấy và kích ứng, được gọi là viêm, ở một hoặc cả hai tinh hoàn. Nhiễm trùng là nguyên nhân phổ biến của viêm tinh hoàn. Chúng bao gồm các bệnh lây truyề', n.prognosis = 'Việc chẩn đoán và điều trị đúng bệnh viêm tinh hoàn do vi khuẩn thường có thể giúp tinh hoàn phục hồi bình thường. Bạn sẽ cần xét nghiệm thêm để kiểm tra ung thư tinh hoàn nếu tinh hoàn không hoàn toà', n.when_to_see = 'Nếu tình trạng đau hoặc sưng ở bìu diễn ra nhanh chóng, hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn ngay lập tức. Một số tình trạng có thể gây đau tinh hoàn. Nhiều người tự bỏ đi. Nhưng một số cầ';
MERGE (n:Disease {id: 'D2139'}) SET n.id = 'D2139', n.name = 'Rối loạn chức năng cực khoái ở phụ nữ', n.name_en = 'Orgasmic dysfunction in women', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001953.htm', n.prognosis = 'Phụ nữ làm tốt hơn khi điều trị bao gồm học các kỹ thuật tình dục hoặc một phương pháp gọi là giải mẫn cảm. Phương pháp điều trị này có tác dụng làm giảm dần phản ứng gây thiếu cực khoái. Giải mẫn cảm';
MERGE (n:Disease {id: 'D2140'}) SET n.id = 'D2140', n.name = 'Dịch vụ chỉnh hình', n.name_en = 'Orthopedic services', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007455.htm', n.overview = 'Có thể có nhiều vấn đề y tế ảnh hưởng đến xương, khớp, dây chằng, gân và cơ. Các vấn đề về xương có thể bao gồm: Biến dạng xương Nhiễm trùng xương Khối u xương Gãy xương Cần phải cắt cụt Không liên kế';
MERGE (n:Disease {id: 'D2141'}) SET n.id = 'D2141', n.name = 'Hạ huyết áp thế đứng (hạ huyết áp tư thế)', n.name_en = 'Orthostatic hypotension (postural hypotension)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/orthostatic-hypotension/symptoms-causes/syc-20352548', n.overview = 'Hạ huyết áp thế đứng - còn gọi là hạ huyết áp tư thế - là một dạng huyết áp thấp xảy ra khi đứng sau khi ngồi hoặc nằm. Hạ huyết áp thế đứng có thể gây chóng mặt hoặc choáng váng và có thể ngất xỉu. H', n.when_to_see = 'Thỉnh thoảng chóng mặt hoặc choáng váng có thể nhẹ - gây ra bởi tình trạng mất nước nhẹ, lượng đường trong máu thấp hoặc quá nóng. Chóng mặt hoặc choáng váng cũng có thể do đứng sau khi ngồi trong một';
MERGE (n:Disease {id: 'D2142'}) SET n.id = 'D2142', n.name = 'Bệnh Osgood-Schlatter', n.name_en = 'Osgood-Schlatter disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001258.htm', n.prognosis = 'Hầu hết các trường hợp đều tự khỏi sau vài tuần hoặc vài tháng. Hầu hết các trường hợp sẽ khỏi sau khi trẻ lớn lên.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu con bạn bị đau đầu gối hoặc chân hoặc nếu cơn đau không thuyên giảm khi điều trị.';
MERGE (n:Disease {id: 'D2143'}) SET n.id = 'D2143', n.name = 'Hội chứng mất myelin thẩm thấu', n.name_en = 'Osmotic demyelination syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000775.htm', n.prognosis = 'Tổn thương thần kinh do tiêu hủy myelin cầu não trung ương thường kéo dài. Rối loạn này có thể gây ra tình trạng khuyết tật nghiêm trọng lâu dài (mãn tính).', n.when_to_see = 'Không có hướng dẫn thực sự nào về thời điểm cần tìm kiếm sự chăm sóc y tế, vì ODS rất hiếm trong cộng đồng nói chung.';
MERGE (n:Disease {id: 'D2144'}) SET n.id = 'D2144', n.name = 'Viêm xương xơ hóa', n.name_en = 'Osteitis fibrosa', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001252.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị đau xương, đau nhức hoặc có triệu chứng của bệnh cường tuyến cận giáp.';
MERGE (n:Disease {id: 'D2145'}) SET n.id = 'D2145', n.name = 'Viêm xương khớp', n.name_en = 'Osteoarthritis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/osteoarthritis/symptoms-causes/syc-20351925 | https://medlineplus.gov/ency/article/000423.htm', n.overview = 'là dạng viêm khớp phổ biến nhất, ảnh hưởng đến hàng triệu người trên toàn thế giới. Nó xảy ra khi sụn bảo vệ đệm các đầu xương bị mòn theo thời gian. Mặc dù viêm xương khớp có thể làm tổn thương bất k', n.prognosis = 'Việc di chuyển của bạn có thể bị hạn chế theo thời gian. Thực hiện các hoạt động hàng ngày như vệ sinh cá nhân, việc nhà hoặc nấu ăn có thể trở thành một thách thức. Điều trị thường cải thiện chức năn', n.when_to_see = 'Nếu cơn đau hoặc cứng khớp không biến mất, hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn.';
MERGE (n:Disease {id: 'D2146'}) SET n.id = 'D2146', n.name = 'Viêm xương sụn bóc tách', n.name_en = 'Osteochondritis dissecans', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/osteochondritis-dissecans/symptoms-causes/syc-20375887', n.overview = '(os-tee-o-kon-DRY-tis DIS-uh-kanz) là một tình trạng khớp trong đó xương bên dưới sụn của khớp bị chết do thiếu lưu lượng máu. Xương và sụn này sau đó có thể bị gãy, gây đau và có thể cản trở chuyển đ', n.when_to_see = 'Nếu bạn bị đau hoặc nhức dai dẳng ở đầu gối, khuỷu tay hoặc khớp khác, hãy đến gặp bác sĩ. Các dấu hiệu và triệu chứng khác cần gọi điện hoặc đến gặp bác sĩ bao gồm sưng khớp hoặc không thể di chuyển ';
MERGE (n:Disease {id: 'D2147'}) SET n.id = 'D2147', n.name = 'Bệnh tạo xương không hoàn hảo', n.name_en = 'Osteogenesis imperfecta', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001573.htm', n.prognosis = 'Một người hoạt động tốt như thế nào tùy thuộc vào loại OI mà họ mắc phải. Loại I, hoặc OI nhẹ, là dạng phổ biến nhất. Những người mắc loại này có thể sống một tuổi thọ bình thường. Loại II là một dạng', n.when_to_see = 'Các thể nặng thường được chẩn đoán sớm nhất trong cuộc đời, nhưng những trường hợp nhẹ có thể không được ghi nhận cho đến sau này trong cuộc đời. Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn';
MERGE (n:Disease {id: 'D2148'}) SET n.id = 'D2148', n.name = 'Nhuyễn xương', n.name_en = 'Osteomalacia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000376.htm', n.prognosis = 'Một số người bị rối loạn thiếu vitamin sẽ khỏi bệnh trong vòng vài tuần. Với việc điều trị, quá trình lành vết thương sẽ diễn ra trong vòng 6 tháng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của chứng nhuyễn xương hoặc nếu bạn nghĩ rằng mình có thể có nguy cơ mắc chứng rối loạn này.';
MERGE (n:Disease {id: 'D2149'}) SET n.id = 'D2149', n.name = 'Viêm tủy xương', n.name_en = 'Osteomyelitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/osteomyelitis/symptoms-causes/syc-20375913 | https://medlineplus.gov/ency/article/000437.htm', n.overview = 'là một bệnh nhiễm trùng ở xương. Nó có thể ảnh hưởng đến một hoặc nhiều phần của xương. Nhiễm trùng có thể đến xương qua đường máu hoặc từ mô bị nhiễm trùng gần đó. Nhiễm trùng cũng có thể bắt đầu tro', n.prognosis = 'Khi điều trị, kết quả điều trị viêm tủy xương cấp tính thường tốt. Triển vọng sẽ tồi tệ hơn đối với những người bị viêm tủy xương (mạn tính) lâu dài. Các triệu chứng có thể đến và đi trong nhiều năm, ', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe nếu bạn bị sốt và đau xương ngày càng trầm trọng. Những người có nguy cơ bị nhiễm trùng do tình trạng bệnh lý hoặc cuộc phẫu thuật gần đây hoặc chấn thương nên';
MERGE (n:Disease {id: 'D2150'}) SET n.id = 'D2150', n.name = 'Viêm tủy xương ở trẻ em', n.name_en = 'Osteomyelitis in children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007697.htm', n.prognosis = 'Khi điều trị, kết quả điều trị viêm tủy xương cấp tính thường tốt. Triển vọng sẽ tồi tệ hơn đối với những người bị viêm tủy xương (mạn tính) lâu dài. Các triệu chứng có thể đến và đi trong nhiều năm, ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu: Con bạn xuất hiện các triệu chứng của viêm tủy xương Con bạn bị viêm tủy xương và các triệu chứng vẫn tiếp tục, ngay cả khi được';
MERGE (n:Disease {id: 'D2151'}) SET n.id = 'D2151', n.name = 'Hoại tử xương', n.name_en = 'Osteonecrosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007260.htm', n.prognosis = 'Bạn thực hiện tốt như thế nào tùy thuộc vào những điều sau: Nguyên nhân gây ra hoại tử xương Bệnh nghiêm trọng đến mức nào là khi được chẩn đoán Số lượng xương liên quan Tuổi và sức khỏe tổng thể của ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng.';
MERGE (n:Disease {id: 'D2152'}) SET n.id = 'D2152', n.name = 'Chứng loãng xương - trẻ sinh non', n.name_en = 'Osteopenia - premature infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007231.htm', n.prognosis = 'Gãy xương thường sẽ tự lành tốt nếu xử lý nhẹ nhàng và tăng lượng canxi, phốt pho và vitamin D trong chế độ ăn uống. Có thể tăng nguy cơ gãy xương trong suốt năm đầu đời đối với trẻ sinh non mắc bệnh ';
MERGE (n:Disease {id: 'D2153'}) SET n.id = 'D2153', n.name = 'Chứng loãng xương', n.name_en = 'Osteoporosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/osteoporosis/symptoms-causes/syc-20351968 | https://medlineplus.gov/ency/article/000360.htm', n.overview = 'khiến xương trở nên yếu và giòn - giòn đến mức một cú ngã hoặc thậm chí những tác động nhẹ như cúi xuống hoặc ho cũng có thể khiến xương bị gãy. Các vết gãy liên quan đến loãng xương thường xảy ra nhấ', n.prognosis = 'Thuốc điều trị loãng xương có thể giúp ngăn ngừa gãy xương trong tương lai. Xương cột sống đã bị xẹp không thể phục hồi lại được. Loãng xương có thể khiến một người bị tàn tật do xương yếu. Gãy xương ', n.when_to_see = 'Nói chuyện với chuyên gia chăm sóc sức khỏe của bạn về bệnh loãng xương nếu bạn trải qua thời kỳ mãn kinh sớm hoặc dùng corticosteroid trong vài tháng một lần. Ngoài ra, hãy gặp nhóm chăm sóc của bạn ';
MERGE (n:Disease {id: 'D2154'}) SET n.id = 'D2154', n.name = 'Phẫu thuật cắt xương đầu gối', n.name_en = 'Osteotomy of the knee', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007499.htm', n.overview = 'Có hai loại phẫu thuật: Cắt xương chày là phẫu thuật được thực hiện trên xương ống chân phía dưới xương chày. Phẫu thuật cắt bỏ xương đùi là phẫu thuật được thực hiện trên xương đùi phía trên đầu gối.', n.prognosis = 'Bạn sẽ được đeo một nẹp để hạn chế khả năng cử động đầu gối của bạn trong thời gian hồi phục. Nẹp cũng có thể giúp giữ đầu gối của bạn ở đúng vị trí. Bạn sẽ phải sử dụng nạng trong 6 tuần trở lên. Lúc';
MERGE (n:Disease {id: 'D2155'}) SET n.id = 'D2155', n.name = 'Viêm tai', n.name_en = 'Otitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001336.htm';
MERGE (n:Disease {id: 'D2156'}) SET n.id = 'D2156', n.name = 'Viêm tai giữa có tràn dịch', n.name_en = 'Otitis media with effusion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007010.htm', n.prognosis = 'OME thường tự biến mất sau vài tuần hoặc vài tháng. Điều trị có thể đẩy nhanh quá trình này. Tai keo có thể không sạch nhanh như OME với chất lỏng loãng hơn. OME thường không nguy hiểm đến tính mạng. ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn nghĩ rằng bạn hoặc con bạn có thể mắc OME. (Bạn nên tiếp tục theo dõi tình trạng cho đến khi chất lỏng biến mất.) Các triệu chứng mới phát triển trong hoặ';
MERGE (n:Disease {id: 'D2157'}) SET n.id = 'D2157', n.name = 'Bệnh xơ cứng tai', n.name_en = 'Otosclerosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001036.htm', n.prognosis = 'Bệnh xơ cứng tai sẽ nặng hơn nếu không được điều trị. Phẫu thuật có thể khôi phục một phần hoặc toàn bộ tình trạng mất thính lực của bạn. Cơn đau và chóng mặt do phẫu thuật sẽ biến mất trong vòng vài ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn bị mất thính lực Bạn bị sốt, đau tai, chóng mặt hoặc các triệu chứng khác sau phẫu thuật';
MERGE (n:Disease {id: 'D2158'}) SET n.id = 'D2158', n.name = 'Ung thư buồng trứng', n.name_en = 'Ovarian cancer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/ovarian-cancer/symptoms-causes/syc-20375941 | https://medlineplus.gov/ency/article/000889.htm', n.overview = 'buồng trứng. Mỗi buồng trứng có kích thước bằng một quả hạnh nhân. Chúng sản sinh ra trứng, gọi là trứng, cũng như các hormone estrogen và progesterone. Ung thư buồng trứng là sự phát triển của các tế', n.prognosis = 'Ung thư buồng trứng hiếm khi được chẩn đoán ở giai đoạn đầu. Nó thường khá tiến triển theo thời gian chẩn đoán: Gần một nửa số phụ nữ sống lâu hơn 5 năm sau khi chẩn đoán Nếu chẩn đoán được thực hiện ', n.when_to_see = 'Hãy hẹn gặp bác sĩ nếu bạn có bất kỳ dấu hiệu hoặc triệu chứng nào khiến bạn lo lắng. Thêm thông tin Chăm sóc ung thư buồng trứng tại xét nghiệm Mayo Clinic CA 125: Xét nghiệm sàng lọc ung thư buồng t';
MERGE (n:Disease {id: 'D2159'}) SET n.id = 'D2159', n.name = 'U nang buồng trứng', n.name_en = 'Ovarian cysts', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/ovarian-cysts/symptoms-causes/syc-20353405 | https://medlineplus.gov/ency/article/001504.htm', n.overview = 'Hệ thống sinh sản nữ, tử cung, cổ tử cung và âm đạo, còn được gọi là ống âm đạo, tạo nên hệ thống sinh sản nữ. U nang buồng trứng là những túi, thường chứa đầy chất lỏng, trong buồng trứng hoặc trên b', n.prognosis = 'U nang ở những phụ nữ vẫn còn kinh nguyệt có nhiều khả năng biến mất hơn. Một u nang phức tạp ở phụ nữ đã mãn kinh có nguy cơ mắc ung thư cao hơn. Ung thư rất khó xảy ra với một u nang đơn giản.', n.when_to_see = 'Nhận trợ giúp y tế ngay lập tức nếu bạn bị: Đau bụng hoặc vùng chậu đột ngột, dữ dội. Đau kèm theo sốt hoặc nôn mửa. Dấu hiệu sốc. Chúng bao gồm da lạnh, ẩm ướt; thở nhanh; và choáng váng hoặc yếu đuố';
MERGE (n:Disease {id: 'D2160'}) SET n.id = 'D2160', n.name = 'Hội chứng quá kích buồng trứng', n.name_en = 'Ovarian hyperstimulation syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/ovarian-hyperstimulation-syndrome-ohss/symptoms-causes/syc-20354697 | https://medlineplus.gov/ency/article/007294.htm', n.overview = 'là phản ứng quá mức với lượng hormone dư thừa. Nó thường xảy ra ở những phụ nữ tiêm thuốc nội tiết tố để kích thích sự phát triển của trứng trong buồng trứng. Hội chứng quá kích buồng trứng (OHSS) khi', n.prognosis = 'Hầu hết các trường hợp OHSS nhẹ sẽ tự khỏi sau khi bắt đầu có kinh. Nếu bạn gặp trường hợp nặng hơn, có thể mất vài ngày để các triệu chứng được cải thiện. Nếu bạn có thai trong thời gian OHSS, các tr', n.when_to_see = 'Nếu bạn đang điều trị khả năng sinh sản và gặp các triệu chứng của hội chứng quá kích buồng trứng, hãy báo cho nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Ngay cả khi bạn gặp trường hợp OHSS nhẹ, ';
MERGE (n:Disease {id: 'D2161'}) SET n.id = 'D2161', n.name = 'Buồng trứng sản xuất quá nhiều androgen', n.name_en = 'Ovarian overproduction of androgens', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001165.htm', n.prognosis = 'Sự thành công của điều trị phụ thuộc vào nguyên nhân sản xuất quá nhiều androgen. Nếu tình trạng này là do khối u buồng trứng gây ra, phẫu thuật cắt bỏ khối u có thể khắc phục được vấn đề. Hầu hết các';
MERGE (n:Disease {id: 'D2162'}) SET n.id = 'D2162', n.name = 'Ngộ độc chất tẩy rửa lò nướng', n.name_en = 'Oven cleaner poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002800.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải những chất độc như ';
MERGE (n:Disease {id: 'D2163'}) SET n.id = 'D2163', n.name = 'Thuốc giảm đau không kê đơn', n.name_en = 'Over-the-counter pain relievers', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002123.htm', n.overview = 'Thuốc giảm đau còn được gọi là thuốc giảm đau. Mỗi loại thuốc giảm đau đều có lợi ích và rủi ro. Một số loại đau đáp ứng tốt hơn với một loại thuốc hơn so với loại khác. Điều gì làm giảm đi nỗi đau củ';
MERGE (n:Disease {id: 'D2164'}) SET n.id = 'D2164', n.name = 'Bàng quang hoạt động quá mức', n.name_en = 'Overactive bladder', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/overactive-bladder/symptoms-causes/syc-20355715', n.overview = ', còn được gọi là OAB, gây ra cảm giác buồn tiểu đột ngột và khó kiểm soát. Có thể cần phải đi tiểu nhiều lần trong ngày và đêm. Cũng có thể xảy ra hiện tượng mất nước tiểu ngoài ý muốn, gọi là tiểu k', n.when_to_see = 'Mặc dù phổ biến ở người lớn tuổi, bàng quang hoạt động quá mức không phải là một phần điển hình của quá trình lão hóa. Có thể không dễ dàng để nói về các triệu chứng của bạn. Nhưng nếu các triệu chứng';
MERGE (n:Disease {id: 'D2165'}) SET n.id = 'D2165', n.name = 'Quá liều', n.name_en = 'Overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007287.htm', n.overview = 'Quá liều có thể nhẹ, trung bình hoặc nghiêm trọng. Các triệu chứng, điều trị và phục hồi phụ thuộc vào loại thuốc cụ thể có liên quan. Tại Hoa Kỳ, hãy gọi 1-800-222-1222 để nói chuyện với trung tâm ki';
MERGE (n:Disease {id: 'D2166'}) SET n.id = 'D2166', n.name = 'Ngộ độc axit oxalic', n.name_en = 'Oxalic acid poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002479.htm', n.prognosis = 'Tốt như thế nào tình trạng của một người phụ thuộc vào lượng chất độc được nuốt vào, mức độ đậm đặc của chất độc và tốc độ điều trị. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi cà';
MERGE (n:Disease {id: 'D2167'}) SET n.id = 'D2167', n.name = 'Quá liều oxazepam', n.name_en = 'Oxazepam overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002516.htm', n.prognosis = 'Việc phục hồi thường xảy ra khi được điều trị thích hợp. Những người hôn mê kéo dài hoặc bị biến chứng hô hấp có thể bị tàn tật vĩnh viễn.';
MERGE (n:Disease {id: 'D2168'}) SET n.id = 'D2168', n.name = 'Liệu pháp oxy ở trẻ sơ sinh', n.name_en = 'Oxygen therapy in infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007242.htm', n.overview = 'Oxy là loại khí mà các tế bào trong cơ thể bạn cần để hoạt động bình thường. Không khí chúng ta hít thở bình thường chứa 21% oxy. Chúng ta có thể nhận được tới 100% oxy, nghĩa là khí được hít vào là o';
MERGE (n:Disease {id: 'D2169'}) SET n.id = 'D2169', n.name = 'Bệnh Paget xương', n.name_en = 'Paget disease of the bone', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000414.htm', n.prognosis = 'Trong hầu hết các trường hợp, tình trạng bệnh có thể được kiểm soát bằng thuốc. Một số ít người có thể phát triển bệnh ung thư xương gọi là u xương ác tính. Một số người sẽ cần phẫu thuật thay khớp.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn xuất hiện các triệu chứng của bệnh Paget.';
MERGE (n:Disease {id: 'D2170'}) SET n.id = 'D2170', n.name = 'Bệnh xương Paget', n.name_en = 'Paget\'s disease of bone', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pagets-disease-of-bone/symptoms-causes/syc-20350811', n.overview = 'Bệnh xương Paget (PAJ-its) cản trở quá trình tái chế bình thường của cơ thể bạn, trong đó mô xương mới dần thay thế mô xương cũ. Theo thời gian, xương có thể trở nên mỏng manh và biến dạng. Xương chậu', n.when_to_see = 'Hãy nói chuyện với bác sĩ nếu bạn bị: Đau xương và khớp Ngứa ran và yếu ở tứ chi Biến dạng xương Mất thính giác không rõ nguyên nhân, đặc biệt nếu chỉ xảy ra ở một bên';
MERGE (n:Disease {id: 'D2171'}) SET n.id = 'D2171', n.name = 'Bệnh Paget vú', n.name_en = 'Paget\'s disease of the breast', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pagets-disease-of-the-breast/symptoms-causes/syc-20351079', n.overview = 'là một dạng ung thư vú hiếm gặp ảnh hưởng đến núm vú. Bệnh Paget ở vú thường gây ra vảy hoặc đóng vảy ở núm vú. Vùng bị ảnh hưởng có thể phát triển từ từ và liên quan đến vùng da xung quanh núm vú, gọ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D2172'}) SET n.id = 'D2172', n.name = 'Thuốc giảm đau - chất ma túy', n.name_en = 'Pain medications - narcotics', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007489.htm', n.overview = 'Chất gây nghiện hoạt động bằng cách liên kết với các thụ thể trong não, ngăn chặn cảm giác đau. Bạn không nên sử dụng thuốc gây nghiện trong hơn 3 đến 4 tháng, trừ khi nhà cung cấp hướng dẫn bạn cách ';
MERGE (n:Disease {id: 'D2173'}) SET n.id = 'D2173', n.name = 'Giao hợp đau đớn (chứng khó giao hợp)', n.name_en = 'Painful intercourse (dyspareunia)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/painful-intercourse/symptoms-causes/syc-20375967', n.overview = 'Giao hợp đau đớn có thể xảy ra vì những lý do từ vấn đề về cơ thể đến lo ngại về tâm lý. Nhiều người bị đau khi giao hợp vào một thời điểm nào đó trong đời. Thuật ngữ y học chỉ giao hợp đau đớn là gia', n.when_to_see = 'Nếu bạn bị đau tái phát khi quan hệ tình dục, hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn. Việc giải quyết vấn đề có thể giúp ích cho đời sống tình dục, sự thân mật về tình cảm và hình ảnh';
