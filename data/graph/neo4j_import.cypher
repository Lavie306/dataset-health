MERGE (n:Disease {id: 'D3129'}) SET n.id = 'D3129', n.name = 'Viêm âm đạo', n.name_en = 'Vaginismus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001487.htm', n.prognosis = 'Những phụ nữ được chuyên gia trị liệu tình dục điều trị thường có thể khắc phục được vấn đề này.';
MERGE (n:Disease {id: 'D3130'}) SET n.id = 'D3130', n.name = 'Sốt thung lũng', n.name_en = 'Valley fever', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/valley-fever/symptoms-causes/syc-20378761 | https://medlineplus.gov/ency/article/001322.htm', n.overview = 'là một bệnh nhiễm nấm. Vi khuẩn coccidioides (kok-sid-e-OI-deze) là nguyên nhân. Còn được gọi là sốt Thung lũng San Joaquin, nó có thể gây ra các triệu chứng như sốt, ho và mệt mỏi. Hai loài nấm cocci', n.prognosis = 'Tình trạng của bạn tốt như thế nào tùy thuộc vào dạng bệnh bạn mắc phải và sức khỏe tổng thể của bạn. Kết quả trong bệnh cấp tính có thể sẽ tốt. Với việc điều trị, kết quả thường tốt đối với bệnh mãn ', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế nếu bạn có các triệu chứng của bệnh sốt thung lũng nếu bạn trên 60 tuổi, có hệ miễn dịch yếu, đang mang thai hoặc bạn là người Philippines hoặc Châu Phi. (5p3) Tìm kiếm s';
