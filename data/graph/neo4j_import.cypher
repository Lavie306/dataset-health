MERGE (n:Disease {id: 'D3132'}) SET n.id = 'D3132', n.name = 'Varicocele', n.name_en = 'Varicocele', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/varicocele/symptoms-causes/syc-20378771 | https://medlineplus.gov/ency/article/001284.htm', n.overview = 'ygen đã cạn kiệt máu ra khỏi tinh hoàn. Giãn tĩnh mạch thừng tinh (VAR-ih-koe-seel) là hiện tượng giãn tĩnh mạch bên trong túi da lỏng lẻo giữ tinh hoàn (bìu dái). Những tĩnh mạch này vận chuyển máu t', n.prognosis = 'Giãn tĩnh mạch thừng tinh thường vô hại và thường không cần điều trị, trừ khi có sự thay đổi về kích thước tinh hoàn của bạn hoặc vấn đề về khả năng sinh sản. Nếu bạn phẫu thuật, số lượng tinh trùng c', n.when_to_see = 'Việc thăm khám sức khỏe hàng năm cho các bé trai rất quan trọng để theo dõi sự phát triển và sức khỏe của tinh hoàn. Điều quan trọng là phải lên lịch và giữ các cuộc hẹn này. Một số tình trạng có thể ';
MERGE (n:Disease {id: 'D3133'}) SET n.id = 'D3133', n.name = 'Giãn tĩnh mạch - điều trị không xâm lấn', n.name_en = 'Varicose vein - noninvasive treatment', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007395.htm', n.overview = 'Giãn tĩnh mạch thường phát triển ở chân. Chúng thường nhô ra và có màu xanh lam. Thông thường, các van trong tĩnh mạch giữ cho máu chảy về tim, do đó máu không tập trung lại một chỗ. Các van trong chứ', n.prognosis = 'Những phương pháp điều trị này giúp giảm đau và cải thiện vẻ ngoài của chân. Hầu hết thời gian, chúng gây ra rất ít sẹo, vết bầm tím hoặc sưng tấy. Mang vớ nén sẽ giúp ngăn ngừa vấn đề quay trở lại.';
MERGE (n:Disease {id: 'D3134'}) SET n.id = 'D3134', n.name = 'Cắt bỏ tĩnh mạch giãn', n.name_en = 'Varicose vein stripping', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002952.htm', n.overview = 'Giãn tĩnh mạch là các tĩnh mạch bị sưng, xoắn và to ra mà bạn có thể nhìn thấy dưới da. Chúng thường có màu đỏ hoặc xanh. Chúng thường xuất hiện ở chân nhưng có thể xảy ra ở các bộ phận khác trên cơ t', n.prognosis = 'Phẫu thuật cắt bỏ tĩnh mạch giúp giảm đau và cải thiện vẻ ngoài của chân bạn. Hiếm khi, việc bóc tĩnh mạch gây ra sẹo. Sưng chân nhẹ có thể xảy ra. Hãy chắc chắn rằng bạn thường xuyên mang vớ nén.';
MERGE (n:Disease {id: 'D3135'}) SET n.id = 'D3135', n.name = 'Giãn tĩnh mạch', n.name_en = 'Varicose veins', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/varicose-veins/symptoms-causes/syc-20350643 | https://medlineplus.gov/ency/article/001109.htm', n.overview = 'và trái tim. Để đưa máu về tim, các tĩnh mạch ở chân phải hoạt động chống lại trọng lực. Van yếu, còn gọi là van yếu, trong tĩnh mạch có thể gây giãn tĩnh mạch. Các van yếu khiến máu chảy vào tĩnh mạc', n.prognosis = 'Giãn tĩnh mạch có xu hướng trở nên trầm trọng hơn theo thời gian. Thực hiện các bước tự chăm sóc có thể giúp giảm đau nhức, giữ cho chứng giãn tĩnh mạch không trở nên trầm trọng hơn và ngăn ngừa các v', n.when_to_see = 'Nếu bạn lo lắng về hình dáng và cảm nhận của tĩnh mạch cũng như các biện pháp tự chăm sóc không giúp ích được gì, hãy gặp chuyên gia chăm sóc sức khỏe của bạn. Yêu cầu một cuộc hẹn Có vấn đề với
 thôn';
MERGE (n:Disease {id: 'D3136'}) SET n.id = 'D3136', n.name = 'Ngộ độc vecni', n.name_en = 'Varnish poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002747.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng vecni họ nuốt và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Sơn bóng có thể gây tổn thương nặng ở: Phổi Miệng Dạ dày ';
MERGE (n:Disease {id: 'D3137'}) SET n.id = 'D3137', n.name = 'Suy giảm nhận thức mạch máu và sa sút trí tuệ mạch máu', n.name_en = 'Vascular cognitive impairment and vascular dementia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/vascular-dementia/symptoms-causes/syc-20378793', n.overview = 'Suy giảm nhận thức mạch máu là thuật ngữ dùng để mô tả những thay đổi trong suy nghĩ và trí nhớ xảy ra khi không có đủ lưu lượng máu đến một phần não, như có thể xảy ra với đột quỵ. "Mạch máu" dùng để';
MERGE (n:Disease {id: 'D3138'}) SET n.id = 'D3138', n.name = 'Chứng mất trí nhớ mạch máu', n.name_en = 'Vascular dementia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000746.htm', n.prognosis = 'Một số cải thiện có thể xảy ra trong thời gian ngắn, nhưng tình trạng rối loạn nhìn chung sẽ trở nên tồi tệ hơn theo thời gian.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu có triệu chứng sa sút trí tuệ mạch máu xảy ra. Đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu có sự thay đổi đột ngột về trạng thái tinh thần, c';
MERGE (n:Disease {id: 'D3139'}) SET n.id = 'D3139', n.name = 'Vòng mạch', n.name_en = 'Vascular ring', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007318.htm', n.prognosis = 'Trẻ sơ sinh khỏe mạnh như thế nào tùy thuộc vào mức độ áp lực của vòng mạch lên thực quản và khí quản cũng như tốc độ chẩn đoán và điều trị của trẻ. Phẫu thuật có tác dụng tốt trong hầu hết các trường', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có các triệu chứng của vòng mạch máu. Việc chẩn đoán và điều trị nhanh chóng có thể ngăn ngừa các biến chứng nghiêm trọng.';
MERGE (n:Disease {id: 'D3140'}) SET n.id = 'D3140', n.name = 'Viêm mạch', n.name_en = 'Vasculitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/vasculitis/symptoms-causes/syc-20363435', n.overview = 'liên quan đến tình trạng sưng tấy và kích ứng, gọi là viêm, ở các mạch máu. Tình trạng viêm có thể làm cho thành mạch máu dày lên. Sự dày lên này có thể thu hẹp các mạch máu. Nếu việc thu hẹp làm hạn ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng khiến bạn lo lắng. Một số loại viêm mạch trở nên tồi tệ nhanh chóng. Chẩn đoán sớm là chìa khóa để điều trị có hiệu quả. Yêu';
MERGE (n:Disease {id: 'D3141'}) SET n.id = 'D3141', n.name = 'Thắt ống dẫn tinh', n.name_en = 'Vasectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002995.htm', n.overview = 'thường được thực hiện tại phòng khám của bác sĩ phẫu thuật bằng cách gây tê tại chỗ. Bạn sẽ tỉnh táo nhưng không cảm thấy đau đớn. Sau khi cạo và làm sạch bìu của bạn, bác sĩ phẫu thuật sẽ tiêm thuốc ', n.prognosis = 'Thắt ống dẫn tinh không ảnh hưởng đến khả năng cương cứng, cực khoái hoặc xuất tinh của nam giới. Thắt ống dẫn tinh không ngăn ngừa sự lây lan của các bệnh lây truyền qua đường tình dục (STIs). Thắt ố';
MERGE (n:Disease {id: 'D3142'}) SET n.id = 'D3142', n.name = 'Ngất do co mạch', n.name_en = 'Vasovagal syncope', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/vasovagal-syncope/symptoms-causes/syc-20350527', n.overview = '(vay-zoh-VAY-gul SING-kuh-pee) xảy ra khi bạn ngất xỉu vì cơ thể phản ứng quá mức với một số tác nhân nhất định. Những điều này có thể bao gồm việc nhìn thấy máu hoặc cảm xúc đau khổ tột độ. Ngất Vaso', n.when_to_see = 'Ngất xỉu có thể là dấu hiệu của một tình trạng nghiêm trọng hơn, chẳng hạn như bệnh về tim hoặc não. Bạn có thể muốn tham khảo ý kiến ​​​​chuyên gia chăm sóc sức khỏe của mình sau khi bị ngất xỉu, đặc';
MERGE (n:Disease {id: 'D3143'}) SET n.id = 'D3143', n.name = 'Suy tĩnh mạch', n.name_en = 'Venous insufficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000203.htm', n.prognosis = 'Suy tĩnh mạch mãn tính có xu hướng trở nên nặng hơn theo thời gian. Tuy nhiên, nó có thể được kiểm soát nếu bắt đầu điều trị ở giai đoạn đầu. Bằng cách thực hiện các bước tự chăm sóc, bạn có thể giảm ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị giãn tĩnh mạch và gây đau. Tình trạng của bạn trở nên tồi tệ hơn hoặc không cải thiện khi tự chăm sóc, chẳng hạn như mang vớ nén hoặc tránh đứn';
MERGE (n:Disease {id: 'D3144'}) SET n.id = 'D3144', n.name = 'Sửa chữa thoát vị bụng', n.name_en = 'Ventral hernia repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007661.htm', n.overview = 'Bạn có thể sẽ được gây mê toàn thân cho ca phẫu thuật này. Điều này sẽ khiến bạn ngủ ngon và không bị đau. Nếu khối thoát vị của bạn nhỏ, bạn có thể được gây tê tủy sống hoặc gây tê ngoài màng cứng và', n.prognosis = 'Sau phẫu thuật, nguy cơ thoát vị tái phát là rất thấp. Tuy nhiên, để giảm nguy cơ mắc phải chứng thoát vị khác, bạn cần duy trì lối sống lành mạnh, chẳng hạn như duy trì cân nặng hợp lý.';
MERGE (n:Disease {id: 'D3145'}) SET n.id = 'D3145', n.name = 'Thiết bị hỗ trợ tâm thất', n.name_en = 'Ventricular assist device', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007268.htm', n.overview = 'Thiết bị hỗ trợ tâm thất có 3 bộ phận: Một máy bơm. Máy bơm nặng từ 1 đến 2 pound (0,5 đến 1 kg). Nó được đặt bên trong hoặc bên ngoài bụng của bạn. Một bộ điều khiển điện tử. Bộ điều khiển là một máy', n.prognosis = 'VAD có thể giúp những người bị suy tim sống lâu hơn. Nó cũng có thể giúp cải thiện chất lượng cuộc sống của bệnh nhân.';
MERGE (n:Disease {id: 'D3146'}) SET n.id = 'D3146', n.name = 'Rung tâm thất', n.name_en = 'Ventricular fibrillation', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/ventricular-fibrillation/symptoms-causes/syc-20364523 | https://medlineplus.gov/ency/article/007200.htm', n.overview = 'là một loại nhịp tim không đều (loạn nhịp tim). Trong quá trình rung tâm thất, các buồng tim phía dưới co bóp rất nhanh và không phối hợp. Kết quả là tim không bơm máu đến phần còn lại của cơ thể. Run', n.prognosis = 'VF sẽ dẫn đến tử vong trong vòng vài phút trừ khi được điều trị nhanh chóng và đúng cách. Ngay cả khi đó, khả năng sống sót lâu dài của những người sống sót sau cơn VF bên ngoài bệnh viện là rất thấp.', n.when_to_see = 'Hẹn gặp bác sĩ tim mạch (bác sĩ tim mạch) nếu bạn có nhịp tim đập nhanh hoặc đập không rõ nguyên nhân. Nếu bạn thấy ai đó ngã gục, hãy tìm kiếm sự trợ giúp y tế khẩn cấp ngay lập tức. Hãy làm theo các';
MERGE (n:Disease {id: 'D3147'}) SET n.id = 'D3147', n.name = 'Thông liên thất', n.name_en = 'Ventricular septal defect', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001099.htm', n.prognosis = 'Nhiều lỗi nhỏ sẽ tự đóng lại. Phẫu thuật có thể sửa chữa những khiếm khuyết không đóng được. Trong hầu hết các trường hợp, một người sẽ không gặp bất kỳ vấn đề y tế nào liên quan đến khiếm khuyết nếu ', n.when_to_see = 'Thông thường, tình trạng này được chẩn đoán khi khám định kỳ cho trẻ sơ sinh. Liên hệ với nhà cung cấp dịch vụ chăm sóc trẻ sơ sinh của bạn nếu trẻ có vẻ khó thở hoặc nếu trẻ có vẻ bị nhiễm trùng đườn';
MERGE (n:Disease {id: 'D3148'}) SET n.id = 'D3148', n.name = 'Thông liên thất (VSD)', n.name_en = 'Ventricular septal defect (VSD)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ventricular-septal-defect/symptoms-causes/syc-20353495', n.overview = 'Thông liên thất (VSD) là một lỗ trên tim. Đó là một vấn đề về tim thường gặp khi sinh ra (khiếm khuyết tim bẩm sinh). Lỗ xuất hiện trên bức tường ngăn cách các buồng dưới của tim (tâm thất). Thông liê', n.when_to_see = 'Gọi cho nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn: Dễ mệt mỏi khi ăn hoặc chơi Không tăng cân Trở nên khó thở khi ăn hoặc khóc Thở nhanh hoặc hụt ​​hơi Gọi cho nhà cung cấp dịch vụ ch';
MERGE (n:Disease {id: 'D3149'}) SET n.id = 'D3149', n.name = 'Nhịp tim nhanh thất', n.name_en = 'Ventricular tachycardia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/ventricular-tachycardia/symptoms-causes/syc-20355138 | https://medlineplus.gov/ency/article/000187.htm', n.overview = 'nhịp tim hoặc nhịp tim nhanh, một xung điện không đều bắt đầu từ buồng dưới của tim khiến tim đập nhanh hơn. Nhịp tim nhanh thất là một loại nhịp tim không đều, được gọi là rối loạn nhịp tim. Nó bắt đ', n.prognosis = 'Kết quả phụ thuộc vào tình trạng tim và các triệu chứng.', n.when_to_see = 'Nhiều thứ khác nhau có thể gây ra nhịp nhanh thất, đôi khi được gọi là V-tach hoặc VT. Điều quan trọng là phải chẩn đoán nhanh, chính xác và chăm sóc thích hợp. Ngay cả khi bạn có một trái tim khỏe mạ';
MERGE (n:Disease {id: 'D3150'}) SET n.id = 'D3150', n.name = 'Tạo shunt não thất', n.name_en = 'Ventriculoperitoneal shunting', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003019.htm', n.overview = 'Thủ tục này được thực hiện trong phòng mổ dưới gây mê toàn thân. Mất khoảng 1 tiếng rưỡi. Một ống mỏng (ống thông) được đưa từ khoang đầu đến bụng để dẫn lưu dịch não tủy dư thừa. Van áp suất và thiết', n.prognosis = 'Đặt ống dẫn lưu thường thành công trong việc giảm áp lực trong não. Nếu não úng thủy có liên quan đến các tình trạng khác, chẳng hạn như tật nứt đốt sống, khối u não, viêm màng não, viêm não hoặc xuất';
MERGE (n:Disease {id: 'D3151'}) SET n.id = 'D3151', n.name = 'Viêm kết mạc mùa xuân', n.name_en = 'Vernal conjunctivitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001390.htm', n.prognosis = 'Tình trạng này tiếp diễn theo thời gian (là mãn tính). Nó trở nên tồi tệ hơn vào những mùa nhất định trong năm, thường xuyên nhất là vào mùa xuân và mùa hè. Điều trị có thể giúp giảm đau.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu các triệu chứng của bạn tiếp tục hoặc trở nên tồi tệ hơn.';
MERGE (n:Disease {id: 'D3152'}) SET n.id = 'D3152', n.name = 'Khối u đốt sống', n.name_en = 'Vertebral tumor', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/vertebral-tumor/symptoms-causes/syc-20350123', n.overview = 'Khối u giải phẫu cột sống là sự phát triển của các tế bào xảy ra trong xương cột sống. Khối u đốt sống còn được gọi là khối u cột sống. Xương của cột sống được gọi là đốt sống. Cột sống được tạo thành', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Một số triệu chứng của khối u đốt sống tương tự như các triệu chứng do các tình trạng khá';
MERGE (n:Disease {id: 'D3153'}) SET n.id = 'D3153', n.name = 'Rối loạn tuần hoàn động vật sống nền', n.name_en = 'Vertebrobasilar circulatory disorders', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001423.htm', n.prognosis = 'Triển vọng phụ thuộc vào: Mức độ tổn thương não Chức năng cơ thể nào đã bị ảnh hưởng Bạn được điều trị nhanh như thế nào Bạn hồi phục nhanh như thế nào Mỗi người có thời gian hồi phục khác nhau và cần', n.when_to_see = 'Gọi 911 hoặc số cấp cứu tại địa phương hoặc đến phòng cấp cứu nếu bạn có bất kỳ triệu chứng nào của bệnh rối loạn tuần hoàn đốt sống hoặc nền.';
MERGE (n:Disease {id: 'D3154'}) SET n.id = 'D3154', n.name = 'Tạo hình đốt sống', n.name_en = 'Vertebroplasty', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007512.htm', n.overview = 'được thực hiện tại bệnh viện hoặc trung tâm phẫu thuật ngoại trú. Bạn có thể được gây tê cục bộ (tỉnh táo và không thể cảm thấy đau). Bạn cũng có thể sẽ nhận được thuốc để giúp bạn thư giãn và cảm thấ', n.prognosis = 'Những người thực hiện thủ thuật này thường ít đau hơn và có chất lượng cuộc sống tốt hơn sau phẫu thuật. Họ thường cần ít thuốc giảm đau hơn và có thể di chuyển tốt hơn trước.';
MERGE (n:Disease {id: 'D3155'}) SET n.id = 'D3155', n.name = 'Cắt dạ dày theo chiều dọc', n.name_en = 'Vertical sleeve gastrectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007435.htm', n.overview = 'Bạn sẽ được gây mê toàn thân trước khi phẫu thuật này. Đây là loại thuốc giúp bạn ngủ ngon và không đau đớn. Phẫu thuật thường được thực hiện bằng cách sử dụng một camera nhỏ đặt trong bụng của bạn. L', n.prognosis = 'Mức giảm cân cuối cùng có thể không lớn bằng phương pháp cắt dạ dày . Điều này có thể là đủ cho nhiều người. Nói chuyện với bác sĩ phẫu thuật của bạn về thủ tục nào là tốt nhất cho bạn. Cân nặng thườn';
MERGE (n:Disease {id: 'D3156'}) SET n.id = 'D3156', n.name = 'Rối loạn liên quan đến chóng mặt', n.name_en = 'Vertigo-associated disorders', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001432.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị chóng mặt không biến mất hoặc cản trở các hoạt động hàng ngày của bạn. Nếu bạn chưa bao giờ bị chóng mặt hoặc nếu bạn bị chóng mặt kèm theo các ';
MERGE (n:Disease {id: 'D3157'}) SET n.id = 'D3157', n.name = 'Mụn nước', n.name_en = 'Vesicles', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003939.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có bất kỳ vết phồng rộp nào không rõ nguyên nhân trên da.';
MERGE (n:Disease {id: 'D3158'}) SET n.id = 'D3158', n.name = 'Trào ngược bàng quang niệu quản', n.name_en = 'Vesicoureteral reflux', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/vesicoureteral-reflux/symptoms-causes/syc-20378819', n.overview = 'Hệ thống tiết niệu nữ mắt, niệu quản, bàng quang và niệu đạo. Hệ thống tiết niệu loại bỏ chất thải ra khỏi cơ thể qua nước tiểu. Thận nằm về phía sau của bụng trên. Chúng lọc chất thải và chất lỏng từ', n.when_to_see = 'Hãy gọi cho chuyên gia chăm sóc sức khỏe ngay lập tức nếu con bạn có bất kỳ triệu chứng UTI nào, chẳng hạn như: Buồn tiểu nhiều và dai dẳng. Cảm giác nóng rát khi đi tiểu. Đau ở vùng bụng, háng hoặc b';
MERGE (n:Disease {id: 'D3159'}) SET n.id = 'D3159', n.name = 'Hội chứng VEXAS', n.name_en = 'VEXAS syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/vexas-syndrome/symptoms-causes/syc-20590472', n.overview = 'là tình trạng hệ thống miễn dịch tấn công nhầm vào cơ thể. Đây được gọi là tình trạng tự viêm. Hội chứng VEXAS gây sưng tấy và kích ứng, gọi là viêm, khắp cơ thể. Hội chứng VEXAS không phổ biến. Một s', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D3160'}) SET n.id = 'D3160', n.name = 'VIPoma', n.name_en = 'VIPoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000228.htm', n.prognosis = 'Phẫu thuật thường có thể chữa khỏi bệnh VIPomas. Tuy nhiên, ở một phần ba đến một nửa số người, khối u đã lan rộng vào thời điểm được chẩn đoán và không thể chữa khỏi. Tuy nhiên, nó phát triển khá chậ', n.when_to_see = 'Nếu bạn bị tiêu chảy phân nước kéo dài hơn 2 đến 3 ngày, hãy liên hệ với nhà cung cấp dịch vụ của bạn.';
MERGE (n:Disease {id: 'D3161'}) SET n.id = 'D3161', n.name = 'Viêm khớp do virus', n.name_en = 'Viral arthritis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000416.htm', n.prognosis = 'Kết quả thường tốt. Hầu hết bệnh viêm khớp do virus biến mất trong vòng vài ngày hoặc vài tuần khi bệnh liên quan đến virus biến mất.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để lấy hẹn nếu các triệu chứng viêm khớp kéo dài hơn một vài tuần.';
MERGE (n:Disease {id: 'D3162'}) SET n.id = 'D3162', n.name = 'Viêm dạ dày ruột do vi-rút (cúm dạ dày)', n.name_en = 'Viral gastroenteritis (stomach flu)', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/viral-gastroenteritis/symptoms-causes/syc-20378847 | https://medlineplus.gov/ency/article/000252.htm', n.overview = 'Viêm dạ dày ruột do vi-rút là một bệnh nhiễm trùng đường ruột bao gồm các dấu hiệu và triệu chứng như tiêu chảy phân nước, co thắt dạ dày, buồn nôn hoặc nôn mửa và đôi khi sốt. Cách phổ biến nhất để p', n.prognosis = 'Đối với hầu hết mọi người, bệnh sẽ khỏi sau vài ngày mà không cần điều trị.', n.when_to_see = 'Nếu bạn là người lớn, hãy gọi cho nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn không thể giữ chất lỏng trong 24 giờ Bạn đã nôn mửa hoặc tiêu chảy trong hơn hai ngày Bạn nôn ra máu Bạn bị mấ';
MERGE (n:Disease {id: 'D3163'}) SET n.id = 'D3163', n.name = 'Sốt xuất huyết do vi-rút', n.name_en = 'Viral hemorrhagic fevers', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/viral-hemorrhagic-fevers/symptoms-causes/syc-20351260', n.overview = 'Sốt xuất huyết do vi-rút (hem-uh-RAJ-ik) là những bệnh truyền nhiễm có thể đe dọa đến tính mạng. Chúng có thể làm hỏng thành mạch máu nhỏ, khiến chúng bị rò rỉ. Và chúng có thể giữ cho máu không bị đô', n.when_to_see = 'Thời điểm tốt nhất để gặp chuyên gia chăm sóc sức khỏe là trước khi bạn đi du lịch đến một quốc gia nơi bạn có thể mắc bệnh truyền nhiễm. Sau đó, bạn có thể tiêm chủng và nhận lời khuyên trước khi đi ';
MERGE (n:Disease {id: 'D3164'}) SET n.id = 'D3164', n.name = 'Viêm phổi do virus', n.name_en = 'Viral pneumonia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000073.htm', n.prognosis = 'Hầu hết các trường hợp viêm phổi do virus đều ở mức độ nhẹ và thuyên giảm mà không cần điều trị trong vòng 1 đến 3 tuần. Một số trường hợp nghiêm trọng hơn và phải nhập viện.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu các triệu chứng viêm phổi do vi-rút phát triển hoặc tình trạng của bạn trở nên tồi tệ hơn sau khi bắt đầu cải thiện.';
MERGE (n:Disease {id: 'D3165'}) SET n.id = 'D3165', n.name = 'Nam hóa', n.name_en = 'Virilization', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002339.htm', n.overview = 'có thể do: Sản xuất testosterone dư thừa Sử dụng steroid đồng hóa (được sử dụng để nâng cao hiệu suất hoặc các mục đích khác) Ở bé trai hoặc bé gái mới sinh, tình trạng này có thể do: Một số loại thuố';
MERGE (n:Disease {id: 'D3166'}) SET n.id = 'D3166', n.name = 'Ấu trùng di chuyển nội tạng', n.name_en = 'Visceral larva migrans', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000633.htm', n.prognosis = 'Nhiễm trùng nặng liên quan đến não hoặc tim có thể dẫn đến tử vong, nhưng trường hợp này rất hiếm.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện bất kỳ triệu chứng nào sau đây: Ho Khó thở Các vấn đề về mắt Sốt Phát ban Cần phải khám sức khỏe toàn diện để kiểm tra VLM. Nhiều tình tr';
MERGE (n:Disease {id: 'D3167'}) SET n.id = 'D3167', n.name = 'Thị lực - quáng gà', n.name_en = 'Vision - night blindness', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003039.htm', n.when_to_see = 'Điều quan trọng là phải khám mắt toàn diện để xác định nguyên nhân và có thể điều trị được. Liên hệ với bác sĩ nhãn khoa nếu các triệu chứng quáng gà kéo dài hoặc ảnh hưởng đáng kể đến cuộc sống của b';
MERGE (n:Disease {id: 'D3168'}) SET n.id = 'D3168', n.name = 'Vấn đề về thị lực', n.name_en = 'Vision problems', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003029.htm', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc khẩn cấp từ nhà cung cấp có kinh nghiệm xử lý các trường hợp cấp cứu về mắt nếu: Bạn bị mù một phần hoặc toàn bộ ở một hoặc cả hai mắt, ngay cả khi tình trạng đó chỉ là tạm th';
MERGE (n:Disease {id: 'D3169'}) SET n.id = 'D3169', n.name = 'Thiếu máu do thiếu vitamin B12', n.name_en = 'Vitamin B12 deficiency anemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000574.htm', n.prognosis = 'Những người mắc bệnh thiếu máu loại này thường điều trị tốt. Thiếu vitamin B12 lâu dài có thể gây tổn thương thần kinh. Điều này có thể là vĩnh viễn nếu bạn không bắt đầu điều trị ngay sau khi các tri', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có bất kỳ triệu chứng thiếu máu nào.';
MERGE (n:Disease {id: 'D3170'}) SET n.id = 'D3170', n.name = 'Thiếu máu do thiếu vitamin', n.name_en = 'Vitamin deficiency anemia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/vitamin-deficiency-anemia/symptoms-causes/syc-20355025', n.overview = 'là có quá ít tế bào hồng cầu khỏe mạnh. Nó xảy ra khi cơ thể có quá ít vitamin B-12 và folate. Không ăn đủ thực phẩm có vitamin B-12 và folate có thể gây thiếu máu do thiếu vitamin. Hoặc cơ thể có thể';
MERGE (n:Disease {id: 'D3171'}) SET n.id = 'D3171', n.name = 'Chảy máu do thiếu vitamin K ở trẻ sơ sinh', n.name_en = 'Vitamin K deficiency bleeding of the newborn', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007320.htm', n.prognosis = 'Triển vọng có xu hướng xấu hơn đối với trẻ mắc bệnh xuất huyết muộn so với các dạng khác. Có tỷ lệ chảy máu bên trong hộp sọ cao hơn (xuất huyết nội sọ) liên quan đến tình trạng khởi phát muộn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu con bạn bị: Bất kỳ tình trạng chảy máu không rõ nguyên nhân Động kinh Hành vi bất thường Nhận chăm sóc y tế khẩn cấp ngay lập tức';
MERGE (n:Disease {id: 'D3172'}) SET n.id = 'D3172', n.name = 'Bệnh bạch biến', n.name_en = 'Vitiligo', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/vitiligo/symptoms-causes/syc-20355912 | https://medlineplus.gov/ency/article/000831.htm', n.overview = '(vit-ih-LIE-go) là bệnh gây mất màu da từng mảng. Các vùng bị đổi màu thường lớn hơn theo thời gian. Tình trạng này có thể ảnh hưởng đến da trên bất kỳ bộ phận nào của cơ thể. Nó cũng có thể ảnh hưởng', n.prognosis = 'Diễn biến của bệnh bạch biến rất đa dạng và không thể đoán trước được. Một số vùng có thể lấy lại sắc tố bình thường (màu sắc), nhưng những vùng mất sắc tố mới khác có thể xuất hiện. Da được tái tạo s', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu các vùng da, tóc hoặc màng nhầy của bạn bị mất màu. Bệnh bạch biến không có cách chữa trị. Nhưng việc điều trị có thể ngăn chặn hoặc làm chậm';
MERGE (n:Disease {id: 'D3173'}) SET n.id = 'D3173', n.name = 'Liệt dây thanh', n.name_en = 'Vocal cord paralysis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/vocal-cord-paralysis/symptoms-causes/syc-20378873', n.overview = 'là tình trạng gây mất khả năng kiểm soát các cơ điều khiển giọng nói. Nó xảy ra khi các xung thần kinh tới thanh quản, còn gọi là thanh quản, bị gián đoạn. Điều này dẫn đến tê liệt các cơ dây thanh âm', n.when_to_see = 'Hãy liên hệ với chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị khàn giọng không rõ nguyên nhân và tình trạng này kéo dài hơn 2 đến 4 tuần. Đồng thời, hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu ';
MERGE (n:Disease {id: 'D3174'}) SET n.id = 'D3174', n.name = 'Rối loạn giọng nói', n.name_en = 'Voice disorders', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/voice-disorders/symptoms-causes/syc-20353022', n.overview = 'Mọi người có thể bị rối loạn giọng nói vì nhiều lý do. Rối loạn giọng nói, còn được gọi là chứng khó phát âm, là sự thay đổi trong cách phát âm giọng nói. Rối loạn giọng nói có thể bao gồm liệt dây th', n.when_to_see = 'Nếu bạn bị khàn giọng hoặc các vấn đề khác về giọng nói trong 2 đến 4 tuần và bạn không bị cảm lạnh hoặc nhiễm trùng đường hô hấp, hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn và đi khám. Y';
MERGE (n:Disease {id: 'D3175'}) SET n.id = 'D3175', n.name = 'Co cứng Volkmann', n.name_en = 'Volkmann contracture', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001221.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào mức độ nghiêm trọng và giai đoạn bệnh tại thời điểm bắt đầu điều trị. Kết quả thường tốt cho những người bị co rút nhẹ. Họ có thể lấy lại chức năng bình', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn ngay nếu bạn bị thương ở khuỷu tay hoặc cẳng tay và bị sưng, tê và đau ngày càng trầm trọng hơn.';
MERGE (n:Disease {id: 'D3176'}) SET n.id = 'D3176', n.name = 'Xoắn ruột - thời thơ ấu', n.name_en = 'Volvulus - childhood', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000985.htm', n.prognosis = 'Trong hầu hết các trường hợp, chẩn đoán và điều trị kịp thời xoắn ruột sẽ mang lại kết quả tốt. Nếu một phần ruột bị chết thì tiên lượng sẽ kém. Tình trạng có thể gây tử vong, tùy thuộc vào lượng ruột', n.when_to_see = 'Đây là tình trạng khẩn cấp. Các triệu chứng của bệnh xoắn ruột ở trẻ em phát triển nhanh chóng và trẻ sẽ bị bệnh nặng. Nhận sự chăm sóc y tế ngay lập tức nếu điều này xảy ra.';
MERGE (n:Disease {id: 'D3177'}) SET n.id = 'D3177', n.name = 'Nôn ra máu', n.name_en = 'Vomiting blood', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003118.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn hoặc đến phòng cấp cứu nếu nôn ra máu thực quản. Bạn sẽ cần phải được kiểm tra ngay lập tức.';
MERGE (n:Disease {id: 'D3178'}) SET n.id = 'D3178', n.name = 'bệnh von Gierke', n.name_en = 'von Gierke disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000338.htm', n.prognosis = 'Với việc điều trị, sự tăng trưởng, dậy thì và chất lượng cuộc sống đã được cải thiện đối với những người mắc bệnh von Gierke. Những người được phát hiện và điều trị cẩn thận từ khi còn trẻ có thể sống', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu gia đình bạn có tiền sử mắc bệnh dự trữ glycogen hoặc trẻ sơ sinh tử vong sớm do lượng đường trong máu thấp.';
MERGE (n:Disease {id: 'D3179'}) SET n.id = 'D3179', n.name = 'Bệnh Von Willebrand', n.name_en = 'Von Willebrand disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/von-willebrand-disease/symptoms-causes/syc-20354978 | https://medlineplus.gov/ency/article/000544.htm', n.overview = 'là tình trạng chảy máu suốt đời khiến máu khó đông. Những người mắc bệnh này có hàm lượng yếu tố von Willebrand thấp, một loại protein giúp đông máu hoặc loại protein mà họ có không hoạt động tốt. Hầu', n.prognosis = 'Chảy máu có thể giảm khi mang thai. Phụ nữ mắc bệnh này thường không bị chảy máu quá nhiều khi sinh con. Bệnh này được truyền qua các gia đình. Tư vấn di truyền có thể giúp các bậc cha mẹ tương lai hi', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu chảy máu xảy ra mà không có lý do. Nếu bạn mắc bệnh von Willebrand và được lên lịch phẫu thuật hoặc gặp tai nạn, hãy đảm bảo rằng bạn hoặc gia đình bạn';
MERGE (n:Disease {id: 'D3180'}) SET n.id = 'D3180', n.name = 'Ung thư âm hộ', n.name_en = 'Vulvar cancer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/vulvar-cancer/symptoms-causes/syc-20368051 | https://medlineplus.gov/ency/article/000902.htm', n.overview = 'xuất hiện trên âm hộ. Âm hộ là vùng thịt bao quanh âm đạo và ống dẫn nước tiểu ra khỏi cơ thể, được gọi là niệu đạo. Ung thư âm hộ là bệnh ung thư bắt đầu bằng sự phát triển của các tế bào trên âm hộ.', n.prognosis = 'Hầu hết phụ nữ mắc bệnh ung thư âm hộ được chẩn đoán và điều trị ở giai đoạn đầu đều có kết quả tốt. Nhưng kết quả của người phụ nữ phụ thuộc vào: Kích thước của khối u Loại ung thư âm hộ Liệu ung thư', n.when_to_see = 'Hãy hẹn gặp bác sĩ, bác sĩ phụ khoa hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. ';
MERGE (n:Disease {id: 'D3181'}) SET n.id = 'D3181', n.name = 'Vulvodynia', n.name_en = 'Vulvodynia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/vulvodynia/symptoms-causes/syc-20353423 | https://medlineplus.gov/ency/article/007699.htm', n.overview = '(vul-voe-DIN-e-uh) là một loại đau hoặc khó chịu lâu dài xung quanh phần bên ngoài của bộ phận sinh dục nữ, được gọi là âm hộ. Nó kéo dài ít nhất ba tháng và không có nguyên nhân rõ ràng. Cảm giác đau', n.prognosis = 'Vulvodynia thường là một tình trạng phức tạp. Có thể mất vài tuần đến vài tháng để giảm đau. Điều trị có thể không làm giảm tất cả các triệu chứng. Sự kết hợp giữa các phương pháp điều trị và thay đổi', n.when_to_see = 'Nếu bạn bị đau ở âm hộ, hãy nói chuyện với bác sĩ phụ khoa hoặc thành viên khác trong nhóm chăm sóc sức khỏe của bạn. Nếu bạn không có bác sĩ phụ khoa, bạn có thể được giới thiệu đến một bác sĩ. Chuyê';
MERGE (n:Disease {id: 'D3182'}) SET n.id = 'D3182', n.name = 'Viêm âm hộ', n.name_en = 'Vulvovaginitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000897.htm', n.prognosis = 'Điều trị nhiễm trùng đúng cách sẽ có hiệu quả trong hầu hết các trường hợp.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có các triệu chứng của viêm âm hộ. Bạn không thấy thuyên giảm sau khi điều trị viêm âm hộ.';
MERGE (n:Disease {id: 'D3183'}) SET n.id = 'D3183', n.name = 'Hội chứng Waardenburg', n.name_en = 'Waardenburg syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001428.htm', n.prognosis = 'Một khi vấn đề về thính giác được giải quyết, hầu hết những người mắc hội chứng này sẽ có thể có một cuộc sống bình thường. Những người mắc các dạng hội chứng hiếm gặp hơn có thể có các biến chứng khá', n.when_to_see = 'Tư vấn di truyền có thể hữu ích nếu bạn có tiền sử gia đình mắc hội chứng Waardenburg và dự định có con. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn để kiểm tra thính lực nếu bạn hoặc c';
MERGE (n:Disease {id: 'D3184'}) SET n.id = 'D3184', n.name = 'Waldenstrom macroglobulinemia', n.name_en = 'Waldenstrom macroglobulinemia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/waldenstrom-macroglobulinemia/symptoms-causes/syc-20359967 | https://medlineplus.gov/ency/article/000588.htm', n.overview = '(mak-roe-glob-u-lih-NEE-me-uh) là một loại ung thư bắt đầu trong các tế bào bạch cầu. Bệnh macroglobulin máu Waldenstrom được coi là một loại ung thư hạch không Hodgkin. Nó đôi khi được gọi là ung thư', n.prognosis = 'Thời gian sống sót trung bình là khoảng 5 năm. Có người sống được hơn 10 năm. Ở một số người, chứng rối loạn này có thể gây ra ít triệu chứng và tiến triển chậm.', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Nếu bạn có các triệu chứng của hội chứng tăng độ nhớt, hãy tìm kiếm sự chăm sóc y tế khẩn cấp ngay lập tức';
MERGE (n:Disease {id: 'D3185'}) SET n.id = 'D3185', n.name = 'Đi bộ bất thường', n.name_en = 'Walking abnormalities', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003199.htm', n.when_to_see = 'Nếu có bất kỳ dấu hiệu bất thường nào về dáng đi không thể kiểm soát và không giải thích được, hãy liên hệ với nhà cung cấp của bạn.';
MERGE (n:Disease {id: 'D3186'}) SET n.id = 'D3186', n.name = 'Ngộ độc thuốc tẩy mụn cóc', n.name_en = 'Wart remover poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002593.htm', n.prognosis = 'Tình trạng của một người khỏe mạnh như thế nào tùy thuộc vào lượng chất độc đi vào máu và tốc độ điều trị được tiếp nhận nhanh như thế nào. Mọi người có thể hồi phục nếu tác dụng của chất độc có thể đ';
MERGE (n:Disease {id: 'D3187'}) SET n.id = 'D3187', n.name = 'Mụn cóc', n.name_en = 'Warts', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000885.htm', n.prognosis = 'Thông thường, mụn cóc là những khối u vô hại và tự biến mất trong vòng 2 năm. Mụn cóc quanh móng hoặc lòng bàn chân khó chữa hơn mụn cóc ở những nơi khác. Mụn cóc có thể quay trở lại sau khi điều trị,', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có dấu hiệu nhiễm trùng (vệt đỏ, mủ, tiết dịch hoặc sốt) hoặc chảy máu. Bạn bị chảy máu nhiều từ mụn cóc hoặc chảy máu không ngừng khi bạn ấn nhẹ.';
MERGE (n:Disease {id: 'D3188'}) SET n.id = 'D3188', n.name = 'Ong bắp cày', n.name_en = 'Wasp sting', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002857.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào mức độ dị ứng của họ với vết đốt của côn trùng và tốc độ họ được điều trị. Họ nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Khả năng ';
MERGE (n:Disease {id: 'D3189'}) SET n.id = 'D3189', n.name = 'Sơn màu nước - nuốt', n.name_en = 'Watercolor paints - swallowing', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002748.htm', n.prognosis = 'Có khả năng phục hồi vì sơn màu nước thường được coi là không độc hại. Một người có thể làm tốt như thế nào tùy thuộc vào lượng sơn họ nuốt và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì ';
MERGE (n:Disease {id: 'D3190'}) SET n.id = 'D3190', n.name = 'Hội chứng Waterhouse-Friderichsen', n.name_en = 'Waterhouse-Friderichsen syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000609.htm', n.prognosis = 'WFS có thể gây tử vong trừ khi việc điều trị nhiễm trùng do vi khuẩn được bắt đầu ngay lập tức và dùng thuốc glucocorticoid.';
MERGE (n:Disease {id: 'D3191'}) SET n.id = 'D3191', n.name = 'Chảy nước mắt', n.name_en = 'Watery eyes', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003036.htm', n.when_to_see = 'Rách hiếm khi là trường hợp khẩn cấp. Bạn nên tìm kiếm sự trợ giúp ngay lập tức nếu: Hóa chất dính vào mắt Bạn bị đau nặng, chảy máu hoặc mất thị lực Bạn bị thương nặng ở mắt Ngoài ra, hãy liên hệ với';
MERGE (n:Disease {id: 'D3192'}) SET n.id = 'D3192', n.name = 'Ngộ độc sáp', n.name_en = 'Wax poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002815.htm', n.prognosis = 'Recovery is very likely.';
MERGE (n:Disease {id: 'D3193'}) SET n.id = 'D3193', n.name = 'Điểm yếu', n.name_en = 'Weakness', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003174.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Điểm yếu đột ngột, đặc biệt nếu chỉ ở một khu vực và không xảy ra cùng với các triệu chứng khác, chẳng hạn như sốt Suy yếu đột ngột sau khi bị bệnh';
MERGE (n:Disease {id: 'D3194'}) SET n.id = 'D3194', n.name = 'Màng ngón tay hoặc ngón chân', n.name_en = 'Webbing of the fingers or toes', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003289.htm', n.when_to_see = 'Tình trạng này thường được phát hiện khi sinh khi em bé nằm trong bệnh viện.';
MERGE (n:Disease {id: 'D3195'}) SET n.id = 'D3195', n.name = 'Tăng cân – không chủ ý', n.name_en = 'Weight gain – unintentional', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003084.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng tăng cân sau đây: Táo bón Tăng cân quá mức mà không rõ nguyên nhân Rụng tóc Cảm thấy lạnh thường xuyên hơn trư';
MERGE (n:Disease {id: 'D3196'}) SET n.id = 'D3196', n.name = 'Giảm cân - không chủ ý', n.name_en = 'Weight loss - unintentional', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003107.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn hoặc một thành viên trong gia đình giảm cân nhiều hơn mức được coi là khỏe mạnh so với độ tuổi và chiều cao của họ. Bạn đã sụt hơn 10 pound (4,5 k';
MERGE (n:Disease {id: 'D3197'}) SET n.id = 'D3197', n.name = 'Thăm khám sức khỏe cho trẻ', n.name_en = 'Well-child visits', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001928.htm', n.overview = 'Tại các lần thăm khám sức khỏe cho trẻ, bạn sẽ nhận được thông tin về các chủ đề như: An toàn khi ngủ Các bệnh ở trẻ em Điều gì sẽ xảy ra khi con bạn lớn lên Viết ra các câu hỏi và mối quan tâm của bạ';
MERGE (n:Disease {id: 'D3198'}) SET n.id = 'D3198', n.name = 'Hội chứng Wernicke-Korsakoff', n.name_en = 'Wernicke-Korsakoff syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000771.htm', n.prognosis = 'Nếu không điều trị, hội chứng Wernicke-Korsakoff sẽ ngày càng nặng hơn và có thể đe dọa tính mạng. Với việc điều trị, có thể kiểm soát được các triệu chứng (chẳng hạn như cử động không phối hợp và khó', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn hoặc đến phòng cấp cứu nếu bạn có các triệu chứng của hội chứng Wernicke-Korsakoff hoặc nếu bạn đã được chẩn đoán mắc bệnh này và các tri';
MERGE (n:Disease {id: 'D3199'}) SET n.id = 'D3199', n.name = 'Nhiễm vi rút West Nile', n.name_en = 'West Nile virus infection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007186.htm', n.prognosis = 'Những người bị nhiễm virus West Nile nhẹ sẽ hồi phục tốt sau khi điều trị. Đối với những người bị nhiễm trùng nặng, triển vọng sẽ không chắc chắn hơn. Viêm não hoặc viêm màng não Tây Nile có thể dẫn đ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng nhiễm vi rút West Nile, đặc biệt nếu bạn có thể đã tiếp xúc với muỗi. Nếu bạn bị bệnh nặng, hãy đến phòng cấp ';
MERGE (n:Disease {id: 'D3200'}) SET n.id = 'D3200', n.name = 'Thoái hóa điểm vàng thể ướt', n.name_en = 'Wet macular degeneration', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/wet-macular-degeneration/symptoms-causes/syc-20351107', n.overview = 'Thị lực với sự thoái hóa điểm vàng phát triển, tầm nhìn rõ ràng, điển hình (trái) trở nên mờ. Với tình trạng thoái hóa điểm vàng tiến triển, một điểm mù thường hình thành ở trung tâm thị trường (phải)', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc mắt nếu: Bạn nhận thấy những thay đổi ở thị lực trung tâm của mình. Bạn mất khả năng nhìn thấy chi tiết. Những thay đổi này có thể là dấu hiệu đầu tiên của bệnh thoái hóa đ';
MERGE (n:Disease {id: 'D3201'}) SET n.id = 'D3201', n.name = 'Dị ứng lúa mì', n.name_en = 'Wheat allergy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/wheat-allergy/symptoms-causes/syc-20378897', n.overview = 'là phản ứng dị ứng với thực phẩm có chứa lúa mì. Dị ứng lúa mì có thể được kích hoạt bằng cách ăn những thực phẩm này, hít phải bột mì hoặc tiếp xúc với các sản phẩm có chứa lúa mì. Dị ứng lúa mì phổ ', n.when_to_see = 'Nếu ai đó có dấu hiệu sốc phản vệ, hãy gọi 911 hoặc số khẩn cấp tại địa phương của bạn. Sốc phản vệ là một cấp cứu y tế cần được chăm sóc ngay lập tức. Nếu bạn nghi ngờ rằng bạn hoặc con bạn bị dị ứng';
MERGE (n:Disease {id: 'D3202'}) SET n.id = 'D3202', n.name = 'Thở khò khè', n.name_en = 'Wheezing', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003070.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu thở khò khè: Xảy ra lần đầu tiên Xảy ra với khó thở đáng kể, da xanh, lú lẫn hoặc thay đổi trạng thái tâm thần Tiếp tục xảy ra mà không g';
MERGE (n:Disease {id: 'D3203'}) SET n.id = 'D3203', n.name = 'Whiplash', n.name_en = 'Whiplash', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/whiplash/symptoms-causes/syc-20378921', n.overview = 'là một chấn thương ở cổ do chuyển động tới lui nhanh và mạnh của cổ, giống như tiếng roi quất. Whiplash thường xảy ra do va chạm xe ô tô từ phía sau. Nhưng đòn roi cũng có thể do tai nạn thể thao, lạm', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị đau cổ hoặc các triệu chứng giật gân khác sau tai nạn ô tô, chấn thương thể thao hoặc chấn thương khác. Điều quan trọng là phải có được chẩn đoá';
MERGE (n:Disease {id: 'D3204'}) SET n.id = 'D3204', n.name = 'Bệnh Whipple', n.name_en = 'Whipple disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000209.htm', n.prognosis = 'Nếu không được điều trị, tình trạng này thường gây tử vong. Điều trị làm giảm triệu chứng và có thể chữa khỏi bệnh.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Đau khớp không biến mất Đau bụng Tiêu chảy Nếu bạn đang được điều trị bệnh Whipple, hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Các triệu chứ';
MERGE (n:Disease {id: 'D3205'}) SET n.id = 'D3205', n.name = 'Nhiễm giun đũa', n.name_en = 'Whipworm infection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001364.htm', n.prognosis = 'Dự kiến ​​sẽ phục hồi hoàn toàn sau khi điều trị.', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế nếu bạn hoặc con bạn bị tiêu chảy ra máu. Ngoài bệnh giun đũa, nhiều bệnh nhiễm trùng và bệnh tật khác cũng có thể gây ra các triệu chứng tương tự.';
MERGE (n:Disease {id: 'D3206'}) SET n.id = 'D3206', n.name = 'Liệu pháp xạ trị toàn bộ vú', n.name_en = 'Whole breast radiation therapy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007691.htm', n.overview = 'Loại bức xạ này được thực hiện bằng máy chụp X-quang cung cấp một vùng bức xạ chính xác đến toàn bộ vú hoặc thành ngực (nếu được thực hiện sau phẫu thuật cắt bỏ vú). Đôi khi, bức xạ cũng sẽ nhắm vào c', n.prognosis = 'Liệu pháp xạ trị toàn bộ vú sau phẫu thuật bảo tồn vú giúp giảm nguy cơ ung thư tái phát và giảm nguy cơ tử vong do ung thư vú.';
MERGE (n:Disease {id: 'D3207'}) SET n.id = 'D3207', n.name = 'Răng có khoảng cách rộng', n.name_en = 'Widely spaced teeth', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003063.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Răng hoặc hàm của con bạn dường như đang phát triển bất thường Các triệu chứng sức khỏe khác đi kèm với sự xuất hiện của răng có khoảng ';
MERGE (n:Disease {id: 'D3208'}) SET n.id = 'D3208', n.name = 'Hội chứng Williams', n.name_en = 'Williams syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001116.htm', n.prognosis = 'Hầu hết những người mắc hội chứng Williams: Bị thiểu năng trí tuệ. Có thể tuổi thọ bị rút ngắn do các vấn đề y tế khác nhau và các biến chứng có thể xảy ra khác. Yêu cầu người chăm sóc toàn thời gian ', n.when_to_see = 'Nhiều triệu chứng và dấu hiệu của hội chứng Williams có thể không rõ ràng khi mới sinh. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có các đặc điểm tương tự như hội chứng Wi';
MERGE (n:Disease {id: 'D3209'}) SET n.id = 'D3209', n.name = 'Khối u Wilms', n.name_en = 'Wilms tumor', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/wilms-tumor/symptoms-causes/syc-20352655 | https://medlineplus.gov/ency/article/001575.htm', n.overview = 'trẻ em. Thận là một phần của hệ thống tiết niệu, giúp loại bỏ chất thải ra khỏi cơ thể qua nước tiểu. Hệ tiết niệu còn bao gồm niệu quản, bàng quang và niệu đạo. Khối u Wilms là một loại ung thư thận ', n.prognosis = 'Trẻ em có khối u chưa lan rộng có tỷ lệ khỏi bệnh là 90% nếu được điều trị thích hợp. Tiên lượng cũng tốt hơn ở trẻ dưới 2 tuổi.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu: Bạn phát hiện thấy một khối u ở bụng con mình, có máu trong nước tiểu hoặc các triệu chứng khác của WT. Con bạn đang được điều t';
MERGE (n:Disease {id: 'D3210'}) SET n.id = 'D3210', n.name = 'Bệnh Wilson', n.name_en = 'Wilson disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000785.htm', n.prognosis = 'Cần điều trị suốt đời để kiểm soát bệnh Wilson. Bệnh có thể gây ra những hậu quả nghiêm trọng như mất chức năng gan. Đồng có thể có tác dụng độc hại đối với hệ thần kinh. Trong trường hợp bệnh không g', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh Wilson. Hãy liên hệ với chuyên gia tư vấn di truyền nếu bạn có tiền sử bệnh Wilson trong gia đình và bạn đang có ý định';
MERGE (n:Disease {id: 'D3211'}) SET n.id = 'D3211', n.name = 'Ngộ độc chất tẩy rửa cửa sổ', n.name_en = 'Window cleaner poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002750.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào thành phần của chất tẩy rửa cửa sổ mà họ nuốt, lượng nuốt và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao.';
MERGE (n:Disease {id: 'D3212'}) SET n.id = 'D3212', n.name = 'Nước rửa kính chắn gió', n.name_en = 'Windshield washer fluid', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002803.htm', n.prognosis = 'Metanol, thành phần chính trong nước rửa kính chắn gió, cực kỳ độc. Chỉ cần 2 muỗng canh (30 ml) có thể gây tử vong cho trẻ. Khoảng 2 đến 8 ounce (60 đến 240 ml) có thể gây tử vong cho người lớn. Mù l';
MERGE (n:Disease {id: 'D3213'}) SET n.id = 'D3213', n.name = 'Rượu và sức khỏe tim mạch', n.name_en = 'Wine and heart health', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001963.htm', n.overview = 'Có một ranh giới mong manh giữa uống rượu lành mạnh và uống rượu có nguy cơ. Đừng bắt đầu uống rượu hoặc uống rượu thường xuyên hơn chỉ để giảm nguy cơ mắc bệnh tim. Uống nhiều rượu có thể gây hại cho';
MERGE (n:Disease {id: 'D3214'}) SET n.id = 'D3214', n.name = 'Hội chứng Wolff-Parkinson-White (WPW)', n.name_en = 'Wolff-Parkinson-White (WPW) syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/wolff-parkinson-white-syndrome/symptoms-causes/syc-20354626', n.overview = 'Hội chứng ff-Parkinson-White (WPW), một đường dẫn điện bổ sung giữa các buồng trên và buồng dưới của tim gây ra nhịp tim nhanh. Hội chứng Wolff-Parkinson-White (WPW) là một bệnh về tim xuất hiện khi m', n.when_to_see = 'Nhiều thứ có thể khiến nhịp tim nhanh. Điều quan trọng là phải được chẩn đoán và chăm sóc kịp thời. Đôi khi nhịp tim nhanh không phải là vấn đề đáng lo ngại. Ví dụ, tốc độ nhịp tim có thể tăng lên khi';
MERGE (n:Disease {id: 'D3215'}) SET n.id = 'D3215', n.name = 'Sức khỏe phụ nữ', n.name_en = 'Women\'s health', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007458.htm', n.overview = 'bao gồm nhiều chuyên khoa và lĩnh vực trọng tâm, chẳng hạn như: Kiểm soát sinh sản, các bệnh lây truyền qua đường tình dục (STIs) và phụ khoa Ung thư vú, ung thư buồng trứng và các bệnh ung thư nữ khá';
MERGE (n:Disease {id: 'D3216'}) SET n.id = 'D3216', n.name = 'Ngộ độc vết gỗ', n.name_en = 'Wood stain poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002825.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng vết gỗ được nuốt vào và tốc độ xử lý. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải những chất độc như vậy có thể gây ảnh hưởng nghiêm ';
MERGE (n:Disease {id: 'D3217'}) SET n.id = 'D3217', n.name = 'Nếp nhăn', n.name_en = 'Wrinkles', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/wrinkles/symptoms-causes/syc-20354927 | https://medlineplus.gov/ency/article/003252.htm', n.overview = '. Da ở những vùng này trở nên mỏng hơn, khô hơn và kém đàn hồi hơn. Nếp nhăn là một phần tự nhiên của quá trình lão hóa. Những đường và nếp nhăn này có nhiều khả năng hình thành trên vùng da thường xu', n.when_to_see = 'Nếp nhăn thường không phải là nguyên nhân gây lo ngại trừ khi chúng xuất hiện ở độ tuổi sớm. Nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn cho rằng làn da của mình đang nhăn nh';
MERGE (n:Disease {id: 'D3218'}) SET n.id = 'D3218', n.name = 'Nội soi khớp cổ tay', n.name_en = 'Wrist arthroscopy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007585.htm', n.overview = 'Bạn có thể được gây mê toàn thân trước cuộc phẫu thuật này. Điều này có nghĩa là bạn sẽ ngủ và không thể cảm thấy đau. Hoặc, bạn sẽ được gây tê vùng. Điều này có nghĩa là vùng cánh tay và cổ tay của b', n.prognosis = 'Nội soi khớp sử dụng những vết cắt nhỏ trên da, vì vậy so với phẫu thuật mở, bạn có thể: Ít đau và cứng khớp hơn trong quá trình hồi phục Ít biến chứng Phục hồi nhanh hơn Các vết cắt nhỏ sẽ lành nhanh';
MERGE (n:Disease {id: 'D3219'}) SET n.id = 'D3219', n.name = 'Đau cổ tay', n.name_en = 'Wrist pain', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/wrist-pain/symptoms-causes/syc-20366213 | https://medlineplus.gov/ency/article/003175.htm', n.overview = 'thường do bong gân hoặc gãy xương do chấn thương bất ngờ. Nhưng đau cổ tay cũng có thể là kết quả của các vấn đề lâu dài, chẳng hạn như căng thẳng lặp đi lặp lại, viêm khớp và hội chứng ống cổ tay. Bở', n.when_to_see = 'Không phải mọi cơn đau cổ tay đều cần được chăm sóc y tế. Bong gân và căng cơ nhẹ thường đáp ứng với thuốc chườm đá, nghỉ ngơi và giảm đau mà bạn có thể mua mà không cần đơn thuốc. Nhưng nếu cơn đau v';
MERGE (n:Disease {id: 'D3220'}) SET n.id = 'D3220', n.name = 'Agammaglobulinemia liên kết X', n.name_en = 'X-linked agammaglobulinemia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/x-linked-agammaglobulinemia/symptoms-causes/syc-20361635', n.overview = '(a-gam-uh-glob-u-lih-NEE-me-uh), còn được gọi là XLA, là một chứng rối loạn hệ thống miễn dịch được truyền qua các gia đình, được gọi là di truyền. XLA khiến việc chống nhiễm trùng trở nên khó khăn. N';
MERGE (n:Disease {id: 'D3221'}) SET n.id = 'D3221', n.name = 'Xanthoma', n.name_en = 'Xanthoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001447.htm', n.prognosis = 'Sự phát triển này không phải là ung thư và không gây đau đớn, nhưng nó có thể là dấu hiệu của một tình trạng bệnh lý khác.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu xanthomas phát triển. Chúng có thể chỉ ra một rối loạn tiềm ẩn cần được điều trị.';
MERGE (n:Disease {id: 'D3222'}) SET n.id = 'D3222', n.name = 'Xeroderma sắc tố', n.name_en = 'Xeroderma pigmentosum', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001467.htm', n.prognosis = 'Hơn một nửa số người mắc bệnh này chết vì ung thư da sớm ở tuổi trưởng thành.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn để lấy hẹn nếu bạn hoặc con bạn có các triệu chứng của XP.';
MERGE (n:Disease {id: 'D3223'}) SET n.id = 'D3223', n.name = 'Ngáp - quá mức', n.name_en = 'Yawning - excessive', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003096.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn bị bệnh không rõ nguyên nhân và quá mức ngáp. Ngáp có liên quan đến việc rất buồn ngủ vào ban ngày.';
MERGE (n:Disease {id: 'D3224'}) SET n.id = 'D3224', n.name = 'Yaws', n.name_en = 'Yaws', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001341.htm', n.prognosis = 'Nếu được điều trị ở giai đoạn đầu, bệnh ghẻ cóc có thể được chữa khỏi. Tổn thương da có thể mất vài tháng mới lành. Ở giai đoạn muộn, bệnh ghẻ cóc có thể đã gây tổn thương cho da và xương. Nó có thể k', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn hoặc con bạn có vết loét trên da hoặc xương không biến mất. Bạn đã từng ở những vùng nhiệt đới, nơi được biết là hay xảy ra hiện';
MERGE (n:Disease {id: 'D3225'}) SET n.id = 'D3225', n.name = 'Nhiễm nấm men (âm đạo)', n.name_en = 'Yeast infection (vaginal)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/yeast-infection/symptoms-causes/syc-20378999', n.overview = 'Nhiễm nấm âm đạo là một bệnh nhiễm nấm. Nó gây kích ứng, tiết dịch và ngứa ở âm đạo và âm hộ. Nhiễm nấm âm đạo còn được gọi là bệnh nấm candida âm đạo. Nhiễm nấm âm đạo ảnh hưởng đến hầu hết mọi người', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu: Đây là lần đầu tiên bạn có các triệu chứng nhiễm trùng nấm men. Bạn không chắc liệu mình có bị nhiễm trùng nấm men hay không. Các triệu chứng của ';
MERGE (n:Disease {id: 'D3226'}) SET n.id = 'D3226', n.name = 'Sốt vàng da', n.name_en = 'Yellow fever', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001365.htm', n.prognosis = 'Sốt vàng da có thể gây ra các vấn đề nghiêm trọng, bao gồm cả chảy máu trong. Cái chết là có thể.', n.when_to_see = 'Hãy báo ngay cho nhà cung cấp dịch vụ của bạn nếu bạn hoặc con bạn bị sốt, nhức đầu, đau cơ, nôn mửa hoặc vàng da, đặc biệt nếu bạn đã đi đến khu vực thường xuyên bị sốt vàng da.';
MERGE (n:Disease {id: 'D3227'}) SET n.id = 'D3227', n.name = 'Ngộ độc thủy tùng', n.name_en = 'Yew poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002877.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào mức độ chất độc bị nuốt phải và việc điều trị được thực hiện nhanh chóng như thế nào. Bạn nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Các tri';
MERGE (n:Disease {id: 'D3228'}) SET n.id = 'D3228', n.name = 'Yips', n.name_en = 'Yips', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/yips/symptoms-causes/syc-20379021', n.overview = 'Yips là tình trạng co thắt cổ tay không chủ ý xảy ra phổ biến nhất khi người chơi golf đang cố gắng đẩy bóng. Tuy nhiên, yip cũng có thể ảnh hưởng đến những người chơi các môn thể thao khác - chẳng hạ';
MERGE (n:Disease {id: 'D3229'}) SET n.id = 'D3229', n.name = 'Con bạn và bệnh cúm', n.name_en = 'Your baby and the flu', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007444.htm', n.overview = 'CÁC TRIỆU CHỨNG CÚM Ở TRẺ SƠ SINH VÀ TRẺ EM TRẺ EM Cúm là một bệnh nhiễm trùng ở mũi, họng và (đôi khi) phổi. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu bạn nhận thấy bất kỳ dấ';
MERGE (n:Disease {id: 'D3230'}) SET n.id = 'D3230', n.name = 'Em bé của bạn trong ống sinh', n.name_en = 'Your baby in the birth canal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002060.htm', n.overview = 'Một số thuật ngữ nhất định được sử dụng để mô tả vị trí và chuyển động của em bé trong ống sinh. TRẠM Thai nhi Trạm thai nhi đề cập đến vị trí của bộ phận hiện diện trong xương chậu của bạn. Phần trìn';
MERGE (n:Disease {id: 'D3231'}) SET n.id = 'D3231', n.name = 'Những vắc xin đầu tiên của con bạn - những điều bạn cần biết', n.name_en = 'Your child\'s first vaccines - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007628.htm', n.overview = 'Các loại vắc xin nêu trong tuyên bố này có thể sẽ được tiêm cùng lúc trong thời thơ ấu và thời thơ ấu. Có Tuyên bố thông tin về vắc xin riêng cho các loại vắc xin khác cũng được khuyến nghị thường xuy';
MERGE (n:Disease {id: 'D3232'}) SET n.id = 'D3232', n.name = 'Túi thừa Zenker', n.name_en = 'Zenker\'s diverticulum', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/zenkers-diverticulum/symptoms-causes/syc-20568839', n.overview = 'một túi hình thành ở phía trên thực quản, như trong hình bên phải. Một thực quản điển hình được hiển thị bên trái. Trong túi thừa Zenker, một khối phồng hoặc túi hình thành ở đầu ống nối cổ họng với d';
MERGE (n:Disease {id: 'D3233'}) SET n.id = 'D3233', n.name = 'Bệnh do vi rút zika', n.name_en = 'Zika virus disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007666.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn phát triển các triệu chứng của bệnh sốt xuất huyết. Hãy cho nhà cung cấp dịch vụ của bạn biết nếu gần đây bạn đã đi du lịch đến khu vực có vi-rút l';
MERGE (n:Disease {id: 'D3234'}) SET n.id = 'D3234', n.name = 'Quá liều oxit kẽm', n.name_en = 'Zinc oxide overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002571.htm', n.prognosis = 'Kẽm oxit không độc lắm nếu ăn phải. Khả năng phục hồi lâu dài là rất có thể. Tuy nhiên, những người tiếp xúc lâu dài với khói kim loại có thể mắc bệnh phổi nghiêm trọng.';
MERGE (n:Disease {id: 'D3235'}) SET n.id = 'D3235', n.name = 'Ngộ độc kẽm', n.name_en = 'Zinc poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002570.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nếu các triệu chứng nhẹ, ngườ';
MERGE (n:Disease {id: 'D3236'}) SET n.id = 'D3236', n.name = 'Hội chứng Zollinger-Ellison', n.name_en = 'Zollinger-Ellison syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/zollinger-ellison-syndrome/symptoms-causes/syc-20379042 | https://medlineplus.gov/ency/article/000325.htm', n.overview = 'Tuyến tụy đàn ông nằm sau dạ dày của bạn. Hội chứng Zollinger-Ellison là tình trạng một hoặc nhiều khối u phát triển ở tuyến tụy hoặc ruột non. Các khối u, được gọi là u tiết gastrin, sản xuất một lượ', n.prognosis = 'Tỷ lệ khỏi bệnh thấp ngay cả khi được phát hiện sớm và cắt bỏ khối u. Tuy nhiên, gastrinomas phát triển chậm. Những người mắc bệnh này có thể sống được nhiều năm sau khi khối u được phát hiện. Thuốc ứ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn bị đau rát, rát ở bụng trên và không biến mất - đặc biệt nếu bạn cũng bị buồn nôn, nôn mửa và tiêu chảy. Hãy cho chuyên gia chăm sóc của bạn biết nếu bạn đ';

