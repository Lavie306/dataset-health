MERGE (n:Disease {id: 'D0930'}) SET n.id = 'D0930', n.name = 'Nghiện ma túy (rối loạn sử dụng chất gây nghiện)', n.name_en = 'Drug addiction (substance use disorder)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/drug-addiction/symptoms-causes/syc-20365112', n.overview = 'Nghiện ma túy, còn gọi là rối loạn sử dụng chất gây nghiện, là một căn bệnh ảnh hưởng đến não và hành vi của một người và dẫn đến việc mất khả năng kiểm soát việc sử dụng một loại thuốc hoặc dược phẩm', n.when_to_see = 'Nếu việc sử dụng ma túy của bạn vượt quá tầm kiểm soát hoặc gây ra vấn đề, hãy nhờ trợ giúp. Bạn tìm kiếm sự giúp đỡ càng sớm thì cơ hội phục hồi lâu dài của bạn càng lớn. Nói chuyện với nhà cung cấp ';
MERGE (n:Disease {id: 'D0931'}) SET n.id = 'D0931', n.name = 'Dị ứng thuốc', n.name_en = 'Drug allergies', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000819.htm', n.prognosis = 'Hầu hết dị ứng thuốc đều đáp ứng với điều trị. Nhưng đôi khi, chúng có thể dẫn đến hen suyễn nặng, sốc phản vệ hoặc tử vong.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn đang dùng thuốc và dường như có phản ứng với thuốc đó. Hãy đến phòng cấp cứu hoặc gọi số khẩn cấp tại địa phương (chẳng hạn như 911) nếu bạn khó thở hoặc x';
MERGE (n:Disease {id: 'D0932'}) SET n.id = 'D0932', n.name = 'Sơ cứu sử dụng ma túy', n.name_en = 'Drug use first aid', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000016.htm', n.when_to_see = 'Các trường hợp khẩn cấp về thuốc không phải lúc nào cũng dễ dàng xác định được. Nếu bạn cho rằng ai đó đã dùng quá liều hoặc nếu bạn cho rằng ai đó đang cai nghiện, hãy sơ cứu và tìm kiếm sự trợ giúp ';
