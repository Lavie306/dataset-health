MERGE (n:Disease {id: 'D1353'}) SET n.id = 'D1353', n.name = 'Tình trạng mất thính giác', n.name_en = 'Hearing loss', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hearing-loss/symptoms-causes/syc-20373072 | https://medlineplus.gov/ency/article/003044.htm', n.overview = 'xảy ra dần dần khi bạn già đi, còn được gọi là chứng lão thị, là tình trạng phổ biến. Hơn một nửa số người ở Hoa Kỳ trên 75 tuổi bị mất thính lực do tuổi tác. Có ba loại mất thính giác: Dẫn truyền, li', n.when_to_see = 'Nếu bạn bị mất thính lực đột ngột, đặc biệt là ở một bên tai, hãy tìm kiếm sự chăm sóc y tế ngay lập tức. Nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khoẻ của bạn nếu việc mất thính giác đang gây';
MERGE (n:Disease {id: 'D1354'}) SET n.id = 'D1354', n.name = 'Mất thính lực - trẻ sơ sinh', n.name_en = 'Hearing loss - infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007322.htm', n.prognosis = 'Thường có thể điều trị mất thính giác do các vấn đề ở tai giữa bằng thuốc hoặc phẫu thuật. Không có cách chữa trị tình trạng mất thính lực do tổn thương tai trong hoặc dây thần kinh. Khả năng nghe của', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu em bé hoặc trẻ nhỏ của bạn có dấu hiệu suy giảm thính lực, chẳng hạn như không phản ứng với tiếng ồn lớn, không tạo ra hoặc bắt chước tiếng động hoặc k';
MERGE (n:Disease {id: 'D1355'}) SET n.id = 'D1355', n.name = 'Dịch vụ tim và mạch máu', n.name_en = 'Heart and vascular services', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007459.htm', n.overview = 'Nhiệm vụ chính của tim là bơm máu giàu oxy đi nuôi cơ thể sau khi bơm máu nghèo oxy đến phổi. Nó thường làm điều này 60 đến 100 lần một phút, 24 giờ một ngày. Tim được tạo thành từ bốn buồng: Tâm nhĩ ';
MERGE (n:Disease {id: 'D1356'}) SET n.id = 'D1356', n.name = 'Rối loạn nhịp tim', n.name_en = 'Heart arrhythmia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/heart-arrhythmia/symptoms-causes/syc-20350668', n.overview = 'Các tế bào nhịp tim điển hình ở nút xoang sẽ gửi tín hiệu điện. Sau đó, tín hiệu đi qua tâm nhĩ đến nút nhĩ thất (AV) rồi đi vào tâm thất, khiến chúng co bóp và bơm máu ra ngoài. Rối loạn nhịp tim (uh', n.when_to_see = 'Nếu bạn cảm thấy tim mình đập quá nhanh hoặc quá chậm hoặc lỡ nhịp, hãy hẹn khám sức khỏe. Bạn có thể được yêu cầu gặp bác sĩ được đào tạo về bệnh tim, được gọi là bác sĩ tim mạch. Nhận chăm sóc y tế ';
MERGE (n:Disease {id: 'D1357'}) SET n.id = 'D1357', n.name = 'Đau tim', n.name_en = 'Heart attack', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/heart-attack/symptoms-causes/syc-20373106 | https://medlineplus.gov/ency/article/000195.htm', n.overview = 'Cơn đau tim xảy ra khi lưu lượng máu đến tim bị giảm hoặc bị chặn nghiêm trọng. Sự tắc nghẽn thường là do sự tích tụ chất béo, cholesterol và các chất khác trong động mạch tim (mạch vành). Các chất bé', n.prognosis = 'Sau một cơn đau tim, bạn có nguy cơ cao bị một cơn đau tim khác. Tình trạng sức khỏe của bạn như thế nào sau cơn đau tim phụ thuộc vào một số yếu tố như: Mức độ tổn thương ở cơ tim và van tim Vị trí t', n.when_to_see = 'Hãy nhận trợ giúp ngay nếu bạn cho rằng mình đang bị đau tim. Thực hiện các bước sau: Gọi trợ giúp y tế khẩn cấp. Nếu bạn cho rằng mình đang bị đau tim, hãy gọi ngay 911 hoặc số khẩn cấp tại địa phươn';
MERGE (n:Disease {id: 'D1358'}) SET n.id = 'D1358', n.name = 'Sơ cứu cơn đau tim', n.name_en = 'Heart attack first aid', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000063.htm', n.when_to_see = 'Hãy gọi 911 hoặc số điện thoại khẩn cấp tại địa phương ngay lập tức nếu người đó: Không trả lời bạn Không thở Bị đau ngực đột ngột hoặc các triệu chứng khác của cơn đau tim';
MERGE (n:Disease {id: 'D1359'}) SET n.id = 'D1359', n.name = 'Khối tim', n.name_en = 'Heart block', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007658.htm', n.prognosis = 'Với việc theo dõi và điều trị thường xuyên, bạn sẽ có thể theo kịp hầu hết các hoạt động thông thường của mình.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn cảm thấy: Chóng mặt Yếu Ngất xỉu Tim đập nhanh Nhịp tim hụt nhịp Đau ngực Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn ';
MERGE (n:Disease {id: 'D1360'}) SET n.id = 'D1360', n.name = 'Phẫu thuật bắc cầu tim', n.name_en = 'Heart bypass surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002946.htm', n.overview = 'Trước khi phẫu thuật, bạn sẽ được gây mê toàn thân. Bạn sẽ ngủ (bất tỉnh) và không bị đau trong quá trình phẫu thuật. Thông thường, khi bạn bất tỉnh, bác sĩ phẫu thuật tim sẽ thực hiện một vết phẫu th', n.prognosis = 'Quá trình phục hồi sau phẫu thuật cần có thời gian. Bạn có thể không thấy được toàn bộ lợi ích của phẫu thuật trong vòng 3 đến 6 tháng. Ở hầu hết những người được phẫu thuật bắc cầu tim, các mảnh ghép';
MERGE (n:Disease {id: 'D1361'}) SET n.id = 'D1361', n.name = 'Phẫu thuật bắc cầu tim - xâm lấn tối thiểu', n.name_en = 'Heart bypass surgery - minimally invasive', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007012.htm', n.overview = 'Để thực hiện phẫu thuật này: Bác sĩ phẫu thuật tim sẽ thực hiện một vết phẫu thuật dài 3 đến 5 inch (8 đến 13 cm) ở phần bên trái của ngực, giữa các xương sườn để đến tim của bạn. Các cơ ở khu vực này', n.prognosis = 'Quá trình phục hồi sau phẫu thuật cần có thời gian và bạn có thể không thấy được toàn bộ lợi ích của phẫu thuật trong vòng 3 đến 6 tháng. Ở hầu hết những người được phẫu thuật bắc cầu tim, các mảnh gh';
MERGE (n:Disease {id: 'D1362'}) SET n.id = 'D1362', n.name = 'Bệnh tim', n.name_en = 'Heart disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/heart-disease/symptoms-causes/syc-20353118', n.overview = 'mô tả một loạt các tình trạng ảnh hưởng đến tim. Bệnh tim bao gồm: Bệnh mạch máu, chẳng hạn như bệnh động mạch vành. Nhịp tim không đều, gọi là rối loạn nhịp tim. Bệnh tim bẩm sinh được gọi là dị tật ', n.when_to_see = 'Nhận trợ giúp y tế khẩn cấp nếu bạn có các triệu chứng bệnh tim này: Đau ngực. Hụt hơi. Ngất xỉu. Luôn gọi 911 hoặc số khẩn cấp tại địa phương nếu bạn cho rằng mình có thể bị đau tim. Nếu bạn nghĩ rằn';
MERGE (n:Disease {id: 'D1363'}) SET n.id = 'D1363', n.name = 'Suy tim', n.name_en = 'Heart failure', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/heart-failure/symptoms-causes/syc-20373142 | https://medlineplus.gov/ency/article/000158.htm', n.overview = 'xảy ra khi cơ tim không bơm máu tốt như bình thường. Khi điều này xảy ra, máu thường ứ lại và chất lỏng có thể tích tụ trong phổi, gây khó thở. Một số tình trạng bệnh tim dần dần khiến tim trở nên quá', n.prognosis = 'Thông thường, bạn có thể kiểm soát bệnh suy tim bằng cách dùng thuốc, thay đổi lối sống và điều trị tình trạng gây ra bệnh. Suy tim có thể đột nhiên trở nên tồi tệ hơn do: Thiếu máu cục bộ (thiếu lưu ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn cho rằng mình có thể có các triệu chứng suy tim. Gọi 911 hoặc trợ giúp y tế khẩn cấp nếu bạn có bất kỳ triệu chứng nào sau đây: Đau ngực. Ngất xỉu hoặc suy';
MERGE (n:Disease {id: 'D1364'}) SET n.id = 'D1364', n.name = 'Suy tim ở trẻ em', n.name_en = 'Heart failure in children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007698.htm', n.prognosis = 'Kết quả lâu dài phụ thuộc vào một số yếu tố. Chúng bao gồm: Những loại khuyết tật tim nào đang tồn tại và liệu chúng có thể được sửa chữa hay không Mức độ nghiêm trọng của bất kỳ tổn thương vĩnh viễn ', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn phát triển: Ho hoặc đờm tăng đột ngột Tăng cân hoặc sưng tấy Đột ngột bú kém hoặc tăng cân kém theo thời gian Điểm yếu Các triệu ';
MERGE (n:Disease {id: 'D1365'}) SET n.id = 'D1365', n.name = 'Tiếng thổi của tim', n.name_en = 'Heart murmurs', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/heart-murmurs/symptoms-causes/syc-20373171 | https://medlineplus.gov/ency/article/003266.htm', n.overview = 'là những âm thanh - chẳng hạn như tiếng vù vù hoặc tiếng vù vù - được tạo ra bởi dòng máu chảy nhanh, giật cục (hỗn loạn) qua tim. Âm thanh có thể được nghe bằng một thiết bị gọi là ống nghe. Nhịp tim', n.when_to_see = 'Hầu hết các tiếng thổi ở tim đều không nghiêm trọng. Nếu bạn lo lắng về tiếng thổi ở tim, hãy hẹn gặp nhà cung cấp dịch vụ chăm sóc chính của bạn. Nhà cung cấp của bạn có thể cho bạn biết nếu cần chăm';
MERGE (n:Disease {id: 'D1366'}) SET n.id = 'D1366', n.name = 'Máy điều hòa nhịp tim', n.name_en = 'Heart pacemaker', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007369.htm', n.overview = 'Máy điều hòa nhịp tim mới hơn chỉ nặng khoảng 1 ounce (28 gram). Hầu hết các máy tạo nhịp tim đều có 2 bộ phận: Máy tạo nhịp tim chứa pin và thông tin để kiểm soát nhịp tim. Dây dẫn là dây nối tim với', n.prognosis = 'Máy tạo nhịp tim có thể giúp giữ nhịp tim và nhịp tim ở mức an toàn cho bạn. Pin của máy điều hòa nhịp tim có tuổi thọ khoảng 6 đến 15 năm. Nhà cung cấp của bạn sẽ kiểm tra pin thường xuyên và thay th';
MERGE (n:Disease {id: 'D1367'}) SET n.id = 'D1367', n.name = 'Tim đập nhanh', n.name_en = 'Heart palpitations', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/heart-palpitations/symptoms-causes/syc-20373196 | https://medlineplus.gov/ency/article/003081.htm', n.overview = '(pal-pih-TAY-shuns) là cảm giác tim đập nhanh, rung rinh hoặc đập thình thịch. Căng thẳng, tập thể dục, dùng thuốc hoặc hiếm khi là tình trạng bệnh lý có thể gây ra chúng. Mặc dù tim đập nhanh có thể ', n.when_to_see = 'Nếu trước đây bạn chưa bao giờ bị tim đập nhanh, hãy đến gặp bác sĩ. Gọi 911 hoặc số khẩn cấp tại địa phương nếu bạn có: Mất tỉnh táo (ý thức) Đau ngực Khó thở Đổ mồ hôi bất thường Chóng mặt hoặc choá';
MERGE (n:Disease {id: 'D1368'}) SET n.id = 'D1368', n.name = 'Ghép tim', n.name_en = 'Heart transplant', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003003.htm', n.overview = 'Việc tìm kiếm một trái tim hiến tặng có thể khó khăn. Trái tim phải được hiến tặng bởi một người đã chết não nhưng vẫn đang được hỗ trợ sự sống. Trái tim của người hiến tặng phải ở trong tình trạng bì', n.prognosis = 'Ghép tim kéo dài sự sống của những người lẽ ra đã chết. Khoảng 90% bệnh nhân ghép tim còn sống sau 1 năm phẫu thuật. Sau 3 năm, hơn 85% bệnh nhân vẫn còn sống sau khi ghép tim. Vấn đề chính, cũng như ';
MERGE (n:Disease {id: 'D1369'}) SET n.id = 'D1369', n.name = 'Bệnh van tim', n.name_en = 'Heart valve disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/heart-valve-disease/symptoms-causes/syc-20353727', n.overview = 'Trong bệnh van tim, một hoặc nhiều van tim không hoạt động bình thường. Có bốn van tim. Chúng giữ cho máu chảy qua tim theo đúng hướng. Đôi khi một van không mở được hoặc không mở hết được. Điều này c', n.when_to_see = 'Nếu bạn có các triệu chứng của bệnh van tim, hãy đặt lịch hẹn để khám sức khỏe. Bạn có thể được giới thiệu đến một bác sĩ được đào tạo về bệnh tim, được gọi là bác sĩ tim mạch. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1370'}) SET n.id = 'D1370', n.name = 'Phẫu thuật van tim', n.name_en = 'Heart valve surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002954.htm', n.overview = 'Trước khi phẫu thuật, bạn sẽ được gây mê toàn thân. Bạn sẽ ngủ và không thể cảm thấy đau. Trong phẫu thuật tim hở, bác sĩ phẫu thuật tim sẽ thực hiện một vết mổ lớn ở xương ức của bạn để đến tim và độ', n.prognosis = 'là cao. Phẫu thuật có thể làm giảm các triệu chứng và kéo dài tuổi thọ của bạn. Van tim cơ học thường không bị hỏng. Tuy nhiên, cục máu đông có thể phát triển trên các van này. Nếu cục máu đông hình t';
MERGE (n:Disease {id: 'D1371'}) SET n.id = 'D1371', n.name = 'Ợ nóng', n.name_en = 'Heartburn', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/heartburn/symptoms-causes/syc-20373223 | https://medlineplus.gov/ency/article/003114.htm', n.overview = 'là cảm giác đau rát ở ngực, ngay sau xương ức. Đôi khi nó đi kèm với vị đắng hoặc axit trong miệng. Cơn đau thường nặng hơn sau khi ăn, vào buổi tối hoặc khi nằm hoặc cúi xuống. Chứng ợ nóng thường xu', n.when_to_see = 'Hãy nhận sự chăm sóc y tế khẩn cấp nếu: Bạn nôn ra chất có máu hoặc trông giống bã cà phê. Phân của bạn có màu đen (như hắc ín) hoặc màu hạt dẻ. Bạn có cảm giác nóng rát và bị ép, nghiền nát hoặc bị á';
MERGE (n:Disease {id: 'D1372'}) SET n.id = 'D1372', n.name = 'Các trường hợp khẩn cấp về nhiệt', n.name_en = 'Heat emergencies', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000056.htm', n.when_to_see = 'Hãy gọi 911 hoặc số khẩn cấp tại địa phương nếu: Người đó bất tỉnh bất cứ lúc nào. Có bất kỳ thay đổi nào khác về mức độ tỉnh táo của người đó (ví dụ: lú lẫn hoặc co giật). Người đó bị sốt trên 102°F ';
MERGE (n:Disease {id: 'D1373'}) SET n.id = 'D1373', n.name = 'Kiệt sức do nhiệt', n.name_en = 'Heat exhaustion', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/heat-exhaustion/symptoms-causes/syc-20373250', n.overview = 'là tình trạng xảy ra khi cơ thể bạn quá nóng. Các triệu chứng có thể bao gồm đổ mồ hôi nhiều và nhịp tim nhanh. Kiệt sức do nhiệt là một trong ba bệnh liên quan đến nhiệt, trong đó chuột rút do nhiệt ', n.when_to_see = 'Nếu bạn cho rằng mình bị kiệt sức vì nóng: Hãy dừng mọi hoạt động và nghỉ ngơi. Di chuyển đến nơi mát mẻ hơn. Uống nước mát hoặc đồ uống thể thao. Liên hệ với bác sĩ nếu các triệu chứng của bạn trở nê';
MERGE (n:Disease {id: 'D1374'}) SET n.id = 'D1374', n.name = 'Không dung nạp nhiệt', n.name_en = 'Heat intolerance', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003094.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn mắc chứng không dung nạp nhiệt không rõ nguyên nhân.';
MERGE (n:Disease {id: 'D1375'}) SET n.id = 'D1375', n.name = 'Phát ban do nhiệt', n.name_en = 'Heat rash', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/heat-rash/symptoms-causes/syc-20373276', n.overview = '— còn được gọi là rôm sảy và miliaria — không chỉ xảy ra ở trẻ sơ sinh. Nó cũng ảnh hưởng đến người lớn, đặc biệt là trong điều kiện nóng ẩm. Phát ban do nhiệt xảy ra khi mồ hôi bị giữ lại trên da. Cá', n.when_to_see = 'Phát ban do nhiệt thường lành bằng cách làm mát da và tránh tiếp xúc với nhiệt độ gây ra. Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn có các triệu chứng kéo dài hơn một';
MERGE (n:Disease {id: 'D1376'}) SET n.id = 'D1376', n.name = 'Say nắng', n.name_en = 'Heatstroke', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/heat-stroke/symptoms-causes/syc-20353581', n.overview = 'là tình trạng do cơ thể quá nóng. Điều này thường xảy ra do tiếp xúc với nhiệt độ cao hoặc hoạt động thể chất ở nhiệt độ cao quá lâu. Có một số giai đoạn tổn thương do nhiệt, trong đó say nắng là nghi', n.when_to_see = 'Nếu bạn cho rằng một người có thể đang bị say nắng, hãy tìm sự trợ giúp y tế ngay lập tức. Gọi 911 hoặc số dịch vụ khẩn cấp tại địa phương của bạn. Thực hiện ngay việc làm mát người bị say nắng trong ';
MERGE (n:Disease {id: 'D1377'}) SET n.id = 'D1377', n.name = 'Chảy máu kinh nguyệt nhiều', n.name_en = 'Heavy menstrual bleeding', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/menorrhagia/symptoms-causes/syc-20352829', n.overview = 'Một số phụ nữ bị chảy máu kinh nhiều hoặc kéo dài hơn một vài ngày. Tình trạng này từng được gọi là rong kinh. Chảy máu kinh nguyệt nặng là một mối quan tâm phổ biến. Nhưng hầu hết phụ nữ không mất má', n.when_to_see = 'Tìm kiếm sự trợ giúp y tế trước kỳ khám theo lịch tiếp theo nếu bạn bị: Chảy máu âm đạo nhiều đến mức làm ướt ít nhất một miếng băng vệ sinh hoặc băng vệ sinh mỗi giờ trong hơn hai giờ liên tục. Chảy ';
MERGE (n:Disease {id: 'D1378'}) SET n.id = 'D1378', n.name = 'Đau gót chân', n.name_en = 'Heel pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003181.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu cơn đau gót chân của bạn không thuyên giảm sau 2 đến 3 tuần điều trị tại nhà. Đồng thời liên hệ với họ nếu: Cơn đau của bạn ngày càng';
MERGE (n:Disease {id: 'D1379'}) SET n.id = 'D1379', n.name = 'Heimlich tự thực hiện thao tác', n.name_en = 'Heimlich maneuver on self', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001983.htm', n.overview = 'Khi bạn bị nghẹn, đường thở của bạn có thể bị tắc nghẽn khiến không có đủ oxy đến phổi. Nếu không có oxy, tổn thương não có thể xảy ra chỉ sau 4 đến 6 phút. Sơ cứu nhanh khi bị nghẹn có thể cứu sống b';
MERGE (n:Disease {id: 'D1380'}) SET n.id = 'D1380', n.name = 'Nhiễm Helicobacter pylori (H. pylori)', n.name_en = 'Helicobacter pylori (H. pylori) infection', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/h-pylori/symptoms-causes/syc-20356171', n.overview = 'Nhiễm Helicobacter pylori là một bệnh nhiễm trùng dạ dày phổ biến. Nguyên nhân là do một loại vi trùng có tên Helicobacter pylori, một loại vi khuẩn còn được gọi là H. pylori. Hơn một nửa số người trê', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị đau dạ dày liên tục hoặc các triệu chứng dạ dày khác. Nhận trợ giúp y tế ngay lập tức nếu: Đau bụng dữ dội, đột ngột hoặc rất dữ dội mà khôn';
MERGE (n:Disease {id: 'D1381'}) SET n.id = 'D1381', n.name = 'Nhiễm Helicobacter pylori', n.name_en = 'Helicobacter pylori infection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007715.htm', n.prognosis = 'Nếu bạn dùng thuốc, rất có thể bệnh nhiễm H pylori sẽ được chữa khỏi. Bạn sẽ ít có khả năng bị loét khác. Đôi khi, H pylori có thể khó chữa khỏi hoàn toàn. Có thể cần phải lặp lại các đợt điều trị khá', n.when_to_see = 'Các triệu chứng nghiêm trọng bắt đầu đột ngột có thể cho thấy tắc nghẽn trong ruột, thủng hoặc xuất huyết, tất cả đều là trường hợp khẩn cấp. Các triệu chứng có thể bao gồm: Phân màu hắc ín, đen hoặc ';
MERGE (n:Disease {id: 'D1382'}) SET n.id = 'D1382', n.name = 'Hội chứng HELLP', n.name_en = 'HELLP syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000890.htm', n.prognosis = 'Kết quả thường tốt nhất nếu vấn đề được chẩn đoán sớm. Việc khám thai định kỳ là rất quan trọng. Bạn cũng nên cho nhà cung cấp dịch vụ của mình biết ngay nếu bạn có các triệu chứng của tình trạng này.', n.when_to_see = 'Nếu các triệu chứng của hội chứng HELLP xảy ra trong thai kỳ: Hãy đến gặp bác sĩ ngay lập tức. Gọi 911 hoặc số khẩn cấp tại địa phương. Đến phòng cấp cứu của bệnh viện hoặc phòng chuyển dạ và sinh nở.';
MERGE (n:Disease {id: 'D1383'}) SET n.id = 'D1383', n.name = 'U nguyên bào mạch máu', n.name_en = 'Hemangioblastoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hemangioblastoma/symptoms-causes/syc-20594491', n.overview = 'U nguyên bào mạch máu là một khối u hiếm gặp, phát triển chậm, bắt đầu trong các tế bào hình thành mạch máu trong não, tủy sống hoặc một phần của mắt. Những khối u này không phải là ung thư, còn được ';
MERGE (n:Disease {id: 'D1384'}) SET n.id = 'D1384', n.name = 'U mạch máu', n.name_en = 'Hemangioma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hemangioma/symptoms-causes/syc-20352334 | https://medlineplus.gov/ency/article/001459.htm', n.overview = 'một nhóm mạch máu dày đặc. Nó thường xuất hiện trên bề mặt da dưới dạng một khối xốp. U máu (he-man-jee-O-muh), còn được gọi là u máu ở trẻ sơ sinh hoặc u máu ở trẻ sơ sinh, là một vết bớt màu đỏ tươi', n.prognosis = 'Các u mạch máu nông nhỏ thường sẽ tự biến mất. Khoảng một nửa biến mất khi 5 tuổi và hầu hết biến mất khi 7 tuổi.', n.when_to_see = 'Nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn sẽ kiểm tra u máu trong các lần khám định kỳ. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khoẻ của con bạn nếu u mạch máu chảy máu, hình thành vết ';
MERGE (n:Disease {id: 'D1385'}) SET n.id = 'D1385', n.name = 'Co thắt nửa mặt', n.name_en = 'Hemifacial spasm', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hemifacial-spasm/symptoms-causes/syc-20373296', n.overview = 'là một tình trạng của hệ thần kinh khiến các cơ ở một bên mặt bị co giật hoặc co thắt. Bạn không thể kiểm soát cơn co thắt nửa mặt. Chúng thường bắt đầu quanh một mắt và có thể lan sang bên đó của khu';
MERGE (n:Disease {id: 'D1386'}) SET n.id = 'D1386', n.name = 'Bệnh nhiễm sắc tố sắt mô', n.name_en = 'Hemochromatosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hemochromatosis/symptoms-causes/syc-20351443 | https://medlineplus.gov/ency/article/000327.htm', n.overview = 'Gan nằm ở phần trên bên phải của bụng, bên dưới cơ hoành và phía trên dạ dày. Hemochromatosis là một loại bệnh quá tải sắt gây ra bởi sự thay đổi gen được truyền lại trong gia đình. Bệnh quá tải sắt l', n.prognosis = 'Nếu không điều trị, tình trạng quá tải sắt có thể dẫn đến tổn thương gan. Sắt bổ sung cũng có thể tích tụ ở các khu vực khác của cơ thể, bao gồm tuyến giáp, tinh hoàn, tuyến tụy, tuyến yên, tim hoặc k', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào của bệnh nhiễm sắc tố sắt mô. Nếu bạn có cha mẹ, anh chị em hoặc con mắc bệnh hemochromatosis, hãy hỏi nhóm chăm sóc sức khỏe của';
MERGE (n:Disease {id: 'D1387'}) SET n.id = 'D1387', n.name = 'Thủ tục tiếp cận phương pháp chạy thận nhân tạo', n.name_en = 'Hemodialysis access procedures', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007641.htm', n.overview = 'Bác sĩ phẫu thuật sẽ đưa đường tiếp cận vào. Có ba loại đường tiếp cận. Lỗ rò: Bác sĩ phẫu thuật nối động mạch và tĩnh mạch dưới da. Đó là lý do tại sao nó được gọi là lỗ rò động mạch-tĩnh mạch hoặc l', n.prognosis = 'Việc quan tâm đến quyền truy cập của bạn sẽ giúp bạn giữ được quyền truy cập đó lâu nhất có thể. So với mảnh ghép, lỗ rò: Có thể tồn tại trong nhiều năm Có lưu lượng máu tốt Ít nguy cơ nhiễm trùng hoặ';
MERGE (n:Disease {id: 'D1388'}) SET n.id = 'D1388', n.name = 'Bệnh huyết sắc tố C', n.name_en = 'Hemoglobin C disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000572.htm', n.prognosis = 'Những người mắc bệnh huyết sắc tố C có thể có một cuộc sống bình thường.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của bệnh hemoglobin C.';
MERGE (n:Disease {id: 'D1389'}) SET n.id = 'D1389', n.name = 'Tan máu', n.name_en = 'Hemolysis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002372.htm', n.overview = 'Hồng cầu thường sống được từ 110 đến 120 ngày. Sau đó, chúng bị phân hủy một cách tự nhiên và thường bị lá lách loại bỏ khỏi hệ tuần hoàn. Một số bệnh và quá trình khiến hồng cầu bị phá vỡ quá sớm. Đi';
MERGE (n:Disease {id: 'D1390'}) SET n.id = 'D1390', n.name = 'Thiếu máu tán huyết', n.name_en = 'Hemolytic anemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000571.htm', n.prognosis = 'Kết quả phụ thuộc vào loại và nguyên nhân gây thiếu máu tán huyết. Thiếu máu trầm trọng có thể làm cho bệnh tim, bệnh phổi hoặc bệnh mạch máu não trở nên nặng hơn.', n.when_to_see = 'Hãy liên hệ với bộ phận chăm sóc sức khỏe của bạn nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn xuất hiện các triệu chứng thiếu máu tán huyết.';
MERGE (n:Disease {id: 'D1391'}) SET n.id = 'D1391', n.name = 'Thiếu máu tán huyết do hóa chất và độc tố', n.name_en = 'Hemolytic anemia caused by chemicals and toxins', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000590.htm';
MERGE (n:Disease {id: 'D1392'}) SET n.id = 'D1392', n.name = 'Khủng hoảng tan máu', n.name_en = 'Hemolytic crisis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003270.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có: Các triệu chứng thiếu máu, bao gồm da nhợt nhạt hoặc mệt mỏi, đặc biệt nếu các triệu chứng này trở nên tồi tệ hơn Nước tiểu có mà';
MERGE (n:Disease {id: 'D1393'}) SET n.id = 'D1393', n.name = 'Bệnh tan máu ở trẻ sơ sinh', n.name_en = 'Hemolytic disease of the newborn', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001298.htm', n.prognosis = 'Mức độ nghiêm trọng của tình trạng này có thể khác nhau. Một số bé không có triệu chứng. Trong những trường hợp khác, các vấn đề như thủy dịch có thể khiến em bé chết trước hoặc ngay sau khi sinh. HDN';
MERGE (n:Disease {id: 'D1394'}) SET n.id = 'D1394', n.name = 'Phản ứng truyền máu tan máu', n.name_en = 'Hemolytic transfusion reaction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001303.htm', n.prognosis = 'Kết quả phụ thuộc vào mức độ nghiêm trọng của phản ứng. Rối loạn có thể diễn ra mà không có vấn đề gì. Hoặc, nó có thể nghiêm trọng và đe dọa tính mạng.', n.when_to_see = 'Hãy cho nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn biết nếu bạn đang được truyền máu và trước đây bạn đã từng bị phản ứng.';
MERGE (n:Disease {id: 'D1395'}) SET n.id = 'D1395', n.name = 'Hội chứng tăng ure huyết tán huyết (HUS)', n.name_en = 'Hemolytic uremic syndrome (HUS)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hemolytic-uremic-syndrome/symptoms-causes/syc-20352399', n.overview = 'Hội chứng tăng ure huyết tán huyết, còn gọi là HUS, là tình trạng có thể xảy ra khi các mạch máu nhỏ bị tổn thương và viêm. Thiệt hại này có thể khiến cục máu đông hình thành trong các mạch khắp cơ th', n.when_to_see = 'Hãy gặp thành viên trong nhóm chăm sóc sức khỏe của bạn ngay lập tức nếu bạn hoặc con bạn bị tiêu chảy ra máu hoặc tiêu chảy vài ngày sau đó: Đi tiểu ít hơn. Sưng tấy. Bầm tím. Chảy máu bất thường. Mệ';
MERGE (n:Disease {id: 'D1396'}) SET n.id = 'D1396', n.name = 'Hội chứng tan máu-ure huyết', n.name_en = 'Hemolytic-uremic syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000510.htm', n.prognosis = 'Đây là một căn bệnh nghiêm trọng ở cả trẻ em và người lớn và có thể gây tử vong. Nếu được điều trị thích hợp, hơn một nửa số người sẽ hồi phục. Kết quả ở trẻ em tốt hơn người lớn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn xuất hiện các triệu chứng của HUS. Các triệu chứng khẩn cấp bao gồm: Máu trong phân Không đi tiểu Giảm sự tỉnh táo (ý thức) Liên hệ với nhà cung cấp dịch v';
MERGE (n:Disease {id: 'D1397'}) SET n.id = 'D1397', n.name = 'Hemophilia', n.name_en = 'Hemophilia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hemophilia/symptoms-causes/syc-20373327 | https://medlineplus.gov/ency/article/000537.htm', n.overview = 'là một chứng rối loạn hiếm gặp trong đó máu không đông lại theo cách thông thường vì không có đủ protein đông máu (yếu tố đông máu). Nếu bạn mắc bệnh máu khó đông, bạn có thể bị chảy máu trong thời gi', n.prognosis = 'Hầu hết những người mắc bệnh máu khó đông đều có thể sinh hoạt bình thường. Nhưng một số người bị chảy máu vào khớp, điều này có thể hạn chế hoạt động của họ. Một số ít người mắc bệnh máu khó đông có ', n.when_to_see = 'Tìm kiếm sự chăm sóc khẩn cấp nếu bạn hoặc con bạn có: Các dấu hiệu hoặc triệu chứng chảy máu vào não Chấn thương trong đó chảy máu không ngừng Các khớp bị sưng, nóng khi chạm vào và đau khi cúi xuống';
MERGE (n:Disease {id: 'D1398'}) SET n.id = 'D1398', n.name = 'Hemophilia A', n.name_en = 'Hemophilia A', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000538.htm', n.prognosis = 'Với việc điều trị, hầu hết những người mắc bệnh máu khó đông A đều có thể có một cuộc sống khá bình thường. Nếu bạn mắc bệnh máu khó đông A, bạn nên kiểm tra thường xuyên với bác sĩ huyết học.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Các triệu chứng rối loạn chảy máu phát triển Một thành viên trong gia đình đã được chẩn đoán mắc bệnh máu khó đông A Bạn mắc bệnh máu khó đông A và bạ';
MERGE (n:Disease {id: 'D1399'}) SET n.id = 'D1399', n.name = 'Hemophilia B', n.name_en = 'Hemophilia B', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000539.htm', n.prognosis = 'Với việc điều trị, hầu hết những người mắc bệnh máu khó đông B đều có thể có một cuộc sống khá bình thường. Nếu bạn mắc bệnh máu khó đông B, bạn nên kiểm tra thường xuyên với bác sĩ huyết học.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Các triệu chứng rối loạn chảy máu phát triển Một thành viên trong gia đình đã được chẩn đoán mắc bệnh máu khó đông B Nếu bạn mắc bệnh máu khó đông B v';
MERGE (n:Disease {id: 'D1400'}) SET n.id = 'D1400', n.name = 'Phẫu thuật bệnh trĩ', n.name_en = 'Hemorrhoid surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002939.htm', n.overview = 'có thể được thực hiện tại phòng khám của bác sĩ phẫu thuật hoặc trong phòng phẫu thuật của bệnh viện. Trong hầu hết các trường hợp, bạn có thể về nhà ngay trong ngày. Loại phẫu thuật bạn thực hiện sẽ ', n.prognosis = 'Bạn sẽ hồi phục hoàn toàn sau vài tuần, tùy thuộc vào mức độ liên quan của cuộc phẫu thuật. Bạn sẽ cần tiếp tục thay đổi chế độ ăn uống và lối sống để giúp ngăn ngừa bệnh trĩ quay trở lại.';
MERGE (n:Disease {id: 'D1401'}) SET n.id = 'D1401', n.name = 'Bệnh trĩ', n.name_en = 'Hemorrhoids', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hemorrhoids/symptoms-causes/syc-20360268 | https://medlineplus.gov/ency/article/000292.htm', n.overview = 'Bệnh trĩ cuối thường không đau nhưng có xu hướng chảy máu. Bệnh trĩ ngoại có thể gây đau. Bệnh trĩ (HEM-uh-roids), còn được gọi là cọc, là các tĩnh mạch bị sưng ở hậu môn và trực tràng dưới. Bệnh trĩ ', n.when_to_see = 'Nếu bạn bị chảy máu khi đi tiêu hoặc bị bệnh trĩ không cải thiện sau một tuần chăm sóc tại nhà, hãy nói chuyện với chuyên gia chăm sóc sức khỏe. Đừng cho rằng chảy máu trực tràng là do bệnh trĩ, đặc b';
MERGE (n:Disease {id: 'D1402'}) SET n.id = 'D1402', n.name = 'Tràn máu màng phổi', n.name_en = 'Hemothorax', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000126.htm', n.prognosis = 'Kết quả phụ thuộc vào nguyên nhân tràn máu màng phổi, lượng máu mất và tốc độ điều trị. Trong trường hợp chấn thương nặng, kết quả còn phụ thuộc vào mức độ nghiêm trọng của vết thương và tốc độ chảy m', n.when_to_see = 'Hãy gọi 911 hoặc số cấp cứu tại địa phương nếu bạn có: Bất kỳ chấn thương nghiêm trọng nào ở ngực Đau ngực Đau hàm, cổ, vai hoặc cánh tay nghiêm trọng Khó thở hoặc hụt hơi Đi đến phòng cấp cứu hoặc gọ';
MERGE (n:Disease {id: 'D1403'}) SET n.id = 'D1403', n.name = 'Ban xuất huyết Henoch-Schonlein', n.name_en = 'Henoch-Schonlein purpura', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/henoch-schonlein-purpura/symptoms-causes/syc-20354040', n.overview = 'khiến các mạch máu nhỏ ở da, khớp, ruột và thận bị viêm và chảy máu. Tình trạng này còn được gọi là viêm mạch máu IgA. Triệu chứng dễ nhận thấy nhất của dạng viêm mạch này là phát ban thường xuất hiện', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn bị phát ban mà bạn nghĩ có thể là ban xuất huyết Henoch-Schonlein, đồng thời bạn cũng bị đau bụng nghiêm trọng, buồn nôn, nôn mửa hoặc phân có máu. Nếu con';
MERGE (n:Disease {id: 'D1404'}) SET n.id = 'D1404', n.name = 'Bệnh não gan', n.name_en = 'Hepatic encephalopathy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hepatic-encephalopathy/symptoms-causes/syc-20583828', n.overview = '(huh-PAT-ik en-sef-uh-LOP-uh-thee) là một tình trạng nghiêm trọng xảy ra khi gan không thể lọc chất độc ra khỏi máu, bao gồm cả amoniac từ ruột. Sự tích tụ chất độc ảnh hưởng đến khả năng hoạt động củ', n.when_to_see = 'Nếu bạn hoặc người mắc bệnh gan đột nhiên lú lẫn, không thể thức dậy hoặc có biểu hiện hành vi bất thường, hãy gọi cho chuyên gia chăm sóc sức khỏe của bạn hoặc đến phòng cấp cứu của bệnh viện ngay lậ';
MERGE (n:Disease {id: 'D1405'}) SET n.id = 'D1405', n.name = 'U mạch máu gan', n.name_en = 'Hepatic hemangioma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000243.htm', n.prognosis = 'Phẫu thuật có thể chữa khỏi khối u ở trẻ sơ sinh nếu nó chỉ ở một thùy gan. Điều này có thể được thực hiện ngay cả khi trẻ bị suy tim.';
MERGE (n:Disease {id: 'D1406'}) SET n.id = 'D1406', n.name = 'Thiếu máu cục bộ ở gan', n.name_en = 'Hepatic ischemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000214.htm', n.prognosis = 'Mọi người thường hồi phục nếu căn bệnh gây thiếu máu cục bộ ở gan có thể được điều trị. Tử vong do suy gan do thiếu máu cục bộ gan là rất hiếm.', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị suy nhược dai dẳng hoặc có các triệu chứng sốc hoặc mất nước.';
MERGE (n:Disease {id: 'D1407'}) SET n.id = 'D1407', n.name = 'Tắc nghẽn tĩnh mạch gan (Budd-Chiari)', n.name_en = 'Hepatic vein obstruction (Budd-Chiari)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000239.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có các triệu chứng tắc nghẽn tĩnh mạch gan Bạn đang được điều trị tình trạng này và bạn xuất hiện các triệu chứng mới';
MERGE (n:Disease {id: 'D1408'}) SET n.id = 'D1408', n.name = 'Viêm gan', n.name_en = 'Hepatitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001154.htm', n.prognosis = 'Triển vọng về bệnh viêm gan sẽ phụ thuộc vào nguyên nhân gây tổn thương gan và mức độ ảnh hưởng nghiêm trọng của bệnh viêm gan đến gan của bạn.', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc ngay lập tức nếu bạn: Có các triệu chứng do sử dụng quá nhiều acetaminophen hoặc các loại thuốc khác. Bạn có thể cần phải bơm dạ dày Nôn ra máu Đi phân có máu hoặc hắc ín Bị n';
MERGE (n:Disease {id: 'D1409'}) SET n.id = 'D1409', n.name = 'Viêm gan A', n.name_en = 'Hepatitis A', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hepatitis-a/symptoms-causes/syc-20367007 | https://medlineplus.gov/ency/article/000278.htm', n.overview = 'là một bệnh nhiễm trùng gan rất dễ lây lan do vi rút viêm gan A gây ra. Virus này là một trong một số loại virus viêm gan gây viêm gan và ảnh hưởng đến khả năng hoạt động của gan. Bạn có nhiều khả năn', n.prognosis = 'Virus không còn tồn tại trong cơ thể sau khi hết nhiễm trùng. Hầu hết những người bị viêm gan A sẽ hồi phục trong vòng 3 tháng. Gần như tất cả mọi người đều khỏe hơn trong vòng 6 tháng. Không có thiệt', n.when_to_see = 'Hẹn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của bệnh viêm gan A. Tiêm vắc-xin viêm gan A hoặc tiêm một loại kháng thể gọi là globulin miễn dịch trong vòng hai tuầ';
MERGE (n:Disease {id: 'D1410'}) SET n.id = 'D1410', n.name = 'Viêm gan A - trẻ em', n.name_en = 'Hepatitis A - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007670.htm', n.prognosis = 'HAV không tồn tại trong cơ thể trẻ sau khi hết nhiễm trùng. Kết quả là nó không gây nhiễm trùng lâu dài ở gan. Hiếm khi, một trường hợp mới có thể gây suy gan nặng và phát triển nhanh chóng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu con bạn có các triệu chứng của bệnh viêm gan A. Đồng thời, hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu con bạn bị:';
MERGE (n:Disease {id: 'D1411'}) SET n.id = 'D1411', n.name = 'Vắc-xin viêm gan A - những điều bạn cần biết', n.name_en = 'Hepatitis A vaccine - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007595.htm', n.overview = '1. Tại sao phải tiêm vắc-xin? Vắc-xin viêm gan A có thể ngăn ngừa viêm gan A. Viêm gan A là một bệnh gan nghiêm trọng. Nó thường lây lan qua tiếp xúc cá nhân, gần gũi với người bị nhiễm bệnh hoặc khi ';
MERGE (n:Disease {id: 'D1412'}) SET n.id = 'D1412', n.name = 'Viêm gan B', n.name_en = 'Hepatitis B', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hepatitis-b/symptoms-causes/syc-20366802 | https://medlineplus.gov/ency/article/000279.htm', n.overview = 'là một bệnh nhiễm trùng gan nghiêm trọng do virus viêm gan B (HBV) gây ra. Đối với hầu hết mọi người, viêm gan B chỉ diễn ra trong thời gian ngắn, còn được gọi là cấp tính. Viêm gan B cấp tính kéo dài', n.prognosis = 'Bệnh cấp tính thường khỏi sau 2 đến 3 tuần. Gan trở lại bình thường trong vòng 4 đến 6 tháng ở hầu hết mọi người. Hầu như tất cả trẻ sơ sinh và khoảng một nửa số trẻ em mắc bệnh viêm gan B đều phát tr', n.when_to_see = 'Nếu bạn biết mình đã tiếp xúc với vi-rút viêm gan B, hãy gọi ngay cho chuyên gia chăm sóc sức khỏe của bạn. Phương pháp điều trị dự phòng có thể làm giảm nguy cơ nhiễm trùng nếu bạn được điều trị tron';
MERGE (n:Disease {id: 'D1413'}) SET n.id = 'D1413', n.name = 'Viêm gan B - trẻ em', n.name_en = 'Hepatitis B - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007671.htm', n.prognosis = 'Nhiều trẻ em có thể loại bỏ HBV khỏi cơ thể và không bị nhiễm trùng lâu dài. However, some children never get rid of HBV. Đây được gọi là nhiễm viêm gan B mãn tính. Trẻ nhỏ dễ bị viêm gan B mãn tính h', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu: Con bạn có các triệu chứng viêm gan B Các triệu chứng viêm gan B không biến mất Các triệu chứng mới phát triển Con bạn thuộc nhó';
MERGE (n:Disease {id: 'D1414'}) SET n.id = 'D1414', n.name = 'Vắc-xin viêm gan B - những điều bạn cần biết', n.name_en = 'Hepatitis B vaccine - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007613.htm', n.overview = 'Tại sao phải tiêm vắc-xin? Vắc-xin viêm gan B có thể ngăn ngừa viêm gan B. Viêm gan B là một bệnh về gan có thể gây bệnh nhẹ kéo dài vài tuần hoặc có thể dẫn đến bệnh nghiêm trọng suốt đời. Viêm gan B';
MERGE (n:Disease {id: 'D1415'}) SET n.id = 'D1415', n.name = 'Viêm gan C', n.name_en = 'Hepatitis C', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hepatitis-c/symptoms-causes/syc-20354278 | https://medlineplus.gov/ency/article/000284.htm', n.overview = 'Gan nằm ở phần trên bên phải của bụng, bên dưới cơ hoành và phía trên dạ dày. Viêm gan C là một bệnh nhiễm virus gây sưng gan, gọi là viêm. Viêm gan C có thể dẫn đến tổn thương gan nghiêm trọng. Virus', n.prognosis = 'Hầu hết mọi người (75% đến 85%) bị nhiễm vi-rút sẽ phát triển thành HCV mạn tính trừ khi họ được điều trị. Tình trạng này có nguy cơ gây xơ gan và ung thư gan. Triển vọng của HCV phụ thuộc một phần và', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Bạn xuất hiện các triệu chứng của bệnh viêm gan Bạn tin rằng mình đã tiếp xúc với HCV';
MERGE (n:Disease {id: 'D1416'}) SET n.id = 'D1416', n.name = 'Viêm gan C - trẻ em', n.name_en = 'Hepatitis C - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007672.htm', n.prognosis = 'Trẻ em dưới 3 tuổi có thể không cần điều trị. Nhiễm trùng ở nhóm tuổi này thường khỏi mà không có bất kỳ biến chứng nào.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có các triệu chứng của bệnh viêm gan C. Bạn cũng nên liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của mình nếu bạn bị v';
MERGE (n:Disease {id: 'D1417'}) SET n.id = 'D1417', n.name = 'Viêm gan D (tác nhân Delta)', n.name_en = 'Hepatitis D (Delta agent)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000216.htm', n.prognosis = 'Những người bị nhiễm HDV cấp tính thường khỏi bệnh sau 2 đến 3 tuần. Nồng độ men gan trở lại bình thường trong vòng 16 tuần. Khoảng 1 trong 10 người bị nhiễm bệnh có thể bị viêm gan lâu dài (mạn tính)', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của viêm gan D.';
MERGE (n:Disease {id: 'D1418'}) SET n.id = 'D1418', n.name = 'Ung thư biểu mô tế bào gan (HCC)', n.name_en = 'Hepatocellular carcinoma (HCC)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hepatocellular-carcinoma/symptoms-causes/syc-20589101', n.overview = 'Ung thư gan dạng ung thư gan phổ biến bắt đầu từ các tế bào gọi là tế bào gan. Loại ung thư này được gọi là ung thư biểu mô tế bào gan. Ung thư biểu mô tế bào gan (HCC) là một loại ung thư bắt đầu từ ', n.when_to_see = 'Đặt lịch hẹn với bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D1419'}) SET n.id = 'D1419', n.name = 'Thoái hóa gan não', n.name_en = 'Hepatocerebral degeneration', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001393.htm', n.prognosis = 'Đây là một tình trạng lâu dài (mãn tính) có thể dẫn đến các triệu chứng thần kinh (thần kinh) vĩnh viễn. Người bệnh có thể tiếp tục trở nên nặng hơn và chết nếu không được ghép gan. Nếu việc cấy ghép ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ triệu chứng nào của bệnh gan.';
MERGE (n:Disease {id: 'D1420'}) SET n.id = 'D1420', n.name = 'Hội chứng gan phổi', n.name_en = 'Hepatopulmonary syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hepatopulmonary-syndrome/symptoms-causes/syc-20373350', n.overview = 'Hội chứng gan phổi (hep-uh-toe-POOL-moe-nar-e) là do các mạch máu trong phổi giãn nở, còn gọi là giãn nở và tăng số lượng. Tình trạng này ảnh hưởng đến phổi của những người mắc bệnh gan tiến triển. Nh';
MERGE (n:Disease {id: 'D1421'}) SET n.id = 'D1421', n.name = 'Hội chứng gan thận', n.name_en = 'Hepatorenal syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000489.htm', n.prognosis = 'Kết quả thường kém. Tử vong thường xảy ra do nhiễm trùng hoặc chảy máu nghiêm trọng (xuất huyết).', n.when_to_see = 'Rối loạn này thường được chẩn đoán tại bệnh viện trong quá trình điều trị rối loạn gan.';
MERGE (n:Disease {id: 'D1422'}) SET n.id = 'D1422', n.name = 'Bệnh amyloidosis di truyền', n.name_en = 'Hereditary amyloidosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000368.htm';
MERGE (n:Disease {id: 'D1423'}) SET n.id = 'D1423', n.name = 'Phù mạch di truyền', n.name_en = 'Hereditary angioedema', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001456.htm', n.prognosis = 'HAE có thể đe dọa tính mạng và mặc dù có các phương pháp điều trị mới, sưng tấy đường thở vẫn có thể dẫn đến tử vong. Một người khỏe mạnh như thế nào phụ thuộc vào các triệu chứng cụ thể.', n.when_to_see = 'Hãy liên hệ hoặc đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn đang cân nhắc việc có con và có tiền sử gia đình mắc bệnh này. Cũng hãy gọi nếu bạn có các triệu chứng của HAE. Sưng đườ';
MERGE (n:Disease {id: 'D1424'}) SET n.id = 'D1424', n.name = 'Chứng tăng bạch cầu hình elip di truyền', n.name_en = 'Hereditary elliptocytosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000563.htm', n.prognosis = 'Hầu hết những người mắc bệnh elliptocytosis di truyền đều không có vấn đề gì. Họ thường không biết mình mắc bệnh này.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị vàng da không khỏi hoặc có triệu chứng thiếu máu hoặc sỏi mật.';
MERGE (n:Disease {id: 'D1425'}) SET n.id = 'D1425', n.name = 'Không dung nạp fructose di truyền', n.name_en = 'Hereditary fructose intolerance', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000359.htm', n.prognosis = 'Chứng không dung nạp fructose di truyền có thể nhẹ hoặc nặng. Việc tránh dùng fructose và sucrose sẽ giúp ích cho hầu hết trẻ em mắc bệnh này. Tiên lượng tốt trong hầu hết các trường hợp. Một số trẻ m', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn xuất hiện các triệu chứng của tình trạng này sau khi bắt đầu bú. Nếu con bạn mắc phải tình trạng này, các chuyên gia khuyên b';
MERGE (n:Disease {id: 'D1426'}) SET n.id = 'D1426', n.name = 'Giãn mao mạch xuất huyết di truyền', n.name_en = 'Hereditary hemorrhagic telangiectasia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hht/symptoms-causes/syc-20351135 | https://medlineplus.gov/ency/article/000837.htm', n.overview = '(tuh-lan-jee-uk-TAY-zhuh) là một bệnh di truyền trong gia đình, gọi là di truyền. Nó gây ra các liên kết không điển hình giữa động mạch và tĩnh mạch được gọi là dị tật động tĩnh mạch (AVM). Các vị trí', n.prognosis = 'Những người mắc hội chứng này có thể có tuổi thọ hoàn toàn bình thường, tùy thuộc vào vị trí của AVM trong cơ thể.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc con bạn bị chảy máu mũi thường xuyên hoặc có các dấu hiệu khác của bệnh này.';
MERGE (n:Disease {id: 'D1427'}) SET n.id = 'D1427', n.name = 'Bệnh bạch cầu trứng di truyền', n.name_en = 'Hereditary ovalocytosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000566.htm';
MERGE (n:Disease {id: 'D1428'}) SET n.id = 'D1428', n.name = 'Thiếu máu hồng cầu hình cầu di truyền', n.name_en = 'Hereditary spherocytic anemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000530.htm', n.prognosis = 'Kết quả điều trị thường tốt. Sau khi cắt bỏ lá lách, tuổi thọ của hồng cầu sẽ trở lại bình thường.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Các triệu chứng của bạn trở nên tồi tệ hơn. Các triệu chứng của bạn không cải thiện khi điều trị mới. Bạn phát triển các triệu chứng mới.';
MERGE (n:Disease {id: 'D1429'}) SET n.id = 'D1429', n.name = 'Chu kỳ urê di truyền bất thường', n.name_en = 'Hereditary urea cycle abnormality', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000372.htm', n.prognosis = 'Mọi người khỏe mạnh như thế nào phụ thuộc vào: Họ gặp phải bất thường nào trong chu trình urê Mức độ nghiêm trọng Nó được phát hiện sớm như thế nào Họ tuân thủ chế độ ăn hạn chế protein chặt chẽ đến m', n.when_to_see = 'Có sẵn xét nghiệm tiền sản. Xét nghiệm di truyền trước khi phôi được cấy có thể được thực hiện cho những người sử dụng in vitro nếu biết nguyên nhân di truyền cụ thể. Chuyên gia dinh dưỡng đóng vai tr';
MERGE (n:Disease {id: 'D1430'}) SET n.id = 'D1430', n.name = 'Thoát vị', n.name_en = 'Hernia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000960.htm', n.prognosis = 'Kết quả của hầu hết các trường hợp thoát vị thường tốt khi được điều trị. Rất hiếm khi thoát vị quay trở lại. Thoát vị vết mổ có nhiều khả năng quay trở lại.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn bị: Thoát vị đau đớn và các chất bên trong không thể bị đẩy trở lại vào bụng bằng cách nằm xuống và dùng áp lực nhẹ Buồn nôn, nôn mửa hoặc sốt cùn';
MERGE (n:Disease {id: 'D1431'}) SET n.id = 'D1431', n.name = 'Thoát vị đĩa đệm', n.name_en = 'Herniated disk', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/herniated-disk/symptoms-causes/syc-20354095 | https://medlineplus.gov/ency/article/000442.htm', n.overview = 'Thoát vị đĩa đệm đề cập đến vấn đề xảy ra với một trong các đệm cao su, được gọi là đĩa đệm, nằm giữa các xương xếp chồng lên nhau tạo thành cột sống. Những xương này được gọi là đốt sống. Đĩa đệm cột', n.prognosis = 'Hầu hết mọi người đều cải thiện khi điều trị. Nhưng bạn có thể bị đau lưng lâu dài, ngay cả sau khi điều trị. Có thể mất vài tháng đến một năm hoặc hơn để quay lại tất cả các hoạt động của bạn mà khôn', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế nếu cơn đau cổ hoặc lưng của bạn lan xuống cánh tay hoặc chân hoặc nếu bạn cũng bị tê, ngứa ran hoặc yếu. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu c';
MERGE (n:Disease {id: 'D1432'}) SET n.id = 'D1432', n.name = 'Quá liều heroin', n.name_en = 'Heroin overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002861.htm', n.prognosis = 'Nếu có thể dùng thuốc giải độc, quá trình phục hồi sau quá liều cấp tính sẽ xảy ra trong vòng 24 đến 48 giờ. Heroin thường được trộn lẫn với các chất gọi là chất pha trộn. Những điều này có thể gây ra';
MERGE (n:Disease {id: 'D1433'}) SET n.id = 'D1433', n.name = 'Herpangina', n.name_en = 'Herpangina', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000969.htm', n.prognosis = 'Bệnh thường khỏi trong vòng một tuần.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Sốt, đau họng hoặc lở miệng kéo dài hơn 5 ngày Con bạn gặp khó khăn khi uống nước hoặc có vẻ bị mất nước Sốt trở nên rất cao hoặc không biến mất';
MERGE (n:Disease {id: 'D1434'}) SET n.id = 'D1434', n.name = 'Herpes - miệng', n.name_en = 'Herpes - oral', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000606.htm', n.prognosis = 'Mụn rộp miệng thường tự khỏi sau 1 đến 2 tuần. Tuy nhiên, nó có thể quay trở lại. Nhiễm herpes có thể nghiêm trọng và nguy hiểm nếu: Nó xảy ra trong hoặc gần mắt. Bạn có hệ thống miễn dịch suy yếu do ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Các triệu chứng nghiêm trọng hoặc không biến mất sau 2 tuần Vết loét hoặc mụn nước gần mắt Các triệu chứng của bệnh herpes và hệ thống miễn dịc';
MERGE (n:Disease {id: 'D1435'}) SET n.id = 'D1435', n.name = 'Viêm miệng Herpetic', n.name_en = 'Herpetic stomatitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001383.htm', n.prognosis = 'Con bạn sẽ hồi phục hoàn toàn trong vòng 10 ngày mà không cần điều trị. Acyclovir có thể tăng tốc độ phục hồi của con bạn. Con bạn sẽ mang virus herpes suốt đời. Ở hầu hết mọi người, virus không hoạt ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn bị sốt, sau đó là đau miệng và con bạn bỏ ăn uống. Con bạn có thể nhanh chóng bị mất nước. Nếu nhiễm herpes lây lan sang mắt thì đó là trường h';
MERGE (n:Disease {id: 'D1436'}) SET n.id = 'D1436', n.name = 'Heterochromia', n.name_en = 'Heterochromia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003319.htm', n.when_to_see = 'Hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy những thay đổi mới về màu của một mắt hoặc hai mắt có màu khác nhau ở trẻ sơ sinh. Cần phải khám mắt kỹ lưỡng để loạ';
MERGE (n:Disease {id: 'D1437'}) SET n.id = 'D1437', n.name = 'Thoát vị gián đoạn', n.name_en = 'Hiatal hernia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hiatal-hernia/symptoms-causes/syc-20373379 | https://medlineplus.gov/ency/article/001137.htm', n.overview = 'omach phình qua cơ hoành vào khoang ngực. Thoát vị gián đoạn xảy ra khi phần trên của dạ dày phình ra qua cơ lớn ngăn cách bụng và ngực. Cơ được gọi là cơ hoành. Cơ hoành có một lỗ nhỏ gọi là khe hở. ', n.prognosis = 'Điều trị có thể làm giảm hầu hết các triệu chứng thoát vị gián đoạn.', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng kéo dài nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/c';
MERGE (n:Disease {id: 'D1438'}) SET n.id = 'D1438', n.name = 'Hiccups', n.name_en = 'Hiccups', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hiccups/symptoms-causes/syc-20352613 | https://medlineplus.gov/ency/article/003068.htm', n.overview = ': Nguyên nhân gây ra chúng khiến bạn không thể kiểm soát được nguyên nhân gây ra nấc. Cơ hoành là cơ ngăn cách ngực với vùng dạ dày và đóng vai trò quan trọng trong quá trình hô hấp. Sự co thắt này kh', n.when_to_see = 'Hãy hẹn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu cơn nấc của bạn kéo dài hơn 48 giờ hoặc nếu chúng nghiêm trọng đến mức gây ra các vấn đề về ăn, ngủ hoặc thở. Yêu cầu một cuộc hẹn Có vấn';
MERGE (n:Disease {id: 'D1439'}) SET n.id = 'D1439', n.name = 'Hidradenitis suppurativa', n.name_en = 'Hidradenitis suppurativa', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hidradenitis-suppurativa/symptoms-causes/syc-20352306', n.overview = 'uppurativa trên các màu da khác nhau. Tình trạng này thường xuất hiện dưới dạng một hoặc nhiều vết sưng mềm chứa đầy mủ. Nó thường xảy ra ở nách. Viêm Hidradenitis suppurativa (hi-drad-uh-NIE-tis sup-', n.when_to_see = 'Chẩn đoán sớm viêm hidradenitis suppurativa là chìa khóa để điều trị hiệu quả. Hãy gặp bác sĩ da liễu nếu tình trạng của bạn: Đau đớn. Gây khó khăn cho việc di chuyển. Không cải thiện trong một vài tu';
MERGE (n:Disease {id: 'D1440'}) SET n.id = 'D1440', n.name = 'Vòm bàn chân cao', n.name_en = 'High arch', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001261.htm', n.prognosis = 'Triển vọng phụ thuộc vào tình trạng gây ra vòm cao. Trong những trường hợp nhẹ, mang giày phù hợp và hỗ trợ vòm có thể giúp giảm đau.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn cho rằng mình bị đau chân liên quan đến vòm bàn chân cao.';
MERGE (n:Disease {id: 'D1441'}) SET n.id = 'D1441', n.name = 'Nồng độ cholesterol trong máu cao', n.name_en = 'High blood cholesterol levels', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000403.htm', n.prognosis = 'Mức cholesterol cao có thể dẫn đến xơ cứng động mạch, còn gọi là xơ vữa động mạch. Điều này xảy ra khi chất béo, cholesterol và các chất khác tích tụ trong thành động mạch và tạo thành các cấu trúc cứ';
MERGE (n:Disease {id: 'D1442'}) SET n.id = 'D1442', n.name = 'Huyết áp cao (tăng huyết áp)', n.name_en = 'High blood pressure (hypertension)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/high-blood-pressure/symptoms-causes/syc-20373410', n.overview = 'Huyết áp cao là tình trạng phổ biến ảnh hưởng đến động mạch của cơ thể. Nó còn được gọi là tăng huyết áp. Nếu bạn bị huyết áp cao, lực đẩy của máu vào thành động mạch luôn ở mức quá cao. Tim phải làm ', n.when_to_see = 'Sàng lọc huyết áp là một phần quan trọng trong chăm sóc sức khỏe tổng quát. Tần suất bạn nên kiểm tra huyết áp tùy thuộc vào độ tuổi và sức khỏe tổng thể của bạn. Hãy yêu cầu nhà cung cấp dịch vụ đo h';
MERGE (n:Disease {id: 'D1443'}) SET n.id = 'D1443', n.name = 'Huyết áp cao - liên quan đến thuốc', n.name_en = 'High blood pressure - medicine-related', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000155.htm';
MERGE (n:Disease {id: 'D1444'}) SET n.id = 'D1444', n.name = 'Huyết áp cao và bệnh về mắt', n.name_en = 'High blood pressure and eye disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000999.htm', n.prognosis = 'Người mắc bệnh võng mạc độ 4 (bệnh võng mạc nặng) thường có vấn đề về tim và thận do huyết áp cao. Họ cũng có nguy cơ bị đột quỵ cao hơn. Trong hầu hết các trường hợp, võng mạc sẽ lành lại nếu huyết á', n.when_to_see = 'Hãy điều trị khẩn cấp nếu bạn bị huyết áp cao kèm theo thay đổi thị lực hoặc đau đầu.';
MERGE (n:Disease {id: 'D1445'}) SET n.id = 'D1445', n.name = 'Huyết áp cao ở người lớn - tăng huyết áp', n.name_en = 'High blood pressure in adults - hypertension', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000468.htm', n.prognosis = 'Trong hầu hết các trường hợp, huyết áp cao có thể được kiểm soát bằng thuốc và thay đổi lối sống. Khi huyết áp không được kiểm soát tốt, bạn có nguy cơ: Chảy máu từ động mạch chủ, mạch máu lớn cung cấ', n.when_to_see = 'Nếu bạn bị huyết áp cao, bạn nên tái khám thường xuyên với nhà cung cấp dịch vụ của mình. Ngay cả khi bạn chưa được chẩn đoán mắc bệnh cao huyết áp, điều quan trọng là phải kiểm tra huyết áp khi khám ';
MERGE (n:Disease {id: 'D1446'}) SET n.id = 'D1446', n.name = 'Cao huyết áp ở trẻ em', n.name_en = 'High blood pressure in children', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/high-blood-pressure-in-children/symptoms-causes/syc-20373440', n.overview = 'Huyết áp cao (tăng huyết áp) ở trẻ em là huyết áp bằng hoặc cao hơn phân vị thứ 95 đối với trẻ cùng giới tính, độ tuổi và chiều cao với con bạn. Không có một phạm vi mục tiêu đơn giản nào cho bệnh cao', n.when_to_see = 'Huyết áp của con bạn nên được kiểm tra trong các cuộc hẹn kiểm tra sức khỏe định kỳ bắt đầu từ 3 tuổi và tại mỗi cuộc hẹn nếu con bạn được phát hiện bị huyết áp cao. Nếu con bạn mắc các bệnh có thể là';
MERGE (n:Disease {id: 'D1447'}) SET n.id = 'D1447', n.name = 'Cao huyết áp ở trẻ em - tăng huyết áp', n.name_en = 'High blood pressure in children - hypertension', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007696.htm', n.prognosis = 'Hầu hết, huyết áp cao ở trẻ em có thể được kiểm soát bằng cách thay đổi lối sống và dùng thuốc nếu cần.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu kết quả giám sát tại nhà cho thấy huyết áp của con bạn vẫn cao.';
MERGE (n:Disease {id: 'D1448'}) SET n.id = 'D1448', n.name = 'Cao huyết áp ở trẻ sơ sinh - tăng huyết áp', n.name_en = 'High blood pressure in infants - hypertension', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007329.htm', n.prognosis = 'Sức khỏe của em bé như thế nào tùy thuộc vào nguyên nhân gây huyết áp cao và các yếu tố khác như: Các vấn đề sức khỏe khác ở em bé Liệu tổn thương (chẳng hạn như tổn thương thận) có xảy ra do huyết áp', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn: Không tăng trưởng và tăng cân Có làn da hơi xanh Bị nhiễm trùng đường tiết niệu thường xuyên Có vẻ khó chịu Lốp xe dễ dàng Đ';
MERGE (n:Disease {id: 'D1449'}) SET n.id = 'D1449', n.name = 'Cholesterol cao', n.name_en = 'High cholesterol', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/high-blood-cholesterol/symptoms-causes/syc-20350800', n.overview = 'Cholesterol là chất sáp có trong máu. Cơ thể cần cholesterol để xây dựng các tế bào khỏe mạnh. Nhưng mức cholesterol cao có thể làm tăng nguy cơ mắc bệnh tim. Với hàm lượng cholesterol cao, chất béo v', n.when_to_see = 'Hiệp hội Tim mạch Hoa Kỳ khuyến cáo trẻ em nên được kiểm tra, còn gọi là sàng lọc, lượng cholesterol cao một lần trong độ tuổi từ 9 đến 11. Việc sàng lọc có thể bắt đầu sớm hơn nếu trẻ có tiền sử gia ';
MERGE (n:Disease {id: 'D1450'}) SET n.id = 'D1450', n.name = 'Cholesterol cao - trẻ em', n.name_en = 'High cholesterol - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007701.htm', n.prognosis = 'Mức cholesterol cao có thể dẫn đến xơ cứng động mạch, còn gọi là xơ vữa động mạch. Điều này xảy ra khi chất béo, cholesterol và các chất khác tích tụ trong thành động mạch và tạo thành các cấu trúc cứ';
MERGE (n:Disease {id: 'D1451'}) SET n.id = 'D1451', n.name = 'Mức kali cao', n.name_en = 'High potassium level', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001179.htm', n.prognosis = 'Nếu nguyên nhân được biết, chẳng hạn như quá nhiều kali trong chế độ ăn uống, thì triển vọng sẽ tốt khi vấn đề được khắc phục. Trong những trường hợp nghiêm trọng hoặc những người có yếu tố nguy cơ li', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn bị nôn mửa, đánh trống ngực, suy nhược hoặc khó thở hoặc nếu bạn đang dùng chất bổ sung kali và có các triệu chứng của lượng kali cao.';
MERGE (n:Disease {id: 'D1452'}) SET n.id = 'D1452', n.name = 'Ung thư đường mật Hilar', n.name_en = 'Hilar cholangiocarcinoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hilar-cholangiocarcinoma/symptoms-causes/syc-20592502', n.overview = 'Ung thư đường mật xảy ra trong các ống dẫn mật, một chất lỏng mà cơ thể sử dụng để tiêu hóa, từ gan đến ruột non. Các ống được gọi là ống mật. Khi ung thư ống mật hình thành trong các ống dẫn trong ga', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1453'}) SET n.id = 'D1453', n.name = 'Nội soi khớp hông', n.name_en = 'Hip arthroscopy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007500.htm', n.overview = 'Trong quá trình nội soi khớp hông, bác sĩ phẫu thuật sử dụng một camera nhỏ gọi là máy nội soi khớp để quan sát bên trong khớp hông của bạn. Máy soi khớp được tạo thành từ một ống nhỏ, thấu kính và ng', n.prognosis = 'Sau phẫu thuật, bạn sẽ phải sử dụng nạng từ 2 đến 6 tuần. Trong tuần đầu tiên, bạn không nên đặt bất kỳ vật nặng nào lên bên đã phẫu thuật. Bạn sẽ dần dần được phép đặt ngày càng nhiều trọng lượng lên';
MERGE (n:Disease {id: 'D1454'}) SET n.id = 'D1454', n.name = 'Chứng loạn sản xương hông', n.name_en = 'Hip dysplasia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hip-dysplasia/symptoms-causes/syc-20350209', n.overview = 'là thuật ngữ y học để chỉ ổ cắm hông không che phủ hoàn toàn phần bóng của xương đùi trên. Điều này làm cho khớp hông bị trật khớp một phần hoặc hoàn toàn. Hầu hết những người mắc chứng loạn sản xương';
MERGE (n:Disease {id: 'D1455'}) SET n.id = 'D1455', n.name = 'Gãy xương hông', n.name_en = 'Hip fracture', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hip-fracture/symptoms-causes/syc-20373468', n.overview = 'Gãy xương hông là một chấn thương nghiêm trọng với các biến chứng có thể đe dọa tính mạng. Nguy cơ gãy xương hông tăng theo tuổi tác. Nguy cơ tăng lên vì xương có xu hướng yếu đi theo tuổi tác. Mất xư';
MERGE (n:Disease {id: 'D1456'}) SET n.id = 'D1456', n.name = 'Phẫu thuật gãy xương hông', n.name_en = 'Hip fracture surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007386.htm', n.overview = 'Bạn có thể được gây mê toàn thân cho phẫu thuật này. Điều này có nghĩa là bạn sẽ bất tỉnh và không thể cảm thấy đau. Bạn có thể bị gây tê tủy sống. Với phương pháp gây mê này, thuốc sẽ được đưa vào lư', n.prognosis = 'Bạn sẽ khỏe hơn nếu ra khỏi giường và bắt đầu di chuyển ngay sau khi phẫu thuật. Các vấn đề sức khỏe phát sinh sau cuộc phẫu thuật này thường do không hoạt động. Bác sĩ phẫu thuật sẽ giúp bạn quyết đị';
MERGE (n:Disease {id: 'D1457'}) SET n.id = 'D1457', n.name = 'Tiêm khớp hông', n.name_en = 'Hip joint injection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007633.htm', n.overview = 'Đối với thủ thuật này, nhà cung cấp dịch vụ chăm sóc sức khỏe sẽ đâm kim vào vùng hông và tiêm thuốc vào khớp hông. Trong hầu hết các trường hợp, nhà cung cấp dịch vụ sử dụng tia X thời gian thực (nội', n.prognosis = 'Hầu hết mọi người đều cảm thấy bớt đau hơn sau khi tiêm hông. Bạn có thể nhận thấy cơn đau giảm đi từ 15 đến 20 phút sau khi tiêm. Cơn đau có thể quay trở lại sau 4 đến 6 giờ khi thuốc gây tê hết tác ';
MERGE (n:Disease {id: 'D1458'}) SET n.id = 'D1458', n.name = 'Thay khớp háng', n.name_en = 'Hip joint replacement', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002975.htm', n.overview = 'Khớp háng của bạn được cấu tạo từ 2 phần chính. Một hoặc cả hai bộ phận có thể được thay thế trong quá trình phẫu thuật: Hốc hông (một phần của xương chậu gọi là ổ cối) Đầu trên của xương đùi (gọi là ', n.prognosis = 'Kết quả phẫu thuật thay khớp háng thường rất xuất sắc. Hầu hết hoặc tất cả cơn đau và cứng khớp của bạn sẽ biến mất. Một số người có thể gặp vấn đề về nhiễm trùng, lỏng lẻo hoặc thậm chí trật khớp hôn';
MERGE (n:Disease {id: 'D1459'}) SET n.id = 'D1459', n.name = 'Rách labral hông', n.name_en = 'Hip labral tear', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hip-labral-tear/symptoms-causes/syc-20354873', n.overview = 'Rách labral hông liên quan đến vòng sụn (labrum) đi theo vành ngoài của ổ khớp hông. Bên cạnh việc đệm khớp hông, labrum còn hoạt động giống như một miếng đệm hoặc miếng đệm cao su để giúp giữ quả bón', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế nếu các triệu chứng trở nên trầm trọng hơn hoặc không cải thiện trong vòng sáu tuần.';
MERGE (n:Disease {id: 'D1460'}) SET n.id = 'D1460', n.name = 'Đau hông', n.name_en = 'Hip pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003179.htm', n.when_to_see = 'Hãy đến bệnh viện hoặc nhận trợ giúp khẩn cấp nếu: Cơn đau hông của bạn cấp tính và do bị ngã nghiêm trọng hoặc chấn thương khác. Chân của bạn bị biến dạng, bầm tím nặng hoặc chảy máu. Bạn không thể d';
MERGE (n:Disease {id: 'D1461'}) SET n.id = 'D1461', n.name = 'Bệnh Hirschsprung', n.name_en = 'Hirschsprung disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001140.htm', n.prognosis = 'Các triệu chứng được cải thiện hoặc biến mất ở hầu hết trẻ em sau phẫu thuật. Một số ít trẻ có thể bị táo bón hoặc gặp khó khăn trong việc kiểm soát phân (đại tiện không tự chủ). Trẻ em được điều trị ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu: Con bạn xuất hiện các triệu chứng của bệnh Hirschsprung Con bạn bị đau bụng hoặc các triệu chứng mới khác sau khi được điều trị ';
MERGE (n:Disease {id: 'D1462'}) SET n.id = 'D1462', n.name = 'Rậm lông', n.name_en = 'Hirsutism', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hirsutism/symptoms-causes/syc-20354935', n.overview = '(HUR-soot-iz-um) là một tình trạng ở phụ nữ khiến lông sẫm màu hoặc thô mọc nhiều hơn. Sự phát triển của tóc theo mô hình giống nam giới. Nó có thể xuất hiện trên mặt, ngực, lưng và các bộ phận khác t', n.when_to_see = 'Nếu bạn cho rằng mình có quá nhiều lông thô trên mặt hoặc cơ thể, hãy nói chuyện với nhóm chăm sóc sức khỏe của bạn. Hỏi về các lựa chọn điều trị. Nhiều lông trên mặt hoặc trên cơ thể có thể là triệu ';
MERGE (n:Disease {id: 'D1463'}) SET n.id = 'D1463', n.name = 'Bệnh mô bào', n.name_en = 'Histiocytosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000068.htm', n.prognosis = 'Bệnh mô bào tế bào Langerhans và bệnh Erdheim-Chester có thể ảnh hưởng đến nhiều cơ quan và có thể dẫn đến tử vong. Khoảng một nửa số người mắc bệnh mô bào phổi sẽ cải thiện, trong khi những người khá', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn có các triệu chứng của chứng rối loạn này. Đến phòng cấp cứu nếu khó thở hoặc đau ngực phát triển.';
MERGE (n:Disease {id: 'D1464'}) SET n.id = 'D1464', n.name = 'Histoplasmosis', n.name_en = 'Histoplasmosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/histoplasmosis/symptoms-causes/syc-20373495 | https://medlineplus.gov/ency/article/001082.htm', n.overview = 'là một bệnh nhiễm trùng do một loại nấm thường thấy trong phân chim và dơi gây ra. Mọi người bị nhiễm trùng bằng cách hít phải các tế bào trong không khí, được gọi là bào tử, từ nấm. Những bào tử này ', n.prognosis = 'Triển vọng phụ thuộc vào mức độ nghiêm trọng của tình trạng nhiễm trùng và tình trạng sức khỏe chung của bạn. Một số người khỏe hơn mà không cần điều trị. Nhiễm trùng đang hoạt động thường sẽ khỏi khi', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn sống ở khu vực thường gặp bệnh histoplasmosis và bạn phát triển: Các triệu chứng giống cúm Đau ngực Ho Khó thở Mặc dù có nhiều bệnh khác có triệu c';
MERGE (n:Disease {id: 'D1465'}) SET n.id = 'D1465', n.name = 'Bệnh Histoplasmosis - phổi cấp tính (nguyên phát)', n.name_en = 'Histoplasmosis - acute (primary) pulmonary', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000098.htm', n.prognosis = 'Khi nhiễm trùng phổi do histoplasmosis nặng hoặc nặng hơn, bệnh có thể kéo dài đến nhiều tháng. Thậm chí sau đó, nó hiếm khi gây tử vong. Bệnh có thể trở nên nặng hơn theo thời gian và trở thành bệnh ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có các triệu chứng của bệnh histoplasmosis, đặc biệt nếu bạn có hệ thống miễn dịch yếu hoặc gần đây đã tiếp xúc với phân chim hoặc dơi Bạn đang đư';
MERGE (n:Disease {id: 'D1466'}) SET n.id = 'D1466', n.name = 'Rối loạn nhân cách kịch tính', n.name_en = 'Histrionic personality disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001531.htm', n.prognosis = 'Rối loạn nhân cách kịch tính có thể cải thiện bằng liệu pháp trò chuyện và đôi khi là dùng thuốc. Nếu không được điều trị, nó có thể gây ra nhiều vấn đề trong cuộc sống cá nhân của mọi người và khiến ', n.when_to_see = 'Hãy gặp nhà cung cấp hoặc chuyên gia sức khỏe tâm thần nếu bạn hoặc ai đó bạn biết có các triệu chứng của rối loạn nhân cách kịch tính.';
MERGE (n:Disease {id: 'D1467'}) SET n.id = 'D1467', n.name = 'HIV/AIDS', n.name_en = 'HIV/AIDS', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hiv-aids/symptoms-causes/syc-20373524', n.overview = 'Hội chứng suy giảm miễn dịch mắc phải (AIDS), là một tình trạng đang diễn ra, còn được gọi là mãn tính. Nguyên nhân là do virus gây suy giảm miễn dịch ở người, còn được gọi là HIV. HIV làm tổn thương ', n.when_to_see = 'Nếu bạn nghĩ rằng mình có thể đã bị nhiễm HIV hoặc có nguy cơ nhiễm vi-rút, hãy gặp chuyên gia chăm sóc sức khỏe càng sớm càng tốt. Thông tin thêm Các triệu chứng HIV giai đoạn đầu: Chúng là gì? Yêu c';
MERGE (n:Disease {id: 'D1468'}) SET n.id = 'D1468', n.name = 'HIV/AIDS ở phụ nữ mang thai và trẻ sơ sinh', n.name_en = 'HIV/AIDS in pregnant women and infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007689.htm', n.prognosis = 'Nguy cơ người mẹ lây truyền HIV khi mang thai hoặc khi chuyển dạ là thấp đối với những bà mẹ được xác định và điều trị bằng ART sớm trong thai kỳ. Khi điều trị, khả năng con cô bị nhiễm bệnh là dưới 1', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhiễm HIV hoặc có nguy cơ nhiễm HIV và bạn có thai hoặc đang nghĩ đến việc mang thai.';
MERGE (n:Disease {id: 'D1469'}) SET n.id = 'D1469', n.name = 'Phát ban', n.name_en = 'Hives', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000845.htm', n.prognosis = 'Phát ban có thể gây khó chịu nhưng chúng thường vô hại và tự biến mất. Khi tình trạng này kéo dài hơn 6 tuần, nó được gọi là phát ban mãn tính. Thông thường không thể tìm thấy nguyên nhân. Hầu hết các', n.when_to_see = 'Hãy gọi 911 hoặc số điện thoại khẩn cấp tại địa phương nếu bạn bị: Ngất xỉu Khó thở Thắt cổ họng Sưng lưỡi hoặc mặt Thở khò khè Liên hệ với nhà cung cấp dịch vụ của bạn nếu phát ban nghiêm trọng, khó ';
MERGE (n:Disease {id: 'D1470'}) SET n.id = 'D1470', n.name = 'Nổi mề đay và phù mạch', n.name_en = 'Hives and angioedema', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hives-and-angioedema/symptoms-causes/syc-20354908', n.overview = 'Nổi mề đay, nổi mẩn ngứa. Phát ban còn được gọi là mày đay. Phù mạch gây sưng tấy ở các lớp da sâu hơn, thường là ở mặt và môi. Nó thường biến mất trong vòng một ngày. Phát ban - còn được gọi là nổi m', n.when_to_see = 'Bạn thường có thể điều trị các trường hợp nổi mề đay hoặc phù mạch nhẹ tại nhà. Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu các triệu chứng của bạn tiếp tục kéo dài hơn một vài ngày. Nế';
MERGE (n:Disease {id: 'D1471'}) SET n.id = 'D1471', n.name = 'Rối loạn tích trữ', n.name_en = 'Hoarding disorder', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hoarding-disorder/symptoms-causes/syc-20356056', n.overview = 'là tình trạng khó khăn liên tục khi vứt bỏ hoặc chia tay tài sản vì bạn tin rằng mình cần phải cứu chúng. Bạn có thể cảm thấy đau khổ khi nghĩ đến việc loại bỏ những món đồ đó. Bạn dần dần giữ hoặc th', n.when_to_see = 'Nếu bạn hoặc người thân có triệu chứng rối loạn tích trữ, hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe hoặc nhà cung cấp dịch vụ sức khỏe tâm thần có chuyên môn về chẩn đoán và điều trị c';
MERGE (n:Disease {id: 'D1472'}) SET n.id = 'D1472', n.name = 'Khàn tiếng', n.name_en = 'Hoarseness', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003054.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn khó thở hoặc khó nuốt. Khàn giọng xảy ra khi chảy nước dãi, đặc biệt ở trẻ nhỏ. Khàn giọng xảy ra ở trẻ dưới 3 tháng tuổi. Khàn tiếng kéo dài hơn 1 tu';
MERGE (n:Disease {id: 'D1473'}) SET n.id = 'D1473', n.name = 'Ung thư hạch Hodgkin', n.name_en = 'Hodgkin lymphoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000580.htm', n.prognosis = 'Ung thư hạch Hodgkin là một trong những bệnh ung thư có thể chữa được nhất. Việc chữa khỏi thậm chí còn có nhiều khả năng hơn nếu nó được chẩn đoán và điều trị sớm. Không giống như nhiều bệnh ung thư ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có các triệu chứng của bệnh ung thư hạch Hodgkin Bạn mắc bệnh ung thư hạch Hodgkin và bạn gặp các tác dụng phụ do điều trị';
MERGE (n:Disease {id: 'D1474'}) SET n.id = 'D1474', n.name = 'Ung thư hạch Hodgkin (bệnh Hodgkin)', n.name_en = 'Hodgkin lymphoma (Hodgkin disease)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hodgkins-lymphoma/symptoms-causes/syc-20352646', n.overview = 'Các bộ phận của hệ thống miễn dịch trong hệ thống miễn dịch của cơ thể, có chức năng bảo vệ chống lại nhiễm trùng và bệnh tật. Hệ thống bạch huyết bao gồm lá lách, tuyến ức, hạch bạch huyết và các kên', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
';
MERGE (n:Disease {id: 'D1475'}) SET n.id = 'D1475', n.name = 'Ung thư hạch Hodgkin ở trẻ em', n.name_en = 'Hodgkin lymphoma in children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007685.htm', n.prognosis = 'Ung thư hạch Hodgkin có thể chữa được trong hầu hết các trường hợp. Ngay cả khi dạng ung thư này quay trở lại, vẫn có cơ hội chữa khỏi ở mức vừa phải. Con bạn sẽ cần được khám và xét nghiệm hình ảnh t', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn bị sưng hạch bạch huyết kèm theo sốt kéo dài hoặc có các triệu chứng khác của bệnh ung thư hạch Hodgkin. Hãy liên hệ với nhà cung cấp dịch vụ c';
MERGE (n:Disease {id: 'D1476'}) SET n.id = 'D1476', n.name = 'Homocystinuria', n.name_en = 'Homocystinuria', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001199.htm', n.prognosis = 'Mặc dù không có phương pháp chữa trị bệnh homocystin niệu nhưng liệu pháp vitamin B có thể giúp ích cho khoảng một nửa số người bị ảnh hưởng bởi tình trạng này. Nếu chẩn đoán được thực hiện khi còn nh', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc một thành viên trong gia đình có các triệu chứng của chứng rối loạn này, đặc biệt nếu bạn có tiền sử gia đình mắc bệnh homocystin niệu.';
MERGE (n:Disease {id: 'D1477'}) SET n.id = 'D1477', n.name = 'Nhiễm giun móc', n.name_en = 'Hookworm infection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000629.htm', n.prognosis = 'Bạn sẽ hồi phục hoàn toàn nếu được điều trị trước khi các biến chứng nghiêm trọng phát triển. Điều trị sẽ thoát khỏi nhiễm trùng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để đặt lịch hẹn nếu các triệu chứng nhiễm giun móc phát triển.';
MERGE (n:Disease {id: 'D1478'}) SET n.id = 'D1478', n.name = 'Tác dụng nội tiết ở trẻ sơ sinh', n.name_en = 'Hormonal effects in newborns', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001911.htm', n.overview = 'Hormon từ mẹ (hormone của mẹ) là một số hóa chất đi qua nhau thai vào máu của em bé trong thai kỳ. Những hormone này có thể ảnh hưởng đến em bé. Ví dụ, phụ nữ mang thai sản xuất lượng hormone estrogen';
MERGE (n:Disease {id: 'D1479'}) SET n.id = 'D1479', n.name = 'Hội chứng Horner', n.name_en = 'Horner syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/horner-syndrome/symptoms-causes/syc-20373547 | https://medlineplus.gov/ency/article/000708.htm', n.overview = 'là tình trạng ảnh hưởng đến mặt và mắt ở một bên cơ thể. Nguyên nhân là do sự gián đoạn của đường dẫn truyền thần kinh từ não đến đầu và cổ. Dấu hiệu hội chứng Horner Giảm kích thước đồng tử mắt là dấ', n.prognosis = 'Kết quả phụ thuộc vào việc điều trị nguyên nhân có thành công hay không.', n.when_to_see = 'Một số yếu tố, một số yếu tố nghiêm trọng hơn những yếu tố khác, có thể gây ra hội chứng Horner. Điều quan trọng là có được chẩn đoán nhanh chóng và chính xác. Nhận dịch vụ chăm sóc khẩn cấp nếu các d';
MERGE (n:Disease {id: 'D1480'}) SET n.id = 'D1480', n.name = 'Viêm phổi mắc phải tại bệnh viện', n.name_en = 'Hospital-acquired pneumonia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000146.htm', n.prognosis = 'Những người mắc các bệnh nghiêm trọng khác không khỏi bệnh viêm phổi tốt như những người không bị bệnh. Viêm phổi mắc phải tại bệnh viện có thể là một căn bệnh đe dọa tính mạng. Tổn thương phổi lâu dà';
MERGE (n:Disease {id: 'D1481'}) SET n.id = 'D1481', n.name = 'Nóng bừng', n.name_en = 'Hot flashes', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hot-flashes/symptoms-causes/syc-20352790', n.overview = 'Nóng bừng là cảm giác nóng đột ngột ở phần trên cơ thể. Nó thường ảnh hưởng đến mặt, cổ và ngực. Nóng bừng cũng có thể gây đổ mồ hôi. Một số người có thể cảm thấy ớn lạnh sau cơn bốc hỏa do cơ thể mất', n.when_to_see = 'Nếu các cơn bốc hỏa ảnh hưởng đến hoạt động hàng ngày hoặc giấc ngủ của bạn, hãy trao đổi với chuyên gia chăm sóc sức khỏe của bạn về các phương pháp điều trị.';
MERGE (n:Disease {id: 'D1482'}) SET n.id = 'D1482', n.name = 'Viêm nang lông trong bồn tắm nước nóng', n.name_en = 'Hot tub folliculitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001460.htm', n.prognosis = 'Tình trạng này thường khỏi mà không để lại sẹo. Vấn đề có thể tái diễn nếu bạn sử dụng lại bồn tắm nước nóng trước khi nó được làm sạch.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của bệnh viêm nang lông do bồn tắm nước nóng.';
MERGE (n:Disease {id: 'D1483'}) SET n.id = 'D1483', n.name = 'Ngộ độc keo gia dụng', n.name_en = 'Household glue poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002826.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào mức độ nghiêm trọng của ngộ độc và tốc độ điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Vì keo gia dụng khá không độc nên có khả n';
MERGE (n:Disease {id: 'D1484'}) SET n.id = 'D1484', n.name = 'Cách làm dây đeo', n.name_en = 'How to make a sling', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000017.htm', n.when_to_see = 'Hãy tìm kiếm sự trợ giúp y tế ngay lập tức nếu người đó bị trật khớp, gãy xương hoặc chảy máu nghiêm trọng. Đồng thời nhận trợ giúp y tế nếu bạn không thể tự mình cố định hoàn toàn vết thương tại hiện';
MERGE (n:Disease {id: 'D1485'}) SET n.id = 'D1485', n.name = 'Cách làm nẹp', n.name_en = 'How to make a splint', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000040.htm', n.when_to_see = 'Nếu chấn thương xảy ra khi đang ở vùng sâu vùng xa, hãy gọi trợ giúp y tế khẩn cấp càng sớm càng tốt. Trong lúc đó, hãy sơ cứu cho người đó. Tìm kiếm sự trợ giúp y tế ngay lập tức nếu có bất kỳ trường';
MERGE (n:Disease {id: 'D1486'}) SET n.id = 'D1486', n.name = 'Vắc-xin HPV (vi-rút u nhú ở người) - những điều bạn cần biết', n.name_en = 'HPV (human papillomavirus) vaccine - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007648.htm', n.overview = 'Tại sao phải tiêm phòng? Vắc-xin HPV (vi rút u nhú ở người) có thể ngăn ngừa nhiễm một số loại vi rút u nhú ở người. Nhiễm HPV có thể gây ra một số loại ung thư, bao gồm: Ung thư cổ tử cung, âm đạo và';
MERGE (n:Disease {id: 'D1487'}) SET n.id = 'D1487', n.name = 'Nhiễm trùng HPV', n.name_en = 'HPV infection', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hpv-infection/symptoms-causes/syc-20351596', n.overview = 'là một bệnh nhiễm virus. Có hơn 100 loại papillomavirus ở người (HPV). Một số loại nhiễm trùng HPV gây ra sự phát triển trên da gọi là mụn cóc và một số loại nhiễm trùng HPV có thể gây ung thư. Hầu hế', n.when_to_see = 'Nếu bạn hoặc con bạn có bất kỳ mụn cóc nào gây bối rối, khó chịu hoặc đau đớn, hãy tìm lời khuyên từ chuyên gia chăm sóc sức khỏe của bạn.';
MERGE (n:Disease {id: 'D1488'}) SET n.id = 'D1488', n.name = 'Vắc-xin HPV', n.name_en = 'HPV vaccine', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007436.htm', n.overview = 'HPV là một loại vi-rút phổ biến lây lan qua quan hệ tình dục. Có một số loại vi-rút HPV. Nhiều loại không gây ra vấn đề. Tuy nhiên, một số loại HPV có thể gây ung thư: Cổ tử cung, âm đạo và âm hộ ở ph';
MERGE (n:Disease {id: 'D1489'}) SET n.id = 'D1489', n.name = 'Máy tạo độ ẩm và sức khỏe', n.name_en = 'Humidifiers and health', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002104.htm', n.overview = 'Sử dụng máy tạo độ ẩm trong nhà có thể giúp giảm nghẹt mũi và có thể giúp làm tan chất nhầy để bạn có thể ho ra ngoài. Không khí ẩm có thể làm giảm sự khó chịu do cảm lạnh và cúm. Hãy làm theo hướng d';
MERGE (n:Disease {id: 'D1490'}) SET n.id = 'D1490', n.name = 'Bướu ở lưng trên (miếng mỡ vùng lưng cổ)', n.name_en = 'Hump on upper back (dorsocervical fat pad)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003112.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có bướu không rõ nguyên nhân sau vai.';
MERGE (n:Disease {id: 'D1491'}) SET n.id = 'D1491', n.name = 'Bệnh Huntington', n.name_en = 'Huntington disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000770.htm', n.prognosis = 'HD khiến tình trạng khuyết tật ngày càng trầm trọng hơn theo thời gian. Những người mắc bệnh HD thường chết trong vòng 15 đến 20 năm. Nguyên nhân tử vong thường là nhiễm trùng. Suicide is also common.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc thành viên gia đình phát triển các triệu chứng của HD. Nếu bạn hoặc ai đó bạn biết đang nghĩ đến việc tự tử, hãy gọi hoặc nhắn tin tới 988 hoặ';
MERGE (n:Disease {id: 'D1492'}) SET n.id = 'D1492', n.name = 'Ung thư tế bào Hurthle', n.name_en = 'Hurthle cell cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hurthle-cell-cancer/symptoms-causes/syc-20373572', n.overview = 'Ung thư tế bào Hurthle (HEERT-luh) là một loại ung thư hiếm gặp ảnh hưởng đến tuyến giáp. Tuyến giáp là một tuyến hình con bướm nằm ở đáy cổ. Nó tiết ra các hormone cần thiết để điều chỉnh quá trình t', n.when_to_see = 'Hãy hẹn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn có bất kỳ dấu hiệu hoặc triệu chứng nào khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D1493'}) SET n.id = 'D1493', n.name = 'Nốt ruồi hydatidiform', n.name_en = 'Hydatidiform mole', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000909.htm', n.prognosis = 'Hầu hết các HM đều không phải ung thư ( lành tính ). Điều trị thường thành công. Việc theo dõi chặt chẽ của bác sĩ là điều quan trọng để đảm bảo rằng các dấu hiệu của thai trứng đã biến mất và nồng độ';
MERGE (n:Disease {id: 'D1494'}) SET n.id = 'D1494', n.name = 'Viêm phổi do hydrocarbon', n.name_en = 'Hydrocarbon pneumonia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001083.htm', n.prognosis = 'Hầu hết trẻ em uống hoặc hít phải các sản phẩm hydrocarbon và bị viêm phổi do hóa chất (viêm phổi không nhiễm trùng) đều hồi phục hoàn toàn sau khi điều trị. Hydrocarbon có độc tính cao có thể nhanh c', n.when_to_see = 'Nếu bạn biết hoặc nghi ngờ rằng con bạn đã nuốt hoặc hít phải sản phẩm hydrocarbon, hãy đưa trẻ đến phòng cấp cứu ngay lập tức. Không sử dụng ipecac để làm người đó nôn mửa.';
MERGE (n:Disease {id: 'D1495'}) SET n.id = 'D1495', n.name = 'Hydrocele', n.name_en = 'Hydrocele', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hydrocele/symptoms-causes/syc-20363969 | https://medlineplus.gov/ency/article/000518.htm', n.overview = 'Hydrocele (HI-droe-seel) là một loại sưng ở bìu, túi da giữ tinh hoàn. Tình trạng sưng tấy này xảy ra khi chất lỏng tích tụ trong túi mỏng bao quanh tinh hoàn. Hydroceles là phổ biến ở trẻ sơ sinh. Ch', n.prognosis = 'Thủy tinh thể đơn giản ở trẻ em thường tự khỏi mà không cần phẫu thuật. Ở người lớn, thủy sinh thường không tự khỏi. Nếu cần phẫu thuật, đây là một thủ thuật dễ dàng và mang lại kết quả rất tốt. Sau p', n.when_to_see = 'Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn bị sưng bìu. Điều quan trọng là phải tìm hiểu xem có nguyên nhân nào khác gây sưng tấy có thể điều trị được hay không. V';
MERGE (n:Disease {id: 'D1496'}) SET n.id = 'D1496', n.name = 'Sửa chữa thủy tinh thể', n.name_en = 'Hydrocele repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002999.htm', n.overview = 'Phẫu thuật sửa chữa thủy tinh thể thường được thực hiện tại phòng khám ngoại trú. Gây mê toàn thân được sử dụng để bạn sẽ ngủ và không đau trong suốt quá trình thực hiện. Ở trẻ sơ sinh hoặc trẻ nhỏ: B', n.prognosis = 'Tỷ lệ sửa chữa thành công của hydrocele là rất cao. Triển vọng dài hạn là tuyệt vời. Tuy nhiên, một hydrocele khác có thể hình thành theo thời gian, đặc biệt nếu có thoát vị.';
MERGE (n:Disease {id: 'D1497'}) SET n.id = 'D1497', n.name = 'Não úng thủy', n.name_en = 'Hydrocephalus', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hydrocephalus/symptoms-causes/syc-20373604 | https://medlineplus.gov/ency/article/001571.htm', n.overview = 'là sự tích tụ dịch não tủy (CSF) trong không gian gọi là tâm thất sâu trong não. Sự tích tụ này có thể làm cho tâm thất lớn hơn và gây áp lực lên não. Dịch não tủy thường chảy qua tâm thất và xung qua', n.prognosis = 'Nếu không điều trị, cứ 10 người bị não úng thủy thì có tới 6 người sẽ tử vong. Những người sống sót sẽ bị khuyết tật về trí tuệ, thể chất và thần kinh ở mức độ khác nhau. Triển vọng phụ thuộc vào nguy', n.when_to_see = 'Tìm kiếm sự chăm sóc y tế khẩn cấp cho trẻ sơ sinh và trẻ mới biết đi có các triệu chứng sau: Tiếng khóc the thé. Khó khăn khi bú hoặc cho ăn. Nôn mửa xảy ra nhiều lần mà không có nguyên nhân rõ ràng.';
MERGE (n:Disease {id: 'D1498'}) SET n.id = 'D1498', n.name = 'Ngộ độc axit clohydric', n.name_en = 'Hydrochloric acid poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002498.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận như thế nào. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Người đó có thể c';
MERGE (n:Disease {id: 'D1499'}) SET n.id = 'D1499', n.name = 'Quá liều hydrocodone và acetaminophen', n.name_en = 'Hydrocodone and acetaminophen overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002670.htm', n.prognosis = 'Tình trạng sức khỏe của bạn như thế nào phụ thuộc vào lượng hydrocodone và acetaminophen bạn đã nuốt và tốc độ điều trị của bạn. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Bạn có thể cầ';
MERGE (n:Disease {id: 'D1500'}) SET n.id = 'D1500', n.name = 'Quá liều hydrocodone/oxycodone', n.name_en = 'Hydrocodone/oxycodone overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007285.htm', n.prognosis = 'Dùng quá liều lượng lớn có thể khiến một người ngừng thở và tử vong nếu không được điều trị ngay lập tức. Người đó có thể cần phải nhập viện để tiếp tục điều trị. Tùy thuộc vào loại thuốc hoặc loại th';
MERGE (n:Disease {id: 'D1501'}) SET n.id = 'D1501', n.name = 'Ngộ độc axit hydrofluoric', n.name_en = 'Hydrofluoric acid poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002499.htm', n.prognosis = 'Khả năng phục hồi của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Axit flohydric đặc biệt nguy hiểm. ';
MERGE (n:Disease {id: 'D1502'}) SET n.id = 'D1502', n.name = 'Ngộ độc hydro peroxide', n.name_en = 'Hydrogen peroxide poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002652.htm', n.prognosis = 'Hầu hết tiếp xúc với hydrogen peroxide cường độ trong gia đình là khá vô hại. Tiếp xúc với hydrogen peroxide cường độ công nghiệp có thể nguy hiểm. Nội soi có thể được yêu cầu để cầm máu bên trong.';
MERGE (n:Disease {id: 'D1503'}) SET n.id = 'D1503', n.name = 'Quá liều hydromorphone', n.name_en = 'Hydromorphone overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002633.htm', n.prognosis = 'Những người nhanh chóng nhận được thuốc (gọi là thuốc giải độc) để đảo ngược tác dụng của hydromorphone có thể hồi phục trong vòng 1 đến 4 giờ. Họ có thể cần phải ở lại bệnh viện để uống thêm liều thu';
MERGE (n:Disease {id: 'D1504'}) SET n.id = 'D1504', n.name = 'Thận ứ nước', n.name_en = 'Hydronephrosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hydronephrosis/symptoms-causes/syc-20575276', n.overview = 'idney. Thông thường, sự tắc nghẽn được gọi là tắc nghẽn ở phần trên của đường tiết niệu gây ra sự tích tụ. Có thể gây sưng thận. Điều này làm cho phần thận gọi là bể thận phình ra hoặc trở nên căng ph', n.when_to_see = 'Gọi cho chuyên gia chăm sóc sức khỏe của bạn nếu bạn có bất kỳ triệu chứng nào của bệnh thận ứ nước. Trẻ mắc bệnh này thường không có triệu chứng. Nhưng hãy đưa bé đi khám sức khỏe ngay nếu có các tri';
MERGE (n:Disease {id: 'D1505'}) SET n.id = 'D1505', n.name = 'Thận ứ nước ở một thận', n.name_en = 'Hydronephrosis of one kidney', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000506.htm', n.prognosis = 'Mất chức năng thận, nhiễm trùng tiểu và đau có thể xảy ra nếu tình trạng này không được điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị đau sườn hoặc sốt liên tục hoặc nghiêm trọng hoặc nếu bạn cho rằng mình có thể bị thận ứ nước.';
MERGE (n:Disease {id: 'D1506'}) SET n.id = 'D1506', n.name = 'Hydrops thai nhi', n.name_en = 'Hydrops fetalis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007308.htm', n.prognosis = 'Hydrops thai nhi thường dẫn đến tử vong ở trẻ sơ sinh ngay trước hoặc sau khi sinh. Nguy cơ cao nhất đối với những em bé được sinh ra rất sớm hoặc bị bệnh khi mới sinh. Những em bé có khiếm khuyết về ';
MERGE (n:Disease {id: 'D1507'}) SET n.id = 'D1507', n.name = 'Quá liều hydroxyzine', n.name_en = 'Hydroxyzine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002654.htm', n.prognosis = 'Có khả năng phục hồi nếu người đó sống sót sau 24 giờ đầu tiên. Các biến chứng như viêm phổi, tổn thương cơ do nằm trên bề mặt cứng trong thời gian dài hoặc tổn thương não do thiếu oxy có thể gây tàn ';
MERGE (n:Disease {id: 'D1508'}) SET n.id = 'D1508', n.name = 'Tăng động', n.name_en = 'Hyperactivity', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003256.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu: Con bạn thường xuyên có vẻ hiếu động thái quá. Con bạn rất năng động, hung hăng, bốc đồng hoặc khó tập trung. Mức độ hoạt động c';
MERGE (n:Disease {id: 'D1509'}) SET n.id = 'D1509', n.name = 'Liệu pháp oxy cao áp', n.name_en = 'Hyperbaric oxygen therapy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002375.htm', n.overview = 'Một số bệnh viện có buồng cao áp. Các đơn vị nhỏ hơn có thể có sẵn ở các trung tâm ngoại trú. Áp suất không khí bên trong buồng oxy cao áp cao hơn khoảng hai lần rưỡi so với áp suất bình thường trong ';
MERGE (n:Disease {id: 'D1510'}) SET n.id = 'D1510', n.name = 'Tăng canxi máu', n.name_en = 'Hypercalcemia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hypercalcemia/symptoms-causes/syc-20355523 | https://medlineplus.gov/ency/article/000365.htm', n.overview = 'Tuyến cận giáp nằm phía sau tuyến giáp, tạo ra hormone tuyến cận giáp. Hormon này đóng vai trò kiểm soát mức độ khoáng chất canxi và phốt pho trong cơ thể. Tăng canxi máu là tình trạng nồng độ canxi t', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào nguyên nhân khiến mức canxi cao của bạn. Triển vọng tốt cho những người bị cường cận giáp nhẹ hoặc tăng canxi máu có nguyên nhân có thể điều trị được. Hầu hết thờ', n.when_to_see = 'Hãy gọi cho chuyên gia chăm sóc sức khỏe của bạn nếu bạn cho rằng mình có bất kỳ triệu chứng tăng canxi máu nào. Chúng có thể bao gồm khát nước quá mức, đi tiểu thường xuyên và đau ở vùng dạ dày. Yêu ';
MERGE (n:Disease {id: 'D1511'}) SET n.id = 'D1511', n.name = 'Da siêu đàn hồi', n.name_en = 'Hyperelastic skin', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003280.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Da của bạn có vẻ rất co giãn có làn da mỏng manh';
MERGE (n:Disease {id: 'D1512'}) SET n.id = 'D1512', n.name = 'Ốm nghén', n.name_en = 'Hyperemesis gravidarum', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001499.htm', n.prognosis = 'Ốm nghén thường nhẹ nhưng dai dẳng. Nó có thể bắt đầu từ tuần thứ 4 đến tuần thứ 8 của thai kỳ. Nó thường biến mất sau 16 đến 18 tuần của thai kỳ. Buồn nôn và nôn mửa nghiêm trọng cũng có thể bắt đầu ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn đang mang thai và bị buồn nôn và nôn mửa nghiêm trọng hoặc nếu bạn có bất kỳ triệu chứng nào sau đây: Dấu hiệu mất nước. Không thể chịu đựng được b';
MERGE (n:Disease {id: 'D1513'}) SET n.id = 'D1513', n.name = 'Hội chứng tăng bạch cầu ái toan', n.name_en = 'Hypereosinophilic syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hypereosinophilic-syndrome/symptoms-causes/syc-20352854', n.overview = 'là tổn thương hoặc rối loạn chức năng cơ quan do dư thừa các tế bào bạch cầu chống lại bệnh tật gọi là bạch cầu ái toan. Hội chứng tăng bạch cầu ái toan (hy-per-ee-o-SIN-o-phil-ik) rất hiếm. Nó có thể', n.when_to_see = 'Nhiều tình trạng khác nhau có thể gây ra các triệu chứng liên quan đến HES. Hãy gặp chuyên gia chăm sóc sức khỏe của bạn càng sớm càng tốt nếu các triệu chứng không cải thiện. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1514'}) SET n.id = 'D1514', n.name = 'Tăng đường huyết - trẻ sơ sinh', n.name_en = 'Hyperglycemia - infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007228.htm', n.prognosis = 'Hầu hết lượng đường trong máu cao tạm thời thường không có tác dụng lâu dài trừ khi em bé mắc bệnh tiểu đường.';
MERGE (n:Disease {id: 'D1515'}) SET n.id = 'D1515', n.name = 'Tăng đường huyết trong bệnh tiểu đường', n.name_en = 'Hyperglycemia in diabetes', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hyperglycemia/symptoms-causes/syc-20373631', n.overview = 'Lượng đường trong máu cao, còn gọi là tăng đường huyết, ảnh hưởng đến những người mắc bệnh tiểu đường. Một số yếu tố có thể đóng vai trò gây tăng đường huyết ở người mắc bệnh tiểu đường. Chúng bao gồm', n.when_to_see = 'Hãy tìm kiếm sự trợ giúp ngay lập tức từ nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn hoặc gọi 911 nếu: Bạn bị tiêu chảy hoặc nôn mửa liên tục và bạn không thể giữ được thức ăn hoặc chất lỏng nào. M';
MERGE (n:Disease {id: 'D1516'}) SET n.id = 'D1516', n.name = 'Tăng tiết mồ hôi', n.name_en = 'Hyperhidrosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hyperhidrosis/symptoms-causes/syc-20367152 | https://medlineplus.gov/ency/article/007259.htm', n.overview = '(hi-pur-hi-DROE-sis) là tình trạng đổ mồ hôi quá nhiều không phải lúc nào cũng liên quan đến nhiệt độ hoặc tập thể dục. Bạn có thể đổ mồ hôi nhiều đến mức thấm qua quần áo hoặc chảy ra tay. Đổ mồ hôi ', n.prognosis = 'Khi điều trị, bệnh tăng tiết mồ hôi có thể được kiểm soát. Nhà cung cấp của bạn có thể thảo luận về các lựa chọn điều trị với bạn.', n.when_to_see = 'Đôi khi đổ mồ hôi quá nhiều là dấu hiệu của một tình trạng nghiêm trọng. Hãy tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn đổ mồ hôi nhiều kèm theo chóng mặt, đau ngực, cổ họng, hàm, cánh tay, vai ho';
MERGE (n:Disease {id: 'D1517'}) SET n.id = 'D1517', n.name = 'Hội chứng Hyperimmunoglobulin E', n.name_en = 'Hyperimmunoglobulin E syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001311.htm', n.prognosis = 'Hội chứng tăng IgE là bệnh mãn tính suốt đời. Mỗi bệnh nhiễm trùng mới đều cần điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của hội chứng Hyper IgE.';
MERGE (n:Disease {id: 'D1518'}) SET n.id = 'D1518', n.name = 'Liệt định kỳ do tăng kali máu', n.name_en = 'Hyperkalemic periodic paralysis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000316.htm', n.prognosis = 'Đôi khi, các cuộc tấn công sẽ tự biến mất sau này. Nhưng các cuộc tấn công lặp đi lặp lại có thể dẫn đến yếu cơ vĩnh viễn. HyperPP đáp ứng tốt với điều trị. Điều trị có thể ngăn ngừa và thậm chí có th', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc con bạn bị yếu cơ đến rồi đi, đặc biệt nếu bạn có thành viên trong gia đình bị liệt định kỳ. Hãy đến phòng cấp cứu hoặc gọi số cấp cứu tại địa';
MERGE (n:Disease {id: 'D1519'}) SET n.id = 'D1519', n.name = 'Khớp siêu linh hoạt', n.name_en = 'Hypermobile joints', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003295.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Khớp đột nhiên bị biến dạng Cánh tay hoặc chân đột nhiên không cử động bình thường Đau xảy ra khi cử động khớp Khả năng cử động khớp đột ngột thay đổi';
MERGE (n:Disease {id: 'D1520'}) SET n.id = 'D1520', n.name = 'Tăng oxy máu và nhiễm oxalosis', n.name_en = 'Hyperoxaluria and oxalosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hyperoxaluria/symptoms-causes/syc-20352254', n.overview = 'Tăng oxy máu (hi-pur-ok-suh-LU-ree-uh) xảy ra khi bạn có quá nhiều oxalate trong nước tiểu. Oxalate là một chất hóa học tự nhiên mà cơ thể tạo ra. Nó cũng được tìm thấy trong một số thực phẩm. Nhưng q', n.when_to_see = 'Trẻ em dễ bị sỏi thận. Sỏi thận hình thành ở trẻ em và thanh thiếu niên có thể do vấn đề sức khỏe gây ra, chẳng hạn như tăng oxalat niệu. Tất cả những người trẻ tuổi bị sỏi thận nên đi khám sức khỏe. ';
MERGE (n:Disease {id: 'D1521'}) SET n.id = 'D1521', n.name = 'Bệnh cường cận giáp', n.name_en = 'Hyperparathyroidism', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hyperparathyroidism/symptoms-causes/syc-20356194 | https://medlineplus.gov/ency/article/001215.htm', n.overview = 'xảy ra khi có quá nhiều hormone tuyến cận giáp trong máu. Tuyến cận giáp tạo ra hormone tuyến cận giáp. Cơ thể có bốn tuyến này. Chúng nằm phía sau tuyến giáp ở phía dưới cổ. Mỗi tuyến cận giáp có kíc', n.prognosis = 'Outlook phụ thuộc vào nguyên nhân gây ra bệnh cường tuyến cận giáp.', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào của bệnh cường cận giáp. Những triệu chứng đó có thể được kích hoạt bởi các tình trạng sức khỏe khác gây ra bệnh cường cận giáp. ';
MERGE (n:Disease {id: 'D1522'}) SET n.id = 'D1522', n.name = 'Viêm phổi quá mẫn', n.name_en = 'Hypersensitivity pneumonitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000109.htm', n.prognosis = 'Hầu hết các triệu chứng sẽ biến mất khi bạn tránh hoặc hạn chế tiếp xúc với tài liệu gây ra sự cố. Triển vọng sẽ tốt nếu bạn ngăn ngừa phơi nhiễm trong giai đoạn cấp tính. Khi đến giai đoạn mãn tính, ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của bệnh viêm phổi quá mẫn, đặc biệt nếu bạn đã tiếp xúc với các tác nhân có hại có thể gây bệnh.';
MERGE (n:Disease {id: 'D1523'}) SET n.id = 'D1523', n.name = 'Viêm mạch quá mẫn', n.name_en = 'Hypersensitivity vasculitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000874.htm', n.prognosis = 'Viêm mạch quá mẫn thường biến mất theo thời gian. Tình trạng này có thể quay trở lại ở một số người. Những người bị viêm mạch liên tục nên được kiểm tra viêm mạch hệ thống.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng viêm mạch quá mẫn.';
MERGE (n:Disease {id: 'D1524'}) SET n.id = 'D1524', n.name = 'Bệnh cường lách', n.name_en = 'Hypersplenism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001314.htm';
MERGE (n:Disease {id: 'D1525'}) SET n.id = 'D1525', n.name = 'Bệnh tim tăng huyết áp', n.name_en = 'Hypertensive heart disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000163.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị huyết áp cao và xuất hiện bất kỳ triệu chứng nào.';
MERGE (n:Disease {id: 'D1526'}) SET n.id = 'D1526', n.name = 'Bệnh cường giáp', n.name_en = 'Hyperthyroidism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000356.htm', n.prognosis = 'Bệnh cường giáp có thể điều trị được. Một số nguyên nhân, chẳng hạn như viêm tuyến giáp, có thể biến mất mà không cần điều trị. Bệnh cường giáp do bệnh Graves thường trở nên nặng hơn theo thời gian. N', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh cường giáp. Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số điện thoại cấp cứu tại địa phương nếu bạn có: Thay đổi ý thức Ch';
MERGE (n:Disease {id: 'D1527'}) SET n.id = 'D1527', n.name = 'Bệnh cường giáp (tuyến giáp hoạt động quá mức)', n.name_en = 'Hyperthyroidism (overactive thyroid)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hyperthyroidism/symptoms-causes/syc-20373659', n.overview = 'Bệnh cường giáp xảy ra khi tuyến giáp sản xuất quá nhiều hormone tuyến giáp. Tình trạng này còn được gọi là tuyến giáp hoạt động quá mức. Bệnh cường giáp làm tăng tốc độ trao đổi chất của cơ thể. Điều', n.when_to_see = 'Nếu bạn giảm cân mà không cố gắng, hoặc nếu bạn nhận thấy nhịp tim nhanh, đổ mồ hôi bất thường, sưng tấy ở gáy hoặc các triệu chứng khác của bệnh cường giáp, hãy hẹn gặp nhà cung cấp dịch vụ chăm sóc ';
MERGE (n:Disease {id: 'D1528'}) SET n.id = 'D1528', n.name = 'Bệnh cơ tim phì đại', n.name_en = 'Hypertrophic cardiomyopathy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hypertrophic-cardiomyopathy/symptoms-causes/syc-20350198 | https://medlineplus.gov/ency/article/000192.htm', n.overview = 'bệnh lý, thành cơ tim gọi là vách ngăn thường trở nên dày hơn bình thường. Nhưng tình trạng dày lên có thể xảy ra ở bất kỳ vị trí nào trong buồng tim dưới bên trái, còn gọi là tâm thất trái. Bệnh cơ t', n.prognosis = 'Một số người mắc bệnh cơ tim phì đại có thể không có triệu chứng và sẽ có tuổi thọ bình thường. Những người khác có thể trở nên tồi tệ hơn từ từ hoặc nhanh chóng. Trong một số trường hợp, tình trạng n', n.when_to_see = 'Nhiều tình trạng có thể gây khó thở và nhịp tim đập nhanh. Điều quan trọng là phải kiểm tra kịp thời để tìm ra nguyên nhân và nhận được sự chăm sóc phù hợp. Hãy gặp chuyên gia chăm sóc sức khỏe của bạ';
MERGE (n:Disease {id: 'D1529'}) SET n.id = 'D1529', n.name = 'Tăng thông khí', n.name_en = 'Hyperventilation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003071.htm', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Bạn thở nhanh lần đầu tiên. Đây có thể là một trường hợp cấp cứu y tế mà bạn cần được đưa đến phòng cấp cứu ngay lập tức. Bạn đang bị đau, bị sốt hoặc đang chảy m';
MERGE (n:Disease {id: 'D1530'}) SET n.id = 'D1530', n.name = 'Hyperv Vitaminosis A', n.name_en = 'Hypervitaminosis A', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000350.htm', n.prognosis = 'Most people fully recover.', n.when_to_see = 'Bạn nên liên hệ với nhà cung cấp của mình: Nếu bạn nghĩ rằng bạn hoặc con bạn có thể đã uống quá nhiều vitamin A Bạn có triệu chứng dư thừa vitamin A';
MERGE (n:Disease {id: 'D1531'}) SET n.id = 'D1531', n.name = 'Chứng thừa vitamin D', n.name_en = 'Hypervitaminosis D', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001594.htm', n.prognosis = 'Dự kiến ​​sẽ phục hồi nhưng tổn thương thận vĩnh viễn có thể xảy ra.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn hoặc con bạn có các triệu chứng của chứng tăng vitamin D và đang dùng nhiều vitamin D hơn RDA Bạn hoặc con bạn có các triệu chứng và đang dùng vitamin D t';
MERGE (n:Disease {id: 'D1532'}) SET n.id = 'D1532', n.name = 'Dấu gạch nối', n.name_en = 'Hyphema', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001021.htm', n.prognosis = 'Kết quả phụ thuộc vào mức độ tổn thương ở mắt. Những người mắc bệnh hồng cầu hình liềm có nhiều khả năng bị biến chứng về mắt và phải được theo dõi chặt chẽ. Những người mắc bệnh tiểu đường có thể sẽ ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nhận thấy có máu ở phía trước mắt hoặc nếu bạn bị chấn thương ở mắt. Bạn sẽ cần được bác sĩ nhãn khoa khám và điều trị ngay lập tức, đặc biệt nếu b';
MERGE (n:Disease {id: 'D1533'}) SET n.id = 'D1533', n.name = 'Hạ đường huyết', n.name_en = 'Hypoglycemia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hypoglycemia/symptoms-causes/syc-20373685', n.overview = 'là tình trạng lượng đường trong máu (glucose) của bạn thấp hơn mức tiêu chuẩn. Glucose là nguồn năng lượng chính của cơ thể bạn. Hạ đường huyết thường liên quan đến điều trị bệnh tiểu đường. Nhưng các', n.when_to_see = 'Tìm kiếm sự trợ giúp y tế ngay lập tức nếu: Bạn có những triệu chứng có thể là hạ đường huyết và bạn không mắc bệnh tiểu đường Bạn bị tiểu đường và hạ đường huyết không đáp ứng với điều trị, chẳng hạn';
MERGE (n:Disease {id: 'D1534'}) SET n.id = 'D1534', n.name = 'Suy sinh dục', n.name_en = 'Hypogonadism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001195.htm', n.prognosis = 'Nhiều dạng suy sinh dục có thể điều trị được và có triển vọng tốt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nhận thấy: Tiết dịch vú Vú to (nam) Nóng bừng (nữ) Bất lực Rụng lông trên cơ thể Mất kinh nguyệt Vấn đề khi mang thai Vấn đề về ham muốn tình dục c';
MERGE (n:Disease {id: 'D1535'}) SET n.id = 'D1535', n.name = 'Suy sinh dục do hypogonadotropic', n.name_en = 'Hypogonadotropic hypogonadism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000390.htm', n.prognosis = 'Việc điều trị hormone phù hợp sẽ bắt đầu dậy thì ở trẻ em và có thể khôi phục khả năng sinh sản ở người lớn. Nếu tình trạng bắt đầu sau tuổi dậy thì hoặc ở tuổi trưởng thành, các triệu chứng thường sẽ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Con bạn không bắt đầu dậy thì vào thời điểm thích hợp. Bạn là phụ nữ dưới 40 tuổi và chu kỳ kinh nguyệt của bạn đã dừng lại. Bạn bị rụng lông nách hoặc lông m';
MERGE (n:Disease {id: 'D1536'}) SET n.id = 'D1536', n.name = 'Liệt chu kỳ hạ kali máu', n.name_en = 'Hypokalemic periodic paralysis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000312.htm', n.prognosis = 'HypoPP đáp ứng tốt với điều trị. Điều trị có thể ngăn ngừa và thậm chí đảo ngược tình trạng yếu cơ tiến triển. Mặc dù sức mạnh cơ ban đầu bình thường giữa các đợt tấn công, nhưng các đợt tấn công lặp ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc con bạn bị yếu cơ đến rồi đi, đặc biệt nếu bạn có thành viên trong gia đình bị liệt định kỳ. Hãy đến phòng cấp cứu hoặc gọi số khẩn cấp tại đị';
MERGE (n:Disease {id: 'D1537'}) SET n.id = 'D1537', n.name = 'Chứng giảm sắc tố Ito', n.name_en = 'Hypomelanosis of Ito', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001461.htm', n.prognosis = 'Triển vọng phụ thuộc vào loại và mức độ nghiêm trọng của các triệu chứng phát triển. Trong hầu hết các trường hợp, màu da cuối cùng sẽ trở lại bình thường.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu con bạn có màu da khác thường. Tuy nhiên, bất kỳ mô hình bất thường nào đều có thể có nguyên nhân khác ngoài HMI.';
MERGE (n:Disease {id: 'D1538'}) SET n.id = 'D1538', n.name = 'Hạ natri máu', n.name_en = 'Hyponatremia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hyponatremia/symptoms-causes/syc-20373711', n.overview = 'là tình trạng xảy ra khi nồng độ natri trong máu thấp hơn mức bình thường. Natri là chất điện giải và nó giúp điều chỉnh lượng nước trong và xung quanh tế bào của bạn. Trong tình trạng hạ natri máu, m', n.when_to_see = 'Tìm kiếm sự chăm sóc khẩn cấp cho bất kỳ ai phát triển các dấu hiệu và triệu chứng nghiêm trọng của hạ natri máu, chẳng hạn như buồn nôn và nôn, lú lẫn, co giật hoặc mất ý thức. Hãy gọi cho chuyên gia';
MERGE (n:Disease {id: 'D1539'}) SET n.id = 'D1539', n.name = 'Suy tuyến cận giáp', n.name_en = 'Hypoparathyroidism', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hypoparathyroidism/symptoms-causes/syc-20355375 | https://medlineplus.gov/ency/article/000385.htm', n.overview = 'là một tình trạng hiếm gặp trong đó cơ thể không sản xuất đủ loại hormone quan trọng gọi là hormone tuyến cận giáp (PTH). PTH giúp kiểm soát và duy trì sự cân bằng hợp lý của hai khoáng chất trong cơ ', n.prognosis = 'Kết quả có thể sẽ tốt nếu chẩn đoán sớm. Nhưng những thay đổi ở răng, đục thủy tinh thể và vôi hóa não không thể đảo ngược ở những trẻ bị suy tuyến cận giáp không được chẩn đoán trong quá trình phát t', n.when_to_see = 'Hãy kiểm tra sức khỏe nếu bạn cho rằng mình có thể có các triệu chứng của bệnh suy tuyến cận giáp. Gọi cho chuyên gia chăm sóc sức khỏe của bạn ngay lập tức nếu bạn bị co giật hoặc khó thở. Suy tuyến ';
MERGE (n:Disease {id: 'D1540'}) SET n.id = 'D1540', n.name = 'Hạ phosphat máu', n.name_en = 'Hypophosphatemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000307.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào nguyên nhân gây ra tình trạng này.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn bị yếu cơ hoặc lú lẫn.';
MERGE (n:Disease {id: 'D1541'}) SET n.id = 'D1541', n.name = 'Suy tuyến yên', n.name_en = 'Hypopituitarism', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hypopituitarism/symptoms-causes/syc-20351645 | https://medlineplus.gov/ency/article/000343.htm', n.overview = 'là một tình trạng hiếm gặp trong đó tuyến yên không tạo ra một hoặc nhiều hormone hoặc không tạo ra đủ hormone. Tuyến yên là một tuyến có kích thước bằng quả thận ở đáy não của bạn. Nó là một phần của', n.prognosis = 'Suy tuyến yên thường là vĩnh viễn. Nó đòi hỏi phải điều trị suốt đời bằng một hoặc nhiều loại thuốc. Nhưng bạn có thể mong đợi một tuổi thọ bình thường. Ở trẻ em, tình trạng suy tuyến yên do khối u có', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn phát triển bất kỳ triệu chứng nào của bệnh suy tuyến yên. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn ngay lập tức nếu các';
MERGE (n:Disease {id: 'D1542'}) SET n.id = 'D1542', n.name = 'Hội chứng thiểu sản tim trái', n.name_en = 'Hypoplastic left heart syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hypoplastic-left-heart-syndrome/symptoms-causes/syc-20350599 | https://medlineplus.gov/ency/article/001106.htm', n.overview = '(HLHS) là một bệnh tim hiếm gặp mà trẻ sinh ra đã mắc phải. Điều đó có nghĩa đó là khuyết tật tim bẩm sinh. Trong tình trạng này, phần bên trái của tim không phát triển đầy đủ và quá nhỏ. Vì vậy nó kh', n.prognosis = 'Nếu không được điều trị, hội chứng thiểu sản tim trái sẽ gây tử vong. Tỷ lệ sống sót của việc sửa chữa theo giai đoạn tiếp tục tăng khi kỹ thuật phẫu thuật và chăm sóc sau phẫu thuật được cải thiện. T', n.when_to_see = 'Nhận trợ giúp y tế khẩn cấp nếu con bạn có: Thay đổi màu da hoặc móng tay. Khó thở hoặc thở nhanh. Mạch yếu hoặc mạch nhanh. Da ẩm ướt mát lạnh. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1543'}) SET n.id = 'D1543', n.name = 'Hypospadias', n.name_en = 'Hypospadias', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hypospadias/symptoms-causes/syc-20355148 | https://medlineplus.gov/ency/article/001286.htm', n.overview = 'rethra nằm ở mặt dưới của dương vật thay vì ở đầu. Vị trí của lỗ mở có thể khác nhau và có thể ở bất cứ đâu từ bên dưới đầu dương vật (phổ biến hơn) đến gốc dương vật (ít phổ biến hơn). Hypospadias (h', n.prognosis = 'Kết quả sau phẫu thuật thường tốt. Trong một số trường hợp, cần phải phẫu thuật nhiều hơn để khắc phục: Lỗ rò (kết nối bất thường giữa niệu đạo và da) Thu hẹp niệu đạo Sự trở lại của đường cong dương ', n.when_to_see = 'Hầu hết trẻ sơ sinh mắc chứng lỗ tiểu thấp đều được chẩn đoán ngay sau khi sinh khi vẫn còn ở bệnh viện. Nhưng có thể khó xác định lỗ tiểu thấp hơn nếu chỉ có một chút thay đổi ở vị trí lỗ niệu đạo. N';
MERGE (n:Disease {id: 'D1544'}) SET n.id = 'D1544', n.name = 'Sửa chữa hyposepadias', n.name_en = 'Hypospadias repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003000.htm', n.overview = 'được thực hiện thường xuyên nhất khi các bé trai từ 6 tháng đến 2 tuổi. Phẫu thuật được thực hiện như một bệnh nhân ngoại trú. Trẻ hiếm khi phải nằm viện một đêm. Những bé trai sinh ra với tật lỗ thấp', n.prognosis = 'Cuộc phẫu thuật này kéo dài suốt đời. Hầu hết trẻ em đều khỏe mạnh sau cuộc phẫu thuật này. Dương vật sẽ trông gần như hoặc hoàn toàn bình thường và hoạt động tốt. Nếu con bạn mắc chứng lỗ tiểu thấp p';
MERGE (n:Disease {id: 'D1545'}) SET n.id = 'D1545', n.name = 'Rối loạn chức năng vùng dưới đồi', n.name_en = 'Hypothalamic dysfunction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001202.htm', n.prognosis = 'Nhiều nguyên nhân gây rối loạn chức năng vùng dưới đồi có thể điều trị được hoặc có thể khắc phục được. Trong hầu hết các trường hợp, hormone bị thiếu có thể được thay thế.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị: Đau đầu Các triệu chứng thừa hoặc thiếu hormone Các vấn đề về thị lực';
MERGE (n:Disease {id: 'D1546'}) SET n.id = 'D1546', n.name = 'Khối u vùng dưới đồi', n.name_en = 'Hypothalamic tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001211.htm', n.prognosis = 'Triển vọng phụ thuộc vào: Loại khối u (u thần kinh đệm hoặc loại khác) Vị trí của khối u Cấp độ khối u Kích thước khối u Tuổi và sức khỏe nói chung của bạn Nhìn chung, u thần kinh đệm ở người lớn nguy', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc con bạn phát triển bất kỳ triệu chứng nào của khối u vùng dưới đồi. Khám sức khỏe định kỳ có thể phát hiện sớm các dấu hiệu của vấn đề, chẳng ';
MERGE (n:Disease {id: 'D1547'}) SET n.id = 'D1547', n.name = 'Vùng dưới đồi', n.name_en = 'Hypothalamus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002380.htm', n.overview = 'BỆNH HẤP DẪN Rối loạn chức năng vùng dưới đồi có thể xảy ra do các bệnh lý, bao gồm: Nguyên nhân di truyền (thường xuất hiện khi mới sinh hoặc trong thời thơ ấu) Nhiễm trùng hoặc viêm Chấn thương do c';
MERGE (n:Disease {id: 'D1548'}) SET n.id = 'D1548', n.name = 'Hạ thân nhiệt', n.name_en = 'Hypothermia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hypothermia/symptoms-causes/syc-20352682 | https://medlineplus.gov/ency/article/000038.htm', n.overview = 'là tình trạng xảy ra khi nhiệt độ cơ thể giảm xuống dưới 95 độ F (35 độ C). Đây là một trường hợp cấp cứu y tế. Khi bị hạ thân nhiệt (hi-poe-THUR-me-uh), cơ thể mất nhiệt nhanh hơn mức có thể tạo ra n', n.when_to_see = 'Hãy gọi 911 hoặc số khẩn cấp tại địa phương của bạn nếu bạn nghi ngờ ai đó bị hạ thân nhiệt. Trong khi chờ trợ giúp khẩn cấp đến, hãy nhẹ nhàng di chuyển người đó vào trong nếu có thể. Chuyển động chó';
MERGE (n:Disease {id: 'D1549'}) SET n.id = 'D1549', n.name = 'Suy giáp', n.name_en = 'Hypothyroidism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000353.htm', n.prognosis = 'Trong hầu hết các trường hợp, mức hormone tuyến giáp trở nên bình thường khi được điều trị thích hợp. Bạn có thể sẽ phải dùng thuốc hormone tuyến giáp trong suốt quãng đời còn lại.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng suy giáp. Nếu bạn đang được điều trị bệnh suy giáp, hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị đau ngực hoặc nhịp ';
MERGE (n:Disease {id: 'D1550'}) SET n.id = 'D1550', n.name = 'Suy giáp (tuyến giáp hoạt động kém)', n.name_en = 'Hypothyroidism (underactive thyroid)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hypothyroidism/symptoms-causes/syc-20350284', n.overview = 'Suy giáp xảy ra khi tuyến giáp không sản xuất đủ hormone tuyến giáp. Tình trạng này còn được gọi là tuyến giáp hoạt động kém. Suy giáp có thể không gây ra các triệu chứng đáng chú ý ở giai đoạn đầu. T', n.when_to_see = 'Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn cảm thấy mệt mỏi vô cớ hoặc nếu bạn có các triệu chứng khác của bệnh suy giáp. Nếu bạn đang dùng thuốc nội tiết tố tuyến giáp để điều trị chứ';
MERGE (n:Disease {id: 'D1551'}) SET n.id = 'D1551', n.name = 'Giảm trương lực cơ', n.name_en = 'Hypotonia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003298.htm';
MERGE (n:Disease {id: 'D1552'}) SET n.id = 'D1552', n.name = 'Sốc giảm thể tích', n.name_en = 'Hypovolemic shock', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000167.htm', n.prognosis = 'Các triệu chứng và kết quả có thể khác nhau, tùy thuộc vào: Lượng máu/thể tích dịch bị mất Tỷ lệ mất máu/dịch Bệnh hoặc chấn thương gây ra mất mát Các tình trạng bệnh lý mãn tính tiềm ẩn, chẳng hạn nh', n.when_to_see = 'Sốc giảm thể tích là một trường hợp cấp cứu y tế. Gọi số khẩn cấp tại địa phương (chẳng hạn như 911) hoặc đưa người đó đến phòng cấp cứu.';
MERGE (n:Disease {id: 'D1553'}) SET n.id = 'D1553', n.name = 'Cắt bỏ tử cung', n.name_en = 'Hysterectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002915.htm', n.overview = 'Bạn có thể bị cắt bỏ toàn bộ hoặc một phần tử cung trong quá trình cắt bỏ tử cung. Ống dẫn trứng và buồng trứng cũng có thể bị cắt bỏ. Có nhiều cách khác nhau để thực hiện phẫu thuật cắt bỏ tử cung. N', n.prognosis = 'Bạn mất bao lâu để hồi phục tùy thuộc vào loại phẫu thuật cắt bỏ tử cung. Thời gian hồi phục trung bình là: Cắt tử cung qua đường bụng: 4 đến 6 tuần Cắt tử cung qua đường âm đạo: 3 đến 4 tuần Cắt tử c';
MERGE (n:Disease {id: 'D1554'}) SET n.id = 'D1554', n.name = 'Hysteroscopy', n.name_en = 'Hysteroscopy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007571.htm', n.overview = 'lấy tên từ một công cụ mỏng, nhẹ dùng để quan sát tử cung, được gọi là hysteroscopy. Công cụ này gửi hình ảnh bên trong tử cung tới màn hình video. Trước khi thực hiện thủ thuật, bạn sẽ được dùng thuố', n.prognosis = 'Nhà cung cấp dịch vụ của bạn sẽ cho bạn biết kết quả của thủ thuật.';
MERGE (n:Disease {id: 'D1555'}) SET n.id = 'D1555', n.name = 'Quá liều Ibuprofen', n.name_en = 'Ibuprofen overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002655.htm', n.prognosis = 'Có thể phục hồi bằng điều trị y tế kịp thời, ngoại trừ trường hợp quá liều rất lớn. Một số người có thể bị tổn thương gan hoặc thận mãn tính.';
MERGE (n:Disease {id: 'D1556'}) SET n.id = 'D1556', n.name = 'Ichthyosis Vulgaris', n.name_en = 'Ichthyosis vulgaris', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001451.htm', n.prognosis = 'Ichthyosis Vulgaris có thể gây khó chịu nhưng nó hiếm khi ảnh hưởng đến sức khỏe tổng thể của bạn. Tình trạng này thường biến mất khi trưởng thành nhưng có thể tái phát nhiều năm sau đó khi người ta g', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Các triệu chứng vẫn tiếp tục mặc dù đã điều trị Các triệu chứng trở nên tồi tệ hơn Các tổn thương da lan rộng Các triệu chứng mới phát triển';
MERGE (n:Disease {id: 'D1557'}) SET n.id = 'D1557', n.name = 'Chứng mất ngủ vô căn', n.name_en = 'Idiopathic hypersomnia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hypersomnia/symptoms-causes/syc-20362332 | https://medlineplus.gov/ency/article/000803.htm', n.overview = 'là tình trạng khiến con người rất buồn ngủ vào ban ngày ngay cả sau một đêm ngủ trọn vẹn. Những người mắc bệnh này khó thức dậy sau khi ngủ. Họ cũng có thể thức dậy trong trạng thái bối rối và mất phư', n.when_to_see = 'Hãy thảo luận về tình trạng của bạn với nhà cung cấp dịch vụ nếu bạn lặp đi lặp lại những cơn buồn ngủ ban ngày. Chúng có thể là do một vấn đề y tế cần được xét nghiệm thêm.';
MERGE (n:Disease {id: 'D1558'}) SET n.id = 'D1558', n.name = 'Tăng huyết áp nội sọ vô căn', n.name_en = 'Idiopathic intracranial hypertension', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000351.htm', n.prognosis = 'Tình trạng này đôi khi tự biến mất trong vòng 6 tháng. Các triệu chứng có thể quay trở lại ở một số người. Một số ít người có các triệu chứng dần dần trở nên trầm trọng hơn và dẫn đến mù lòa.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn hoặc con bạn có bất kỳ triệu chứng nào được liệt kê ở trên.';
MERGE (n:Disease {id: 'D1559'}) SET n.id = 'D1559', n.name = 'Xơ phổi vô căn', n.name_en = 'Idiopathic pulmonary fibrosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000069.htm', n.prognosis = 'IPF có thể cải thiện hoặc ổn định trong thời gian dài dù có hoặc không điều trị. Hầu hết mọi người trở nên tồi tệ hơn, ngay cả khi được điều trị. Khi các triệu chứng về hô hấp trở nên trầm trọng hơn, ', n.when_to_see = 'Liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu bạn có bất kỳ dấu hiệu nào sau đây: Thở khó hơn, nhanh hơn hoặc nông hơn (bạn không thể hít một hơi sâu) Cần nghiêng người về phía trước khi ngồi để t';
MERGE (n:Disease {id: 'D1560'}) SET n.id = 'D1560', n.name = 'Bệnh thận IgA', n.name_en = 'IgA nephropathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000466.htm', n.prognosis = 'Bệnh thận IgA tiến triển dần dần. Trong nhiều trường hợp, nó không trở nên tồi tệ hơn chút nào. Tình trạng của bạn có nhiều khả năng trở nên tồi tệ hơn nếu bạn bị: Huyết áp cao Lượng lớn protein trong', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có nước tiểu có máu hoặc nếu bạn sản xuất ít nước tiểu hơn bình thường.';
MERGE (n:Disease {id: 'D1561'}) SET n.id = 'D1561', n.name = 'Bệnh thận IgA (bệnh Berger)', n.name_en = 'IgA nephropathy (Berger disease)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/iga-nephropathy/symptoms-causes/syc-20352268', n.overview = 'Bệnh thận IgA (nuh-FROP-uh-thee), còn được gọi là bệnh Berger, là một bệnh về thận. Nó xảy ra khi một loại protein chống vi trùng gọi là immunoglobulin A (IgA) tích tụ trong thận. Điều này gây ra một ', n.when_to_see = 'Hãy gặp bác sĩ nếu bạn cho rằng mình có các triệu chứng của bệnh thận IgA. Điều quan trọng là phải kiểm tra nếu bạn nhận thấy có máu trong nước tiểu. Nhiều tình trạng khác nhau có thể gây ra triệu chứ';
MERGE (n:Disease {id: 'D1562'}) SET n.id = 'D1562', n.name = 'Viêm mạch máu IgA - Ban xuất huyết Henoch-Schonlein', n.name_en = 'IgA vasculitis - Henoch-Schonlein purpura', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000425.htm', n.prognosis = 'Bệnh thường tự khỏi. Hai phần ba số trẻ bị viêm mạch IgA chỉ có một đợt. Một phần ba số trẻ em có nhiều cơn hơn. Mọi người nên theo dõi y tế chặt chẽ trong 6 tháng sau các đợt bệnh để tìm dấu hiệu của', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn xuất hiện các triệu chứng của bệnh viêm mạch IgA và chúng kéo dài hơn một vài ngày. Bạn có nước tiểu có màu hoặc lượng nước tiểu ít sau một đợt.';
MERGE (n:Disease {id: 'D1563'}) SET n.id = 'D1563', n.name = 'Cắt hồi tràng', n.name_en = 'Ileostomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007378.htm', n.overview = 'Trước khi phẫu thuật để tạo đường thông hồi tràng, bạn có thể phải phẫu thuật để cắt bỏ toàn bộ đại tràng và trực tràng, hoặc chỉ một phần ruột non. Những phẫu thuật này bao gồm: Cắt bỏ ruột non Cắt b', n.prognosis = 'Hầu hết những người được phẫu thuật cắt hồi tràng đều có thể thực hiện hầu hết các hoạt động họ đã làm trước khi phẫu thuật. Điều này bao gồm hầu hết các hoạt động thể thao, du lịch, làm vườn, đi bộ đ';
MERGE (n:Disease {id: 'D1564'}) SET n.id = 'D1564', n.name = 'Rối loạn lo âu về bệnh tật', n.name_en = 'Illness anxiety disorder', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/illness-anxiety-disorder/symptoms-causes/syc-20373782 | https://medlineplus.gov/ency/article/001236.htm', n.overview = 'Các liên kết liên quan Rối loạn triệu chứng cơ thể Rối loạn lo âu về bệnh tật, đôi khi được gọi là chứng nghi bệnh hoặc lo lắng về sức khỏe, là tình trạng lo lắng quá mức rằng bạn đang hoặc có thể bị ', n.prognosis = 'Rối loạn thường kéo dài (mạn tính), trừ khi các yếu tố tâm lý hoặc rối loạn tâm trạng và lo âu được điều trị.', n.when_to_see = 'Vì các triệu chứng có thể liên quan đến các vấn đề sức khỏe nên điều quan trọng là bạn phải được nhà cung cấp dịch vụ chăm sóc chính của mình đánh giá nếu việc này chưa được thực hiện. Nếu nhà cung cấ';
MERGE (n:Disease {id: 'D1565'}) SET n.id = 'D1565', n.name = 'Hình ảnh và X quang', n.name_en = 'Imaging and radiology', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007451.htm', n.overview = 'CHẨN ĐOÁN X quang Chẩn đoán X quang giúp các nhà cung cấp dịch vụ chăm sóc sức khỏe nhìn thấy các cấu trúc bên trong cơ thể bạn. Các bác sĩ chuyên giải thích những hình ảnh này được gọi là bác sĩ X qu';
MERGE (n:Disease {id: 'D1566'}) SET n.id = 'D1566', n.name = 'Quá liều imipramine', n.name_en = 'Imipramine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002656.htm', n.prognosis = 'Quá liều imipramine có thể rất nghiêm trọng. Những người nuốt quá nhiều loại thuốc này hầu như luôn phải nhập viện. Tình trạng sức khỏe của một người sẽ phụ thuộc vào lượng thuốc được nuốt vào và thời';
MERGE (n:Disease {id: 'D1567'}) SET n.id = 'D1567', n.name = 'Thiếu máu tán huyết miễn dịch', n.name_en = 'Immune hemolytic anemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000576.htm', n.prognosis = 'Bệnh có thể khởi phát nhanh chóng và rất nghiêm trọng, hoặc có thể ở mức độ nhẹ và không cần điều trị đặc biệt. Ở hầu hết mọi người, steroid hoặc cắt lách có thể kiểm soát hoàn toàn hoặc một phần tình', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn cảm thấy mệt mỏi hoặc đau ngực không rõ nguyên nhân hoặc có dấu hiệu nhiễm trùng.';
MERGE (n:Disease {id: 'D1568'}) SET n.id = 'D1568', n.name = 'Phản ứng miễn dịch', n.name_en = 'Immune response', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000821.htm', n.overview = 'Hệ thống miễn dịch bảo vệ cơ thể khỏi các chất có thể gây hại bằng cách nhận biết và phản ứng với các kháng nguyên. Kháng nguyên là những chất (thường là protein) trên bề mặt tế bào, vi rút, nấm hoặc ';
MERGE (n:Disease {id: 'D1569'}) SET n.id = 'D1569', n.name = 'Giảm tiểu cầu miễn dịch (ITP)', n.name_en = 'Immune thrombocytopenia (ITP)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/idiopathic-thrombocytopenic-purpura/symptoms-causes/syc-20352325', n.overview = 'là một căn bệnh có thể dẫn đến bầm tím và chảy máu. Mức độ thấp của các tế bào giúp đông máu, còn được gọi là tiểu cầu, thường gây chảy máu. Từng được gọi là ban xuất huyết giảm tiểu cầu vô căn, ITP c', n.when_to_see = 'Hãy hẹn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn có các triệu chứng khiến bạn lo lắng. Chảy máu không ngừng là một trường hợp cấp cứu y tế. Tìm kiếm sự giúp đỡ ngay lập ';
MERGE (n:Disease {id: 'D1570'}) SET n.id = 'D1570', n.name = 'Ban xuất huyết giảm tiểu cầu miễn dịch (ITP)', n.name_en = 'Immune thrombocytopenic purpura (ITP)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000535.htm', n.prognosis = 'Với việc điều trị, khả năng thuyên giảm (giai đoạn không có triệu chứng) là rất cao. Trong một số ít trường hợp, ITP có thể trở thành tình trạng lâu dài ở người lớn và xuất hiện trở lại, ngay cả sau m', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu xảy ra chảy máu nghiêm trọng hoặc nếu các triệu chứng mới khác phát triển.';
MERGE (n:Disease {id: 'D1571'}) SET n.id = 'D1571', n.name = 'Bệnh suy giảm miễn dịch', n.name_en = 'Immunodeficiency diseases', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000818.htm', n.prognosis = 'Một số bệnh suy giảm miễn dịch ở mức độ nhẹ và thỉnh thoảng gây bệnh. Một số khác thì nghiêm trọng và có thể gây tử vong. Sự ức chế miễn dịch do thuốc gây ra thường biến mất sau khi ngừng thuốc.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn đang dùng hóa trị liệu hoặc corticosteroid và bạn phát triển: Sốt 100,5°F (38°C) trở lên Ho kèm khó thở Đau dạ dày Các triệu chứng mới khác Hãy đế';
MERGE (n:Disease {id: 'D1572'}) SET n.id = 'D1572', n.name = 'Răng bị ảnh hưởng', n.name_en = 'Impacted tooth', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001057.htm', n.prognosis = 'Răng bị ảnh hưởng có thể không gây ra vấn đề gì cho một số người và có thể không cần điều trị. Điều trị thường thành công nhất nếu răng gây ra các triệu chứng. Nhổ răng khôn trước 20 tuổi thường mang ', n.when_to_see = 'Hãy liên hệ với nha sĩ nếu bạn có một chiếc răng chưa mọc (hoặc răng mới mọc một phần) và bạn bị đau nướu hoặc các triệu chứng khác.';
MERGE (n:Disease {id: 'D1573'}) SET n.id = 'D1573', n.name = 'Răng khôn bị ảnh hưởng', n.name_en = 'Impacted wisdom teeth', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/wisdom-teeth/symptoms-causes/syc-20373808', n.overview = 'eth xuất hiện (mọc) trong miệng. Đôi khi một chiếc răng khôn bị mắc kẹt bên dưới bề mặt nướu của bạn và mọc ở một góc kỳ lạ, có thể gây ra vấn đề. Đây được gọi là răng khôn bị ảnh hưởng. Răng khôn, ră', n.when_to_see = 'Hãy gặp nha sĩ nếu bạn có các triệu chứng ở khu vực phía sau răng hàm cuối cùng có thể liên quan đến răng khôn bị ảnh hưởng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem';
MERGE (n:Disease {id: 'D1574'}) SET n.id = 'D1574', n.name = 'Không có hậu môn', n.name_en = 'Imperforate anus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001147.htm', n.prognosis = 'Hầu hết các khuyết tật đều có thể được khắc phục thành công bằng phẫu thuật. Hầu hết trẻ có khiếm khuyết nhẹ đều học rất tốt. Tuy nhiên, táo bón có thể là một vấn đề. Trẻ em trải qua những cuộc phẫu t', n.when_to_see = 'Vấn đề này thường gặp khi khám trẻ sơ sinh lần đầu. Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu một đứa trẻ được điều trị hậu môn không thông có: Đau bụng Táo bón khó kiểm soát Không thể kiểm soá';
MERGE (n:Disease {id: 'D1575'}) SET n.id = 'D1575', n.name = 'Sửa chữa hở hậu môn', n.name_en = 'Imperforate anus repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002926.htm', n.overview = 'Phẫu thuật này được thực hiện như thế nào tùy thuộc vào loại hở hậu môn. Phẫu thuật được thực hiện dưới gây mê toàn thân. Điều này có nghĩa là trẻ sơ sinh đang ngủ và không cảm thấy đau trong suốt quá', n.prognosis = 'Hầu hết các khiếm khuyết đều có thể được sửa chữa bằng phẫu thuật. Trẻ có khiếm khuyết nhẹ thường học rất tốt. Tuy nhiên, táo bón có thể là một vấn đề. Trẻ em trải qua những ca phẫu thuật phức tạp hơn';
MERGE (n:Disease {id: 'D1576'}) SET n.id = 'D1576', n.name = 'Bệnh chốc lở', n.name_en = 'Impetigo', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/impetigo/symptoms-causes/syc-20352352 | https://medlineplus.gov/ency/article/000860.htm', n.overview = '(im-puh-TIE-go) là một bệnh nhiễm trùng da phổ biến và rất dễ lây lan, chủ yếu ảnh hưởng đến trẻ sơ sinh và trẻ nhỏ. Nó thường xuất hiện dưới dạng vết loét màu đỏ trên mặt, đặc biệt là quanh mũi, miện', n.prognosis = 'Vết loét của bệnh chốc lở lành dần. Sẹo rất hiếm. Tỷ lệ khỏi bệnh rất cao nhưng vấn đề thường quay trở lại ở trẻ nhỏ.', n.when_to_see = 'Nếu bạn nghi ngờ mình hoặc con bạn mắc bệnh chốc lở, hãy tham khảo ý kiến ​​bác sĩ gia đình, bác sĩ nhi khoa của con bạn hoặc bác sĩ da liễu.';
MERGE (n:Disease {id: 'D1577'}) SET n.id = 'D1577', n.name = 'Máy khử rung tim có thể cấy ghép', n.name_en = 'Implantable cardioverter-defibrillator', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007370.htm', n.overview = 'ICD được tạo thành từ các bộ phận sau: Máy tạo xung có kích thước bằng một chiếc đồng hồ bỏ túi lớn. Nó chứa pin và các mạch điện đọc hoạt động điện của tim bạn. Các điện cực là những sợi dây, còn đượ', n.prognosis = 'ICD của bạn sẽ liên tục theo dõi nhịp tim của bạn để đảm bảo chúng ổn định. Nó sẽ gây sốc cho tim khi cảm nhận được nhịp điệu đe dọa tính mạng. Hầu hết các thiết bị này cũng có thể hoạt động như một m';
MERGE (n:Disease {id: 'D1578'}) SET n.id = 'D1578', n.name = 'Thụ tinh trong ống nghiệm (IVF)', n.name_en = 'In vitro fertilization (IVF)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007279.htm', n.overview = 'Thông thường, trứng và tinh trùng được thụ tinh bên trong cơ thể người phụ nữ. Nếu trứng được thụ tinh bám vào niêm mạc tử cung và tiếp tục phát triển thì khoảng 9 tháng sau đó em bé sẽ chào đời. Quá ', n.prognosis = 'khác nhau giữa các phòng khám và phải được xem xét cẩn thận. Tuy nhiên, số lượng bệnh nhân ở mỗi phòng khám là khác nhau, vì vậy tỷ lệ mang thai được báo cáo không thể được sử dụng như một dấu hiệu ch';
MERGE (n:Disease {id: 'D1579'}) SET n.id = 'D1579', n.name = 'Cổ tử cung không đủ năng lực', n.name_en = 'Incompetent cervix', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/incompetent-cervix/symptoms-causes/syc-20373836', n.overview = 'Hệ thống sinh sản nữ, tử cung, cổ tử cung và âm đạo, còn gọi là ống âm đạo, tạo nên hệ thống sinh sản nữ. Cổ tử cung yếu xảy ra khi mô cổ tử cung yếu gây ra hoặc góp phần gây ra sinh non hoặc mất thai';
MERGE (n:Disease {id: 'D1580'}) SET n.id = 'D1580', n.name = 'Chứng mất kiểm soát sắc tố', n.name_en = 'Incontinentia pigmenti', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001583.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào mức độ nghiêm trọng của sự liên quan đến hệ thần kinh trung ương và các vấn đề về mắt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn có tiền sử gia đình mắc bệnh IP và đang cân nhắc việc có con Con bạn có các triệu chứng của chứng rối loạn này';
MERGE (n:Disease {id: 'D1581'}) SET n.id = 'D1581', n.name = 'Tăng chu vi vòng đầu', n.name_en = 'Increased head circumference', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003305.htm', n.when_to_see = 'Chăm sóc sức khỏe của bạn bác sĩ thường nhận thấy kích thước đầu của trẻ tăng lên khi khám sức khỏe định kỳ cho trẻ.';
MERGE (n:Disease {id: 'D1582'}) SET n.id = 'D1582', n.name = 'Tăng áp lực nội sọ', n.name_en = 'Increased intracranial pressure', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000793.htm', n.prognosis = 'Áp lực nội sọ tăng đột ngột là tình trạng nghiêm trọng và thường đe dọa tính mạng. Điều trị kịp thời mang lại triển vọng tốt hơn. Nếu áp lực gia tăng đè lên các cấu trúc não và mạch máu quan trọng, nó';
MERGE (n:Disease {id: 'D1583'}) SET n.id = 'D1583', n.name = 'Khó tiêu', n.name_en = 'Indigestion', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/indigestion/symptoms-causes/syc-20352211 | https://medlineplus.gov/ency/article/003260.htm', n.overview = 'Hệ thống tiêu hóa gan, dạ dày, túi mật, ruột non và đại tràng. Khó tiêu là cảm giác khó chịu hoặc đau bụng. Các triệu chứng có thể bao gồm đau rát, cảm thấy no khi ăn hoặc cảm thấy no lâu sau khi ăn. ', n.when_to_see = 'Chứng khó tiêu nhẹ thường không có gì đáng lo ngại. Nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu các triệu chứng khó tiêu kéo dài hơn hai tuần. Hãy chăm sóc càng sớm càng tốt nếu bạn bị chứ';
MERGE (n:Disease {id: 'D1584'}) SET n.id = 'D1584', n.name = 'Quá liều Indomethacin', n.name_en = 'Indomethacin overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002657.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng indomethacin được nuốt vào và thời gian điều trị được tiếp nhận nhanh như thế nào. Nhận được sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Quá li';
MERGE (n:Disease {id: 'D1585'}) SET n.id = 'D1585', n.name = 'Viêm phế quản công nghiệp', n.name_en = 'Industrial bronchitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000072.htm', n.prognosis = 'Kết quả thường tốt miễn là bạn có thể ngừng tiếp xúc với chất gây kích ứng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn thường xuyên tiếp xúc với bụi, khói, axit mạnh hoặc các hóa chất khác có thể ảnh hưởng đến phổi và bạn xuất hiện các triệu chứng viêm phế quản.';
MERGE (n:Disease {id: 'D1586'}) SET n.id = 'D1586', n.name = 'Bệnh ngộ độc ở trẻ sơ sinh', n.name_en = 'Infant botulism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001384.htm', n.prognosis = 'Khi tình trạng bệnh được phát hiện và điều trị sớm, trẻ thường hồi phục hoàn toàn. Tử vong hoặc thương tật vĩnh viễn có thể dẫn đến những trường hợp phức tạp.', n.when_to_see = 'Bệnh ngộ độc ở trẻ sơ sinh có thể đe dọa tính mạng. Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương ngay lập tức nếu trẻ sơ sinh của bạn có các triệu chứng ngộ độc.';
MERGE (n:Disease {id: 'D1587'}) SET n.id = 'D1587', n.name = 'Bệnh vàng da ở trẻ sơ sinh', n.name_en = 'Infant jaundice', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/infant-jaundice/symptoms-causes/syc-20373865', n.overview = 'là màu vàng của da và mắt của trẻ sơ sinh. Nguyên nhân là do sự tích tụ sắc tố gọi là bilirubin trong máu của em bé. Vàng da ở trẻ sơ sinh là một tình trạng phổ biến, đặc biệt ở trẻ sinh trước 37 tuần', n.when_to_see = 'Hầu hết các bệnh viện đều có chính sách khám trẻ sơ sinh để phát hiện bệnh vàng da trước khi xuất viện. Học viện Nhi khoa Hoa Kỳ khuyến cáo: Trẻ sơ sinh nên được khám bệnh vàng da trong các lần khám s';
MERGE (n:Disease {id: 'D1588'}) SET n.id = 'D1588', n.name = 'Trẻ sơ sinh của bà mẹ mắc bệnh tiểu đường', n.name_en = 'Infant of diabetic mother', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001597.htm', n.prognosis = 'Trong hầu hết các trường hợp, các triệu chứng của trẻ sơ sinh sẽ biến mất trong vòng vài giờ, vài ngày hoặc vài tuần. Tuy nhiên, tim to có thể phải mất vài tháng mới khỏe lại. Rất hiếm khi lượng đường', n.when_to_see = 'Nếu bạn đang mang thai và được chăm sóc trước khi sinh thường xuyên, xét nghiệm định kỳ sẽ cho biết bạn có mắc bệnh tiểu đường thai kỳ hay không. Nếu bạn đang mang thai hoặc dự định mang thai và mắc b';
MERGE (n:Disease {id: 'D1589'}) SET n.id = 'D1589', n.name = 'Phản xạ của trẻ sơ sinh', n.name_en = 'Infant reflexes', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003292.htm', n.when_to_see = 'Nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn thường sẽ phát hiện ra phản xạ bất thường của trẻ sơ sinh trong một cuộc kiểm tra được thực hiện vì lý do khác. Phản xạ kéo dài hơn bình thường có thể là';
MERGE (n:Disease {id: 'D1590'}) SET n.id = 'D1590', n.name = 'Trào ngược ở trẻ sơ sinh', n.name_en = 'Infant reflux', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/infant-acid-reflux/symptoms-causes/syc-20351408', n.overview = 'Trào ngược axit ở trẻ sơ sinh sẽ giãn ra khi dạ dày no, thức ăn có thể trào ngược lên thực quản của trẻ. Cơ này được gọi là cơ thắt thực quản dưới. Trào ngược ở trẻ sơ sinh là hiện tượng trẻ nôn ra ch', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe nếu em bé: Không tăng cân. Liên tục khạc nhổ mạnh khiến các chất trong dạ dày trào ra khỏi miệng. Điều này được gọi là nôn mửa. Nhổ ra chất lỏng màu xanh lá câ';
MERGE (n:Disease {id: 'D1591'}) SET n.id = 'D1591', n.name = 'Chuẩn bị quy trình kiểm tra trẻ sơ sinh', n.name_en = 'Infant test procedure preparation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002055.htm', n.overview = 'Hãy lưu ý rằng trẻ sơ sinh của bạn có thể sẽ khóc và có thể phải sử dụng dụng cụ kiềm chế. Bạn có thể giúp trẻ vượt qua quá trình này nhiều nhất bằng cách có mặt và thể hiện sự quan tâm của bạn. Khóc ';
MERGE (n:Disease {id: 'D1592'}) SET n.id = 'D1592', n.name = 'Bệnh truyền nhiễm', n.name_en = 'Infectious diseases', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/infectious-diseases/symptoms-causes/syc-20351173', n.overview = 'là những căn bệnh xảy ra khi những sinh vật nhỏ bé xâm nhập vào cơ thể và nhân lên. Vi khuẩn, vi rút, nấm và ký sinh trùng là những ví dụ về sinh vật có thể gây bệnh. Nhiều sinh vật sống trong và trên', n.when_to_see = 'Hãy gọi cho chuyên gia chăm sóc sức khỏe của bạn nếu bạn: Đã bị động vật cắn. Khó thở. Ho kéo dài hơn một tuần hoặc ho ra chất nhầy hoặc máu màu vàng xanh. Bị nhức đầu dữ dội kèm theo sốt. Bị phát ban';
MERGE (n:Disease {id: 'D1593'}) SET n.id = 'D1593', n.name = 'Viêm thực quản truyền nhiễm', n.name_en = 'Infectious esophagitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000646.htm', n.prognosis = 'Ở những người có hệ miễn dịch khỏe mạnh, bệnh viêm thực quản thường tự khỏi. Những người có hệ thống miễn dịch yếu có thể mất nhiều thời gian hơn để khỏi bệnh.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn mắc bất kỳ tình trạng nào có thể làm giảm phản ứng miễn dịch và bạn xuất hiện các triệu chứng của viêm thực quản truyền nhiễm.';
