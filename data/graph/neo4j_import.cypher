MERGE (n:Disease {id: 'D0437'}) SET n.id = 'D0437', n.name = 'Thở - chậm lại hoặc ngừng thở', n.name_en = 'Breathing - slowed or stopped', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003069.htm', n.when_to_see = 'Tìm kiếm sự chăm sóc y tế ngay lập tức hoặc gọi số cấp cứu tại địa phương của bạn (chẳng hạn như 911) nếu một người có bất kỳ loại vấn đề về hô hấp nào: Đi khập khiễng Bị co giật Không tỉnh táo (mất ý';
MERGE (n:Disease {id: 'D0438'}) SET n.id = 'D0438', n.name = 'Khó thở - sơ cứu', n.name_en = 'Breathing difficulties - first aid', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000007.htm', n.when_to_see = 'Hãy gọi 911 hoặc số điện thoại khẩn cấp tại địa phương của bạn nếu bạn hoặc người khác có bất kỳ triệu chứng khó thở nào, trong phần Triệu chứng ở trên. Ngoài ra, hãy liên hệ ngay với nhà cung cấp dịc';
MERGE (n:Disease {id: 'D0439'}) SET n.id = 'D0439', n.name = 'Khó thở', n.name_en = 'Breathing difficulty', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003075.htm', n.when_to_see = 'Đến phòng cấp cứu hoặc gọi số cấp cứu địa phương (chẳng hạn như 911) nếu: Khó thở xuất hiện đột ngột hoặc cản trở nghiêm trọng đến hơi thở và thậm chí cả việc nói chuyện của bạn Ai đó ngừng thở hoàn t';
MERGE (n:Disease {id: 'D0440'}) SET n.id = 'D0440', n.name = 'Khó thở - nằm xuống', n.name_en = 'Breathing difficulty - lying down', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003076.htm', n.when_to_see = 'Nếu bạn gặp khó thở khi nằm không rõ nguyên nhân, hãy gọi cho nhà cung cấp dịch vụ của bạn.';
MERGE (n:Disease {id: 'D0441'}) SET n.id = 'D0441', n.name = 'Rối loạn tâm thần ngắn hạn', n.name_en = 'Brief psychotic disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001529.htm', n.prognosis = 'Hầu hết những người mắc chứng rối loạn này đều có kết quả tốt. Các giai đoạn lặp lại có thể xảy ra để phản ứng với căng thẳng.', n.when_to_see = 'Hãy gọi để đặt lịch hẹn với chuyên gia sức khỏe tâm thần nếu bạn có các triệu chứng của chứng rối loạn này. Nếu bạn hoặc ai đó bạn biết đang nghĩ đến việc tự tử, hãy gọi hoặc nhắn tin tới 988 hoặc trò';
MERGE (n:Disease {id: 'D0442'}) SET n.id = 'D0442', n.name = 'Sự kiện không giải thích được được giải quyết ngắn gọn - BRUE', n.name_en = 'Brief resolved unexplained event - BRUE', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007683.htm', n.prognosis = 'Thông thường, những hiện tượng này vô hại và không phải là dấu hiệu của các vấn đề sức khỏe nghiêm trọng hơn hoặc tử vong. BRUE dường như không phải là yếu tố rủi ro đối với SIDS. Hầu hết nạn nhân của', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp của bạn nếu nghi ngờ có hành vi lạm dụng trẻ em. Các dấu hiệu lạm dụng có thể bao gồm: Ngộ độc hoặc chấn thương đầu không phải do tai nạn Gây ra bầm tím hoặc các dấu ';
MERGE (n:Disease {id: 'D0443'}) SET n.id = 'D0443', n.name = 'Sống mũi rộng', n.name_en = 'Broad nasal bridge', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003057.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn cảm thấy hình dạng mũi của con bạn đang cản trở hơi thở Bạn có thắc mắc về mũi của con bạn';
MERGE (n:Disease {id: 'D0444'}) SET n.id = 'D0444', n.name = 'Gãy mắt cá chân', n.name_en = 'Broken ankle', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/broken-ankle/symptoms-causes/syc-20450025', n.overview = 'Gãy mắt cá chân, còn gọi là gãy mắt cá chân, là chấn thương ở một hoặc nhiều xương tạo nên khớp mắt cá chân. Mắt cá chân có thể bị gãy do chấn thương xoắn, bước nhầm hoặc ngã, chấn thương khi chơi thể', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu mắt cá chân bị mất hình dạng, nếu cơn đau và sưng tấy không thuyên giảm khi tự chăm sóc hoặc nếu cơn đau và sưng tấy trở nên trầm trọng hơn theo thời gian. Bạn';
MERGE (n:Disease {id: 'D0445'}) SET n.id = 'D0445', n.name = 'Gãy cánh tay', n.name_en = 'Broken arm', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/broken-arm/symptoms-causes/syc-20353260', n.overview = 'Xương cánh tay rus) và hai xương cẳng tay (xương trụ và xương quay). Thuật ngữ "gãy tay" có thể ám chỉ tình trạng gãy xương ở bất kỳ xương nào trong số này. Gãy cánh tay liên quan đến một hoặc nhiều x', n.when_to_see = 'Nếu bạn bị đau ở cánh tay đến mức không thể sử dụng bình thường thì hãy đi khám bác sĩ ngay. Điều tương tự cũng áp dụng cho con của bạn. Sự chậm trễ trong chẩn đoán và điều trị gãy tay, đặc biệt đối v';
MERGE (n:Disease {id: 'D0446'}) SET n.id = 'D0446', n.name = 'Gãy xương', n.name_en = 'Broken bone', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000001.htm', n.when_to_see = 'Hãy gọi 911 hoặc số khẩn cấp tại địa phương nếu: Người đó không phản ứng hoặc bất tỉnh. Nghi ngờ có xương bị gãy ở đầu, cổ hoặc lưng. Nghi ngờ bị gãy xương ở hông, xương chậu hoặc cẳng chân. Bạn không';
MERGE (n:Disease {id: 'D0447'}) SET n.id = 'D0447', n.name = 'Gãy xương đòn', n.name_en = 'Broken collarbone', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/broken-collarbone/symptoms-causes/syc-20370311', n.overview = 'và xương bả vai. Gãy xương đòn là một chấn thương phổ biến gây đau và sưng tấy khi gãy. Gãy xương đòn là một chấn thương phổ biến. Xương đòn hay còn gọi là xương đòn, nối xương bả vai với xương ức. Ng', n.when_to_see = 'Nếu bạn nhận thấy các triệu chứng gãy xương đòn hoặc đau đến mức không thể sử dụng cánh tay như bình thường, hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe ngay lập tức. Chờ đợi để được điều trị c';
MERGE (n:Disease {id: 'D0448'}) SET n.id = 'D0448', n.name = 'Gãy bàn chân', n.name_en = 'Broken foot', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/broken-foot/symptoms-causes/syc-20355492', n.overview = 'Xương bàn chân là một hoặc nhiều xương ở bàn chân. Gãy bàn chân hay còn gọi là gãy xương bàn chân là tình trạng chấn thương ở một hoặc nhiều xương ở bàn chân. Xương có thể bị gãy do chấn thương khi ch', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe nếu bàn chân của bạn bị mất hình dạng, nếu cơn đau và sưng tấy không thuyên giảm khi tự chăm sóc hoặc nếu cơn đau và sưng tấy trở nên trầm trọng hơn theo thời ';
MERGE (n:Disease {id: 'D0449'}) SET n.id = 'D0449', n.name = 'Gãy tay', n.name_en = 'Broken hand', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/broken-hand/symptoms-causes/syc-20450240', n.overview = 'Gãy tay xảy ra khi một hoặc nhiều xương trên bàn tay của bạn bị gãy hoặc nứt, thường là do bị ngã. Khi ngã, người ta đưa tay ra để đỡ lấy mình. Chuyển động này là bản năng. Điều này có thể dẫn đến gãy';
MERGE (n:Disease {id: 'D0450'}) SET n.id = 'D0450', n.name = 'Hội chứng trái tim tan vỡ', n.name_en = 'Broken heart syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/broken-heart-syndrome/symptoms-causes/syc-20354617', n.overview = 'là một bệnh về tim thường xảy ra do những tình huống căng thẳng và cảm xúc cực độ. Tình trạng này cũng có thể được kích hoạt bởi một bệnh lý nghiêm trọng hoặc do phẫu thuật. Hội chứng trái tim tan vỡ ', n.when_to_see = 'Bất kỳ cơn đau ngực nào tiếp tục có thể là do cơn đau tim. Gọi 911 hoặc số khẩn cấp tại địa phương nếu bạn bị đau ngực mới hoặc không giải thích được. Cũng hãy gọi nếu bạn có nhịp tim rất nhanh hoặc k';
MERGE (n:Disease {id: 'D0451'}) SET n.id = 'D0451', n.name = 'Gãy chân', n.name_en = 'Broken leg', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/broken-leg/symptoms-causes/syc-20370412', n.overview = 'Gãy chân (gãy xương ở chân) là tình trạng gãy hoặc nứt một trong các xương ở chân của bạn. Các nguyên nhân phổ biến bao gồm té ngã, tai nạn xe cơ giới và chấn thương thể thao. Điều trị gãy chân phụ th', n.when_to_see = 'Nếu bạn hoặc con bạn có bất kỳ dấu hiệu hoặc triệu chứng nào của gãy chân, hãy tìm kiếm sự chăm sóc ngay lập tức. Sự chậm trễ trong chẩn đoán và điều trị có thể dẫn đến các vấn đề sau này, bao gồm cả ';
MERGE (n:Disease {id: 'D0452'}) SET n.id = 'D0452', n.name = 'Mũi gãy', n.name_en = 'Broken nose', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/broken-nose/symptoms-causes/syc-20370439', n.overview = 'Mũi gãy hay còn gọi là gãy mũi, là vết nứt hoặc gãy một trong các xương ở mũi. Thông thường, xương ở sống mũi của bạn sẽ bị gãy. Các nguyên nhân phổ biến gây gãy mũi bao gồm chơi thể thao, đánh nhau v', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế khẩn cấp nếu bạn bị chấn thương ở mũi cùng với bất kỳ triệu chứng nào sau đây: Có thể bị chấn thương ở đầu hoặc cổ với các triệu chứng như nhức đầu dữ dội, đau cổ, nôn mử';
MERGE (n:Disease {id: 'D0453'}) SET n.id = 'D0453', n.name = 'Hàm bị gãy hoặc trật khớp', n.name_en = 'Broken or dislocated jaw', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000019.htm', n.when_to_see = 'Hàm bị gãy hoặc trật khớp cần được chăm sóc y tế kịp thời. Các triệu chứng cấp cứu bao gồm khó thở hoặc chảy máu nhiều.';
MERGE (n:Disease {id: 'D0454'}) SET n.id = 'D0454', n.name = 'Răng bị gãy hoặc rụng', n.name_en = 'Broken or knocked out tooth', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000058.htm', n.when_to_see = 'Hãy liên hệ ngay với nha sĩ khi răng bị gãy hoặc bị lung lay. Nếu bạn có thể tìm thấy chiếc răng, hãy mang nó đến nha sĩ. Thực hiện theo các bước trong phần Sơ cứu ở trên. Nếu bạn không thể khép răng ';
MERGE (n:Disease {id: 'D0455'}) SET n.id = 'D0455', n.name = 'Gãy xương sườn', n.name_en = 'Broken ribs', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/broken-ribs/symptoms-causes/syc-20350763', n.overview = 'e gãy hoặc nứt. Gãy xương sườn là một chấn thương phổ biến xảy ra khi một trong các xương trong khung xương sườn bị gãy hoặc nứt. Nguyên nhân phổ biến nhất là tác động mạnh do té ngã, tai nạn ô tô hoặ', n.when_to_see = 'Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe nếu một phần vùng xương sườn của bạn bị đau sau một tai nạn hoặc nếu bạn khó thở hoặc đau khi thở sâu. Hãy tìm kiếm sự trợ giúp y tế ngay lập tức nếu';
MERGE (n:Disease {id: 'D0456'}) SET n.id = 'D0456', n.name = 'Gãy ngón chân', n.name_en = 'Broken toe', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/broken-toe/symptoms-causes/syc-20370463', n.overview = 'Gãy ngón chân là một chấn thương phổ biến, thường xảy ra do làm rơi vật gì đó vào bàn chân hoặc vấp ngón chân. Thông thường, điều trị ngón chân bị gãy bao gồm việc băng nó vào ngón chân bên cạnh. Nhưn', n.when_to_see = 'Hãy tham khảo ý kiến ​​của nhà cung cấp dịch vụ chăm sóc sức khỏe nếu cơn đau, sưng tấy và thay đổi màu da kéo dài hơn một vài ngày hoặc nếu vết thương ảnh hưởng đến việc đi lại hoặc mang giày.';
MERGE (n:Disease {id: 'D0457'}) SET n.id = 'D0457', n.name = 'Gãy cổ tay', n.name_en = 'Broken wrist', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/broken-wrist/symptoms-causes/syc-20353169', n.overview = 'Xương bàn tay và xương cổ tay, được gọi là xương ống cổ tay, cộng với hai xương dài ở cẳng tay của bạn - xương quay và xương trụ. Mỗi ngón tay bao gồm một xương bàn tay (metacarpal) và ba xương ngón t', n.when_to_see = 'Nếu bạn nghĩ mình có thể bị gãy cổ tay, hãy đến gặp bác sĩ ngay. Nếu bạn bị tê, sưng tấy hoặc khó cử động ngón tay, hãy tìm kiếm sự chăm sóc y tế ngay lập tức. Trì hoãn chẩn đoán và điều trị có thể dẫ';
MERGE (n:Disease {id: 'D0458'}) SET n.id = 'D0458', n.name = 'Quá liều brompheniramine', n.name_en = 'Brompheniramine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002601.htm', n.prognosis = 'Nếu người đó sống sót sau 24 giờ đầu tiên, cơ hội sống sót là rất cao. Rất ít người thực sự chết vì dùng thuốc kháng histamine quá liều. Tuy nhiên, với liều lượng rất cao thuốc kháng histamine có thể ';
MERGE (n:Disease {id: 'D0459'}) SET n.id = 'D0459', n.name = 'Giãn phế quản', n.name_en = 'Bronchiectasis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000144.htm', n.prognosis = 'Triển vọng phụ thuộc vào nguyên nhân cụ thể của bệnh. Khi được điều trị, hầu hết mọi người đều sống mà không bị khuyết tật nặng và bệnh tiến triển chậm.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị đau ngực hoặc khó thở ngày càng nặng hơn Có sự thay đổi về màu sắc hoặc lượng đờm mà bạn ho ra hoặc có máu Các triệu chứng khác trở nên tồi tệ hơn ';
MERGE (n:Disease {id: 'D0460'}) SET n.id = 'D0460', n.name = 'Viêm tiểu phế quản', n.name_en = 'Bronchiolitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/bronchiolitis/symptoms-causes/syc-20351565 | https://medlineplus.gov/ency/article/000975.htm', n.overview = 'Các tiểu phế quản và phế nang trong phổi r phổi, đường dẫn khí chính, được gọi là phế quản, phân nhánh thành các lối đi ngày càng nhỏ hơn. Đường dẫn khí nhỏ nhất, được gọi là tiểu phế quản, dẫn đến cá', n.prognosis = 'Hơi thở thường trở nên tốt hơn vào ngày thứ ba và hầu hết các triệu chứng sẽ rõ ràng trong vòng một tuần. Trong một số ít trường hợp, bệnh viêm phổi hoặc các vấn đề nghiêm trọng hơn về hô hấp sẽ phát ', n.when_to_see = 'Nếu các triệu chứng trở nên nghiêm trọng, hãy gọi cho nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn. Điều này đặc biệt quan trọng nếu con bạn dưới 12 tuần tuổi hoặc có các yếu tố nguy cơ khác gây';
MERGE (n:Disease {id: 'D0461'}) SET n.id = 'D0461', n.name = 'Viêm phế quản', n.name_en = 'Bronchitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bronchitis/symptoms-causes/syc-20355566', n.overview = 'là tình trạng viêm niêm mạc ống phế quản của bạn. Những ống này mang không khí đến và đi từ phổi của bạn. Những người bị viêm phế quản thường ho ra chất nhầy đặc, có thể bị đổi màu. Viêm phế quản có t', n.when_to_see = 'Hãy liên hệ với bác sĩ hoặc phòng khám để được tư vấn nếu cơn ho của bạn: Kèm theo sốt cao hơn 100,4 F (38 C). Tạo ra máu. Có liên quan đến tình trạng khó thở hoặc thở khò khè nghiêm trọng hoặc trầm t';
MERGE (n:Disease {id: 'D0462'}) SET n.id = 'D0462', n.name = 'Chứng loạn sản phế quản phổi', n.name_en = 'Bronchopulmonary dysplasia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001088.htm', n.prognosis = 'Trẻ mắc bệnh BPD sẽ thuyên giảm dần theo thời gian. Liệu pháp oxy có thể cần thiết trong nhiều tháng. Một số trẻ sơ sinh bị tổn thương phổi lâu dài và cần được hỗ trợ thở và thở oxy, chẳng hạn như dùn', n.when_to_see = 'Nếu con bạn mắc bệnh BPD, hãy theo dõi mọi vấn đề về hô hấp. Liên hệ với nhà cung cấp dịch vụ của con bạn nếu bạn thấy bất kỳ dấu hiệu nhiễm trùng đường hô hấp nào.';
MERGE (n:Disease {id: 'D0463'}) SET n.id = 'D0463', n.name = 'Nhện ẩn dật màu nâu', n.name_en = 'Brown recluse spider', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002859.htm', n.prognosis = 'Với sự chăm sóc y tế thích hợp, khả năng sống sót sau 48 giờ thường là dấu hiệu cho thấy quá trình hồi phục sẽ diễn ra. Ngay cả khi được điều trị thích hợp và nhanh chóng, các triệu chứng có thể kéo d';
MERGE (n:Disease {id: 'D0464'}) SET n.id = 'D0464', n.name = 'Brucellosis', n.name_en = 'Brucellosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/brucellosis/symptoms-causes/syc-20351738 | https://medlineplus.gov/ency/article/000597.htm', n.overview = 'là một bệnh nhiễm trùng do vi khuẩn gây ra. Nó lây lan từ động vật sang người. Thông thường, mọi người mắc bệnh brucellosis do ăn các sản phẩm sữa tươi hoặc chưa được xử lý để an toàn hơn, được gọi là', n.prognosis = 'Các triệu chứng có thể đến và đi trong nhiều năm. Ngoài ra, bệnh có thể tái phát sau một thời gian dài mà không có triệu chứng.', n.when_to_see = 'Bệnh Brucellosis có thể khó chẩn đoán, đặc biệt là ở giai đoạn đầu. Vào thời điểm đó, nó thường giống như các tình trạng khác, chẳng hạn như bệnh cúm. Hãy hẹn khám bác sĩ nếu bạn có nguy cơ mắc bệnh b';
MERGE (n:Disease {id: 'D0465'}) SET n.id = 'D0465', n.name = 'Hội chứng Brugada', n.name_en = 'Brugada syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/brugada-syndrome/symptoms-causes/syc-20370489', n.overview = 'Hội chứng Brugada (brew-GAH-dah) là một tình trạng nhịp tim (rối loạn nhịp tim) hiếm gặp nhưng có khả năng đe dọa tính mạng, đôi khi do di truyền. Những người mắc hội chứng Brugada có nguy cơ gia tăng', n.when_to_see = 'Các dấu hiệu và triệu chứng của hội chứng Brugada tương tự như một số rối loạn nhịp tim khác. Điều quan trọng là bạn phải gặp nhà cung cấp dịch vụ chăm sóc sức khỏe để tìm hiểu xem hội chứng Brugada h';
MERGE (n:Disease {id: 'D0466'}) SET n.id = 'D0466', n.name = 'Vết bầm tím', n.name_en = 'Bruise', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007213.htm', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn cảm thấy áp lực cực độ ở phần cơ thể bị bầm tím, đặc biệt nếu vùng đó rộng hoặc rất đau. Điều này có thể là do hội chứng kho';
MERGE (n:Disease {id: 'D0467'}) SET n.id = 'D0467', n.name = 'Chứng nghiến răng', n.name_en = 'Bruxism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001413.htm', n.prognosis = 'Nghiến răng không phải là một chứng rối loạn nguy hiểm. Tuy nhiên, nó có thể gây tổn thương vĩnh viễn cho răng và gây đau hàm khó chịu, đau đầu hoặc đau tai…', n.when_to_see = 'Hãy gặp nha sĩ ngay nếu bạn gặp khó khăn khi ăn uống hoặc há miệng. Hãy nhớ rằng rất nhiều tình trạng có thể xảy ra, từ viêm khớp đến chấn thương do chấn thương cổ, đều có thể gây ra các triệu chứng T';
MERGE (n:Disease {id: 'D0468'}) SET n.id = 'D0468', n.name = 'Bệnh Buerger', n.name_en = 'Buerger disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/buergers-disease/symptoms-causes/syc-20350658', n.overview = 'chân tay anh ấy bị tắc nghẽn do huyết khối. Theo thời gian, mô da bị tổn thương hoặc bị phá hủy. Các vết loét mở, đau đớn phát triển trên ngón chân và ngón tay. Không sử dụng thuốc lá là cách tốt nhất', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn cho rằng mình có các triệu chứng của bệnh Buerger. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0469'}) SET n.id = 'D0469', n.name = 'An toàn khi đuổi côn trùng', n.name_en = 'Bug repellent safety', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001969.htm', n.overview = 'Cách đuổi côn trùng an toàn nhất là mặc quần áo phù hợp. Đội mũ đầy đủ vành để bảo vệ đầu và sau gáy. Hãy chắc chắn rằng mắt cá chân và cổ tay của bạn được che phủ. Nhét ống quần vào tất. Mặc quần áo ';
MERGE (n:Disease {id: 'D0470'}) SET n.id = 'D0470', n.name = 'Ngộ độc thuốc xịt côn trùng', n.name_en = 'Bug spray poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002763.htm', n.prognosis = 'Đối với thuốc xịt có chứa pyrethrins: Khi tiếp xúc đơn giản hoặc hít phải một lượng nhỏ, quá trình phục hồi sẽ xảy ra. Khó thở nghiêm trọng có thể nhanh chóng đe dọa tính mạng. Đối với thuốc xịt có ch';
MERGE (n:Disease {id: 'D0471'}) SET n.id = 'D0471', n.name = 'Chứng cuồng ăn', n.name_en = 'Bulimia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000341.htm', n.prognosis = 'Bulimia là một căn bệnh lâu dài. Nhiều người vẫn sẽ có một số triệu chứng, ngay cả khi điều trị. Những người có ít biến chứng y khoa hơn về chứng cuồng ăn và những người sẵn sàng và có thể tham gia tr', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn để lấy hẹn nếu bạn hoặc con bạn có các triệu chứng rối loạn ăn uống. Nếu bạn hoặc ai đó bạn biết đang nghĩ đến việc tự tử, hãy gọi hoặc n';
MERGE (n:Disease {id: 'D0472'}) SET n.id = 'D0472', n.name = 'Bulimia nervosa', n.name_en = 'Bulimia nervosa', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bulimia/symptoms-causes/syc-20353615', n.overview = 'Bulimia (boo-LEE-me-uh) nervosa, thường được gọi là chứng cuồng ăn, là một chứng rối loạn ăn uống nghiêm trọng, có khả năng đe dọa tính mạng. Những người mắc chứng cuồng ăn vô độ. Điều này có nghĩa là', n.when_to_see = 'Nếu bạn có bất kỳ triệu chứng cuồng ăn nào, hãy tìm kiếm sự trợ giúp y tế ngay lập tức. Nếu không được điều trị, chứng cuồng ăn có thể ảnh hưởng nghiêm trọng đến sức khỏe thể chất và tinh thần của bạn';
MERGE (n:Disease {id: 'D0473'}) SET n.id = 'D0473', n.name = 'Pemphigoid bọng nước', n.name_en = 'Bullous pemphigoid', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/bullous-pemphigoid/symptoms-causes/syc-20350414 | https://medlineplus.gov/ency/article/000883.htm', n.overview = 'nhiều mụn nước. Khi các mụn nước vỡ ra, chúng sẽ để lại vết loét thường lành mà không để lại sẹo. Pemphigoid bọng nước (BUL-us PEM-fih-goid) là một tình trạng da hiếm gặp gây ra các mụn nước lớn chứa ', n.prognosis = 'Pemphigoid bọng nước thường đáp ứng tốt với điều trị. Thuốc thường có thể được dừng lại sau vài năm. Bệnh đôi khi tái phát sau khi ngừng điều trị.', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn có: Các vết phồng rộp không rõ nguyên nhân. Mụn nước trên mắt của bạn. Một bệnh nhiễm trùng. Các mụn nước đang mở ra và rò rỉ. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0474'}) SET n.id = 'D0474', n.name = 'Khối nhánh bó', n.name_en = 'Bundle branch block', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bundle-branch-block/symptoms-causes/syc-20370514', n.overview = 'là tình trạng có sự chậm trễ hoặc tắc nghẽn dọc theo con đường mà các xung điện truyền đi để làm cho tim đập. Đôi khi nó khiến tim khó bơm máu đến phần còn lại của cơ thể. Sự chậm trễ hoặc tắc nghẽn c', n.when_to_see = 'Nếu bạn bị ngất, hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe để loại trừ những nguyên nhân nghiêm trọng. Nếu bạn bị bệnh tim hoặc đã được chẩn đoán mắc block nhánh bó, hãy hỏi nhà cung cấp dịch';
MERGE (n:Disease {id: 'D0475'}) SET n.id = 'D0475', n.name = 'Loại bỏ Bunion', n.name_en = 'Bunion removal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002962.htm', n.overview = 'Bạn sẽ được gây mê (thuốc gây tê) để không cảm thấy đau. Gây tê cục bộ - Bàn chân của bạn có thể bị tê bằng thuốc giảm đau. Bạn cũng có thể được cho thuốc giúp bạn thư giãn. Bạn sẽ tỉnh táo. Gây tê tủ', n.prognosis = 'Bạn sẽ bớt đau hơn sau khi loại bỏ búi tóc và bàn chân của bạn đã lành. Bạn cũng có thể đi lại và mang giày dễ dàng hơn. Phẫu thuật này có thể sửa chữa một số biến dạng ở bàn chân của bạn, nhưng nó sẽ';
MERGE (n:Disease {id: 'D0476'}) SET n.id = 'D0476', n.name = 'Bunions', n.name_en = 'Bunions', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/bunions/symptoms-causes/syc-20354799 | https://medlineplus.gov/ency/article/001231.htm', n.overview = 'Bunion là một vết sưng xương hình thành trên khớp ở gốc ngón chân cái. Nó xảy ra khi một số xương ở phần trước của bàn chân di chuyển ra khỏi vị trí bình thường. Điều này khiến ngón chân cái bị kéo về', n.prognosis = 'Bạn có thể giữ cho búi tóc không bị nặng hơn bằng cách chăm sóc nó. Cố gắng mang những đôi giày khác nhau khi nó bắt đầu phát triển. Thanh thiếu niên có thể gặp nhiều khó khăn hơn khi điều trị búi tóc', n.when_to_see = 'Bunions thường không cần điều trị y tế. Nhưng một số triệu chứng cần được một thành viên trong nhóm chăm sóc sức khỏe của bạn kiểm tra. Hoặc bạn có thể gặp bác sĩ điều trị các bệnh về bàn chân, được g';
MERGE (n:Disease {id: 'D0477'}) SET n.id = 'D0477', n.name = 'Ung thư hạch Burkitt', n.name_en = 'Burkitt lymphoma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/burkitt-lymphoma/symptoms-causes/syc-20584512 | https://medlineplus.gov/ency/article/001308.htm', n.overview = 'là một loại ung thư hạch. Ung thư hạch là bệnh ung thư ảnh hưởng đến hệ bạch huyết. Hệ bạch huyết được tạo thành từ các cơ quan, tuyến, mạch dạng ống và cụm tế bào gọi là hạch bạch huyết. Nó là một ph', n.prognosis = 'Hơn một nửa số người mắc bệnh BL có thể được chữa khỏi bằng hóa trị liệu chuyên sâu. Tỷ lệ chữa khỏi có thể thấp hơn nếu ung thư lan đến tủy xương hoặc dịch tủy sống. Triển vọng sẽ kém nếu ung thư qua', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0478'}) SET n.id = 'D0478', n.name = 'Hội chứng bỏng miệng', n.name_en = 'Burning mouth syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/burning-mouth-syndrome/symptoms-causes/syc-20350911', n.overview = 'là thuật ngữ y tế chỉ tình trạng bỏng rát liên tục hoặc tái phát trong miệng mà không có nguyên nhân rõ ràng. Bạn có thể cảm thấy nóng rát ở lưỡi, nướu, môi, bên trong má, vòm miệng hoặc các khu vực r', n.when_to_see = 'Nếu bạn cảm thấy khó chịu, nóng rát hoặc đau nhức ở lưỡi, môi, nướu hoặc các vùng khác trong miệng, hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe hoặc nha sĩ. Họ có thể cần phải làm việc cùng nha';
MERGE (n:Disease {id: 'D0479'}) SET n.id = 'D0479', n.name = 'Bỏng', n.name_en = 'Burns', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/burns/symptoms-causes/syc-20370539 | https://medlineplus.gov/ency/article/000030.htm', n.overview = 'Bỏng cấp độ hai. Nó ảnh hưởng đến lớp da thứ nhất và thứ hai, được gọi là lớp biểu bì và lớp hạ bì. Các mụn nước có thể phát triển và cơn đau có thể rất khủng khiếp. Bỏng là tổn thương mô do tiếp xúc ', n.when_to_see = 'Gọi 911 hoặc tìm kiếm sự chăm sóc ngay lập tức đối với: Vết bỏng có thể sâu, liên quan đến tất cả các lớp da. Vết bỏng khiến da bị khô và sần sùi. Vết bỏng trông cháy thành than hoặc có mảng màu trắng';
MERGE (n:Disease {id: 'D0480'}) SET n.id = 'D0480', n.name = 'Viêm bao hoạt dịch', n.name_en = 'Bursitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/bursitis/symptoms-causes/syc-20353242 | https://medlineplus.gov/ency/article/000419.htm', n.overview = 'Bao hoạt dịch ở vai bị co thắt giữa các bộ phận chuyển động trong các khớp của cơ thể bạn. Viêm bao hoạt dịch vai là tình trạng viêm hoặc kích ứng một bao hoạt dịch (màu xanh lam) ở vai của bạn. Bao h', n.prognosis = 'Hầu hết mọi người đều thành công sau khi điều trị. Khi không thể khắc phục được nguyên nhân, bạn có thể bị đau kéo dài.', n.when_to_see = 'Tham khảo ý kiến bác sĩ nếu bạn bị: Đau khớp vô hiệu Đột ngột không thể cử động khớp Sưng quá mức, đỏ, bầm tím hoặc phát ban ở vùng bị ảnh hưởng Đau nhói hoặc đau nhói, đặc biệt là khi bạn tập thể dục';
MERGE (n:Disease {id: 'D0481'}) SET n.id = 'D0481', n.name = 'Viêm bao hoạt dịch gót chân', n.name_en = 'Bursitis of the heel', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001073.htm', n.prognosis = 'Tình trạng này thường thuyên giảm sau vài tuần nếu được điều trị thích hợp.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị đau gót chân hoặc các triệu chứng của viêm bao hoạt dịch sau gót chân không cải thiện khi nghỉ ngơi.';
MERGE (n:Disease {id: 'D0482'}) SET n.id = 'D0482', n.name = 'Quá liều butazolidin', n.name_en = 'Butazolidin overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002602.htm', n.prognosis = 'Rất có khả năng phục hồi. Tuy nhiên, chảy máu ở dạ dày hoặc ruột có thể nghiêm trọng và cần phải truyền máu. Nếu có tổn thương thận, nó có thể là vĩnh viễn. Nếu chảy máu không ngừng, ngay cả khi dùng ';
MERGE (n:Disease {id: 'D0483'}) SET n.id = 'D0483', n.name = 'Pin nút', n.name_en = 'Button batteries', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002764.htm', n.prognosis = 'Hầu hết pin nuốt phải đều đi qua dạ dày và ruột mà không gây ra bất kỳ tổn thương nghiêm trọng nào. Tình trạng của một người có tốt hay không tùy thuộc vào loại pin họ nuốt phải và tốc độ họ được điều';
MERGE (n:Disease {id: 'D0484'}) SET n.id = 'D0484', n.name = 'Byssinosis', n.name_en = 'Byssinosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001089.htm', n.prognosis = 'Ngừng tiếp xúc với bụi thường cải thiện các triệu chứng. Tiếp tục tiếp xúc có thể dẫn đến suy giảm chức năng phổi. Tại Hoa Kỳ, những người mắc bệnh byssinosis có thể được hưởng trợ cấp bồi thường cho ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn nghi ngờ rằng mình đã tiếp xúc với bụi bông hoặc bụi sợi khác tại nơi làm việc và bạn có vấn đề về hô hấp. Bị bệnh byssinosis khiến bạn dễ bị nhiễm trùng p';
MERGE (n:Disease {id: 'D0485'}) SET n.id = 'D0485', n.name = 'Sinh mổ', n.name_en = 'C-section', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002911.htm', n.overview = 'Sinh mổ được thực hiện khi người mẹ sinh con qua đường âm đạo là không thể hoặc không an toàn. Thủ tục thường được thực hiện khi người phụ nữ tỉnh táo. Cơ thể được gây tê từ ngực đến chân bằng phương ', n.prognosis = 'Hầu hết các bà mẹ và trẻ sơ sinh đều khỏe mạnh sau khi sinh mổ. Phụ nữ sinh mổ có thể sinh con qua ngã âm đạo nếu có lần mang thai tiếp theo, tùy thuộc vào: Loại sinh mổ được thực hiện Tại sao lại sin';
MERGE (n:Disease {id: 'D0486'}) SET n.id = 'D0486', n.name = 'Nhiễm C. difficile', n.name_en = 'C. difficile infection', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/c-difficile/symptoms-causes/syc-20351691', n.overview = 'Clostridioides difficile (klos-TRID-e-oi-deez dif-uh-SEEL) là một loại vi khuẩn gây nhiễm trùng đại tràng, phần dài nhất của ruột già. Các triệu chứng có thể bao gồm từ tiêu chảy đến tổn thương ruột k', n.when_to_see = 'Một số người đi ngoài phân lỏng trong hoặc ngay sau khi điều trị bằng kháng sinh. Điều này có thể do nhiễm C. difficile. Hẹn khám chăm sóc sức khỏe nếu bạn: Đi tiêu phân lỏng từ ba lần trở lên mỗi ngà';
MERGE (n:Disease {id: 'D0487'}) SET n.id = 'D0487', n.name = 'Quá liều caffeine', n.name_en = 'Caffeine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002579.htm', n.prognosis = 'Có thể cần phải nằm viện một thời gian ngắn để hoàn tất quá trình điều trị. Trong trường hợp nghiêm trọng, tử vong có thể do co giật hoặc nhịp tim không đều.';
MERGE (n:Disease {id: 'D0488'}) SET n.id = 'D0488', n.name = 'Ngộ độc thực vật caladi', n.name_en = 'Caladium plant poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002863.htm', n.prognosis = 'Những người không tiếp xúc nhiều bằng miệng với cây thường sẽ ổn trong vòng vài ngày. Những người tiếp xúc nhiều bằng miệng với cây này có thể mất nhiều thời gian hơn để hồi phục. Bỏng nghiêm trọng ở ';
MERGE (n:Disease {id: 'D0489'}) SET n.id = 'D0489', n.name = 'Vôi hóa', n.name_en = 'Calcification', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002321.htm', n.overview = 'Chín mươi chín phần trăm canxi vào cơ thể được tích tụ trong xương và răng. Lượng canxi còn lại hòa tan trong máu. Khi một rối loạn ảnh hưởng đến sự cân bằng giữa canxi và một số hóa chất trong cơ thể';
MERGE (n:Disease {id: 'D0490'}) SET n.id = 'D0490', n.name = 'Bệnh vôi hóa', n.name_en = 'Calciphylaxis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/calciphylaxis/symptoms-causes/syc-20370559', n.overview = '(kal-sih-fuh-LAK-sis) là một căn bệnh nghiêm trọng, hiếm gặp. Nó liên quan đến sự tích tụ canxi trong các mạch máu nhỏ của mô mỡ và da. Các triệu chứng của bệnh vôi hóa bao gồm cục máu đông, cục u dướ';
MERGE (n:Disease {id: 'D0491'}) SET n.id = 'D0491', n.name = 'Quá liều canxi cacbonat', n.name_en = 'Calcium carbonate overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002605.htm', n.prognosis = 'Canxi cacbonat không độc lắm. Rất ít người chết vì dùng thuốc kháng axit quá liều và khả năng phục hồi là hoàn toàn có thể. Tuy nhiên, nồng độ canxi cao có thể gây rối loạn nhịp tim nghiêm trọng, cũng';
MERGE (n:Disease {id: 'D0492'}) SET n.id = 'D0492', n.name = 'Canxi cacbonat với quá liều magiê', n.name_en = 'Calcium carbonate with magnesium overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002539.htm', n.prognosis = 'Với điều trị y tế thích hợp, hầu hết mọi người đều hồi phục hoàn toàn. Tử vong có thể xảy ra do rối loạn nhịp tim nghiêm trọng.';
MERGE (n:Disease {id: 'D0493'}) SET n.id = 'D0493', n.name = 'Ngộ độc canxi hydroxit', n.name_en = 'Calcium hydroxide poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002910.htm', n.prognosis = 'Tình trạng của người đó phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải những chất độc như vậy có thể gây ả';
MERGE (n:Disease {id: 'D0494'}) SET n.id = 'D0494', n.name = 'Viêm khớp do canxi pyrophosphate', n.name_en = 'Calcium pyrophosphate arthritis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000421.htm', n.prognosis = 'Hầu hết mọi người đều làm tốt với việc điều trị để giảm đau khớp cấp tính. Một loại thuốc như colchicine có thể giúp ngăn ngừa các cơn tái phát. Không có biện pháp điều trị nào để loại bỏ các tinh thể', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị sưng khớp và đau khớp.';
MERGE (n:Disease {id: 'D0495'}) SET n.id = 'D0495', n.name = 'Quá liều thuốc chẹn kênh canxi', n.name_en = 'Calcium-channel blocker overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002580.htm', n.prognosis = 'Dùng quá nhiều thuốc chẹn kênh canxi có thể rất nguy hiểm. Tử vong có thể xảy ra, đặc biệt với verapamil. Nếu nhịp tim và huyết áp của người đó có thể được điều chỉnh thì khả năng sống sót là rất cao.';
MERGE (n:Disease {id: 'D0496'}) SET n.id = 'D0496', n.name = 'Ngộ độc hoa loa kèn', n.name_en = 'Calla lily poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002864.htm', n.prognosis = 'Nếu tiếp xúc với miệng của người đó không nghiêm trọng, các triệu chứng thường hết trong vòng vài ngày. Đối với những người tiếp xúc nhiều với cây, thời gian phục hồi lâu hơn có thể cần thiết. Trong m';
MERGE (n:Disease {id: 'D0497'}) SET n.id = 'D0497', n.name = 'Quá liều Campho-Phenique', n.name_en = 'Campho-Phenique overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002606.htm', n.prognosis = 'Sống sót sau 48 giờ thường có nghĩa là người đó sẽ hồi phục. Các cơn co giật và nhịp tim không đều có thể bắt đầu đột ngột, trong vòng vài phút sau khi tiếp xúc và gây nguy cơ lớn nhất cho sức khỏe và';
MERGE (n:Disease {id: 'D0498'}) SET n.id = 'D0498', n.name = 'Quá liều long não', n.name_en = 'Camphor overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002566.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận nhanh như thế nào. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao.';
MERGE (n:Disease {id: 'D0499'}) SET n.id = 'D0499', n.name = 'Nhiễm Campylobacter', n.name_en = 'Campylobacter infection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000224.htm', n.prognosis = 'Hầu hết mọi người sẽ hồi phục sau 5 đến 8 ngày. Khi hệ thống miễn dịch của một người không hoạt động tốt, nhiễm trùng Campylobacter có thể lan đến tim hoặc não. Các vấn đề khác có thể xảy ra là: Một d', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị tiêu chảy kéo dài hơn 1 tuần hoặc tái phát. Có máu trong phân của bạn. Bạn bị tiêu chảy và không thể uống nước do buồn nôn hoặc nôn. Bạn bị sốt';
MERGE (n:Disease {id: 'D0500'}) SET n.id = 'D0500', n.name = 'Bệnh Canavan', n.name_en = 'Canavan disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001586.htm', n.prognosis = 'Với bệnh Canavan, hệ thần kinh trung ương bị suy sụp. Mọi người có khả năng bị tàn tật. Những người có dạng sơ sinh thường không sống quá tuổi thơ. Một số trẻ em có thể sống đến tuổi thiếu niên. Những', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có bất kỳ triệu chứng nào của bệnh Canavan.';
MERGE (n:Disease {id: 'D0501'}) SET n.id = 'D0501', n.name = 'Ung thư', n.name_en = 'Cancer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cancer/symptoms-causes/syc-20370588 | https://medlineplus.gov/ency/article/001289.htm', n.overview = 'đề cập đến bất kỳ một trong số rất nhiều bệnh được đặc trưng bởi sự phát triển của các tế bào bất thường phân chia không kiểm soát và có khả năng xâm nhập và phá hủy các mô cơ thể bình thường. Ung thư', n.prognosis = 'Triển vọng phụ thuộc vào loại ung thư và giai đoạn ung thư khi được chẩn đoán. Một số bệnh ung thư có thể được chữa khỏi. Những bệnh ung thư khác không thể chữa khỏi vẫn có thể được điều trị hiệu quả.', n.when_to_see = 'Hãy hẹn gặp bác sĩ nếu bạn có bất kỳ dấu hiệu hoặc triệu chứng dai dẳng nào khiến bạn lo lắng. Nếu bạn không có bất kỳ dấu hiệu hoặc triệu chứng nào nhưng lo lắng về nguy cơ mắc bệnh ung thư, hãy thảo';
MERGE (n:Disease {id: 'D0502'}) SET n.id = 'D0502', n.name = 'Nhiễm nấm Candida auris', n.name_en = 'Candida auris infection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007758.htm', n.prognosis = 'Nhiễm trùng C auris có thể khó điều trị do khả năng kháng thuốc chống nấm của nó. Tình trạng sức khỏe của một người sẽ phụ thuộc vào: Mức độ nhiễm trùng nghiêm trọng Liệu nhiễm trùng có lan đến máu và', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị sốt và ớn lạnh không cải thiện, ngay cả sau khi điều trị bằng kháng sinh Bạn bị nhiễm nấm không cải thiện, ngay cả sau khi điều trị bằng thuốc ';
MERGE (n:Disease {id: 'D0503'}) SET n.id = 'D0503', n.name = 'Nhiễm nấm Candida ở da', n.name_en = 'Candida infection of the skin', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000880.htm', n.prognosis = 'Bệnh nấm candida ở da thường khỏi sau khi điều trị, đặc biệt nếu nguyên nhân cơ bản được khắc phục. Nhiễm trùng lặp lại là phổ biến.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của bệnh nấm candida ở da.';
MERGE (n:Disease {id: 'D0504'}) SET n.id = 'D0504', n.name = 'Ngộ độc nến', n.name_en = 'Candles poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002766.htm', n.prognosis = 'Sáp nến được coi là không độc hại và rất có khả năng phục hồi. Tình trạng của một người tốt như thế nào tùy thuộc vào lượng sáp họ nuốt và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ h';
MERGE (n:Disease {id: 'D0505'}) SET n.id = 'D0505', n.name = 'Viêm loét miệng', n.name_en = 'Canker sore', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/canker-sore/symptoms-causes/syc-20370615 | https://medlineplus.gov/ency/article/000998.htm', n.overview = 'bề mặt của má hoặc môi, trên hoặc dưới lưỡi, ở gốc nướu hoặc trên vòm miệng mềm của bạn. Chúng thường có phần giữa màu trắng hoặc vàng, viền đỏ và có thể cực kỳ đau đớn. Loét miệng, còn gọi là loét áp', n.prognosis = 'Các vết loét của Canker hầu như luôn tự lành. Cơn đau sẽ giảm sau vài ngày. Các triệu chứng khác biến mất sau 10 đến 14 ngày.', n.when_to_see = 'Tham khảo ý kiến ​​bác sĩ nếu bạn gặp phải: Vết loét loét lớn bất thường Vết loét tái phát, vết loét mới phát triển trước khi vết cũ lành hoặc bùng phát thường xuyên Vết loét dai dẳng, kéo dài hai tuầ';
MERGE (n:Disease {id: 'D0506'}) SET n.id = 'D0506', n.name = 'Caput succedaneum', n.name_en = 'Caput succedaneum', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001587.htm', n.prognosis = 'Có thể mong đợi sự phục hồi hoàn toàn. Da đầu sẽ trở lại hình dạng bình thường.', n.when_to_see = 'Hầu hết, vấn đề được nhận thấy ngay sau khi sinh. Bạn không cần liên hệ với nhà cung cấp của mình trừ khi bạn có câu hỏi khác.';
MERGE (n:Disease {id: 'D0507'}) SET n.id = 'D0507', n.name = 'Ngộ độc axit carbolic', n.name_en = 'Carbolic acid poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002890.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng axit carbolic được nuốt vào và tốc độ điều trị được nhận. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Tổn thương tiếp tục xảy ra ở thực quản và';
MERGE (n:Disease {id: 'D0508'}) SET n.id = 'D0508', n.name = 'Ngộ độc carbon monoxide', n.name_en = 'Carbon monoxide poisoning', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/carbon-monoxide/symptoms-causes/syc-20370642 | https://medlineplus.gov/ency/article/002804.htm', n.overview = 'xảy ra khi carbon monoxide tích tụ trong máu. Khi có quá nhiều carbon monoxide trong không khí, carbon monoxide sẽ thay thế oxy trong hồng cầu. Điều này có thể dẫn đến tổn thương mô nghiêm trọng hoặc ', n.prognosis = 'Ngộ độc carbon monoxide có thể gây tử vong. Đối với những người sống sót, quá trình phục hồi diễn ra chậm. Sức khoẻ của một người phụ thuộc vào số lượng và thời gian tiếp xúc với khí carbon monoxide. ', n.when_to_see = 'Nếu có thể bị ngộ độc khí carbon monoxide, hãy ra ngoài không khí trong lành và tìm kiếm sự chăm sóc y tế ngay lập tức. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/';
MERGE (n:Disease {id: 'D0509'}) SET n.id = 'D0509', n.name = 'Hậu bối', n.name_en = 'Carbuncle', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000825.htm', n.prognosis = 'Carbuncles có thể tự lành. Những người khác thường đáp ứng tốt với điều trị.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Hậu bối không lành khi điều trị tại nhà trong vòng 2 tuần Hậu bối tái phát thường xuyên Hậu bối nằm trên mặt hoặc trên da phía trên cột sống Bạn bị sốt, c';
MERGE (n:Disease {id: 'D0510'}) SET n.id = 'D0510', n.name = 'Hội chứng carcinoid', n.name_en = 'Carcinoid syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/carcinoid-syndrome/symptoms-causes/syc-20370666 | https://medlineplus.gov/ency/article/000347.htm', n.overview = 'xảy ra khi một khối u ung thư hiếm gặp gọi là khối u carcinoid tiết ra một số hóa chất vào máu của bạn, gây ra nhiều dấu hiệu và triệu chứng. Khối u carcinoid, một loại khối u thần kinh nội tiết, xảy ', n.prognosis = 'Triển vọng ở những người mắc hội chứng carcinoid khác với triển vọng ở những người có khối u carcinoid không có hội chứng. Hầu hết những người có khối u carcinoid sẽ không phát triển hội chứng carcino', n.when_to_see = 'Hãy hẹn gặp bác sĩ nếu bạn có các dấu hiệu và triệu chứng khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D0511'}) SET n.id = 'D0511', n.name = 'Khối u carcinoid', n.name_en = 'Carcinoid tumors', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/carcinoid-tumors/symptoms-causes/syc-20351039', n.overview = 'là một loại ung thư phát triển chậm có thể phát sinh ở một số nơi trên khắp cơ thể bạn. Các khối u carcinoid, là một tập hợp con của các khối u được gọi là khối u thần kinh nội tiết, thường bắt đầu ở ', n.when_to_see = 'Nếu bạn gặp bất kỳ dấu hiệu và triệu chứng nào khiến bạn khó chịu và dai dẳng, hãy hẹn gặp bác sĩ. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin đ';
MERGE (n:Disease {id: 'D0512'}) SET n.id = 'D0512', n.name = 'Ung thư biểu mô nguyên phát không xác định', n.name_en = 'Carcinoma of unknown primary', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/carcinoma-unknown-primary/symptoms-causes/syc-20370683', n.overview = 'là chẩn đoán mà các chuyên gia chăm sóc sức khỏe đưa ra khi họ không thể tìm ra nơi ung thư bắt đầu. Ung thư biểu mô nguyên phát chưa rõ là ung thư giai đoạn muộn đã lan rộng trong cơ thể. Thông thườn', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0513'}) SET n.id = 'D0513', n.name = 'Thủ tục cắt bỏ tim', n.name_en = 'Cardiac ablation procedures', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007368.htm', n.overview = 'Có hai phương pháp thực hiện cắt bỏ tim: Cắt bỏ tần số vô tuyến sử dụng năng lượng nhiệt để loại bỏ vùng có vấn đề. Cryoablation sử dụng nhiệt độ rất lạnh. Loại thủ tục bạn thực hiện sẽ phụ thuộc vào ', n.prognosis = 'Tỷ lệ thành công khác nhau tùy thuộc vào loại vấn đề về nhịp tim đang được điều trị.';
MERGE (n:Disease {id: 'D0514'}) SET n.id = 'D0514', n.name = 'Bệnh amyloidosis tim', n.name_en = 'Cardiac amyloidosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000193.htm', n.prognosis = 'Trước đây, bệnh amyloidosis tim được cho là một căn bệnh khó chữa và gây tử vong nhanh chóng. Tuy nhiên, lĩnh vực này đang thay đổi nhanh chóng. Các loại bệnh amyloidosis khác nhau có thể ảnh hưởng đế', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn mắc chứng rối loạn này và xuất hiện các triệu chứng mới như: Chóng mặt khi thay đổi tư thế Tăng cân quá mức (nước) Sụt cân quá mức Ngất xỉu Các vấn';
MERGE (n:Disease {id: 'D0515'}) SET n.id = 'D0515', n.name = 'Ngừng tim', n.name_en = 'Cardiac arrest', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007640.htm', n.prognosis = 'Hầu hết mọi người đều không qua khỏi khi bị ngừng tim. Nếu bạn đã từng bị ngừng tim, bạn có nguy cơ cao bị một lần khác. Bạn sẽ cần phải làm việc chặt chẽ với bác sĩ để giảm thiểu rủi ro.', n.when_to_see = 'Hãy gọi ngay cho nhà cung cấp của bạn hoặc 911 hoặc số cấp cứu tại địa phương nếu bạn bị: Đau ngực Khó thở';
MERGE (n:Disease {id: 'D0516'}) SET n.id = 'D0516', n.name = 'Quá liều glycoside tim', n.name_en = 'Cardiac glycoside overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002581.htm', n.prognosis = 'Suy giảm chức năng tim và rối loạn nhịp tim có thể gây ra kết cục xấu. Tử vong có thể xảy ra, đặc biệt ở trẻ nhỏ và người lớn tuổi. Người lớn tuổi đặc biệt dễ bị các vấn đề về ngộ độc glycoside tim lâ';
MERGE (n:Disease {id: 'D0517'}) SET n.id = 'D0517', n.name = 'Siêu âm nội mạch tim', n.name_en = 'Cardiac intravascular ultrasound', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007266.htm', n.overview = 'Một cây đũa siêu âm nhỏ được gắn vào đầu một ống mỏng. Ống này được gọi là ống thông. Ống thông được đưa vào động mạch ở vùng háng và di chuyển lên tim. Nó khác với siêu âm song công thông thường. Siê';
MERGE (n:Disease {id: 'D0518'}) SET n.id = 'D0518', n.name = 'Chèn ép tim', n.name_en = 'Cardiac tamponade', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000194.htm', n.prognosis = 'Tử vong do chèn ép tim có thể xảy ra nhanh chóng nếu dịch hoặc máu không được loại bỏ kịp thời từ bên trong màng ngoài tim. Kết quả thường tốt nếu tình trạng này được điều trị kịp thời. Tuy nhiên, chè', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi đến số khẩn cấp tại địa phương (chẳng hạn như 911) nếu các triệu chứng phát triển. Chèn ép tim là một tình trạng cấp cứu cần được chăm sóc y tế ngay lập tức.';
MERGE (n:Disease {id: 'D0519'}) SET n.id = 'D0519', n.name = 'Sốc tim', n.name_en = 'Cardiogenic shock', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cardiogenic-shock/symptoms-causes/syc-20366739 | https://medlineplus.gov/ency/article/000185.htm', n.overview = 'là một tình trạng đe dọa tính mạng. Nó xảy ra khi tim đột nhiên không thể bơm đủ máu để đáp ứng nhu cầu của cơ thể. Nó thường được gây ra bởi một cơn đau tim lớn hoặc nghiêm trọng. Nhưng không phải ai', n.prognosis = 'Trước đây, tỷ lệ tử vong do sốc tim dao động từ 80% đến 90%. Trong những nghiên cứu gần đây hơn, tỷ lệ này đã giảm xuống còn 50% đến 75%. Khi sốc tim không được điều trị, tiên lượng rất xấu.', n.when_to_see = 'Gọi 911 hoặc số khẩn cấp tại địa phương của bạn nếu có bất kỳ ai có triệu chứng đau tim hoặc sốc tim. Nhận trợ giúp ngay lập tức có thể cải thiện cơ hội sống sót. Nó cũng có thể làm giảm tổn thương ch';
MERGE (n:Disease {id: 'D0520'}) SET n.id = 'D0520', n.name = 'Bệnh cơ tim', n.name_en = 'Cardiomyopathy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cardiomyopathy/symptoms-causes/syc-20370709 | https://medlineplus.gov/ency/article/001105.htm', n.overview = '(kahr-dee-o-my-OP-uh-thee) là một bệnh về cơ tim. Nó khiến tim gặp khó khăn hơn trong việc bơm máu đến phần còn lại của cơ thể, điều này có thể dẫn đến các triệu chứng suy tim. Bệnh cơ tim cũng có thể', n.prognosis = 'Triển vọng phụ thuộc vào nhiều thứ khác nhau, bao gồm: Nguyên nhân và loại bệnh cơ tim Mức độ nghiêm trọng của vấn đề về tim Vấn đề đã tồn tại trong bao lâu Tình trạng này phản ứng thế nào với điều tr', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào của bệnh cơ tim. Gọi 911 hoặc số khẩn cấp tại địa phương nếu bạn ngất xỉu, khó thở hoặc đau ngực kéo dài hơn một vài phút. Một số';
MERGE (n:Disease {id: 'D0521'}) SET n.id = 'D0521', n.name = 'Chuyển nhịp', n.name_en = 'Cardioversion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007110.htm', n.overview = 'có thể được thực hiện bằng sốc điện hoặc dùng thuốc. Chuyển nhịp tim bằng điện được thực hiện bằng một thiết bị gây sốc điện cho tim để thay đổi nhịp tim trở lại bình thường. Thiết bị này được gọi là ';
MERGE (n:Disease {id: 'D0522'}) SET n.id = 'D0522', n.name = 'Bệnh động mạch cảnh', n.name_en = 'Carotid artery disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/carotid-artery-disease/symptoms-causes/syc-20360519 | https://medlineplus.gov/ency/article/007427.htm', n.overview = 'Động mạch cảnh Có một cái ở mỗi bên cổ. Các động mạch cảnh cung cấp máu cho não và đầu. Bệnh động mạch cảnh xảy ra khi chất béo tích tụ, gọi là mảng bám, làm tắc nghẽn các mạch máu đưa máu đến não và ', n.prognosis = 'Vì không có triệu chứng nên bạn có thể không biết mình mắc bệnh động mạch cảnh cho đến khi bị đột quỵ hoặc TIA. Một số người bị đột quỵ phục hồi hầu hết hoặc tất cả các chức năng của họ. Những người k', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc khẩn cấp nếu có bất kỳ triệu chứng nào của đột quỵ. Ngay cả khi chúng chỉ tồn tại trong một thời gian ngắn và sau đó bạn cảm thấy ổn, hãy đến gặp chuyên gia chăm sóc sức khỏe ';
MERGE (n:Disease {id: 'D0523'}) SET n.id = 'D0523', n.name = 'Phẫu thuật động mạch cảnh - mở', n.name_en = 'Carotid artery surgery - open', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002951.htm', n.overview = 'Trong quá trình phẫu thuật cắt bỏ nội mạc động mạch cảnh: Bạn được gây mê toàn thân. Bạn đang ngủ và không còn đau đớn. Một số bệnh viện sử dụng gây tê cục bộ để thay thế. Chỉ có phần cơ thể bạn đang ', n.prognosis = 'Phẫu thuật động mạch cảnh có thể giúp giảm nguy cơ bị đột quỵ. Nhưng bạn sẽ cần phải thay đổi lối sống để giúp ngăn ngừa sự tích tụ mảng bám, cục máu đông và các vấn đề khác trong động mạch cảnh theo ';
MERGE (n:Disease {id: 'D0524'}) SET n.id = 'D0524', n.name = 'Giải phóng đường hầm cổ tay', n.name_en = 'Carpal tunnel release', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002976.htm', n.overview = 'Dây thần kinh giữa và các gân uốn cong (hoặc cuộn tròn) các ngón tay của bạn đi qua một lối đi được gọi là đường hầm cổ tay ở cổ tay của bạn. Đường hầm này hẹp nên bất kỳ vết sưng tấy nào cũng có thể ', n.prognosis = 'Giải phóng ống cổ tay giúp giảm đau, ngứa ran và tê dây thần kinh, đồng thời phục hồi sức mạnh cơ bắp. Hầu hết mọi người đều được giúp đỡ nhờ phẫu thuật này. Thời gian hồi phục của bạn sẽ phụ thuộc và';
MERGE (n:Disease {id: 'D0525'}) SET n.id = 'D0525', n.name = 'Hội chứng ống cổ tay', n.name_en = 'Carpal tunnel syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/carpal-tunnel-syndrome/symptoms-causes/syc-20355603 | https://medlineplus.gov/ency/article/000433.htm', n.overview = 'là một trong những tình trạng bàn tay phổ biến nhất. Nguyên nhân là do áp lực lên dây thần kinh giữa trong ống cổ tay của cổ tay. Đường hầm cổ tay là một lối đi hẹp được bao quanh bởi xương và dây chằ', n.prognosis = 'Các triệu chứng thường cải thiện mà không cần phẫu thuật. Nhưng hơn một nửa số trường hợp cuối cùng cần phải phẫu thuật. Ngay cả khi phẫu thuật thành công, quá trình lành vết thương hoàn toàn có thể m', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn có các triệu chứng của hội chứng ống cổ tay cản trở các hoạt động thông thường và kiểu ngủ của bạn. Tổn thương thần kinh và cơ vĩnh viễn có thể xảy ra mà k';
MERGE (n:Disease {id: 'D0526'}) SET n.id = 'D0526', n.name = 'Bệnh Castleman', n.name_en = 'Castleman disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/castleman-disease/symptoms-causes/syc-20543017', n.overview = 'là một nhóm rối loạn hiếm gặp liên quan đến các hạch bạch huyết ngày càng lớn hơn, được gọi là hạch bạch huyết phì đại và có nhiều triệu chứng. Dạng rối loạn phổ biến nhất liên quan đến một hạch bạch ', n.when_to_see = 'Nếu bạn nhận thấy hạch bạch huyết sưng to ở một bên cổ hoặc ở vùng nách, xương đòn hoặc háng, hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn. Đồng thời, hãy gọi cho nhóm chăm sóc của bạn nếu ';
MERGE (n:Disease {id: 'D0527'}) SET n.id = 'D0527', n.name = 'Quá liều dầu thầu dầu', n.name_en = 'Castor oil overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002768.htm', n.prognosis = 'Thông thường, dầu thầu dầu sẽ gây ra một số vấn đề. Khả năng phục hồi là rất có thể. Nếu buồn nôn, nôn và tiêu chảy không được kiểm soát, tình trạng mất nước và mất cân bằng điện giải (hóa học và khoá';
MERGE (n:Disease {id: 'D0528'}) SET n.id = 'D0528', n.name = 'Bệnh mèo cào', n.name_en = 'Cat-scratch disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001614.htm', n.prognosis = 'Những người có hệ miễn dịch khỏe mạnh sẽ hồi phục hoàn toàn mà không cần điều trị. Những người có hệ miễn dịch yếu cần điều trị bằng kháng sinh để hồi phục.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có hạch bạch huyết to và bạn đã tiếp xúc với mèo.';
MERGE (n:Disease {id: 'D0529'}) SET n.id = 'D0529', n.name = 'Đục thủy tinh thể - người lớn', n.name_en = 'Cataract - adult', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001001.htm', n.prognosis = 'Thị lực có thể không cải thiện đến 20/20 sau phẫu thuật đục thủy tinh thể nếu mắc các bệnh về mắt khác, chẳng hạn như thoái hóa điểm vàng . Bác sĩ nhãn khoa của bạn thường có thể xác định trước điều n', n.when_to_see = 'Hãy liên hệ với chuyên gia chăm sóc mắt của bạn để đặt lịch hẹn nếu bạn gặp phải: Giảm thị lực ban đêm Vấn đề với ánh sáng chói Mất thị lực';
MERGE (n:Disease {id: 'D0530'}) SET n.id = 'D0530', n.name = 'Loại bỏ đục thủy tinh thể', n.name_en = 'Cataract removal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002957.htm', n.overview = 'Phẫu thuật đục thủy tinh thể là một thủ tục ngoại trú. Điều này có nghĩa là bạn có thể không phải ở lại bệnh viện qua đêm. Phẫu thuật được thực hiện bởi bác sĩ nhãn khoa. Đây là bác sĩ y khoa chuyên v', n.prognosis = 'Hầu hết mọi người đều hồi phục tốt và nhanh chóng sau phẫu thuật đục thủy tinh thể. Nếu một người có các vấn đề khác về mắt, chẳng hạn như bệnh tăng nhãn áp hoặc thoái hóa điểm vàng, phẫu thuật có thể';
MERGE (n:Disease {id: 'D0531'}) SET n.id = 'D0531', n.name = 'Đục thủy tinh thể', n.name_en = 'Cataracts', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cataracts/symptoms-causes/syc-20353790', n.overview = 'Đục thủy tinh thể trông như thế nào, thấu kính của mắt bạn trở nên đục. Cuối cùng, đục thủy tinh thể có thể trở nên giống như đục thủy tinh thể ở mắt phải của người này. Bệnh đục thủy tinh thể ảnh hưở', n.when_to_see = 'Hãy hẹn khám mắt nếu bạn nhận thấy bất kỳ thay đổi nào về thị lực của mình. Nếu bạn có những thay đổi về thị lực đột ngột, chẳng hạn như nhìn đôi hoặc nhìn thấy ánh sáng nhấp nháy, đau mắt đột ngột ho';
MERGE (n:Disease {id: 'D0532'}) SET n.id = 'D0532', n.name = 'Sâu bướm', n.name_en = 'Caterpillars', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002860.htm', n.prognosis = 'Bạn nhận được trợ giúp y tế càng nhanh thì các triệu chứng của bạn sẽ biến mất càng nhanh. Hầu hết mọi người không gặp vấn đề lâu dài khi tiếp xúc với sâu bướm.';
MERGE (n:Disease {id: 'D0533'}) SET n.id = 'D0533', n.name = 'UTI liên quan đến ống thông', n.name_en = 'Catheter-related UTI', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000483.htm', n.prognosis = 'UTI liên quan đến ống thông có thể khó điều trị hơn các UTI khác. Bị nhiễm trùng nhiều lần theo thời gian có thể dẫn đến tổn thương thận hoặc sỏi thận và sỏi bàng quang. UTI không được điều trị có thể', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Bất kỳ triệu chứng nào của UTI Đau lưng hoặc sườn Sốt Nôn mửa';
MERGE (n:Disease {id: 'D0534'}) SET n.id = 'D0534', n.name = 'Ngộ độc hợp chất caulking', n.name_en = 'Caulking compound poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002828.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng khói họ hít vào hoặc lượng chất bịt kín đã nuốt vào và tốc độ điều trị được tiếp nhận. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Thiệt hại có';
MERGE (n:Disease {id: 'D0535'}) SET n.id = 'D0535', n.name = 'Dị tật hang động', n.name_en = 'Cavernous malformations', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cavernous-malformations/symptoms-causes/syc-20360941', n.overview = 'Dị tật hang não Dị dạng hang não là một mạch máu có hình dạng không đều, có hình dạng giống như một quả dâu tằm nhỏ. Nó có thể hình thành trong não hoặc tủy sống và có thể gây ra một loạt các triệu ch', n.when_to_see = 'Tìm kiếm sự trợ giúp y tế ngay lập tức nếu bạn gặp bất kỳ triệu chứng nào của cơn động kinh. Đồng thời nhận trợ giúp y tế ngay lập tức nếu bạn có các triệu chứng gợi ý dị tật hang não hoặc chảy máu nã';
MERGE (n:Disease {id: 'D0536'}) SET n.id = 'D0536', n.name = 'Huyết khối xoang hang', n.name_en = 'Cavernous sinus thrombosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001628.htm', n.prognosis = 'Huyết khối xoang hang có thể dẫn đến tử vong nếu không được điều trị.', n.when_to_see = 'Liên hệ ngay với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có: Mắt lồi Mí mắt sụp xuống Đau mắt Không thể di chuyển mắt theo bất kỳ hướng cụ thể nào Mất thị lực';
MERGE (n:Disease {id: 'D0537'}) SET n.id = 'D0537', n.name = 'Sâu răng và sâu răng', n.name_en = 'Cavities and tooth decay', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cavities/symptoms-causes/syc-20352892', n.overview = 'Các loại sâu răng trở thành những lỗ hoặc lỗ nhỏ. Ba loại sâu răng được hiển thị ở đây. Sâu răng bề mặt nhẵn xảy ra ở các mặt nhẵn của răng. Sâu răng xảy ra trên bề mặt của rễ. Sâu răng và vết nứt xảy';
MERGE (n:Disease {id: 'D0538'}) SET n.id = 'D0538', n.name = 'Ngộ độc dầu lá tuyết tùng', n.name_en = 'Cedar leaf oil poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002769.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng dầu lá tuyết tùng mà họ nuốt vào và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Chấn thương muộn có thể xảy ra, bao gồ';
MERGE (n:Disease {id: 'D0539'}) SET n.id = 'D0539', n.name = 'Bệnh Celiac', n.name_en = 'Celiac disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/celiac-disease/symptoms-causes/syc-20352220', n.overview = 'hình thành các nhung mao, giúp hấp thụ đường, chất béo, protein, vitamin, khoáng chất và các chất dinh dưỡng khác từ thực phẩm bạn ăn. Tiếp xúc với gluten ở những người mắc bệnh celiac làm tổn thương ', n.when_to_see = 'Hãy tham khảo ý kiến ​​của nhóm chăm sóc sức khỏe nếu bạn bị tiêu chảy hoặc khó chịu về tiêu hóa kéo dài hơn hai tuần. Hãy tham khảo ý kiến ​​của nhóm chăm sóc sức khỏe cho con bạn nếu con bạn: Xanh x';
MERGE (n:Disease {id: 'D0540'}) SET n.id = 'D0540', n.name = 'Bệnh celiac – mầm bệnh', n.name_en = 'Celiac disease – sprue', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000233.htm', n.prognosis = 'Tuân theo chế độ ăn không chứa gluten sẽ chữa lành tổn thương ở ruột và ngăn ngừa tổn thương thêm. Sự chữa lành này thường xảy ra nhất trong vòng 3 đến 6 tháng ở trẻ em. Việc phục hồi có thể mất từ ​​', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh celiac.';
MERGE (n:Disease {id: 'D0541'}) SET n.id = 'D0541', n.name = 'Điện thoại di động và bệnh ung thư', n.name_en = 'Cell phones and cancer', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007151.htm', n.overview = 'Tại thời điểm này vẫn chưa rõ liệu có mối liên hệ giữa việc sử dụng điện thoại di động và bệnh ung thư hay không. Các nghiên cứu đã được thực hiện chưa đạt được kết luận nhất quán. Cần nhiều nghiên cứ';
MERGE (n:Disease {id: 'D0542'}) SET n.id = 'D0542', n.name = 'Cellulite', n.name_en = 'Cellulite', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cellulite/symptoms-causes/syc-20354945 | https://medlineplus.gov/ency/article/002033.htm', n.overview = 'Mọi người đều có các lớp mỡ dưới da, vì vậy ngay cả những người gầy cũng có thể có cellulite. Các sợi collagen kết nối chất béo với da có thể bị giãn, đứt hoặc kéo chặt. Điều này cho phép các tế bào m', n.when_to_see = 'Việc điều trị là không cần thiết. Nhưng nếu bạn lo lắng về vẻ ngoài của làn da, hãy nói chuyện với bác sĩ chăm sóc chính hoặc bác sĩ chuyên khoa về bệnh ngoài da (bác sĩ da liễu) hoặc phẫu thuật thẩm ';
MERGE (n:Disease {id: 'D0543'}) SET n.id = 'D0543', n.name = 'Viêm mô tế bào', n.name_en = 'Cellulitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cellulitis/symptoms-causes/syc-20370762 | https://medlineplus.gov/ency/article/000855.htm', n.overview = '(sel-u-LIE-tis) là một bệnh nhiễm trùng da lan rộng, phổ biến nhất là ở cẳng chân. Nguyên nhân là do vi khuẩn xâm nhập qua vết nứt trên da. Vùng da bị ảnh hưởng sưng tấy, đau và nóng khi chạm vào. Nhi', n.prognosis = 'Viêm mô tế bào thường biến mất sau khi dùng kháng sinh từ 7 đến 10 ngày. Có thể cần điều trị lâu hơn nếu viêm mô tế bào nặng hơn. Điều này có thể xảy ra nếu bạn mắc bệnh mãn tính hoặc hệ thống miễn dị', n.when_to_see = 'Điều quan trọng là phải phát hiện và điều trị sớm bệnh viêm mô tế bào vì tình trạng này có thể lây lan nhanh chóng khắp cơ thể. Tìm kiếm sự chăm sóc khẩn cấp nếu: Bạn bị phát ban sưng tấy hoặc phát ba';
MERGE (n:Disease {id: 'D0544'}) SET n.id = 'D0544', n.name = 'Rết', n.name_en = 'Centipede', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002842.htm', n.prognosis = 'Các triệu chứng thường kéo dài dưới 48 giờ. Trong một số trường hợp, tình trạng sưng tấy và đau nhức có thể kéo dài tới 3 tuần hoặc có thể biến mất và quay trở lại. Phản ứng dị ứng nghiêm trọng hoặc v';
MERGE (n:Disease {id: 'D0545'}) SET n.id = 'D0545', n.name = 'Bệnh đái tháo nhạt trung ương', n.name_en = 'Central diabetes insipidus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000460.htm', n.prognosis = 'Kết quả tùy thuộc vào nguyên nhân. Nếu được điều trị, bệnh đái tháo nhạt trung ương thường không gây ra vấn đề nghiêm trọng hoặc dẫn đến tử vong sớm.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của bệnh đái tháo nhạt trung ương. Nếu bạn mắc bệnh đái tháo nhạt trung ương, hãy liên hệ với nhà cung cấp dịch vụ của bạ';
MERGE (n:Disease {id: 'D0546'}) SET n.id = 'D0546', n.name = 'Ung thư hạch hệ thần kinh trung ương (CNS)', n.name_en = 'Central nervous system (CNS) lymphoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/central-nervous-system-lymphoma/symptoms-causes/syc-20598772', n.overview = 'là một loại ung thư hạch . Ung thư hạch là bệnh ung thư ảnh hưởng đến hệ bạch huyết. Hệ bạch huyết được tạo thành từ các cơ quan, tuyến, mạch dạng ống và cụm tế bào gọi là hạch bạch huyết. Nó là một p';
MERGE (n:Disease {id: 'D0547'}) SET n.id = 'D0547', n.name = 'Dị tật mạch máu hệ thần kinh trung ương', n.name_en = 'Central nervous system vascular malformations', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/central-nervous-system-vascular-malformations/symptoms-causes/syc-20356113', n.overview = 'là những vấn đề hiếm gặp ở mạch máu. Chúng thường hình thành trong não hoặc tủy sống và lớp phủ của chúng, được gọi là màng. Có một số loại dị tật mạch máu hệ thần kinh trung ương: Dị dạng động tĩnh m';
MERGE (n:Disease {id: 'D0548'}) SET n.id = 'D0548', n.name = 'Bệnh hắc mạc huyết thanh trung tâm', n.name_en = 'Central serous choroidopathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001612.htm', n.prognosis = 'Hầu hết mọi người đều hồi phục thị lực tốt mà không cần điều trị. Tuy nhiên, thị lực thường không còn tốt như trước khi bệnh xảy ra. Bệnh tái phát ở khoảng một nửa số người. Ngay cả khi bệnh quay trở ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu thị lực của bạn trở nên kém hơn.';
MERGE (n:Disease {id: 'D0549'}) SET n.id = 'D0549', n.name = 'Chứng ngưng thở khi ngủ trung ương', n.name_en = 'Central sleep apnea', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/central-sleep-apnea/symptoms-causes/syc-20352109 | https://medlineplus.gov/ency/article/003997.htm', n.overview = 'là chứng rối loạn hô hấp trong đó nhịp thở liên tục dừng lại và bắt đầu trong khi ngủ. Những lần ngừng thở này được gọi là ngưng thở. Ngưng thở khi ngủ trung ương xảy ra khi não không gửi tín hiệu thí', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào tình trạng bệnh lý gây ra chứng ngưng thở khi ngủ trung ương. Triển vọng thường thuận lợi cho những người mắc chứng ngưng thở khi ngủ trung ương vô căn.', n.when_to_see = 'Hãy nói chuyện với ai đó trong nhóm chăm sóc sức khỏe ban đầu của bạn nếu bạn có - hoặc nếu đối tác của bạn nhận thấy - bất kỳ triệu chứng nào của chứng ngưng thở khi ngủ trung ương, đặc biệt là: Khó ';
MERGE (n:Disease {id: 'D0550'}) SET n.id = 'D0550', n.name = 'Đường tĩnh mạch trung tâm - trẻ sơ sinh', n.name_en = 'Central venous line - infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007246.htm', n.overview = 'TẠI SAO SỬ DỤNG ĐƯỜNG TĨNH MẠCH TRUNG TÂM? Đường tĩnh mạch trung tâm thường được đặt khi trẻ không thể đặt ống thông trung tâm qua da (PICC) hoặc ống thông trung tâm đường giữa (MCC). Đường truyền tĩn';
MERGE (n:Disease {id: 'D0551'}) SET n.id = 'D0551', n.name = 'Bệnh mạch máu amyloid não', n.name_en = 'Cerebral amyloid angiopathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000719.htm', n.prognosis = 'Tình trạng rối loạn dần dần trở nên tồi tệ hơn.', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn đột ngột mất khả năng vận động, cảm giác, thị giác hoặc lời nói.';
MERGE (n:Disease {id: 'D0552'}) SET n.id = 'D0552', n.name = 'Dị dạng động tĩnh mạch não', n.name_en = 'Cerebral arteriovenous malformation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000779.htm', n.prognosis = 'Một số người có triệu chứng đầu tiên là chảy máu não quá nhiều sẽ chết. Những người khác có thể bị co giật vĩnh viễn và các vấn đề về não và hệ thần kinh. AVM không gây ra triệu chứng vào thời điểm mọ', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn gặp: Tê ở các bộ phận trên cơ thể Động kinh Đau đầu dữ dội Nôn mửa Suy nhược Các triệu chứng khác của AVM bị vỡ Đồng thời, hãy';
MERGE (n:Disease {id: 'D0553'}) SET n.id = 'D0553', n.name = 'Thiếu oxy não', n.name_en = 'Cerebral hypoxia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001435.htm', n.prognosis = 'Triển vọng phụ thuộc vào mức độ chấn thương sọ não. Điều này được quyết định bởi thời gian não thiếu oxy và liệu dinh dưỡng cho não có bị ảnh hưởng hay không. Nếu não chỉ thiếu oxy trong một thời gian', n.when_to_see = 'Tình trạng thiếu oxy não là một trường hợp cấp cứu y tế. Gọi 911 hoặc số khẩn cấp tại địa phương ngay lập tức nếu ai đó bất tỉnh hoặc có các triệu chứng thiếu oxy não khác.';
MERGE (n:Disease {id: 'D0554'}) SET n.id = 'D0554', n.name = 'Bại não', n.name_en = 'Cerebral palsy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cerebral-palsy/symptoms-causes/syc-20353999 | https://medlineplus.gov/ency/article/000716.htm', n.overview = 'là một nhóm các tình trạng ảnh hưởng đến vận động và tư thế. Nguyên nhân là do tổn thương xảy ra ở não đang phát triển, thường là trước khi sinh. Các triệu chứng xuất hiện trong thời thơ ấu hoặc những', n.prognosis = 'CP là chứng rối loạn suốt đời. Chăm sóc dài hạn có thể được yêu cầu. Rối loạn này không ảnh hưởng đến tuổi thọ dự kiến. Mức độ khuyết tật khác nhau. Trẻ sơ sinh bị CP nhẹ có thể hết các triệu chứng kh', n.when_to_see = 'Hãy liên hệ với chuyên gia chăm sóc sức khỏe của con bạn và nhận được chẩn đoán nhanh chóng nếu con bạn có các triệu chứng của tình trạng vận động. Ngoài ra, hãy gặp chuyên gia y tế nếu con bạn chậm p';
MERGE (n:Disease {id: 'D0555'}) SET n.id = 'D0555', n.name = 'Ung thư cổ tử cung', n.name_en = 'Cervical cancer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cervical-cancer/symptoms-causes/syc-20352501 | https://medlineplus.gov/ency/article/000893.htm', n.overview = 'Ung thư cổ tử cung là gì? Chuyên gia của Mayo Clinic giải thích Tìm hiểu thêm về ung thư cổ tử cung từ bác sĩ ung thư phụ khoa Kristina Butler, M.D., M.S. Hiển thị bản ghi cho video Ung thư cổ tử cung', n.prognosis = 'Sức khỏe của bệnh nhân phụ thuộc vào nhiều thứ, bao gồm: Loại ung thư cổ tử cung Giai đoạn ung thư (nó đã lan rộng bao xa) Tuổi tác và sức khỏe chung Nếu ung thư quay trở lại sau khi điều trị thì tình', n.when_to_see = 'Đặt lịch hẹn với bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập ';
MERGE (n:Disease {id: 'D0556'}) SET n.id = 'D0556', n.name = 'Chứng loạn sản cổ tử cung', n.name_en = 'Cervical dysplasia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001491.htm', n.prognosis = 'Chẩn đoán sớm và điều trị kịp thời sẽ chữa khỏi hầu hết các trường hợp loạn sản cổ tử cung. Tuy nhiên, tình trạng này có thể quay trở lại. Nếu không điều trị, chứng loạn sản cổ tử cung nghiêm trọng có', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn từ 21 tuổi trở lên và bạn chưa bao giờ khám phụ khoa và xét nghiệm Pap.';
MERGE (n:Disease {id: 'D0557'}) SET n.id = 'D0557', n.name = 'Chứng loạn trương lực cổ', n.name_en = 'Cervical dystonia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cervical-dystonia/symptoms-causes/syc-20354123', n.overview = ', còn được gọi là vẹo cổ do co thắt, là một tình trạng đau đớn trong đó cơ cổ của bạn co thắt không chủ ý, khiến đầu bạn bị vặn hoặc quay sang một bên. Chứng loạn trương lực cơ cổ cũng có thể khiến đầ';
MERGE (n:Disease {id: 'D0558'}) SET n.id = 'D0558', n.name = 'Polyp cổ tử cung', n.name_en = 'Cervical polyps', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001494.htm', n.prognosis = 'Hầu hết các polyp không phải là ung thư (lành tính) và dễ dàng cắt bỏ. Polyp không phát triển trở lại hầu hết thời gian. Phụ nữ có polyp có nguy cơ phát triển nhiều polyp hơn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị: Chảy máu bất thường từ âm đạo, bao gồm chảy máu sau khi quan hệ tình dục hoặc giữa các kỳ kinh Dịch tiết bất thường từ âm đạo';
MERGE (n:Disease {id: 'D0559'}) SET n.id = 'D0559', n.name = 'Thoái hóa đốt sống cổ', n.name_en = 'Cervical spondylosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cervical-spondylosis/symptoms-causes/syc-20370787 | https://medlineplus.gov/ency/article/000436.htm', n.overview = 'là thuật ngữ chung chỉ sự hao mòn liên quan đến tuổi tác ảnh hưởng đến các đĩa đệm cột sống ở cổ của bạn. Khi các đĩa đệm mất nước và co lại, các dấu hiệu viêm xương khớp sẽ phát triển, bao gồm cả các', n.prognosis = 'Hầu hết những người mắc bệnh thoái hóa đốt sống cổ đều có một số triệu chứng lâu dài. Hầu hết các triệu chứng này sẽ cải thiện khi điều trị không phẫu thuật và không cần phẫu thuật. Nhiều người gặp vấ', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Tình trạng trở nên tồi tệ hơn Có dấu hiệu biến chứng Bạn xuất hiện các triệu chứng mới (chẳng hạn như mất vận động hoặc cảm giác ở một vùng trên cơ thể) Bạn mất k';
MERGE (n:Disease {id: 'D0560'}) SET n.id = 'D0560', n.name = 'Viêm cổ tử cung', n.name_en = 'Cervicitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cervicitis/symptoms-causes/syc-20370814 | https://medlineplus.gov/ency/article/001495.htm', n.overview = 'Hệ thống sinh sản nữ, tử cung, cổ tử cung và âm đạo, còn gọi là ống âm đạo, tạo nên hệ thống sinh sản nữ. Viêm cổ tử cung là tình trạng viêm cổ tử cung, phần dưới, hẹp của tử cung mở vào âm đạo. Các t', n.prognosis = 'Hầu hết các trường hợp viêm cổ tử cung đơn giản thường khỏi bằng cách điều trị nếu tìm ra nguyên nhân và có cách điều trị cho nguyên nhân đó. Thông thường, viêm cổ tử cung không gây ra bất kỳ triệu ch', n.when_to_see = 'Hãy đi khám bác sĩ nếu bạn có: Dịch tiết âm đạo bất thường, dai dẳng Chảy máu âm đạo không có kinh Đau khi quan hệ tình dục Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem ';
MERGE (n:Disease {id: 'D0561'}) SET n.id = 'D0561', n.name = 'Phẫu thuật lạnh cổ tử cung', n.name_en = 'Cervix cryosurgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002917.htm', n.overview = 'Liệu pháp áp lạnh được thực hiện tại văn phòng của nhà cung cấp dịch vụ chăm sóc sức khỏe khi bạn tỉnh. Bạn có thể bị chuột rút nhẹ. Bạn có thể bị đau một chút trong quá trình phẫu thuật. Để thực hiện', n.prognosis = 'Nhà cung cấp dịch vụ của bạn nên làm lại xét nghiệm Pap hoặc sinh thiết trong lần tái khám để đảm bảo rằng tất cả các mô bất thường đã bị phá hủy. Bạn có thể cần xét nghiệm phết tế bào cổ tử cung thườ';
MERGE (n:Disease {id: 'D0562'}) SET n.id = 'D0562', n.name = 'Chà xát', n.name_en = 'Chafing', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002034.htm', n.overview = 'Khi chà xát gây kích ứng da, những lời khuyên sau có thể hữu ích: Tránh mặc quần áo thô. Mặc vải 100% cotton vào da có thể hữu ích. Giảm ma sát với da bằng cách mặc đúng loại quần áo cho hoạt động bạn';
MERGE (n:Disease {id: 'D0563'}) SET n.id = 'D0563', n.name = 'Bệnh Chagas', n.name_en = 'Chagas disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/chagas-disease/symptoms-causes/syc-20356212 | https://medlineplus.gov/ency/article/001372.htm', n.overview = 'Bệnh Chagas (CHAH-gus) là một bệnh do nhiễm ký sinh trùng Trypanosoma cruzi. Ký sinh trùng được tìm thấy trong phân của bọ triatomine. Những lỗi này còn được gọi là reduviid. Chúng còn có thể được gọi', n.prognosis = 'Khoảng 1/3 số người nhiễm bệnh không được điều trị sẽ phát triển bệnh Chagas mãn tính hoặc có triệu chứng. Có thể mất hơn 20 năm kể từ thời điểm nhiễm trùng ban đầu để phát triển các vấn đề về tim hoặ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn đã ở khu vực có bệnh Chagas phổ biến và bạn có các triệu chứng của tình trạng này.';
MERGE (n:Disease {id: 'D0564'}) SET n.id = 'D0564', n.name = 'Chắp', n.name_en = 'Chalazion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001006.htm', n.prognosis = 'Chalazia thường tự lành vết thương. Kết quả điều trị là tuyệt vời trong hầu hết các trường hợp, nhưng chúng có thể quay trở lại sau khi lành vết thương ban đầu.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu các cục u trên mí mắt tiếp tục to hơn dù đã được điều trị hoặc bạn bị rụng một vùng lông mi.';
MERGE (n:Disease {id: 'D0565'}) SET n.id = 'D0565', n.name = 'Chancroid', n.name_en = 'Chancroid', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000635.htm', n.prognosis = 'Chancroid có thể tự cải thiện. Một số người bị loét và chảy dịch nhiều tháng. Điều trị bằng kháng sinh thường làm lành vết thương nhanh chóng và để lại rất ít vết sẹo.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để lấy hẹn nếu: Bạn có các triệu chứng của bệnh hạ cam. Bạn đã có quan hệ tình dục với một người mà bạn biết mắc bệnh STI. Bạn đã tham gia vào các hoạt độn';
MERGE (n:Disease {id: 'D0566'}) SET n.id = 'D0566', n.name = 'Những thay đổi ở trẻ sơ sinh khi mới sinh', n.name_en = 'Changes in the newborn at birth', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002395.htm', n.overview = 'PHỔI, TIM VÀ MÁU Nhau thai của mẹ giúp bé "thở" khi đang lớn lên trong bụng mẹ. Oxy và carbon dioxide chảy qua máu trong nhau thai. Hầu hết nó đi vào tim và chảy qua cơ thể em bé. Điều này cho phép em';
MERGE (n:Disease {id: 'D0567'}) SET n.id = 'D0567', n.name = 'Bàn chân Charcot', n.name_en = 'Charcot foot', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007748.htm', n.prognosis = 'Tiên lượng phụ thuộc vào mức độ nghiêm trọng của biến dạng bàn chân và mức độ lành vết thương của bạn mà không bị nhiễm trùng. Nhiều người làm tốt với việc niềng răng, thay đổi hoạt động và theo dõi l', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn mắc bệnh tiểu đường và bàn chân của bạn ấm, đỏ hoặc sưng.';
MERGE (n:Disease {id: 'D0568'}) SET n.id = 'D0568', n.name = 'Bệnh Charcot-Marie-Tooth', n.name_en = 'Charcot-Marie-Tooth disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/charcot-marie-tooth-disease/symptoms-causes/syc-20350517 | https://medlineplus.gov/ency/article/000727.htm', n.overview = 'Bệnh Charcot (shahr-KOH)-Marie-Tooth là một nhóm các bệnh di truyền gây tổn thương thần kinh. Điều kiện di truyền được truyền qua các gia đình. Tổn thương này chủ yếu xảy ra ở các dây thần kinh ở tay ', n.prognosis = 'Bệnh Charcot-Marie-Tooth dần trở nên trầm trọng hơn. Một số bộ phận của cơ thể có thể bị tê và cơn đau có thể từ nhẹ đến nặng. Cuối cùng bệnh có thể gây tàn phế.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bàn chân hoặc cẳng chân liên tục bị yếu hoặc giảm cảm giác.';
MERGE (n:Disease {id: 'D0569'}) SET n.id = 'D0569', n.name = 'Ngựa Charley', n.name_en = 'Charley horse', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002066.htm', n.prognosis = 'Co thắt cơ sẽ thuyên giảm khi nghỉ ngơi và theo thời gian. Triển vọng là tuyệt vời cho hầu hết mọi người. Học cách tập thể dục đúng cách với chế độ luyện tập phù hợp và uống đủ chất lỏng có thể ngăn n', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị co thắt cơ và đau dữ dội. Bạn bị yếu cơ do co thắt cơ. Bạn bị co thắt cơ không ngừng và lan sang các bộ phận khác của cơ thể. Ngay cả khi cơn c';
MERGE (n:Disease {id: 'D0570'}) SET n.id = 'D0570', n.name = 'Hội chứng Chediak-Higashi', n.name_en = 'Chediak-Higashi syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001312.htm', n.prognosis = 'Tử vong thường xảy ra trong 10 năm đầu đời, do nhiễm trùng lâu dài (mãn tính) hoặc bệnh cấp tính dẫn đến bệnh giống ung thư hạch (tế bào lympho thực bào máu). Tuy nhiên, một số trẻ bị ảnh hưởng có thể', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có tiền sử gia đình mắc chứng rối loạn này và bạn đang có ý định sinh con. Nói chuyện với nhà cung cấp dịch vụ của bạn nếu con bạn có các triệu chứ';
MERGE (n:Disease {id: 'D0571'}) SET n.id = 'D0571', n.name = 'Bỏng hoặc phản ứng hóa học', n.name_en = 'Chemical burn or reaction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000059.htm', n.when_to_see = 'Hãy gọi trợ giúp y tế ngay nếu người đó khó thở, lên cơn co giật hoặc bất tỉnh.';
MERGE (n:Disease {id: 'D0572'}) SET n.id = 'D0572', n.name = 'Viêm phổi do hóa chất', n.name_en = 'Chemical pneumonitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000143.htm', n.prognosis = 'Kết quả phụ thuộc vào hóa chất, mức độ nghiêm trọng của việc tiếp xúc và liệu vấn đề là cấp tính hay mãn tính.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn khó thở sau khi hít phải (hoặc có thể hít phải) bất kỳ chất nào.';
MERGE (n:Disease {id: 'D0573'}) SET n.id = 'D0573', n.name = 'Não hóa trị', n.name_en = 'Chemo brain', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/chemo-brain/symptoms-causes/syc-20351060', n.overview = 'là thuật ngữ phổ biến mà những người mắc bệnh ung thư sử dụng để mô tả những vấn đề về suy nghĩ và trí nhớ có thể xảy ra trong và sau khi điều trị ung thư. Não hóa trị còn có thể được gọi là sương mù ', n.when_to_see = 'Nếu bạn gặp vấn đề về trí nhớ hoặc suy nghĩ, hãy đặt lịch hẹn với chuyên gia chăm sóc sức khỏe của bạn. Viết nhật ký về các triệu chứng của bạn để giúp chuyên gia chăm sóc sức khỏe của bạn biết các vấ';
MERGE (n:Disease {id: 'D0574'}) SET n.id = 'D0574', n.name = 'Hóa chất', n.name_en = 'Chemosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003038.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Các triệu chứng của bạn không biến mất. Bạn không thể nhắm mắt lại được. Bạn có các triệu chứng khác, chẳng hạn như đau mắt, thay đổi th';
MERGE (n:Disease {id: 'D0575'}) SET n.id = 'D0575', n.name = 'Hóa trị', n.name_en = 'Chemotherapy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002324.htm', n.overview = 'PHƯƠNG PHÁP HÓA TRỊ LIỆU ĐƯỢC PHƯƠNG PHÁP Tùy thuộc vào loại ung thư và nơi phát hiện, thuốc hóa trị có thể được cung cấp theo nhiều cách khác nhau, bao gồm: Tiêm hoặc tiêm vào cơ Tiêm hoặc tiêm dưới ';
MERGE (n:Disease {id: 'D0576'}) SET n.id = 'D0576', n.name = 'U mạch máu anh đào', n.name_en = 'Cherry angioma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001441.htm', n.prognosis = 'U mạch máu anh đào không phải là ung thư. Chúng thường không gây hại cho sức khỏe của bạn. Việc loại bỏ thường không gây ra sẹo.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có các triệu chứng của u mạch máu anh đào và bạn muốn loại bỏ nó. Sự xuất hiện của u mạch máu anh đào (hoặc bất kỳ tổn thương da nào) thay đổi';
MERGE (n:Disease {id: 'D0577'}) SET n.id = 'D0577', n.name = 'Đau ngực', n.name_en = 'Chest pain', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/chest-pain/symptoms-causes/syc-20370838 | https://medlineplus.gov/ency/article/003079.htm', n.overview = 'là cảm giác đau hoặc khó chịu ở vùng giữa cổ và bụng. Đau ngực có thể dữ dội hoặc âm ỉ. Nó có thể đến và đi, hoặc bạn có thể luôn cảm thấy đau. Các triệu chứng chính xác phụ thuộc vào nguyên nhân. Nhi', n.when_to_see = 'Nếu bạn mới bị đau ngực hoặc không rõ nguyên nhân hoặc nghĩ rằng mình đang bị đau tim, hãy gọi 911 hoặc trợ giúp y tế khẩn cấp ngay lập tức. Đừng bao giờ bỏ qua các triệu chứng của cơn đau tim. Nếu bạ';
MERGE (n:Disease {id: 'D0578'}) SET n.id = 'D0578', n.name = 'Đặt ống ngực', n.name_en = 'Chest tube insertion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002947.htm', n.overview = 'Khi đặt ống ngực, bạn sẽ nằm nghiêng hoặc ngồi thẳng một phần, với một tay qua đầu. Đôi khi, bạn sẽ nhận thuốc qua tĩnh mạch (tiêm tĩnh mạch, hoặc IV) để giúp bạn thư giãn và buồn ngủ. Da của bạn sẽ đ', n.prognosis = 'Triển vọng phụ thuộc vào lý do ống lồng ngực được đưa vào. Tràn khí màng phổi thường được cải thiện nhưng đôi khi cần phải phẫu thuật để khắc phục vấn đề cơ bản. Điều này có thể được thực hiện thông q';
MERGE (n:Disease {id: 'D0579'}) SET n.id = 'D0579', n.name = 'Dị tật Chiari', n.name_en = 'Chiari malformation', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/chiari-malformation/symptoms-causes/syc-20354010', n.overview = 'phần xương ở phía sau hộp sọ được cắt bỏ. Điều này nhường chỗ cho phần não gọi là tiểu não. Nó cũng làm giảm áp lực lên thân não, tiểu não và tủy sống. Dị tật Chiari (kee-AH-ree mal-for-MAY-shun) là t', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn hoặc con bạn có bất kỳ triệu chứng nào có thể liên quan đến dị tật Chiari. Nhiều triệu chứng của dị tật Chiari cũng có thể do các tình trạng khác gây ra. Đ';
MERGE (n:Disease {id: 'D0580'}) SET n.id = 'D0580', n.name = 'Thủy đậu', n.name_en = 'Chickenpox', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/chickenpox/symptoms-causes/syc-20351282 | https://medlineplus.gov/ency/article/001592.htm', n.overview = 'e, da đầu, ngực, lưng có vài nốt ở tay và chân. Các đốm nhanh chóng chứa đầy chất lỏng trong suốt, vỡ ra và sau đó đóng vảy. Thủy đậu e, da đầu, ngực, lưng có vài nốt ở tay chân. Các đốm nhanh chóng c', n.prognosis = 'Trong hầu hết các trường hợp, một người hồi phục mà không có biến chứng. Một khi bạn đã bị thủy đậu, virus thường không hoạt động hoặc ngủ yên trong cơ thể bạn suốt đời. Khoảng 1 trong 10 người trưởng', n.when_to_see = 'Nếu bạn cho rằng mình hoặc con bạn có thể bị thủy đậu, hãy gọi cho nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Thông thường, bệnh thủy đậu có thể được chẩn đoán bằng cách khám phát ban và các triệ';
MERGE (n:Disease {id: 'D0581'}) SET n.id = 'D0581', n.name = 'Bọ chét', n.name_en = 'Chiggers', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001333.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu phát ban rất ngứa hoặc nếu các triệu chứng của bạn trở nên tồi tệ hơn hoặc không cải thiện khi điều trị.';
MERGE (n:Disease {id: 'D0582'}) SET n.id = 'D0582', n.name = 'Chilblains', n.name_en = 'Chilblains', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/chilblains/symptoms-causes/syc-20351097', n.overview = 'vài giờ sau khi tiếp xúc với không khí lạnh nhưng không đóng băng. Chilblains (CHILL-blayns) là tình trạng gây ra các mảng sưng tấy và phồng rộp ở bàn tay và bàn chân. Nguyên nhân là do tiếp xúc với k', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế cho trẻ bị chilblains nếu bạn: Có các triệu chứng kéo dài hoặc biến mất sau đó bùng phát. Nghĩ rằng bạn có thể bị nhiễm trùng. Có các triệu chứng không cải thiện sau hai ';
MERGE (n:Disease {id: 'D0583'}) SET n.id = 'D0583', n.name = 'Lạm dụng trẻ em', n.name_en = 'Child abuse', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/child-abuse/symptoms-causes/syc-20370864', n.overview = 'Bất kỳ hành vi cố ý làm tổn hại hoặc ngược đãi trẻ em dưới 18 tuổi đều được coi là lạm dụng trẻ em. Lạm dụng trẻ em có nhiều hình thức và thường xảy ra cùng một lúc. Lạm dụng thể chất. Lạm dụng thể xá', n.when_to_see = 'Nếu bạn lo ngại rằng con bạn hoặc một đứa trẻ khác đã bị lạm dụng, hãy tìm kiếm sự giúp đỡ ngay lập tức. Tùy theo tình huống, hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của trẻ, cơ quan ph';
MERGE (n:Disease {id: 'D0584'}) SET n.id = 'D0584', n.name = 'Bỏ bê trẻ em và lạm dụng tình cảm', n.name_en = 'Child neglect and emotional abuse', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007225.htm', n.prognosis = 'Kết quả lâu dài phụ thuộc vào: Mức độ nghiêm trọng của việc lạm dụng Trẻ bị lạm dụng trong bao lâu Sự thành công của các lớp trị liệu và nuôi dạy con cái';
