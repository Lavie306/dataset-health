MERGE (n:Disease {id: 'D2358'}) SET n.id = 'D2358', n.name = 'Sơ cứu ngộ độc', n.name_en = 'Poisoning first aid', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007579.htm', n.when_to_see = 'Có thể liên hệ trực tiếp với trung tâm kiểm soát chất độc tại địa phương bằng cách gọi đến đường dây nóng Trợ giúp về chất độc miễn phí quốc gia (1-800-222-1222) từ bất kỳ nơi nào ở Hoa Kỳ. Đường dây ';
MERGE (n:Disease {id: 'D2359'}) SET n.id = 'D2359', n.name = 'Ngộ độc Pokeweed', n.name_en = 'Pokeweed poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002874.htm', n.prognosis = 'Sức khỏe của bạn phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Bạn nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Những cái chết đã được báo cáo. Nấu lá kh';
MERGE (n:Disease {id: 'D2360'}) SET n.id = 'D2360', n.name = 'Bệnh bại liệt', n.name_en = 'Polio', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/polio/symptoms-causes/syc-20376512 | https://medlineplus.gov/ency/article/001402.htm', n.overview = 'là một căn bệnh do virus gây ra, chủ yếu ảnh hưởng đến các dây thần kinh ở tủy sống hoặc thân não. Ở dạng nghiêm trọng nhất, bệnh bại liệt có thể khiến một người không thể cử động một số chi, còn gọi ', n.prognosis = 'Triển vọng phụ thuộc vào dạng bệnh và vùng cơ thể bị ảnh hưởng. Trong hầu hết các trường hợp, bệnh nhân có thể hồi phục hoàn toàn nếu tủy sống và não không bị ảnh hưởng. Liên quan đến não hoặc tủy sốn', n.when_to_see = 'Các dấu hiệu và triệu chứng của bệnh bại liệt tương tự như các bệnh do vi rút khác ảnh hưởng đến hệ thần kinh. Điều quan trọng là có được chẩn đoán kịp thời và chính xác. Nếu bạn bị bệnh bại liệt trướ';
MERGE (n:Disease {id: 'D2361'}) SET n.id = 'D2361', n.name = 'Vắc xin bại liệt - những điều bạn cần biết', n.name_en = 'Polio vaccine - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007606.htm', n.overview = 'Tại sao phải tiêm phòng? Vắc-xin bại liệt có thể ngăn ngừa bệnh bại liệt. Bệnh bại liệt (hay bệnh bại liệt) là một căn bệnh tàn tật và đe dọa tính mạng do virus bại liệt gây ra, có thể lây nhiễm vào t';
MERGE (n:Disease {id: 'D2362'}) SET n.id = 'D2362', n.name = 'Polyarteritis nodosa', n.name_en = 'Polyarteritis nodosa', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001438.htm', n.prognosis = 'Các phương pháp điều trị hiện tại bằng steroid và các loại thuốc khác ức chế hệ thống miễn dịch (chẳng hạn như azathioprine hoặc cyclophosphamide) có thể cải thiện các triệu chứng và cơ hội sống sót l', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn xuất hiện các triệu chứng của chứng rối loạn này. Chẩn đoán và điều trị sớm có thể cải thiện cơ hội đạt được kết quả tốt.';
MERGE (n:Disease {id: 'D2363'}) SET n.id = 'D2363', n.name = 'Bệnh thận đa nang', n.name_en = 'Polycystic kidney disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/polycystic-kidney-disease/symptoms-causes/syc-20352820 | https://medlineplus.gov/ency/article/000502.htm', n.overview = 'Thận đa nang giúp bổ máu và duy trì sự cân bằng hóa học của cơ thể. Với bệnh thận đa nang (phải), các túi chứa đầy chất lỏng gọi là u nang phát triển trong thận. Thận phát triển lớn hơn và dần dần mất', n.prognosis = 'Bệnh càng ngày càng nặng. Cuối cùng, nó có thể dẫn đến suy thận giai đoạn cuối. Nó cũng liên quan đến bệnh gan, bao gồm cả nhiễm trùng u nang gan. Việc điều trị có thể làm giảm các triệu chứng trong n', n.when_to_see = 'Mọi người thường mắc bệnh thận đa nang nhiều năm mà không hề hay biết. Nếu bạn có một số triệu chứng của bệnh thận đa nang, hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn. Nếu bạn có cha mẹ, anh chị';
MERGE (n:Disease {id: 'D2364'}) SET n.id = 'D2364', n.name = 'Hội chứng buồng trứng đa nang', n.name_en = 'Polycystic ovary syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000369.htm', n.prognosis = 'Khi được điều trị, phụ nữ mắc PCOS thường có khả năng mang thai. Trong thời kỳ mang thai, nguy cơ mắc phải: Sảy thai Huyết áp cao Tiểu đường thai kỳ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng của chứng rối loạn này.';
MERGE (n:Disease {id: 'D2365'}) SET n.id = 'D2365', n.name = 'Hội chứng buồng trứng đa nang (PCOS)', n.name_en = 'Polycystic ovary syndrome (PCOS)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pcos/symptoms-causes/syc-20353439', n.overview = 'Hội chứng buồng trứng đa nang là tình trạng chu kỳ kinh nguyệt của bạn có thể rất xa nhau, không đều hoặc rất dài. Điều đó cũng có thể có nghĩa là cơ thể bạn có quá nhiều nhóm hormone gọi là androgen ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn lo lắng về kinh nguyệt, nếu bạn gặp khó khăn khi mang thai hoặc nếu bạn có các triệu chứng của quá nhiều androgen. Chúng có thể bao gồm sự phát triển của t';
MERGE (n:Disease {id: 'D2366'}) SET n.id = 'D2366', n.name = 'Bệnh đa hồng cầu - trẻ sơ sinh', n.name_en = 'Polycythemia - newborn', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000536.htm', n.prognosis = 'Triển vọng tốt cho trẻ sơ sinh bị tăng độ nhớt nhẹ. Kết quả tốt cũng có thể xảy ra ở những trẻ sơ sinh được điều trị tình trạng tăng độ nhớt nghiêm trọng. Triển vọng sẽ phụ thuộc phần lớn vào lý do củ';
MERGE (n:Disease {id: 'D2367'}) SET n.id = 'D2367', n.name = 'Bệnh đa hồng cầu', n.name_en = 'Polycythemia vera', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/polycythemia-vera/symptoms-causes/syc-20355850 | https://medlineplus.gov/ency/article/000589.htm', n.overview = '(pol-e-sy-THEE-me-uh VEER-uh) là một loại ung thư máu. Nó khiến tủy xương tạo ra quá nhiều tế bào hồng cầu. Những tế bào bổ sung này làm dày máu, làm chậm dòng chảy của nó. Điều này có thể gây ra các ', n.prognosis = 'PV thường phát triển chậm. Hầu hết mọi người không có triệu chứng liên quan đến bệnh tại thời điểm chẩn đoán. Tình trạng này thường được chẩn đoán trước khi các triệu chứng nghiêm trọng xảy ra.', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của bệnh đa hồng cầu.';
MERGE (n:Disease {id: 'D2368'}) SET n.id = 'D2368', n.name = 'Polydactyly', n.name_en = 'Polydactyly', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003176.htm', n.when_to_see = 'Hầu hết, tình trạng này được phát hiện khi sinh khi em bé vẫn còn nằm viện.';
MERGE (n:Disease {id: 'D2369'}) SET n.id = 'D2369', n.name = 'Đa ối', n.name_en = 'Polyhydramnios', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/polyhydramnios/symptoms-causes/syc-20368493 | https://medlineplus.gov/ency/article/003267.htm', n.overview = 'khi mang thai, lượng nước ối tích tụ trong tử cung tăng lên khi mang thai. Những trường hợp đa ối nhẹ có thể tự khỏi. Trường hợp nặng có thể cần điều trị. Đa ối (pol-e-hi-DRAM-nee-os) là sự tích tụ củ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn đang mang thai và nhận thấy rằng bụng của bạn đang to lên rất nhanh.';
MERGE (n:Disease {id: 'D2370'}) SET n.id = 'D2370', n.name = 'Phát ban ánh sáng đa hình', n.name_en = 'Polymorphous light eruption', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/polymorphous-light-eruption/symptoms-causes/syc-20355868 | https://medlineplus.gov/ency/article/001477.htm', n.overview = 'là phát ban do tiếp xúc với ánh nắng mặt trời ở những người nhạy cảm với ánh sáng mặt trời. Đa hình có nghĩa là phát ban có thể có nhiều dạng, chẳng hạn như vết sưng nhỏ, vùng nổi lên hoặc mụn nước. T', n.prognosis = 'Nhiều người trở nên ít nhạy cảm hơn với ánh sáng mặt trời theo thời gian.', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị phát ban mà không có nguyên nhân rõ ràng, chẳng hạn như dị ứng đã biết hoặc tiếp xúc gần đây với cây thường xuân độc. Phát ban phun trào nhẹ đa ';
MERGE (n:Disease {id: 'D2371'}) SET n.id = 'D2371', n.name = 'Đau đa cơ dạng thấp', n.name_en = 'Polymyalgia rheumatica', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/polymyalgia-rheumatica/symptoms-causes/syc-20376539 | https://medlineplus.gov/ency/article/000415.htm', n.overview = 'là một tình trạng viêm. Nó gây đau và cứng khớp và cơ, chủ yếu ở vai và hông. Các triệu chứng của bệnh đau đa cơ do thấp khớp (pol-e-my-AL-juh rue-MAT-ih-kuh) có thể bắt đầu nhanh chóng hoặc xuất hiện', n.prognosis = 'Đối với hầu hết mọi người, PMR sẽ biến mất sau 1 đến 2 năm điều trị. Bạn có thể ngừng dùng thuốc sau thời điểm này, nhưng trước tiên hãy kiểm tra với nhà cung cấp dịch vụ của bạn. Đối với một số người', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn bị yếu hoặc cứng ở vai và cổ mà không biến mất. Đồng thời liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng mới như sốt, nhức đầu và đau ';
MERGE (n:Disease {id: 'D2372'}) SET n.id = 'D2372', n.name = 'Viêm đa cơ', n.name_en = 'Polymyositis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/polymyositis/symptoms-causes/syc-20353208', n.overview = '(pol-e-my-o-SY-tis) là tình trạng sưng tấy và kích ứng, gọi là viêm, xảy ra khi hệ thống miễn dịch tấn công các mô cơ của chính nó. Viêm đa cơ gây ra tình trạng yếu các cơ tham gia chuyển động của cơ ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn bị yếu cơ. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2373'}) SET n.id = 'D2373', n.name = 'Viêm đa cơ - người lớn', n.name_en = 'Polymyositis - adult', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000428.htm', n.prognosis = 'Phản ứng với điều trị khác nhau, tùy theo biến chứng. Có đến 1 trong 5 người có thể chết trong vòng 5 năm kể từ khi mắc bệnh. Nhiều người, đặc biệt là trẻ em, khỏi bệnh và không cần điều trị liên tục.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của chứng rối loạn này. Tìm cách điều trị khẩn cấp nếu bạn bị khó thở và khó nuốt.';
MERGE (n:Disease {id: 'D2374'}) SET n.id = 'D2374', n.name = 'Bệnh chàm Pompholyx', n.name_en = 'Pompholyx eczema', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000832.htm', n.prognosis = 'Bệnh chàm Pompholyx thường biến mất mà không có vấn đề gì, nhưng các triệu chứng có thể quay trở lại. Gãi mạnh có thể dẫn đến da dày, bị kích ứng. Đây được gọi là da lichen hóa. Điều này làm cho vấn đ', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Các dấu hiệu nhiễm trùng như đau, đỏ, ấm hoặc sốt Phát ban không biến mất bằng các phương pháp điều trị đơn giản tại nhà';
MERGE (n:Disease {id: 'D2375'}) SET n.id = 'D2375', n.name = 'Phình động mạch khoeo', n.name_en = 'Popliteal artery aneurysm', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/popliteal-artery-aneurysm/symptoms-causes/syc-20355432', n.overview = 'Phình động mạch khoeo là một khối phồng bất thường xảy ra ở thành động mạch nằm phía sau khớp gối. Đó là một loại chứng phình động mạch chi dưới. Sản phẩm & Dịch vụ Sách: Sách sức khỏe gia đình Mayo C';
MERGE (n:Disease {id: 'D2376'}) SET n.id = 'D2376', n.name = 'Hội chứng kẹt động mạch khoeo', n.name_en = 'Popliteal artery entrapment syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/popliteal-artery-entrapment/symptoms-causes/syc-20465211', n.overview = ', còn được gọi là PAES, là một tình trạng hiếm gặp ảnh hưởng đến động mạch chính phía sau đầu gối. Động mạch đó là động mạch khoeo. Trong tình trạng này, cơ bắp chân nằm sai vị trí hoặc to hơn bình th', n.when_to_see = 'Hãy hẹn khám sức khỏe nếu bạn bị đau chân. Điều này đặc biệt quan trọng nếu bạn bị chuột rút ở bắp chân hoặc bàn chân khi hoạt động và tình trạng này sẽ thuyên giảm khi nghỉ ngơi. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2377'}) SET n.id = 'D2377', n.name = 'Porphyria', n.name_en = 'Porphyria', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/porphyria/symptoms-causes/syc-20356066 | https://medlineplus.gov/ency/article/001208.htm', n.overview = '(por-FEAR-e-uh) đề cập đến một nhóm rối loạn hiếm gặp do sự tích tụ các hóa chất tự nhiên gọi là porphyrin trong cơ thể. Porphyrin cần thiết để tạo ra heme, một phần của huyết sắc tố. Hemoglobin là mộ', n.prognosis = 'Porphyria là một căn bệnh kéo dài suốt đời với các triệu chứng đến rồi đi. Một số dạng bệnh gây ra nhiều triệu chứng hơn những dạng khác. Việc điều trị thích hợp và tránh xa các tác nhân gây bệnh có t', n.when_to_see = 'Nhiều triệu chứng của bệnh rối loạn chuyển hóa porphyrin cũng giống như các triệu chứng khác, phổ biến hơn. Điều này có thể gây khó khăn cho việc biết liệu bạn có đang bị bệnh rối loạn chuyển hóa porp';
MERGE (n:Disease {id: 'D2378'}) SET n.id = 'D2378', n.name = 'Vết rượu vang cảng', n.name_en = 'Port-wine stain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001475.htm', n.prognosis = 'Các vết bẩn trên mặt phản ứng tốt hơn với liệu pháp laser so với các vết bẩn trên cánh tay, chân hoặc giữa cơ thể. Các vết bẩn cũ có thể khó xử lý hơn.', n.when_to_see = 'Tất cả các vết bớt phải được nhà cung cấp đánh giá trong quá trình khám định kỳ.';
MERGE (n:Disease {id: 'D2379'}) SET n.id = 'D2379', n.name = 'Cắt shunt tĩnh mạch cửa', n.name_en = 'Portacaval shunting', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007336.htm', n.overview = 'là một cuộc phẫu thuật lớn. Nó liên quan đến một vết cắt lớn (vết mổ) ở vùng bụng (bụng). Sau đó, bác sĩ phẫu thuật sẽ tạo một kết nối giữa tĩnh mạch cửa (cung cấp phần lớn máu cho gan) và tĩnh mạch c';
MERGE (n:Disease {id: 'D2380'}) SET n.id = 'D2380', n.name = 'Tăng áp lực tĩnh mạch cửa', n.name_en = 'Portal hypertension', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/portal-hypertension/symptoms-causes/syc-20599670', n.overview = 'Lưu lượng máu qua gan điển hình so với tăng áp lực tĩnh mạch cửa và tăng áp lực tĩnh mạch cửa Ở một lá gan khỏe mạnh (ảnh trên), máu chảy vào và được lọc, sau đó được gửi đến tim. Khi bị tăng huyết áp';
