MERGE (n:Disease {id: 'D0857'}) SET n.id = 'D0857', n.name = 'Kỷ lục các cột mốc phát triển - 5 tuổi', n.name_en = 'Developmental milestones record - 5 years', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002016.htm', n.overview = 'Các cột mốc kỹ năng thể chất và vận động của một đứa trẻ 5 tuổi điển hình bao gồm: Tăng khoảng 4 đến 5 pound mỗi năm (1,8 đến 2,25 kg) Tăng khoảng 2 đến 3 inch mỗi năm (5 đến 7,5 cm) Thị lực đạt 20/20';
