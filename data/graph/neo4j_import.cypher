MERGE (n:Disease {id: 'D1921'}) SET n.id = 'D1921', n.name = 'Bệnh thay đổi tối thiểu', n.name_en = 'Minimal change disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000496.htm', n.prognosis = 'Trẻ em thường đáp ứng với corticosteroid tốt hơn người lớn. Trẻ em thường đáp ứng trong tháng đầu điều trị. Sự tái phát có thể xảy ra. Tình trạng này có thể cải thiện sau khi điều trị lâu dài bằng cor', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Bạn xuất hiện các triệu chứng của bệnh thay đổi tối thiểu Bạn mắc chứng rối loạn này và các triệu chứng của bạn trở nên tồi tệ hơn Bạn xuất hiện các triệu chứng m';
MERGE (n:Disease {id: 'D1922'}) SET n.id = 'D1922', n.name = 'Thay khớp háng xâm lấn tối thiểu', n.name_en = 'Minimally invasive hip replacement', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007498.htm', n.overview = 'Để thực hiện phẫu thuật này: Một vết cắt sẽ được thực hiện ở một trong ba vị trí -- ở phía sau hông (trên mông), ở phía trước hông (gần háng) hoặc ở một bên hông. Bác sĩ phẫu thuật của bạn sẽ giải thí';
MERGE (n:Disease {id: 'D1923'}) SET n.id = 'D1923', n.name = 'Sảy thai', n.name_en = 'Miscarriage', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/pregnancy-loss-miscarriage/symptoms-causes/syc-20354298 | https://medlineplus.gov/ency/article/001488.htm', n.overview = 'là tình trạng mất thai đột ngột trước tuần thứ 20. Khoảng 10% đến 20% trường hợp mang thai được biết đến đều kết thúc bằng sẩy thai. Nhưng con số thực tế có thể cao hơn. Điều này là do nhiều trường hợ', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn: Bị chảy máu âm đạo có hoặc không bị chuột rút khi mang thai. Đang mang thai và nhận thấy mô hoặc chất giống như cục máu đông đi qua âm đạo của bạn. Th';
MERGE (n:Disease {id: 'D1924'}) SET n.id = 'D1924', n.name = 'Sẩy thai - dọa sảy', n.name_en = 'Miscarriage - threatened', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000907.htm', n.prognosis = 'Hầu hết phụ nữ bị dọa sẩy thai đều có thai kỳ bình thường. Những phụ nữ đã sẩy thai từ hai lần trở lên liên tiếp có thể dễ bị sẩy thai lần nữa hơn những phụ nữ khác.', n.when_to_see = 'Nếu bạn biết mình đang (hoặc có khả năng) mang thai và có bất kỳ triệu chứng nào của việc dọa sẩy thai, hãy liên hệ ngay với nhà cung cấp dịch vụ khám thai của bạn.';
MERGE (n:Disease {id: 'D1925'}) SET n.id = 'D1925', n.name = 'Ngộ độc cây tầm gửi', n.name_en = 'Mistletoe poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002883.htm', n.prognosis = 'Tình trạng sức khỏe của bạn phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Bạn nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Các triệu chứng kéo dài từ 1 đ';
MERGE (n:Disease {id: 'D1926'}) SET n.id = 'D1926', n.name = 'Hẹp hai lá', n.name_en = 'Mitral stenosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000175.htm', n.prognosis = 'Kết quả sẽ khác nhau. Rối loạn này có thể nhẹ, không có triệu chứng hoặc có thể nặng hơn và trở nên tàn tật theo thời gian. Các biến chứng có thể nghiêm trọng hoặc đe dọa tính mạng. Trong hầu hết các ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có các triệu chứng hẹp van hai lá. Bạn bị hẹp van hai lá và các triệu chứng không cải thiện khi điều trị hoặc xuất hiện các triệu chứng mới.';
MERGE (n:Disease {id: 'D1927'}) SET n.id = 'D1927', n.name = 'Bệnh van hai lá', n.name_en = 'Mitral valve disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mitral-valve-disease/symptoms-causes/syc-20355107', n.overview = 'Sa van hai lá và hở van hai lá Van hai lá ngăn cách hai buồng tim bên trái. Trong tình trạng sa van hai lá, các vạt van phình ra vào khoang trên bên trái trong mỗi nhịp tim. Sa van hai lá có thể khiến', n.when_to_see = 'Nếu bạn có các triệu chứng của bệnh van hai lá, bạn có thể được giới thiệu đến một bác sĩ được đào tạo về bệnh tim, được gọi là bác sĩ tim mạch. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1928'}) SET n.id = 'D1928', n.name = 'Sa van hai lá', n.name_en = 'Mitral valve prolapse', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/mitral-valve-prolapse/symptoms-causes/syc-20355446 | https://medlineplus.gov/ency/article/000180.htm', n.overview = 'là một loại bệnh van tim ảnh hưởng đến van giữa buồng tim trái. Các nắp (tờ rơi) của van hai lá có dạng mềm. Chúng phình ra phía sau (sa ra) giống như một chiếc dù rơi vào khoang trên bên trái của tim', n.prognosis = 'Hầu hết, sa van hai lá là vô hại và không gây ra triệu chứng. Các triệu chứng xảy ra có thể được điều trị và kiểm soát bằng thuốc hoặc phẫu thuật. Một số nhịp tim bất thường (loạn nhịp tim) ở những ng', n.when_to_see = 'Nếu bạn có các triệu chứng sa van hai lá, hãy hẹn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Nhiều tình trạng khác có thể gây ra các triệu chứng tương tự. Nếu bạn bị đau ngực đột ngột hoặc bấ';
MERGE (n:Disease {id: 'D1929'}) SET n.id = 'D1929', n.name = 'Hở van hai lá', n.name_en = 'Mitral valve regurgitation', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/mitral-valve-regurgitation/symptoms-causes/syc-20350178 | https://medlineplus.gov/ency/article/000176.htm', n.overview = 'là một loại bệnh van tim phổ biến, còn gọi là bệnh van tim. Trong tình trạng này, van giữa buồng tim trái không hoạt động hoàn toàn. Máu chảy ngược qua van. Nếu máu chảy ngược nhiều thì phần còn lại c', n.prognosis = 'Kết quả sẽ khác nhau. Hầu hết tình trạng này đều nhẹ nên không cần điều trị hoặc hạn chế. Các triệu chứng thường có thể được kiểm soát bằng thuốc.', n.when_to_see = 'Nếu bạn có triệu chứng hở van hai lá hãy đặt lịch hẹn khám sức khỏe. Bạn có thể được gửi đến một bác sĩ được đào tạo về bệnh tim, được gọi là bác sĩ tim mạch. Yêu cầu một cuộc hẹn Có vấn đề với
 thông';
MERGE (n:Disease {id: 'D1930'}) SET n.id = 'D1930', n.name = 'Hẹp van hai lá', n.name_en = 'Mitral valve stenosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mitral-valve-stenosis/symptoms-causes/syc-20353159', n.overview = 'Tim và tim điển hình bị hẹp van hai lá Hẹp van hai lá Hẹp van hai lá, được minh họa ở hình trái tim bên phải, là tình trạng van hai lá của tim bị thu hẹp. Van không mở đúng cách, chặn dòng máu chảy và', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn ngay nếu bạn bị đau ngực, nhịp tim nhanh, đập hoặc đập mạnh hoặc khó thở khi hoạt động. Chuyên gia chăm sóc sức khỏe của bạn có thể yêu cầu bạn đến gặp';
MERGE (n:Disease {id: 'D1931'}) SET n.id = 'D1931', n.name = 'Phẫu thuật van hai lá - xâm lấn tối thiểu', n.name_en = 'Mitral valve surgery - minimally invasive', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007411.htm', n.overview = 'Trước khi phẫu thuật, bạn sẽ được gây mê toàn thân. Bạn sẽ ngủ và không bị đau. Có một số cách khác nhau để thực hiện phẫu thuật van hai lá xâm lấn tối thiểu. Bác sĩ phẫu thuật tim của bạn có thể thực', n.prognosis = 'Van tim cơ học không thường xuyên bị hỏng. Tuy nhiên, cục máu đông có thể phát triển trên chúng. Nếu cục máu đông hình thành, bạn có thể bị đột quỵ. Chảy máu có thể xảy ra, nhưng điều này rất hiếm. Va';
MERGE (n:Disease {id: 'D1932'}) SET n.id = 'D1932', n.name = 'Phẫu thuật van hai lá - mở', n.name_en = 'Mitral valve surgery - open', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007412.htm', n.overview = 'Trước khi phẫu thuật, bạn sẽ được gây mê toàn thân. Bạn sẽ ngủ và không đau trong suốt quá trình thực hiện. Bác sĩ phẫu thuật sẽ thực hiện một vết cắt dài 10 inch (25,4 cm) ở giữa ngực của bạn. Tiếp t', n.prognosis = 'Van tim cơ học có tuổi thọ suốt đời. Tuy nhiên, cục máu đông có thể phát triển trên chúng. Điều này có thể khiến chúng bị nhiễm trùng hoặc bị tắc. Nếu cục máu đông hình thành, bạn có thể bị đột quỵ. V';
MERGE (n:Disease {id: 'D1933'}) SET n.id = 'D1933', n.name = 'Mittelschmerz', n.name_en = 'Mittelschmerz', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/mittelschmerz/symptoms-causes/syc-20375122 | https://medlineplus.gov/ency/article/001503.htm', n.overview = 'Hệ thống sinh sản nữ, tử cung, cổ tử cung và âm đạo, còn được gọi là ống âm đạo, tạo nên hệ thống sinh sản nữ. Mittelschmerz là tình trạng đau bụng dưới một bên liên quan đến quá trình rụng trứng. Tiế', n.prognosis = 'Mittelschmerz có thể gây đau nhưng không gây hại. Đó không phải là dấu hiệu của bệnh tật. Nó có thể giúp phụ nữ biết được thời điểm trứng rụng trong chu kỳ kinh nguyệt. Điều quan trọng là bạn phải thả', n.when_to_see = 'Mittelschmerz hiếm khi cần đến sự can thiệp của y tế. Tuy nhiên, hãy liên hệ với bác sĩ nếu cơn đau vùng chậu mới trở nên trầm trọng, kèm theo buồn nôn hoặc sốt hoặc nếu nó kéo dài - bất kỳ điều nào t';
MERGE (n:Disease {id: 'D1934'}) SET n.id = 'D1934', n.name = 'Bệnh mô liên kết hỗn hợp', n.name_en = 'Mixed connective tissue disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mixed-connective-tissue-disease/symptoms-causes/syc-20375147', n.overview = ', còn được gọi là MCTD, có các triệu chứng của nhiều tình trạng thấp khớp. Những tình trạng này bao gồm lupus, xơ cứng bì và viêm cơ. Nhiều người mắc bệnh mô liên kết hỗn hợp cũng bị viêm khớp và hội ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn có các triệu chứng khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D1935'}) SET n.id = 'D1935', n.name = 'Vắc xin MMR (sởi, quai bị và rubella) - những điều bạn cần biết', n.name_en = 'MMR (measles, mumps, and rubella) vaccine - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007603.htm', n.overview = 'Tại sao phải tiêm vắc xin? Vắc-xin MMR có thể ngăn ngừa bệnh sởi, quai bị và rubella. SỞI (M) gây sốt, ho, sổ mũi, đỏ mắt, chảy nước mắt, sau đó thường phát ban khắp cơ thể. Nó có thể dẫn đến co giật ';
MERGE (n:Disease {id: 'D1936'}) SET n.id = 'D1936', n.name = 'Vắc xin MMRV (sởi, quai bị, rubella và thủy đậu) - những điều bạn cần biết', n.name_en = 'MMRV (measles, mumps, rubella, and varicella) vaccine - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007604.htm', n.overview = 'Tại sao phải tiêm vắc xin? Vắc-xin MMRV có thể ngăn ngừa bệnh sởi, quai bị, rubella và thủy đậu. SỞI (M) gây sốt, ho, sổ mũi, đỏ mắt, chảy nước mắt, sau đó thường phát ban khắp cơ thể. Nó có thể dẫn đ';
MERGE (n:Disease {id: 'D1937'}) SET n.id = 'D1937', n.name = 'Phẫu thuật vi mô Mohs', n.name_en = 'Mohs micrographic surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007634.htm', n.overview = 'Phẫu thuật Mohs thường diễn ra tại phòng khám của bác sĩ phẫu thuật. Phẫu thuật thường được bắt đầu vào sáng sớm và hoàn thành trong một ngày. Đôi khi nếu khối u lớn hoặc bạn cần tái tạo, có thể phải ', n.prognosis = 'Phẫu thuật Mohs có tỷ lệ chữa khỏi bệnh ung thư da là 99%. Với phẫu thuật này, lượng mô nhỏ nhất có thể sẽ được loại bỏ. Bạn sẽ có vết sẹo nhỏ hơn so với những lựa chọn điều trị khác.';
MERGE (n:Disease {id: 'D1938'}) SET n.id = 'D1938', n.name = 'Mang thai trứng', n.name_en = 'Molar pregnancy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/molar-pregnancy/symptoms-causes/syc-20375175', n.overview = 'Mang thai trứng là một biến chứng hiếm gặp của thai kỳ. Nó liên quan đến sự phát triển bất thường của các tế bào được gọi là nguyên bào nuôi. Những tế bào này thường trở thành cơ quan nuôi dưỡng bào t';
MERGE (n:Disease {id: 'D1939'}) SET n.id = 'D1939', n.name = 'Dị ứng nấm mốc', n.name_en = 'Mold allergy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mold-allergy/symptoms-causes/syc-20351519', n.overview = 'Nếu bạn bị dị ứng nấm mốc, hệ thống miễn dịch của bạn quá nhạy cảm với bào tử nấm mốc. Dị ứng nấm mốc có thể gây ho, ngứa mắt và các triệu chứng khác khiến bạn khó chịu. Ở một số người, dị ứng nấm mốc', n.when_to_see = 'Nếu bạn bị nghẹt mũi, hắt hơi, chảy nước mắt, khó thở, thở khò khè hoặc các triệu chứng khó chịu khác kéo dài, hãy đến gặp chuyên gia chăm sóc sức khỏe.';
MERGE (n:Disease {id: 'D1940'}) SET n.id = 'D1940', n.name = 'Nốt ruồi', n.name_en = 'Moles', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/moles/symptoms-causes/syc-20375200', n.overview = 'Nốt ruồi trên mặt thường có đường kính nhỏ hơn 1/4 inch (khoảng 6 mm) - kích thước của một cục tẩy bút chì. Nốt ruồi hoặc nếp nhăn. Nói chuyện với bác sĩ của bạn về bất kỳ thay đổi nào về màu sắc hoặc', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu nốt ruồi trông bất thường, phát triển hoặc thay đổi. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thôn';
MERGE (n:Disease {id: 'D1941'}) SET n.id = 'D1941', n.name = 'U mềm lây', n.name_en = 'Molluscum contagiosum', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/molluscum-contagiosum/symptoms-causes/syc-20375226 | https://medlineplus.gov/ency/article/000826.htm', n.overview = '(mo-LUS-kum-kum kun-tay-jee-OH-sum) là một bệnh nhiễm trùng da khá phổ biến do virus gây ra. Nó gây ra những vết sưng tròn, chắc, không đau, có kích thước từ đầu đinh đến cục tẩy bút chì. Nếu vết sưng', n.prognosis = 'Tổn thương u mềm lây có thể tồn tại từ vài tháng đến vài năm. Cuối cùng chúng biến mất mà không để lại sẹo, trừ khi bị gãi quá nhiều, có thể để lại sẹo hoặc đổi màu. Rối loạn này có thể tồn tại ở nhữn', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có vấn đề về da trông giống như u mềm lây. Các tổn thương u mềm lây vẫn tồn tại hoặc lan rộng hoặc nếu các triệu chứng mới xuất hiện';
MERGE (n:Disease {id: 'D1942'}) SET n.id = 'D1942', n.name = 'Bệnh gammopathy đơn dòng có ý nghĩa không xác định (MGUS)', n.name_en = 'Monoclonal gammopathy of undetermined significance (MGUS)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mgus/symptoms-causes/syc-20352362', n.overview = 'Bệnh gammopathy đơn dòng có ý nghĩa không xác định, còn được gọi là MGUS, là một tình trạng gây ra bởi sự phát triển của các tế bào plasma bị biến đổi. Tế bào plasma là một loại tế bào bạch cầu thường';
MERGE (n:Disease {id: 'D1943'}) SET n.id = 'D1943', n.name = 'Bệnh đơn dây thần kinh', n.name_en = 'Mononeuropathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000780.htm', n.prognosis = 'Bệnh đơn dây thần kinh có thể gây tàn tật và đau đớn. Nếu nguyên nhân của rối loạn chức năng thần kinh có thể được tìm thấy và điều trị thành công thì trong một số trường hợp có thể phục hồi hoàn toàn';
MERGE (n:Disease {id: 'D1944'}) SET n.id = 'D1944', n.name = 'Bệnh bạch cầu đơn nhân', n.name_en = 'Mononucleosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/mononucleosis/symptoms-causes/syc-20350328 | https://medlineplus.gov/ency/article/000591.htm', n.overview = 'Bệnh bạch cầu đơn nhân truyền nhiễm (mono) thường được gọi là bệnh hôn. Vi-rút gây bệnh mono (vi-rút Epstein-Barr) lây lan qua nước bọt. Bạn có thể lây bệnh qua hôn, nhưng bạn cũng có thể bị phơi nhiễ', n.prognosis = 'Sốt thường giảm sau 10 ngày, các hạch bạch huyết và lá lách sưng tấy sẽ lành sau 4 tuần. Tình trạng mệt mỏi thường biến mất trong vòng vài tuần nhưng có thể kéo dài từ 2 đến 3 tháng. Gần như tất cả mọ', n.when_to_see = 'Các triệu chứng ban đầu của bệnh mono rất giống với bất kỳ căn bệnh nào khác do vi-rút gây ra. Bạn không cần liên hệ với nhà cung cấp dịch vụ trừ khi các triệu chứng của bạn kéo dài hơn 10 ngày hoặc b';
MERGE (n:Disease {id: 'D1945'}) SET n.id = 'D1945', n.name = 'Rối loạn tâm trạng', n.name_en = 'Mood disorders', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mood-disorders/symptoms-causes/syc-20365057', n.overview = ', chẳng hạn như trầm cảm và rối loạn lưỡng cực, ảnh hưởng đến cảm xúc của con người. Nếu bạn bị trầm cảm, bạn có thể liên tục cảm thấy buồn. Bạn cũng có thể lo lắng. Nếu bạn bị rối loạn lưỡng cực, bạn', n.when_to_see = 'Nếu bạn lo lắng rằng mình có thể bị rối loạn tâm trạng, hãy đến gặp bác sĩ hoặc chuyên gia sức khỏe tâm thần càng sớm càng tốt. Nếu bạn không chắc chắn mình muốn tìm cách điều trị, hãy nói chuyện với ';
MERGE (n:Disease {id: 'D1946'}) SET n.id = 'D1946', n.name = 'Phản xạ Moro', n.name_en = 'Moro reflex', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003293.htm';
MERGE (n:Disease {id: 'D1947'}) SET n.id = 'D1947', n.name = 'Morphea', n.name_en = 'Morphea', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/morphea/symptoms-causes/syc-20375283', n.overview = 'có nhiều mảng u phát triển ở trung tâm màu trắng hoặc ngà chắc chắn. Vùng da bị ảnh hưởng trở nên căng và kém linh hoạt. Morphea (mor-FEE-uh) là một tình trạng hiếm gặp gây ra các mảng bị đổi màu, khô', n.when_to_see = 'Hãy gặp bác sĩ nếu bạn nhận thấy các mảng da cứng hoặc dày màu đỏ. Chẩn đoán và điều trị sớm có thể giúp làm chậm sự phát triển của các mảng da mới và cho phép bác sĩ xác định và điều trị các biến chứ';
MERGE (n:Disease {id: 'D1948'}) SET n.id = 'D1948', n.name = 'Quá liều morphin', n.name_en = 'Morphine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002502.htm', n.prognosis = 'Tình trạng sức khỏe của người đó phụ thuộc vào mức độ nghiêm trọng của quá liều và tốc độ điều trị được tiếp nhận. Nếu có thể sử dụng chất đối kháng ma túy thích hợp (thuốc chống lại tác dụng của ma t';
MERGE (n:Disease {id: 'D1949'}) SET n.id = 'D1949', n.name = 'U thần kinh Morton', n.name_en = 'Morton neuroma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/mortons-neuroma/symptoms-causes/syc-20351935 | https://medlineplus.gov/ency/article/007286.htm', n.overview = 'bám vào ngón chân bạn. Điều này có thể gây ra cảm giác đau rát, rát ở mu bàn chân. Bạn có thể bị châm chích, nóng rát hoặc tê ở những ngón chân bị ảnh hưởng. U dây thần kinh Morton là một dây thần kin', n.prognosis = 'Điều trị không phẫu thuật không phải lúc nào cũng cải thiện được triệu chứng. Phẫu thuật để loại bỏ mô dày thành công trong hầu hết các trường hợp.', n.when_to_see = 'Tốt nhất đừng bỏ qua bất kỳ cơn đau chân nào kéo dài hơn vài ngày. Hãy đến gặp chuyên gia chăm sóc sức khỏe nếu bạn cảm thấy đau rát ở mu bàn chân và tình trạng này không cải thiện khi thay giày dép h';
MERGE (n:Disease {id: 'D1950'}) SET n.id = 'D1950', n.name = 'Chủ nghĩa khảm', n.name_en = 'Mosaicism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001317.htm', n.prognosis = 'Bạn hoạt động tốt như thế nào tùy thuộc vào cơ quan và mô nào bị ảnh hưởng (ví dụ: não hoặc tim). Thật khó để dự đoán tác động của việc có hai dòng tế bào khác nhau trong một người. Nhìn chung, những ', n.when_to_see = 'Việc chẩn đoán bệnh khảm có thể gây nhầm lẫn và không chắc chắn. Một cố vấn di truyền có thể giúp trả lời bất kỳ câu hỏi nào về chẩn đoán và xét nghiệm.';
MERGE (n:Disease {id: 'D1951'}) SET n.id = 'D1951', n.name = 'Vết muỗi đốt', n.name_en = 'Mosquito bites', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mosquito-bites/symptoms-causes/syc-20375310', n.overview = 'là những vết ngứa hình thành trên da sau khi muỗi hút máu bạn. Các vết sưng tấy thường biến mất mà không cần điều trị trong vài ngày. Một số vết muỗi đốt có thể bị sưng, đau và viêm. Loại phản ứng này', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu vết muỗi đốt dường như xảy ra kèm theo các dấu hiệu cảnh báo về tình trạng nghiêm trọng. Chúng có thể bao gồm sốt cao, nhức đầu dữ dộ';
MERGE (n:Disease {id: 'D1952'}) SET n.id = 'D1952', n.name = 'Ung thư miệng', n.name_en = 'Mouth cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mouth-cancer/symptoms-causes/syc-20350997', n.overview = 'Ung thư miệng là gì? Chuyên gia của Mayo Clinic giải thích Tìm hiểu thêm về ung thư miệng, còn được gọi là ung thư miệng, từ bác sĩ ung thư Katharine Price, M.D. Hiển thị bản ghi cho video Ung thư miệ', n.when_to_see = 'Hãy hẹn gặp bác sĩ, nha sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
