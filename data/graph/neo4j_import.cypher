MERGE (n:Disease {id: 'D1183'}) SET n.id = 'D1183', n.name = 'Thiếu folate', n.name_en = 'Folate deficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000354.htm';
MERGE (n:Disease {id: 'D1184'}) SET n.id = 'D1184', n.name = 'Thiếu máu do thiếu folate', n.name_en = 'Folate-deficiency anemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000551.htm', n.prognosis = 'Bệnh thiếu máu do thiếu folate thường đáp ứng tốt với điều trị trong vòng 3 đến 6 tháng. Nó có thể sẽ trở nên tốt hơn khi nguyên nhân cơ bản của sự thiếu hụt được điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng thiếu máu do thiếu folate.';
MERGE (n:Disease {id: 'D1185'}) SET n.id = 'D1185', n.name = 'U lympho nang', n.name_en = 'Follicular lymphoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/follicular-lymphoma/symptoms-causes/syc-20584732', n.overview = 'là một loại ung thư hạch. Ung thư hạch là bệnh ung thư ảnh hưởng đến hệ bạch huyết. Hệ bạch huyết được tạo thành từ các cơ quan, tuyến, mạch dạng ống và cụm tế bào gọi là hạch bạch huyết. Nó là một ph', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1186'}) SET n.id = 'D1186', n.name = 'Viêm nang lông', n.name_en = 'Folliculitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/folliculitis/symptoms-causes/syc-20361634 | https://medlineplus.gov/ency/article/000823.htm', n.overview = 'là một tình trạng da phổ biến xảy ra khi nang lông bị viêm. Nó thường được gây ra bởi nhiễm trùng vi khuẩn. Lúc đầu, nó có thể trông giống như những mụn nhỏ xung quanh các túi nhỏ nơi mỗi sợi tóc mọc ', n.prognosis = 'Viêm nang lông thường đáp ứng tốt với điều trị nhưng có thể tái phát.', n.when_to_see = 'Hãy hẹn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu tình trạng của bạn lan rộng hoặc các triệu chứng không biến mất sau một hoặc hai tuần thực hiện các biện pháp tự chăm sóc. Bạn có thể cần';
MERGE (n:Disease {id: 'D1187'}) SET n.id = 'D1187', n.name = 'Thóp - phồng', n.name_en = 'Fontanelles - bulging', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003310.htm', n.when_to_see = 'Cần phải chăm sóc khẩn cấp ngay lập tức đối với bất kỳ trẻ sơ sinh nào có thóp thực sự phồng lên, đặc biệt nếu tình trạng này xảy ra cùng với sốt hoặc buồn ngủ quá mức.';
MERGE (n:Disease {id: 'D1188'}) SET n.id = 'D1188', n.name = 'Thóp - phì đại', n.name_en = 'Fontanelles - enlarged', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003311.htm', n.when_to_see = 'Nếu bạn cho rằng thóp trên đầu của bé lớn hơn bình thường, hãy nói chuyện với bác sĩ nhà cung cấp dịch vụ chăm sóc sức khoẻ của trẻ. Thông thường, dấu hiệu này sẽ được nhìn thấy trong lần khám sức khỏ';
MERGE (n:Disease {id: 'D1189'}) SET n.id = 'D1189', n.name = 'Thóp trũng', n.name_en = 'Fontanelles - sunken', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003309.htm', n.when_to_see = 'Thóp trũng có thể là một trường hợp cấp cứu y tế. Nhà cung cấp dịch vụ chăm sóc sức khỏe nên kiểm tra trẻ sơ sinh ngay lập tức.';
MERGE (n:Disease {id: 'D1190'}) SET n.id = 'D1190', n.name = 'Dị ứng thực phẩm', n.name_en = 'Food allergy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/food-allergy/symptoms-causes/syc-20355095 | https://medlineplus.gov/ency/article/000817.htm', n.overview = 'là một phản ứng của hệ miễn dịch xảy ra ngay sau khi ăn một loại thực phẩm nhất định. Ngay cả một lượng nhỏ thực phẩm gây dị ứng cũng có thể gây ra các triệu chứng như nổi mề đay, sưng đường hô hấp và', n.prognosis = 'Dị ứng với đậu phộng, các loại hạt cây và động vật có vỏ có xu hướng kéo dài suốt đời. Việc tránh các thực phẩm có vấn đề có thể dễ dàng nếu thực phẩm đó không phổ biến hoặc dễ nhận biết. Khi đi ăn xa', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe hoặc bác sĩ dị ứng nếu bạn có các triệu chứng dị ứng thực phẩm ngay sau khi ăn. Nếu có thể, hãy gặp chuyên gia chăm sóc khi phản ứng dị ứng xảy ra. Điều này có thể';
MERGE (n:Disease {id: 'D1191'}) SET n.id = 'D1191', n.name = 'Ngộ độc thực phẩm', n.name_en = 'Food poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001652.htm', n.prognosis = 'Hầu hết mọi người đều hồi phục hoàn toàn sau các loại ngộ độc thực phẩm phổ biến nhất trong vòng 12 đến 48 giờ. Một số loại ngộ độc thực phẩm có thể gây ra các biến chứng nghiêm trọng. Tử vong do ngộ ', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Máu hoặc mủ trong phân Tiêu chảy và không thể uống nước do buồn nôn và nôn Sốt trên 101°F (38,3°C) hoặc con bạn bị sốt trên 100,4°F (38°C) cùng với';
MERGE (n:Disease {id: 'D1192'}) SET n.id = 'D1192', n.name = 'Ngộ độc thực phẩm (bệnh do thực phẩm)', n.name_en = 'Food poisoning (foodborne illness)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/food-poisoning/symptoms-causes/syc-20356230', n.overview = 'Ngộ độc thực phẩm, một loại bệnh do thực phẩm, là căn bệnh mà mọi người mắc phải do ăn hoặc uống thứ gì đó. Nguyên nhân là do vi trùng hoặc những thứ có hại khác có trong thức ăn, đồ uống. Các triệu c', n.when_to_see = 'Yêu cầu đặt lịch Chẩn đoán & điều trị 16/08/2025 In Hiển thị tài liệu tham khảo An toàn thực phẩm. Trung tâm Kiểm soát và Phòng ngừa Dịch bệnh Hoa Kỳ. Truy cập ngày 25 tháng 2 năm 2025. Định nghĩa và ';
MERGE (n:Disease {id: 'D1193'}) SET n.id = 'D1193', n.name = 'Thả chân', n.name_en = 'Foot drop', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/foot-drop/symptoms-causes/syc-20372628 | https://medlineplus.gov/ency/article/007761.htm', n.overview = ', đôi khi còn gọi là thả chân, là thuật ngữ chung chỉ độ khó nâng phần trước của bàn chân. Nếu bạn bị thả chân, phần trước bàn chân của bạn có thể bị kéo lê trên mặt đất khi bạn bước đi. Tụt chân khôn', n.prognosis = 'Bạn phục hồi tốt như thế nào tùy thuộc vào nguyên nhân gây ra tình trạng thả chân. Chứng tụt chân thường sẽ biến mất hoàn toàn. Nếu nguyên nhân nghiêm trọng hơn, chẳng hạn như đột quỵ, bạn có thể khôn', n.when_to_see = 'Nếu ngón chân của bạn kéo lê trên sàn khi bạn đi bộ, hãy tham khảo ý kiến ​​chuyên gia chăm sóc sức khỏe của bạn. Nếu chứng thả bàn chân không được điều trị, nó có thể gây mất khả năng vận động và chứ';
MERGE (n:Disease {id: 'D1194'}) SET n.id = 'D1194', n.name = 'Đau chân', n.name_en = 'Foot pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003183.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị đau chân đột ngột và dữ dội. Cơn đau ở chân của bạn bắt đầu sau một chấn thương, đặc biệt nếu bàn chân của bạn bị chảy máu hoặc bầm tím hoặc bạ';
MERGE (n:Disease {id: 'D1195'}) SET n.id = 'D1195', n.name = 'Sưng bàn chân, cẳng chân và mắt cá chân', n.name_en = 'Foot, leg, and ankle swelling', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003104.htm', n.when_to_see = 'Gọi 911 hoặc số cấp cứu tại địa phương nếu: Bạn cảm thấy khó thở. Bạn bị đau ngực, đặc biệt nếu có cảm giác như bị đè ép hoặc tức ngực. Liên hệ với nhà cung cấp của bạn ngay lập tức nếu: Bạn bị bệnh t';
MERGE (n:Disease {id: 'D1196'}) SET n.id = 'D1196', n.name = 'Phẫu thuật cắt lỗ thông', n.name_en = 'Foraminotomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007390.htm', n.overview = 'làm giảm áp lực lên dây thần kinh đi ra khỏi cột sống của bạn. Điều này làm giảm bất kỳ cơn đau nào bạn đang gặp phải. Phẫu thuật cắt bỏ lỗ có thể được thực hiện ở bất kỳ cấp độ nào của cột sống. Bạn ', n.prognosis = 'Phẫu thuật cắt bỏ lỗ liên hợp để điều trị chứng hẹp lỗ liên hợp cột sống thường sẽ giúp giảm bớt toàn bộ hoặc một phần các triệu chứng. Những vấn đề về cột sống trong tương lai có thể xảy ra với những';
MERGE (n:Disease {id: 'D1197'}) SET n.id = 'D1197', n.name = 'Căng da trán', n.name_en = 'Forehead lift', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002990.htm', n.overview = 'Căng da trán sẽ loại bỏ hoặc thay đổi các cơ và da gây ra các dấu hiệu lão hóa như lông mày rũ xuống, mí mắt "trùm đầu", nếp nhăn trên trán và nếp nhăn. Phẫu thuật có thể được thực hiện một mình hoặc ', n.prognosis = 'Bạn sẽ có thể đi lại sau 1 đến 2 ngày, nhưng bạn sẽ không thể làm việc trong ít nhất 7 ngày sau khi phẫu thuật. Bạn có thể gội đầu và tắm 2 ngày sau phẫu thuật hoặc ngay sau khi tháo băng. Trong vòng ';
MERGE (n:Disease {id: 'D1198'}) SET n.id = 'D1198', n.name = 'Dị vật trong mũi', n.name_en = 'Foreign body in the nose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000037.htm', n.when_to_see = 'Nhận trợ giúp y tế ngay lập tức nếu có bất kỳ trường hợp nào sau đây: Người đó không thể thở tốt Chảy máu xảy ra và tiếp tục trong hơn 2 hoặc 3 phút sau khi bạn lấy dị vật ra, mặc dù đã ấn nhẹ vào mũi';
MERGE (n:Disease {id: 'D1199'}) SET n.id = 'D1199', n.name = 'Vật lạ - hít vào', n.name_en = 'Foreign object - inhaled', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007738.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn hoặc gọi 911 hoặc số khẩn cấp tại địa phương nếu bạn cho rằng trẻ đã hít phải vật lạ.';
MERGE (n:Disease {id: 'D1200'}) SET n.id = 'D1200', n.name = 'Vật lạ - nuốt phải', n.name_en = 'Foreign object - swallowed', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000036.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn hoặc gọi 911 hoặc số khẩn cấp tại địa phương nếu bạn cho rằng trẻ đã nuốt phải vật lạ.';
MERGE (n:Disease {id: 'D1201'}) SET n.id = 'D1201', n.name = 'Ngộ độc Foxglove', n.name_en = 'Foxglove poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002878.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào lượng chất độc nuốt vào và tốc độ điều trị. Bạn nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Các triệu chứng kéo dài từ 1 đến 3 ngày và có thể';
MERGE (n:Disease {id: 'D1202'}) SET n.id = 'D1202', n.name = 'Gãy xương đòn ở trẻ sơ sinh', n.name_en = 'Fractured clavicle in the newborn', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001588.htm', n.prognosis = 'Quá trình phục hồi hoàn toàn diễn ra mà không cần điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu em bé của bạn có biểu hiện khó chịu khi bạn bế chúng lên.';
MERGE (n:Disease {id: 'D1203'}) SET n.id = 'D1203', n.name = 'Hội chứng X dễ gãy', n.name_en = 'Fragile X syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001668.htm', n.prognosis = 'Người đó hoạt động tốt như thế nào tùy thuộc vào mức độ khuyết tật trí tuệ.';
MERGE (n:Disease {id: 'D1204'}) SET n.id = 'D1204', n.name = 'Đi tiểu thường xuyên hoặc khẩn cấp', n.name_en = 'Frequent or urgent urination', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003140.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn ngay nếu: Bạn bị sốt, đau lưng hoặc đau bên hông, nôn mửa hoặc ớn lạnh Bạn khát nước hoặc thèm ăn, mệt mỏi hoặc giảm cân đột ngột. Đồng thời, hãy liên hệ với nhà c';
MERGE (n:Disease {id: 'D1205'}) SET n.id = 'D1205', n.name = 'Friedreich mất điều hòa', n.name_en = 'Friedreich ataxia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001411.htm', n.prognosis = 'Chứng mất điều hòa Friedreich dần trở nên nặng hơn và gây ra các vấn đề trong sinh hoạt hàng ngày. Hầu hết mọi người cần sử dụng xe lăn trong vòng 15 năm kể từ khi bệnh bắt đầu. Bệnh có thể dẫn đến tử', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu các triệu chứng của bệnh mất điều hòa Friedreich xảy ra, đặc biệt nếu gia đình có tiền sử mắc chứng rối loạn này.';
MERGE (n:Disease {id: 'D1206'}) SET n.id = 'D1206', n.name = 'Sếp phía trước', n.name_en = 'Frontal bossing', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003301.htm', n.when_to_see = 'Nếu bạn nhận thấy trán của con bạn trông quá nổi bật, hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn.';
MERGE (n:Disease {id: 'D1207'}) SET n.id = 'D1207', n.name = 'Động kinh thùy trán', n.name_en = 'Frontal lobe seizures', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/frontal-lobe-seizures/symptoms-causes/syc-20353958', n.overview = 'Thùy não rất quan trọng đối với việc suy nghĩ và quản lý chuyển động hoặc hoạt động có chủ ý. Thùy đỉnh có liên quan đến nhiệt độ cơ thể, vị giác, xúc giác và chuyển động. Thùy chẩm có liên quan đến t', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn có các triệu chứng động kinh. Gọi 911 hoặc trợ giúp y tế khẩn cấp nếu bạn thấy ai đó bị co giật kéo dài hơn năm phút. Yêu cầu một cuộc hẹn Có vấn đề với th';
MERGE (n:Disease {id: 'D1208'}) SET n.id = 'D1208', n.name = 'Chứng mất trí nhớ vùng trán', n.name_en = 'Frontotemporal dementia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/frontotemporal-dementia/symptoms-causes/syc-20354737 | https://medlineplus.gov/ency/article/000744.htm', n.overview = '(FTD), còn được gọi là thoái hóa thùy trán (FTLD), là thuật ngữ chung để chỉ một nhóm bệnh về não chủ yếu ảnh hưởng đến thùy trán và thùy thái dương của não. Những vùng não này có liên quan đến tính c', n.prognosis = 'Tình trạng rối loạn dần dần trở nên tồi tệ hơn. Người bệnh sẽ bị tàn tật hoàn toàn sớm trong quá trình mắc bệnh. FTD thường gây tử vong trong vòng 8 đến 10 năm, thường là do nhiễm trùng hoặc đôi khi d', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn hoặc đến phòng cấp cứu nếu chức năng tâm thần trở nên tồi tệ hơn.';
MERGE (n:Disease {id: 'D1209'}) SET n.id = 'D1209', n.name = 'Sự tê cóng', n.name_en = 'Frostbite', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/frostbite/symptoms-causes/syc-20372656 | https://medlineplus.gov/ency/article/000057.htm', n.overview = 'của ngón tay cho thấy việc đóng băng có thể khiến mô chết như thế nào. Frostbite là một chấn thương do da và các mô bên dưới bị đóng băng. Giai đoạn đầu của tê cóng được gọi là tê cóng. Nó gây ra cảm ', n.when_to_see = 'Ngoài tình trạng tê cóng, các vết thương do tê cóng cần được chuyên gia chăm sóc sức khỏe kiểm tra để tìm hiểu mức độ nghiêm trọng của chúng. Tìm kiếm sự chăm sóc khẩn cấp khi: Đau dữ dội ngay cả sau ';
MERGE (n:Disease {id: 'D1210'}) SET n.id = 'D1210', n.name = 'Vai đông cứng', n.name_en = 'Frozen shoulder', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/frozen-shoulder/symptoms-causes/syc-20372684 | https://medlineplus.gov/ency/article/000455.htm', n.overview = 'e bao bọc khớp dày lên và siết chặt. Vai đông lạnh, còn được gọi là viêm bao khớp dính, liên quan đến cứng và đau ở khớp vai. Các dấu hiệu và triệu chứng thường bắt đầu từ từ, sau đó trở nên nặng hơn.', n.prognosis = 'Điều trị bằng vật lý trị liệu và NSAID thường phục hồi khả năng vận động và chức năng của vai trong vòng một năm. Ngay cả khi không được điều trị, vai vẫn có thể tự khỏi sau 2 năm. Sau khi phẫu thuật ', n.when_to_see = 'Nếu bạn bị đau và cứng vai và cho rằng mình bị cứng vai, hãy liên hệ với nhà cung cấp dịch vụ của bạn để được đánh giá, giới thiệu và điều trị.';
MERGE (n:Disease {id: 'D1211'}) SET n.id = 'D1211', n.name = 'Chứng loạn dưỡng Fuchs', n.name_en = 'Fuchs dystrophy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/fuchs-dystrophy/symptoms-causes/syc-20352727 | https://medlineplus.gov/ency/article/007295.htm', n.overview = 'dày lên và giác mạc trở nên đục. Thân giác mạc còn được gọi là stroma. Chứng loạn dưỡng Fuchs là tình trạng chất lỏng tích tụ trong mô trong ở phía trước mắt, được gọi là giác mạc. Điều này làm cho gi', n.prognosis = 'Chứng loạn dưỡng Fuchs trở nên trầm trọng hơn theo thời gian. Nếu không được ghép giác mạc, người mắc chứng loạn dưỡng Fuchs nặng có thể bị mù hoặc bị đau dữ dội và thị lực rất giảm. Các trường hợp lo', n.when_to_see = 'Nếu bạn có một số triệu chứng này và đặc biệt là nếu chúng trở nên trầm trọng hơn theo thời gian, hãy đến gặp chuyên gia chăm sóc mắt. Chuyên gia chăm sóc mắt có thể giới thiệu bạn đến một chuyên gia ';
MERGE (n:Disease {id: 'D1212'}) SET n.id = 'D1212', n.name = 'Ngộ độc dầu nhiên liệu', n.name_en = 'Fuel oil poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002895.htm', n.prognosis = 'Tình trạng của một người phụ thuộc vào lượng dầu nhiên liệu được nuốt vào và tốc độ điều trị được tiếp nhận. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải những chất độc như vậy ';
MERGE (n:Disease {id: 'D1213'}) SET n.id = 'D1213', n.name = 'Chứng khó tiêu chức năng', n.name_en = 'Functional dyspepsia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/functional-dyspepsia/symptoms-causes/syc-20375709', n.overview = 'là một thuật ngữ dùng để mô tả tình trạng khó tiêu kéo dài mà không có nguyên nhân rõ ràng. Chứng khó tiêu chức năng (dis-PEP-see-uh) còn được gọi là chứng khó tiêu không loét. Chứng khó tiêu chức năn', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn gặp phải các triệu chứng liên tục khiến bạn lo lắng. Tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn gặp phải: Nôn ra máu. Phân đen, hắc ín. Hụt hơi. Đa';
MERGE (n:Disease {id: 'D1214'}) SET n.id = 'D1214', n.name = 'Rối loạn thần kinh chức năng/rối loạn chuyển đổi', n.name_en = 'Functional neurologic disorder/conversion disorder', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/conversion-disorder/symptoms-causes/syc-20355197', n.overview = 'Rối loạn thần kinh chức năng - một thuật ngữ mới hơn và rộng hơn bao gồm những gì mà một số người gọi là rối loạn chuyển đổi - có các triệu chứng về hệ thần kinh (thần kinh) không thể giải thích được ', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế nếu có các dấu hiệu và triệu chứng khiến bạn lo lắng hoặc cản trở khả năng hoạt động của bạn. Nếu nguyên nhân cơ bản là bệnh thần kinh hoặc tình trạng bệnh lý khác, việc ';
MERGE (n:Disease {id: 'D1215'}) SET n.id = 'D1215', n.name = 'Rối loạn thần kinh chức năng', n.name_en = 'Functional neurological disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000954.htm', n.prognosis = 'Các triệu chứng thường kéo dài vài ngày đến vài tuần và có thể biến mất đột ngột trong khi những triệu chứng khác có thể kéo dài hàng năm. Các triệu chứng thường không đe dọa đến tính mạng, nhưng các ', n.when_to_see = 'Hãy gặp nhà cung cấp hoặc chuyên gia sức khỏe tâm thần nếu bạn hoặc ai đó bạn biết có các triệu chứng của FND.';
MERGE (n:Disease {id: 'D1216'}) SET n.id = 'D1216', n.name = 'Viêm khớp do nấm', n.name_en = 'Fungal arthritis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000444.htm', n.prognosis = 'Tình trạng của bạn tốt như thế nào tùy thuộc vào nguyên nhân cơ bản gây ra tình trạng nhiễm trùng và sức khỏe tổng thể của bạn. Hệ thống miễn dịch suy yếu, ung thư và một số loại thuốc có thể ảnh hưởn', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có bất kỳ triệu chứng nào của bệnh viêm khớp do nấm.';
