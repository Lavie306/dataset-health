MERGE (n:Disease {id: 'D1167'}) SET n.id = 'D1167', n.name = 'Ngón tay đổi màu', n.name_en = 'Fingers that change color', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003249.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Ngón tay của bạn đổi màu và nguyên nhân không phải là nguyên nhân được biết đến. Ngón tay hoặc ngón chân của bạn chuyển sang màu đen hoặ';
MERGE (n:Disease {id: 'D1168'}) SET n.id = 'D1168', n.name = 'Kiến lửa', n.name_en = 'Fire ants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002843.htm', n.prognosis = 'Việc điều trị thích hợp được bắt đầu càng sớm thì kết quả càng tốt. Những người không bị dị ứng với kiến ​​lửa sẽ khỏi bệnh sau vài giờ đến vài ngày. Những người bị phản ứng dị ứng nghiêm trọng có thể';
MERGE (n:Disease {id: 'D1169'}) SET n.id = 'D1169', n.name = 'Nhiễm sán dây cá', n.name_en = 'Fish tapeworm infection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001375.htm', n.prognosis = 'Sán dây cá có thể điều trị được bằng một liều điều trị duy nhất. Không có tác dụng lâu dài.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn nhận thấy có một con giun hoặc các đoạn giun trong phân của mình Bạn có các triệu chứng thiếu máu Bất kỳ thành viên nào trong gia đình được chẩn đ';
MERGE (n:Disease {id: 'D1170'}) SET n.id = 'D1170', n.name = 'Loại bỏ lưỡi câu', n.name_en = 'Fishhook removal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000055.htm', n.when_to_see = 'Ưu điểm chính của việc nhận trợ giúp y tế đối với bất kỳ vết thương do lưỡi câu nào là vết thương có thể được loại bỏ bằng cách gây tê tại chỗ. Điều này có nghĩa là trước khi tháo móc ra, nhà cung cấp';
MERGE (n:Disease {id: 'D1171'}) SET n.id = 'D1171', n.name = 'Rò', n.name_en = 'Fistula', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002365.htm', n.overview = 's có thể xảy ra ở nhiều bộ phận trên cơ thể. Chúng có thể hình thành giữa: Động mạch và tĩnh mạch (lỗ rò động tĩnh mạch) Ống mật và bề mặt da (từ phẫu thuật túi mật) Cổ tử cung và âm đạo Cổ và họng Kh';
MERGE (n:Disease {id: 'D1172'}) SET n.id = 'D1172', n.name = 'Đau sườn', n.name_en = 'Flank pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003113.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ dấu hiệu nào sau đây: Đau sườn cùng với sốt cao, ớn lạnh, buồn nôn hoặc nôn Máu (màu đỏ hoặc nâu) trong nước tiểu Đau hông ';
MERGE (n:Disease {id: 'D1173'}) SET n.id = 'D1173', n.name = 'Bàn chân bẹt', n.name_en = 'Flat feet', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001262.htm', n.prognosis = 'Hầu hết các trường hợp bàn chân bẹt đều không gây đau đớn và không gây ra vấn đề gì. Họ sẽ không cần điều trị. Một số nguyên nhân gây đau bàn chân bẹt có thể được điều trị mà không cần phẫu thuật. Nếu', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị đau dai dẳng ở bàn chân hoặc con bạn phàn nàn về đau chân hoặc đau cẳng chân.';
MERGE (n:Disease {id: 'D1174'}) SET n.id = 'D1174', n.name = 'Flatfeet', n.name_en = 'Flatfeet', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/flatfeet/symptoms-causes/syc-20372604', n.overview = 'e được mô tả ở bên trái, trong khi Flatfeet thường tạo ra dấu chân giống như hình bên phải. Bàn chân bẹt là một tình trạng phổ biến, còn được gọi là bàn chân bẹt, trong đó các vòm bên trong bàn chân s', n.when_to_see = 'Hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn bị đau chân, đặc biệt nếu điều đó hạn chế những gì bạn muốn làm. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1175'}) SET n.id = 'D1175', n.name = 'Ung thư sàn miệng', n.name_en = 'Floor of the mouth cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/floor-mouth-cancer/symptoms-causes/syc-20354179', n.overview = 'là bệnh ung thư bắt đầu từ sự phát triển của các tế bào dưới lưỡi. Ung thư sàn miệng thường bắt đầu ở các tế bào mỏng, phẳng nằm bên trong miệng, được gọi là tế bào vảy. Khi ung thư bắt đầu ở những tế', n.when_to_see = 'Hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thô';
MERGE (n:Disease {id: 'D1176'}) SET n.id = 'D1176', n.name = 'Cúm', n.name_en = 'Flu', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000080.htm', n.prognosis = 'Hàng triệu người ở Hoa Kỳ mắc bệnh cúm mỗi năm. Hầu hết mọi người sẽ khỏi bệnh trong vòng một hoặc hai tuần, nhưng hàng nghìn người bị cúm sẽ bị viêm phổi hoặc nhiễm trùng não. Họ có thể cần phải ở lạ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp nếu bạn hoặc con bạn bị cúm và có nguy cơ bị biến chứng. Đồng thời liên hệ với nhà cung cấp dịch vụ của bạn nếu các triệu chứng cúm rất nặng và không thuyên giảm. Liên hệ ';
MERGE (n:Disease {id: 'D1177'}) SET n.id = 'D1177', n.name = 'Mất cân bằng chất lỏng', n.name_en = 'Fluid imbalance', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001187.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn có dấu hiệu mất nước hoặc sưng tấy, để ngăn ngừa các biến chứng nghiêm trọng hơn.';
MERGE (n:Disease {id: 'D1178'}) SET n.id = 'D1178', n.name = 'Quá liều florua', n.name_en = 'Fluoride overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002650.htm', n.prognosis = 'Một người khỏe mạnh như thế nào tùy thuộc vào lượng nuốt và tốc độ nuốt được điều trị. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Lượng florua trong kem đánh răng thườn';
MERGE (n:Disease {id: 'D1179'}) SET n.id = 'D1179', n.name = 'Khiếm khuyết thần kinh khu trú', n.name_en = 'Focal neurologic deficits', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003191.htm', n.when_to_see = 'Nếu bạn bị mất khả năng vận động, cảm giác hoặc chức năng, hãy liên hệ với nhà cung cấp của bạn.';
MERGE (n:Disease {id: 'D1180'}) SET n.id = 'D1180', n.name = 'Xơ cứng cầu thận cục bộ từng đoạn', n.name_en = 'Focal segmental glomerulosclerosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000478.htm', n.prognosis = 'Một phần lớn những người bị xơ cứng cầu thận khu trú hoặc từng đoạn sẽ phát triển bệnh thận mãn tính hoặc suy thận.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của tình trạng này, đặc biệt nếu có: Sốt Đau khi đi tiểu Lượng nước tiểu giảm';
MERGE (n:Disease {id: 'D1181'}) SET n.id = 'D1181', n.name = 'Xơ cứng cầu thận từng đoạn khu trú (FSGS)', n.name_en = 'Focal segmental glomerulosclerosis (FSGS)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/fsgs/symptoms-causes/syc-20354693', n.overview = 'Xơ cứng cầu thận điển hình và có sẹo (FSGS) là kết quả của mô sẹo phát triển trong cầu thận. Tiểu cầu là những cấu trúc nhỏ trong thận có chức năng lọc các chất thải từ máu để tạo ra nước tiểu. Một cầ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào của FSGS.';
