MERGE (n:Disease {id: 'D0001'}) SET n.id = 'D0001', n.name = 'hội chứng Aarskog', n.name_en = 'Aarskog syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001654.htm', n.prognosis = 'Một số người có thể bị chậm phát triển trí tuệ, nhưng trẻ mắc bệnh này thường có kỹ năng xã hội tốt. Một số nam giới có thể gặp vấn đề về khả năng sinh sản.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn chậm phát triển hoặc nếu bạn nhận thấy bất kỳ triệu chứng nào của hội chứng Aarskog. Tìm kiếm tư vấn di truyền nếu bạn có tiền sử';
MERGE (n:Disease {id: 'D0002'}) SET n.id = 'D0002', n.name = 'hội chứng Aase', n.name_en = 'Aase syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001662.htm', n.prognosis = 'Tình trạng thiếu máu có xu hướng cải thiện theo tuổi tác.';
MERGE (n:Disease {id: 'D0003'}) SET n.id = 'D0003', n.name = 'Bụng - sưng lên', n.name_en = 'Abdomen - swollen', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003122.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Sưng bụng ngày càng trầm trọng và không biến mất. Tình trạng sưng tấy xảy ra kèm theo các triệu chứng khác không giải thích được. Bụng của bạn mềm khi chạ';
MERGE (n:Disease {id: 'D0004'}) SET n.id = 'D0004', n.name = 'Chứng phình động mạch chủ bụng', n.name_en = 'Abdominal aortic aneurysm', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/abdominal-aortic-aneurysm/symptoms-causes/syc-20350688 | https://medlineplus.gov/ency/article/000162.htm', n.overview = 'xảy ra khi phần dưới của động mạch chính của cơ thể, gọi là động mạch chủ, bị yếu đi và phình ra phía ngoài như một quả bóng bay. Phình động mạch chủ bụng là tình trạng vùng phình to ở phần dưới của đ', n.prognosis = 'Kết quả thường tốt nếu bạn phẫu thuật để chữa chứng phình động mạch trước khi nó vỡ. Khi chứng phình động mạch chủ bụng bắt đầu rách hoặc vỡ, đó là trường hợp cấp cứu y tế. Chỉ có khoảng 1 trong 5 ngư', n.when_to_see = 'Nếu bạn bị đau, đặc biệt nếu cơn đau đột ngột và dữ dội, hãy nhờ trợ giúp y tế ngay lập tức. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin được đá';
MERGE (n:Disease {id: 'D0005'}) SET n.id = 'D0005', n.name = 'Phẫu thuật điều trị phình động mạch chủ bụng - mở', n.name_en = 'Abdominal aortic aneurysm repair - open', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007392.htm', n.overview = 'Ca phẫu thuật sẽ diễn ra trong phòng mổ. Bạn sẽ được gây mê toàn thân (bạn sẽ ngủ và không đau). Bác sĩ phẫu thuật sẽ mở bụng của bạn và thay thế chứng phình động mạch chủ bằng một vật liệu giống như ', n.prognosis = 'Quá trình hồi phục hoàn toàn đối với phẫu thuật mở để sửa chữa chứng phình động mạch chủ có thể mất 2 hoặc 3 tháng. Hầu hết mọi người đều hồi phục hoàn toàn sau cuộc phẫu thuật này. Hầu hết những ngườ';
MERGE (n:Disease {id: 'D0006'}) SET n.id = 'D0006', n.name = 'Đầy bụng', n.name_en = 'Abdominal bloating', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003123.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị: Đau bụng Có máu trong phân hoặc phân có màu sẫm, như hắc ín Tiêu chảy Chứng ợ nóng ngày càng trầm trọng Nôn mửa Sụt cân';
MERGE (n:Disease {id: 'D0007'}) SET n.id = 'D0007', n.name = 'thăm dò bụng', n.name_en = 'Abdominal exploration', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002928.htm', n.overview = 'Phẫu thuật nội soi thăm dò được thực hiện trong khi bạn đang được gây mê toàn thân. Điều này có nghĩa là bạn đang ngủ và không cảm thấy đau. Bác sĩ phẫu thuật của bạn sẽ thực hiện một vết cắt vào bụng', n.prognosis = 'Bạn sẽ có thể bắt đầu ăn uống bình thường khoảng 2 đến 3 ngày sau khi phẫu thuật. Bạn ở lại bệnh viện bao lâu tùy thuộc vào mức độ nghiêm trọng của vấn đề. Phục hồi hoàn toàn thường mất khoảng 4 đến 6';
MERGE (n:Disease {id: 'D0008'}) SET n.id = 'D0008', n.name = 'Khối bụng', n.name_en = 'Abdominal mass', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003274.htm', n.when_to_see = 'Nhận trợ giúp y tế ngay lập tức nếu bạn có một khối u ở bụng cùng với đau bụng dữ dội. Đây có thể là dấu hiệu của chứng phình động mạch chủ bị vỡ, đây là tình trạng khẩn cấp. Liên hệ với nhà cung cấp ';
MERGE (n:Disease {id: 'D0009'}) SET n.id = 'D0009', n.name = 'Đau bụng', n.name_en = 'Abdominal pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003120.htm', n.when_to_see = 'Nhận trợ giúp y tế ngay lập tức hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn: Hiện đang được điều trị ung thư Không thể đại tiện, đặc biệt nếu bạn cũng đang nôn mửa Nôn ra máu hoặc có máu trong';
MERGE (n:Disease {id: 'D0010'}) SET n.id = 'D0010', n.name = 'Đau bụng - trẻ em dưới 12 tuổi', n.name_en = 'Abdominal pain - children under age 12', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007504.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu cơn đau bụng không biến mất sau 24 giờ. Hãy tìm sự trợ giúp y tế ngay lập tức hoặc gọi đến số cấp cứu tại địa phương của bạn (chẳng hạn như 911) nếu con bạ';
MERGE (n:Disease {id: 'D0011'}) SET n.id = 'D0011', n.name = 'Cứng bụng', n.name_en = 'Abdominal rigidity', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003136.htm', n.when_to_see = 'Hãy chăm sóc y tế ngay nếu bạn bị đau khi ấn nhẹ bụng rồi thả ra.';
MERGE (n:Disease {id: 'D0012'}) SET n.id = 'D0012', n.name = 'Âm thanh bụng', n.name_en = 'Abdominal sounds', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003137.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có bất kỳ triệu chứng nào như: Chảy máu từ trực tràng Buồn nôn Tiêu chảy hoặc táo bón tiếp tục Nôn mửa';
MERGE (n:Disease {id: 'D0013'}) SET n.id = 'D0013', n.name = 'Phẫu thuật thành bụng', n.name_en = 'Abdominal wall surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002978.htm', n.overview = 'Cuộc phẫu thuật của bạn sẽ được thực hiện trong phòng phẫu thuật của bệnh viện. Bạn sẽ được gây mê toàn thân. Điều này sẽ giúp bạn ngủ ngon và không bị đau trong suốt quá trình. Ca phẫu thuật kéo dài ', n.prognosis = 'Hầu hết mọi người đều hài lòng với kết quả của phẫu thuật tạo hình thành bụng. Nhiều người cảm thấy một cảm giác tự tin mới.';
MERGE (n:Disease {id: 'D0014'}) SET n.id = 'D0014', n.name = 'Chảy máu tử cung bất thường', n.name_en = 'Abnormal uterine bleeding', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000903.htm', n.prognosis = 'Liệu pháp hormone thường làm giảm các triệu chứng. Có thể không cần điều trị nếu bạn không bị thiếu máu do mất máu. Việc điều trị tập trung vào nguyên nhân gây chảy máu thường có hiệu quả ngay lập tức', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu bạn bị chảy máu âm đạo bất thường.';
MERGE (n:Disease {id: 'D0015'}) SET n.id = 'D0015', n.name = 'Da tối hoặc sáng bất thường', n.name_en = 'Abnormally dark or light skin', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003242.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn để lấy hẹn nếu bạn có: Da đổi màu gây lo ngại đáng kể. Da bị sạm hoặc sáng màu liên tục, không rõ nguyên nhân. Bất kỳ vết loét hoặc tổn thươn';
MERGE (n:Disease {id: 'D0016'}) SET n.id = 'D0016', n.name = 'ABO không tương thích', n.name_en = 'ABO incompatibility', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001306.htm', n.prognosis = 'Sự không tương thích ABO có thể là một vấn đề rất nghiêm trọng có thể dẫn đến tử vong. Với việc điều trị đúng và kịp thời, bệnh sẽ hồi phục hoàn toàn.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu gần đây bạn đã được truyền máu hoặc cấy ghép và bạn có các triệu chứng không tương thích ABO.';
MERGE (n:Disease {id: 'D0017'}) SET n.id = 'D0017', n.name = 'Phá thai - dùng thuốc', n.name_en = 'Abortion - medication', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007382.htm', n.overview = 'Phá thai bằng thuốc có thể được thực hiện trong vòng 11 tuần kể từ ngày đầu tiên của kỳ kinh cuối cùng của người phụ nữ. Sự kết hợp của hai loại thuốc nội tiết tố theo toa thường được sử dụng nhiều nh', n.prognosis = 'Phá thai bằng thuốc an toàn và hiệu quả. Họ hiếm khi có biến chứng nghiêm trọng.';
MERGE (n:Disease {id: 'D0018'}) SET n.id = 'D0018', n.name = 'Phá thai - thủ tục', n.name_en = 'Abortion - procedure', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002912.htm', n.overview = 'Thủ tục phá thai bao gồm việc làm giãn nở tử cung (cổ tử cung) và đặt một ống hút nhỏ vào tử cung. Hút được sử dụng để loại bỏ thai nhi và các vật liệu liên quan đến thai kỳ ra khỏi tử cung. Trước khi', n.prognosis = 'Vấn đề hiếm khi xảy ra sau thủ tục này. Sự hồi phục thể chất thường diễn ra trong vòng vài ngày, tùy thuộc vào giai đoạn của thai kỳ. Chảy máu âm đạo có thể kéo dài từ một tuần đến 10 ngày. Chuột rút ';
MERGE (n:Disease {id: 'D0019'}) SET n.id = 'D0019', n.name = 'áp xe', n.name_en = 'Abscess', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001353.htm', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu bạn nghĩ rằng bạn có bất kỳ loại áp xe nào. Liên hệ với nha sĩ nếu bạn nghĩ rằng mình bị áp xe răng.';
MERGE (n:Disease {id: 'D0020'}) SET n.id = 'D0020', n.name = 'Áp xe - bụng hoặc xương chậu', n.name_en = 'Abscess - abdomen or pelvis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000212.htm', n.prognosis = 'Bạn đáp ứng tốt như thế nào với việc điều trị tùy thuộc vào nguyên nhân gây áp xe và mức độ nhiễm trùng nặng như thế nào. Nó cũng phụ thuộc vào sức khỏe tổng thể của bạn. Thông thường, thuốc kháng sin', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị: Đau bụng dữ dội Sốt Buồn nôn Nôn mửa Thay đổi thói quen đại tiện';
MERGE (n:Disease {id: 'D0021'}) SET n.id = 'D0021', n.name = 'Không có mồ hôi', n.name_en = 'Absence of sweating', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003219.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị thiếu mồ hôi nói chung hoặc thiếu mồ hôi bất thường khi tiếp xúc với nhiệt độ cao hoặc tập thể dục vất vả.';
MERGE (n:Disease {id: 'D0022'}) SET n.id = 'D0022', n.name = 'Cơn động kinh vắng ý thức', n.name_en = 'Absence seizure', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/petit-mal-seizure/symptoms-causes/syc-20359683 | https://medlineplus.gov/ency/article/000696.htm', n.overview = 's liên quan đến tình trạng mất ý thức trong thời gian ngắn và đột ngột. Chúng phổ biến ở trẻ em hơn ở người lớn. Một người bị cơn vắng mặt có thể nhìn chằm chằm vào khoảng không trong vài giây. Sau đó', n.when_to_see = 'Liên hệ với bác sĩ nhi khoa của con bạn: Nếu bạn lo lắng rằng con bạn có thể bị co giật. Nếu con bạn bị động kinh nhưng lại xuất hiện các triệu chứng của một loại động kinh mới. Nếu cơn động kinh tiếp';
MERGE (n:Disease {id: 'D0023'}) SET n.id = 'D0023', n.name = 'Vắng kinh nguyệt - tiểu học', n.name_en = 'Absent menstrual periods - primary', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001218.htm', n.prognosis = 'Triển vọng phụ thuộc vào nguyên nhân gây vô kinh và liệu nó có thể được điều trị bằng cách điều trị hoặc thay đổi lối sống hay không. Kinh nguyệt không có khả năng tự bắt đầu nếu vô kinh do một trong ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu con gái của bạn trên 15 tuổi và chưa bắt đầu có kinh nguyệt hoặc nếu con từ 14 tuổi trở lên và không có dấu hiệu dậy thì nào khác.';
MERGE (n:Disease {id: 'D0024'}) SET n.id = 'D0024', n.name = 'Vắng kinh nguyệt - thứ phát', n.name_en = 'Absent menstrual periods - secondary', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001219.htm', n.prognosis = 'Triển vọng phụ thuộc vào nguyên nhân gây vô kinh. Nhiều tình trạng gây vô kinh thứ phát sẽ đáp ứng với điều trị.', n.when_to_see = 'Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe chính của bạn hoặc nhà cung cấp dịch vụ chăm sóc sức khỏe phụ nữ nếu bạn bị trễ kinh nhiều hơn một kỳ kinh để có thể được chẩn đoán và điều trị nếu c';
MERGE (n:Disease {id: 'D0025'}) SET n.id = 'D0025', n.name = 'Vắng van phổi', n.name_en = 'Absent pulmonary valve', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007314.htm', n.prognosis = 'Nếu không phẫu thuật, có thể có nguy cơ dẫn đến hậu quả nghiêm trọng. Trong nhiều trường hợp, phẫu thuật có thể điều trị tình trạng này và làm giảm các triệu chứng. Kết quả thường rất tốt.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu trẻ sơ sinh của bạn có triệu chứng không có van phổi. Nếu bạn có tiền sử gia đình bị dị tật tim, hãy nói chuyện với bác sĩ trước hoặc tro';
MERGE (n:Disease {id: 'D0026'}) SET n.id = 'D0026', n.name = 'bệnh gai đen', n.name_en = 'Acanthosis nigricans', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/acanthosis-nigricans/symptoms-causes/syc-20368983 | https://medlineplus.gov/ency/article/000852.htm', n.overview = 'là tình trạng gây ra các vùng da dày, sẫm màu ở các nếp gấp và nếp nhăn trên cơ thể. Nó thường ảnh hưởng đến nách, háng và cổ. Acanthosis nigricans (ak-an-THOE-sis NIE-grih-kuns) có xu hướng ảnh hưởng', n.prognosis = 'AN thường biến mất nếu nguyên nhân được tìm thấy và điều trị.', n.when_to_see = 'Tham khảo ý kiến ​​nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy những thay đổi trên làn da của mình - đặc biệt nếu những thay đổi đó xảy ra đột ngột. Bạn có thể có một tình trạng t';
MERGE (n:Disease {id: 'D0027'}) SET n.id = 'D0027', n.name = 'Quá liều Acetaminophen và codeine', n.name_en = 'Acetaminophen and codeine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002562.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào lượng thuốc nuốt vào và tốc độ điều trị được tiếp nhận như thế nào. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nếu hơi t';
MERGE (n:Disease {id: 'D0028'}) SET n.id = 'D0028', n.name = 'Quá liều Acetaminophen', n.name_en = 'Acetaminophen overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002598.htm', n.prognosis = 'Nếu điều trị được thực hiện trong vòng 8 giờ sau khi dùng quá liều thì cơ hội phục hồi là rất cao. Tuy nhiên, nếu không điều trị nhanh chóng, dùng quá liều lượng lớn acetaminophen có thể dẫn đến suy g';
MERGE (n:Disease {id: 'D0029'}) SET n.id = 'D0029', n.name = 'Ngộ độc axeton', n.name_en = 'Acetone poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002480.htm', n.prognosis = 'Việc vô tình uống một lượng nhỏ axeton/nước tẩy sơn móng tay không có khả năng gây hại cho bạn khi trưởng thành. Tuy nhiên, ngay cả một lượng nhỏ cũng có thể gây nguy hiểm cho con bạn, vì vậy điều qua';
MERGE (n:Disease {id: 'D0030'}) SET n.id = 'D0030', n.name = 'Achalasia', n.name_en = 'Achalasia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/achalasia/symptoms-causes/syc-20352850 | https://medlineplus.gov/ency/article/000267.htm', n.overview = 'là tình trạng nuốt ảnh hưởng đến ống nối miệng và dạ dày, gọi là thực quản. Các dây thần kinh bị tổn thương khiến các cơ của thực quản khó ép thức ăn và chất lỏng vào dạ dày. Thức ăn sau đó tích tụ tr', n.prognosis = 'Kết quả của phẫu thuật và điều trị không phẫu thuật là tương tự nhau. Tuy nhiên, tùy thuộc vào loại achalasia mà bạn mắc phải, bác sĩ có thể đề xuất một quy trình cụ thể. Nhiều hơn một điều trị đôi kh', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Bạn gặp khó khăn khi nuốt hoặc đau khi nuốt Các triệu chứng của bạn vẫn tiếp tục, ngay cả khi điều trị chứng co thắt tâm vị';
MERGE (n:Disease {id: 'D0031'}) SET n.id = 'D0031', n.name = 'Viêm gân Achilles', n.name_en = 'Achilles tendinitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/achilles-tendinitis/symptoms-causes/syc-20369020 | https://medlineplus.gov/ency/article/001072.htm', n.overview = 'là một chấn thương ở gân Achilles (uh-KILL-eez). Nguyên nhân có thể là do sử dụng quá nhiều hoặc quá nhiều mà không nghỉ ngơi đầy đủ, gọi là sử dụng quá mức. Hoặc nó có thể phát triển mà không có nguy', n.prognosis = 'Trong hầu hết các trường hợp, thay đổi lối sống giúp cải thiện các triệu chứng. Hãy nhớ rằng các triệu chứng có thể quay trở lại nếu bạn không hạn chế các hoạt động gây đau hoặc nếu bạn không duy trì ', n.when_to_see = 'Nếu bạn bị đau quanh gân Achilles mà không biến mất, hãy gọi cho chuyên gia chăm sóc sức khỏe của bạn. Nếu cơn đau đột ngột dữ dội hoặc khiến bạn không thể di chuyển, bạn có thể đã bị rách gân Achille';
MERGE (n:Disease {id: 'D0032'}) SET n.id = 'D0032', n.name = 'Sửa chữa gân Achilles', n.name_en = 'Achilles tendon repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007643.htm', n.overview = 'Để khắc phục vết rách gân Achilles của bạn, bác sĩ phẫu thuật sẽ: Cắt phía sau gót chân của bạn Thực hiện nhiều vết cắt nhỏ thay vì một vết cắt lớn Sau đó, bác sĩ phẫu thuật sẽ: Nối hai đầu gân của bạ', n.prognosis = 'Bạn sẽ có thể tiếp tục hoạt động đầy đủ trong khoảng 6 tháng. Dự kiến ​​quá trình phục hồi hoàn toàn sẽ mất khoảng 9 tháng.';
MERGE (n:Disease {id: 'D0033'}) SET n.id = 'D0033', n.name = 'Đứt gân Achilles', n.name_en = 'Achilles tendon rupture', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/achilles-tendon-rupture/symptoms-causes/syc-20353234', n.overview = 'dây xơ nối các cơ ở phía sau bắp chân với xương gót chân. Nếu bạn căng gân Achilles quá mức, nó có thể bị rách (đứt). Đứt gân Achilles (uh-KILL-eez) là một chấn thương ảnh hưởng đến mặt sau của cẳng c';
MERGE (n:Disease {id: 'D0034'}) SET n.id = 'D0034', n.name = 'Achondrosis', n.name_en = 'Achondrogenesis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001247.htm', n.prognosis = 'Kết quả thường rất kém. Nhiều trẻ sơ sinh mắc chứng loạn sản sụn chết non hoặc chết ngay sau khi sinh vì các vấn đề về hô hấp liên quan đến lồng ngực nhỏ bất thường.', n.when_to_see = 'Tình trạng này thường được chẩn đoán trong lần khám đầu tiên của trẻ sơ sinh.';
MERGE (n:Disease {id: 'D0035'}) SET n.id = 'D0035', n.name = 'Chứng loạn sản sụn', n.name_en = 'Achondroplasia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001577.htm', n.prognosis = 'Chiều cao của người trưởng thành thường là 46 đến 57 inch (1,17 đến 1,45 mét) đối với nam và 44 đến 54 inch (1,12 đến 1,37 mét) đối với nữ. Trí tuệ ở mức bình thường. Trẻ sơ sinh nhận gen bất thường t', n.when_to_see = 'Nếu có tiền sử gia đình mắc chứng loạn sản sụn và bạn dự định có con, bạn có thể thấy hữu ích khi nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của mình.';
MERGE (n:Disease {id: 'D0036'}) SET n.id = 'D0036', n.name = 'Ngộ độc chất hàn axit', n.name_en = 'Acid soldering flux poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002830.htm', n.prognosis = 'Tình trạng một người khỏe mạnh như thế nào tùy thuộc vào mức độ ngộ độc nghiêm trọng của họ và tốc độ điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Thiệt hại có thể tiếp tục xảy ';
MERGE (n:Disease {id: 'D0037'}) SET n.id = 'D0037', n.name = 'Nhiễm toan', n.name_en = 'Acidosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001181.htm', n.prognosis = 'Nhiễm axit có thể nguy hiểm nếu không được điều trị. Nhiều trường hợp đáp ứng tốt với điều trị. Triển vọng sẽ phụ thuộc vào căn bệnh tiềm ẩn gây ra tình trạng này.', n.when_to_see = 'Tất cả các loại nhiễm toan sẽ gây ra các triệu chứng cần được bác sĩ điều trị.';
MERGE (n:Disease {id: 'D0038'}) SET n.id = 'D0038', n.name = 'chấn thương ACL', n.name_en = 'ACL injury', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/acl-injury/symptoms-causes/syc-20350738', n.overview = 'những chất giúp ổn định khớp gối. ACL kết nối xương đùi (xương đùi) với xương ống chân (xương chày). Nó thường bị rách nhất khi chơi các môn thể thao liên quan đến việc dừng đột ngột và đổi hướng - ch', n.when_to_see = 'Tìm kiếm sự chăm sóc ngay lập tức nếu bất kỳ chấn thương nào ở đầu gối của bạn gây ra các dấu hiệu hoặc triệu chứng của chấn thương ACL. Khớp gối là một cấu trúc phức tạp gồm xương, dây chằng, gân và ';
MERGE (n:Disease {id: 'D0039'}) SET n.id = 'D0039', n.name = 'Tái thiết ACL', n.name_en = 'ACL reconstruction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007208.htm', n.overview = 'Hầu hết mọi người đều được gây mê toàn thân cho cuộc phẫu thuật này. Điều này có nghĩa là bạn sẽ ngủ và không bị đau. Các loại gây mê khác, như gây tê vùng hoặc gây tê, cũng có thể được sử dụng cho ph', n.prognosis = 'Hầu hết mọi người sẽ có đầu gối ổn định và không bị chùng xuống sau khi tái tạo ACL. Các phương pháp phẫu thuật và phục hồi chức năng tốt hơn đã dẫn đến: Ít đau và cứng khớp hơn sau phẫu thuật Ít biến';
MERGE (n:Disease {id: 'D0040'}) SET n.id = 'D0040', n.name = 'Acne', n.name_en = 'Acne', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/acne/symptoms-causes/syc-20368047 | https://medlineplus.gov/ency/article/000873.htm', n.overview = 'là một tình trạng da xảy ra khi nang lông của bạn bị dính dầu và tế bào da chết. Nó gây ra mụn đầu trắng, mụn đầu đen hoặc mụn nhọt. Mụn trứng cá phổ biến nhất ở thanh thiếu niên, mặc dù nó ảnh hưởng ', n.prognosis = 'Hầu hết mụn trứng cá sẽ biến mất sau tuổi thiếu niên nhưng có thể kéo dài đến tuổi trung niên. Tình trạng này thường đáp ứng tốt với điều trị nhưng phản ứng có thể mất từ ​​6 đến 8 tuần và thỉnh thoản', n.when_to_see = 'Nếu các biện pháp tự chăm sóc không làm sạch mụn trứng cá, hãy đến gặp bác sĩ chăm sóc chính của bạn. Người đó có thể kê đơn thuốc mạnh hơn. Nếu mụn vẫn tồn tại hoặc nghiêm trọng, bạn có thể tìm đến b';
MERGE (n:Disease {id: 'D0041'}) SET n.id = 'D0041', n.name = 'U dây thần kinh âm thanh', n.name_en = 'Acoustic neuroma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000778.htm', n.prognosis = 'U dây thần kinh thính giác không phải là ung thư. Khối u không lan sang các bộ phận khác của cơ thể. Tuy nhiên, nó có thể tiếp tục phát triển và đè lên các cấu trúc trong hộp sọ. Những người có khối u', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị: Mất thính giác đột ngột hoặc trở nên trầm trọng hơn Ù tai một bên Chóng mặt (chóng mặt)';
MERGE (n:Disease {id: 'D0042'}) SET n.id = 'D0042', n.name = 'U dây thần kinh thính giác (u dây thần kinh tiền đình)', n.name_en = 'Acoustic neuroma (vestibular schwannoma)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/acoustic-neuroma/symptoms-causes/syc-20356127', n.overview = 'Dây thần kinh thính giác thần kinh thính giác và dây thần kinh mặt bên trong ống tai trong. Áp lực của khối u lên các dây thần kinh này có thể gây mất thính giác, ù tai và yếu cơ mặt. U thần kinh thín';
MERGE (n:Disease {id: 'D0043'}) SET n.id = 'D0043', n.name = 'Chấn thương âm thanh', n.name_en = 'Acoustic trauma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001061.htm', n.prognosis = 'Mất thính lực có thể là vĩnh viễn ở tai bị ảnh hưởng. Đeo bảo vệ tai khi ở gần nguồn âm thanh lớn có thể ngăn tình trạng suy giảm thính lực trở nên trầm trọng hơn.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Bạn có các triệu chứng chấn thương âm thanh Mất thính giác xảy ra hoặc trở nên trầm trọng hơn';
MERGE (n:Disease {id: 'D0044'}) SET n.id = 'D0044', n.name = 'Khiếm khuyết chức năng tiểu cầu mắc phải', n.name_en = 'Acquired platelet function defect', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000546.htm', n.prognosis = 'Hầu hết thời gian, việc điều trị nguyên nhân của vấn đề sẽ khắc phục được khiếm khuyết.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn bị chảy máu và không biết nguyên nhân Các triệu chứng của bạn trở nên tồi tệ hơn Các triệu chứng của bạn không cải thiện sau khi bạn';
MERGE (n:Disease {id: 'D0045'}) SET n.id = 'D0045', n.name = 'bệnh acrodysostosis', n.name_en = 'Acrodysostosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001248.htm', n.prognosis = 'Các vấn đề phụ thuộc vào mức độ liên quan đến xương và tình trạng thiểu năng trí tuệ. Nói chung mọi người làm tốt.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của con bạn nếu có dấu hiệu bệnh acrodystosis phát triển. Đảm bảo chiều cao và cân nặng của con bạn được đo trong mỗi lần khám sức khỏe cho trẻ. Nhà cung cấp dịch vụ c';
MERGE (n:Disease {id: 'D0046'}) SET n.id = 'D0046', n.name = 'Bệnh to cực', n.name_en = 'Acromegaly', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/acromegaly/symptoms-causes/syc-20351222 | https://medlineplus.gov/ency/article/000321.htm', n.overview = 'Người có khuôn mặt và bàn tay to cực. Những thay đổi trên khuôn mặt có thể bao gồm lông mày và hàm dưới nổi bật hơn, cùng với mũi và môi lớn hơn. Bệnh to cực là một tình trạng nội tiết tố hiếm gặp ở n', n.prognosis = 'Phẫu thuật tuyến yên thành công ở hầu hết mọi người, tùy thuộc vào kích thước của khối u và kinh nghiệm của bác sĩ phẫu thuật thần kinh với khối u tuyến yên. Nếu không điều trị, các triệu chứng sẽ trở', n.when_to_see = 'Hãy kiểm tra sức khỏe nếu bạn cho rằng mình có các triệu chứng của bệnh to cực. Tình trạng này thường phát triển chậm. Ngay cả các thành viên trong gia đình cũng có thể mất nhiều thời gian để nhận thấ';
MERGE (n:Disease {id: 'D0047'}) SET n.id = 'D0047', n.name = 'dày sừng quang hóa', n.name_en = 'Actinic keratosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/actinic-keratosis/symptoms-causes/syc-20354969 | https://medlineplus.gov/ency/article/000827.htm', n.overview = 'Chứng dày sừng quang hóa (ak-TIN-ik ker-uh-TOE-sis) là một mảng sần sùi, có vảy trên da phát triển sau nhiều năm tiếp xúc với ánh nắng mặt trời. Nó thường được tìm thấy trên mặt, môi, tai, cẳng tay, d', n.prognosis = 'Một số ít các khối u da này biến thành ung thư biểu mô tế bào vảy.', n.when_to_see = 'Có thể khó phân biệt giữa các điểm không phải ung thư và các điểm ung thư. Vì vậy, tốt nhất là bạn nên để nhà cung cấp dịch vụ chăm sóc sức khỏe đánh giá những thay đổi mới trên da - đặc biệt nếu vết ';
MERGE (n:Disease {id: 'D0048'}) SET n.id = 'D0048', n.name = 'bệnh Actinomycosis', n.name_en = 'Actinomycosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000599.htm', n.prognosis = 'Sự phục hồi hoàn toàn có thể được mong đợi khi điều trị.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu bạn phát triển các triệu chứng của bệnh nhiễm trùng này. Bắt đầu điều trị ngay lập tức giúp đẩy nhanh quá trình phục hồi.';
MERGE (n:Disease {id: 'D0049'}) SET n.id = 'D0049', n.name = 'Khủng hoảng thượng thận cấp tính', n.name_en = 'Acute adrenal crisis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000357.htm', n.prognosis = 'Sốc có thể xảy ra nếu không được điều trị sớm và có thể đe dọa tính mạng do huyết áp rất thấp và các vấn đề về tim.', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi số khẩn cấp tại địa phương (chẳng hạn như 911) nếu bạn xuất hiện các triệu chứng của cơn suy thượng thận cấp tính. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của';
MERGE (n:Disease {id: 'D0050'}) SET n.id = 'D0050', n.name = 'Tắc động mạch cấp tính - thận', n.name_en = 'Acute arterial occlusion - kidney', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001272.htm', n.prognosis = 'Thiệt hại do tắc động mạch có thể biến mất. Tuy nhiên, trong hầu hết các trường hợp, nó là vĩnh viễn. Nếu chỉ có một quả thận bị ảnh hưởng, quả thận khỏe mạnh có thể đảm nhiệm việc lọc máu và sản xuất', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn ngừng sản xuất nước tiểu Bạn cảm thấy đau đột ngột, dữ dội ở lưng, sườn hoặc bụng Nhận trợ giúp y tế khẩn cấp ngay lập tức nếu bạn có các triệu chứng ';
MERGE (n:Disease {id: 'D0051'}) SET n.id = 'D0051', n.name = 'Viêm phế quản cấp tính', n.name_en = 'Acute bronchitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001087.htm', n.prognosis = 'Ngoại trừ ho, các triệu chứng thường hết sau 7 đến 10 ngày nếu bạn không bị rối loạn phổi. Ho thường kéo dài từ 2 đến 3 tuần.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn: Ho hầu hết các ngày hoặc ho liên tục Ho ra máu Sốt cao hoặc ớn lạnh Sốt nhẹ trong 3 ngày trở lên Có chất nhầy đặc, màu vàng xanh, đặc biệt là nếu có m';
MERGE (n:Disease {id: 'D0052'}) SET n.id = 'D0052', n.name = 'Mất điều hòa tiểu não cấp tính', n.name_en = 'Acute cerebellar ataxia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001397.htm', n.prognosis = 'Những người bị bệnh do nhiễm virus gần đây sẽ hồi phục hoàn toàn mà không cần điều trị trong vài tháng. Đột quỵ, chảy máu hoặc nhiễm trùng có thể gây ra các triệu chứng vĩnh viễn.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu có bất kỳ triệu chứng mất điều hòa nào xuất hiện.';
MERGE (n:Disease {id: 'D0053'}) SET n.id = 'D0053', n.name = 'Viêm túi mật cấp tính', n.name_en = 'Acute cholecystitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000264.htm', n.prognosis = 'Hầu hết những người được phẫu thuật cắt bỏ túi mật đều hồi phục hoàn toàn.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Đau bụng dữ dội không biến mất Các triệu chứng viêm túi mật quay trở lại';
MERGE (n:Disease {id: 'D0054'}) SET n.id = 'D0054', n.name = 'Hội chứng mạch vành cấp tính', n.name_en = 'Acute coronary syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/acute-coronary-syndrome/symptoms-causes/syc-20352136 | https://medlineplus.gov/ency/article/007639.htm', n.overview = 'Đau tim và oxy đến tim bị chặn. Sự tích tụ chất béo, cholesterol và các chất khác có thể làm cho động mạch bị thu hẹp, cản trở lưu lượng máu. Sự tích tụ này được gọi là mảng bám. Nếu mảng bám vỡ ra, c', n.prognosis = 'Tình trạng sức khỏe của bạn sau ACS phụ thuộc vào: Bạn được điều trị nhanh như thế nào Số lượng động mạch bị tắc nghẽn và mức độ tắc nghẽn nặng đến mức nào Tim của bạn có bị tổn thương hay không, cũng', n.when_to_see = 'An ACS is a medical emergency. Nếu bạn có các triệu chứng của ACS, hãy nhanh chóng gọi 911 hoặc số khẩn cấp tại địa phương. Không nên: Cố gắng tự lái xe đến bệnh viện. Đợi đã - Nếu bạn đang bị đau tim';
MERGE (n:Disease {id: 'D0055'}) SET n.id = 'D0055', n.name = 'Viêm tủy mềm cấp tính', n.name_en = 'Acute flaccid myelitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007743.htm', n.prognosis = 'Triển vọng dài hạn của AFM vẫn chưa được biết đến.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn hoặc con bạn bị: Yếu đột ngột ở cánh tay hoặc chân hoặc khó di chuyển đầu hoặc mặt Bất kỳ triệu chứng nào khác của AFM';
MERGE (n:Disease {id: 'D0056'}) SET n.id = 'D0056', n.name = 'Viêm tủy mềm cấp tính (AFM)', n.name_en = 'Acute flaccid myelitis (AFM)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/acute-flaccid-myelitis/symptoms-causes/syc-20493046', n.overview = 'là một tình trạng hiếm gặp nhưng nghiêm trọng ảnh hưởng đến tủy sống. Nó có thể gây yếu tay hoặc chân đột ngột, mất trương lực cơ và mất phản xạ. Tình trạng này chủ yếu ảnh hưởng đến trẻ nhỏ. Hầu hết ', n.when_to_see = 'Nếu bạn hoặc con bạn có bất kỳ dấu hiệu hoặc triệu chứng nào được liệt kê ở trên, hãy tìm kiếm sự chăm sóc y tế càng sớm càng tốt.';
MERGE (n:Disease {id: 'D0057'}) SET n.id = 'D0057', n.name = 'Suy thận cấp tính', n.name_en = 'Acute kidney failure', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000501.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu lượng nước tiểu của bạn chậm hoặc ngừng hoặc bạn có các triệu chứng khác của suy thận cấp.';
MERGE (n:Disease {id: 'D0058'}) SET n.id = 'D0058', n.name = 'Chấn thương thận cấp tính', n.name_en = 'Acute kidney injury', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/kidney-failure/symptoms-causes/syc-20369048', n.overview = 'Mặt cắt ngang của thận từ máu thông qua các đơn vị lọc gọi là nephron. Mỗi nephron chứa một bộ lọc, được gọi là cầu thận. Mỗi bộ lọc có các mạch máu nhỏ gọi là mao mạch. Khi máu chảy vào cầu thận, các', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn ngay lập tức hoặc tìm kiếm sự chăm sóc khẩn cấp nếu bạn có các triệu chứng của chấn thương thận cấp tính. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin đượ';
MERGE (n:Disease {id: 'D0059'}) SET n.id = 'D0059', n.name = 'Suy gan cấp tính', n.name_en = 'Acute liver failure', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/acute-liver-failure/symptoms-causes/syc-20352863', n.overview = 'là tình trạng mất chức năng gan xảy ra nhanh chóng - tính bằng ngày hoặc vài tuần - thường ở người không mắc bệnh gan từ trước. Nguyên nhân thường gặp nhất là do virus viêm gan hoặc do thuốc, chẳng hạ', n.when_to_see = 'Suy gan cấp tính có thể phát triển nhanh chóng ở người khỏe mạnh và đe dọa tính mạng. Nếu bạn hoặc ai đó bạn biết đột nhiên bị vàng mắt hoặc da; đau ở bụng trên; hoặc bất kỳ thay đổi bất thường nào về';
MERGE (n:Disease {id: 'D0060'}) SET n.id = 'D0060', n.name = 'Bệnh bạch cầu lymphoblastic cấp tính (ALL)', n.name_en = 'Acute lymphoblastic leukemia (ALL)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000541.htm', n.prognosis = 'Những người đáp ứng điều trị ngay lập tức có xu hướng làm tốt hơn. Hầu hết trẻ em bị ALL đều có thể được chữa khỏi. Trẻ em thường có kết quả tốt hơn người lớn.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu bạn hoặc con bạn phát triển các triệu chứng của TẤT CẢ.';
MERGE (n:Disease {id: 'D0061'}) SET n.id = 'D0061', n.name = 'Bệnh bạch cầu lymphocytic cấp tính', n.name_en = 'Acute lymphocytic leukemia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/acute-lymphocytic-leukemia/symptoms-causes/syc-20369077', n.overview = '(ALL) là một loại ung thư máu và tủy xương - mô xốp bên trong xương nơi các tế bào máu được tạo ra. Từ "cấp tính" trong bệnh bạch cầu lymphocytic cấp tính xuất phát từ việc bệnh tiến triển nhanh chóng', n.when_to_see = 'Hãy hẹn gặp bác sĩ của bạn hoặc bác sĩ của con bạn nếu bạn nhận thấy bất kỳ dấu hiệu và triệu chứng dai dẳng nào khiến bạn lo lắng. Nhiều dấu hiệu và triệu chứng của bệnh bạch cầu lymphocytic cấp tính';
MERGE (n:Disease {id: 'D0062'}) SET n.id = 'D0062', n.name = 'Bệnh say núi cấp tính', n.name_en = 'Acute mountain sickness', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000133.htm', n.prognosis = 'Hầu hết các trường hợp đều nhẹ. Các triệu chứng cải thiện nhanh chóng khi bạn leo xuống núi ở độ cao thấp hơn. Trường hợp nặng có thể dẫn đến tử vong do các vấn đề về phổi (phù phổi) hoặc sưng não (ph', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có hoặc có các triệu chứng say núi cấp tính, ngay cả khi bạn cảm thấy khỏe hơn khi quay trở lại độ cao thấp hơn. Gọi 911 hoặc số khẩn cấp tại địa phương nế';
MERGE (n:Disease {id: 'D0063'}) SET n.id = 'D0063', n.name = 'Bệnh bạch cầu tủy cấp tính', n.name_en = 'Acute myelogenous leukemia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/acute-myelogenous-leukemia/symptoms-causes/syc-20369109', n.overview = ', còn được gọi là AML, là một bệnh ung thư máu và tủy xương. Tủy xương là chất mềm bên trong xương, nơi tạo ra các tế bào máu. Từ “cấp tính” trong bệnh bạch cầu tủy cấp tính có nghĩa là bệnh có xu hướ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng liên tục khiến bạn lo lắng. Các triệu chứng bệnh bạch cầu tủy cấp tính giống như các triệu chứng của nhiều tình trạng phổ bi';
MERGE (n:Disease {id: 'D0064'}) SET n.id = 'D0064', n.name = 'Bệnh bạch cầu tủy cấp tính (AML) - trẻ em', n.name_en = 'Acute myeloid leukemia (AML) - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007656.htm', n.prognosis = 'Ung thư có thể quay trở lại bất cứ lúc nào. Nhưng đối với hầu hết trẻ em, AML không quay trở lại sau 5 năm. Tuy nhiên, có rất nhiều kết quả khác nhau đối với các phân nhóm AML khác nhau và bệnh có thể', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn để lấy hẹn ngay nếu con bạn xuất hiện các triệu chứng sau: Sốt dai dẳng Dễ bầm tím Khó thở Nhiễm virus không khỏi Mệt mỏi kéo dài Bất';
MERGE (n:Disease {id: 'D0065'}) SET n.id = 'D0065', n.name = 'Bệnh bạch cầu dòng tủy cấp tính - người lớn', n.name_en = 'Acute myeloid leukemia - adult', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000542.htm', n.prognosis = 'Khi sinh thiết tủy xương cho thấy không có bằng chứng về AML, bạn được cho là đã thuyên giảm. Bạn làm tốt đến mức nào tùy thuộc vào sức khỏe tổng thể của bạn và phân nhóm di truyền của tế bào AML. Sự ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để đặt lịch hẹn nếu bạn: Xuất hiện các triệu chứng của AML Có AML và sốt không thuyên giảm hoặc có các dấu hiệu nhiễm trùng khác';
MERGE (n:Disease {id: 'D0066'}) SET n.id = 'D0066', n.name = 'Hội chứng viêm thận cấp', n.name_en = 'Acute nephritic syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000495.htm', n.prognosis = 'Triển vọng phụ thuộc vào căn bệnh gây ra viêm thận. Khi tình trạng được cải thiện, các triệu chứng ứ nước (chẳng hạn như sưng tấy và ho) và huyết áp cao có thể biến mất sau 1 hoặc 2 tuần. Xét nghiệm n', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của hội chứng viêm thận cấp.';
MERGE (n:Disease {id: 'D0067'}) SET n.id = 'D0067', n.name = 'Viêm tụy cấp', n.name_en = 'Acute pancreatitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000287.htm', n.prognosis = 'Hầu hết các trường hợp sẽ khỏi sau một tuần hoặc ít hơn. Tuy nhiên, một số trường hợp phát triển thành bệnh nguy hiểm đến tính mạng. Tỷ lệ tử vong cao khi: Đã xảy ra xuất huyết ở tuyến tụy. Các vấn đề', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị đau bụng dữ dội và liên tục. Bạn phát triển các triệu chứng khác của viêm tụy cấp.';
MERGE (n:Disease {id: 'D0068'}) SET n.id = 'D0068', n.name = 'Hội chứng suy hô hấp cấp tính', n.name_en = 'Acute respiratory distress syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000103.htm', n.prognosis = 'Khoảng 1/3 số người mắc ARDS chết vì căn bệnh này. Những người còn sống thường lấy lại được hầu hết chức năng bình thường của phổi, nhưng nhiều người bị tổn thương phổi vĩnh viễn (thường là nhẹ). Nhiề', n.when_to_see = 'ARDS thường xảy ra nhất trong một căn bệnh khác mà người đó đã phải nhập viện. Trong một số trường hợp, một người khỏe mạnh bị viêm phổi nặng và trở nên nặng hơn và trở thành ARDS. Nếu bạn khó thở, hã';
MERGE (n:Disease {id: 'D0069'}) SET n.id = 'D0069', n.name = 'Viêm xoang cấp tính', n.name_en = 'Acute sinusitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/acute-sinusitis/symptoms-causes/syc-20351671', n.overview = 'khiến các khoảng trống bên trong mũi, được gọi là xoang, bị viêm và sưng tấy. Viêm xoang cấp tính khiến xoang khó thoát nước. Chất nhầy tích tụ. Viêm xoang cấp tính có thể khiến bạn khó thở bằng mũi. ', n.when_to_see = 'Hầu hết những người bị viêm xoang cấp tính không cần đến gặp nhà cung cấp dịch vụ chăm sóc sức khoẻ. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ điều nào sau đây: Các ';
MERGE (n:Disease {id: 'D0070'}) SET n.id = 'D0070', n.name = 'Hoại tử ống thận cấp tính', n.name_en = 'Acute tubular necrosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000512.htm', n.prognosis = 'ATN có thể kéo dài vài ngày đến 6 tuần hoặc hơn. Sau đó có thể là 1 hoặc 2 ngày thải ra một lượng nước tiểu lớn bất thường khi thận hồi phục. Chức năng thận thường trở lại bình thường nhưng có thể có ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu lượng nước tiểu của bạn giảm hoặc ngừng hoặc nếu bạn phát triển các triệu chứng khác của ATN.';
MERGE (n:Disease {id: 'D0071'}) SET n.id = 'D0071', n.name = 'Bệnh Addison', n.name_en = 'Addison disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000378.htm', n.prognosis = 'Với liệu pháp hormone, nhiều người mắc bệnh Addison có thể có một cuộc sống gần như bình thường.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn không thể uống thuốc do nôn mửa. Bạn bị căng thẳng như nhiễm trùng, chấn thương, chấn thương hoặc mất nước. Bạn có thể cần phải điều chỉnh thuốc của mình.';
MERGE (n:Disease {id: 'D0072'}) SET n.id = 'D0072', n.name = 'Cắt bỏ VA', n.name_en = 'Adenoid removal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003011.htm', n.overview = 'Con bạn sẽ được gây mê toàn thân trước khi phẫu thuật. Điều này có nghĩa là con bạn sẽ ngủ và không thể cảm thấy đau. Trong khi phẫu thuật: Bác sĩ phẫu thuật đặt một dụng cụ nhỏ vào miệng của con bạn ', n.prognosis = 'Sau thủ thuật này, hầu hết trẻ em: Thở tốt hơn bằng mũi Ít bị đau họng hơn và nhẹ hơn Ít bị nhiễm trùng tai hơn Trong một số trường hợp hiếm gặp, mô vòm họng có thể phát triển trở lại. Điều này không ';
MERGE (n:Disease {id: 'D0073'}) SET n.id = 'D0073', n.name = 'Adenomyosis', n.name_en = 'Adenomyosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/adenomyosis/symptoms-causes/syc-20369138 | https://medlineplus.gov/ency/article/001513.htm', n.overview = '(ad-uh-no-my-O-sis) là một tình trạng ảnh hưởng đến tử cung. Tử cung là cơ quan hình quả lê rỗng, nơi em bé lớn lên trong thai kỳ. Khi bạn mắc bệnh adenomyosis, mô lót bên trong tử cung sẽ phát triển ', n.prognosis = 'Các triệu chứng thường biến mất sau thời kỳ mãn kinh. Phẫu thuật cắt bỏ tử cung thường giúp bạn loại bỏ hoàn toàn các triệu chứng.', n.when_to_see = 'Bạn nên đến gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có kinh nguyệt nhiều kéo dài hoặc bị chuột rút nghiêm trọng trong kỳ kinh ảnh hưởng đến hoạt động hàng ngày của bạn.';
MERGE (n:Disease {id: 'D0074'}) SET n.id = 'D0074', n.name = 'Độ bám dính', n.name_en = 'Adhesion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001493.htm', n.prognosis = 'Kết quả tốt trong hầu hết các trường hợp.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn: Đau bụng Không thể thải khí Buồn nôn và nôn mửa không biến mất Đau bụng dữ dội và chuột rút';
MERGE (n:Disease {id: 'D0075'}) SET n.id = 'D0075', n.name = 'Rối loạn điều chỉnh', n.name_en = 'Adjustment disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000932.htm', n.prognosis = 'Với sự giúp đỡ và hỗ trợ phù hợp, bạn sẽ nhanh chóng khỏe lại. Vấn đề thường không kéo dài quá 6 tháng, trừ khi tác nhân gây căng thẳng vẫn tiếp tục hiện diện.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để lấy hẹn nếu bạn xuất hiện các triệu chứng rối loạn điều chỉnh. Nếu bạn hoặc ai đó bạn biết đang nghĩ đến việc tự tử, hãy gọi hoặc nhắn tin tới 988 hoặc ';
MERGE (n:Disease {id: 'D0076'}) SET n.id = 'D0076', n.name = 'Các khối u và khối u phần phụ', n.name_en = 'Adnexal tumors and masses', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/adnexal-tumors/symptoms-causes/syc-20355053', n.overview = 'Hệ thống sinh sản nữ, tử cung, cổ tử cung và âm đạo, còn được gọi là ống âm đạo, tạo nên hệ thống sinh sản nữ. Các khối u và khối u phụ là sự phát triển của các tế bào hình thành trên các cơ quan và m', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Nếu bạn có bất kỳ triệu chứng nào sau đây, hãy đi cấp cứu ngay lập tức: Đau vùng chậu hoặ';
MERGE (n:Disease {id: 'D0077'}) SET n.id = 'D0077', n.name = 'Sự phát triển của tuổi vị thành niên', n.name_en = 'Adolescent development', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002003.htm', n.overview = 'Trong thời niên thiếu, trẻ phát triển khả năng: Hiểu các ý tưởng trừu tượng. Chúng bao gồm việc nắm bắt các khái niệm toán học cao hơn và phát triển các triết lý đạo đức, bao gồm các quyền và đặc quyề';
MERGE (n:Disease {id: 'D0078'}) SET n.id = 'D0078', n.name = 'Kiểm tra vị thành niên hoặc chuẩn bị thủ tục', n.name_en = 'Adolescent test or procedure preparation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002054.htm', n.overview = 'Có nhiều cách để giúp thanh thiếu niên chuẩn bị cho kiểm tra hoặc thủ tục y tế. Đầu tiên, giải thích lý do của thủ tục. Hãy để con bạn tham gia và đưa ra càng nhiều quyết định càng tốt. CHUẨN BỊ TRƯỚC';
MERGE (n:Disease {id: 'D0079'}) SET n.id = 'D0079', n.name = 'Ung thư tuyến thượng thận', n.name_en = 'Adrenal cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/adrenal-cancer/symptoms-causes/syc-20351026', n.overview = 'Tuyến thượng thận tạo ra các hormone giúp điều hòa quá trình trao đổi chất, hệ thống miễn dịch, huyết áp và các chức năng quan trọng khác. Mặc dù nhỏ nhưng những tuyến này kiểm soát phần lớn những gì ', n.when_to_see = 'Hãy đặt lịch hẹn với chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D0080'}) SET n.id = 'D0080', n.name = 'Cắt bỏ tuyến thượng thận', n.name_en = 'Adrenal gland removal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007437.htm', n.overview = 'Bạn sẽ được gây mê toàn thân để bạn có thể ngủ và không bị đau trong quá trình phẫu thuật. Cắt bỏ tuyến thượng thận có thể được thực hiện theo hai cách. Loại phẫu thuật bạn thực hiện sẽ phụ thuộc vào ', n.prognosis = 'Những người trải qua phẫu thuật nội soi hầu hết đều hồi phục nhanh hơn so với phẫu thuật mở. Tình trạng sức khỏe của bạn sau phẫu thuật như thế nào tùy thuộc vào lý do phẫu thuật: Nếu bạn đã phẫu thuậ';
MERGE (n:Disease {id: 'D0081'}) SET n.id = 'D0081', n.name = 'Tuyến thượng thận', n.name_en = 'Adrenal glands', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002219.htm', n.overview = 'Mỗi tuyến thượng thận có kích thước bằng phần trên cùng của ngón tay cái. Phần bên ngoài của tuyến được gọi là vỏ não. Nó tạo ra các hormone steroid như cortisol, aldosterone và các hormone có thể chu';
MERGE (n:Disease {id: 'D0082'}) SET n.id = 'D0082', n.name = 'Quá liều thuốc giãn phế quản adrenergic', n.name_en = 'Adrenergic bronchodilator overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002594.htm', n.prognosis = 'Sống sót sau 24 giờ thường là một dấu hiệu tốt cho thấy người đó sẽ hồi phục. Những người bị co giật, khó thở và rối loạn nhịp tim có thể gặp vấn đề nghiêm trọng nhất sau khi dùng quá liều.';
MERGE (n:Disease {id: 'D0083'}) SET n.id = 'D0083', n.name = 'Ung thư biểu mô vỏ thượng thận', n.name_en = 'Adrenocortical carcinoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001663.htm', n.prognosis = 'Kết quả phụ thuộc vào việc chẩn đoán được thực hiện sớm như thế nào và khối u có lan rộng hay không (di căn). Các khối u lan rộng thường dẫn đến tử vong trong vòng 1 đến 3 năm.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc con bạn có các triệu chứng của ACC, hội chứng Cushing hoặc chậm phát triển.';
MERGE (n:Disease {id: 'D0084'}) SET n.id = 'D0084', n.name = 'Adrenoleukodystrophy', n.name_en = 'Adrenoleukodystrophy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/adrenoleukodystrophy/symptoms-causes/syc-20369157 | https://medlineplus.gov/ency/article/001182.htm', n.overview = '(uh-dree-noh-loo-koh-DIS-truh-fee) là một loại tình trạng di truyền (di truyền) làm tổn thương màng (vỏ myelin) cách nhiệt các tế bào thần kinh trong não của bạn. Trong chứng loạn dưỡng tuyến thượng t', n.prognosis = 'Dạng ALD liên kết X thời thơ ấu là một bệnh tiến triển. Nó dẫn đến tình trạng hôn mê lâu dài (trạng thái thực vật) khoảng 2 năm sau khi các triệu chứng trên hệ thần kinh phát triển. Đứa trẻ có thể sốn', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Con bạn phát triển các triệu chứng của ALD liên kết X Con bạn mắc ALD liên kết X và ngày càng trầm trọng hơn';
MERGE (n:Disease {id: 'D0085'}) SET n.id = 'D0085', n.name = 'Rối loạn tăng động/giảm chú ý ở người lớn (ADHD)', n.name_en = 'Adult attention-deficit/hyperactivity disorder (ADHD)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/adult-adhd/symptoms-causes/syc-20350878', n.overview = 'là một rối loạn sức khỏe tâm thần bao gồm sự kết hợp của các vấn đề dai dẳng, chẳng hạn như khó chú ý, hiếu động thái quá và hành vi bốc đồng. ADHD ở người trưởng thành có thể dẫn đến các mối quan hệ ', n.when_to_see = 'Nếu bất kỳ triệu chứng nào liệt kê ở trên liên tục làm gián đoạn cuộc sống của bạn, hãy trao đổi với bác sĩ về việc liệu bạn có thể bị ADHD hay không. Các loại chuyên gia chăm sóc sức khỏe khác nhau c';
MERGE (n:Disease {id: 'D0086'}) SET n.id = 'D0086', n.name = 'Sarcoma mô mềm ở người trưởng thành', n.name_en = 'Adult soft tissue sarcoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007654.htm', n.prognosis = 'Triển vọng của những người bị ung thư được điều trị sớm là rất tốt. Hầu hết những người sống sót sau 5 năm có thể hy vọng không bị ung thư sau 10 năm.', n.when_to_see = 'Hãy gặp bác sĩ của bạn nếu có bất kỳ cục u nào phát triển về kích thước hoặc gây đau đớn.';
MERGE (n:Disease {id: 'D0087'}) SET n.id = 'D0087', n.name = 'Bệnh Still ở người lớn', n.name_en = 'Adult Still disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/adult-stills-disease/symptoms-causes/syc-20351907 | https://medlineplus.gov/ency/article/000450.htm', n.overview = 'là một loại viêm khớp hiếm gặp. Các triệu chứng thường gặp là sốt, phát ban và đau khớp. Tình trạng này có thể xảy ra ở một số người dưới dạng một đợt rồi biến mất. Ở những người khác, tình trạng này ', n.prognosis = 'Ở nhiều người, các triệu chứng có thể quay trở lại nhiều lần trong vài năm tới. Các triệu chứng tiếp tục kéo dài (mãn tính) ở khoảng 1/3 số người trưởng thành mắc bệnh Still.', n.when_to_see = 'Nếu bạn bị sốt cao, phát ban và đau khớp, hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Ngoài ra, nếu bạn mắc bệnh Still ở người lớn và bị ho, khó thở, đau ngực hoặc bất kỳ triệu chứng b';
MERGE (n:Disease {id: 'D0088'}) SET n.id = 'D0088', n.name = 'Ngộ độc sau cạo râu', n.name_en = 'Aftershave poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002698.htm', n.prognosis = 'Ngộ độc sau cạo râu phổ biến hơn ở trẻ nhỏ so với trẻ lớn hơn hoặc người lớn. Người nghiện rượu có thể uống nước hoa sau khi cạo râu khi hết rượu khác. Kết quả phụ thuộc vào số lượng người đó nuốt. Ph';
MERGE (n:Disease {id: 'D0089'}) SET n.id = 'D0089', n.name = 'Agammaglobulinemia', n.name_en = 'Agammaglobulinemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001307.htm', n.prognosis = 'Điều trị bằng globulin miễn dịch đã cải thiện đáng kể sức khỏe của những người mắc chứng rối loạn này. Nếu không điều trị, hầu hết các bệnh nhiễm trùng nặng đều gây tử vong.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn để lấy hẹn nếu: Bạn hoặc con bạn bị nhiễm trùng thường xuyên. Bạn có tiền sử gia đình mắc bệnh agammaglobulinemia hoặc rối loạn suy giảm ';
MERGE (n:Disease {id: 'D0090'}) SET n.id = 'D0090', n.name = 'Đốm đồi mồi (đốm gan)', n.name_en = 'Age spots (liver spots)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/age-spots/symptoms-causes/syc-20355859', n.overview = 'Đốm đồi mồi là những vùng tối nhỏ, phẳng trên da. Chúng có kích thước khác nhau và thường xuất hiện ở những vùng tiếp xúc nhiều với ánh nắng mặt trời như mặt, tay, vai và cánh tay. Đốm đồi mồi còn đượ', n.when_to_see = 'Đốm đồi mồi không cần chăm sóc y tế. Nhờ bác sĩ xem xét những đốm đen hoặc có sự thay đổi về hình dáng. Những thay đổi này có thể là dấu hiệu của khối u ác tính, một dạng ung thư da nghiêm trọng. Tốt ';
MERGE (n:Disease {id: 'D0091'}) SET n.id = 'D0091', n.name = 'Suy giảm thính lực liên quan đến tuổi tác', n.name_en = 'Age-related hearing loss', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001045.htm', n.prognosis = 'Tình trạng mất thính lực liên quan đến tuổi tác thường trở nên trầm trọng hơn một cách từ từ. Tình trạng mất thính lực không thể hồi phục và có thể dẫn đến điếc. Mất thính giác có thể khiến bạn tránh ', n.when_to_see = 'Cần kiểm tra tình trạng mất thính lực càng sớm càng tốt. Điều này giúp kiểm tra các nguyên nhân như có quá nhiều ráy tai trong tai hoặc tác dụng phụ của thuốc. Nhà cung cấp của bạn nên yêu cầu bạn đi ';
MERGE (n:Disease {id: 'D0092'}) SET n.id = 'D0092', n.name = 'Thoái hóa điểm vàng liên quan đến tuổi tác', n.name_en = 'Age-related macular degeneration', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001000.htm', n.prognosis = 'AMD không ảnh hưởng đến tầm nhìn bên (ngoại vi). Điều này có nghĩa là mất thị lực hoàn toàn không bao giờ xảy ra. AMD chỉ gây mất thị lực trung tâm. AMD khô, nhẹ thường không gây mất thị lực trung tâm', n.when_to_see = 'Nếu bạn bị AMD, bác sĩ nhãn khoa có thể khuyên bạn nên kiểm tra thị lực hàng ngày bằng lưới Amsler. Liên hệ với bác sĩ nhãn khoa của bạn ngay lập tức nếu các đường trông có vẻ lượn sóng. Đồng thời liê';
MERGE (n:Disease {id: 'D0093'}) SET n.id = 'D0093', n.name = 'Những thay đổi lão hóa trên da', n.name_en = 'Aging changes in skin', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/004014.htm', n.overview = 'Những thay đổi về da là một trong những dấu hiệu lão hóa dễ nhận thấy nhất. Bằng chứng của tuổi tác ngày càng tăng bao gồm nếp nhăn và da chảy xệ. Tóc trắng hoặc bạc là một dấu hiệu lão hóa rõ ràng kh';
MERGE (n:Disease {id: 'D0094'}) SET n.id = 'D0094', n.name = 'Những thay đổi về tuổi tác trong hệ thống sinh sản nam giới', n.name_en = 'Aging changes in the male reproductive system', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/004017.htm', n.overview = 'Không giống như phụ nữ, nam giới không trải qua sự thay đổi lớn, nhanh chóng (trong vài tháng) về khả năng sinh sản khi họ già đi (như mãn kinh). Thay vào đó, những thay đổi xảy ra dần dần trong một q';
MERGE (n:Disease {id: 'D0095'}) SET n.id = 'D0095', n.name = 'Kích động', n.name_en = 'Agitation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003212.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn để biết tình trạng kích động: Kéo dài trong một thời gian dài Rất nghiêm trọng Xảy ra với những suy nghĩ hoặc hành động làm tổn thương bản thân hoặc người khác Xảy';
MERGE (n:Disease {id: 'D0096'}) SET n.id = 'D0096', n.name = 'Chứng sợ khoảng rộng', n.name_en = 'Agoraphobia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/agoraphobia/symptoms-causes/syc-20355987 | https://medlineplus.gov/ency/article/000923.htm', n.overview = '(ag-uh-ruh-FOE-be-uh) là một loại rối loạn lo âu. Chứng sợ khoảng rộng bao gồm nỗi sợ hãi và tránh né những nơi hoặc tình huống có thể gây hoảng loạn và cảm giác bị mắc kẹt, bất lực hoặc xấu hổ. Bạn c', n.prognosis = 'Hầu hết mọi người đều có thể khỏi bệnh nhờ dùng thuốc và CBT. Nếu không có sự giúp đỡ sớm và hiệu quả, chứng rối loạn có thể trở nên khó điều trị hơn.', n.when_to_see = 'Chứng sợ khoảng rộng có thể hạn chế nghiêm trọng khả năng giao tiếp, làm việc, tham dự các sự kiện quan trọng và thậm chí quản lý các chi tiết trong cuộc sống hàng ngày của bạn, chẳng hạn như chạy việ';
MERGE (n:Disease {id: 'D0097'}) SET n.id = 'D0097', n.name = 'Mất bạch cầu hạt', n.name_en = 'Agranulocytosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001295.htm', n.prognosis = 'Việc điều trị hoặc loại bỏ nguyên nhân thường mang lại kết quả tốt.';
MERGE (n:Disease {id: 'D0098'}) SET n.id = 'D0098', n.name = 'Hội chứng Aicardi', n.name_en = 'Aicardi syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001664.htm', n.prognosis = 'Triển vọng phụ thuộc vào mức độ nghiêm trọng của các triệu chứng và các tình trạng sức khỏe khác hiện có. Gần như tất cả trẻ em mắc hội chứng này đều gặp khó khăn nghiêm trọng trong học tập và hoàn to', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có các triệu chứng của hội chứng Aicardi. Tìm kiếm sự chăm sóc khẩn cấp nếu trẻ sơ sinh bị co thắt hoặc co giật.';
MERGE (n:Disease {id: 'D0099'}) SET n.id = 'D0099', n.name = 'Tai máy bay', n.name_en = 'Airplane ear', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/airplane-ear/symptoms-causes/syc-20351701', n.overview = 'là hiện tượng căng thẳng lên màng nhĩ xảy ra khi áp suất không khí ở tai giữa và áp suất không khí bên ngoài tai mất cân bằng. Tai máy bay có thể xảy ra khi máy bay đang lên cao sau khi cất cánh hoặc ', n.when_to_see = 'Đối với tình trạng khó chịu ở tai, đầy hoặc nghẹt thính giác kéo dài hơn một vài ngày hoặc đối với các triệu chứng nghiêm trọng, hãy đặt lịch hẹn khám.';
MERGE (n:Disease {id: 'D0100'}) SET n.id = 'D0100', n.name = 'Bệnh bạch tạng', n.name_en = 'Albinism', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/albinism/symptoms-causes/syc-20369184 | https://medlineplus.gov/ency/article/001479.htm', n.overview = 'Thuật ngữ bệnh bạch tạng thường dùng để chỉ bệnh bạch tạng mắt da (ok-u-low-ku-TAY-nee-us) (OCA). OCA là một nhóm rối loạn di truyền trong các gia đình mà cơ thể tạo ra ít hoặc không tạo ra chất gọi l', n.prognosis = 'Bệnh bạch tạng thường không ảnh hưởng đến tuổi thọ. Tuy nhiên, dạng bệnh bạch tạng HPS có thể rút ngắn tuổi thọ của một người do bệnh phổi hoặc các vấn đề về chảy máu. Những người mắc bệnh bạch tạng c', n.when_to_see = 'Khi con bạn chào đời, nhà cung cấp dịch vụ chăm sóc sức khỏe có thể nhận thấy tóc hoặc da thiếu màu ảnh hưởng đến lông mi và lông mày. Nhà cung cấp có thể sẽ yêu cầu khám mắt và theo dõi chặt chẽ mọi ';
MERGE (n:Disease {id: 'D0101'}) SET n.id = 'D0101', n.name = 'Rượu và mang thai', n.name_en = 'Alcohol and pregnancy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007454.htm', n.overview = 'Khi phụ nữ mang thai uống rượu, rượu sẽ di chuyển qua máu của người đó và đi vào máu, mô và các cơ quan của em bé. Rượu phân hủy trong cơ thể trẻ chậm hơn nhiều so với người lớn. Điều đó có nghĩa là n';
MERGE (n:Disease {id: 'D0102'}) SET n.id = 'D0102', n.name = 'Không dung nạp rượu', n.name_en = 'Alcohol intolerance', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/alcohol-intolerance/symptoms-causes/syc-20369211', n.overview = 'là một tình trạng di truyền trong đó cơ thể không thể phân hủy rượu một cách hiệu quả. Không dung nạp rượu có thể gây ra phản ứng ngay lập tức sau khi bạn uống rượu. Các phản ứng phổ biến nhất là nghẹ', n.when_to_see = 'Đối với tình trạng không dung nạp rượu ở mức độ nhẹ, bạn không cần phải gặp chuyên gia chăm sóc sức khỏe. Đơn giản chỉ cần tránh uống rượu, hạn chế uống bao nhiêu hoặc tránh một số loại đồ uống có cồn';
MERGE (n:Disease {id: 'D0103'}) SET n.id = 'D0103', n.name = 'Ngộ độc rượu', n.name_en = 'Alcohol poisoning', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/alcohol-poisoning/symptoms-causes/syc-20354386', n.overview = 'là một hậu quả nghiêm trọng - và đôi khi gây tử vong - do uống một lượng lớn rượu trong một thời gian ngắn. Uống quá nhiều và nhanh có thể ảnh hưởng đến nhịp thở, nhịp tim, nhiệt độ cơ thể và phản xạ ', n.when_to_see = 'Không nhất thiết phải có tất cả các triệu chứng trên trước khi tìm kiếm sự trợ giúp y tế. Người bị ngộ độc rượu bất tỉnh hoặc không thể tỉnh lại có thể tử vong.';
MERGE (n:Disease {id: 'D0104'}) SET n.id = 'D0104', n.name = 'Sử dụng rượu và uống an toàn', n.name_en = 'Alcohol use and safe drinking', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001944.htm', n.overview = 'Rượu là một trong những chất gây nghiện được sử dụng rộng rãi nhất trên thế giới. UỐNG UỐNG THANH NIÊN Sử dụng rượu không chỉ là vấn đề của người lớn. Đó cũng là vấn đề của tuổi teen. Hầu hết học sinh';
MERGE (n:Disease {id: 'D0105'}) SET n.id = 'D0105', n.name = 'Rối loạn sử dụng rượu', n.name_en = 'Alcohol use disorder', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/alcohol-use-disorder/symptoms-causes/syc-20369243 | https://medlineplus.gov/ency/article/000944.htm', n.overview = 'là một dạng sử dụng rượu liên quan đến các vấn đề trong việc kiểm soát việc uống rượu của bạn, bận tâm đến rượu hoặc tiếp tục sử dụng rượu ngay cả khi nó gây ra vấn đề. Rối loạn này cũng liên quan đến', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào việc họ có thể cắt giảm hoặc ngừng uống rượu thành công hay không. Có thể phải mất vài lần cố gắng để ngừng uống rượu vĩnh viễn. Nếu bạn đang đấu tranh ', n.when_to_see = 'Nếu bạn cảm thấy đôi khi bạn uống quá nhiều rượu hoặc việc uống rượu của bạn đang gây ra vấn đề hoặc nếu gia đình bạn lo lắng về việc bạn uống rượu, hãy trao đổi với nhà cung cấp dịch vụ chăm sóc sức ';
MERGE (n:Disease {id: 'D0106'}) SET n.id = 'D0106', n.name = 'Cai rượu', n.name_en = 'Alcohol withdrawal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000764.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào mức độ tổn thương nội tạng và liệu người đó có thể ngừng uống rượu hoàn toàn hay không. Hội chứng cai rượu có thể ở mức độ từ rối loạn nhẹ và khó chịu đ', n.when_to_see = 'Cai rượu là một tình trạng nghiêm trọng có thể nhanh chóng đe dọa tính mạng. Hãy liên hệ với nhà cung cấp của bạn ngay lập tức hoặc đến phòng cấp cứu nếu bạn cho rằng mình có thể đang bị cai rượu, đặc';
MERGE (n:Disease {id: 'D0107'}) SET n.id = 'D0107', n.name = 'Viêm gan do rượu (Viêm gan liên quan đến rượu)', n.name_en = 'Alcoholic hepatitis (Alcohol-associated hepatitis)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/alcoholic-hepatitis/symptoms-causes/syc-20351388', n.overview = 'Gan nằm ở phần trên bên phải của bụng, bên dưới cơ hoành và phía trên dạ dày. Viêm gan do rượu là một loại tổn thương gan và sưng tấy do uống rượu. Tình trạng sưng này, được gọi là viêm, làm tổn thươn', n.when_to_see = 'Viêm gan do rượu là một căn bệnh nghiêm trọng, thường gây tử vong. Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn: Có triệu chứng viêm gan do rượu. Thật khó để quản lý lượng rượu bạn uống. Muốn giúp tha';
MERGE (n:Disease {id: 'D0108'}) SET n.id = 'D0108', n.name = 'Nhiễm toan ceto do rượu', n.name_en = 'Alcoholic ketoacidosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000323.htm', n.prognosis = 'Chăm sóc y tế kịp thời sẽ cải thiện triển vọng tổng thể. Mức độ sử dụng rượu nghiêm trọng và sự hiện diện của bệnh gan hoặc các vấn đề khác cũng có thể ảnh hưởng đến triển vọng.', n.when_to_see = 'Nếu bạn hoặc người khác có triệu chứng nhiễm toan ceton do rượu, hãy tìm kiếm trợ giúp y tế khẩn cấp.';
MERGE (n:Disease {id: 'D0109'}) SET n.id = 'D0109', n.name = 'Bệnh gan do rượu', n.name_en = 'Alcoholic liver disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000281.htm', n.prognosis = 'Bệnh gan do rượu có thể điều trị được nếu được phát hiện trước khi gây tổn thương nghiêm trọng. Tuy nhiên, việc tiếp tục uống rượu quá mức có thể rút ngắn tuổi thọ của bạn. Xơ gan càng làm tình trạng ', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn: Xuất hiện các triệu chứng của bệnh gan do rượu Phát triển các triệu chứng sau một thời gian dài uống rượu nhiều Lo lắng rằng việc uống rượu có thể gây';
MERGE (n:Disease {id: 'D0110'}) SET n.id = 'D0110', n.name = 'Bệnh thần kinh do rượu', n.name_en = 'Alcoholic neuropathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000714.htm', n.prognosis = 'Tổn thương dây thần kinh do bệnh thần kinh do rượu thường là vĩnh viễn. Tình trạng có thể trở nên tồi tệ hơn nếu người đó tiếp tục sử dụng rượu hoặc nếu vấn đề dinh dưỡng không được khắc phục. Bệnh th', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh thần kinh do rượu.';
MERGE (n:Disease {id: 'D0111'}) SET n.id = 'D0111', n.name = 'Nhiễm kiềm', n.name_en = 'Alkalosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001183.htm', n.prognosis = 'Hầu hết các trường hợp nhiễm kiềm đều đáp ứng tốt với điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn cảm thấy bối rối, không thể tập trung hoặc không thể "hít thở". Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu có: Mất ý thức Các tr';
MERGE (n:Disease {id: 'D0112'}) SET n.id = 'D0112', n.name = 'Alkaptonuria', n.name_en = 'Alkaptonuria', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001200.htm', n.prognosis = 'Kết quả dự kiến ​​sẽ tốt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy nước tiểu của chính bạn hoặc của con bạn chuyển sang màu nâu sẫm hoặc đen khi tiếp xúc với không khí.';
MERGE (n:Disease {id: 'D0113'}) SET n.id = 'D0113', n.name = 'Chất gây dị ứng', n.name_en = 'Allergen', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002229.htm', n.overview = 'Các chất gây dị ứng thông thường bao gồm: Protein động vật và lông động vật Thực phẩm bụi (chẳng hạn như trứng, đậu phộng, sữa, các loại hạt, đậu nành, cá, thịt động vật và lúa mì) Bào tử nấm Phân côn';
MERGE (n:Disease {id: 'D0114'}) SET n.id = 'D0114', n.name = 'Viêm kết mạc dị ứng', n.name_en = 'Allergic conjunctivitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001031.htm', n.prognosis = 'Các triệu chứng thường biến mất khi điều trị. Tuy nhiên, chúng có thể tồn tại nếu bạn tiếp tục tiếp xúc với chất gây dị ứng. Tình trạng sưng tấy lâu dài ở lớp lót bên ngoài của mắt có thể xảy ra ở nhữ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn có các triệu chứng viêm kết mạc dị ứng không đáp ứng với các bước tự chăm sóc và điều trị không kê đơn. Tầm nhìn của bạn bị ảnh hưởng. Bạn bị đau mắt nghi';
MERGE (n:Disease {id: 'D0115'}) SET n.id = 'D0115', n.name = 'Phản ứng dị ứng', n.name_en = 'Allergic reactions', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000005.htm', n.when_to_see = 'Hãy liên hệ ngay để được hỗ trợ y tế (911 hoặc số khẩn cấp tại địa phương) nếu: Người đó đang bị phản ứng dị ứng nghiêm trọng. Đừng chờ đợi xem phản ứng có trở nên tồi tệ hơn không. Người đó có tiền s';
MERGE (n:Disease {id: 'D0116'}) SET n.id = 'D0116', n.name = 'Viêm mũi dị ứng', n.name_en = 'Allergic rhinitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000813.htm', n.prognosis = 'Hầu hết các triệu chứng viêm mũi dị ứng đều có thể được điều trị bằng thuốc. Trường hợp nặng hơn cần tiêm ngừa dị ứng. Một số người, đặc biệt là trẻ em, có thể hết dị ứng khi hệ thống miễn dịch trở nê', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn để đặt lịch hẹn nếu: Bạn có các triệu chứng sốt cỏ khô nghiêm trọng Phương pháp điều trị từng hiệu quả với bạn không còn hiệu quả Các triệu chứng của bạn không đáp';
MERGE (n:Disease {id: 'D0117'}) SET n.id = 'D0117', n.name = 'Dị ứng', n.name_en = 'Allergies', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/allergies/symptoms-causes/syc-20351497 | https://medlineplus.gov/ency/article/000812.htm', n.overview = 'xảy ra khi hệ thống miễn dịch phản ứng với một chất lạ xâm nhập vào cơ thể. Những chất này được gọi là chất gây dị ứng. Chúng bao gồm phấn hoa, nọc ong và lông thú cưng. Dị ứng cũng có thể xảy ra do m', n.prognosis = 'thường xuyên Hầu hết các bệnh dị ứng có thể được điều trị dễ dàng bằng thuốc. Một số trẻ có thể hết dị ứng khi lớn lên, đặc biệt là dị ứng thực phẩm. Nhưng một khi một chất đã gây ra phản ứng dị ứng, ', n.when_to_see = 'Bạn có thể gặp chuyên gia chăm sóc sức khỏe nếu bạn có các triệu chứng mà bạn cho là do dị ứng gây ra và các loại thuốc dị ứng không kê đơn được bán không cần đơn cũng không giúp bạn giảm bớt. Nếu bạn';
MERGE (n:Disease {id: 'D0118'}) SET n.id = 'D0118', n.name = 'Aloe', n.name_en = 'Aloe', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002709.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng lô hội họ nuốt và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Lô hội không độc lắm. Điều trị thường không cần thiết. T';
MERGE (n:Disease {id: 'D0119'}) SET n.id = 'D0119', n.name = 'Rụng tóc từng vùng', n.name_en = 'Alopecia areata', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001450.htm', n.prognosis = 'Phục hồi hoàn toàn tình trạng rụng tóc là điều bình thường. Tuy nhiên, một số người có thể có kết quả kém hơn, bao gồm cả những người mắc: Rụng tóc từng vùng bắt đầu khi còn trẻ Bệnh chàm Rụng tóc lâu', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn lo lắng về tình trạng rụng tóc.';
MERGE (n:Disease {id: 'D0120'}) SET n.id = 'D0120', n.name = 'Thiếu Alpha-1-antitrypsin', n.name_en = 'Alpha-1-antitrypsin deficiency', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/alpha-1-antitrypsin-deficiency/symptoms-causes/syc-20588790 | https://medlineplus.gov/ency/article/000120.htm', n.overview = '(AATD) là một tình trạng di truyền trong các gia đình, được gọi là di truyền. Nó có thể gây tổn thương phổi, gan, da và mạch máu. Không phải tất cả những người mắc AATD đều phát triển các triệu chứng ', n.prognosis = 'Một số người bị thiếu hụt chất này sẽ không phát triển bệnh gan hoặc phổi. Nếu bạn bỏ thuốc lá, bạn có thể làm chậm sự tiến triển của bệnh phổi. COPD và xơ gan có thể đe dọa tính mạng.', n.when_to_see = 'Nếu bạn hoặc con bạn có các triệu chứng của bệnh về phổi, gan, da hoặc mạch máu, hãy trao đổi với chuyên gia chăm sóc sức khỏe của bạn về việc xét nghiệm tình trạng này. Nói chuyện với chuyên gia chăm';
MERGE (n:Disease {id: 'D0121'}) SET n.id = 'D0121', n.name = 'Hội chứng Alpha-gal', n.name_en = 'Alpha-gal syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/alpha-gal-syndrome/symptoms-causes/syc-20428608', n.overview = 'là một loại dị ứng thực phẩm. Nó có thể xảy ra sau khi bị bọ ve cắn. Dị ứng là thịt đỏ và các sản phẩm khác từ động vật có vú. Hội chứng Alpha-gal có thể đe dọa tính mạng. Ở Hoa Kỳ, tình trạng này thư', n.when_to_see = 'Nhận trợ giúp nếu bạn có các triệu chứng dị ứng thực phẩm sau khi ăn, thậm chí vài giờ sau khi ăn. Hãy gặp chuyên gia chăm sóc sức khỏe chính của bạn hoặc chuyên gia về dị ứng, được gọi là bác sĩ dị ứ';
MERGE (n:Disease {id: 'D0122'}) SET n.id = 'D0122', n.name = 'Hội chứng Alport', n.name_en = 'Alport syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000504.htm', n.prognosis = 'Triển vọng phụ thuộc vào loại hội chứng Alport, giới tính sinh học và tuổi tác. Đối với cả nam và nữ, chức năng thận sẽ xấu đi theo thời gian. Ở nam giới mắc XLAS, điều này có thể dẫn đến suy thận ở đ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn để lấy hẹn nếu: Bạn có các triệu chứng của hội chứng Alport. Bạn có tiền sử gia đình mắc hội chứng Alport và bạn đang có kế hoạch mang thai. Lượng nước tiểu của bạ';
MERGE (n:Disease {id: 'D0123'}) SET n.id = 'D0123', n.name = 'Hội chứng Alstrom', n.name_en = 'Alstrom syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001665.htm', n.prognosis = 'Những điều sau đây có thể phát triển: Điếc Mù vĩnh viễn Bệnh tiểu đường loại 2 Suy thận và gan có thể trở nên tồi tệ hơn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn có các triệu chứng của bệnh tiểu đường. Triệu chứng thường gặp của bệnh tiểu đường là khát nước và đi tiểu nhiều. Hã';
MERGE (n:Disease {id: 'D0124'}) SET n.id = 'D0124', n.name = 'Thuốc thay thế - giảm đau', n.name_en = 'Alternative medicine - pain relief', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002064.htm', n.overview = 'Có rất nhiều dạng thuốc thay thế để giảm đau. Chúng bao gồm châm cứu, chỉnh hình, thuốc thảo dược, xoa bóp, sóng từ, thôi miên, phản hồi sinh học, thiền, yoga và thái cực quyền. Châm cứu liên quan đến';
MERGE (n:Disease {id: 'D0125'}) SET n.id = 'D0125', n.name = 'Bệnh Alzheimer', n.name_en = 'Alzheimer disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000760.htm', n.prognosis = 'Bệnh Alzheimer tiến triển nhanh đến mức nào là khác nhau ở mỗi người. Nếu bệnh Alzheimer phát triển nhanh chóng, nó có nhiều khả năng trở nên trầm trọng hơn. Những người mắc bệnh Alzheimer thường chết', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Các triệu chứng của bệnh Alzheimer phát triển hoặc một người có sự thay đổi đột ngột về trạng thái tâm thần Tình trạng của người mắc bệnh Alzheimer trở nên tồ';
MERGE (n:Disease {id: 'D0126'}) SET n.id = 'D0126', n.name = 'Amaurosis fugax', n.name_en = 'Amaurosis fugax', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000784.htm', n.prognosis = 'Amaurosis fugax làm tăng nguy cơ đột quỵ.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu xảy ra tình trạng mất thị lực. Nếu các triệu chứng kéo dài hơn một vài phút hoặc nếu có các triệu chứng khác kèm theo mất thị lực, hãy đi khám ngay.';
MERGE (n:Disease {id: 'D0127'}) SET n.id = 'D0127', n.name = 'Cơ quan sinh dục không rõ ràng', n.name_en = 'Ambiguous genitalia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003269.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn lo lắng về hình dáng bên ngoài của cơ quan sinh dục ngoài của con bạn hoặc con bạn: Mất hơn 2 tuần để lấy lại cân nặng khi sinh Ă';
MERGE (n:Disease {id: 'D0128'}) SET n.id = 'D0128', n.name = 'Giảm thị lực', n.name_en = 'Amblyopia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001014.htm', n.prognosis = 'Trẻ em được điều trị trước 5 tuổi hầu như luôn phục hồi thị lực gần như bình thường. Tuy nhiên, họ có thể tiếp tục gặp vấn đề với nhận thức sâu sắc. Các vấn đề về thị lực vĩnh viễn có thể xảy ra nếu v', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe hoặc bác sĩ nhãn khoa nếu bạn nghi ngờ trẻ nhỏ có vấn đề về thị lực.';
MERGE (n:Disease {id: 'D0129'}) SET n.id = 'D0129', n.name = 'Bệnh amip', n.name_en = 'Amebiasis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000298.htm', n.prognosis = 'Kết quả điều trị thường tốt. Thông thường, bệnh kéo dài khoảng 2 tuần nhưng có thể tái phát nếu bạn không điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị tiêu chảy không thuyên giảm hoặc trở nên nặng hơn.';
MERGE (n:Disease {id: 'D0130'}) SET n.id = 'D0130', n.name = 'Áp xe gan do amip', n.name_en = 'Amebic liver abscess', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000211.htm', n.prognosis = 'Nếu không điều trị, áp xe có thể vỡ ra (vỡ) và lan sang các cơ quan khác dẫn đến tử vong. Những người được điều trị có cơ hội chữa khỏi hoàn toàn rất cao hoặc chỉ có những biến chứng nhỏ.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của bệnh này, đặc biệt nếu gần đây bạn đã đi du lịch đến một khu vực được biết là đang xảy ra bệnh.';
MERGE (n:Disease {id: 'D0131'}) SET n.id = 'D0131', n.name = 'U nguyên bào ameloblastoma', n.name_en = 'Ameloblastoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ameloblastoma/symptoms-causes/syc-20351278', n.overview = 'là một khối u hiếm gặp, không phải ung thư (lành tính) và phát triển thường xuyên nhất ở hàm gần răng hàm. U nguyên bào tạo men bắt đầu trong các tế bào hình thành lớp men bảo vệ trên răng của bạn. Lo', n.when_to_see = 'Hãy nói chuyện với nha sĩ hoặc nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị sưng hoặc đau hàm hoặc bất kỳ mối lo ngại nào khác về sức khỏe răng miệng của mình.';
MERGE (n:Disease {id: 'D0132'}) SET n.id = 'D0132', n.name = 'Amelogenogen không hoàn hảo', n.name_en = 'Amelogenesis imperfecta', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001578.htm', n.prognosis = 'Điều trị thường thành công trong việc bảo vệ răng.', n.when_to_see = 'Hãy liên hệ với nha sĩ nếu bạn có các triệu chứng của tình trạng này.';
MERGE (n:Disease {id: 'D0133'}) SET n.id = 'D0133', n.name = 'Vô kinh', n.name_en = 'Amenorrhea', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/amenorrhea/symptoms-causes/syc-20369299', n.overview = '(uh-men-o-REE-uh) là tình trạng không có kinh nguyệt, thường được định nghĩa là mất một hoặc nhiều kỳ kinh. Vô kinh nguyên phát đề cập đến việc không có kinh nguyệt ở người chưa có kinh trước 15 tuổi.', n.when_to_see = 'Hãy tham khảo ý kiến ​​bác sĩ nếu bạn bị mất ít nhất ba kỳ kinh liên tiếp hoặc nếu bạn chưa bao giờ có kinh và bạn từ 15 tuổi trở lên. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầ';
MERGE (n:Disease {id: 'D0134'}) SET n.id = 'D0134', n.name = 'Quá liều Aminophylline', n.name_en = 'Aminophylline overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002572.htm', n.prognosis = 'Co giật và không đều nhịp tim có thể khó kiểm soát. Một số triệu chứng có thể xảy ra tới 12 giờ sau khi dùng quá liều. Tử vong có thể xảy ra khi dùng quá liều, đặc biệt ở người già hoặc trẻ.';
MERGE (n:Disease {id: 'D0135'}) SET n.id = 'D0135', n.name = 'Quá liều amitriptyline và perphenazine', n.name_en = 'Amitriptyline and perphenazine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002645.htm', n.prognosis = 'Quá liều amitriptyline và perphenazine có thể rất nghiêm trọng. Những người nuốt quá nhiều loại thuốc này hầu như luôn phải nhập viện. Tình trạng sức khỏe của một người sẽ phụ thuộc vào lượng thuốc đư';
MERGE (n:Disease {id: 'D0136'}) SET n.id = 'D0136', n.name = 'Quá liều amitriptyline hydrochloride', n.name_en = 'Amitriptyline hydrochloride overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002631.htm', n.prognosis = 'Quá liều amitriptyline hydrochloride có thể rất nghiêm trọng. Những người nuốt quá nhiều loại thuốc này hầu như luôn phải nhập viện. Tình trạng sức khỏe của một người sẽ phụ thuộc vào lượng thuốc được';
MERGE (n:Disease {id: 'D0137'}) SET n.id = 'D0137', n.name = 'Ngộ độc amoniac', n.name_en = 'Ammonia poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002759.htm', n.prognosis = 'Thiệt hại liên quan đến số lượng và nồng độ (nồng độ) của amoniac. Hầu hết các chất tẩy rửa gia dụng đều tương đối yếu và gây hư hỏng nhẹ hoặc ít. Chất tẩy rửa cường độ cao công nghiệp có thể gây bỏng';
MERGE (n:Disease {id: 'D0138'}) SET n.id = 'D0138', n.name = 'Ngộ độc amoni hydroxit', n.name_en = 'Ammonium hydroxide poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002491.htm', n.prognosis = 'Sống sót sau 48 giờ thường có nghĩa là người đó sẽ hồi phục. Nếu hóa chất làm bỏng mắt, mắt đó có thể bị mù vĩnh viễn. Hiệu quả của một người phụ thuộc vào độ mạnh của hóa chất cũng như tốc độ pha loã';
MERGE (n:Disease {id: 'D0139'}) SET n.id = 'D0139', n.name = 'Chứng mất trí nhớ', n.name_en = 'Amnesia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/amnesia/symptoms-causes/syc-20353360', n.overview = ', còn được gọi là hội chứng mất trí nhớ, đề cập đến việc mất ký ức, bao gồm sự kiện, thông tin và kinh nghiệm. Phim ảnh và truyền hình có xu hướng chiếu cảnh những người mắc chứng mất trí nhớ quên mất', n.when_to_see = 'Bất cứ ai bị mất trí nhớ không rõ nguyên nhân, chấn thương đầu hoặc lú lẫn đều cần được chăm sóc y tế ngay lập tức. Những người bị mất trí nhớ có thể không biết mình đang ở đâu hoặc không thể tìm kiếm';
MERGE (n:Disease {id: 'D0140'}) SET n.id = 'D0140', n.name = 'Trình tự dải ối', n.name_en = 'Amniotic band sequence', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001579.htm', n.prognosis = 'Trẻ sơ sinh khỏe mạnh như thế nào tùy thuộc vào mức độ nghiêm trọng của tình trạng. Hầu hết các trường hợp đều nhẹ và triển vọng chức năng bình thường là tốt. Những trường hợp nghiêm trọng hơn có kết ';
MERGE (n:Disease {id: 'D0141'}) SET n.id = 'D0141', n.name = 'Nước ối', n.name_en = 'Amniotic fluid', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002220.htm', n.overview = 'Khi còn trong bụng mẹ, em bé nổi lên trong nước ối. Lượng nước ối nhiều nhất vào khoảng tuần thứ 34 của thai kỳ (thai tuần 34), khi đó lượng nước ối trung bình là 800 ml (mL). Khoảng 600 mL nước ối ba';
MERGE (n:Disease {id: 'D0142'}) SET n.id = 'D0142', n.name = 'Ung thư bóng Vater', n.name_en = 'Ampullary cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ampullary-cancer/symptoms-causes/syc-20355066', n.overview = 'Bóng Vater và ống tụy nối với nhau và đổ vào ruột non. Ung thư bóng Vater là bệnh ung thư bắt đầu bằng sự phát triển của các tế bào trong bóng Vater. Bóng Vater nằm ở nơi ống mật và ống tụy nối với nh', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng dai dẳng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0143'}) SET n.id = 'D0143', n.name = 'Amyloidosis', n.name_en = 'Amyloidosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/amyloidosis/symptoms-causes/syc-20353178', n.overview = '(am-uh-loi-DO-sis) là một căn bệnh hiếm gặp xảy ra khi một loại protein gọi là amyloid tích tụ trong các cơ quan. Sự tích tụ amyloid này có thể ảnh hưởng đến cách hoạt động của các cơ quan. Bệnh amylo', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn thường xuyên gặp bất kỳ triệu chứng nào liên quan đến bệnh amyloidosis. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem';
MERGE (n:Disease {id: 'D0144'}) SET n.id = 'D0144', n.name = 'Bệnh xơ cứng teo cơ một bên (ALS)', n.name_en = 'Amyotrophic lateral sclerosis (ALS)', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/amyotrophic-lateral-sclerosis/symptoms-causes/syc-20354022 | https://medlineplus.gov/ency/article/000688.htm', n.overview = 'Bệnh xơ cứng teo cơ một bên (a-my-o-TROE-fik LAT-ur-ul skluh-ROE-sis) là một bệnh về hệ thần kinh ảnh hưởng đến các tế bào thần kinh trong não và tủy sống. Còn được gọi là ALS, căn bệnh này dẫn đến yế', n.prognosis = 'Theo thời gian, những người mắc ALS mất khả năng hoạt động và tự chăm sóc bản thân. Tử vong thường xảy ra trong vòng 3 đến 5 năm sau khi chẩn đoán. Khoảng 1 trong 4 người sống sót được hơn 5 năm sau k', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn có các triệu chứng của ALS, đặc biệt nếu bạn có tiền sử gia đình mắc chứng rối loạn này Bạn hoặc người khác đã được chẩn đoán mắc ALS và các triệu chứng t';
MERGE (n:Disease {id: 'D0145'}) SET n.id = 'D0145', n.name = 'Ung thư hậu môn', n.name_en = 'Anal cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/anal-cancer/symptoms-causes/syc-20354140', n.overview = 'Ống hậu môn có chiều dài 1 1/2 inch (khoảng 4 cm). Các cơ được gọi là cơ thắt bao quanh ống hậu môn. Các cơ vòng thư giãn để cho phép chất thải rời khỏi cơ thể. Ung thư hậu môn là sự phát triển của cá', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng hoặc nếu chúng không biến mất. Thông thường, chuyên gia chăm sóc sức khỏe sẽ tìm kiếm bất ';
MERGE (n:Disease {id: 'D0146'}) SET n.id = 'D0146', n.name = 'Nứt hậu môn', n.name_en = 'Anal fissure', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/anal-fissure/symptoms-causes/syc-20351424 | https://medlineplus.gov/ency/article/001130.htm', n.overview = 'Nứt hậu môn là một vết rách nhỏ ở mô mỏng, ẩm dọc theo hậu môn. Hậu môn là lỗ ở cuối đường tiêu hóa, nơi phân thoát ra khỏi cơ thể. Các nguyên nhân phổ biến gây nứt hậu môn bao gồm táo bón, rặn rặn ho', n.prognosis = 'Các vết nứt hậu môn thường lành nhanh chóng mà không gặp bất kỳ vấn đề gì nữa. Những người đã phát triển vết nứt một lần có nhiều khả năng mắc phải chúng trong tương lai.', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn bị đau khi đi tiêu hoặc thấy có máu trên phân hoặc giấy vệ sinh sau khi đi tiêu. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xe';
MERGE (n:Disease {id: 'D0147'}) SET n.id = 'D0147', n.name = 'Lỗ rò hậu môn', n.name_en = 'Anal fistula', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/anal-fistula/symptoms-causes/syc-20352871', n.overview = 'Lỗ rò hậu môn - còn được gọi là lỗ rò-in-ano - là một đường hầm phát triển giữa bên trong hậu môn và vùng da bên ngoài xung quanh hậu môn. Hậu môn là lỗ cơ ở cuối đường tiêu hóa nơi phân thoát ra khỏi';
MERGE (n:Disease {id: 'D0148'}) SET n.id = 'D0148', n.name = 'Ngứa hậu môn', n.name_en = 'Anal itching', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/anal-itching/symptoms-causes/syc-20369345', n.overview = 'là tình trạng phổ biến. Cơn ngứa ở hoặc xung quanh hậu môn thường dữ dội và có thể khiến bạn xấu hổ, khó chịu. Ngứa hậu môn, còn được gọi là ngứa hậu môn (proo-RIE-tus A-nie), có một số nguyên nhân có', n.when_to_see = 'Hầu hết các trường hợp ngứa hậu môn đều không cần chăm sóc y tế. Nhưng hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Ngứa hậu môn nghiêm trọng hoặc liên tục Bạn bị chảy máu hậu môn hoặc ';
MERGE (n:Disease {id: 'D0149'}) SET n.id = 'D0149', n.name = 'Bệnh thận do thuốc giảm đau', n.name_en = 'Analgesic nephropathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000482.htm', n.prognosis = 'Tổn thương ở thận có thể cấp tính và tạm thời, hoặc mãn tính và lâu dài.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có bất kỳ dấu hiệu nào sau đây: Các triệu chứng của bệnh thận do thuốc giảm đau, đặc biệt nếu bạn đã sử dụng thuốc giảm đau trong một thời gian dài';
MERGE (n:Disease {id: 'D0150'}) SET n.id = 'D0150', n.name = 'Sốc phản vệ', n.name_en = 'Anaphylaxis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/anaphylaxis/symptoms-causes/syc-20351468 | https://medlineplus.gov/ency/article/000844.htm', n.overview = 'là một phản ứng dị ứng nghiêm trọng, có khả năng đe dọa tính mạng. Nó có thể xảy ra trong vòng vài giây hoặc vài phút sau khi tiếp xúc với thứ gì đó mà bạn bị dị ứng, chẳng hạn như đậu phộng hoặc ong ', n.prognosis = 'Sốc phản vệ có thể đe dọa tính mạng nếu không được điều trị kịp thời. Các triệu chứng thường thuyên giảm nếu điều trị đúng cách, vì vậy điều quan trọng là phải hành động ngay.', n.when_to_see = 'Hãy tìm kiếm trợ giúp y tế khẩn cấp nếu bạn, con bạn hoặc người khác ở cùng bạn bị phản ứng dị ứng nghiêm trọng. Đừng chờ đợi xem các triệu chứng có biến mất hay không. Nếu bạn lên cơn và mang theo ốn';
MERGE (n:Disease {id: 'D0151'}) SET n.id = 'D0151', n.name = 'Ung thư hạch tế bào lớn thoái hóa', n.name_en = 'Anaplastic large cell lymphoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/anaplastic-large-cell-lymphoma/symptoms-causes/syc-20593721', n.overview = '(ALCL) là một loại ung thư hạch. Ung thư hạch là bệnh ung thư ảnh hưởng đến hệ bạch huyết. Hệ bạch huyết được tạo thành từ các cơ quan, tuyến, mạch dạng ống và cụm tế bào gọi là hạch bạch huyết. Nó là', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0152'}) SET n.id = 'D0152', n.name = 'Ung thư tuyến giáp Anaplastic', n.name_en = 'Anaplastic thyroid cancer', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000352.htm', n.prognosis = 'Triển vọng của căn bệnh này rất kém. Hầu hết mọi người không thể sống sót quá 6 tháng vì bệnh tiến triển nặng và thiếu các phương pháp điều trị hiệu quả.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy: Một khối u hoặc khối dai dẳng ở cổ Khàn giọng hoặc thay đổi giọng nói Ho hoặc ho ra máu';
MERGE (n:Disease {id: 'D0153'}) SET n.id = 'D0153', n.name = 'Thông nối', n.name_en = 'Anastomosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002231.htm', n.overview = 'Ví dụ về các thông nối trong phẫu thuật là: Lỗ rò động tĩnh mạch (một lỗ được tạo ra giữa động mạch và tĩnh mạch) để lọc máu Đại tràng (một lỗ được tạo giữa ruột và da của thành bụng) Ruột, trong đó h';
MERGE (n:Disease {id: 'D0154'}) SET n.id = 'D0154', n.name = 'Thiếu máu', n.name_en = 'Anemia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/anemia/symptoms-causes/syc-20351360 | https://medlineplus.gov/ency/article/000560.htm', n.overview = 'là vấn đề không có đủ tế bào hồng cầu hoặc huyết sắc tố khỏe mạnh để vận chuyển oxy đến các mô của cơ thể. Hemoglobin là một loại protein được tìm thấy trong các tế bào hồng cầu mang oxy từ phổi đến t', n.when_to_see = 'Hãy hẹn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn mệt mỏi hoặc khó thở và không biết tại sao. Nồng độ protein trong hồng cầu mang oxy thấp, được gọi là huyết sắc tố, là dấu hiệu chính';
MERGE (n:Disease {id: 'D0155'}) SET n.id = 'D0155', n.name = 'Thiếu máu do thiếu sắt - trẻ em', n.name_en = 'Anemia caused by low iron - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007134.htm', n.prognosis = 'Với việc điều trị, kết quả có thể sẽ tốt. Trong hầu hết các trường hợp, lượng máu sẽ trở lại bình thường sau 2 đến 3 tháng. Điều quan trọng là bác sĩ của bạn phải tìm ra nguyên nhân gây ra tình trạng ';
MERGE (n:Disease {id: 'D0156'}) SET n.id = 'D0156', n.name = 'Thiếu máu do thiếu sắt - trẻ sơ sinh và trẻ mới biết đi', n.name_en = 'Anemia caused by low iron - infants and toddlers', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007618.htm', n.prognosis = 'Với việc điều trị, kết quả có thể sẽ tốt. Trong hầu hết các trường hợp, lượng máu sẽ trở lại bình thường sau 2 tháng. Điều quan trọng là nhà cung cấp phải tìm ra nguyên nhân khiến con bạn bị thiếu sắt';
MERGE (n:Disease {id: 'D0157'}) SET n.id = 'D0157', n.name = 'Thiếu máu bệnh mãn tính', n.name_en = 'Anemia of chronic disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000565.htm', n.prognosis = 'Tình trạng thiếu máu sẽ cải thiện khi căn bệnh gây ra bệnh đó được điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị rối loạn (mãn tính) lâu dài và bạn xuất hiện các triệu chứng thiếu máu.';
MERGE (n:Disease {id: 'D0158'}) SET n.id = 'D0158', n.name = 'Bệnh thiếu não', n.name_en = 'Anencephaly', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001580.htm', n.prognosis = 'Tình trạng này thường gây tử vong trong vòng vài ngày sau khi sinh.', n.when_to_see = 'Nhà cung cấp dịch vụ chăm sóc sức khỏe thường phát hiện tình trạng này trong quá trình xét nghiệm tiền sản và siêu âm định kỳ. Nếu không, nó được nhận ra khi sinh ra. Nếu bệnh não được phát hiện trước';
MERGE (n:Disease {id: 'D0159'}) SET n.id = 'D0159', n.name = 'Chứng phình động mạch', n.name_en = 'Aneurysm', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001122.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện một khối u trên cơ thể, cho dù nó có đau và nhức nhối hay không. Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạ';
MERGE (n:Disease {id: 'D0160'}) SET n.id = 'D0160', n.name = 'Chứng phình động mạch trong não', n.name_en = 'Aneurysm in the brain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001414.htm', n.prognosis = 'Bạn làm tốt như thế nào còn phụ thuộc vào nhiều thứ. Những người hôn mê sâu sau khi vỡ phình động mạch không có kết quả tốt như những người có triệu chứng ít nghiêm trọng hơn. Chứng phình động mạch nã', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn bị đau đầu đột ngột hoặc dữ dội, đặc biệt nếu bạn cũng bị buồn nôn, nôn, co giật hoặc bất kỳ triệu chứng nào khác về hệ thần k';
MERGE (n:Disease {id: 'D0161'}) SET n.id = 'D0161', n.name = 'Hội chứng Angelman', n.name_en = 'Angelman syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/angelman-syndrome/symptoms-causes/syc-20355621 | https://medlineplus.gov/ency/article/007616.htm', n.overview = 'là tình trạng gây ra bởi sự thay đổi trong gen, được gọi là thay đổi di truyền. Hội chứng Angelman gây ra tình trạng chậm phát triển, các vấn đề về giọng nói và thăng bằng, khuyết tật về tâm thần và đ', n.prognosis = 'Những người mắc AS có tuổi thọ gần như bình thường. Nhiều người có tình bạn và tương tác xã hội. Điều trị giúp cải thiện chức năng. Người mắc AS không thể tự sống được. Tuy nhiên, họ có thể học một số', n.when_to_see = 'Hầu hết trẻ sơ sinh mắc hội chứng Angelman không biểu hiện triệu chứng khi mới sinh. Dấu hiệu đầu tiên của hội chứng Angelman thường là sự chậm phát triển. Điều này bao gồm việc không bò hoặc bập bẹ t';
MERGE (n:Disease {id: 'D0162'}) SET n.id = 'D0162', n.name = 'Đau thắt ngực', n.name_en = 'Angina', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/angina/symptoms-causes/syc-20369373', n.overview = '(an-JIE-nuh hoặc AN-juh-nuh) là một loại đau ngực do lưu lượng máu đến tim giảm. Đau thắt ngực là một triệu chứng của bệnh động mạch vành. Đau thắt ngực còn được gọi là đau thắt ngực. Đau thắt ngực th', n.when_to_see = 'Đau ngực kéo dài hơn vài phút và không thuyên giảm khi nghỉ ngơi hoặc dùng thuốc trị đau thắt ngực có thể là do cơn đau tim. Gọi 911 hoặc trợ giúp y tế khẩn cấp. Chỉ tự lái xe đến bệnh viện nếu không ';
MERGE (n:Disease {id: 'D0163'}) SET n.id = 'D0163', n.name = 'Angiodysplasia của đại tràng', n.name_en = 'Angiodysplasia of the colon', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000238.htm', n.prognosis = 'Những người bị chảy máu liên quan đến tình trạng này mặc dù đã được nội soi, chụp động mạch, dùng thuốc hoặc phẫu thuật có thể sẽ bị chảy máu nhiều hơn trong tương lai. Triển vọng vẫn tốt nếu tình trạ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu xảy ra chảy máu trực tràng.';
MERGE (n:Disease {id: 'D0164'}) SET n.id = 'D0164', n.name = 'Phù mạch', n.name_en = 'Angioedema', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000846.htm', n.prognosis = 'Phù mạch không ảnh hưởng đến hô hấp có thể gây khó chịu. Nó thường vô hại và biến mất sau vài ngày.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Phù mạch không đáp ứng với điều trị Tình trạng nghiêm trọng Bạn chưa bao giờ bị phù mạch trước đó Hãy đến phòng cấp cứu hoặc gọi số cấp cứu tại địa phương';
MERGE (n:Disease {id: 'D0165'}) SET n.id = 'D0165', n.name = 'Tạo hình mạch và đặt stent - động mạch cảnh', n.name_en = 'Angioplasty and stent placement - carotid artery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002953.htm', n.overview = 'Tạo hình mạch và đặt stent động mạch cảnh (CAS) được thực hiện bằng cách sử dụng một vết cắt phẫu thuật nhỏ. Nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn sẽ tiến hành phẫu thuật cắt háng của bạn sau', n.prognosis = 'Nong mạch và đặt stent động mạch cảnh có thể giúp giảm nguy cơ bị đột quỵ. Nhưng bạn có thể cần phải thay đổi lối sống, chẳng hạn như thay đổi chế độ ăn uống và tập thể dục thường xuyên, để giúp ngăn ';
MERGE (n:Disease {id: 'D0166'}) SET n.id = 'D0166', n.name = 'Nong mạch và đặt stent - tim', n.name_en = 'Angioplasty and stent placement - heart', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007473.htm', n.overview = 'Trước khi thủ tục nong mạch bắt đầu, bạn sẽ nhận được một số thuốc giảm đau. Bạn cũng có thể được dùng thuốc giúp bạn thư giãn và thuốc làm loãng máu để ngăn ngừa cục máu đông hình thành. Bạn sẽ nằm t', n.prognosis = 'Đối với hầu hết mọi người, nong mạch vành cải thiện đáng kể lưu lượng máu qua động mạch vành và tim. Nó có thể giúp bạn tránh phải phẫu thuật bắc cầu động mạch vành (CABG). Nong mạch vành không chữa đ';
MERGE (n:Disease {id: 'D0167'}) SET n.id = 'D0167', n.name = 'Nong mạch và đặt stent - động mạch ngoại vi', n.name_en = 'Angioplasty and stent placement - peripheral arteries', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007393.htm', n.overview = 'Nong mạch vành sử dụng một "quả bóng" y tế để mở rộng các động mạch bị tắc. Quả bóng ép vào thành trong của động mạch để mở không gian và cải thiện lưu lượng máu. Một stent kim loại thường được đặt ng', n.prognosis = 'Nong mạch vành cải thiện lưu lượng máu động mạch cho hầu hết mọi người. Kết quả sẽ khác nhau, tùy thuộc vào vị trí tắc nghẽn, kích thước mạch máu và mức độ tắc nghẽn ở các động mạch khác. Bạn có thể k';
MERGE (n:Disease {id: 'D0168'}) SET n.id = 'D0168', n.name = 'Angiosarcoma', n.name_en = 'Angiosarcoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/angiosarcoma/symptoms-causes/syc-20350244', n.overview = 'là một loại ung thư hiếm gặp hình thành trong niêm mạc mạch máu và mạch bạch huyết. Các mạch bạch huyết là một phần của hệ thống miễn dịch. Các mạch bạch huyết thu thập vi khuẩn, vi rút và các chất th', n.when_to_see = 'Đặt lịch hẹn với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ triệu chứng dai dẳng nào
 những triệu chứng khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D0169'}) SET n.id = 'D0169', n.name = 'Anisocoria', n.name_en = 'Anisocoria', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003314.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có những thay đổi dai dẳng, không giải thích được hoặc đột ngột về kích thước đồng tử. Nếu có bất kỳ thay đổi nào gần đây về kích';
MERGE (n:Disease {id: 'D0170'}) SET n.id = 'D0170', n.name = 'Nội soi khớp mắt cá chân', n.name_en = 'Ankle arthroscopy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007584.htm', n.overview = 'Bạn có thể được gây mê toàn thân trước khi phẫu thuật. Điều này có nghĩa là bạn sẽ ngủ và không thể cảm thấy đau. Hoặc, bạn có thể được gây tê vùng. Điều này có nghĩa là vùng chân và mắt cá chân của b', n.prognosis = 'Nội soi khớp sử dụng những vết cắt nhỏ trên da. So với phẫu thuật mở, bạn có thể: Ít đau và cứng khớp Ít biến chứng hơn Phục hồi nhanh hơn Các vết cắt nhỏ sẽ lành nhanh chóng và bạn có thể tiếp tục cá';
MERGE (n:Disease {id: 'D0171'}) SET n.id = 'D0171', n.name = 'Đau mắt cá chân', n.name_en = 'Ankle pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003167.htm', n.when_to_see = 'Hãy đến bệnh viện nếu: Bạn bị đau dữ dội ngay cả khi KHÔNG chịu được trọng lượng. Bạn nghi ngờ bị gãy xương (khớp có vẻ bị biến dạng hoặc bạn không thể đặt bất kỳ trọng lượng nào lên chân). Bạn nghe t';
MERGE (n:Disease {id: 'D0172'}) SET n.id = 'D0172', n.name = 'Phẫu thuật thay thế mắt cá chân', n.name_en = 'Ankle replacement', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007254.htm', n.overview = 'thường được thực hiện khi bạn đang được gây mê toàn thân. Điều này có nghĩa là bạn sẽ ngủ và không cảm thấy đau. Bạn có thể bị gây tê tủy sống. Bạn có thể tỉnh táo nhưng sẽ không cảm thấy gì ở dưới th', n.prognosis = 'Một ca thay mắt cá chân thành công có thể sẽ: Giảm hoặc loại bỏ cơn đau của bạn Cho phép bạn di chuyển mắt cá chân lên xuống Trong hầu hết các trường hợp, tổng số lần thay mắt cá chân kéo dài từ 10 nă';
MERGE (n:Disease {id: 'D0173'}) SET n.id = 'D0173', n.name = 'Viêm cột sống dính khớp', n.name_en = 'Ankylosing spondylitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/ankylosing-spondylitis/symptoms-causes/syc-20354808 | https://medlineplus.gov/ency/article/000420.htm', n.overview = 'hay còn gọi là viêm cột sống dính trục, là một loại bệnh viêm nhiễm chủ yếu ảnh hưởng đến cột sống. Theo thời gian, tình trạng viêm có thể khiến một số xương ở cột sống, được gọi là đốt sống, dính lại', n.prognosis = 'Diễn biến của bệnh khó dự đoán. Theo thời gian, các dấu hiệu và triệu chứng của bệnh AS bùng phát (tái phát) và thuyên giảm (chuyển tiếp). Hầu hết mọi người đều có thể hoạt động tốt trừ khi họ bị tổn ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn bị đau thắt lưng hoặc đau mông diễn ra từ từ. Ngoài ra, hãy đến gặp chuyên gia chăm sóc sức khỏe nếu cơn đau trở nên tồi tệ hơn vào buổi sáng hoặc khiến bạ';
MERGE (n:Disease {id: 'D0174'}) SET n.id = 'D0174', n.name = 'Tuyến tụy hình khuyên', n.name_en = 'Annular pancreas', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001142.htm', n.prognosis = 'Kết quả thường tốt nhất khi phẫu thuật. Người lớn có tuyến tụy hình khuyên có nguy cơ mắc ung thư tuyến tụy hoặc đường mật cao hơn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn có bất kỳ triệu chứng nào của tuyến tụy hình khuyên.';
MERGE (n:Disease {id: 'D0175'}) SET n.id = 'D0175', n.name = 'Động mạch vành trái bất thường từ động mạch phổi', n.name_en = 'Anomalous left coronary artery from the pulmonary artery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007323.htm', n.prognosis = 'Nếu không điều trị, hầu hết trẻ sơ sinh sẽ không qua khỏi trong năm đầu tiên. Những đứa trẻ sống sót mà không cần điều trị có thể gặp các vấn đề nghiêm trọng về tim. Trẻ sơ sinh mắc bệnh này nếu không', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn: Thở nhanh Trông rất nhợt nhạt Có vẻ đau khổ và thường xuyên khóc';
MERGE (n:Disease {id: 'D0176'}) SET n.id = 'D0176', n.name = 'Anorchia', n.name_en = 'Anorchia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001185.htm', n.prognosis = 'Triển vọng tốt khi điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu là trẻ nam: Dường như có tinh hoàn cực nhỏ hoặc không có. Dường như không bắt đầu dậy thì khi còn ở tuổi thiếu niên';
MERGE (n:Disease {id: 'D0177'}) SET n.id = 'D0177', n.name = 'Áp xe hậu môn trực tràng', n.name_en = 'Anorectal abscess', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001519.htm', n.prognosis = 'Nếu được điều trị kịp thời, những người mắc bệnh này thường sẽ khỏi bệnh. Trẻ sơ sinh và trẻ mới biết đi thường hồi phục nhanh chóng. Các biến chứng có thể xảy ra khi điều trị bị trì hoãn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn: Nhận thấy dịch tiết ra từ trực tràng, đau hoặc các triệu chứng khác của áp xe hậu môn trực tràng Bị sốt, ớn lạnh hoặc các triệu ';
MERGE (n:Disease {id: 'D0178'}) SET n.id = 'D0178', n.name = 'Chán ăn', n.name_en = 'Anorexia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000362.htm', n.prognosis = 'Chán ăn là một tình trạng nghiêm trọng có thể đe dọa đến tính mạng. Các chương trình điều trị có thể giúp những người mắc bệnh trở lại cân nặng bình thường. Nhưng bệnh thường tái phát. Những phụ nữ mắ', n.when_to_see = 'Hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu người mà bạn quan tâm: Quá tập trung vào cân nặng Tập thể dục quá sức Hạn chế thực phẩm họ ăn Rất thiếu cân Có biểu hiện suy nghĩ ';
MERGE (n:Disease {id: 'D0179'}) SET n.id = 'D0179', n.name = 'Chán ăn tâm thần', n.name_en = 'Anorexia nervosa', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/anorexia-nervosa/symptoms-causes/syc-20353591', n.overview = 'Chán ăn tâm thần (an-o-REK-see-uh), thường được gọi đơn giản là chán ăn, là một chứng rối loạn ăn uống có thể điều trị được, trong đó mọi người có trọng lượng cơ thể thấp dựa trên lịch sử cân nặng cá ', n.when_to_see = 'Vì tình trạng suy dinh dưỡng ảnh hưởng đến não bộ nên người mắc chứng biếng ăn có thể không muốn điều trị. Đặc điểm cốt lõi của chứng biếng ăn là những người mắc chứng rối loạn ăn uống thường không nh';
MERGE (n:Disease {id: 'D0180'}) SET n.id = 'D0180', n.name = 'Chứng vô cảm ở phụ nữ', n.name_en = 'Anorgasmia in women', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/anorgasmia/symptoms-causes/syc-20369422', n.overview = 'Chứng vô cảm bị trì hoãn, cực khoái không thường xuyên hoặc không có - hoặc cực khoái ít mãnh liệt hơn đáng kể - sau khi kích thích tình dục và kích thích tình dục đầy đủ. Những phụ nữ gặp vấn đề về c', n.when_to_see = 'Hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu bạn lo lắng về đời sống tình dục của mình, đặc biệt nếu bạn lo lắng về khả năng đạt cực khoái của mình. Yêu cầu một cuộc hẹn Có vấn đề với
 ';
MERGE (n:Disease {id: 'D0181'}) SET n.id = 'D0181', n.name = 'Chấn thương dây chằng chéo trước (ACL)', n.name_en = 'Anterior cruciate ligament (ACL) injury', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001074.htm', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu bạn bị chấn thương đầu gối nghiêm trọng. Nhận sự chăm sóc y tế ngay lập tức nếu bàn chân mát và xanh sau chấn thương đầu gối. Điều này có nghĩa là';
MERGE (n:Disease {id: 'D0182'}) SET n.id = 'D0182', n.name = 'Đau phía trước đầu gối', n.name_en = 'Anterior knee pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000452.htm', n.prognosis = 'Đau phía trước đầu gối thường cải thiện khi thay đổi hoạt động, liệu pháp tập thể dục và sử dụng NSAID. Phẫu thuật hiếm khi cần thiết. Tuy nhiên, nếu đầu gối của bạn có các triệu chứng như mất ổn định', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có triệu chứng của rối loạn này.';
MERGE (n:Disease {id: 'D0183'}) SET n.id = 'D0183', n.name = 'Sa âm đạo trước (cystocele)', n.name_en = 'Anterior vaginal prolapse (cystocele)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cystocele/symptoms-causes/syc-20369452', n.overview = 'Sa trước âm đạo (cystocele) xảy ra khi bàng quang sa xuống và ấn vào âm đạo. Còn được gọi là sa bàng quang, tình trạng này xảy ra khi các cơ và mô hỗ trợ bàng quang bị yếu đi. Sa âm đạo trước xảy ra k', n.when_to_see = 'Bàng quang sa có thể gây khó chịu nhưng hiếm khi gây đau. Nó có thể làm cho việc làm rỗng bàng quang trở nên khó khăn, có thể dẫn đến nhiễm trùng bàng quang. Hãy hẹn gặp chuyên gia chăm sóc sức khỏe c';
MERGE (n:Disease {id: 'D0184'}) SET n.id = 'D0184', n.name = 'Sửa chữa thành trước âm đạo', n.name_en = 'Anterior vaginal wall repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003982.htm', n.overview = 'Thành âm đạo trước có thể bị lún (sa) hoặc phồng lên. Điều này xảy ra khi bàng quang hoặc niệu đạo chìm vào âm đạo. Việc sửa chữa có thể được thực hiện khi bạn đang: Gây mê toàn thân : Bạn sẽ ngủ và k', n.prognosis = 'Phẫu thuật này thường sẽ sửa chữa được tình trạng sa tử cung và các triệu chứng sẽ biến mất. Sự cải thiện này thường sẽ kéo dài trong nhiều năm.';
MERGE (n:Disease {id: 'D0185'}) SET n.id = 'D0185', n.name = 'Bệnh than', n.name_en = 'Anthrax', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/anthrax/symptoms-causes/syc-20356203 | https://medlineplus.gov/ency/article/001325.htm', n.overview = 'là một căn bệnh hiếm gặp nhưng nghiêm trọng do một loại vi khuẩn hình thành bào tử có tên là Bacillus anthracis gây ra. Trong cơ thể, bào tử tạo thành chất độc có thể phá hủy các mô. Bệnh than chủ yếu', n.prognosis = 'Khi được điều trị bằng kháng sinh, bệnh than ở da có khả năng thuyên giảm. Nhưng một số người không được điều trị có thể chết nếu bệnh than lây lan vào máu. Những người mắc bệnh than qua đường hô hấp ', n.when_to_see = 'Nhiều bệnh thông thường bắt đầu bằng các triệu chứng giống như bệnh cúm. Khả năng bạn bị đau họng và đau nhức cơ bắp là do bệnh than là rất nhỏ. Nếu bạn cho rằng mình có thể đã tiếp xúc với bệnh than,';
MERGE (n:Disease {id: 'D0186'}) SET n.id = 'D0186', n.name = 'Bệnh chống màng đáy cầu thận', n.name_en = 'Anti-glomerular basement membrane disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000142.htm', n.prognosis = 'Việc chẩn đoán sớm là rất quan trọng. Triển vọng sẽ tồi tệ hơn nhiều nếu thận đã bị tổn thương nghiêm trọng khi bắt đầu điều trị. Tổn thương phổi có thể từ nhẹ đến nặng. Nhiều người sẽ cần phải chạy t', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để lấy hẹn nếu bạn sản xuất ít nước tiểu hơn hoặc bạn có bất kỳ triệu chứng nào khác của bệnh kháng GBM.';
MERGE (n:Disease {id: 'D0187'}) SET n.id = 'D0187', n.name = 'Phẫu thuật chống trào ngược', n.name_en = 'Anti-reflux surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002925.htm', n.overview = 'Thủ tục phổ biến nhất thuộc loại này được gọi là gây quỹ. Trong phẫu thuật này, bác sĩ phẫu thuật của bạn sẽ: Đầu tiên sửa chữa thoát vị gián đoạn, nếu có. Điều này liên quan đến việc thắt chặt lỗ hở ', n.prognosis = 'Chứng ợ nóng và các triệu chứng khác sẽ cải thiện sau phẫu thuật. Một số người vẫn cần dùng thuốc trị chứng ợ nóng sau phẫu thuật. Bạn có thể cần một cuộc phẫu thuật khác trong tương lai nếu bạn phát ';
MERGE (n:Disease {id: 'D0188'}) SET n.id = 'D0188', n.name = 'Phẫu thuật chống trào ngược - trẻ em', n.name_en = 'Anti-reflux surgery - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007401.htm', n.overview = 'Loại phẫu thuật chống trào ngược phổ biến nhất được gọi là gây quỹ. Phẫu thuật này thường mất 2 đến 3 giờ. Con bạn sẽ được gây mê toàn thân trước khi phẫu thuật. Điều đó có nghĩa là trẻ sẽ ngủ và khôn', n.prognosis = 'Chứng ợ nóng và các triệu chứng liên quan sẽ cải thiện sau phẫu thuật chống trào ngược. Tuy nhiên, con bạn vẫn có thể cần dùng thuốc điều trị chứng ợ nóng sau phẫu thuật. Một số trẻ có thể cần phẫu th';
MERGE (n:Disease {id: 'D0189'}) SET n.id = 'D0189', n.name = 'Ngộ độc sản phẩm chống gỉ', n.name_en = 'Anti-rust product poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002770.htm', n.prognosis = 'Tình trạng của một người khỏe mạnh như thế nào tùy thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận nhanh như thế nào. Người đó nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồ';
MERGE (n:Disease {id: 'D0190'}) SET n.id = 'D0190', n.name = 'Tiêu chảy liên quan đến kháng sinh', n.name_en = 'Antibiotic associated diarrhea', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/antibiotic-associated-diarrhea/symptoms-causes/syc-20352231', n.overview = 'Tiêu chảy liên quan đến kháng sinh là tình trạng đi tiêu phân lỏng, lỏng ba lần trở lên một ngày sau khi dùng thuốc kháng sinh. Thuốc kháng sinh được sử dụng để điều trị nhiễm trùng do vi khuẩn. Khoản', n.when_to_see = 'Một số tình trạng có thể gây tiêu chảy. Gọi cho chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị: Tiêu chảy kéo dài hơn hai ngày. Tiêu chảy kèm theo đau bụng, sốt hoặc các triệu chứng nghiêm trọng khác';
MERGE (n:Disease {id: 'D0191'}) SET n.id = 'D0191', n.name = 'Ngộ độc thuốc diệt chuột chống đông máu', n.name_en = 'Anticoagulant rodenticides poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002595.htm', n.prognosis = 'Tử vong có thể xảy ra muộn nhất là 2 tuần sau khi bị ngộ độc do chảy máu. Tuy nhiên, việc điều trị đúng cách thường ngăn ngừa các biến chứng nghiêm trọng. Nếu mất máu làm tổn thương tim hoặc các cơ qu';
MERGE (n:Disease {id: 'D0192'}) SET n.id = 'D0192', n.name = 'Quá liều thuốc chống tiêu chảy', n.name_en = 'Antidiarrheal medicine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002522.htm', n.prognosis = 'Hầu hết mọi người sẽ hồi phục sau khi điều trị và được theo dõi trong 24 giờ. Tuy nhiên, tử vong có thể xảy ra, đặc biệt ở trẻ nhỏ. Trẻ em dưới 6 tuổi nên nhập viện và theo dõi chặt chẽ trong 24 giờ v';
MERGE (n:Disease {id: 'D0193'}) SET n.id = 'D0193', n.name = 'Ngộ độc chất chống đông', n.name_en = 'Antifreeze poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002751.htm', n.prognosis = 'Đối với ethylene glycol: Tử vong có thể xảy ra trong vòng 24 giờ đầu. Nếu bệnh nhân sống sót, lượng nước tiểu có thể ít hoặc không có trong vài tuần trước khi thận hồi phục. Tổn thương thận có thể là ';
MERGE (n:Disease {id: 'D0194'}) SET n.id = 'D0194', n.name = 'Hội chứng kháng phospholipid', n.name_en = 'Antiphospholipid syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/antiphospholipid-syndrome/symptoms-causes/syc-20355831', n.overview = 'Hội chứng kháng phospholipid (AN-te-fos-fo-LIP-id) là tình trạng hệ thống miễn dịch nhầm lẫn tạo ra các kháng thể tấn công các mô trong cơ thể. Những kháng thể này có thể khiến cục máu đông hình thành', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc khẩn cấp nếu bạn có các triệu chứng: Đột quỵ. Cục máu đông trong não có thể gây tê, yếu hoặc tê liệt đột ngột ở mặt, cánh tay hoặc chân. Bạn có thể gặp khó khăn khi nói hoặc h';
MERGE (n:Disease {id: 'D0195'}) SET n.id = 'D0195', n.name = 'Hội chứng kháng phospholipid - APS', n.name_en = 'Antiphospholipid syndrome - APS', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000547.htm', n.prognosis = 'Nếu không điều trị, những người mắc APS sẽ gặp hiện tượng đông máu lặp lại. Trong hầu hết các trường hợp, kết quả sẽ tốt nếu được điều trị thích hợp, bao gồm cả liệu pháp chống đông máu lâu dài. Một s', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy các triệu chứng của cục máu đông, chẳng hạn như: Sưng hoặc đỏ ở chân Khó thở Đau, tê và màu da nhợt nhạt ở cánh tay hoặc ch';
MERGE (n:Disease {id: 'D0196'}) SET n.id = 'D0196', n.name = 'Rối loạn nhân cách chống đối xã hội', n.name_en = 'Antisocial personality disorder', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/antisocial-personality-disorder/symptoms-causes/syc-20353928 | https://medlineplus.gov/ency/article/000921.htm', n.overview = ', đôi khi được gọi là bệnh xã hội, là một tình trạng sức khỏe tâm thần trong đó một người luôn tỏ ra không quan tâm đến đúng sai và phớt lờ các quyền cũng như cảm xúc của người khác. Những người mắc c', n.prognosis = 'Các triệu chứng có xu hướng lên đến đỉnh điểm vào cuối tuổi thiếu niên và đầu tuổi 20. Đôi khi chúng tự cải thiện khi một người ở độ tuổi 40.', n.when_to_see = 'Những người mắc chứng rối loạn nhân cách chống đối xã hội không có khả năng tự mình tìm kiếm sự giúp đỡ. Nếu bạn nghi ngờ rằng một người bạn hoặc thành viên gia đình có thể mắc bệnh này, bạn có thể nh';
MERGE (n:Disease {id: 'D0197'}) SET n.id = 'D0197', n.name = 'Rối loạn lo âu', n.name_en = 'Anxiety disorders', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/anxiety/symptoms-causes/syc-20350961', n.overview = 'Đôi khi cảm thấy lo lắng là một phần bình thường của cuộc sống. Tuy nhiên, những người mắc chứng rối loạn lo âu thường có sự lo lắng và sợ hãi mãnh liệt, quá mức và dai dẳng về các tình huống hàng ngà', n.when_to_see = 'Hãy gặp bác sĩ nếu: Bạn cảm thấy mình đang lo lắng quá nhiều và điều đó đang cản trở công việc, các mối quan hệ hoặc các phần khác trong cuộc sống của bạn. Sự sợ hãi, lo lắng hay lo lắng của bạn khiến';
MERGE (n:Disease {id: 'D0198'}) SET n.id = 'D0198', n.name = 'Phình động mạch chủ', n.name_en = 'Aortic aneurysm', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/aortic-aneurysm/symptoms-causes/syc-20369472', n.overview = 'và phình động mạch chủ bóc tách động mạch chủ là một điểm yếu trên thành động mạch chủ và bắt đầu phình ra hoặc phồng ra ngoài, như trong hình bên trái. Chứng phình động mạch có thể xảy ra ở bất kỳ vị';
MERGE (n:Disease {id: 'D0199'}) SET n.id = 'D0199', n.name = 'Sửa chữa chứng phình động mạch chủ - nội mạch', n.name_en = 'Aortic aneurysm repair - endovascular', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007391.htm', n.overview = 'Thủ tục này được thực hiện trong phòng phẫu thuật, tại khoa X quang của bệnh viện hoặc trong phòng thí nghiệm đặt ống thông. Bạn sẽ nằm trên một chiếc bàn có đệm. Bạn có thể được gây mê toàn thân (bạn', n.prognosis = 'Phục hồi sau sửa chữa nội mạch diễn ra nhanh chóng trong hầu hết các trường hợp. Bạn sẽ cần được theo dõi và kiểm tra thường xuyên để đảm bảo chứng phình động mạch chủ đã được sửa chữa của bạn không b';
MERGE (n:Disease {id: 'D0200'}) SET n.id = 'D0200', n.name = 'Hội chứng vòm động mạch chủ', n.name_en = 'Aortic arch syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001123.htm';
MERGE (n:Disease {id: 'D0201'}) SET n.id = 'D0201', n.name = 'Bóc tách động mạch chủ', n.name_en = 'Aortic dissection', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/aortic-dissection/symptoms-causes/syc-20369496 | https://medlineplus.gov/ency/article/000181.htm', n.overview = 'Bóc tách động mạch chủ là một cấp cứu y tế trong đó vết rách xảy ra ở lớp bên trong của động mạch chính của cơ thể. Động mạch đó được gọi là động mạch chủ. Máu chảy qua nước mắt. Điều này làm cho lớp ', n.prognosis = 'Bóc tách động mạch chủ đe dọa tính mạng. Tình trạng này có thể được kiểm soát bằng phẫu thuật nếu nó được thực hiện trước khi vỡ động mạch chủ. Ít hơn một nửa số người bị vỡ động mạch chủ sống sót. Nh', n.when_to_see = 'Hãy gọi 911 hoặc số khẩn cấp tại địa phương nếu bạn bị: Đau ngực hoặc đau bụng dữ dội. Khó thở đột ngột. Các triệu chứng của đột quỵ, chẳng hạn như khó nhìn, nói hoặc di chuyển đột ngột.';
MERGE (n:Disease {id: 'D0202'}) SET n.id = 'D0202', n.name = 'Hở van động mạch chủ', n.name_en = 'Aortic regurgitation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000179.htm', n.prognosis = 'Phẫu thuật có thể chữa khỏi bệnh suy động mạch chủ và giảm các triệu chứng, trừ khi bạn bị suy tim hoặc các biến chứng khác. Những người bị đau thắt ngực hoặc suy tim sung huyết do hở van động mạch ch', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có các triệu chứng hở van động mạch chủ. Bạn bị suy động mạch chủ và các triệu chứng của bạn trở nên trầm trọng hơn hoặc xuất hiện các triệu chứng';
MERGE (n:Disease {id: 'D0203'}) SET n.id = 'D0203', n.name = 'Hẹp động mạch chủ', n.name_en = 'Aortic stenosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000178.htm', n.prognosis = 'Kết quả khác nhau. Rối loạn có thể nhẹ và không gây ra triệu chứng. Theo thời gian, van động mạch chủ có thể trở nên hẹp hơn. Điều này có thể dẫn đến các vấn đề về tim nghiêm trọng hơn như: Rung tâm n', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc con bạn có các triệu chứng hẹp động mạch chủ. Đồng thời, hãy liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu bạn được chẩn đoán mắc bệnh này';
MERGE (n:Disease {id: 'D0204'}) SET n.id = 'D0204', n.name = 'Bệnh van động mạch chủ', n.name_en = 'Aortic valve disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/aortic-valve-disease/symptoms-causes/syc-20355117', n.overview = 'Hẹp van động mạch chủ và thu hẹp van giữa buồng bơm chính của tim và động mạch chính của cơ thể, được gọi là động mạch chủ. Việc thu hẹp tạo ra một lỗ nhỏ hơn cho máu đi qua. Điều này làm giảm hoặc ch', n.when_to_see = 'Nếu bạn bị đau ngực đột ngột, hãy gọi 911 hoặc số khẩn cấp tại địa phương của bạn. Hãy hẹn khám sức khỏe nếu bạn có các triệu chứng của bệnh van động mạch chủ, chẳng hạn như khó thở, mệt mỏi sau khi h';
MERGE (n:Disease {id: 'D0205'}) SET n.id = 'D0205', n.name = 'Hở van động mạch chủ ion', n.name_en = 'Aortic valve regurgitation', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/aortic-valve-regurgitation/symptoms-causes/syc-20353129', n.overview = ', van động mạch chủ không hoạt động bình thường. Điều này khiến máu chảy ngược từ động mạch chính của cơ thể, gọi là động mạch chủ, vào buồng tim phía dưới bên trái, gọi là tâm thất trái. Hở van động ', n.when_to_see = 'Hãy gọi ngay cho thành viên trong nhóm chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng hở van động mạch chủ. Đôi khi các triệu chứng đầu tiên của hở van động mạch chủ có liên quan đến suy tim. Su';
MERGE (n:Disease {id: 'D0206'}) SET n.id = 'D0206', n.name = 'Hẹp van động mạch chủ', n.name_en = 'Aortic valve stenosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/aortic-stenosis/symptoms-causes/syc-20353139', n.overview = 'là một loại bệnh về van tim hay còn gọi là bệnh van tim. Van động mạch chủ nằm giữa buồng tim phía dưới bên trái và động mạch chính của cơ thể, được gọi là động mạch chủ. Trong hẹp van động mạch chủ, ', n.when_to_see = 'Nếu bạn có nhịp tim không đều hoặc các triệu chứng khác của hẹp van động mạch chủ, hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu ';
MERGE (n:Disease {id: 'D0207'}) SET n.id = 'D0207', n.name = 'Phẫu thuật van động mạch chủ - xâm lấn tối thiểu', n.name_en = 'Aortic valve surgery - minimally invasive', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007407.htm', n.overview = 'Trước khi phẫu thuật, bạn sẽ được gây mê toàn thân. Bạn sẽ ngủ và không bị đau. Có một số cách để thực hiện phẫu thuật van động mạch chủ xâm lấn tối thiểu. Các kỹ thuật bao gồm phẫu thuật cắt bỏ ngực ', n.prognosis = 'Van tim cơ học không thường xuyên bị hỏng. Tuy nhiên, cục máu đông có thể phát triển trên chúng. Nếu cục máu đông hình thành, bạn có thể bị đột quỵ. Chảy máu có thể xảy ra, nhưng điều này rất hiếm. Va';
MERGE (n:Disease {id: 'D0208'}) SET n.id = 'D0208', n.name = 'Phẫu thuật van động mạch chủ - mở', n.name_en = 'Aortic valve surgery - open', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007408.htm', n.overview = 'Trước khi phẫu thuật, bạn sẽ được gây mê toàn thân. Bạn sẽ ngủ và không bị đau. Bác sĩ phẫu thuật sẽ thực hiện một vết cắt dài 10 inch (25 cm) ở giữa ngực của bạn. Tiếp theo, bác sĩ phẫu thuật sẽ chia', n.prognosis = 'Van tim cơ học không thường xuyên bị hỏng. Tuy nhiên, cục máu đông có thể phát triển trên chúng. Nếu cục máu đông hình thành, bạn có thể bị đột quỵ. Chảy máu có thể xảy ra, nhưng điều này rất hiếm. Va';
MERGE (n:Disease {id: 'D0209'}) SET n.id = 'D0209', n.name = 'Cửa sổ động mạch phổi', n.name_en = 'Aortopulmonary window', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007319.htm', n.prognosis = 'Phẫu thuật chỉnh sửa cửa sổ chủ phổi thành công trong hầu hết các trường hợp. Nếu khiếm khuyết được điều trị nhanh chóng, trẻ sẽ không bị ảnh hưởng lâu dài.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn có các triệu chứng của cửa sổ động mạch phổi. Tình trạng này được chẩn đoán và điều trị càng sớm thì tiên lượng của trẻ càng tốt.';
MERGE (n:Disease {id: 'D0210'}) SET n.id = 'D0210', n.name = 'Hội chứng Apert', n.name_en = 'Apert syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001581.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có tiền sử gia đình mắc hội chứng Apert hoặc bạn nhận thấy hộp sọ của con bạn không phát triển bình thường.';
MERGE (n:Disease {id: 'D0211'}) SET n.id = 'D0211', n.name = 'Aphasia', n.name_en = 'Aphasia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/aphasia/symptoms-causes/syc-20369518', n.overview = 'là một chứng rối loạn ảnh hưởng đến cách bạn giao tiếp. Nó có thể tác động đến lời nói của bạn, cũng như cách bạn viết và hiểu cả ngôn ngữ nói và viết. Chứng mất ngôn ngữ thường xảy ra đột ngột sau độ', n.when_to_see = 'Bởi vì chứng mất ngôn ngữ thường là dấu hiệu của một vấn đề nghiêm trọng, chẳng hạn như đột quỵ, hãy tìm kiếm sự chăm sóc y tế khẩn cấp nếu bạn hoặc người thân đột nhiên phát triển: Khó nói Khó hiểu l';
MERGE (n:Disease {id: 'D0212'}) SET n.id = 'D0212', n.name = 'Thiếu máu bất sản', n.name_en = 'Aplastic anemia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/aplastic-anemia/symptoms-causes/syc-20355015 | https://medlineplus.gov/ency/article/000554.htm', n.overview = 'là tình trạng xảy ra khi tủy xương của bạn ngừng tạo ra đủ tế bào máu mới. Tình trạng này khiến bạn mệt mỏi, dễ bị nhiễm trùng và chảy máu không kiểm soát. Một tình trạng hiếm gặp và nghiêm trọng, thi', n.prognosis = 'Không được điều trị, thiếu máu bất sản trầm trọng dẫn đến tử vong nhanh chóng. Ghép tủy xương có thể rất thành công ở những người trẻ tuổi. Cấy ghép cũng được sử dụng ở người lớn tuổi hoặc khi bệnh tá', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn hoặc đến phòng cấp cứu nếu chảy máu xảy ra mà không có lý do hoặc nếu chảy máu khó cầm. Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn ';
MERGE (n:Disease {id: 'D0213'}) SET n.id = 'D0213', n.name = 'Ngưng thở khi sinh non', n.name_en = 'Apnea of prematurity', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007227.htm', n.prognosis = 'Ngưng thở là hiện tượng thường gặp ở trẻ sinh non. Ngưng thở nhẹ dường như không có tác dụng lâu dài. Tuy nhiên, ngăn ngừa nhiều đợt hoặc đợt bệnh nghiêm trọng sẽ tốt hơn cho em bé về lâu dài. Chứng n';
MERGE (n:Disease {id: 'D0214'}) SET n.id = 'D0214', n.name = 'Cắt ruột thừa', n.name_en = 'Appendectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002921.htm', n.overview = 'Ruột thừa là một cơ quan nhỏ hình ngón tay, phân nhánh từ phần đầu tiên của ruột già (đại tràng). Khi nó bị sưng (viêm) hoặc bị nhiễm trùng, tình trạng này được gọi là viêm ruột thừa. Khi bạn bị viêm ';
MERGE (n:Disease {id: 'D0215'}) SET n.id = 'D0215', n.name = 'Viêm ruột thừa', n.name_en = 'Appendicitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/appendicitis/symptoms-causes/syc-20369543 | https://medlineplus.gov/ency/article/000256.htm', n.overview = 'xuất phát từ ruột kết. Viêm ruột thừa xảy ra khi ruột thừa bị viêm và chứa đầy mủ. Viêm ruột thừa là tình trạng viêm ruột thừa. Ruột thừa là một túi hình ngón tay nhô ra từ đại tràng ở phía dưới bên p', n.prognosis = 'Hầu hết mọi người đều hồi phục nhanh chóng sau phẫu thuật nếu ruột thừa được cắt bỏ trước khi nó vỡ. Nếu ruột thừa của bạn bị vỡ trước khi phẫu thuật, quá trình hồi phục có thể mất nhiều thời gian hơn', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn hoặc con bạn có các triệu chứng. Đau bụng khủng khiếp cần được chăm sóc y tế ngay lập tức. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho y';
MERGE (n:Disease {id: 'D0216'}) SET n.id = 'D0216', n.name = 'Ung thư ruột thừa', n.name_en = 'Appendix cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/appendix-cancer/symptoms-causes/syc-20593402', n.overview = 'Phụ lục phần đầu tiên của ruột già. Ung thư ruột thừa là một loại ung thư hiếm gặp bắt đầu khi các tế bào trong ruột thừa phát triển ngoài tầm kiểm soát. Ruột thừa là một túi nhỏ gắn vào phần đầu tiên', n.when_to_see = 'Vì những triệu chứng này có thể do nhiều vấn đề sức khỏe khác gây ra nên điều quan trọng là bạn phải nói chuyện với chuyên gia chăm sóc sức khỏe nếu các triệu chứng kéo dài hơn một vài ngày hoặc có vẻ';
MERGE (n:Disease {id: 'D0217'}) SET n.id = 'D0217', n.name = 'Sự thèm ăn - giảm', n.name_en = 'Appetite - decreased', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003121.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn giảm hơn 10 pound hoặc 4,5 kg (kg) mà không cần cố gắng. Tìm kiếm sự trợ giúp y tế nếu tình trạng giảm cảm giác thèm ăn xảy ra cùng v';
MERGE (n:Disease {id: 'D0218'}) SET n.id = 'D0218', n.name = 'Cảm giác thèm ăn - tăng', n.name_en = 'Appetite - increased', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003134.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn tăng cảm giác thèm ăn dai dẳng không rõ nguyên nhân Bạn có các triệu chứng khác không giải thích được';
MERGE (n:Disease {id: 'D0219'}) SET n.id = 'D0219', n.name = 'Thích hợp với tuổi thai (AGA)', n.name_en = 'Appropriate for gestational age (AGA)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002225.htm', n.overview = 'Tuổi thai là thuật ngữ phổ biến được sử dụng trong thời kỳ mang thai để mô tả khoảng thời gian của thai kỳ. Nó được tính bằng tuần, từ ngày đầu tiên của chu kỳ kinh nguyệt cuối cùng của người phụ nữ đ';
MERGE (n:Disease {id: 'D0220'}) SET n.id = 'D0220', n.name = 'Apraxia', n.name_en = 'Apraxia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007472.htm', n.prognosis = 'Nhiều người mắc chứng apraxia không còn khả năng độc lập và có thể gặp khó khăn khi thực hiện các công việc hàng ngày. Hỏi nhà cung cấp dịch vụ chăm sóc sức khỏe những hoạt động nào có thể an toàn hoặ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp nếu ai đó gặp khó khăn khi thực hiện các công việc hàng ngày hoặc có các triệu chứng mất điều hòa động lực khác sau đột quỵ hoặc chấn thương não.';
MERGE (n:Disease {id: 'D0221'}) SET n.id = 'D0221', n.name = 'Arachnodactyly', n.name_en = 'Arachnodactyly', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003288.htm', n.when_to_see = 'Một số trẻ sinh ra với arachnodactyly. Nó có thể trở nên rõ ràng hơn theo thời gian. Nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có những ngón tay dài và thon và bạn lo n';
MERGE (n:Disease {id: 'D0222'}) SET n.id = 'D0222', n.name = 'ARDS', n.name_en = 'ARDS', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ards/symptoms-causes/syc-20355576', n.overview = 'Hội chứng suy hô hấp cấp tính (ARDS) xảy ra khi phổi sưng tấy khiến chất lỏng tích tụ trong các túi khí nhỏ đàn hồi trong phổi. Những túi khí này, được gọi là phế nang, có màng bảo vệ, nhưng sưng phổi', n.when_to_see = 'ARDS thường xảy ra sau một căn bệnh hoặc chấn thương nặng và hầu hết những người mắc ARDS đều đã nhập viện. Nhưng nếu bạn có các triệu chứng của ARDS và không ở cơ sở y tế, hãy đến ngay phòng cấp cứu ';
MERGE (n:Disease {id: 'D0223'}) SET n.id = 'D0223', n.name = 'Khối u ở nách', n.name_en = 'Armpit lump', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003099.htm', n.when_to_see = 'Khối u ở nách ở phụ nữ có thể là dấu hiệu của ung thư vú và cần được bác sĩ kiểm tra ngay. Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có một khối u ở nách không rõ nguyên nhân. Đừng cố gắng tự m';
MERGE (n:Disease {id: 'D0224'}) SET n.id = 'D0224', n.name = 'Chứng loạn nhịp tim', n.name_en = 'Arrhythmias', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001101.htm', n.prognosis = 'Kết quả phụ thuộc vào một số yếu tố: Loại rối loạn nhịp tim mà bạn mắc phải. Cho dù bạn có bệnh động mạch vành, suy tim hay bệnh van tim.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn phát triển bất kỳ triệu chứng nào của chứng rối loạn nhịp tim có thể xảy ra. Bạn đã được chẩn đoán mắc chứng rối loạn nhịp tim và các triệu chứng ';
MERGE (n:Disease {id: 'D0225'}) SET n.id = 'D0225', n.name = 'Thuyên tắc động mạch', n.name_en = 'Arterial embolism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001102.htm', n.prognosis = 'Tình trạng của một người tốt như thế nào tùy thuộc vào vị trí của cục máu đông và mức độ cục máu đông làm tắc nghẽn dòng máu cũng như tình trạng tắc nghẽn đã tồn tại trong bao lâu. Thuyên tắc động mạc', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn có các triệu chứng của tắc mạch động mạch.';
MERGE (n:Disease {id: 'D0226'}) SET n.id = 'D0226', n.name = 'Suy động mạch', n.name_en = 'Arterial insufficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000725.htm';
MERGE (n:Disease {id: 'D0227'}) SET n.id = 'D0227', n.name = 'Xơ cứng động mạch / xơ vữa động mạch', n.name_en = 'Arteriosclerosis / atherosclerosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/arteriosclerosis-atherosclerosis/symptoms-causes/syc-20350569', n.overview = 'Xơ cứng động mạch và xơ vữa động mạch đôi khi được dùng với nghĩa tương tự. Nhưng có một sự khác biệt giữa hai điều khoản. Xơ cứng động mạch xảy ra khi các mạch máu mang oxy và chất dinh dưỡng từ tim ', n.when_to_see = 'Nếu bạn cho rằng mình bị xơ vữa động mạch, hãy hẹn khám sức khỏe. Chẩn đoán và điều trị sớm có thể ngăn chặn tình trạng xơ vữa động mạch trở nên tồi tệ hơn. Điều trị có thể ngăn ngừa cơn đau tim, đột ';
MERGE (n:Disease {id: 'D0228'}) SET n.id = 'D0228', n.name = 'Rò động tĩnh mạch', n.name_en = 'Arteriovenous fistula', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/arteriovenous-fistula/symptoms-causes/syc-20369567', n.overview = 'Lỗ rò động tĩnh mạch (AV) là sự kết nối không đều giữa động mạch và tĩnh mạch. Thông thường, máu chảy từ động mạch đến các mạch máu nhỏ (mao mạch), rồi đến tĩnh mạch. Chất dinh dưỡng và oxy trong máu ', n.when_to_see = 'Nếu bạn có các dấu hiệu và triệu chứng của lỗ rò động tĩnh mạch, hãy hẹn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Việc phát hiện sớm lỗ rò động tĩnh mạch có thể giúp điều trị bệnh dễ dàng h';
MERGE (n:Disease {id: 'D0229'}) SET n.id = 'D0229', n.name = 'Dị dạng động tĩnh mạch', n.name_en = 'Arteriovenous malformation', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/arteriovenous-malformation/symptoms-causes/syc-20350544', n.overview = 'Lưu lượng máu AVM AVM, máu truyền nhanh từ động mạch đến tĩnh mạch, làm gián đoạn lưu lượng máu thông thường và làm mất oxy của các mô xung quanh. Dị dạng động tĩnh mạch, còn được gọi là AVM, là tình ', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế nếu bạn có bất kỳ triệu chứng nào của AVM, chẳng hạn như đau đầu, chóng mặt, các vấn đề về thị lực, co giật và thay đổi suy nghĩ. Nhiều AVM được tìm thấy trong quá trình ';
MERGE (n:Disease {id: 'D0230'}) SET n.id = 'D0230', n.name = 'Viêm khớp', n.name_en = 'Arthritis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/arthritis/symptoms-causes/syc-20350772 | https://medlineplus.gov/ency/article/001243.htm', n.overview = 'Viêm xương khớp so với viêm khớp dạng thấp viêm xương khớp Viêm xương khớp, dạng viêm khớp phổ biến nhất, liên quan đến việc sụn bao bọc xương trong các khớp bị mòn đi. Viêm khớp dạng thấp là tình trạ', n.prognosis = 'Một số rối loạn liên quan đến viêm khớp có thể được chữa khỏi hoàn toàn nếu điều trị thích hợp. Tuy nhiên, nhiều rối loạn trong số này trở thành vấn đề sức khỏe lâu dài (mãn tính) nhưng thường có thể ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Cơn đau khớp của bạn kéo dài hơn 3 ngày. Bạn bị đau khớp nghiêm trọng không rõ nguyên nhân. Khớp bị ảnh hưởng sưng lên đáng kể. Bạn gặp khó khăn khi d';
MERGE (n:Disease {id: 'D0231'}) SET n.id = 'D0231', n.name = 'Cơ vòng tiết niệu nhân tạo', n.name_en = 'Artificial urinary sphincter', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003983.htm', n.overview = 'Thủ tục này có thể được thực hiện khi bạn đang: Gây mê toàn thân . Bạn sẽ ngủ và không thể cảm thấy đau. Gây tê tủy sống. Bạn sẽ tỉnh nhưng sẽ không thể cảm nhận được bất cứ thứ gì bên dưới thắt lưng ', n.prognosis = 'Tình trạng rò rỉ nước tiểu giảm ở nhiều người thực hiện thủ thuật này. Tuy nhiên, vẫn có thể có một số rò rỉ. Theo thời gian, một số hoặc toàn bộ lượng rò rỉ có thể quay trở lại. Có thể mô niệu đạo bê';
MERGE (n:Disease {id: 'D0232'}) SET n.id = 'D0232', n.name = 'Bệnh bụi phổi amiăng', n.name_en = 'Asbestosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/asbestosis/symptoms-causes/syc-20354637 | https://medlineplus.gov/ency/article/000118.htm', n.overview = '(as-bes-TOE-sis) là một bệnh phổi mãn tính do hít phải sợi amiăng. Tiếp xúc kéo dài với những sợi này có thể gây sẹo mô phổi và khó thở. Các triệu chứng của bệnh bụi phổi amiăng có thể từ nhẹ đến nặng', n.prognosis = 'Kết quả phụ thuộc vào lượng amiăng bạn đã tiếp xúc và thời gian bạn tiếp xúc. Những người phát triển u trung biểu mô ác tính có xu hướng có kết quả kém.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu bạn nghi ngờ rằng bạn đã tiếp xúc với amiăng và bạn có vấn đề về hô hấp. Bị bệnh bụi phổi amiăng khiến bạn dễ bị nhiễm trùng phổi hơn. Nếu bạn được chẩn đoán mắc b';
MERGE (n:Disease {id: 'D0233'}) SET n.id = 'D0233', n.name = 'Bệnh giun đũa', n.name_en = 'Ascariasis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/ascariasis/symptoms-causes/syc-20369593 | https://medlineplus.gov/ency/article/000628.htm', n.overview = '(as-kuh-RIE-uh-sis) là một loại bệnh nhiễm giun đũa. Những con giun này là loài ký sinh sử dụng cơ thể làm vật chủ để trưởng thành từ trứng thành giun trưởng thành. Giun trưởng thành có thể dài hơn mộ', n.prognosis = 'Hầu hết mọi người đều hồi phục sau các triệu chứng nhiễm trùng, ngay cả khi không điều trị. Nhưng họ có thể tiếp tục mang giun trong cơ thể. Các biến chứng có thể do giun trưởng thành di chuyển đến mộ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của bệnh giun đũa, đặc biệt nếu bạn đã đi đến khu vực phổ biến bệnh này. Ngoài ra, hãy liên hệ với nhà cung cấ';
MERGE (n:Disease {id: 'D0234'}) SET n.id = 'D0234', n.name = 'Cổ trướng', n.name_en = 'Ascites', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/ascites/symptoms-causes/syc-20596724 | https://medlineplus.gov/ency/article/000286.htm', n.overview = 'xảy ra khi chất lỏng dư thừa tích tụ ở vùng bụng của bạn, gọi là bụng. Chất lỏng tích tụ trong khoang phúc mạc, đó là không gian xung quanh các cơ quan bụng của bạn. Sự tích tụ này có thể làm cho bụng', n.when_to_see = 'Nếu bạn bị cổ trướng, hãy liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu bạn bị: Sốt trên 100,5°F (38,05°C) hoặc sốt không biến mất Đau bụng Máu trong phân hoặc phân màu đen, hắc ín Máu trong chất ';
MERGE (n:Disease {id: 'D0235'}) SET n.id = 'D0235', n.name = 'Hội chứng Asherman', n.name_en = 'Asherman syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001483.htm', n.prognosis = 'Hội chứng Asherman thường có thể được chữa khỏi bằng phẫu thuật. Đôi khi sẽ cần nhiều hơn một thủ tục. Phụ nữ vô sinh do hội chứng Asherman có thể sinh con sau khi điều trị. Mang thai thành công phụ t', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Chu kỳ kinh nguyệt của bạn không quay trở lại sau phẫu thuật phụ khoa hoặc sản khoa. Bạn không thể mang thai sau 6 đến 12 tháng cố gắng (bác sĩ có thể';
MERGE (n:Disease {id: 'D0236'}) SET n.id = 'D0236', n.name = 'Axit aspartic', n.name_en = 'Aspartic acid', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002234.htm', n.overview = 'giúp mọi tế bào trong cơ thể hoạt động. Nó đóng vai trò trong: Sản xuất và giải phóng hormone Chức năng hệ thần kinh bình thường Nguồn axit aspartic thực vật bao gồm: Quả bơ Măng tây Mật đường Nguồn a';
MERGE (n:Disease {id: 'D0237'}) SET n.id = 'D0237', n.name = 'Aspergillosis', n.name_en = 'Aspergillosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/aspergillosis/symptoms-causes/syc-20369619 | https://medlineplus.gov/ency/article/001326.htm', n.overview = 'là một bệnh nhiễm trùng do một loại nấm mốc có tên là aspergillus gây ra. Nấm mốc Aspergillus là một loại nấm. Các bệnh do nhiễm aspergillosis thường ảnh hưởng đến hệ hô hấp. Tuy nhiên, các bệnh có th', n.prognosis = 'Khi được điều trị, những người mắc bệnh aspergillosis phế quản phổi dị ứng thường khỏi bệnh theo thời gian. Bệnh thường tái phát (tái phát) và cần điều trị lại. Nếu bệnh aspergillosis xâm lấn không th', n.when_to_see = 'Nếu bạn bị hen suyễn hoặc xơ nang, hãy gặp chuyên gia chăm sóc sức khỏe của bạn bất cứ khi nào bạn nhận thấy sự thay đổi trong nhịp thở của mình. Mặc dù aspergillosis có thể không phải là nguyên nhân ';
MERGE (n:Disease {id: 'D0238'}) SET n.id = 'D0238', n.name = 'Ngộ độc xi măng nhựa đường', n.name_en = 'Asphalt cement poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002752.htm', n.prognosis = 'Sức khoẻ của một người phụ thuộc vào lượng nhựa đường họ nuốt và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nhựa đường nóng nguội đi rất nhanh và khó bong ra kh';
MERGE (n:Disease {id: 'D0239'}) SET n.id = 'D0239', n.name = 'Viêm phổi do hít', n.name_en = 'Aspiration pneumonia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000121.htm', n.prognosis = 'Kết quả phụ thuộc vào: Sức khỏe của người đó trước khi bị viêm phổi Loại vi khuẩn gây viêm phổi Mức độ liên quan đến phổi Nhiễm trùng nặng hơn có thể dẫn đến tổn thương phổi lâu dài.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn, đến phòng cấp cứu hoặc gọi đến số cấp cứu tại địa phương (chẳng hạn như 911) nếu bạn bị: Đau ngực Ớn lạnh Sốt Khó thở Môi hoặc lưỡi đổi màu hơi xanh (tím tái) Thở';
MERGE (n:Disease {id: 'D0240'}) SET n.id = 'D0240', n.name = 'Quá liều Aspirin', n.name_en = 'Aspirin overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002542.htm', n.prognosis = 'Một liều aspirin độc hại là 200 đến 300 mg/kg (miligam trên mỗi kg trọng lượng cơ thể) và nếu nuốt phải 500 mg/kg có khả năng gây tử vong. Trong trường hợp quá liều mãn tính, nồng độ aspirin trong cơ ';
MERGE (n:Disease {id: 'D0241'}) SET n.id = 'D0241', n.name = 'Cơn hen suyễn', n.name_en = 'Asthma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/asthma/symptoms-causes/syc-20369653 | https://medlineplus.gov/ency/article/000141.htm', n.overview = 'tấn công vào phổi của bạn có thể bị viêm và sưng tấy. Ngoài ra, màng trong lớp lót đường thở của bạn có thể tiết ra chất nhầy dư thừa. Kết quả là một cơn hen suyễn. Trong cơn hen suyễn, đường thở bị t', n.prognosis = 'Không có cách chữa trị bệnh hen suyễn, mặc dù các triệu chứng đôi khi cải thiện theo thời gian, đặc biệt là ở trẻ em. Với việc tự chăm sóc và điều trị y tế đúng cách, hầu hết những người mắc bệnh hen ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn để lấy hẹn nếu các triệu chứng hen suyễn phát triển. Liên hệ với nhà cung cấp của bạn ngay lập tức nếu: Cơn hen suyễn cần nhiều thuốc hơn mức khuyến nghị Các triệu';
MERGE (n:Disease {id: 'D0242'}) SET n.id = 'D0242', n.name = 'Bệnh hen suyễn ở trẻ em', n.name_en = 'Asthma in children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000990.htm', n.prognosis = 'Nếu được điều trị thích hợp, hầu hết trẻ em mắc bệnh hen suyễn đều có thể sống một cuộc sống bình thường. Khi bệnh hen suyễn không được kiểm soát tốt, nó có thể dẫn đến việc phải nghỉ học, gặp khó khă', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu bạn cho rằng con mình có các triệu chứng hen suyễn mới. Nếu con bạn mới được chẩn đoán mắc bệnh hen suyễn, hãy liên hệ với nhà cu';
MERGE (n:Disease {id: 'D0243'}) SET n.id = 'D0243', n.name = 'Loạn thị', n.name_en = 'Astigmatism', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/astigmatism/symptoms-causes/syc-20353835 | https://medlineplus.gov/ency/article/001015.htm', n.overview = '(uh- STIG-muh-tiz-um) là một khiếm khuyết phổ biến và thường có thể điều trị được ở độ cong của mắt gây mờ khoảng cách và tầm nhìn gần. Loạn thị xảy ra khi bề mặt phía trước của mắt (giác mạc) hoặc th', n.prognosis = 'Loạn thị có thể thay đổi theo thời gian, cần phải đeo kính hoặc kính áp tròng mới. Điều chỉnh thị lực bằng laser thường có thể loại bỏ hoặc giảm đáng kể chứng loạn thị.', n.when_to_see = 'Hãy gặp bác sĩ nhãn khoa nếu các triệu chứng về mắt làm bạn mất hứng thú với các hoạt động hoặc cản trở khả năng thực hiện các công việc hàng ngày của bạn. Bác sĩ nhãn khoa có thể xác định xem bạn có ';
MERGE (n:Disease {id: 'D0244'}) SET n.id = 'D0244', n.name = 'U tế bào hình sao', n.name_en = 'Astrocytoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/astrocytoma/symptoms-causes/syc-20576675', n.overview = 'ở tủy sống. Nó bắt đầu trong các tế bào gọi là tế bào hình sao hỗ trợ các tế bào thần kinh. Một số u tế bào hình sao phát triển rất chậm và một số khác có thể là ung thư ác tính phát triển nhanh chóng', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có các triệu chứng liên tục khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0245'}) SET n.id = 'D0245', n.name = 'Vi khuẩn niệu không có triệu chứng', n.name_en = 'Asymptomatic bacteriuria', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000520.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn gặp: Khó làm sạch bàng quang Sốt Đau sườn hoặc đau lưng Đau khi đi tiểu Bạn sẽ cần được kiểm tra xem có bị nhiễm trùng bàng quang hoặc thận hay không.';
MERGE (n:Disease {id: 'D0246'}) SET n.id = 'D0246', n.name = 'Ataxia', n.name_en = 'Ataxia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ataxia/symptoms-causes/syc-20355652', n.overview = 'Tiểu não và thân não do tổn thương phần não kiểm soát sự phối hợp cơ bắp, được gọi là tiểu não. Ataxia mô tả khả năng kiểm soát cơ kém gây ra các cử động vụng về. Nó có thể ảnh hưởng đến việc đi lại v', n.when_to_see = 'Nếu bạn chưa mắc bệnh gây mất điều hòa, chẳng hạn như bệnh đa xơ cứng, hãy gặp chuyên gia chăm sóc sức khỏe của bạn càng sớm càng tốt nếu bạn: Mất thăng bằng. Mất sự phối hợp cơ ở tay, cánh tay hoặc c';
MERGE (n:Disease {id: 'D0247'}) SET n.id = 'D0247', n.name = 'Ataxia - telangiectasia', n.name_en = 'Ataxia - telangiectasia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001394.htm', n.prognosis = 'Cái chết sớm là phổ biến, nhưng tuổi thọ lại khác nhau. Bởi vì những người mắc bệnh này rất nhạy cảm với bức xạ nên họ không bao giờ được xạ trị và không nên chụp X-quang khi không cần thiết.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn phát triển các triệu chứng của chứng rối loạn này.';
MERGE (n:Disease {id: 'D0248'}) SET n.id = 'D0248', n.name = 'Xẹp phổi', n.name_en = 'Atelectasis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/atelectasis/symptoms-causes/syc-20369684 | https://medlineplus.gov/ency/article/000065.htm', n.overview = '(at-uh-LEK-tuh-sis) là tình trạng xẹp phổi hoặc một phần phổi, còn gọi là thùy phổi. Nó xảy ra khi các túi khí nhỏ trong phổi, gọi là phế nang, bị mất không khí. Xẹp phổi là một trong những biến chứng', n.prognosis = 'Ở người trưởng thành, tình trạng xẹp phổi ở một vùng nhỏ của phổi thường không đe dọa đến tính mạng. Phần còn lại của phổi có thể bù đắp cho vùng bị xẹp, mang đủ oxy cho cơ thể hoạt động. Các vùng xẹp', n.when_to_see = 'Luôn được chăm sóc y tế ngay lập tức nếu bạn khó thở. Các tình trạng khác ngoài xẹp phổi có thể gây khó thở, vì vậy điều quan trọng là phải được chẩn đoán và điều trị đúng. Nếu hơi thở của bạn đột nhi';
MERGE (n:Disease {id: 'D0249'}) SET n.id = 'D0249', n.name = 'Bệnh thận do xơ vữa động mạch', n.name_en = 'Atheroembolic renal disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000480.htm';
MERGE (n:Disease {id: 'D0250'}) SET n.id = 'D0250', n.name = 'Xơ vữa động mạch', n.name_en = 'Atherosclerosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000171.htm', n.prognosis = 'Chứng xơ vữa động mạch không thể phục hồi một khi nó đã xảy ra. Tuy nhiên, thay đổi lối sống và điều trị mức cholesterol cao có thể ngăn ngừa hoặc làm chậm quá trình trở nên tồi tệ hơn. Điều này có th';
MERGE (n:Disease {id: 'D0251'}) SET n.id = 'D0251', n.name = 'Bệnh nấm bàn chân', n.name_en = 'Athlete\'s foot', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/athletes-foot/symptoms-causes/syc-20353841 | https://medlineplus.gov/ency/article/000875.htm', n.overview = ', còn gọi là nấm bàn chân, là một bệnh nhiễm trùng da do nấm gây ra. Nó thường bắt đầu giữa các ngón chân. Tình trạng này có thể xảy ra khi bàn chân bị nóng và đổ mồ hôi khi đi giày kín. Các dấu hiệu ', n.prognosis = 'Bàn chân của vận động viên hầu như luôn phản ứng tốt với việc tự chăm sóc, mặc dù bệnh có thể quay trở lại. Có thể cần dùng thuốc dài hạn và các biện pháp phòng ngừa. Nhiễm trùng có thể lan đến móng c', n.when_to_see = 'Vận động viên để chân ở một bên bàn chân gây ra tình trạng da khô, bong vảy ở lòng bàn chân và hai bên bàn chân. Nếu bạn bị phát ban ở bàn chân mà không cải thiện sau hai tuần sử dụng kem chống nấm mà';
MERGE (n:Disease {id: 'D0252'}) SET n.id = 'D0252', n.name = 'Viêm da dị ứng', n.name_en = 'Atopic dermatitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000853.htm', n.prognosis = 'Viêm da dị ứng có thể kéo dài. Bạn có thể cải thiện các triệu chứng của bệnh bằng cách điều trị, tránh các chất gây kích ứng và giữ ẩm tốt cho làn da. Ở trẻ em, tình trạng này thường bắt đầu biến mất ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Viêm da dị ứng không thuyên giảm khi chăm sóc tại nhà Các triệu chứng trở nên nặng hơn hoặc việc điều trị không hiệu quả Bạn có dấu hiệu nhiễm trùng (';
MERGE (n:Disease {id: 'D0253'}) SET n.id = 'D0253', n.name = 'Viêm da dị ứng (eczema)', n.name_en = 'Atopic dermatitis (eczema)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/atopic-dermatitis-eczema/symptoms-causes/syc-20353273', n.overview = 'Viêm da dị ứng phía sau đầu gối có thể gây phát ban rất ngứa. Viêm da dị ứng thường xảy ra ở những nơi da bị uốn cong - bên trong khuỷu tay, phía sau đầu gối và phía trước cổ. Viêm da dị ứng (eczema) ', n.when_to_see = 'Hãy trao đổi với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn hoặc con bạn: Có các triệu chứng viêm da dị ứng Khó chịu đến mức tình trạng này ảnh hưởng đến giấc ngủ và hoạt động hàng ngày Bị nhiễm t';
MERGE (n:Disease {id: 'D0254'}) SET n.id = 'D0254', n.name = 'Rung nhĩ', n.name_en = 'Atrial fibrillation', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/atrial-fibrillation/symptoms-causes/syc-20350624', n.overview = 'rối loạn ythm. Trong một trái tim điển hình, một nhóm tế bào gọi là nút xoang sẽ gửi tín hiệu điện để bắt đầu mỗi nhịp tim. Các tín hiệu đi qua buồng tim phía trên đến nút AV, nơi chúng thường chậm lạ', n.when_to_see = 'Nếu bạn có triệu chứng rung nhĩ hãy đặt lịch hẹn khám sức khỏe nhé. Bạn có thể được giới thiệu đến một bác sĩ được đào tạo về bệnh tim, được gọi là bác sĩ tim mạch. Nếu bạn bị đau ngực, hãy nhận trợ g';
MERGE (n:Disease {id: 'D0255'}) SET n.id = 'D0255', n.name = 'Rung tâm nhĩ và cuồng nhĩ', n.name_en = 'Atrial fibrillation and atrial flutter', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000184.htm', n.prognosis = 'Việc điều trị thường có thể kiểm soát được chứng rối loạn này. Nhiều người bị AFib điều trị rất tốt. AFib có xu hướng quay trở lại và nặng hơn. Nó có thể quay trở lại ở một số người, ngay cả khi được ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng của AFib hoặc rung.';
MERGE (n:Disease {id: 'D0256'}) SET n.id = 'D0256', n.name = 'Cuồng nhĩ', n.name_en = 'Atrial flutter', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/atrial-flutter/symptoms-causes/syc-20352586', n.overview = 'Các buồng trên của tim, gọi là tâm nhĩ, đập quá nhanh. Rung tâm nhĩ là một loại rối loạn nhịp tim, được gọi là rối loạn nhịp tim. Nó tương tự như rung tâm nhĩ (AFib). Nhưng trong rung tâm nhĩ, nhịp ti', n.when_to_see = 'Nếu bạn cảm thấy tim mình đập thình thịch, rung rinh, lỡ nhịp hoặc đập quá nhanh, hãy hẹn khám sức khỏe. Bạn có thể được yêu cầu gặp bác sĩ được đào tạo về bệnh tim, được gọi là bác sĩ tim mạch. Nhận ';
MERGE (n:Disease {id: 'D0257'}) SET n.id = 'D0257', n.name = 'U nhầy nhĩ', n.name_en = 'Atrial myxoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007273.htm', n.prognosis = 'Trong hầu hết các trường hợp, phẫu thuật có thể loại bỏ u nhầy thành công. Hiếm khi khối u có thể quay trở lại sau vài năm. Nhà cung cấp dịch vụ của bạn có thể sẽ đề nghị theo dõi thường xuyên để kiểm';
MERGE (n:Disease {id: 'D0258'}) SET n.id = 'D0258', n.name = 'Thông liên nhĩ (ASD)', n.name_en = 'Atrial septal defect (ASD)', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/atrial-septal-defect/symptoms-causes/syc-20369715 | https://medlineplus.gov/ency/article/000157.htm', n.overview = 'Thông liên nhĩ (ASD) là một bệnh tim bẩm sinh. Điều đó có nghĩa đó là khuyết tật tim bẩm sinh. Những người mắc ASD có một lỗ giữa các buồng tim phía trên. Lỗ này làm tăng lượng máu đi qua phổi. Thông ', n.prognosis = 'Ở trẻ sơ sinh, ASD nhỏ (dưới 5 mm) thường không gây ra vấn đề gì hoặc sẽ đóng lại mà không cần điều trị. ASD lớn hơn (8 đến 10 mm), thường không đóng được và có thể cần sửa chữa. Các yếu tố quan trọng', n.when_to_see = 'Dị tật tim bẩm sinh nghiêm trọng thường được chẩn đoán trước hoặc ngay sau khi trẻ chào đời. Nhận trợ giúp khẩn cấp ngay lập tức nếu trẻ khó thở. Gọi cho chuyên gia chăm sóc sức khỏe nếu những triệu c';
MERGE (n:Disease {id: 'D0259'}) SET n.id = 'D0259', n.name = 'Nhịp tim nhanh nhĩ', n.name_en = 'Atrial tachycardia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/atrial-tachycardia/symptoms-causes/syc-20573298', n.overview = 'là nhịp tim không đều, được gọi là rối loạn nhịp tim. Đó là một loại nhịp tim nhanh trên thất. Trong cơn nhịp nhanh nhĩ, tim đập hơn 100 lần một phút. Sau đó, nhịp tim trở lại khoảng 60 đến 80 nhịp mộ', n.when_to_see = 'Các triệu chứng của nhịp nhanh nhĩ có thể liên quan đến tình trạng sức khỏe nghiêm trọng. Gọi 911 hoặc số khẩn cấp tại địa phương nếu bạn có nhịp tim rất nhanh kéo dài hơn vài phút hoặc nếu nhịp tim n';
MERGE (n:Disease {id: 'D0260'}) SET n.id = 'D0260', n.name = 'Thông liên nhĩ thất', n.name_en = 'Atrioventricular canal defect', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/atrioventricular-canal-defect/symptoms-causes/syc-20361492', n.overview = 'Thông liên nhĩ thất là sự kết hợp của nhiều vấn đề ảnh hưởng đến trung tâm tim. Bệnh tim có sẵn từ khi sinh ra. Điều đó có nghĩa đó là khuyết tật tim bẩm sinh. Trẻ sinh ra với tình trạng này có một lỗ';
MERGE (n:Disease {id: 'D0261'}) SET n.id = 'D0261', n.name = 'Nhịp tim nhanh vào lại nút nhĩ thất (AVNRT)', n.name_en = 'Atrioventricular nodal reentry tachycardia (AVNRT)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/avnrt/symptoms-causes/syc-20573830', n.overview = 'là một loại nhịp tim không đều, còn được gọi là rối loạn nhịp tim. Đây là loại nhịp tim nhanh trên thất (SVT) phổ biến nhất. Những người bị AVNRT có nhịp tim rất nhanh, thường bắt đầu và kết thúc đột ', n.when_to_see = 'Hãy hẹn khám sức khỏe nếu bạn có những thay đổi không rõ nguyên nhân trong nhịp tim. Đồng thời, hãy đến gặp chuyên gia chăm sóc sức khỏe nếu trẻ sơ sinh hoặc trẻ nhỏ có các triệu chứng sau: Nhịp tim n';
MERGE (n:Disease {id: 'D0262'}) SET n.id = 'D0262', n.name = 'Rối loạn tăng động giảm chú ý', n.name_en = 'Attention deficit hyperactivity disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001551.htm', n.prognosis = 'ADHD là một tình trạng lâu dài. ADHD có thể dẫn đến: Sử dụng ma túy bất hợp pháp và lạm dụng rượu Học kém ở trường Khó duy trì công việc Rắc rối với pháp luật Một phần ba đến một nửa số trẻ mắc ADHD c', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn hoặc giáo viên của con bạn nghi ngờ có ADHD. Bạn cũng nên nói với nhà cung cấp của mình về: Các vấn đề ở nhà, trường học và với bạn bè Tác dụng phụ của thu';
MERGE (n:Disease {id: 'D0263'}) SET n.id = 'D0263', n.name = 'Rối loạn tăng động/giảm chú ý (ADHD) ở trẻ em', n.name_en = 'Attention-deficit/hyperactivity disorder (ADHD) in children', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/adhd/symptoms-causes/syc-20350889', n.overview = 'Rối loạn tăng động giảm chú ý, còn gọi là ADHD, là một tình trạng lâu dài ảnh hưởng đến hàng triệu trẻ em. Nó thường tiếp tục đến tuổi trưởng thành. ADHD bao gồm nhiều vấn đề đang diễn ra. Những điều ', n.when_to_see = 'Nếu bạn lo lắng rằng con mình có dấu hiệu mắc chứng ADHD, hãy đến gặp bác sĩ nhi khoa hoặc chuyên gia chăm sóc sức khỏe gia đình. Chuyên gia chăm sóc sức khỏe của bạn có thể thực hiện đánh giá y tế để';
MERGE (n:Disease {id: 'D0264'}) SET n.id = 'D0264', n.name = 'Cơ quan sinh dục không điển hình', n.name_en = 'Atypical genitalia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/atypical-genitalia/symptoms-causes/syc-20369273', n.overview = ', trước đây gọi là cơ quan sinh dục mơ hồ, là một tình trạng hiếm gặp trong đó bộ phận sinh dục của trẻ sơ sinh nhìn bề ngoài không rõ ràng là nam hay nữ. Ở trẻ có cơ quan sinh dục không điển hình, bộ';
MERGE (n:Disease {id: 'D0265'}) SET n.id = 'D0265', n.name = 'Tăng sản không điển hình của vú', n.name_en = 'Atypical hyperplasia of the breast', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/atypical-hyperplasia/symptoms-causes/syc-20369773', n.overview = 'Vấn đề về giải phẫu vú, sắp xếp giống như những cánh hoa cúc. Các thùy lại được chia thành các thùy nhỏ hơn để sản xuất sữa cho con bú. Những ống nhỏ, gọi là ống dẫn, dẫn sữa đến một bể chứa nằm ngay ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với thông tin được gửi cho yêu cầu này.
 Xem lại/cập nhật ';
MERGE (n:Disease {id: 'D0266'}) SET n.id = 'D0266', n.name = 'Viêm phổi không điển hình', n.name_en = 'Atypical pneumonia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000079.htm', n.prognosis = 'Hầu hết những người bị viêm phổi do mycoplasma hoặc chlamydia đều khỏi bệnh khi dùng đúng loại kháng sinh. Viêm phổi Legionella có thể nghiêm trọng. Nó có thể dẫn đến các vấn đề, thường gặp nhất ở nhữ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị sốt, ho hoặc khó thở. Có nhiều nguyên nhân gây ra những triệu chứng này. Nhà cung cấp sẽ cần kiểm tra bệnh viêm phổi. Ngoài ra, hãy liên hệ với ';
MERGE (n:Disease {id: 'D0267'}) SET n.id = 'D0267', n.name = 'Khối u hình thoi quái thai không điển hình (ATRT)', n.name_en = 'Atypical teratoid rhabdoid tumor (ATRT)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/atypical-teratoid-rhabdoid-brain-tumor/symptoms-causes/syc-20593005', n.overview = 'là một loại ung thư rất hiếm gặp, phát triển nhanh, bắt đầu từ não hoặc tủy sống. Đó là một loại ung thư của khối u não. Khối u ung thư còn được gọi là khối u ác tính. Tổ chức Y tế Thế giới (WHO) phân';
MERGE (n:Disease {id: 'D0268'}) SET n.id = 'D0268', n.name = 'Rối loạn xử lý thính giác (APD)', n.name_en = 'Auditory processing disorder (APD)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/auditory-processing-disorder/symptoms-causes/syc-20555261', n.overview = 'Rối loạn xử lý thính giác, còn được gọi là APD, là một loại mất thính giác do có điều gì đó ảnh hưởng đến phần não xử lý cách bạn nghe. Tổn thương tai gây ra các loại mất thính lực khác. APD đôi khi c', n.when_to_see = 'Nếu bạn gặp khó khăn khi nghe hoặc hiểu những gì bạn nghe thấy, hãy nói chuyện với chuyên gia chăm sóc sức khỏe. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0269'}) SET n.id = 'D0269', n.name = 'Polyp tai', n.name_en = 'Aural polyps', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001638.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị đau dữ dội, chảy máu từ tai hoặc thính lực giảm mạnh.';
MERGE (n:Disease {id: 'D0270'}) SET n.id = 'D0270', n.name = 'Thính chẩn', n.name_en = 'Auscultation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002226.htm', n.overview = 'thường được thực hiện bằng cách sử dụng một công cụ gọi là ống nghe. Các nhà cung cấp dịch vụ chăm sóc sức khỏe thường xuyên lắng nghe phổi, tim và ruột của một người để đánh giá những điều sau về âm ';
MERGE (n:Disease {id: 'D0271'}) SET n.id = 'D0271', n.name = 'Rối loạn phổ tự kỷ', n.name_en = 'Autism spectrum disorder', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/autism-spectrum-disorder/symptoms-causes/syc-20352928 | https://medlineplus.gov/ency/article/001526.htm', n.overview = 'là một tình trạng liên quan đến sự phát triển của não bộ, ảnh hưởng đến cách mọi người nhìn nhận người khác và giao tiếp với họ. Điều này gây ra vấn đề trong giao tiếp và hòa hợp với những người khác ', n.prognosis = 'Với cách điều trị phù hợp, nhiều triệu chứng ASD có thể được cải thiện. Hầu hết những người mắc ASD đều có một số triệu chứng trong suốt cuộc đời của họ. Tuy nhiên, họ có thể sống cùng gia đình hoặc t', n.when_to_see = 'Trẻ sơ sinh phát triển theo tốc độ riêng của chúng và nhiều trẻ không tuân theo các mốc thời gian chính xác được tìm thấy trong một số cuốn sách nuôi dạy con cái. Nhưng trẻ mắc chứng rối loạn phổ tự k';
MERGE (n:Disease {id: 'D0272'}) SET n.id = 'D0272', n.name = 'Các bệnh tự miễn dịch', n.name_en = 'Autoimmune diseases', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000816.htm', n.prognosis = 'Kết quả tùy thuộc vào bệnh. Hầu hết các bệnh tự miễn là mãn tính, nhưng nhiều bệnh có thể được kiểm soát bằng điều trị. Các triệu chứng của bệnh tự miễn có thể đến và đi. Khi các triệu chứng trở nên t', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của bệnh tự miễn.';
MERGE (n:Disease {id: 'D0273'}) SET n.id = 'D0273', n.name = 'Viêm não tự miễn', n.name_en = 'Autoimmune encephalitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/autoimmune-encephalitis/symptoms-causes/syc-20576380', n.overview = '(en-sef-uh-LIE-tis) là một nhóm các tình trạng gây sưng não. Điều này xảy ra do hệ thống miễn dịch tấn công nhầm vào các tế bào não. Các triệu chứng viêm não tự miễn có thể khác nhau nhưng có thể bao ', n.when_to_see = 'Nhận chăm sóc y tế khẩn cấp nếu bạn hoặc ai đó ở cùng bạn có các triệu chứng nghiêm trọng của AE. Điều này bao gồm các cơn co giật kéo dài hơn năm phút hoặc xảy ra lần lượt dẫn đến mất ý thức. Đồng th';
MERGE (n:Disease {id: 'D0274'}) SET n.id = 'D0274', n.name = 'Động kinh tự miễn', n.name_en = 'Autoimmune epilepsy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/autoimmune-epilepsy/symptoms-causes/syc-20576892', n.overview = 'là một loại động kinh trong đó các cơn động kinh xảy ra do hệ thống miễn dịch tấn công nhầm vào các tế bào não. Nó có thể xảy ra với các tình trạng ảnh hưởng đến hệ thống miễn dịch, đặc biệt là viêm n', n.when_to_see = 'Nhận dịch vụ chăm sóc y tế khẩn cấp nếu bạn hoặc người đi cùng bạn bị động kinh kéo dài hơn năm phút hoặc nếu các cơn động kinh xảy ra lần lượt kèm theo mất ý thức. Đồng thời tìm kiếm sự chăm sóc y tế';
MERGE (n:Disease {id: 'D0275'}) SET n.id = 'D0275', n.name = 'Viêm gan tự miễn', n.name_en = 'Autoimmune hepatitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/autoimmune-hepatitis/symptoms-causes/syc-20352153 | https://medlineplus.gov/ency/article/000245.htm', n.overview = 'là một bệnh về gan xảy ra khi hệ thống miễn dịch của cơ thể tấn công gan. Điều này có thể gây sưng, kích ứng và tổn thương gan. Nguyên nhân chính xác của bệnh viêm gan tự miễn vẫn chưa rõ ràng, nhưng ', n.prognosis = 'Kết quả sẽ khác nhau. Corticosteroid và các loại thuốc khác có thể làm chậm sự tiến triển của bệnh. Tuy nhiên, viêm gan tự miễn có thể tiến triển thành xơ gan. Điều này có thể yêu cầu ghép gan.', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0276'}) SET n.id = 'D0276', n.name = 'Viêm tụy tự miễn', n.name_en = 'Autoimmune pancreatitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/autoimmune-pancreatitis/symptoms-causes/syc-20369800', n.overview = 'là tình trạng viêm ở tuyến tụy. Nó có thể được gây ra bởi hệ thống miễn dịch tấn công tuyến tụy. Viêm tụy tự miễn còn được gọi là AIP. Hai loại AIP hiện đã được công nhận, loại 1 và loại 2. AIP loại 1', n.when_to_see = 'Viêm tụy tự miễn thường không gây ra bất kỳ triệu chứng nào. Tuy nhiên, hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn sụt cân không rõ nguyên nhân, đau bụng, vàng da hoặc các triệu chứng khác làm phiền';
MERGE (n:Disease {id: 'D0277'}) SET n.id = 'D0277', n.name = 'Các bệnh tự viêm', n.name_en = 'Autoinflammatory diseases', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007845.htm', n.prognosis = 'Hầu hết SAID đều là mãn tính, nhưng các triệu chứng có thể được kiểm soát bằng cách điều trị. Kết quả phụ thuộc vào loại bệnh và các cơ quan bị ảnh hưởng. Hầu hết những người bị SAID cần điều trị lâu ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc con bạn bị sốt liên tục không rõ nguyên nhân, phát ban trên da, viêm hoặc đau khớp mà không rõ nguyên nhân.';
MERGE (n:Disease {id: 'D0278'}) SET n.id = 'D0278', n.name = 'Ngộ độc xà phòng máy rửa chén tự động', n.name_en = 'Automatic dishwasher soap poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002729.htm', n.prognosis = 'Most cases of swallowing dishwasher soap are not that harmful. Sức khoẻ của một người phụ thuộc vào lượng chất độc được nuốt vào và tốc độ điều trị được tiếp nhận như thế nào. Một người nhận được trợ ';
MERGE (n:Disease {id: 'D0279'}) SET n.id = 'D0279', n.name = 'Chứng khó phản xạ tự động', n.name_en = 'Autonomic dysreflexia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001431.htm', n.prognosis = 'Outlook tùy thuộc vào nguyên nhân. Những người bị rối loạn chức năng tự chủ do dùng một loại thuốc thường hồi phục khi ngừng dùng thuốc đó. Khi AD bị trầm trọng hơn bởi các yếu tố khác, khả năng phục ', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn có các triệu chứng của AD.';
MERGE (n:Disease {id: 'D0280'}) SET n.id = 'D0280', n.name = 'Bệnh thần kinh tự trị', n.name_en = 'Autonomic neuropathy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/autonomic-neuropathy/symptoms-causes/syc-20369829 | https://medlineplus.gov/ency/article/000776.htm', n.overview = 'xảy ra khi có tổn thương ở các dây thần kinh kiểm soát các chức năng tự động của cơ thể. Nó có thể ảnh hưởng đến huyết áp, kiểm soát nhiệt độ, tiêu hóa, chức năng bàng quang và thậm chí cả chức năng t', n.prognosis = 'Bạn làm tốt như thế nào sẽ phụ thuộc vào nguyên nhân của vấn đề và liệu nó có thể được điều trị hay không.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng của bệnh thần kinh tự trị. Các triệu chứng ban đầu có thể bao gồm: Ngất xỉu hoặc choáng váng khi đứng Thay đổi chức năng ruột, bàng quang ho';
MERGE (n:Disease {id: 'D0281'}) SET n.id = 'D0281', n.name = 'Gen nhiễm sắc thể thường trội', n.name_en = 'Autosomal dominant', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002049.htm', n.overview = 'Di truyền một bệnh, tình trạng hoặc đặc điểm phụ thuộc vào loại nhiễm sắc thể bị ảnh hưởng (nhiễm sắc thể không giới tính hoặc giới tính). Nó còn phụ thuộc vào tính trạng đó là trội hay lặn. Một gen b';
MERGE (n:Disease {id: 'D0282'}) SET n.id = 'D0282', n.name = 'Bệnh thận ống kẽ thận gen trội nhiễm sắc thể thường', n.name_en = 'Autosomal dominant tubulointerstitial kidney disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000465.htm', n.prognosis = 'Độ tuổi mà những người mắc ADTKD mắc bệnh thận giai đoạn cuối khác nhau, tùy thuộc vào dạng bệnh. Nó có thể còn trẻ như ở tuổi thiếu niên hoặc ở tuổi trưởng thành. Điều trị suốt đời có thể kiểm soát c', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có bất kỳ triệu chứng nào về các vấn đề về tiết niệu hoặc thận.';
MERGE (n:Disease {id: 'D0283'}) SET n.id = 'D0283', n.name = 'Gen lặn nhiễm sắc thể thường', n.name_en = 'Autosomal recessive', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002052.htm', n.overview = 'Di truyền một bệnh, tình trạng hoặc đặc điểm cụ thể phụ thuộc vào loại nhiễm sắc thể bị ảnh hưởng. Hai loại là nhiễm sắc thể thường và nhiễm sắc thể giới tính. Nó còn phụ thuộc vào tính trạng đó là tr';
MERGE (n:Disease {id: 'D0284'}) SET n.id = 'D0284', n.name = 'Hoại tử vô mạch (hoại tử xương)', n.name_en = 'Avascular necrosis (osteonecrosis)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/avascular-necrosis/symptoms-causes/syc-20369859', n.overview = 'Hoại tử vô mạch là tình trạng mô xương chết do thiếu nguồn cung cấp máu. Còn được gọi là hoại tử xương, nó có thể dẫn đến những vết gãy nhỏ trong xương và khiến xương bị gãy. Quá trình này có thể mất ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn để biết tình trạng đau liên tục ở bất kỳ khớp nào. Tìm kiếm sự chăm sóc y tế ngay lập tức nếu có thể bị gãy xương hoặc trật khớp.';
MERGE (n:Disease {id: 'D0285'}) SET n.id = 'D0285', n.name = 'Cúm gia cầm', n.name_en = 'Avian influenza', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007263.htm', n.prognosis = 'Triển vọng phụ thuộc vào loại vi-rút cúm gia cầm và mức độ lây nhiễm nặng như thế nào. Bệnh có thể gây tử vong.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn xuất hiện các triệu chứng giống cúm trong vòng 10 ngày sau khi tiếp xúc với gia cầm bị nhiễm bệnh, ở gần gia súc bị nhiễm bệnh hoặc ở trong khu vực đã biết';
MERGE (n:Disease {id: 'D0286'}) SET n.id = 'D0286', n.name = 'Rối loạn nhân cách né tránh', n.name_en = 'Avoidant personality disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000940.htm', n.prognosis = 'Những người mắc chứng rối loạn này có thể phát triển một số khả năng liên quan đến người khác. Với việc điều trị, điều này có thể được cải thiện.', n.when_to_see = 'Hãy gặp nhà cung cấp của bạn hoặc chuyên gia sức khỏe tâm thần nếu sự nhút nhát hoặc sợ bị từ chối lấn át khả năng hoạt động trong cuộc sống và các mối quan hệ của bạn. Nếu bạn hoặc ai đó bạn biết đan';
MERGE (n:Disease {id: 'D0287'}) SET n.id = 'D0287', n.name = 'Rối loạn chức năng thần kinh nách', n.name_en = 'Axillary nerve dysfunction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000689.htm', n.prognosis = 'Có thể hồi phục hoàn toàn nếu xác định được nguyên nhân gây ra chứng rối loạn chức năng thần kinh nách và điều trị thành công.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để lấy hẹn nếu bạn có các triệu chứng rối loạn chức năng thần kinh nách. Chẩn đoán và điều trị sớm làm tăng cơ hội kiểm soát các triệu chứng.';
MERGE (n:Disease {id: 'D0288'}) SET n.id = 'D0288', n.name = 'Ung thư hạch tế bào B', n.name_en = 'B-cell lymphoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/b-cell-lymphoma/symptoms-causes/syc-20586599', n.overview = 's là một loại ung thư hạch. Ung thư hạch là bệnh ung thư ảnh hưởng đến hệ bạch huyết. Hệ bạch huyết được tạo thành từ các cơ quan, tuyến, mạch dạng ống và cụm tế bào gọi là hạch bạch huyết. Nó là một ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0289'}) SET n.id = 'D0289', n.name = 'Trẻ sơ sinh và rôm sảy', n.name_en = 'Babies and heat rashes', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001966.htm', n.overview = 'Để tránh rôm sảy, hãy giữ cho bé luôn mát mẻ và khô ráo khi thời tiết ấm áp. Một số gợi ý hữu ích: Trong mùa nóng, hãy cho bé mặc quần áo cotton nhẹ, mềm. Chất liệu cotton có khả năng thấm hút rất tốt';
MERGE (n:Disease {id: 'D0290'}) SET n.id = 'D0290', n.name = 'Trẻ sơ sinh và các mũi tiêm', n.name_en = 'Babies and shots', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001967.htm', n.overview = 'Các bậc cha mẹ thường thắc mắc làm cách nào để thực hiện các mũi tiêm ít gây đau đớn cho con mình. Gần như tất cả các mũi tiêm chủng (còn gọi là tiêm chủng) đều cần được tiêm vào cơ hoặc dưới da bằng ';
MERGE (n:Disease {id: 'D0291'}) SET n.id = 'D0291', n.name = 'Phản xạ Babinski', n.name_en = 'Babinski reflex', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003294.htm';
MERGE (n:Disease {id: 'D0292'}) SET n.id = 'D0292', n.name = 'Mụn trẻ em', n.name_en = 'Baby acne', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/baby-acne/symptoms-causes/syc-20369880', n.overview = 'là tình trạng gây ra những vết sưng nhỏ trên da của trẻ sơ sinh - thường ở mặt và cổ. Mụn ở trẻ em là tình trạng phổ biến và mang tính tạm thời. Bạn có thể làm rất ít điều để ngăn chặn nó và nó thường', n.when_to_see = 'Hãy nói chuyện với thành viên trong nhóm chăm sóc sức khỏe của con bạn nếu bạn lo lắng về làn da của con mình.';
MERGE (n:Disease {id: 'D0293'}) SET n.id = 'D0293', n.name = 'Quá liều Bacitracin', n.name_en = 'Bacitracin overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002563.htm', n.prognosis = 'Nếu phản ứng dị ứng phát triển và được kiểm soát thì khả năng phục hồi là rất cao. Sống sót sau 24 giờ thường là dấu hiệu cho thấy có khả năng phục hồi.';
MERGE (n:Disease {id: 'D0294'}) SET n.id = 'D0294', n.name = 'Quá liều kẽm Bacitracin', n.name_en = 'Bacitracin zinc overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002569.htm', n.prognosis = 'Nếu phản ứng dị ứng được kiểm soát thì khả năng phục hồi là rất cao. Sống sót sau 24 giờ thường là dấu hiệu cho thấy có khả năng phục hồi.';
MERGE (n:Disease {id: 'D0295'}) SET n.id = 'D0295', n.name = 'Đau lưng', n.name_en = 'Back pain', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/back-pain/symptoms-causes/syc-20369906', n.overview = 'là một trong những lý do phổ biến nhất khiến mọi người tìm kiếm sự trợ giúp y tế hoặc nghỉ việc. Đau lưng là nguyên nhân hàng đầu gây ra tình trạng khuyết tật trên toàn thế giới. May mắn thay, các biệ', n.when_to_see = 'Hầu hết chứng đau lưng sẽ cải thiện theo thời gian bằng cách điều trị tại nhà và tự chăm sóc, thường trong vòng vài tuần. Liên hệ với chuyên gia chăm sóc sức khỏe của bạn nếu bị đau lưng: Kéo dài hơn ';
MERGE (n:Disease {id: 'D0296'}) SET n.id = 'D0296', n.name = 'Đau lưng - khi bạn gặp bác sĩ', n.name_en = 'Back pain - when you see the doctor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007494.htm', n.overview = 'Các câu hỏi mà nhà cung cấp dịch vụ của bạn có thể hỏi bao gồm: Cơn đau của bạn nằm ở đâu? Đau lưng của bạn chỉ ở một bên hay cả hai bên? Cảm giác đau như thế nào? Nó có âm ỉ, sắc bén, đau nhói hoặc n';
MERGE (n:Disease {id: 'D0297'}) SET n.id = 'D0297', n.name = 'Viêm dạ dày ruột do vi khuẩn', n.name_en = 'Bacterial gastroenteritis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000254.htm', n.prognosis = 'Hầu hết mọi người sẽ khỏe hơn sau vài ngày mà không cần điều trị. Một số loại E coli hiếm gặp có thể gây ra: Thiếu máu trầm trọng Xuất huyết tiêu hóa Suy thận', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Máu hoặc mủ trong phân, hoặc phân của bạn có màu đen Tiêu chảy kèm theo sốt trên 101°F (38,3°C) hoặc 100,4°F (38°C) ở trẻ em Gần đây đã đi du lịch ';
MERGE (n:Disease {id: 'D0298'}) SET n.id = 'D0298', n.name = 'Viêm âm đạo do vi khuẩn', n.name_en = 'Bacterial vaginosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bacterial-vaginosis/symptoms-causes/syc-20352279', n.overview = '(BV) có thể gây khó chịu và đau âm đạo. Nó xảy ra khi mức độ vi khuẩn tự nhiên mất cân bằng. Mức độ cân bằng của vi khuẩn giúp giữ cho âm đạo khỏe mạnh. Nhưng khi có quá nhiều vi khuẩn phát triển, nó ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu: Dịch tiết âm đạo của bạn có mùi bất thường và bạn cảm thấy khó chịu. Bác sĩ có thể giúp tìm ra nguyên nhân gây ra các triệu chứng của bạn. Bạn đã từng bị ';
MERGE (n:Disease {id: 'D0299'}) SET n.id = 'D0299', n.name = 'Hôi miệng', n.name_en = 'Bad breath', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bad-breath/symptoms-causes/syc-20350922', n.overview = 'Chứng hôi miệng có mùi hôi, dẫn đến hôi miệng. Hôi miệng, còn gọi là chứng hôi miệng, có thể khiến bạn xấu hổ và trong một số trường hợp thậm chí có thể gây lo lắng. Không có gì ngạc nhiên khi các kệ ', n.when_to_see = 'Nếu bạn bị hôi miệng, hãy xem lại cách bạn giữ miệng và răng sạch sẽ. Hãy thử thay đổi lối sống, chẳng hạn như đánh răng và lưỡi sau khi ăn, sử dụng chỉ nha khoa và uống nhiều nước. Nếu bạn vẫn còn hô';
MERGE (n:Disease {id: 'D0300'}) SET n.id = 'D0300', n.name = 'Túi dưới mắt', n.name_en = 'Bags under eyes', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bags-under-eyes/symptoms-causes/syc-20369927', n.overview = 'là hiện tượng sưng hoặc bọng mắt nhẹ. Chúng phổ biến khi bạn già đi và các mô xung quanh mắt bạn yếu đi, bao gồm cả một số cơ nâng đỡ mí mắt của bạn. Chất béo giúp hỗ trợ mắt sau đó có thể di chuyển v', n.when_to_see = 'Bạn có thể không thích vẻ ngoài của chúng, nhưng có bọng dưới mắt thường vô hại và không cần chăm sóc y tế. Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu tình trạng này gây ra các vấn';
MERGE (n:Disease {id: 'D0301'}) SET n.id = 'D0301', n.name = 'U nang', n.name_en = 'Baker cyst', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/bakers-cyst/symptoms-causes/syc-20369950 | https://medlineplus.gov/ency/article/001222.htm', n.overview = 'có thể hình thành khi chất lỏng hoạt dịch lấp đầy một túi đệm, gọi là bao hoạt dịch, ở phía sau đầu gối. U nang Baker là khối u chứa đầy dịch phía sau đầu gối. Nó gây ra sự phồng lên và cảm giác căng ', n.prognosis = 'U nang Baker sẽ không gây ra bất kỳ tác hại lâu dài nào nhưng có thể gây khó chịu và đau đớn. Các triệu chứng của u nang Baker thường đến rồi đi. Tình trạng khuyết tật lâu dài rất hiếm. Hầu hết mọi ng', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị sưng sau đầu gối và trở nên to hơn hoặc đau đớn. Đau có thể là dấu hiệu của nhiễm trùng. Đồng thời liên hệ với nhà cung cấp dịch vụ chăm sóc sức';
MERGE (n:Disease {id: 'D0302'}) SET n.id = 'D0302', n.name = 'Quá liều bột nở', n.name_en = 'Baking powder overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002738.htm', n.prognosis = 'Kết quả của việc dùng quá liều bột nở phụ thuộc vào nhiều yếu tố, bao gồm: Lượng bột nở nuốt vào Tuổi, cân nặng và sức khỏe tổng thể của người đó Loại biến chứng phát triển Nếu buồn nôn, nôn và tiêu c';
MERGE (n:Disease {id: 'D0303'}) SET n.id = 'D0303', n.name = 'Quá liều baking soda', n.name_en = 'Baking soda overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002749.htm', n.prognosis = 'Kết quả của việc dùng quá liều baking soda phụ thuộc vào nhiều yếu tố, bao gồm: Lượng baking soda nuốt vào Thời gian từ khi dùng quá liều đến khi bắt đầu điều trị Tuổi, cân nặng và sức khỏe tổng thể c';
MERGE (n:Disease {id: 'D0304'}) SET n.id = 'D0304', n.name = 'Vấn đề về thăng bằng', n.name_en = 'Balance problems', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/balance-problems/symptoms-causes/syc-20350474', n.overview = 'có thể khiến bạn cảm thấy chóng mặt, như thể căn phòng đang quay tròn, chao đảo hoặc choáng váng. Bạn có thể cảm thấy như căn phòng đang quay tròn hoặc bạn sắp ngã xuống. Những cảm giác này có thể xảy';
MERGE (n:Disease {id: 'D0305'}) SET n.id = 'D0305', n.name = 'Viêm quy đầu', n.name_en = 'Balanitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000862.htm', n.prognosis = 'Hầu hết các trường hợp viêm quy đầu có thể được kiểm soát bằng kem bôi thuốc và vệ sinh tốt. Phẫu thuật không cần thiết trong hầu hết thời gian.', n.when_to_see = 'Hãy cho nhà cung cấp dịch vụ của bạn biết nếu bạn có bất kỳ dấu hiệu nào của viêm quy đầu, bao gồm sưng bao quy đầu hoặc đau.';
MERGE (n:Disease {id: 'D0306'}) SET n.id = 'D0306', n.name = 'Nhiễm độc và quá liều barbiturat', n.name_en = 'Barbiturate intoxication and overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000951.htm', n.prognosis = 'Khoảng 1 trong 10 người sử dụng quá liều thuốc an thần hoặc hỗn hợp có chứa thuốc an thần sẽ chết. Họ thường chết vì các vấn đề về tim và phổi.', n.when_to_see = 'Hãy gọi số khẩn cấp tại địa phương của bạn, chẳng hạn như 911, nếu ai đó đã dùng thuốc an thần và có vẻ cực kỳ mệt mỏi hoặc có vấn đề về hô hấp. Bạn có thể liên hệ trực tiếp với trung tâm kiểm soát ch';
MERGE (n:Disease {id: 'D0307'}) SET n.id = 'D0307', n.name = 'Hội chứng Bardet-Biedl (BBS)', n.name_en = 'Bardet-Biedl syndrome (BBS)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bardet-biedl-syndrome/symptoms-causes/syc-20586227', n.overview = 'Hội chứng Bardet-Biedl (BAR-day, BEE-dul), còn được gọi là BBS, là một tình trạng hiếm gặp do thay đổi gen. BBS có thể ảnh hưởng đến hầu hết mọi bộ phận của cơ thể. Bắt đầu từ thời thơ ấu, việc tăng c', n.when_to_see = 'Vì hội chứng Bardet-Biedl là một tình trạng hiếm gặp nên đôi khi rất khó phát hiện. Các triệu chứng rất khác nhau và có thể bắt đầu vài năm sau khi sinh. Nếu bạn lo lắng về sự tăng trưởng và phát triể';
MERGE (n:Disease {id: 'D0308'}) SET n.id = 'D0308', n.name = 'Barrett thực quản', n.name_en = 'Barrett esophagus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001143.htm', n.prognosis = 'Việc điều trị sẽ cải thiện các triệu chứng trào ngược axit và có thể giữ cho BE không trở nên tồi tệ hơn. RFA loại bỏ mô BE cũng như loại bỏ qua nội soi, nhưng BE thường quay trở lại và đây là lý do t', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Chứng ợ nóng kéo dài hơn một vài ngày hoặc bạn bị đau hoặc khó nuốt. Bạn đã được chẩn đoán mắc bệnh BE và các triệu chứng của bạn trở nên tồi tệ hơn. ';
MERGE (n:Disease {id: 'D0309'}) SET n.id = 'D0309', n.name = 'Các tế bào mực', n.name_en = 'Barrett\'s esophagus', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/barretts-esophagus/symptoms-causes/syc-20352841', n.overview = 'của Barrett thực quản được thay thế bằng một lớp lót dày, màu đỏ có khả năng gây biến đổi ung thư, được cho là do bệnh trào ngược dạ dày thực quản (GERD) lâu năm gây ra. Barrett thực quản là tình trạn', n.when_to_see = 'Nếu bạn gặp rắc rối với chứng ợ nóng, trào ngược và trào ngược axit trong hơn 5 năm, bạn nên hỏi bác sĩ về nguy cơ mắc bệnh Barrett thực quản. Hãy tìm kiếm sự trợ giúp ngay lập tức nếu bạn: Đau ngực, ';
MERGE (n:Disease {id: 'D0310'}) SET n.id = 'D0310', n.name = 'U nang hoặc áp xe Bartholin', n.name_en = 'Bartholin cyst or abscess', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001489.htm', n.prognosis = 'Cơ hội phục hồi hoàn toàn là rất lớn. Áp xe có thể tái phát trong một số trường hợp. Điều quan trọng là phải điều trị bất kỳ bệnh nhiễm trùng âm đạo nào được chẩn đoán cùng lúc với áp xe.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn nhận thấy một khối u sưng tấy, đau đớn ở môi âm hộ gần lỗ âm đạo và tình trạng này không cải thiện sau 2 đến 3 ngày điều trị tại nhà. Cơn đau nghi';
MERGE (n:Disease {id: 'D0311'}) SET n.id = 'D0311', n.name = 'U nang Bartholin', n.name_en = 'Bartholin\'s cyst', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bartholin-cyst/symptoms-causes/syc-20369976', n.overview = 'Các tuyến Bartholin (BAHR-toe-linz) nằm ở mỗi bên của cửa âm đạo. Những tuyến này tiết ra chất lỏng giúp bôi trơn âm đạo. Đôi khi các lỗ hở của các tuyến này bị tắc nghẽn, khiến chất lỏng chảy ngược v', n.when_to_see = 'Hãy gọi cho bác sĩ nếu bạn có một khối u đau gần lỗ âm đạo và không cải thiện sau hai hoặc ba ngày tự chăm sóc - ví dụ: ngâm vùng đó trong nước ấm (tắm sitz). Nếu cơn đau nghiêm trọng, hãy hẹn gặp bác';
MERGE (n:Disease {id: 'D0312'}) SET n.id = 'D0312', n.name = 'Hội chứng Bartter', n.name_en = 'Bartter syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000308.htm', n.prognosis = 'Trẻ sơ sinh bị suy giảm tăng trưởng nghiêm trọng có thể phát triển bình thường sau khi điều trị. Theo thời gian, một số người mắc bệnh này sẽ bị suy thận.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn: Bị chuột rút cơ bắp Không phát triển tốt Đi tiểu thường xuyên';
MERGE (n:Disease {id: 'D0313'}) SET n.id = 'D0313', n.name = 'Ung thư biểu mô tế bào đáy', n.name_en = 'Basal cell carcinoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/basal-cell-carcinoma/symptoms-causes/syc-20354187', n.overview = 'là một loại ung thư da. Ung thư biểu mô tế bào đáy bắt đầu trong các tế bào da gọi là tế bào đáy. Các tế bào cơ bản tạo ra các tế bào da mới khi những tế bào cũ chết đi. Ung thư biểu mô tế bào đáy thư', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn thấy những thay đổi về bề ngoài làn da của mình, chẳng hạn như một khối u mới, một sự thay đổi ở khối u trước đó hoặc một vết loét tái';
MERGE (n:Disease {id: 'D0314'}) SET n.id = 'D0314', n.name = 'Ung thư da tế bào đáy', n.name_en = 'Basal cell skin cancer', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000824.htm', n.prognosis = 'Hầu hết các bệnh ung thư này đều được chữa khỏi khi được điều trị sớm. Một số bệnh ung thư tế bào đáy tái phát ở cùng một vị trí. Những cái nhỏ hơn ít có khả năng quay trở lại. Ung thư da tế bào đáy h', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để lấy hẹn nếu vết loét hoặc vết đốm trên da thay đổi về: Ngoại hình Màu sắc Kích thước Kết cấu Đồng thời liên hệ với nhà cung cấp dịch vụ của bạn nếu vết ';
MERGE (n:Disease {id: 'D0315'}) SET n.id = 'D0315', n.name = 'Rối loạn chức năng hạch nền', n.name_en = 'Basal ganglia dysfunction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001069.htm', n.prognosis = 'Một người hoạt động tốt như thế nào tùy thuộc vào nguyên nhân gây ra rối loạn chức năng. Một số nguyên nhân có thể khắc phục được, trong khi những nguyên nhân khác cần điều trị suốt đời.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu bạn có bất kỳ dấu hiệu nào: Cử động bất thường hoặc không chủ ý Ngã mà không biết lý do Nếu bạn hoặc người khác nhận thấy rằng bạn run rẩy hoặc chậm chạp';
MERGE (n:Disease {id: 'D0316'}) SET n.id = 'D0316', n.name = 'Hội chứng Bassen-Kornzweig', n.name_en = 'Bassen-Kornzweig syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001666.htm', n.prognosis = 'Một người hoạt động tốt như thế nào tùy thuộc vào mức độ vấn đề về não và hệ thần kinh.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu trẻ sơ sinh hoặc trẻ nhỏ của bạn có các triệu chứng của bệnh này. Tư vấn di truyền có thể giúp các gia đình hiểu được tình trạng bệnh và những rủi ro k';
MERGE (n:Disease {id: 'D0317'}) SET n.id = 'D0317', n.name = 'Bệnh loạn dưỡng cơ Becker', n.name_en = 'Becker muscular dystrophy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000706.htm', n.prognosis = 'Bệnh loạn dưỡng cơ Becker dẫn đến tình trạng khuyết tật ngày càng trầm trọng hơn. Tuy nhiên, mức độ khuyết tật khác nhau. Một số người có thể cần xe lăn. Những người khác có thể chỉ cần sử dụng dụng c', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Xuất hiện các triệu chứng của chứng loạn dưỡng cơ Becker Một người mắc chứng loạn dưỡng cơ Becker phát triển các triệu chứng mới (đặc biệt là sốt kèm theo ho ';
MERGE (n:Disease {id: 'D0318'}) SET n.id = 'D0318', n.name = 'Hội chứng Beckwith-Wiedemann', n.name_en = 'Beckwith-Wiedemann syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001186.htm', n.prognosis = 'Trẻ mắc hội chứng Beckwith-Wiedemann thường có cuộc sống bình thường. Cần nghiên cứu thêm để phát triển thông tin theo dõi lâu dài.', n.when_to_see = 'Nếu bạn có con mắc hội chứng Beckwith-Wiedemann và phát triển các triệu chứng đáng lo ngại, hãy liên hệ ngay với bác sĩ nhi khoa.';
MERGE (n:Disease {id: 'D0319'}) SET n.id = 'D0319', n.name = 'Đái dầm', n.name_en = 'Bed-wetting', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bed-wetting/symptoms-causes/syc-20366685', n.overview = '- còn được gọi là tiểu không tự chủ vào ban đêm hoặc đái dầm về đêm - có nghĩa là đi tiểu mà không có ý định trong khi ngủ. Điều này xảy ra sau độ tuổi mà việc giữ khô ráo vào ban đêm có thể được dự đ', n.when_to_see = 'Hầu hết trẻ em đều tự khỏi chứng đái dầm - nhưng một số trẻ cần được giúp đỡ một chút. Trong các trường hợp khác, đái dầm có thể là dấu hiệu của một tình trạng tiềm ẩn cần được chăm sóc y tế. Nói chuy';
MERGE (n:Disease {id: 'D0320'}) SET n.id = 'D0320', n.name = 'Rệp', n.name_en = 'Bedbugs', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bedbugs/symptoms-causes/syc-20370001', n.overview = 'Hạt táo rệp. Ban ngày chúng ẩn náu trong các vết nứt, kẽ hở của giường, lò xo hộp, đầu giường và khung giường. Rệp là loài côn trùng nhỏ, hút máu, màu nâu đỏ, không có cánh. Vết cắn của rệp thường khỏ', n.when_to_see = 'Nếu bạn gặp phản ứng dị ứng hoặc phản ứng da nghiêm trọng do vết cắn của rệp, hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn để được điều trị chuyên nghiệp. Yêu cầu một cuộc hẹn Có vấn đề ';
MERGE (n:Disease {id: 'D0321'}) SET n.id = 'D0321', n.name = 'Vết lở loét (loét do áp lực)', n.name_en = 'Bedsores (pressure ulcers)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bed-sores/symptoms-causes/syc-20355893', n.overview = 'Vết loét do áp lực làm giảm lưu lượng máu đến những vùng dễ bị tổn thương trên cơ thể. Áp lực này có thể do nằm trên giường hoặc xe lăn trong thời gian dài. Lở loét là những vết thương ở da và mô bên ', n.when_to_see = 'Nếu bạn nhận thấy các dấu hiệu cảnh báo về vết loét do nằm lâu, hãy thay đổi tư thế để giảm bớt áp lực lên vùng đó. Nếu vùng đó không cải thiện sau 24 đến 48 giờ, hãy liên hệ với chuyên gia chăm sóc s';
MERGE (n:Disease {id: 'D0322'}) SET n.id = 'D0322', n.name = 'Thói quen đi ngủ cho trẻ sơ sinh và trẻ nhỏ', n.name_en = 'Bedtime habits for infants and children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002392.htm', n.overview = 'EM BÉ MỚI CỦA BẠN (DƯỚI 2 THÁNG) VÀ GIẤC NGỦ Lúc đầu, em bé mới sinh của bạn có chu kỳ bú và ngủ-thức 24 giờ. Trẻ sơ sinh có thể ngủ từ 14 đến 17 giờ mỗi ngày. Họ chỉ thức từ 1 đến 3 giờ mỗi lần. Các ';
MERGE (n:Disease {id: 'D0323'}) SET n.id = 'D0323', n.name = 'Ong đốt', n.name_en = 'Bee sting', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bee-stings/symptoms-causes/syc-20353869', n.overview = 'Ong đốt là một mối phiền toái thường gặp ở ngoài trời. Bạn có thể thực hiện một số bước để tránh bị ong, ong bắp cày và ong bắp cày đốt. Nếu bạn bị đốt, sơ cứu cơ bản có thể giúp giảm đau do phản ứng ', n.when_to_see = 'Gọi 911 hoặc tìm kiếm sự chăm sóc ngay lập tức khi: Phản ứng nghiêm trọng khi bị ong đốt gợi ý sốc phản vệ, ngay cả khi đó chỉ là một hoặc hai triệu chứng. Nếu bạn được kê đơn thuốc epinephrine khẩn c';
MERGE (n:Disease {id: 'D0324'}) SET n.id = 'D0324', n.name = 'Nọc ong, ong bắp cày, ong bắp cày hoặc áo khoác màu vàng', n.name_en = 'Bee, wasp, hornet, or yellow jacket sting', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002847.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào mức độ dị ứng của họ với vết đốt của côn trùng và tốc độ họ được điều trị. Họ nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Khả năng ';
MERGE (n:Disease {id: 'D0325'}) SET n.id = 'D0325', n.name = 'Ngộ độc sáp ong', n.name_en = 'Beeswax poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002760.htm', n.prognosis = 'Vì sáp ong được coi là khá không độc hại nên rất có khả năng phục hồi. Một người khỏe mạnh như thế nào tùy thuộc vào lượng sáp ong họ nuốt và tốc độ họ được điều trị.';
MERGE (n:Disease {id: 'D0326'}) SET n.id = 'D0326', n.name = 'Bệnh Behcet', n.name_en = 'Behcet disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/behcet-disease/symptoms-causes/syc-20351326', n.overview = 'Bệnh Behcet (beh-CHET), còn gọi là hội chứng Behcet, là một tình trạng hiếm gặp. Nó gây sưng mạch máu, gọi là viêm, khắp cơ thể. Các triệu chứng của bệnh Behcet lúc đầu có vẻ như không liên quan. Chún', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng có thể là bệnh Behcet. Nếu bạn đã được chẩn đoán mắc bệnh này, hãy gặp chuyên gia y tế nếu bạn có các triệu chứng mới. Yêu c';
MERGE (n:Disease {id: 'D0327'}) SET n.id = 'D0327', n.name = 'Ợ hơi', n.name_en = 'Belching', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003080.htm', n.when_to_see = 'Hầu hết ợ hơi chỉ là một vấn đề nhỏ. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu tình trạng ợ hơi không biến mất hoặc nếu bạn còn có các triệu chứng khác như đau bụng hoặc sốt.';
MERGE (n:Disease {id: 'D0328'}) SET n.id = 'D0328', n.name = 'Bệnh liệt Bell', n.name_en = 'Bell palsy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000773.htm', n.prognosis = 'Hầu hết các trường hợp sẽ khỏi hoàn toàn trong vòng vài tuần đến vài tháng. Nếu bạn không mất toàn bộ chức năng thần kinh và các triệu chứng bắt đầu cải thiện trong vòng 3 tuần, bạn có nhiều khả năng ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn ngay lập tức nếu mặt bạn xệ xuống hoặc bạn có các triệu chứng khác của bệnh liệt Bell. Nhà cung cấp của bạn có thể loại trừ các tình trạng khác nghiêm trọn';
MERGE (n:Disease {id: 'D0329'}) SET n.id = 'D0329', n.name = 'Khối u tuyến thượng thận lành tính', n.name_en = 'Benign adrenal tumors', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/benign-adrenal-tumors/symptoms-causes/syc-20356190', n.overview = 'Tuyến thượng thận tạo ra các hormone giúp điều hòa quá trình trao đổi chất, hệ thống miễn dịch, huyết áp và các chức năng quan trọng khác. Mặc dù nhỏ nhưng những tuyến này kiểm soát phần lớn những gì ';
MERGE (n:Disease {id: 'D0330'}) SET n.id = 'D0330', n.name = 'Khối u hoặc u nang tai lành tính', n.name_en = 'Benign ear cyst or tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001033.htm', n.prognosis = 'Các u nang và khối u lành tính ở tai phát triển chậm. Đôi khi chúng có thể co lại hoặc có thể tự biến mất.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Các triệu chứng của khối u hoặc u nang tai lành tính Khó chịu, đau hoặc mất thính giác';
MERGE (n:Disease {id: 'D0331'}) SET n.id = 'D0331', n.name = 'Chóng mặt tư thế kịch phát lành tính (BPPV)', n.name_en = 'Benign paroxysmal positional vertigo (BPPV)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/vertigo/symptoms-causes/syc-20370055', n.overview = 'Chóng mặt tư thế kịch phát lành tính, còn được gọi là BPPV, là một trong những nguyên nhân phổ biến nhất gây chóng mặt. Chóng mặt là cảm giác quay tròn hoặc di chuyển đột ngột. BPPV gây chóng mặt từ n', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị chóng mặt hoặc chóng mặt đột ngột, dữ dội, kéo dài hoặc tái phát.';
MERGE (n:Disease {id: 'D0332'}) SET n.id = 'D0332', n.name = 'Khối u thần kinh ngoại biên lành tính', n.name_en = 'Benign peripheral nerve tumor', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/peripheral-nerve-tumors-benign/symptoms-causes/syc-20368680', n.overview = 'là những khối u hình thành trên dây thần kinh ngoại biên. Các dây thần kinh ngoại biên liên kết não và tủy sống với các bộ phận khác của cơ thể. Những dây thần kinh này điều khiển các cơ cho phép bạn ';
MERGE (n:Disease {id: 'D0333'}) SET n.id = 'D0333', n.name = 'Chóng mặt lành tính theo tư thế', n.name_en = 'Benign positional vertigo', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001420.htm', n.prognosis = 'BPPV không thoải mái, nhưng nó thường có thể được điều trị bằng thao tác Epley. Nó có thể quay lại lần nữa mà không báo trước.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn bị chóng mặt. Điều trị chứng chóng mặt không có tác dụng. Nhận trợ giúp y tế ngay lập tức nếu bạn cũng có các triệu chứng như: Suy nhược Nói lắp Các vấn đ';
MERGE (n:Disease {id: 'D0334'}) SET n.id = 'D0334', n.name = 'Tăng sản tuyến tiền liệt lành tính (BPH)', n.name_en = 'Benign prostatic hyperplasia (BPH)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/benign-prostatic-hyperplasia/symptoms-causes/syc-20370087', n.overview = 'là một vấn đề sức khỏe trở nên phổ biến hơn theo tuổi tác. Nó còn được gọi là phì đại tuyến tiền liệt. Tuyến tiền liệt là một tuyến nhỏ giúp tạo ra tinh dịch. Nó được tìm thấy ngay dưới bàng quang. Và', n.when_to_see = 'Nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn về các triệu chứng của bạn, ngay cả khi chúng không làm phiền bạn. Điều quan trọng là tìm hiểu xem có nguyên nhân nào có thể điều trị được';
MERGE (n:Disease {id: 'D0335'}) SET n.id = 'D0335', n.name = 'Ngộ độc benzen', n.name_en = 'Benzene poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002720.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng benzen họ nuốt vào và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Benzen rất độc. Ngộ độc có thể gây tử vong nhanh chó';
MERGE (n:Disease {id: 'D0336'}) SET n.id = 'D0336', n.name = 'Beriberi', n.name_en = 'Beriberi', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000339.htm', n.prognosis = 'Nếu không được điều trị, bệnh beriberi có thể gây tử vong. Khi được điều trị, các triệu chứng thường cải thiện nhanh chóng. Tổn thương tim thường hồi phục được. Dự kiến ​​sẽ có sự phục hồi hoàn toàn t', n.when_to_see = 'Beriberi cực kỳ hiếm ở Hoa Kỳ. Tuy nhiên, hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn cảm thấy chế độ ăn uống của gia đình mình không đầy đủ hoặc kém cân bằng Bạn hoặc con bạn có bất kỳ triệ';
MERGE (n:Disease {id: 'D0337'}) SET n.id = 'D0337', n.name = 'Quá liều thuốc chẹn beta', n.name_en = 'Beta-blockers overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002578.htm', n.prognosis = 'Quá liều thuốc chẹn beta có thể rất nguy hiểm. Nó có thể gây tử vong. Nếu nhịp tim và huyết áp của người đó có thể được điều chỉnh thì khả năng sống sót là rất cao. Khả năng sống sót phụ thuộc vào liề';
MERGE (n:Disease {id: 'D0338'}) SET n.id = 'D0338', n.name = 'Bezoar', n.name_en = 'Bezoar', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001582.htm', n.prognosis = 'Full recovery is expected.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nghi ngờ con mình có dị vật.';
MERGE (n:Disease {id: 'D0339'}) SET n.id = 'D0339', n.name = 'Van động mạch chủ hai mảnh', n.name_en = 'Bicuspid aortic valve', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007325.htm', n.prognosis = 'Tình trạng sức khỏe của người bệnh phụ thuộc vào sự hiện diện và mức độ nghiêm trọng của các biến chứng của BAV. Sự hiện diện của các vấn đề thể chất khác khi sinh cũng có thể ảnh hưởng đến khả năng h', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu con bạn: Chán ăn Da xanh xao hoặc nhợt nhạt bất thường Có vẻ dễ mệt mỏi';
MERGE (n:Disease {id: 'D0340'}) SET n.id = 'D0340', n.name = 'Thận ứ nước hai bên', n.name_en = 'Bilateral hydronephrosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000474.htm', n.prognosis = 'Phẫu thuật được thực hiện khi em bé còn trong bụng mẹ hoặc ngay sau khi sinh có thể mang lại kết quả tốt trong việc cải thiện chức năng thận. Sự phục hồi chức năng thận có thể khác nhau, tùy thuộc vào', n.when_to_see = 'Vấn đề này thường được nhà cung cấp dịch vụ chăm sóc sức khỏe tìm ra.';
MERGE (n:Disease {id: 'D0341'}) SET n.id = 'D0341', n.name = 'Cơn động kinh co cứng-co giật hai bên', n.name_en = 'Bilateral tonic-clonic seizure', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000695.htm';
MERGE (n:Disease {id: 'D0342'}) SET n.id = 'D0342', n.name = 'Tắc nghẽn ống mật', n.name_en = 'Bile duct obstruction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000263.htm', n.prognosis = 'Nếu tình trạng tắc nghẽn không được khắc phục, nó có thể dẫn đến nhiễm trùng đe dọa tính mạng và tích tụ bilirubin nguy hiểm. Nếu tình trạng tắc nghẽn kéo dài có thể dẫn đến bệnh gan mãn tính. Hầu hết', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn: Nhận thấy sự thay đổi màu sắc của nước tiểu và phân Bị vàng da Đau bụng không thuyên giảm hoặc tái phát';
MERGE (n:Disease {id: 'D0343'}) SET n.id = 'D0343', n.name = 'Hẹp ống mật', n.name_en = 'Bile duct stricture', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000220.htm', n.prognosis = 'Điều trị hầu hết đều thành công. Thành công lâu dài phụ thuộc vào nguyên nhân gây ra sự nghiêm ngặt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu các triệu chứng tái phát sau viêm tụy, cắt túi mật hoặc phẫu thuật đường mật khác.';
MERGE (n:Disease {id: 'D0344'}) SET n.id = 'D0344', n.name = 'Trào ngược mật', n.name_en = 'Bile reflux', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bile-reflux/symptoms-causes/syc-20370115', n.overview = 'xảy ra khi mật trào ngược vào dạ dày. Mật là chất lỏng do gan tạo ra để giúp tiêu hóa thức ăn. Đôi khi, chất lỏng này trào ngược vào thực quản, ống nối miệng và dạ dày. Trào ngược dịch mật có thể xảy ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn thường xuyên có các triệu chứng trào ngược hoặc nếu bạn giảm cân mà không cố gắng. Nếu bạn đã được chẩn đoán mắc chứng trào ngược axit hoặc bệnh trào n';
MERGE (n:Disease {id: 'D0345'}) SET n.id = 'D0345', n.name = 'Đèn Bili', n.name_en = 'Bili lights', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002394.htm', n.overview = 'Quang trị liệu bao gồm việc chiếu ánh sáng huỳnh quang từ đèn bili lên da trần. Một bước sóng ánh sáng cụ thể có thể phân hủy bilirubin thành dạng mà cơ thể có thể loại bỏ qua nước tiểu và phân. Ánh s';
MERGE (n:Disease {id: 'D0346'}) SET n.id = 'D0346', n.name = 'Hẹp đường mật', n.name_en = 'Biliary atresia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/biliary-atresia/symptoms-causes/syc-20591855 | https://medlineplus.gov/ency/article/001145.htm', n.overview = 'là một tình trạng gan hiếm gặp ảnh hưởng đến trẻ sơ sinh và trẻ nhỏ. Nó xảy ra khi các ống mật bị viêm và tắc nghẽn hoặc không hình thành đúng cách. Ống mật là những ống mảnh mang dịch mật từ gan đến ', n.prognosis = 'Phẫu thuật sớm sẽ cải thiện khả năng sống sót của hơn một phần ba số trẻ mắc bệnh này. Lợi ích lâu dài của việc ghép gan vẫn chưa được biết đến nhưng nó được cho là sẽ cải thiện khả năng sống sót.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có biểu hiện vàng da hoặc nếu các triệu chứng khác của chứng hẹp đường mật phát triển.';
MERGE (n:Disease {id: 'D0347'}) SET n.id = 'D0347', n.name = 'Bệnh não do bilirubin', n.name_en = 'Bilirubin encephalopathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007309.htm', n.prognosis = 'BE là một tình trạng nghiêm trọng. Nhiều trẻ sơ sinh bị biến chứng hệ thần kinh tử vong.', n.when_to_see = 'Hãy nhận trợ giúp y tế ngay nếu con bạn có dấu hiệu của tình trạng này.';
MERGE (n:Disease {id: 'D0348'}) SET n.id = 'D0348', n.name = 'Chứng rối loạn ăn uống vô độ', n.name_en = 'Binge-eating disorder', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/binge-eating-disorder/symptoms-causes/syc-20353627 | https://medlineplus.gov/ency/article/003265.htm', n.overview = 'là một tình trạng nghiêm trọng. Nó luôn liên quan đến cảm giác như bạn không thể ngừng ăn. Nó cũng thường liên quan đến việc ăn nhiều hơn lượng thức ăn thông thường. Hầu như tất cả mọi người đôi khi ă', n.prognosis = 'Ăn uống vô độ là một chứng rối loạn có thể điều trị được. Liệu pháp nói chuyện dài hạn có vẻ hữu ích nhất.', n.when_to_see = 'Nếu bạn có bất kỳ triệu chứng nào của chứng rối loạn ăn uống vô độ, hãy nhận trợ giúp y tế càng sớm càng tốt. Nói chuyện với chuyên gia chăm sóc sức khỏe của bạn hoặc chuyên gia sức khỏe tâm thần về c';
MERGE (n:Disease {id: 'D0349'}) SET n.id = 'D0349', n.name = 'Phản hồi sinh học', n.name_en = 'Biofeedback', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002241.htm', n.overview = 'thường dựa trên các phép đo: Huyết áp Sóng não (EEG) Nhịp thở Nhịp tim Căng cơ Độ dẫn điện của da Nhiệt độ da Bằng cách xem các phép đo này, bạn có thể học cách thay đổi các chức năng này bằng cách th';
MERGE (n:Disease {id: 'D0350'}) SET n.id = 'D0350', n.name = 'Rối loạn lưỡng cực', n.name_en = 'Bipolar disorder', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/bipolar-disorder/symptoms-causes/syc-20355955 | https://medlineplus.gov/ency/article/000926.htm', n.overview = ', trước đây gọi là hưng cảm trầm cảm, là một tình trạng sức khỏe tâm thần gây ra sự thay đổi tâm trạng cực độ. Chúng bao gồm những cảm xúc dâng cao, còn được gọi là hưng cảm hoặc hưng cảm nhẹ, và nhữn', n.prognosis = 'Giai đoạn trầm cảm hoặc hưng cảm quay trở lại ở hầu hết mọi người, ngay cả khi đã điều trị. Mọi người cũng có thể gặp vấn đề với rượu hoặc sử dụng ma túy bất hợp pháp. Họ cũng có thể gặp vấn đề với cá', n.when_to_see = 'Hãy tìm sự giúp đỡ ngay lập tức nếu bạn: Có các triệu chứng hưng cảm Cảm thấy muốn làm tổn thương bản thân hoặc người khác Cảm thấy vô vọng, sợ hãi hoặc choáng ngợp Nhìn hoặc nghe thấy những thứ không';
MERGE (n:Disease {id: 'D0351'}) SET n.id = 'D0351', n.name = 'Cúm gia cầm (cúm gia cầm)', n.name_en = 'Bird flu (avian influenza)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bird-flu/symptoms-causes/syc-20568390', n.overview = 'Thông tin liên quan Cúm (cúm) - Thông tin liên quan Cúm (cúm) Cúm H1N1 (cúm lợn) - Thông tin liên quan Cúm H1N1 (cúm lợn) Sự khác biệt giữa cúm H1N1 và cúm A là gì? - Thông tin liên quan Sự khác biệt ';
MERGE (n:Disease {id: 'D0352'}) SET n.id = 'D0352', n.name = 'Kiểm soát sinh sản - phương pháp giải phóng chậm', n.name_en = 'Birth control - slow release methods', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007555.htm', n.overview = 'Cấy ghép PROGESTIN Cấy ghép progestin là một que nhỏ được cấy dưới da, thường là ở bên trong cánh tay. Que sẽ giải phóng một lượng nhỏ progestin hàng ngày vào máu. Mất khoảng một phút để chèn thanh. T';
MERGE (n:Disease {id: 'D0353'}) SET n.id = 'D0353', n.name = 'Kiểm soát sinh sản và kế hoạch hóa gia đình', n.name_en = 'Birth control and family planning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001946.htm', n.overview = 'Dưới đây là một số câu hỏi cần cân nhắc khi lựa chọn phương pháp ngừa thai: Phương pháp này ngăn ngừa mang thai hiệu quả như thế nào? Để biết một phương pháp có hiệu quả như thế nào, hãy nhìn vào số l';
MERGE (n:Disease {id: 'D0354'}) SET n.id = 'D0354', n.name = 'Quá liều thuốc tránh thai', n.name_en = 'Birth control pill overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002599.htm', n.prognosis = 'Các triệu chứng nghiêm trọng rất khó xảy ra. Thuốc tránh thai có thể ảnh hưởng đến quá trình chuyển hóa của các loại thuốc khác, điều này có thể dẫn đến các triệu chứng hoặc tác dụng phụ nghiêm trọng ';
MERGE (n:Disease {id: 'D0355'}) SET n.id = 'D0355', n.name = 'Thuốc tránh thai', n.name_en = 'Birth control pills', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007460.htm', n.overview = 'BCP còn được gọi là thuốc tránh thai đường uống hoặc chỉ là "viên thuốc". Nhà cung cấp dịch vụ chăm sóc sức khỏe phải kê toa hầu hết các loại BCP nhưng một loại gần đây đã được Cục Quản lý Thực phẩm v';
MERGE (n:Disease {id: 'D0356'}) SET n.id = 'D0356', n.name = 'Vết bớt - sắc tố', n.name_en = 'Birthmarks - pigmented', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000828.htm', n.prognosis = 'Nốt ruồi lớn xuất hiện khi mới sinh có thể phát triển khối u ác tính, một loại ung thư da. Điều này đặc biệt đúng nếu nốt ruồi chiếm diện tích lớn hơn kích thước nắm tay. Nguy cơ ung thư liên quan đến', n.when_to_see = 'Yêu cầu nhà cung cấp dịch vụ của bạn kiểm tra bất kỳ vết bớt nào. Hãy cho nhà cung cấp dịch vụ của bạn biết về bất kỳ thay đổi nào ở vết bớt, chẳng hạn như sau: Chảy máu Thay đổi màu sắc Viêm ngứa Vết';
MERGE (n:Disease {id: 'D0357'}) SET n.id = 'D0357', n.name = 'Lưỡi lông đen', n.name_en = 'Black hairy tongue', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/black-hairy-tongue/symptoms-causes/syc-20356077', n.overview = 'của tế bào da chết trên các nốt mụn li ti trên lưỡi gọi là u nhú. Thức ăn, đồ uống, thuốc lá, vi khuẩn hoặc nấm men và các chất khác có thể mắc kẹt trên nhú và làm ố chúng. Lưỡi có lông đen là tình tr', n.when_to_see = 'Dù trông không đẹp nhưng lưỡi lông đen thường là một tình trạng vô hại. Nó thường là ngắn hạn khi các bước được thực hiện để loại bỏ hoặc quản lý nguyên nhân. Hãy gặp chuyên gia chăm sóc sức khỏe hoặc';
MERGE (n:Disease {id: 'D0358'}) SET n.id = 'D0358', n.name = 'Ngộ độc bóng đêm đen', n.name_en = 'Black nightshade poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002887.htm', n.prognosis = 'Tình trạng sức khỏe của bạn phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị. Bạn nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Các triệu chứng kéo dài từ 1 đến 3 ngày và có';
MERGE (n:Disease {id: 'D0359'}) SET n.id = 'D0359', n.name = 'Phân đen hoặc hắc ín', n.name_en = 'Black or tarry stools', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003130.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn ngay lập tức nếu: Bạn nhận thấy có máu hoặc thay đổi màu sắc của phân Bạn nôn ra máu Bạn cảm thấy chóng mặt hoặc choáng váng Ở trẻ em, mộ';
MERGE (n:Disease {id: 'D0360'}) SET n.id = 'D0360', n.name = 'Nhện góa phụ đen', n.name_en = 'Black widow spider', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002858.htm', n.prognosis = 'Các triệu chứng nặng thường bắt đầu cải thiện trong vòng 2 đến 3 ngày, nhưng các triệu chứng nhẹ hơn có thể kéo dài trong vài tuần. Cái chết ở một người khỏe mạnh là rất hiếm. Trẻ nhỏ, người bị bệnh n';
MERGE (n:Disease {id: 'D0361'}) SET n.id = 'D0361', n.name = 'Ung thư bàng quang', n.name_en = 'Bladder cancer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/bladder-cancer/symptoms-causes/syc-20356104 | https://medlineplus.gov/ency/article/000486.htm', n.overview = 'Ung thư bàng quang là gì? Chuyên gia của Mayo Clinic giải thích Tìm hiểu thêm về ung thư bàng quang từ bác sĩ tiết niệu Mark Tyson, M.D., M.P.H. Hiển thị bản ghi cho video Ung thư bàng quang là gì? Mộ', n.prognosis = 'Sau khi điều trị ung thư bàng quang, bạn sẽ được bác sĩ theo dõi chặt chẽ. Điều này có thể bao gồm: Chụp CT để kiểm tra sự lây lan hoặc quay trở lại của bệnh ung thư Theo dõi các triệu chứng có thể gợ', n.when_to_see = 'Nếu bạn nhận thấy nước tiểu của mình bị đổi màu và lo ngại nó có thể chứa máu, hãy hẹn gặp bác sĩ để kiểm tra. Ngoài ra, hãy hẹn gặp bác sĩ nếu bạn có các dấu hiệu hoặc triệu chứng khác khiến bạn lo l';
MERGE (n:Disease {id: 'D0362'}) SET n.id = 'D0362', n.name = 'Chứng teo bàng quang', n.name_en = 'Bladder exstrophy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bladder-exstrophy/symptoms-causes/syc-20391299', n.overview = 'ở trẻ gái sinh ra đã bị teo bàng quang, bàng quang nằm ở bên ngoài cơ thể và âm đạo chưa được hình thành đầy đủ. Bác sĩ phẫu thuật bàng quang (trên cùng bên phải), sau đó là phẫu thuật bụng và da (dướ';
MERGE (n:Disease {id: 'D0363'}) SET n.id = 'D0363', n.name = 'Sửa chữa chứng teo bàng quang', n.name_en = 'Bladder exstrophy repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002997.htm', n.overview = 'bao gồm hai ca phẫu thuật. Cuộc phẫu thuật đầu tiên là sửa chữa bàng quang. Thứ hai là gắn các xương chậu lại với nhau. Cuộc phẫu thuật đầu tiên tách bàng quang lộ ra khỏi thành bụng. Bàng quang sau đ', n.prognosis = 'Việc kiểm soát đường tiết niệu thường xảy ra nhất sau khi cổ bàng quang được sửa chữa. Phẫu thuật này không phải lúc nào cũng thành công. Trẻ có thể cần phải lặp lại phẫu thuật sau này. Ngay cả khi ph';
MERGE (n:Disease {id: 'D0364'}) SET n.id = 'D0364', n.name = 'Tắc nghẽn đường ra bàng quang', n.name_en = 'Bladder outlet obstruction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002238.htm', n.prognosis = 'Hầu hết các nguyên nhân gây BOO đều có thể chữa khỏi nếu được chẩn đoán sớm. Tuy nhiên, nếu chẩn đoán hoặc điều trị bị trì hoãn, điều này có thể gây tổn thương vĩnh viễn cho bàng quang hoặc thận.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của BOO.';
MERGE (n:Disease {id: 'D0365'}) SET n.id = 'D0365', n.name = 'Sỏi bàng quang', n.name_en = 'Bladder stones', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/bladder-stones/symptoms-causes/syc-20354339 | https://medlineplus.gov/ency/article/001275.htm', n.overview = 'là những khối khoáng chất cứng hình thành trong bàng quang. Chúng được tạo ra khi các khoáng chất trong nước tiểu tạo thành tinh thể. Điều này thường xảy ra khi bàng quang không rỗng hoàn toàn. Sỏi bà', n.prognosis = 'Hầu hết sỏi bàng quang đều tự đào thải hoặc có thể loại bỏ được. Chúng không gây tổn thương vĩnh viễn cho bàng quang. Họ có thể quay trở lại nếu nguyên nhân không được khắc phục. Nếu không được điều t', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của sỏi bàng quang.';
MERGE (n:Disease {id: 'D0366'}) SET n.id = 'D0366', n.name = 'Blastocystis hominis', n.name_en = 'Blastocystis hominis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/blastocystis-hominis-infection/symptoms-causes/syc-20351205', n.overview = 'Blastocystis là một loại ký sinh trùng cực nhỏ có thể sống trong đường tiêu hóa của bạn. Các nhà nghiên cứu chưa hiểu đầy đủ về vai trò của blastocystis trong việc gây bệnh. Một số người bị tiêu chảy,', n.when_to_see = 'Hãy đi khám bác sĩ nếu bạn có các dấu hiệu và triệu chứng, chẳng hạn như tiêu chảy hoặc đau bụng, kéo dài hơn ba ngày.';
MERGE (n:Disease {id: 'D0367'}) SET n.id = 'D0367', n.name = 'Bệnh blastomycosis', n.name_en = 'Blastomycosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000102.htm', n.prognosis = 'Những người bị vết loét da nhẹ (tổn thương) và nhiễm trùng phổi nhẹ thường hồi phục hoàn toàn. Nhiễm trùng có thể dẫn đến tử vong nếu không được điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh blastomycosis.';
MERGE (n:Disease {id: 'D0368'}) SET n.id = 'D0368', n.name = 'Chảy máu', n.name_en = 'Bleeding', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000045.htm', n.when_to_see = 'Hãy tìm kiếm sự trợ giúp y tế ngay lập tức nếu: Chảy máu không thể kiểm soát được, phải sử dụng garô hoặc nguyên nhân là do chấn thương nghiêm trọng. Vết thương có thể cần phải khâu. Sỏi hoặc bụi bẩn ';
MERGE (n:Disease {id: 'D0369'}) SET n.id = 'D0369', n.name = 'Rối loạn chảy máu', n.name_en = 'Bleeding disorders', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001304.htm', n.prognosis = 'Kết quả tùy thuộc vào chứng rối loạn. Hầu hết các rối loạn chảy máu nguyên phát đều có thể được kiểm soát. Khi rối loạn là do các bệnh, chẳng hạn như DIC, kết quả sẽ phụ thuộc vào mức độ điều trị căn ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy bất kỳ hiện tượng chảy máu bất thường hoặc nghiêm trọng nào.';
MERGE (n:Disease {id: 'D0370'}) SET n.id = 'D0370', n.name = 'Chảy máu do giãn tĩnh mạch thực quản', n.name_en = 'Bleeding esophageal varices', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000268.htm', n.prognosis = 'Chảy máu thường tái phát dù có hoặc không điều trị. Giãn tĩnh mạch thực quản chảy máu là một biến chứng nghiêm trọng của bệnh gan và có kết quả kém. Việc đặt shunt có thể dẫn đến sự gia tăng các chất ', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ của bạn hoặc đến phòng cấp cứu nếu bạn nôn ra máu hoặc đi ngoài phân màu đen như hắc ín.';
MERGE (n:Disease {id: 'D0371'}) SET n.id = 'D0371', n.name = 'Chảy máu nướu răng', n.name_en = 'Bleeding gums', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003062.htm', n.when_to_see = 'Hãy tham khảo ý kiến ​​bác sĩ nếu: Chảy máu nghiêm trọng hoặc lâu dài (mãn tính) Nướu của bạn tiếp tục chảy máu ngay cả sau khi điều trị Bạn có các triệu chứng chảy máu không rõ nguyên nhân khác';
MERGE (n:Disease {id: 'D0372'}) SET n.id = 'D0372', n.name = 'Chảy máu dưới da', n.name_en = 'Bleeding into the skin', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003235.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị chảy máu đột ngột vào da mà không có lý do rõ ràng Bạn nhận thấy vết bầm tím không rõ nguyên nhân mà không có biến đi';
MERGE (n:Disease {id: 'D0373'}) SET n.id = 'D0373', n.name = 'Viêm bờ mi', n.name_en = 'Blepharitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/blepharitis/symptoms-causes/syc-20370141 | https://medlineplus.gov/ency/article/001619.htm', n.overview = '(blef-uh-RYE-tis) là tình trạng gây sưng, ngứa và các kích ứng khác ở mí mắt. Viêm bờ mi thường ảnh hưởng đến cả hai mắt dọc theo mép mí mắt. Viêm bờ mi có thể do vi khuẩn thường vô hại trên mí mắt tr', n.prognosis = 'Kết quả điều trị thường tốt nhất. Bạn có thể cần giữ cho mí mắt sạch sẽ để ngăn vấn đề tái phát. Tiếp tục điều trị sẽ làm dịu vết đỏ và giúp mắt bạn dễ chịu hơn. Styes và chalazia phổ biến hơn ở những', n.when_to_see = 'Nếu bạn có các triệu chứng viêm bờ mi không cải thiện khi tắm hoặc rửa thường xuyên, hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn.';
MERGE (n:Disease {id: 'D0374'}) SET n.id = 'D0374', n.name = 'Mù và giảm thị lực', n.name_en = 'Blindness and vision loss', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003040.htm', n.when_to_see = 'Mất thị lực đột ngột luôn là tình trạng khẩn cấp, ngay cả khi bạn chưa mất thị lực hoàn toàn. Bạn đừng bao giờ bỏ qua tình trạng mất thị lực vì nghĩ rằng nó sẽ tốt hơn. Liên hệ với bác sĩ nhãn khoa ho';
MERGE (n:Disease {id: 'D0375'}) SET n.id = 'D0375', n.name = 'Tắc nghẽn đường hô hấp trên', n.name_en = 'Blockage of upper airway', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000067.htm', n.prognosis = 'Điều trị kịp thời thường thành công. Nhưng tình trạng này rất nguy hiểm và có thể gây tử vong ngay cả khi được điều trị.', n.when_to_see = 'Tắc nghẽn đường thở thường là trường hợp khẩn cấp. Gọi 911 hoặc số khẩn cấp tại địa phương để được trợ giúp y tế. Làm theo hướng dẫn về cách giúp nạn nhân thở cho đến khi có sự trợ giúp.';
MERGE (n:Disease {id: 'D0376'}) SET n.id = 'D0376', n.name = 'Ống dẫn nước mắt bị tắc', n.name_en = 'Blocked tear duct', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/blocked-tear-duct/symptoms-causes/syc-20351369 | https://medlineplus.gov/ency/article/001016.htm', n.overview = 'Khi ống dẫn nước mắt bị tắc, nước mắt không thể chảy ra theo cách thông thường, khiến mắt bị chảy nước và khó chịu. Tình trạng này xảy ra do tắc nghẽn một phần hoặc toàn bộ hệ thống thoát nước mắt. Ốn', n.prognosis = 'Đối với trẻ sơ sinh, ống dẫn nước mắt bị tắc thường sẽ tự biến mất trước khi trẻ được 1 tuổi. Nếu không, kết quả vẫn có thể tốt khi thăm dò. Ở người lớn, tình trạng ống dẫn nước mắt bị tắc sẽ khác nha', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu mắt bạn chảy nước mắt liên tục trong vài ngày hoặc nếu mắt bạn bị nhiễm trùng thường xuyên hoặc liên tục. Ống dẫn nước mắt bị tắc có thể do khối u đè lên hệ th';
MERGE (n:Disease {id: 'D0377'}) SET n.id = 'D0377', n.name = 'Cục máu đông', n.name_en = 'Blood clots', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001124.htm';
MERGE (n:Disease {id: 'D0378'}) SET n.id = 'D0378', n.name = 'Có máu trong tinh dịch', n.name_en = 'Blood in the semen', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003163.htm', n.when_to_see = 'Luôn liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy có máu trong tinh dịch.';
MERGE (n:Disease {id: 'D0379'}) SET n.id = 'D0379', n.name = 'Máu trong nước tiểu (tiểu máu)', n.name_en = 'Blood in urine (hematuria)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/blood-in-urine/symptoms-causes/syc-20353432', n.overview = 'Có thể đáng sợ khi thấy máu trong nước tiểu, còn gọi là tiểu máu. Trong nhiều trường hợp, nguyên nhân là vô hại. Nhưng máu trong nước tiểu cũng có thể là dấu hiệu của một căn bệnh nghiêm trọng. Nếu bạ', n.when_to_see = 'Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe bất cứ khi nào nước tiểu có vẻ như có máu trong đó. Nước tiểu màu đỏ không phải lúc nào cũng do hồng cầu gây ra. Một số loại thuốc có thể khiến nước ';
MERGE (n:Disease {id: 'D0380'}) SET n.id = 'D0380', n.name = 'Máy đo huyết áp tại nhà', n.name_en = 'Blood pressure monitors for home', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007482.htm', n.overview = 'Máy đo huyết áp bạn chọn phải có chất lượng tốt, vừa vặn và dễ sử dụng. MÁY THEO DÕI Huyết Áp THỦ CÔNG Các thiết bị thủ công bao gồm một vòng bít quấn quanh cánh tay của bạn, một bầu bóp cao su và một';
MERGE (n:Disease {id: 'D0381'}) SET n.id = 'D0381', n.name = 'Bệnh Blount', n.name_en = 'Blount disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001584.htm', n.prognosis = 'Nếu chân có thể được đặt vào đúng vị trí thì triển vọng sẽ tốt. Chân phải hoạt động bình thường và trông bình thường.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu chân hoặc các chân của con bạn có vẻ bị cong. Đồng thời liên hệ với nhà cung cấp nếu con bạn bị cong chân và có vẻ ngày càng nặng';
MERGE (n:Disease {id: 'D0382'}) SET n.id = 'D0382', n.name = 'Da đổi màu xanh', n.name_en = 'Blue discoloration of the skin', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003215.htm', n.when_to_see = 'Da xanh có thể là dấu hiệu của nhiều vấn đề y tế nghiêm trọng. Liên hệ hoặc ghé thăm nhà cung cấp của bạn. Đối với người lớn, hãy liên hệ với nhà cung cấp dịch vụ của bạn hoặc gọi đến số khẩn cấp tại ';
MERGE (n:Disease {id: 'D0383'}) SET n.id = 'D0383', n.name = 'Ngộ độc bóng đêm xanh', n.name_en = 'Blue nightshade poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002888.htm', n.prognosis = 'Tình trạng sức khỏe của bạn phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận nhanh như thế nào. Bạn nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Các triệu ch';
MERGE (n:Disease {id: 'D0384'}) SET n.id = 'D0384', n.name = 'Rối loạn dị dạng cơ thể', n.name_en = 'Body dysmorphic disorder', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/body-dysmorphic-disorder/symptoms-causes/syc-20353938', n.overview = 'là một tình trạng sức khỏe tâm thần mà bạn không thể ngừng suy nghĩ về một hoặc nhiều khiếm khuyết hoặc khuyết điểm được nhận thấy trên ngoại hình của mình - một khuyết điểm có vẻ nhỏ hoặc không được ', n.when_to_see = 'Sự xấu hổ và bối rối về ngoại hình của mình có thể khiến bạn không thể tìm cách điều trị chứng rối loạn dị dạng cơ thể. Nhưng nếu bạn có bất kỳ dấu hiệu hoặc triệu chứng nào, hãy đến gặp nhà cung cấp ';
MERGE (n:Disease {id: 'D0385'}) SET n.id = 'D0385', n.name = 'Chấy rận', n.name_en = 'Body lice', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/body-lice/symptoms-causes/syc-20350310 | https://medlineplus.gov/ency/article/000838.htm', n.overview = 'là loài côn trùng nhỏ không có cánh. Chấy sống trên quần áo và chăn ga gối đệm. Nhiều lần trong ngày, chúng di chuyển đến da để hút máu. Chúng thường cắn ở những nơi đường may quần áo chạm vào da. Chấ', n.prognosis = 'Bằng cách thực hiện các bước nêu trên, chấy rận có thể bị tiêu diệt hoàn toàn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có chấy rận trên quần áo hoặc tình trạng ngứa không biến mất.';
MERGE (n:Disease {id: 'D0386'}) SET n.id = 'D0386', n.name = 'Chỉ số khối cơ thể', n.name_en = 'Body mass index', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007196.htm', n.overview = 'Việc béo phì khiến tim bạn căng thẳng và có thể dẫn đến các vấn đề sức khỏe nghiêm trọng . Chúng bao gồm: Viêm khớp ở đầu gối và hông Bệnh tim Huyết áp cao Ngưng thở khi ngủ Tiểu đường loại 2 Giãn tĩn';
MERGE (n:Disease {id: 'D0387'}) SET n.id = 'D0387', n.name = 'Nhọt', n.name_en = 'Boils', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001474.htm', n.prognosis = 'Một số người bị mụn nhọt nhiều lần. Nhọt ở những vùng như ống tai hoặc mũi có thể rất đau. Nhọt hình thành gần nhau có thể mở rộng và nối với nhau, gây ra tình trạng gọi là bệnh carbunculosis.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu mụn nhọt: Xuất hiện trên mặt hoặc cột sống của bạn Xảy ra cùng với sốt, các vệt đỏ chảy ra từ vết loét, tích tụ nhiều chất lỏng trong khu vực hoặc các triệ';
MERGE (n:Disease {id: 'D0388'}) SET n.id = 'D0388', n.name = 'Nhọt và nhọt', n.name_en = 'Boils and carbuncles', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/boils-and-carbuncles/symptoms-causes/syc-20353770', n.overview = 'Nhọt là một vết sưng đau, đầy mủ hình thành dưới da khi vi khuẩn lây nhiễm và làm viêm một hoặc nhiều nang lông của bạn. Nhọt là một cụm mụn nhọt tạo thành một vùng nhiễm trùng liên kết dưới da. Nhọt ', n.when_to_see = 'Bạn thường có thể tự chăm sóc cho một vết nhọt nhỏ. Nhưng hãy đến gặp bác sĩ nếu bạn bị nhiều mụn nhọt cùng một lúc hoặc nếu nhọt: Xuất hiện trên mặt hoặc ảnh hưởng đến thị lực của bạn Xấu đi nhanh ch';
MERGE (n:Disease {id: 'D0389'}) SET n.id = 'D0389', n.name = 'Ung thư xương', n.name_en = 'Bone cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bone-cancer/symptoms-causes/syc-20350217', n.overview = 'là sự phát triển của các tế bào bắt đầu trong xương. Ung thư xương có thể bắt đầu ở bất kỳ xương nào. Nhưng nó thường ảnh hưởng đến xương đùi nhất. Thuật ngữ “ung thư xương” không bao gồm ung thư bắt ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
';
MERGE (n:Disease {id: 'D0390'}) SET n.id = 'D0390', n.name = 'Ghép xương', n.name_en = 'Bone graft', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002963.htm', n.overview = 'Một mảnh ghép xương có thể được lấy từ xương khỏe mạnh của chính người đó (điều này được gọi là ghép tự thân). Hoặc, nó có thể được lấy từ xương hiến tặng đông lạnh (đồng loại). Trong một số trường hợ', n.prognosis = 'Hầu hết các mảnh ghép xương đều giúp khiếm khuyết xương lành lại với ít nguy cơ bị đào thải mảnh ghép.';
MERGE (n:Disease {id: 'D0391'}) SET n.id = 'D0391', n.name = 'Ghép tủy xương', n.name_en = 'Bone marrow transplant', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003009.htm', n.overview = 'Trước khi cấy ghép, có thể thực hiện hóa trị, xạ trị hoặc cả hai. Điều này có thể được thực hiện theo hai cách: Điều trị xâm lấn (tiêu hủy tủy) - Hóa trị, xạ trị liều cao hoặc cả hai được dùng để tiêu', n.prognosis = 'Tình trạng sức khỏe của bạn sau khi cấy ghép phụ thuộc vào: Loại cấy ghép tủy xương Tế bào của người hiến tặng phù hợp với tế bào của bạn như thế nào Loại ung thư hoặc bệnh tật mà bạn mắc phải Tuổi và';
MERGE (n:Disease {id: 'D0392'}) SET n.id = 'D0392', n.name = 'Di căn xương', n.name_en = 'Bone metastasis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bone-metastasis/symptoms-causes/syc-20370191', n.overview = 'xảy ra khi các tế bào ung thư tách ra khỏi nơi chúng bắt đầu và lan sang xương. Di căn là thuật ngữ y học để chỉ căn bệnh lây lan sang một khu vực cách xa nơi nó bắt đầu. Khi ung thư lây lan, các chuy', n.when_to_see = 'Nếu bạn có các triệu chứng kéo dài khiến bạn lo lắng, hãy đặt lịch hẹn với bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác. Nếu trước đây bạn đã từng điều trị bệnh ung thư, hãy cho nhóm chăm sóc sức khỏ';
MERGE (n:Disease {id: 'D0393'}) SET n.id = 'D0393', n.name = 'Đau xương hoặc đau nhức', n.name_en = 'Bone pain or tenderness', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003180.htm', n.when_to_see = 'Bị đau xương hoặc sự dịu dàng rất nghiêm túc. Liên hệ với nhà cung cấp của bạn nếu bạn bị đau xương không rõ nguyên nhân.';
MERGE (n:Disease {id: 'D0394'}) SET n.id = 'D0394', n.name = 'Gai xương', n.name_en = 'Bone spurs', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bone-spurs/symptoms-causes/syc-20370212', n.overview = 'là sự phát triển của xương hình thành dọc theo các mép xương. Chúng còn được gọi là loãng xương. Gai xương thường hình thành ở nơi xương gặp nhau - ở khớp. Chúng cũng có thể hình thành trên xương cột ', n.when_to_see = 'Hãy khám sức khỏe nếu bạn bị: Đau hoặc sưng ở một hoặc nhiều khớp. Rắc rối khi di chuyển khớp. Yếu hoặc mất cảm giác ở cánh tay hoặc chân.';
MERGE (n:Disease {id: 'D0395'}) SET n.id = 'D0395', n.name = 'Khối u xương', n.name_en = 'Bone tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001230.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào loại khối u xương. Kết quả thường tốt ở những người có khối u không phải ung thư (lành tính). Nhưng một số khối u xương lành tính có thể biến thành ung thư. Những', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của khối u xương.';
MERGE (n:Disease {id: 'D0396'}) SET n.id = 'D0396', n.name = 'Rối loạn nhân cách ranh giới', n.name_en = 'Borderline personality disorder', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/borderline-personality-disorder/symptoms-causes/syc-20370237 | https://medlineplus.gov/ency/article/000935.htm', n.overview = 'là một tình trạng sức khỏe tâm thần ảnh hưởng đến cách mọi người cảm nhận về bản thân và người khác, khiến họ khó hoạt động trong cuộc sống hàng ngày. Nó bao gồm một kiểu mẫu các mối quan hệ không ổn ', n.prognosis = 'Triển vọng của việc điều trị phụ thuộc vào mức độ nghiêm trọng của tình trạng và liệu người đó có sẵn sàng chấp nhận sự giúp đỡ hay không. Với liệu pháp nói chuyện dài hạn, người bệnh thường dần dần c', n.when_to_see = 'Hãy gặp bác sĩ nếu bạn hoặc ai đó bạn biết có các triệu chứng rối loạn nhân cách ranh giới. Điều đặc biệt quan trọng là tìm kiếm sự giúp đỡ ngay lập tức nếu bạn hoặc ai đó bạn biết đang có ý nghĩ tự t';
MERGE (n:Disease {id: 'D0397'}) SET n.id = 'D0397', n.name = 'Ngộ độc axit boric', n.name_en = 'Boric acid poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002485.htm', n.prognosis = 'Tỷ lệ tử vong ở trẻ sơ sinh do ngộ độc axit boric rất cao. Tuy nhiên, ngộ độc axit boric hiếm hơn đáng kể so với trước đây vì chất này không còn được sử dụng làm chất khử trùng trong vườn ươm. Nó cũng';
MERGE (n:Disease {id: 'D0398'}) SET n.id = 'D0398', n.name = 'Tiêm độc tố Botulinum - thanh quản', n.name_en = 'Botulinum toxin injection - larynx', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007637.htm', n.overview = 'BTX được tiêm vào các cơ xung quanh dây thanh âm. Điều này làm suy yếu các cơ và cải thiện chất lượng giọng nói. Nó không phải là thuốc chữa chứng loạn trương lực thanh quản nhưng có thể giúp giảm bớt', n.prognosis = 'Trong hầu hết các trường hợp, việc tiêm BTX sẽ cải thiện chất lượng giọng nói của bạn trong khoảng 3 đến 4 tháng. Để duy trì giọng nói của mình, bạn có thể cần tiêm thuốc vài tháng một lần. Nhà cung c';
MERGE (n:Disease {id: 'D0399'}) SET n.id = 'D0399', n.name = 'Bệnh ngộ độc', n.name_en = 'Botulism', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/botulism/symptoms-causes/syc-20370262 | https://medlineplus.gov/ency/article/000598.htm', n.overview = 'là một tình trạng hiếm gặp nhưng nghiêm trọng. Một chất độc tấn công các dây thần kinh của cơ thể gây ra nó. Một loại vi khuẩn có tên Clostridium botulinum tạo ra độc tố. Chất độc này được gọi là độc ', n.prognosis = 'Điều trị kịp thời giúp giảm đáng kể nguy cơ tử vong.', n.when_to_see = 'Hãy nhận sự chăm sóc y tế ngay lập tức nếu bạn cho rằng mình mắc bệnh ngộ độc. Điều trị nhanh chóng làm tăng cơ hội sống sót và giảm nguy cơ biến chứng. Được chăm sóc y tế nhanh chóng cũng có thể cho ';
MERGE (n:Disease {id: 'D0400'}) SET n.id = 'D0400', n.name = 'Đại tiện không tự chủ', n.name_en = 'Bowel incontinence', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003135.htm', n.when_to_see = 'Hãy báo cáo bất kỳ vấn đề nào về tình trạng không tự chủ được đại tiện cho nhà cung cấp dịch vụ của bạn. Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Một đứa trẻ đã được tập đi vệ sinh bị són phâ';
MERGE (n:Disease {id: 'D0401'}) SET n.id = 'D0401', n.name = 'Rèn luyện ruột', n.name_en = 'Bowel retraining', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003971.htm', n.overview = 'Các vấn đề có thể được hưởng lợi từ việc rèn luyện ruột bao gồm: Đại tiện không tự chủ, tức là mất kiểm soát ruột, khiến bạn đi đại tiện một cách bất ngờ và không chủ ý. Điều này có thể bao gồm từ việ';
MERGE (n:Disease {id: 'D0402'}) SET n.id = 'D0402', n.name = 'Chân vòng kiềng', n.name_en = 'Bowlegs', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001585.htm', n.prognosis = 'Trong nhiều trường hợp, kết quả là tốt và thường không có vấn đề gì khi đi lại.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn có biểu hiện chân vòng kiềng liên tục hoặc ngày càng trầm trọng hơn sau 3 tuổi.';
MERGE (n:Disease {id: 'D0403'}) SET n.id = 'D0403', n.name = 'Bệnh đám rối cánh tay', n.name_en = 'Brachial plexopathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001418.htm', n.prognosis = 'Có thể phục hồi tốt nếu tìm ra nguyên nhân và điều trị đúng cách. Trong một số trường hợp, mất một phần hoặc toàn bộ khả năng vận động hoặc cảm giác. Đau dây thần kinh có thể nghiêm trọng và có thể ké', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn cảm thấy đau, tê, ngứa ran hoặc yếu ở vai, cánh tay hoặc bàn tay.';
MERGE (n:Disease {id: 'D0404'}) SET n.id = 'D0404', n.name = 'Đám rối cánh tay', n.name_en = 'Brachial plexus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002239.htm', n.overview = 'Tổn thương dây thần kinh đám rối cánh tay có thể gây ra các vấn đề về cơ và cảm giác thường đi kèm với đau ở cùng một khu vực. Các triệu chứng có thể bao gồm: Mất cảm giác hoặc cảm giác ở cánh tay hoặ';
MERGE (n:Disease {id: 'D0405'}) SET n.id = 'D0405', n.name = 'Chấn thương đám rối cánh tay', n.name_en = 'Brachial plexus injury', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/brachial-plexus-injury/symptoms-causes/syc-20350235', n.overview = 'Đám rối cánh tay là nhóm dây thần kinh gửi tín hiệu từ tủy sống đến vai, cánh tay và bàn tay. Chấn thương đám rối cánh tay xảy ra khi các dây thần kinh này bị kéo căng, ép lại với nhau hoặc trong trườ', n.when_to_see = 'Chấn thương đám rối cánh tay có thể gây ra tình trạng yếu hoặc tàn tật kéo dài. Ngay cả khi vấn đề của bạn có vẻ nhỏ, bạn có thể cần được chăm sóc y tế. Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe ';
MERGE (n:Disease {id: 'D0406'}) SET n.id = 'D0406', n.name = 'Chấn thương đám rối cánh tay ở trẻ sơ sinh', n.name_en = 'Brachial plexus injury in newborns', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001395.htm', n.prognosis = 'Hầu hết các bé sẽ hồi phục hoàn toàn trong vòng 3 đến 4 tháng. Những người không hồi phục trong thời gian này có triển vọng phục hồi hoàn toàn kém. Trong những trường hợp này, có thể có sự tách rời rễ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu trẻ sơ sinh của bạn không cử động được cánh tay.';
MERGE (n:Disease {id: 'D0407'}) SET n.id = 'D0407', n.name = 'Nhịp tim chậm', n.name_en = 'Bradycardia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bradycardia/symptoms-causes/syc-20355474', n.overview = 'l nhịp tim thường bắt đầu ở khu vực của tim gọi là nút xoang. Nhịp tim điển hình được thể hiện trong hình bên trái. Nhịp tim chậm (brad-e-KAHR-dee-uh) là nhịp tim chậm. Tim của người trưởng thành khi ', n.when_to_see = 'Nhiều thứ có thể gây ra triệu chứng nhịp tim chậm. Điều quan trọng là phải chẩn đoán nhanh, chính xác và chăm sóc thích hợp. Hãy hẹn khám sức khỏe nếu bạn lo lắng về nhịp tim chậm. Nếu bạn ngất xỉu, k';
MERGE (n:Disease {id: 'D0408'}) SET n.id = 'D0408', n.name = 'Áp xe não', n.name_en = 'Brain abscess', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000783.htm', n.prognosis = 'Nếu không được điều trị, áp xe não hầu như luôn gây tử vong. Nếu được điều trị, tỷ lệ tử vong là khoảng 10% đến 30%. Càng nhận được điều trị sớm thì càng tốt. Một số người có thể bị tổn thương não hoặ', n.when_to_see = 'Hãy đến phòng cấp cứu của bệnh viện hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn có các triệu chứng của áp xe não.';
MERGE (n:Disease {id: 'D0409'}) SET n.id = 'D0409', n.name = 'Chứng phình động mạch não', n.name_en = 'Brain aneurysm', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/brain-aneurysm/symptoms-causes/syc-20361483', n.overview = 'thành mạch. Thành của chứng phình động mạch có thể đủ mỏng để vỡ. Hình minh họa cho thấy một cá nhân bị chứng phình động mạch chưa vỡ. Hình nhỏ cho thấy điều gì xảy ra khi chứng phình động mạch bị vỡ.', n.when_to_see = 'Tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn bị đau đầu đột ngột, cực kỳ nghiêm trọng. Nếu bạn đang ở cùng với người phàn nàn về cơn đau đầu đột ngột, dữ dội hoặc bất tỉnh hoặc lên cơn co giật, hãy ';
MERGE (n:Disease {id: 'D0410'}) SET n.id = 'D0410', n.name = 'Sửa chữa chứng phình động mạch não', n.name_en = 'Brain aneurysm repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007372.htm', n.overview = 'Có hai phương pháp phổ biến được sử dụng để sửa chữa chứng phình động mạch: Việc cắt bỏ được thực hiện trong quá trình phẫu thuật mở hộp sọ. Sửa chữa nội mạch (phẫu thuật), thường sử dụng cuộn dây hoặ', n.prognosis = 'Sau khi phẫu thuật thành công chứng phình động mạch chảy máu, việc chảy máu trở lại là điều hiếm gặp. Triển vọng cũng phụ thuộc vào việc tổn thương não xảy ra do chảy máu trước, trong hoặc sau phẫu th';
MERGE (n:Disease {id: 'D0411'}) SET n.id = 'D0411', n.name = 'Não AVM (dị tật động tĩnh mạch)', n.name_en = 'Brain AVM (arteriovenous malformation)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/brain-avm/symptoms-causes/syc-20350260', n.overview = 'Não AVM được truyền tĩnh mạch qua các mạch máu rối rắm. Điều này làm gián đoạn quá trình điển hình về cách máu lưu thông qua não. Mạch máu trong não được định hình AVM, máu đi trực tiếp từ động mạch đ', n.when_to_see = 'Hãy nhận sự chăm sóc y tế ngay lập tức nếu bạn nhận thấy bất kỳ triệu chứng nào của AVM não, chẳng hạn như co giật, đau đầu hoặc các triệu chứng khác. AVM não chảy máu rất nguy hiểm và cần được chăm s';
MERGE (n:Disease {id: 'D0412'}) SET n.id = 'D0412', n.name = 'Thoát vị não', n.name_en = 'Brain herniation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001421.htm', n.prognosis = 'Những người bị thoát vị não thường bị chấn thương sọ não nặng. Họ có thể có ít cơ hội phục hồi do chấn thương gây ra thoát vị. Khi thoát vị xảy ra, nó càng làm giảm cơ hội phục hồi. Triển vọng khác nh', n.when_to_see = 'Hãy gọi 911 hoặc số điện thoại cấp cứu tại địa phương hoặc đưa người đó đến phòng cấp cứu của bệnh viện nếu họ giảm tỉnh táo hoặc có các triệu chứng khác, đặc biệt nếu người đó bị chấn thương ở đầu ho';
MERGE (n:Disease {id: 'D0413'}) SET n.id = 'D0413', n.name = 'Di căn não', n.name_en = 'Brain metastases', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/brain-metastases/symptoms-causes/syc-20350136', n.overview = 'đến bất kỳ nơi nào trong cơ thể và lây lan (di căn) lên não. Mayo Clinic Connect: Khối u não Di căn não là bệnh ung thư đã di căn đến não từ một bộ phận khác của cơ thể. Đôi khi chúng được gọi là cuộc', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng mới, liên tục hoặc trầm trọng hơn khiến bạn lo lắng, đặc biệt là các triệu chứng liên quan đến đau đầu, co giật, suy nghĩ, t';
MERGE (n:Disease {id: 'D0414'}) SET n.id = 'D0414', n.name = 'Phẫu thuật não', n.name_en = 'Brain surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003018.htm', n.overview = 'Bạn có thể thức hoặc ngủ trong quá trình thực hiện thủ thuật này được gọi là phẫu thuật cắt sọ. Phẫu thuật mở hộp sọ tỉnh được thực hiện khi bác sĩ phẫu thuật làm việc gần các khu vực quan trọng của n', n.prognosis = 'Tình trạng của bạn như thế nào sau phẫu thuật não tùy thuộc vào tình trạng đang được điều trị, sức khỏe chung của bạn, phần nào của não có liên quan và loại phẫu thuật cụ thể.';
MERGE (n:Disease {id: 'D0415'}) SET n.id = 'D0415', n.name = 'Khối u não', n.name_en = 'Brain tumor', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/brain-tumor/symptoms-causes/syc-20350084', n.overview = 'nó có thể bắt đầu ở nơi khác và lan đến não. Khi khối u phát triển, nó tạo ra áp lực và thay đổi chức năng của các mô não xung quanh, gây ra các dấu hiệu và triệu chứng như đau đầu, buồn nôn và các vấ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có các dấu hiệu và triệu chứng dai dẳng khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập ';
MERGE (n:Disease {id: 'D0416'}) SET n.id = 'D0416', n.name = 'U não - trẻ em', n.name_en = 'Brain tumor - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000768.htm', n.prognosis = 'Sức khỏe của trẻ phụ thuộc vào nhiều thứ, bao gồm cả loại khối u. Nói chung, khoảng 3 trong số 4 trẻ em sống sót ít nhất 5 năm sau khi được chẩn đoán. Các vấn đề về não và hệ thần kinh lâu dài có thể ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp nếu trẻ bị đau đầu không biến mất hoặc có các triệu chứng khác của khối u não. Hãy đến phòng cấp cứu nếu trẻ có bất kỳ dấu hiệu nào sau đây: Suy nhược cơ thể Thay đổi hành';
MERGE (n:Disease {id: 'D0417'}) SET n.id = 'D0417', n.name = 'Khối u não - nguyên phát - người lớn', n.name_en = 'Brain tumor - primary - adults', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007222.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn phát triển bất kỳ cơn đau đầu mới, dai dẳng nào hoặc các triệu chứng khác của khối u não. Liên hệ với nhà cung cấp của bạn hoặc đến phòng cấp cứu n';
MERGE (n:Disease {id: 'D0418'}) SET n.id = 'D0418', n.name = 'Khối u thân não', n.name_en = 'Brainstem tumor', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/brainstem-tumor/symptoms-causes/syc-20595061', n.overview = 'Khối u thân não là sự phát triển ở não giữa, cầu não hoặc tủy. Ba khu vực này kết nối não với tủy sống và hướng dẫn nhiều chức năng thiết yếu. Hầu hết các khối u thân não là u thần kinh đệm. Chúng bao', n.when_to_see = 'Bạn nên tìm kiếm sự chăm sóc nếu nhận thấy các triệu chứng mới ảnh hưởng đến cử động, thăng bằng, chuyển động của mắt, lời nói, khả năng nuốt hoặc sức mạnh. Những triệu chứng này có thể xuất hiện đột ';
MERGE (n:Disease {id: 'D0419'}) SET n.id = 'D0419', n.name = 'U nang khe hở nhánh', n.name_en = 'Branchial cleft cyst', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001396.htm', n.prognosis = 'Phẫu thuật thường thành công và có kết quả tốt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để lấy hẹn nếu bạn nhận thấy có một vết lõm nhỏ, khe hở hoặc cục u ở cổ hoặc vai trên của con bạn, đặc biệt nếu chất lỏng chảy ra từ khu vực này.';
MERGE (n:Disease {id: 'D0420'}) SET n.id = 'D0420', n.name = 'Phẫu thuật nâng ngực', n.name_en = 'Breast augmentation surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002984.htm', n.overview = 'Nâng ngực được thực hiện bằng cách đặt túi độn phía sau mô vú hoặc dưới cân cơ hoặc cơ ngực. Túi cấy ghép là một túi chứa đầy nước muối vô trùng (nước muối) hoặc vật liệu gọi là silicone. Phẫu thuật đ', n.prognosis = 'Bạn có thể sẽ có kết quả rất tốt sau phẫu thuật vú. Bạn có thể cảm thấy tốt hơn về ngoại hình và bản thân. Ngoài ra, mọi cơn đau hoặc triệu chứng về da do phẫu thuật có thể sẽ biến mất. Bạn có thể cần';
MERGE (n:Disease {id: 'D0421'}) SET n.id = 'D0421', n.name = 'Ung thư vú', n.name_en = 'Breast cancer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/breast-cancer/symptoms-causes/syc-20352470 | https://medlineplus.gov/ency/article/000913.htm', n.overview = 'Vấn đề về giải phẫu vú, được sắp xếp giống như những cánh hoa cúc. Các thùy lại được chia thành các thùy nhỏ hơn để sản xuất sữa cho con bú. Những ống nhỏ, gọi là ống dẫn, dẫn sữa đến một bể chứa nằm ', n.prognosis = 'Các phương pháp điều trị mới, cải tiến đang giúp những người mắc bệnh ung thư vú sống lâu hơn. Ngay cả khi được điều trị, ung thư vú vẫn có thể lan sang các bộ phận khác của cơ thể. Đôi khi, ung thư v', n.when_to_see = 'Nếu bạn tìm thấy một khối u hoặc thay đổi khác ở vú, hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác. Đừng đợi lần chụp X-quang tuyến vú tiếp theo để xem liệu thay đổi bạn tìm thấy có phải l';
MERGE (n:Disease {id: 'D0422'}) SET n.id = 'D0422', n.name = 'Ung thư vú ở nam giới', n.name_en = 'Breast cancer in men', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007653.htm', n.prognosis = 'Triển vọng lâu dài cho nam giới mắc bệnh ung thư vú là tuyệt vời khi ung thư được phát hiện và điều trị sớm. Khoảng 91% nam giới được điều trị trước khi ung thư lan sang các khu vực khác trên cơ thể s', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn nhận thấy điều gì đó bất thường ở vú của mình, bao gồm bất kỳ cục u, thay đổi nào trên da hoặc tiết dịch.';
MERGE (n:Disease {id: 'D0423'}) SET n.id = 'D0423', n.name = 'U nang vú', n.name_en = 'Breast cysts', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/breast-cysts/symptoms-causes/syc-20370284', n.overview = 'U nang vú sẽ hơi nhẹ khi bạn ấn vào nó. U nang vú là những túi chứa đầy chất lỏng bên trong vú. Chúng thường không phải ung thư (lành tính). Bạn có thể có một hoặc nhiều u nang vú. U nang vú thường có', n.when_to_see = 'Mô vú bình thường thường có cảm giác sần hoặc có nốt sần. Nhưng nếu bạn cảm thấy một khối u vú mới không biến mất, ngày càng lớn hơn hoặc tồn tại dai dẳng sau một hoặc hai chu kỳ kinh nguyệt, hãy đến ';
MERGE (n:Disease {id: 'D0424'}) SET n.id = 'D0424', n.name = 'Vú to ở nam giới', n.name_en = 'Breast enlargement in males', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003165.htm', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Bạn Gần đây bị sưng, đau hoặc phì đại ở một hoặc cả hai vú Núm vú chảy dịch sẫm màu hoặc có máu Có vết loét hoặc loét da trên vú Khối u ở vú có cảm giác cứng hoặc';
MERGE (n:Disease {id: 'D0425'}) SET n.id = 'D0425', n.name = 'Nhiễm trùng vú', n.name_en = 'Breast infection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001490.htm', n.prognosis = 'Tình trạng này thường khỏi nhanh chóng khi điều trị bằng kháng sinh.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Bất kỳ phần nào của mô vú của bạn trở nên đỏ, mềm, sưng hoặc nóng Bạn đang cho con bú và phát triển sốt cao Các hạch bạch huyết ở nách của bạn trở nên mềm hoặc sư';
MERGE (n:Disease {id: 'D0426'}) SET n.id = 'D0426', n.name = 'Nâng ngực', n.name_en = 'Breast lift', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007402.htm', n.overview = 'Phẫu thuật thẩm mỹ ngực có thể được thực hiện tại phòng khám phẫu thuật ngoại trú hoặc tại bệnh viện. Bạn có thể sẽ được gây mê toàn thân. Phương pháp này sử dụng các loại thuốc giúp bạn ngủ ngon và k', n.prognosis = 'Bạn có thể sẽ nhận được kết quả rất tốt sau phẫu thuật ngực. Bạn có thể cảm thấy tốt hơn về ngoại hình và bản thân. Sẹo là vĩnh viễn và thường rất rõ ràng cho đến một năm sau phẫu thuật. Sau một năm, ';
MERGE (n:Disease {id: 'D0427'}) SET n.id = 'D0427', n.name = 'Khối u vú', n.name_en = 'Breast lump', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003155.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Da trên vú của bạn xuất hiện lúm đồng tiền hoặc nhăn nheo (như vỏ cam). Bạn tìm thấy một khối u vú mới trong quá trình tự kiểm tra. Bạn bị bầm tím ở n';
MERGE (n:Disease {id: 'D0428'}) SET n.id = 'D0428', n.name = 'Loại bỏ khối u ở vú', n.name_en = 'Breast lump removal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002918.htm', n.overview = 'Đôi khi, nhà cung cấp dịch vụ chăm sóc sức khỏe không thể cảm nhận được khối u khi khám cho bạn. Tuy nhiên, nó có thể được nhìn thấy trên các kết quả hình ảnh, chẳng hạn như chụp quang tuyến vú hoặc s', n.prognosis = 'Kết quả của phẫu thuật cắt bỏ khối u đối với bệnh ung thư vú phụ thuộc chủ yếu vào kích thước của khối u cũng như cấu tạo của khối u. Nó cũng phụ thuộc vào sự lây lan của nó đến các hạch bạch huyết bê';
MERGE (n:Disease {id: 'D0429'}) SET n.id = 'D0429', n.name = 'Đau vú', n.name_en = 'Breast pain', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/breast-pain/symptoms-causes/syc-20350423 | https://medlineplus.gov/ency/article/003152.htm', n.overview = '(đau vú) có thể được mô tả là đau, nhói, đau nhói, như bị đâm, đau rát hoặc căng cứng ở mô vú. Cơn đau có thể liên tục hoặc chỉ thỉnh thoảng xảy ra và có thể xảy ra ở nam giới, phụ nữ và người chuyển ', n.when_to_see = 'Hãy hẹn gặp bác sĩ nếu đau vú: Tiếp tục hàng ngày trong hơn một vài tuần Xảy ra ở một khu vực cụ thể trên vú của bạn Có vẻ trở nên tồi tệ hơn theo thời gian Cản trở các hoạt động hàng ngày Đánh thức b';
MERGE (n:Disease {id: 'D0430'}) SET n.id = 'D0430', n.name = 'Tái tạo vú - cấy ghép', n.name_en = 'Breast reconstruction - implants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007403.htm', n.overview = 'Nếu bạn tái thiết cùng lúc với phẫu thuật cắt bỏ vú, bác sĩ phẫu thuật của bạn có thể thực hiện một trong những điều sau: Cắt bỏ vú để lại da. Điều này có nghĩa là một vùng da nhỏ sẽ được cắt bỏ cùng ', n.prognosis = 'Kết quả của cuộc phẫu thuật này thường rất tốt. Gần như không thể làm cho một bộ ngực tái tạo trông giống hệt như bộ ngực tự nhiên còn lại. Bạn có thể cần nhiều thủ tục "chỉnh sửa" hoặc sửa đổi hơn để';
MERGE (n:Disease {id: 'D0431'}) SET n.id = 'D0431', n.name = 'Tái tạo vú - mô tự nhiên', n.name_en = 'Breast reconstruction - natural tissue', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007404.htm', n.overview = 'Nếu bạn tái tạo vú cùng lúc với phẫu thuật cắt bỏ vú, bác sĩ phẫu thuật có thể thực hiện một trong hai cách sau: Cắt bỏ vú để lại da. Điều này có nghĩa là núm vú, quầng vú và một vùng da nhỏ xung quan', n.prognosis = 'Kết quả của ca phẫu thuật này thường rất tốt. Nhưng việc tái tạo sẽ không khôi phục lại cảm giác bình thường của vú hoặc núm vú mới của bạn. Phẫu thuật tái tạo vú sau ung thư vú có thể cải thiện cảm g';
MERGE (n:Disease {id: 'D0432'}) SET n.id = 'D0432', n.name = 'Phẫu thuật thu nhỏ ngực', n.name_en = 'Breast reduction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007405.htm', n.overview = 'được thực hiện dưới hình thức gây mê toàn thân. Phương pháp này sử dụng các loại thuốc giúp bạn ngủ ngon và không đau đớn. Để thu nhỏ ngực, bác sĩ phẫu thuật sẽ loại bỏ một số mô và da vú. Núm vú của ', n.prognosis = 'Bạn có thể sẽ nhận được kết quả rất tốt sau phẫu thuật thu nhỏ ngực. Bạn có thể cảm thấy tốt hơn về ngoại hình của mình và thoải mái hơn với nhiều hoạt động khác nhau. Các triệu chứng đau hoặc da, chẳ';
MERGE (n:Disease {id: 'D0433'}) SET n.id = 'D0433', n.name = 'Tự kiểm tra vú', n.name_en = 'Breast self-exam', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001993.htm', n.overview = 'Thời gian tốt nhất để tự kiểm tra vú hàng tháng là khoảng 3 đến 5 ngày sau khi kỳ kinh của bạn bắt đầu. Làm điều đó vào cùng một thời điểm mỗi tháng. Ngực của bạn không còn mềm hoặc sần sùi vào thời đ';
MERGE (n:Disease {id: 'D0434'}) SET n.id = 'D0434', n.name = 'Hơi thở có mùi', n.name_en = 'Breath odor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003058.htm', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Mùi hơi thở không biến mất đi và không có nguyên nhân rõ ràng (chẳng hạn như hút thuốc hoặc ăn thực phẩm gây ra mùi hôi). Hơi thở của bạn có mùi và có dấu hiệu nh';
MERGE (n:Disease {id: 'D0435'}) SET n.id = 'D0435', n.name = 'Âm thanh hơi thở', n.name_en = 'Breath sounds', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007535.htm', n.when_to_see = 'Tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn bị: Tím tái (da đổi màu hơi xanh) Đau mũi Khó thở hoặc khó thở nghiêm trọng Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị thở khò khè hoặc khác tiế';
