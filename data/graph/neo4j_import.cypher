MERGE (n:Disease {id: 'D2175'}) SET n.id = 'D2175', n.name = 'Ngộ độc chất tẩy sơn, sơn mài và vecni', n.name_en = 'Paint, lacquer, and varnish remover poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002801.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận như thế nào. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải những c';
MERGE (n:Disease {id: 'D2176'}) SET n.id = 'D2176', n.name = 'Giật cơ vòm miệng', n.name_en = 'Palatal myoclonus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001637.htm';
MERGE (n:Disease {id: 'D2177'}) SET n.id = 'D2177', n.name = 'Da nhợt nhạt', n.name_en = 'Paleness', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003244.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn hoặc 911 hoặc số cấp cứu tại địa phương nếu một người đột nhiên bị xanh xao toàn thân. Hành động khẩn cấp có thể cần thiết để duy trì lưu thô';
MERGE (n:Disease {id: 'D2178'}) SET n.id = 'D2178', n.name = 'Độ nghiêng của mí mắt - mắt', n.name_en = 'Palpebral slant - eye', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003316.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Trẻ sơ sinh của bạn có các đặc điểm bất thường trên khuôn mặt Bạn lo lắng về khả năng cử động mắt của trẻ sơ sinh Bạn nhận thấy bất ';
MERGE (n:Disease {id: 'D2179'}) SET n.id = 'D2179', n.name = 'Tuyến tụy phân chia', n.name_en = 'Pancreas divisum', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000247.htm', n.prognosis = 'Hầu hết kết quả đều tốt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn xuất hiện các triệu chứng của chứng rối loạn này.';
MERGE (n:Disease {id: 'D2180'}) SET n.id = 'D2180', n.name = 'Ghép tụy', n.name_en = 'Pancreas transplant', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003007.htm', n.overview = 'Tuyến tụy khỏe mạnh được lấy từ một người hiến tặng đã chết não nhưng vẫn đang được hỗ trợ sự sống. Tuyến tụy của người hiến tặng phải được ghép cẩn thận với người nhận nó. Tuyến tụy khỏe mạnh được vậ', n.prognosis = 'Nếu quá trình cấy ghép thành công, bạn sẽ không cần phải tiêm insulin, kiểm tra lượng đường trong máu hàng ngày hoặc tuân theo chế độ ăn kiêng cho bệnh tiểu đường nữa. Ngoài ra, chức năng thận của bạn';
MERGE (n:Disease {id: 'D2181'}) SET n.id = 'D2181', n.name = 'Áp xe tụy', n.name_en = 'Pancreatic abscess', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000270.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào mức độ nghiêm trọng của bệnh. Tỷ lệ tử vong do áp xe tụy không thoát nước là rất cao.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có: Đau bụng kèm theo sốt Các dấu hiệu khác của áp xe tuyến tụy, đặc biệt nếu gần đây bạn bị nang giả tụy hoặc viêm tụy';
MERGE (n:Disease {id: 'D2182'}) SET n.id = 'D2182', n.name = 'Ung thư tuyến tụy', n.name_en = 'Pancreatic cancer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/pancreatic-cancer/symptoms-causes/syc-20355421 | https://medlineplus.gov/ency/article/000236.htm', n.overview = 'Ung thư tuyến tụy là gì? Chuyên gia của Mayo Clinic giải thích Tìm hiểu thêm về ung thư tuyến tụy từ bác sĩ phẫu thuật ung thư Chee-Chee Stucky, MD của Mayo Clinic Hiển thị bản ghi cho video Ung thư t', n.prognosis = 'Một số người mắc bệnh ung thư tuyến tụy có thể phẫu thuật cắt bỏ đã được chữa khỏi. Nhưng ở hầu hết mọi người, khối u đã lan rộng và không thể cắt bỏ hoàn toàn tại thời điểm chẩn đoán. Hóa trị và xạ t', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có các triệu chứng khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin được đánh dấu';
MERGE (n:Disease {id: 'D2183'}) SET n.id = 'D2183', n.name = 'U nang tuyến tụy', n.name_en = 'Pancreatic cysts', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pancreatic-cysts/symptoms-causes/syc-20375993', n.overview = 'là những túi dịch dạng túi trên hoặc trong tuyến tụy. Tuyến tụy là một cơ quan lớn phía sau dạ dày có chức năng sản xuất hormone và enzym giúp tiêu hóa thức ăn. U nang tuyến tụy thường được tìm thấy t', n.when_to_see = 'Hiếm khi u nang có thể bị nhiễm trùng. Hãy đến gặp chuyên gia chăm sóc sức khỏe nếu bạn bị sốt và đau bụng không thuyên giảm. U nang tụy bị vỡ có thể là một trường hợp cấp cứu y tế, nhưng may mắn là h';
MERGE (n:Disease {id: 'D2184'}) SET n.id = 'D2184', n.name = 'Các khối u thần kinh nội tiết tuyến tụy', n.name_en = 'Pancreatic neuroendocrine tumors', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/pancreatic-neuroendocrine-tumors/symptoms-causes/syc-20352489 | https://medlineplus.gov/ency/article/000393.htm', n.overview = 'là một loại ung thư hiếm gặp bắt đầu từ sự phát triển của các tế bào trong tuyến tụy. Tuyến tụy là một tuyến dài, phẳng nằm phía sau dạ dày. Nó tạo ra các enzyme và hormone giúp tiêu hóa thức ăn. Các ', n.prognosis = 'Bạn có thể khỏi bệnh nếu khối u được phẫu thuật cắt bỏ trước khi chúng lan sang các cơ quan khác. Nếu khối u là ung thư, hóa trị có thể được sử dụng nhưng thường không thể chữa khỏi bệnh cho con người', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
