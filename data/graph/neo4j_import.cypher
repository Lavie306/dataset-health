MERGE (n:Disease {id: 'D0587'}) SET n.id = 'D0587', n.name = 'Hen suyễn ở trẻ em', n.name_en = 'Childhood asthma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/childhood-asthma/symptoms-causes/syc-20351507', n.overview = 'Trong bệnh hen suyễn ở trẻ em, phổi và đường hô hấp dễ bị viêm khi tiếp xúc với một số tác nhân nhất định. Những tác nhân như vậy bao gồm hít phải phấn hoa, bị cảm lạnh hoặc nhiễm trùng đường hô hấp k', n.when_to_see = 'Đưa con bạn đến gặp chuyên gia chăm sóc sức khỏe nếu bạn nghi ngờ con mình bị hen suyễn. Điều trị sớm sẽ giúp kiểm soát các triệu chứng và có thể ngăn ngừa các cơn hen suyễn. Hãy hẹn gặp chuyên gia y ';
MERGE (n:Disease {id: 'D0588'}) SET n.id = 'D0588', n.name = 'Béo phì ở trẻ em', n.name_en = 'Childhood obesity', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/childhood-obesity/symptoms-causes/syc-20354827', n.overview = 'là một tình trạng sức khỏe nghiêm trọng liên quan đến việc cơ thể dư thừa mỡ ngay từ khi còn nhỏ. Cân nặng tăng thêm thường khiến trẻ dễ mắc các bệnh khác như tiểu đường và huyết áp cao. Béo phì ở trẻ', n.when_to_see = 'Nếu bạn lo lắng rằng con mình tăng cân quá nhiều, hãy nói chuyện với chuyên gia chăm sóc sức khỏe của con bạn. Hãy khám sức khỏe ngay nếu con bạn cũng có bất kỳ triệu chứng nào sau đây: Nhức đầu không';
MERGE (n:Disease {id: 'D0589'}) SET n.id = 'D0589', n.name = 'Bệnh tâm thần phân liệt ở trẻ em', n.name_en = 'Childhood schizophrenia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/childhood-schizophrenia/symptoms-causes/syc-20354483', n.overview = 'là một chứng rối loạn tâm thần không phổ biến nhưng nghiêm trọng, trong đó trẻ em và thanh thiếu niên diễn giải hiện thực một cách bất thường. Tâm thần phân liệt liên quan đến một loạt các vấn đề về s', n.when_to_see = 'Có thể khó biết cách xử lý những thay đổi hành vi mơ hồ ở con bạn. Bạn có thể sợ phải vội vàng kết luận rằng con bạn mắc bệnh tâm thần. Giáo viên của con bạn hoặc nhân viên khác của trường có thể cảnh';
MERGE (n:Disease {id: 'D0590'}) SET n.id = 'D0590', n.name = 'Ớn lạnh', n.name_en = 'Chills', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003091.htm', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp nếu: Có các triệu chứng như cứng cổ, lú lẫn, khó chịu hoặc uể oải. Ớn lạnh kèm theo ho dữ dội, khó thở, đau bụng hoặc nóng rát hoặc đi tiểu thường xuyên. Trẻ dưới 3 t';
MERGE (n:Disease {id: 'D0591'}) SET n.id = 'D0591', n.name = 'Phẫu thuật nâng cằm', n.name_en = 'Chin augmentation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002986.htm', n.overview = 'Phẫu thuật có thể được thực hiện tại phòng khám của bác sĩ phẫu thuật, bệnh viện hoặc phòng khám ngoại trú. Bạn có thể được chụp X-quang mặt và cằm. Bác sĩ phẫu thuật sẽ sử dụng những tia X này để tìm', n.prognosis = 'Nếu vết cắt được thực hiện dưới cằm, vết sẹo sẽ không đáng chú ý lắm. Hầu hết các cấy ghép tồn tại suốt đời. Đôi khi, mô cấy làm từ xương hoặc mô mỡ được lấy từ một bộ phận khác trên cơ thể bạn có thể';
MERGE (n:Disease {id: 'D0592'}) SET n.id = 'D0592', n.name = 'Chlamydia', n.name_en = 'Chlamydia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001345.htm', n.prognosis = 'Điều trị bằng kháng sinh hầu như luôn có tác dụng. Bạn và bạn tình nên dùng thuốc theo chỉ dẫn. Nếu chlamydia lây lan vào tử cung và ống dẫn trứng, nó có thể gây ra sẹo. Sẹo có thể khiến bạn khó mang ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của chlamydia. Nhiều người mắc bệnh chlamydia có thể không có triệu chứng. Vì vậy, nhiều người trưởng thành có hoạt động tình dụ';
MERGE (n:Disease {id: 'D0593'}) SET n.id = 'D0593', n.name = 'Nhiễm Chlamydia ở phụ nữ', n.name_en = 'Chlamydia infections in women', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000660.htm', n.prognosis = 'Điều trị bằng kháng sinh hầu như luôn có tác dụng. Bạn và bạn tình nên dùng thuốc theo chỉ dẫn. Nếu chlamydia lây lan vào tử cung và ống dẫn trứng, nó có thể gây ra sẹo. Sẹo có thể khiến bạn khó mang ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn có các triệu chứng của chlamydia. Bạn lo lắng rằng mình có thể bị nhiễm chlamydia.';
MERGE (n:Disease {id: 'D0594'}) SET n.id = 'D0594', n.name = 'Chlamydia trachomatis', n.name_en = 'Chlamydia trachomatis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/chlamydia/symptoms-causes/syc-20355349', n.overview = 'Chlamydia (kluh-MID-e-uh) là một bệnh lây truyền qua đường tình dục phổ biến. Bệnh lây truyền qua đường tình dục là bệnh nhiễm trùng lây lan chủ yếu qua tiếp xúc với bộ phận sinh dục hoặc dịch cơ thể.', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe nếu bạn bị chảy dịch từ âm đạo, dương vật hoặc trực tràng hoặc nếu bạn bị đau khi đi tiểu. Ngoài ra, hãy gặp nhóm chăm sóc sức khỏe của bạn nếu bạn biết bạn tì';
MERGE (n:Disease {id: 'D0595'}) SET n.id = 'D0595', n.name = 'Nhiễm Chlamydia - nam', n.name_en = 'Chlamydial infections - male', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000659.htm', n.prognosis = 'Điều trị bằng kháng sinh hầu như luôn thành công. Nếu các triệu chứng của bạn không cải thiện nhanh chóng, hãy đảm bảo rằng bạn cũng đang được điều trị bệnh lậu và các bệnh nhiễm trùng khác lây lan qu', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng nhiễm chlamydia.';
