MERGE (n:Disease {id: 'D0951'}) SET n.id = 'D0951', n.name = 'Chứng loạn dưỡng cơ Duchenne', n.name_en = 'Duchenne muscular dystrophy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000705.htm', n.prognosis = 'Bệnh loạn dưỡng cơ Duchenne dẫn đến tình trạng khuyết tật ngày càng trầm trọng hơn. Tử vong thường xảy ra do rối loạn phổi, mặc dù những tiến bộ trong chăm sóc hỗ trợ đã giúp nhiều nam giới sống đến 3', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Con bạn có các triệu chứng của chứng loạn dưỡng cơ Duchenne. Các triệu chứng trở nên nặng hơn hoặc xuất hiện các triệu chứng mới, đặ';
MERGE (n:Disease {id: 'D0952'}) SET n.id = 'D0952', n.name = 'Ung thư biểu mô ống tại chỗ (DCIS)', n.name_en = 'Ductal carcinoma in situ (DCIS)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dcis/symptoms-causes/syc-20371889', n.overview = 'Vấn đề về giải phẫu vú, sắp xếp giống như những cánh hoa cúc. Các thùy lại được chia thành các thùy nhỏ hơn để sản xuất sữa cho con bú. Những ống nhỏ, gọi là ống dẫn, dẫn sữa đến một bể chứa nằm ngay ', n.when_to_see = 'Đặt lịch hẹn với bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn nhận thấy có sự thay đổi ở ngực của mình. Những thay đổi cần quan sát có thể bao gồm khối u, vùng da nhăn nheo hoặc bất thường, v';
MERGE (n:Disease {id: 'D0953'}) SET n.id = 'D0953', n.name = 'Hội chứng Dumping', n.name_en = 'Dumping syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dumping-syndrome/symptoms-causes/syc-20371915', n.overview = 'là tình trạng thức ăn di chuyển từ dạ dày xuống ruột non quá nhanh sau khi ăn, thường thấy hơn sau một số ca phẫu thuật. Nó đôi khi được gọi là làm rỗng dạ dày nhanh chóng. Hội chứng Dumping thường xả', n.when_to_see = 'Hãy liên hệ với chuyên gia chăm sóc sức khỏe nếu bất kỳ điều nào sau đây áp dụng cho bạn: Bạn xuất hiện các triệu chứng có thể do hội chứng Dumping, ngay cả khi bạn chưa phẫu thuật. Các triệu chứng củ';
MERGE (n:Disease {id: 'D0954'}) SET n.id = 'D0954', n.name = 'Teo tá tràng', n.name_en = 'Duodenal atresia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001131.htm', n.prognosis = 'Dự kiến ​​sẽ hồi phục chứng teo tá tràng sau khi điều trị. Nếu không được điều trị, tình trạng này sẽ gây tử vong.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu trẻ sơ sinh của bạn: Bú kém hoặc không hề Nôn mửa (không chỉ đơn giản là nhổ ra) hoặc nếu chất nôn có màu xanh lá cây Không đi tiểu h';
MERGE (n:Disease {id: 'D0955'}) SET n.id = 'D0955', n.name = 'Co cứng Dupuytren', n.name_en = 'Dupuytren contracture', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/dupuytrens-contracture/symptoms-causes/syc-20371943 | https://medlineplus.gov/ency/article/001233.htm', n.overview = 'khiến một hoặc nhiều ngón tay cong về phía lòng bàn tay. Các ngón tay bị ảnh hưởng không thể duỗi thẳng hoàn toàn. Nó thường ảnh hưởng đến hai ngón tay xa ngón cái nhất. Co cứng Dupuytren là tình trạn', n.prognosis = 'Chứng rối loạn tiến triển với tốc độ không thể đoán trước. Phẫu thuật thường có thể khôi phục lại cử động bình thường cho các ngón tay. Các triệu chứng có thể tái phát trong vòng 10 năm sau phẫu thuật', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng của chứng rối loạn này. Đồng thời liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn mất cảm giác ở ngón tay hoặc nếu đầ';
MERGE (n:Disease {id: 'D0956'}) SET n.id = 'D0956', n.name = 'Rò động tĩnh mạch màng cứng', n.name_en = 'Dural arteriovenous fistulas', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dural-arteriovenous-fistulas/symptoms-causes/syc-20364280', n.overview = '(dAVF) là những kết nối không đều giữa động mạch và tĩnh mạch. Chúng xuất hiện ở lớp vỏ cứng bao phủ não hoặc tủy sống, được gọi là màng cứng. Những lối đi không đều giữa động mạch và tĩnh mạch được g', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có bất kỳ triệu chứng nào bất thường hoặc khiến bạn lo lắng. Tìm kiếm sự trợ giúp y tế ngay lập tức nếu bạn bị co giật hoặc có các triệu chứng ';
MERGE (n:Disease {id: 'D0957'}) SET n.id = 'D0957', n.name = 'Dị ứng mạt bụi', n.name_en = 'Dust mite allergy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dust-mites/symptoms-causes/syc-20352173', n.overview = 'là phản ứng dị ứng với những con bọ nhỏ sống trong bụi nhà. Các triệu chứng của dị ứng mạt bụi giống như sốt cỏ khô, chẳng hạn như hắt hơi và sổ mũi. Nhiều người bị dị ứng với mạt bụi cũng có các triệ', n.when_to_see = 'Một số triệu chứng của dị ứng mạt bụi, chẳng hạn như sổ mũi hoặc hắt hơi, giống như cảm lạnh thông thường. Thật khó để biết liệu các triệu chứng là do cảm lạnh hay dị ứng. Nếu các triệu chứng kéo dài ';
MERGE (n:Disease {id: 'D0958'}) SET n.id = 'D0958', n.name = 'Bệnh lùn', n.name_en = 'Dwarfism', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dwarfism/symptoms-causes/syc-20371969', n.overview = 'là vóc dáng thấp bé do tình trạng di truyền hoặc y tế. Tầm vóc là chiều cao của một người ở tư thế đứng. Bệnh lùn thường được định nghĩa là người trưởng thành có chiều cao từ 4 feet, 10 inch (147 cm) ', n.when_to_see = 'Các triệu chứng của bệnh lùn không cân đối thường xuất hiện ngay từ lúc mới sinh hoặc khi còn nhỏ. Lúc đầu, bệnh lùn cân đối có thể không được nhìn thấy. Hãy gặp chuyên gia chăm sóc sức khỏe của con b';
MERGE (n:Disease {id: 'D0959'}) SET n.id = 'D0959', n.name = 'Ngộ độc thuốc nhuộm', n.name_en = 'Dye remover poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002783.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Người đó nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nếu ngộ độc liên quan đến chất';
MERGE (n:Disease {id: 'D0960'}) SET n.id = 'D0960', n.name = 'Chứng khó nói', n.name_en = 'Dysarthria', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/dysarthria/symptoms-causes/syc-20371994 | https://medlineplus.gov/ency/article/007470.htm', n.overview = 'xảy ra khi các cơ dùng để nói yếu hoặc khó kiểm soát. Chứng khó nói thường gây ra tình trạng nói ngọng hoặc chậm và khó hiểu. Nguyên nhân phổ biến của chứng khó nói bao gồm các tình trạng ảnh hưởng đế', n.prognosis = 'Tùy thuộc vào nguyên nhân gây ra chứng khó nói, các triệu chứng có thể cải thiện, giữ nguyên hoặc trở nên nặng hơn từ từ hoặc nhanh chóng. Những người mắc ALS cuối cùng sẽ mất khả năng nói. Một số ngư', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Đau ngực, ớn lạnh, sốt, khó thở hoặc các triệu chứng khác của bệnh viêm phổi Ho hoặc nghẹt thở Khó nói hoặc giao tiếp với người khác Cảm giác b';
MERGE (n:Disease {id: 'D0961'}) SET n.id = 'D0961', n.name = 'Chứng khó đọc', n.name_en = 'Dysgraphia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001543.htm', n.prognosis = 'Mức độ hồi phục tùy thuộc vào mức độ nghiêm trọng của chứng rối loạn. Sự cải thiện thường được nhìn thấy sau khi điều trị.', n.when_to_see = 'Những bậc cha mẹ lo ngại về khả năng viết của con mình nên cho con mình kiểm tra bởi các chuyên gia giáo dục.';
MERGE (n:Disease {id: 'D0962'}) SET n.id = 'D0962', n.name = 'Chứng Dyshidrosis', n.name_en = 'Dyshidrosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dyshidrosis/symptoms-causes/syc-20352342', n.overview = 'ở lòng bàn chân, lòng bàn tay hoặc hai bên ngón tay. Dyshidrosis là một tình trạng da gây ra các mụn nước nhỏ chứa đầy chất lỏng hình thành ở lòng bàn tay và hai bên ngón tay. Đôi khi lòng bàn chân cũ', n.when_to_see = 'Hãy gọi cho bác sĩ nếu bạn bị phát ban ở tay hoặc chân nghiêm trọng, không biến mất hoặc lan ra ngoài bàn tay và bàn chân. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem x';
MERGE (n:Disease {id: 'D0963'}) SET n.id = 'D0963', n.name = 'Chứng khó nuốt', n.name_en = 'Dysphagia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dysphagia/symptoms-causes/syc-20372028', n.overview = 'Thực quản dạ dày. Các vòng cơ co lại và giãn ra để cho phép thức ăn và chất lỏng đi qua phần trên và phần dưới. Chứng khó nuốt là một thuật ngữ y học chỉ tình trạng khó nuốt. Chứng khó nuốt có thể là ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn thường xuyên gặp khó khăn khi nuốt hoặc nếu sụt cân, nôn mửa hoặc nôn mửa xảy ra cùng với chứng khó nuốt của bạn. Nếu tắc nghẽn khiến bạn khó thở, hãy gọi ';
MERGE (n:Disease {id: 'D0964'}) SET n.id = 'D0964', n.name = 'Dystonia', n.name_en = 'Dystonia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dystonia/symptoms-causes/syc-20350480', n.overview = 'là một chứng rối loạn vận động khiến các cơ co lại. Điều này có thể gây ra các chuyển động xoắn hoặc các chuyển động khác xảy ra lặp đi lặp lại và không nằm trong tầm kiểm soát của người đó. Khi tình ', n.when_to_see = 'Các triệu chứng ban đầu của chứng loạn trương lực cơ thường nhẹ, thỉnh thoảng xảy ra và liên quan đến một hoạt động cụ thể. Hãy gặp thành viên trong nhóm chăm sóc sức khỏe của bạn nếu bạn bị co thắt c';
MERGE (n:Disease {id: 'D0965'}) SET n.id = 'D0965', n.name = 'Viêm ruột E coli', n.name_en = 'E coli enteritis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000296.htm', n.prognosis = 'Hầu hết mọi người sẽ khỏi bệnh sau vài ngày mà không cần điều trị. Một số loại E coli không phổ biến có thể gây thiếu máu trầm trọng hoặc suy thận.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để lấy hẹn nếu: Bạn không thể duy trì đủ chất lỏng. Tình trạng tiêu chảy của bạn không thuyên giảm sau 5 ngày (2 ngày đối với trẻ sơ sinh hoặc trẻ nhỏ) hoặ';
MERGE (n:Disease {id: 'D0966'}) SET n.id = 'D0966', n.name = 'E. coli', n.name_en = 'E. coli', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/e-coli/symptoms-causes/syc-20372058', n.overview = 'Escherichia coli, còn được gọi là E. coli, vi khuẩn sống trong ruột của người và động vật. Hầu hết các loại E. coli không gây hại hoặc gây bệnh nhẹ. Nhưng một số chủng, chẳng hạn như E. coli O157:H7, ', n.when_to_see = 'Liên hệ với chuyên gia chăm sóc sức khỏe nếu bạn đi ngoài phân lỏng hơn hai ngày hoặc phân có máu. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
