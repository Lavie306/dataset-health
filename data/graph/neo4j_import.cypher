MERGE (n:Disease {id: 'D0934'}) SET n.id = 'D0934', n.name = 'Thiếu máu tán huyết miễn dịch do thuốc', n.name_en = 'Drug-induced immune hemolytic anemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000578.htm', n.prognosis = 'Kết quả sẽ tốt cho hầu hết mọi người nếu họ ngừng dùng loại thuốc đang gây ra vấn đề.', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của tình trạng này.';
