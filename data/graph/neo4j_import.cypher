MERGE (n:Disease {id: 'D2391'}) SET n.id = 'D2391', n.name = 'Tiền sản giật sau sinh', n.name_en = 'Postpartum preeclampsia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/postpartum-preeclampsia/symptoms-causes/syc-20376646', n.overview = 'là một tình trạng hiếm gặp xảy ra khi bạn bị huyết áp cao và có quá nhiều protein trong nước tiểu ngay sau khi sinh con. Tiền sản giật là một tình trạng tương tự phát triển trong thai kỳ và thường khỏ', n.when_to_see = 'Nếu bạn có các dấu hiệu hoặc triệu chứng của tiền sản giật sau sinh ngay sau khi sinh con, hãy liên hệ ngay với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Tùy thuộc vào hoàn cảnh, bạn có thể cần ';
MERGE (n:Disease {id: 'D2392'}) SET n.id = 'D2392', n.name = 'Viêm cầu thận sau liên cầu khuẩn (GN)', n.name_en = 'Poststreptococcal glomerulonephritis (GN)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000503.htm', n.prognosis = 'Posttreptococcal GN thường tự biến mất sau vài tuần đến vài tháng. Ở một số ít người lớn, bệnh có thể nặng hơn và dẫn đến suy thận lâu dài (mãn tính). Đôi khi, bệnh có thể tiến triển thành bệnh thận g', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn có các triệu chứng của viêm cầu thận sau liên cầu khuẩn Bạn có viêm cầu thận sau liên cầu khuẩn và lượng nước tiểu giảm hoặc các';
