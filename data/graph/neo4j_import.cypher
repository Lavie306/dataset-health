MERGE (n:Disease {id: 'D0924'}) SET n.id = 'D0924', n.name = 'Ngộ độc chất tẩy rửa cống', n.name_en = 'Drain cleaner poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002779.htm', n.prognosis = 'Khả năng phục hồi của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải loại chất độc này có thể ';
MERGE (n:Disease {id: 'D0925'}) SET n.id = 'D0925', n.name = 'Ngộ độc dụng cụ mở ống dẫn nước', n.name_en = 'Drain opener poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002780.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Người đó nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nếu loại chất độc này lọt vào ';
MERGE (n:Disease {id: 'D0926'}) SET n.id = 'D0926', n.name = 'Chất tẩy rửa ống thoát nước', n.name_en = 'Drainpipe cleaners', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002782.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Người đó nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải những chất độc như v';
MERGE (n:Disease {id: 'D0927'}) SET n.id = 'D0927', n.name = 'Hội chứng Dressler', n.name_en = 'Dressler syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dresslers-syndrome/symptoms-causes/syc-20371811', n.overview = 'Viêm màng ngoài tim ở tim (màng ngoài tim). Tim bên phải có lớp niêm mạc bị sưng và nhiễm trùng (viêm màng ngoài tim). Hội chứng Dressler là hiện tượng sưng tấy và kích ứng túi quanh tim xảy ra sau kh', n.when_to_see = 'Nhận dịch vụ chăm sóc khẩn cấp khi bị đau ngực đột ngột hoặc liên tục. Đây có thể là triệu chứng của cơn đau tim hoặc một tình trạng nghiêm trọng khác. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0928'}) SET n.id = 'D0928', n.name = 'Chảy nước dãi', n.name_en = 'Drooling', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003048.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Nguyên nhân chảy nước dãi chưa được chẩn đoán. Có mối lo ngại về việc bịt miệng hoặc nghẹt thở. Trẻ bị sốt, khó thở hoặc ôm đầu ở tư';
