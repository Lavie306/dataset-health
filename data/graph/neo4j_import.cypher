MERGE (n:Disease {id: 'D2398'}) SET n.id = 'D2398', n.name = 'Hội chứng Prader-Willi', n.name_en = 'Prader-Willi syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/prader-willi-syndrome/symptoms-causes/syc-20355997 | https://medlineplus.gov/ency/article/001605.htm', n.overview = 'Hội chứng Prader-Willi (PRAH-dur VIL-e) là một tình trạng di truyền hiếm gặp dẫn đến các vấn đề về thể chất, tinh thần và hành vi. Đặc điểm chính của hội chứng Prader-Willi là cảm giác lúc nào cũng đó', n.prognosis = 'Đứa trẻ sẽ cần sự giáo dục phù hợp với mức IQ của chúng. Trẻ cũng sẽ cần liệu pháp ngôn ngữ, thể chất và lao động càng sớm càng tốt. Kiểm soát cân nặng sẽ mang lại cuộc sống thoải mái và khỏe mạnh hơn', n.when_to_see = 'Việc thăm khám sức khỏe trẻ sơ sinh theo lịch thường xuyên có thể giúp phát hiện sớm các dấu hiệu tăng trưởng và phát triển kém có thể là dấu hiệu của hội chứng Prader-Willi hoặc các tình trạng khác. ';
MERGE (n:Disease {id: 'D2399'}) SET n.id = 'D2399', n.name = 'Dậy thì sớm', n.name_en = 'Precocious puberty', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/precocious-puberty/symptoms-causes/syc-20351811 | https://medlineplus.gov/ency/article/001168.htm', n.overview = 'là khi cơ thể trẻ bắt đầu chuyển đổi thành cơ thể người lớn quá sớm. Sự thay đổi này được gọi là tuổi dậy thì. Hầu hết, tuổi dậy thì xảy ra sau 8 tuổi ở bé gái và sau 9 tuổi ở bé trai. Tuy nhiên, trẻ ', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe cho con bạn nếu: Con bạn có dấu hiệu dậy thì sớm Bất kỳ trẻ nào phát triển giới tính sớm dường như gặp vấn đề ở trường hoặc với bạn bè đồng trang lứa';
MERGE (n:Disease {id: 'D2400'}) SET n.id = 'D2400', n.name = 'Tiền tiểu đường', n.name_en = 'Prediabetes', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/prediabetes/symptoms-causes/syc-20355278', n.overview = 'Kháng insulin là gì? Chuyên gia của Mayo Clinic giải thích Tìm hiểu về tình trạng kháng insulin từ Eleanna De Filippis, M.D., Ph.D., bác sĩ nội tiết tại Mayo Clinic. Hiển thị bản ghi cho video Kháng i', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn lo lắng về bệnh tiểu đường hoặc nếu bạn nhận thấy bất kỳ dấu hiệu hoặc triệu chứng nào của bệnh tiểu đường loại 2. Hãy hỏi nhà cung cấp d';
MERGE (n:Disease {id: 'D2401'}) SET n.id = 'D2401', n.name = 'Tiền sản giật', n.name_en = 'Preeclampsia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/preeclampsia/symptoms-causes/syc-20355745 | https://medlineplus.gov/ency/article/000898.htm', n.overview = 'là một biến chứng của thai kỳ. Khi bị tiền sản giật, bạn có thể bị huyết áp cao, lượng protein trong nước tiểu cao cho thấy tổn thương thận (protein niệu) hoặc các dấu hiệu tổn thương nội tạng khác. T', n.prognosis = 'Các dấu hiệu và triệu chứng của tiền sản giật thường biến mất trong vòng 6 tuần sau khi sinh. Tuy nhiên, huyết áp cao đôi khi trở nên nặng hơn trong vài ngày đầu sau khi sinh. Bạn vẫn có nguy cơ bị ti', n.when_to_see = 'Hãy đảm bảo bạn đi khám thai để nhà cung cấp dịch vụ chăm sóc sức khỏe có thể theo dõi huyết áp của bạn. Liên hệ với nhà cung cấp của bạn ngay lập tức hoặc đến phòng cấp cứu nếu bạn bị đau đầu dữ dội,';
MERGE (n:Disease {id: 'D2402'}) SET n.id = 'D2402', n.name = 'Mang thai - xác định ngày dễ thụ thai', n.name_en = 'Pregnancy - identifying fertile days', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007015.htm', n.overview = 'Khi muốn có thai, nhiều cặp vợ chồng lên kế hoạch giao hợp vào khoảng ngày 11 đến ngày 14 của chu kỳ 28 ngày của người phụ nữ. Đây là thời điểm rụng trứng xảy ra. Thật khó để biết chính xác khi nào sự';
MERGE (n:Disease {id: 'D2403'}) SET n.id = 'D2403', n.name = 'Mang thai và mụn rộp', n.name_en = 'Pregnancy and herpes', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001368.htm', n.prognosis = 'Trẻ sơ sinh bị viêm não HSV toàn thân hoặc HSV thường có sức khỏe kém. Điều này bất chấp thuốc kháng vi-rút và điều trị sớm. Ở trẻ sơ sinh mắc bệnh ngoài da, mụn nước có thể tiếp tục quay trở lại ngay', n.when_to_see = 'Nếu em bé của bạn có bất kỳ triệu chứng nào của bệnh mụn rộp mắc phải khi sinh, bao gồm cả mụn nước trên da mà không có triệu chứng nào khác, hãy đưa em bé đến gặp bác sĩ ngay lập tức.';
MERGE (n:Disease {id: 'D2404'}) SET n.id = 'D2404', n.name = 'Mang thai và bệnh cúm', n.name_en = 'Pregnancy and the flu', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007443.htm', n.overview = 'CÁC TRIỆU CHỨNG CỦA CÚM KHI MANG THAI LÀ GÌ? Các triệu chứng cúm ở tất cả mọi người đều giống nhau và bao gồm: Ho Đau họng Chảy nước mũi Sốt từ 100,4°F (38°C) trở lên Các triệu chứng khác có thể bao g';
MERGE (n:Disease {id: 'D2405'}) SET n.id = 'D2405', n.name = 'Sinh non', n.name_en = 'Premature birth', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/premature-birth/symptoms-causes/syc-20376730', n.overview = 'Sinh non có nghĩa là em bé được sinh ra quá sớm. Việc sinh nở diễn ra trước tuần thứ 37 của thai kỳ. Một thai kỳ thông thường kéo dài khoảng 40 tuần. Trẻ sinh non thường gặp các vấn đề nghiêm trọng về';
MERGE (n:Disease {id: 'D2406'}) SET n.id = 'D2406', n.name = 'Xuất tinh sớm', n.name_en = 'Premature ejaculation', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/premature-ejaculation/symptoms-causes/syc-20354900 | https://medlineplus.gov/ency/article/001524.htm', n.overview = 'xảy ra ở nam giới khi tinh dịch rời khỏi cơ thể (xuất tinh) sớm hơn mong muốn khi quan hệ tình dục. Xuất tinh sớm là một khiếu nại tình dục phổ biến. Cứ 3 người thì có 1 người nói rằng họ mắc bệnh này', n.prognosis = 'Trong hầu hết các trường hợp, người đàn ông có thể học cách kiểm soát xuất tinh. Giáo dục và thực hành các kỹ thuật đơn giản thường thành công. Xuất tinh sớm mãn tính có thể là dấu hiệu của sự lo lắng', n.when_to_see = 'Hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn xuất tinh sớm hơn mong muốn trong hầu hết các lần quan hệ tình dục. Việc cảm thấy xấu hổ khi thảo luận về các vấn đề sức khỏe ';
MERGE (n:Disease {id: 'D2407'}) SET n.id = 'D2407', n.name = 'Trẻ sinh non', n.name_en = 'Premature infant', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001562.htm', n.prognosis = 'Sinh non từng là nguyên nhân chính gây tử vong ở trẻ sơ sinh. Kỹ thuật y tế và điều dưỡng được cải tiến đã làm tăng khả năng sống sót của trẻ sinh non. Sinh non có thể có tác dụng lâu dài. Nhiều trẻ s';
MERGE (n:Disease {id: 'D2408'}) SET n.id = 'D2408', n.name = 'Suy buồng trứng sớm', n.name_en = 'Premature ovarian failure', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001163.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn không còn kinh nguyệt hàng tháng nữa. Bạn có triệu chứng mãn kinh sớm. Bạn đang gặp khó khăn trong việc mang thai.';
MERGE (n:Disease {id: 'D2409'}) SET n.id = 'D2409', n.name = 'Co thắt tâm thất sớm (PVC)', n.name_en = 'Premature ventricular contractions (PVCs)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/premature-ventricular-contractions/symptoms-causes/syc-20376757', n.overview = 'là một loại nhịp tim không đều, còn được gọi là rối loạn nhịp tim. PVC là nhịp tim thêm. Chúng bắt đầu ở một trong các buồng dưới của tim, được gọi là tâm thất. Các nhịp bổ sung thay đổi kiểu nhịp tim', n.when_to_see = 'Nếu bạn cảm thấy nhịp tim của mình có sự thay đổi, hãy đặt lịch hẹn để kiểm tra sức khỏe. Chuyên gia chăm sóc sức khỏe có thể tìm hiểu xem các triệu chứng của bạn có phải do bệnh tim hay vấn đề sức kh';
MERGE (n:Disease {id: 'D2410'}) SET n.id = 'D2410', n.name = 'Những thay đổi ở ngực tiền kinh nguyệt', n.name_en = 'Premenstrual breast changes', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003153.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn: Có khối u mới, bất thường hoặc thay đổi trong mô vú Có khối u một bên (một bên) trong mô vú Không biết cách thực hiện tự kiểm tra vú đúng cách Là phụ ';
MERGE (n:Disease {id: 'D2411'}) SET n.id = 'D2411', n.name = 'Rối loạn khó chịu tiền kinh nguyệt', n.name_en = 'Premenstrual dysphoric disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007193.htm', n.prognosis = 'Sau khi được chẩn đoán và điều trị thích hợp, hầu hết phụ nữ mắc PMDĐ nhận thấy rằng các triệu chứng của họ biến mất hoặc giảm xuống mức có thể chấp nhận được.', n.when_to_see = 'Nếu bạn hoặc ai đó bạn biết đang nghĩ đến việc tự tử, hãy gọi điện hoặc nhắn tin cho 988 hoặc trò chuyện 988lifeline.org. Bạn cũng có thể gọi 1-800-273-8255 (1-800-273-TALK). Đường dây nóng tự tử và k';
MERGE (n:Disease {id: 'D2412'}) SET n.id = 'D2412', n.name = 'Hội chứng tiền kinh nguyệt', n.name_en = 'Premenstrual syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001505.htm', n.prognosis = 'Hầu hết phụ nữ được điều trị các triệu chứng PMS đều nhận được sự thuyên giảm tốt. Các triệu chứng PMS có thể trở nên nghiêm trọng đến mức khiến bạn không thể hoạt động bình thường. Tỷ lệ tự tử ở phụ ', n.when_to_see = 'Liên hệ hoặc đặt lịch hẹn với nhà cung cấp của bạn nếu: PMS không khỏi khi tự điều trị Các triệu chứng của bạn nghiêm trọng đến mức hạn chế khả năng hoạt động của bạn Bạn cảm thấy muốn làm tổn thương ';
MERGE (n:Disease {id: 'D2413'}) SET n.id = 'D2413', n.name = 'Hội chứng tiền kinh nguyệt (PMS)', n.name_en = 'Premenstrual syndrome (PMS)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/premenstrual-syndrome/symptoms-causes/syc-20376780', n.overview = 'có rất nhiều dấu hiệu và triệu chứng, bao gồm thay đổi tâm trạng, đau ngực, thèm ăn, mệt mỏi, khó chịu và trầm cảm. Người ta ước tính rằng cứ 4 phụ nữ đang có kinh thì có 3 người đã trải qua một số dạ', n.when_to_see = 'Nếu bạn không thể kiểm soát hội chứng tiền kinh nguyệt bằng cách thay đổi lối sống và các triệu chứng của hội chứng tiền kinh nguyệt (PMS) đang ảnh hưởng đến sức khỏe và hoạt động hàng ngày của bạn, h';
MERGE (n:Disease {id: 'D2414'}) SET n.id = 'D2414', n.name = 'Chứng tăng nitơ huyết trước thận', n.name_en = 'Prerenal azotemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000508.htm', n.prognosis = 'Chứng tăng nitơ huyết trước thận có thể hồi phục nếu tìm được và khắc phục nguyên nhân trong vòng 24 giờ. Nếu nguyên nhân không được khắc phục nhanh chóng, thận có thể bị tổn thương (hoại tử ống cấp t', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn có các triệu chứng của bệnh tăng nitơ huyết trước thận.';
MERGE (n:Disease {id: 'D2415'}) SET n.id = 'D2415', n.name = 'Lão thị', n.name_en = 'Presbyopia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/presbyopia/symptoms-causes/syc-20363328 | https://medlineplus.gov/ency/article/001026.htm', n.overview = 'là tình trạng mất dần khả năng tập trung vào các vật thể ở gần của mắt. Đó là một phần tự nhiên và thường gây khó chịu của quá trình lão hóa. Lão thị thường trở nên đáng chú ý ở độ tuổi từ đầu đến giữ', n.prognosis = 'Thị lực có thể được điều chỉnh bằng kính đeo mắt, kính áp tròng hoặc phẫu thuật.', n.when_to_see = 'Hãy khám bác sĩ nhãn khoa nếu nhìn cận cảnh bị mờ khiến bạn không thể đọc, làm việc cận cảnh hoặc tận hưởng các hoạt động bình thường khác. Anh ấy hoặc cô ấy có thể xác định xem bạn có bị viễn thị hay';
MERGE (n:Disease {id: 'D2416'}) SET n.id = 'D2416', n.name = 'Sự phát triển của trẻ mẫu giáo', n.name_en = 'Preschooler development', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002013.htm', n.overview = 'Tất cả trẻ em đều phát triển khác nhau một chút. Nếu bạn lo lắng về sự phát triển của con mình, hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn. PHÁT TRIỂN THỂ CHẤT Trẻ 3 đến 6 t';
MERGE (n:Disease {id: 'D2417'}) SET n.id = 'D2417', n.name = 'Bài kiểm tra dành cho trẻ mẫu giáo hoặc chuẩn bị thủ tục', n.name_en = 'Preschooler test or procedure preparation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002057.htm', n.overview = 'Chuẩn bị cho trẻ làm bài kiểm tra y tế có thể làm giảm sự lo lắng của chúng. Nó cũng có thể làm cho họ ít khóc và chống lại thủ tục hơn. Nghiên cứu cho thấy việc giảm bớt lo lắng có thể làm giảm cảm g';
MERGE (n:Disease {id: 'D2418'}) SET n.id = 'D2418', n.name = 'Lạm dụng thuốc theo toa', n.name_en = 'Prescription drug abuse', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/prescription-drug-abuse/symptoms-causes/syc-20376813', n.overview = 'là việc sử dụng thuốc theo toa theo cách không được người kê đơn dự định. Lạm dụng thuốc theo toa, còn được gọi là lạm dụng thuốc theo toa, bao gồm mọi thứ từ việc dùng thuốc giảm đau theo toa của bạn', n.when_to_see = 'Nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khoẻ của bạn nếu bạn nghĩ rằng bạn có thể gặp vấn đề với việc sử dụng thuốc theo toa. Bạn có thể cảm thấy xấu hổ khi nói về điều đó - nhưng hãy nhớ rằn';
MERGE (n:Disease {id: 'D2419'}) SET n.id = 'D2419', n.name = 'Chuyển dạ sinh non', n.name_en = 'Preterm labor', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/preterm-labor/symptoms-causes/syc-20376842', n.overview = 'xảy ra khi các cơn co thắt thường xuyên khiến cổ tử cung mở sau tuần 20 và trước tuần 37 của thai kỳ. Sinh non có thể khiến em bé được sinh ra trước tuần thứ 37 của thai kỳ. Sinh càng sớm thì nguy cơ ', n.when_to_see = 'Nếu bạn có các triệu chứng chuyển dạ sinh non hoặc bạn lo lắng về cảm giác của mình, hãy liên hệ với chuyên gia chăm sóc sức khỏe của bạn ngay lập tức. Chuyên gia chăm sóc sức khỏe của bạn có thể tìm ';
MERGE (n:Disease {id: 'D2420'}) SET n.id = 'D2420', n.name = 'Priapism', n.name_en = 'Priapism', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/priapism/symptoms-causes/syc-20352005', n.overview = 'là hiện tượng dương vật cương cứng kéo dài. Sự cương cứng hoàn toàn hoặc một phần tiếp tục kéo dài hàng giờ hoặc không phải do kích thích tình dục gây ra. Các loại priapism chính là thiếu máu cục bộ v', n.when_to_see = 'Nếu bạn bị cương cứng kéo dài hơn bốn giờ, bạn cần được chăm sóc khẩn cấp. Bác sĩ phòng cấp cứu sẽ xác định xem bạn mắc chứng cương đau dương vật do thiếu máu cục bộ hay cương đau dương vật không do t';
MERGE (n:Disease {id: 'D2421'}) SET n.id = 'D2421', n.name = 'Giảm thông khí phế nang nguyên phát', n.name_en = 'Primary alveolar hypoventilation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000078.htm', n.prognosis = 'Response to treatment varies.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng của chứng rối loạn này. Tìm kiếm sự chăm sóc y tế ngay lập tức nếu da hơi xanh.';
MERGE (n:Disease {id: 'D2422'}) SET n.id = 'D2422', n.name = 'Bệnh amyloidosis nguyên phát', n.name_en = 'Primary amyloidosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000533.htm', n.prognosis = 'Bạn hoạt động tốt như thế nào tùy thuộc vào cơ quan nào bị ảnh hưởng. Sự liên quan đến tim và thận có thể dẫn đến suy nội tạng và tử vong. Bệnh amyloid toàn thân (toàn thân) có thể dẫn đến tử vong tro', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh này. Đồng thời, hãy gọi nếu bạn đã được chẩn đoán mắc bệnh này và có: Đi tiểu ít Khó thở Sưng mắt cá chân hoặc các bộ p';
MERGE (n:Disease {id: 'D2423'}) SET n.id = 'D2423', n.name = 'Chứng tăng aldosterone nguyên phát và thứ phát', n.name_en = 'Primary and secondary hyperaldosteronism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000330.htm', n.prognosis = 'Triển vọng của bệnh cường aldosteron nguyên phát là tốt nếu được chẩn đoán và điều trị sớm. Triển vọng của chứng tăng aldosteron thứ phát phụ thuộc vào nguyên nhân của tình trạng này.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của chứng tăng aldosteron.';
MERGE (n:Disease {id: 'D2424'}) SET n.id = 'D2424', n.name = 'Viêm đường mật nguyên phát', n.name_en = 'Primary biliary cholangitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000282.htm', n.prognosis = 'Kết quả có thể khác nhau. Nếu tình trạng này không được điều trị, hầu hết mọi người sẽ chết nếu không được ghép gan. Khoảng 1/4 số người mắc bệnh trong 10 năm sẽ bị suy gan. Các bác sĩ hiện có thể sử ', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị: Sưng bụng Máu trong phân Lẫn lộn Vàng da Ngứa da không biến mất và không liên quan đến các nguyên nhân khác Nôn ra máu';
MERGE (n:Disease {id: 'D2425'}) SET n.id = 'D2425', n.name = 'Viêm đường mật nguyên phát (PBC)', n.name_en = 'Primary biliary cholangitis (PBC)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/primary-biliary-cholangitis/symptoms-causes/syc-20376874', n.overview = 'Gan bị viêm đường mật nguyên phát Viêm đường mật mật nguyên phát, hệ thống miễn dịch tấn công niêm mạc ống mật trong gan. Các ống mật bị tổn thương sẽ làm rò rỉ mật và gây viêm, gây sẹo mô gan, còn gọ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị ngứa dữ dội, dai dẳng trên phần lớn cơ thể mà không có nguyên nhân rõ ràng. Ngoài ra, hãy gặp chuyên gia y tế nếu bạn luôn cảm thấy cực kỳ m';
MERGE (n:Disease {id: 'D2426'}) SET n.id = 'D2426', n.name = 'Rối loạn suy giảm miễn dịch nguyên phát', n.name_en = 'Primary immunodeficiency', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/primary-immunodeficiency/symptoms-causes/syc-20376905', n.overview = 'là một nhóm các tình trạng khiến cơ thể khó chống lại nhiễm trùng. Đôi khi chúng được gọi là rối loạn miễn dịch nguyên phát hoặc suy giảm miễn dịch nguyên phát. Nhiều người bị suy giảm miễn dịch nguyê', n.when_to_see = 'Nếu bạn hoặc con bạn bị nhiễm trùng thường xuyên, tái phát hoặc nặng hoặc nhiễm trùng không đáp ứng với các phương pháp điều trị, hãy nói chuyện với chuyên gia chăm sóc sức khỏe. Chẩn đoán sớm và điều';
MERGE (n:Disease {id: 'D2427'}) SET n.id = 'D2427', n.name = 'Bệnh xơ cứng bên nguyên phát (PLS)', n.name_en = 'Primary lateral sclerosis (PLS)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/primary-lateral-sclerosis/symptoms-causes/syc-20353968', n.overview = 'là một tình trạng hiếm gặp ảnh hưởng đến các tế bào thần kinh trong não điều khiển chuyển động. PLS từ từ phá vỡ các tế bào thần kinh và gây ra tình trạng yếu cơ ở chân, tay và lưỡi. Đây là một bệnh t', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn bị cứng hoặc yếu kéo dài ở chân hoặc tay. Ngoài ra, hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn gặp khó khăn khi nuốt hoặc nói. Đưa con bạn đến gặp ch';
MERGE (n:Disease {id: 'D2428'}) SET n.id = 'D2428', n.name = 'U lympho não nguyên phát', n.name_en = 'Primary lymphoma of the brain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000734.htm', n.prognosis = 'Nếu không điều trị, những người mắc bệnh ung thư hạch não nguyên phát chỉ sống sót được dưới 6 tháng. Khi được điều trị bằng hóa trị, một nửa số bệnh nhân sẽ thuyên giảm sau 10 năm được chẩn đoán. Khả';
MERGE (n:Disease {id: 'D2429'}) SET n.id = 'D2429', n.name = 'U lympho tế bào B lớn trung thất nguyên phát', n.name_en = 'Primary mediastinal large B-cell lymphoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/primary-mediastinal-large-b-cell-lymphoma/symptoms-causes/syc-20596342', n.overview = '(PMBCL) là một loại ung thư hạch. Loại ung thư hạch này còn được gọi là PMBL. Ung thư hạch là một loại ung thư ảnh hưởng đến tế bào lympho, một loại tế bào bạch cầu. Các tế bào bạch cầu là một phần củ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng hoặc không biến mất. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2430'}) SET n.id = 'D2430', n.name = 'Suy buồng trứng nguyên phát', n.name_en = 'Primary ovarian insufficiency', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/premature-ovarian-failure/symptoms-causes/syc-20354683', n.overview = 'xảy ra khi buồng trứng ngừng hoạt động bình thường trước tuổi 40. Khi điều này xảy ra, buồng trứng không tạo ra lượng hormone estrogen thông thường hoặc không rụng trứng thường xuyên. Tình trạng này t', n.when_to_see = 'Nếu bạn bị trễ kinh từ ba tháng trở lên, hãy đến gặp nhóm chăm sóc sức khỏe để tìm ra nguyên nhân. Bạn có thể bị trễ kinh vì nhiều lý do, chẳng hạn như mang thai, căng thẳng hoặc thay đổi chế độ ăn uố';
MERGE (n:Disease {id: 'D2431'}) SET n.id = 'D2431', n.name = 'Chứng mất ngôn ngữ tiến triển nguyên phát', n.name_en = 'Primary progressive aphasia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/primary-progressive-aphasia/symptoms-causes/syc-20350499', n.overview = 'Các chức năng của não chịu trách nhiệm cho các chức năng quan trọng khác nhau. Chứng mất ngôn ngữ tiến triển nguyên phát (uh-FAY-zhuh) là một tình trạng hệ thần kinh hiếm gặp ảnh hưởng đến khả năng gi', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn lo lắng về khả năng giao tiếp của mình. Nếu bạn có một thành viên trong gia đình hoặc bạn bè có triệu chứng mắc chứng mất ngôn ngữ tiến triển tiên ';
MERGE (n:Disease {id: 'D2432'}) SET n.id = 'D2432', n.name = 'Viêm đường mật xơ cứng nguyên phát (PSC)', n.name_en = 'Primary sclerosing cholangitis (PSC)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/primary-sclerosing-cholangitis/symptoms-causes/syc-20355797', n.overview = 'Ống mật làm tổn thương toàn bộ ruột. Mật giúp phân hủy chất béo. Khi ống mật bị tổn thương, mật có thể trào ngược vào gan, gây tổn thương tế bào gan. Thiệt hại này có thể dẫn đến suy gan. Viêm đường m', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị ngứa dữ dội, dai dẳng trên phần lớn cơ thể mà không có nguyên nhân rõ ràng. Ngoài ra, hãy gặp chuyên gia y tế nếu bạn luôn cảm thấy cực kỳ m';
MERGE (n:Disease {id: 'D2433'}) SET n.id = 'D2433', n.name = 'Quá liều prochlorperazine', n.name_en = 'Prochlorperazine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002615.htm', n.prognosis = 'Prochlorperazine khá an toàn. Rất có thể, quá liều sẽ chỉ gây buồn ngủ và một số tác dụng phụ, chẳng hạn như cử động không kiểm soát của môi, mắt, đầu và cổ trong thời gian ngắn. Những chuyển động này';
MERGE (n:Disease {id: 'D2434'}) SET n.id = 'D2434', n.name = 'Viêm trực tràng', n.name_en = 'Proctitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/proctitis/symptoms-causes/syc-20376933 | https://medlineplus.gov/ency/article/001139.htm', n.overview = 'là tình trạng kích thích và sưng tấy ống cơ nối với phần cuối của đại tràng, được gọi là trực tràng. Phân đi qua trực tràng trên đường ra khỏi cơ thể. Viêm trực tràng có thể gây đau trực tràng, tiêu c', n.prognosis = 'Kết quả điều trị là tốt.', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào của bệnh viêm trực tràng.';
MERGE (n:Disease {id: 'D2435'}) SET n.id = 'D2435', n.name = 'Progeria', n.name_en = 'Progeria', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/progeria/symptoms-causes/syc-20356038 | https://medlineplus.gov/ency/article/001657.htm', n.overview = '(pro-JEER-e-uh), còn được gọi là hội chứng progeria Hutchinson-Gilford, là một rối loạn di truyền tiến triển cực kỳ hiếm gặp. Nó khiến trẻ em già đi nhanh chóng, bắt đầu từ hai năm đầu đời. Trẻ em mắc', n.prognosis = 'Progeria gây tử vong sớm. Những người mắc bệnh này thường chỉ sống đến tuổi thiếu niên (tuổi thọ trung bình là 14 năm). Tuy nhiên, một số có thể sống đến đầu tuổi 20. Nguyên nhân tử vong thường liên q', n.when_to_see = 'Progeria thường được tìm thấy ở trẻ sơ sinh hoặc trẻ nhỏ. Điều này thường xảy ra khi khám sức khỏe định kỳ, khi trẻ lần đầu tiên có những dấu hiệu lão hóa sớm. Nếu bạn nhận thấy những thay đổi ở con m';
MERGE (n:Disease {id: 'D2436'}) SET n.id = 'D2436', n.name = 'Prognathism', n.name_en = 'Prognathism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003026.htm', n.when_to_see = 'Nha sĩ hoặc bác sĩ chỉnh nha có thể điều trị sự thẳng hàng bất thường của hàm và răng. Nhà cung cấp dịch vụ chăm sóc sức khoẻ ban đầu của bạn cũng nên tham gia để kiểm tra các rối loạn bệnh lý tiềm ẩn';
MERGE (n:Disease {id: 'D2437'}) SET n.id = 'D2437', n.name = 'Bệnh não chất trắng đa ổ tiến triển', n.name_en = 'Progressive multifocal leukoencephalopathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000674.htm', n.prognosis = 'PML là một tình trạng nguy hiểm đến tính mạng. Tùy thuộc vào mức độ nghiêm trọng của nhiễm trùng, có tới một nửa số người được chẩn đoán mắc PML sẽ chết trong vòng vài tháng đầu tiên. Nói chuyện với n';
MERGE (n:Disease {id: 'D2438'}) SET n.id = 'D2438', n.name = 'Bệnh liệt siêu nhân tiến triển', n.name_en = 'Progressive supranuclear palsy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/progressive-supranuclear-palsy/symptoms-causes/syc-20355659 | https://medlineplus.gov/ency/article/000767.htm', n.overview = 'Nguyên nhân gây liệt siêu nhân ở thân não, vỏ não, tiểu não và hạch nền - một cụm tế bào nằm sâu trong não của bạn - là nguyên nhân gây ra các vấn đề về phối hợp và vận động của bệnh liệt siêu nhân ti', n.prognosis = 'Việc điều trị đôi khi có thể làm giảm triệu chứng trong một thời gian nhưng tình trạng sẽ nặng hơn. Chức năng não sẽ suy giảm theo thời gian. Cái chết thường xảy ra trong 5 đến 7 năm. Các loại thuốc m', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn thường xuyên bị ngã và nếu bạn bị cứng cổ/cơ thể và các vấn đề về thị lực. Ngoài ra, hãy gọi điện nếu người thân đã được chẩn đoán mắc bệnh PSP và ';
MERGE (n:Disease {id: 'D2439'}) SET n.id = 'D2439', n.name = 'Prolactinoma', n.name_en = 'Prolactinoma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/prolactinoma/symptoms-causes/syc-20376958 | https://medlineplus.gov/ency/article/000336.htm', n.overview = 'là một khối u của tuyến yên không phải là ung thư. Khối u này khiến tuyến yên sản xuất quá nhiều hormone gọi là prolactin. U prolactinoma không nguy hiểm đến tính mạng. Nhưng nó có thể gây ra những lo', n.prognosis = 'Triển vọng thường rất tốt nhưng phụ thuộc vào sự thành công của điều trị nội khoa hoặc phẫu thuật. Việc xét nghiệm để kiểm tra xem khối u đã quay trở lại sau khi điều trị hay chưa là điều quan trọng. ', n.when_to_see = 'Nếu bạn có các triệu chứng có thể do u tiết prolactin gây ra, hãy gặp chuyên gia chăm sóc sức khỏe của bạn. Nếu bạn bị u tiết prolactin và muốn mang thai hoặc đã mang thai, hãy nói chuyện với chuyên g';
MERGE (n:Disease {id: 'D2440'}) SET n.id = 'D2440', n.name = 'Quá liều promethazine', n.name_en = 'Promethazine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002527.htm', n.prognosis = 'Nếu người đó sống sót sau 24 giờ đầu tiên, khả năng phục hồi là có thể. Những người bị nhịp tim bất thường và co giật có nguy cơ cao nhất gặp phải hậu quả nghiêm trọng. Rất ít người thực sự chết vì dù';
MERGE (n:Disease {id: 'D2441'}) SET n.id = 'D2441', n.name = 'Ngộ độc propan', n.name_en = 'Propane poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002836.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào loại tiếp xúc với chất độc và tốc độ điều trị được tiếp nhận như thế nào. Một người nhận được trợ giúp y tế càng nhanh thì càng tốt. Những người tiếp xú';
MERGE (n:Disease {id: 'D2442'}) SET n.id = 'D2442', n.name = 'Propyl Alcohol', n.name_en = 'Propyl alcohol', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002538.htm', n.prognosis = 'Ngộ độc rượu propyl hiếm khi gây tử vong. Có thể xảy ra những ảnh hưởng lâu dài, bao gồm suy thận, có thể phải chạy thận nhân tạo (máy thận). Lọc máu cũng có thể cần thiết trong trường hợp ngộ độc cấp';
MERGE (n:Disease {id: 'D2443'}) SET n.id = 'D2443', n.name = 'Xạ trị áp sát tuyến tiền liệt', n.name_en = 'Prostate brachytherapy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007385.htm', n.overview = 'Xạ trị áp sát tuyến tiền liệt mất 30 phút hoặc hơn, tùy thuộc vào loại trị liệu mà bạn áp dụng. Trước khi thực hiện, bạn sẽ được uống thuốc để không cảm thấy đau. Bạn có thể nhận được: Thuốc an thần g', n.prognosis = 'Hầu hết nam giới mắc bệnh ung thư tuyến tiền liệt nhỏ, phát triển chậm vẫn không bị ung thư hoặc bệnh ung thư của họ được kiểm soát tốt trong nhiều năm sau khi điều trị bằng phương pháp này. Các triệu';
MERGE (n:Disease {id: 'D2444'}) SET n.id = 'D2444', n.name = 'Ung thư tuyến tiền liệt', n.name_en = 'Prostate cancer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/prostate-cancer/symptoms-causes/syc-20353087 | https://medlineplus.gov/ency/article/000380.htm', n.overview = 'Ung thư tuyến tiền liệt là gì? Chuyên gia của Mayo Clinic giải thích Tìm hiểu thêm về ung thư tuyến tiền liệt từ bác sĩ tiết niệu Mitchell Humphreys của Mayo Clinic Hiển thị bản ghi cho video Ung thư ', n.prognosis = 'Kết quả của bạn tốt như thế nào tùy thuộc vào việc ung thư có lan ra ngoài tuyến tiền liệt hay không và mức độ bất thường của các tế bào ung thư (điểm Gleason) khi bạn được chẩn đoán. Có thể chữa khỏi', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
';
MERGE (n:Disease {id: 'D2445'}) SET n.id = 'D2445', n.name = 'Ung thư tuyến tiền liệt tái phát', n.name_en = 'Prostate cancer recurrence', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/prostate-cancer-recurrence/symptoms-causes/syc-20592131', n.overview = 'là khi ung thư tuyến tiền liệt quay trở lại sau khi điều trị. Nó có thể xảy ra nếu một số tế bào ung thư ẩn náu trong cơ thể và bắt đầu phát triển trở lại. Tái phát ung thư tuyến tiền liệt thường xảy ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Nếu bạn đến khám thường xuyên với đội ngũ chăm sóc sức khỏe đã điều trị bệnh ung thư tuyế';
MERGE (n:Disease {id: 'D2446'}) SET n.id = 'D2446', n.name = 'Cắt bỏ tuyến tiền liệt - xâm lấn tối thiểu', n.name_en = 'Prostate resection - minimally invasive', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007415.htm', n.overview = 'Những thủ tục này thường được thực hiện tại phòng khám của bác sĩ phẫu thuật hoặc tại trung tâm phẫu thuật. Phẫu thuật có thể được thực hiện theo nhiều cách. Loại phẫu thuật sẽ phụ thuộc vào kích thướ', n.prognosis = 'Trong hầu hết các trường hợp, các quy trình này có thể làm giảm các triệu chứng của bạn. Nhưng bạn có nhiều khả năng cần phải phẫu thuật lần thứ hai sau 5 đến 10 năm so với khi bạn cắt bỏ tuyến tiền l';
MERGE (n:Disease {id: 'D2447'}) SET n.id = 'D2447', n.name = 'Viêm tuyến tiền liệt', n.name_en = 'Prostatitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/prostatitis/symptoms-causes/syc-20355766', n.overview = 'là tình trạng tuyến tiền liệt thường liên quan đến sưng tấy và kích ứng, được gọi là viêm. Viêm tuyến tiền liệt có thể khiến bạn đau hoặc khó đi tiểu. Nó cũng có thể gây đau ở háng, vùng xương chậu ho', n.when_to_see = 'Một số tình trạng có thể gây ra các triệu chứng giống như bệnh viêm tuyến tiền liệt. Nhận chẩn đoán và điều trị càng sớm càng tốt. Hãy chăm sóc ngay nếu bạn: Không thể đi tiểu. Bị sốt và khó tiểu hoặc';
MERGE (n:Disease {id: 'D2448'}) SET n.id = 'D2448', n.name = 'Viêm tuyến tiền liệt - vi khuẩn', n.name_en = 'Prostatitis - bacterial', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000519.htm', n.prognosis = 'Viêm tuyến tiền liệt cấp tính sẽ khỏi bằng thuốc và những thay đổi nhỏ trong chế độ ăn uống và hành vi của bạn. Nó có thể quay trở lại hoặc biến thành viêm tuyến tiền liệt mãn tính.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng viêm tuyến tiền liệt.';
MERGE (n:Disease {id: 'D2449'}) SET n.id = 'D2449', n.name = 'Viêm tuyến tiền liệt - không do vi khuẩn', n.name_en = 'Prostatitis - nonbacterial', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000524.htm', n.prognosis = 'Nhiều người phản ứng với điều trị. Tuy nhiên, một số khác vẫn không thấy nhẹ nhõm dù đã thử nhiều cách. Các triệu chứng thường quay trở lại và có thể không thể điều trị được.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng viêm tuyến tiền liệt.';
MERGE (n:Disease {id: 'D2450'}) SET n.id = 'D2450', n.name = 'Bệnh đường ruột mất protein', n.name_en = 'Protein-losing enteropathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007338.htm';
MERGE (n:Disease {id: 'D2451'}) SET n.id = 'D2451', n.name = 'Thiếu protrombin', n.name_en = 'Prothrombin deficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000549.htm', n.prognosis = 'Kết quả tốt nếu được điều trị thích hợp. Thiếu hụt protrombin di truyền là tình trạng kéo dài suốt đời. Triển vọng thiếu hụt protrombin mắc phải phụ thuộc vào nguyên nhân. Nếu nguyên nhân là do bệnh g', n.when_to_see = 'Hãy điều trị khẩn cấp ngay nếu bạn bị mất máu lâu dài hoặc không rõ nguyên nhân hoặc nếu bạn không thể kiểm soát được tình trạng chảy máu.';
MERGE (n:Disease {id: 'D2452'}) SET n.id = 'D2452', n.name = 'Liệu pháp proton', n.name_en = 'Proton therapy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007281.htm', n.overview = 'Hầu hết các loại xạ trị đều sử dụng tia X để tiêu diệt tế bào ung thư. Liệu pháp proton sử dụng chùm hạt đặc biệt gọi là proton. Chùm proton có thể được nhắm tốt hơn vào khối u, do đó ít gây tổn hại h';
MERGE (n:Disease {id: 'D2453'}) SET n.id = 'D2453', n.name = 'Rối loạn máy giật tạm thời', n.name_en = 'Provisional tic disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000747.htm', n.prognosis = 'Những cơn giật cơ đơn giản thời thơ ấu thường biến mất trong khoảng thời gian vài tháng. Nếu các triệu chứng kéo dài hơn ba tháng, chúng có nhiều khả năng trở thành mãn tính.', n.when_to_see = 'Hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu bạn lo lắng về chứng rối loạn máy giật tạm thời, đặc biệt nếu nó tiếp tục hoặc làm gián đoạn cuộc sống của con bạn. Nếu bạn kh';
MERGE (n:Disease {id: 'D2454'}) SET n.id = 'D2454', n.name = 'Nhiễm toan ở ống thận gần', n.name_en = 'Proximal renal tubular acidosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000497.htm', n.prognosis = 'Mặc dù nguyên nhân cơ bản của nhiễm toan ống thận gần có thể tự khỏi nhưng những ảnh hưởng và biến chứng có thể tồn tại vĩnh viễn hoặc đe dọa tính mạng. Điều trị thường thành công.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng nhiễm toan ống thận gần. Nhận trợ giúp y tế ngay lập tức nếu phát triển bất kỳ triệu chứng khẩn cấp nào sau đây: Giảm sự tỉnh tá';
MERGE (n:Disease {id: 'D2455'}) SET n.id = 'D2455', n.name = 'Hội chứng bụng mận', n.name_en = 'Prune belly syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001269.htm', n.prognosis = 'Hội chứng bụng mận là một vấn đề nghiêm trọng và thường đe dọa đến tính mạng. Nhiều trẻ sơ sinh mắc bệnh này chết non hoặc chết trong vài tuần đầu đời. Nguyên nhân tử vong là do các vấn đề nghiêm trọn', n.when_to_see = 'Hội chứng bụng mận thường được chẩn đoán trước khi sinh hoặc khi trẻ chào đời. Nếu bạn có con được chẩn đoán mắc hội chứng bụng mận, hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn khi ';
MERGE (n:Disease {id: 'D2456'}) SET n.id = 'D2456', n.name = 'Pseudobulbar ảnh hưởng đến', n.name_en = 'Pseudobulbar affect', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pseudobulbar-affect/symptoms-causes/syc-20353737', n.overview = ', còn được gọi là PBA, là một tình trạng não trong đó một người đột nhiên cười hoặc khóc và không thể kiểm soát được phản ứng. Thuật ngữ "pseudobulbar" có nghĩa là một tình trạng trong đường dẫn corti', n.when_to_see = 'Nếu bạn cho rằng mình bị ảnh hưởng bởi thanh giả hành, hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn. Nếu bạn đang được điều trị bệnh thần kinh, bác sĩ chuyên khoa có thể chẩn đoán PBA. Nhiề';
MERGE (n:Disease {id: 'D2457'}) SET n.id = 'D2457', n.name = 'Thiếu Pseudocholinesterase', n.name_en = 'Pseudocholinesterase deficiency', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pseudocholinesterase-deficiency/symptoms-causes/syc-20354543', n.overview = 'Thiếu Pseudocholinesterase (soo-doe-koh-lin-ES-tur-ays) là một chứng rối loạn hiếm gặp khiến bạn nhạy cảm với một số thuốc giãn cơ - succinylcholine hoặc mivacurium - được sử dụng trong quá trình gây ', n.when_to_see = 'Nếu bạn có tiền sử gia đình bị thiếu hụt pseudocholinesterase hoặc một thành viên trong gia đình gặp bất kỳ vấn đề nào với việc gây mê, hãy báo cho nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn trước';
MERGE (n:Disease {id: 'D2458'}) SET n.id = 'D2458', n.name = 'Pseudogout', n.name_en = 'Pseudogout', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pseudogout/symptoms-causes/syc-20376983', n.overview = '(SOO-doe-gout) là một loại bệnh viêm khớp gây sưng tấy đột ngột và đau đớn ở một hoặc nhiều khớp. Các tập phim có thể kéo dài hàng ngày hoặc hàng tuần. Thuật ngữ y học cho bệnh giả gút là bệnh lắng đọ', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế nếu bạn bị đau và sưng khớp đột ngột, dữ dội. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2459'}) SET n.id = 'D2459', n.name = 'Giả suy tuyến cận giáp', n.name_en = 'Pseudohypoparathyroidism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000364.htm', n.prognosis = 'Hạ canxi máu ở bệnh PHP thường nhẹ hơn so với các dạng suy tuyến cận giáp khác, nhưng mức độ nghiêm trọng của các triệu chứng có thể khác nhau giữa những người khác nhau.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc con bạn có bất kỳ triệu chứng nào về mức canxi thấp hoặc bệnh giả suy tuyến cận giáp.';
MERGE (n:Disease {id: 'D2460'}) SET n.id = 'D2460', n.name = 'Viêm đại tràng màng giả', n.name_en = 'Pseudomembranous colitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/pseudomembranous-colitis/symptoms-causes/syc-20351434 | https://medlineplus.gov/ency/article/000259.htm', n.overview = 'Viêm đại tràng màng giả (SOO-doe-mem-bruh-nus) là tình trạng viêm đại tràng tiến triển có thể gây tiêu chảy nghiêm trọng hoặc đe dọa tính mạng. Viêm đại tràng giả mạc thường do vi khuẩn sản sinh ra ch', n.prognosis = 'Triển vọng tốt trong hầu hết các trường hợp nếu không có biến chứng. Tuy nhiên, có tới 1 trong 5 ca nhiễm trùng có thể tái phát và cần điều trị thêm.', n.when_to_see = 'Nếu bạn hiện đang dùng hoặc gần đây đã dùng thuốc kháng sinh và bị tiêu chảy, hãy liên hệ với chuyên gia chăm sóc sức khỏe của bạn. Ngoài ra, hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn bất cứ kh';
MERGE (n:Disease {id: 'D2461'}) SET n.id = 'D2461', n.name = 'Giả u não (tăng huyết áp nội sọ vô căn)', n.name_en = 'Pseudotumor cerebri (idiopathic intracranial hypertension)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pseudotumor-cerebri/symptoms-causes/syc-20354031', n.overview = 'Tăng huyết áp nội sọ vô căn (IIH) xảy ra khi áp lực bên trong hộp sọ tăng lên mà không có nguyên nhân rõ ràng. IIH còn được gọi là não giả (SOO-doe-too-mur SER-uh-bry). Áp lực nội sọ cao hơn có thể dẫ';
MERGE (n:Disease {id: 'D2462'}) SET n.id = 'D2462', n.name = 'Bệnh vẩy nến', n.name_en = 'Psittacosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000088.htm', n.prognosis = 'Dự kiến ​​bạn sẽ hồi phục hoàn toàn nếu không mắc bất kỳ bệnh lý nào khác ảnh hưởng đến sức khỏe của mình.', n.when_to_see = 'Cần có thuốc kháng sinh để điều trị bệnh nhiễm trùng này. Nếu bạn phát triển các triệu chứng của bệnh psittacosis, hãy liên hệ với nhà cung cấp của bạn.';
MERGE (n:Disease {id: 'D2463'}) SET n.id = 'D2463', n.name = 'Viêm khớp vẩy nến', n.name_en = 'Psoriatic arthritis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/psoriatic-arthritis/symptoms-causes/syc-20354076 | https://medlineplus.gov/ency/article/000413.htm', n.overview = 'là một loại viêm khớp có thể ảnh hưởng đến những người mắc bệnh vẩy nến. Bệnh vẩy nến là một tình trạng da gây ra các mảng ngứa, có vảy trên da. Các mảng da có thể có màu đỏ, tím hoặc nâu tùy thuộc và', n.prognosis = 'Bệnh đôi khi nhẹ và chỉ ảnh hưởng đến một vài khớp. Tuy nhiên, ở nhiều người bị viêm khớp vẩy nến, tổn thương khớp xảy ra trong vài năm đầu. Ở một số người, bệnh viêm khớp nặng có thể gây biến dạng ở ', n.when_to_see = 'Nếu bạn bị bệnh vẩy nến và bắt đầu nhận thấy đau khớp hoặc cứng khớp, hãy nói với chuyên gia chăm sóc sức khỏe của bạn. Nói chuyện với chuyên gia chăm sóc sức khỏe của bạn về việc gặp bác sĩ thấp khớp';
MERGE (n:Disease {id: 'D2464'}) SET n.id = 'D2464', n.name = 'Rối loạn tâm thần', n.name_en = 'Psychosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001553.htm', n.prognosis = 'Một người hoạt động tốt như thế nào tùy thuộc vào nguyên nhân gây ra chứng rối loạn tâm thần. Nếu nguyên nhân có thể được khắc phục thì triển vọng thường tốt. Trong trường hợp này, việc điều trị bằng ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe hoặc chuyên gia sức khỏe tâm thần của bạn nếu bạn hoặc một thành viên trong gia đình bạn mất liên lạc với thực tế. Nếu có bất kỳ lo ngại nào về s';
MERGE (n:Disease {id: 'D2465'}) SET n.id = 'D2465', n.name = 'Mộng thịt', n.name_en = 'Pterygium', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001011.htm', n.prognosis = 'Hầu hết chứng đau mộng thịt không gây ra vấn đề gì và không cần điều trị bằng phẫu thuật. Nếu mộng thịt ảnh hưởng đến giác mạc, việc loại bỏ nó có thể mang lại kết quả tốt.', n.when_to_see = 'Những người bị mộng thịt nên được bác sĩ nhãn khoa khám mỗi năm. Điều này sẽ cho phép tình trạng này được điều trị trước khi nó ảnh hưởng đến thị lực. Liên hệ với bác sĩ nhãn khoa nếu bạn đã từng bị m';
MERGE (n:Disease {id: 'D2466'}) SET n.id = 'D2466', n.name = 'Chấy rận (cua)', n.name_en = 'Pubic lice (crabs)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pubic-lice-crabs/symptoms-causes/syc-20350300', n.overview = 'Chấy rận hay còn gọi là cua, là loài côn trùng nhỏ bé xâm nhập vào vùng sinh dục. Chúng khác với chấy trên đầu và chấy trên cơ thể. Với kích thước từ 1/16 inch (1,6 mm) trở xuống, rận mu được gọi là c', n.when_to_see = 'Đối với chấy rận mu, hãy gặp chuyên gia chăm sóc sức khỏe của bạn để tìm hiểu xem bạn có mắc các bệnh lây truyền qua đường tình dục khác hay không. Trẻ em bị chấy rận cần gặp chuyên gia chăm sóc sức k';
MERGE (n:Disease {id: 'D2467'}) SET n.id = 'D2467', n.name = 'Nhiễm Actinomycosis phổi', n.name_en = 'Pulmonary actinomycosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000074.htm', n.prognosis = 'Hầu hết mọi người đều khỏe hơn sau khi điều trị bằng kháng sinh.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có các triệu chứng của bệnh nhiễm nấm phổi Các triệu chứng của bạn trở nên tồi tệ hơn hoặc không cải thiện khi điều trị Bạn xuất hiện các triệu ch';
MERGE (n:Disease {id: 'D2468'}) SET n.id = 'D2468', n.name = 'Nhiễm protein phế nang phổi', n.name_en = 'Pulmonary alveolar proteinosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000114.htm', n.prognosis = 'Một số người bị PAP thuyên giảm. Những người khác bị suy giảm chức năng phổi (suy hô hấp) ngày càng trầm trọng hơn và họ có thể cần phải ghép phổi.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng nghiêm trọng về hô hấp. Khó thở ngày càng trầm trọng hơn theo thời gian có thể báo hiệu tình trạng của bạn đang phát triể';
MERGE (n:Disease {id: 'D2469'}) SET n.id = 'D2469', n.name = 'Rò động tĩnh mạch phổi', n.name_en = 'Pulmonary arteriovenous fistula', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001090.htm', n.prognosis = 'Triển vọng của những người mắc HHT không tốt bằng những người không mắc HHT. Đối với những người không có HHT, phẫu thuật cắt bỏ các mạch máu bất thường thường có kết quả tốt và tình trạng này khó có ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn thường xuyên bị chảy máu cam hoặc khó thở, đặc biệt nếu bạn cũng có tiền sử cá nhân hoặc gia đình mắc bệnh HHT.';
MERGE (n:Disease {id: 'D2470'}) SET n.id = 'D2470', n.name = 'Bệnh aspergilloma ở phổi', n.name_en = 'Pulmonary aspergilloma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000127.htm', n.prognosis = 'Kết quả có thể tốt cho nhiều người. Tuy nhiên, nó phụ thuộc vào mức độ nghiêm trọng của tình trạng và sức khỏe tổng thể của bạn. Phẫu thuật có thể rất thành công trong một số trường hợp, nhưng nó phức', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn ho ra máu và nhớ đề cập đến bất kỳ triệu chứng nào khác đã phát triển.';
MERGE (n:Disease {id: 'D2471'}) SET n.id = 'D2471', n.name = 'Chứng teo phổi', n.name_en = 'Pulmonary atresia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/pulmonary-atresia/symptoms-causes/syc-20350727 | https://medlineplus.gov/ency/article/001091.htm', n.overview = 'dòng nước chảy từ tim đến phổi không hình thành như bình thường. Thay vào đó, một lượng máu có thể đi vào phổi thông qua một kết nối tạm thời gọi là ống động mạch. Ống động mạch nằm giữa động mạch chí', n.prognosis = 'Hầu hết các trường hợp đều có thể được hỗ trợ bằng phẫu thuật. Sức khỏe của em bé phụ thuộc vào: Kích thước và sự kết nối của động mạch phổi (động mạch đưa máu đến phổi) Tim đập tốt như thế nào Các va', n.when_to_see = 'Chứng teo phổi thường được phát hiện ngay sau khi sinh. Nếu con bạn có các triệu chứng teo phổi sau khi bạn xuất viện, hãy nhờ trợ giúp y tế ngay lập tức. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2472'}) SET n.id = 'D2472', n.name = 'Hẹp phổi với thông liên thất', n.name_en = 'Pulmonary atresia with ventricular septal defect', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pulmonary-atresia-ventricular-septum-defect/symptoms-causes/syc-20580510', n.overview = 'Hẹp phổi (uh-TREE-zhuh) với thông liên thất, còn được gọi là PA-VSD, là một bệnh tim xuất hiện khi mới sinh. Điều đó có nghĩa đó là khuyết tật tim bẩm sinh. Khi bị teo phổi, van giữa tim và phổi chưa ', n.when_to_see = 'Teo phổi kèm thông liên thất hay còn gọi là PA-VSD, thường được phát hiện trong thời kỳ mang thai hoặc ngay sau khi sinh. Nếu con bạn có các triệu chứng của tình trạng này sau khi sinh, hãy gọi cho ch';
MERGE (n:Disease {id: 'D2473'}) SET n.id = 'D2473', n.name = 'Phù phổi', n.name_en = 'Pulmonary edema', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/pulmonary-edema/symptoms-causes/syc-20377009 | https://medlineplus.gov/ency/article/000140.htm', n.overview = 'là tình trạng do có quá nhiều chất lỏng trong phổi. Chất lỏng này tích tụ trong nhiều túi khí trong phổi, gây khó thở. Trong hầu hết các trường hợp, các vấn đề về tim đều gây ra phù phổi. Nhưng chất l', n.prognosis = 'Triển vọng tùy thuộc vào nguyên nhân. Tình trạng có thể tốt hơn nhanh chóng hoặc chậm rãi. Một số người có thể cần sử dụng máy thở trong thời gian dài. Nếu không được điều trị, tình trạng này có thể đ', n.when_to_see = 'Phù phổi xuất hiện đột ngột (phù phổi cấp tính) đe dọa tính mạng. Gọi 911 hoặc trợ giúp y tế khẩn cấp nếu bạn có bất kỳ triệu chứng cấp tính nào sau đây: Khó thở, đặc biệt là nếu nó xuất hiện đột ngột';
MERGE (n:Disease {id: 'D2474'}) SET n.id = 'D2474', n.name = 'Thuyên tắc phổi', n.name_en = 'Pulmonary embolism', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pulmonary-embolism/symptoms-causes/syc-20354647', n.overview = 'cục máu đông mắc kẹt trong động mạch trong phổi, làm tắc nghẽn dòng máu đến một phần của phổi. Các cục máu đông thường bắt đầu ở chân và di chuyển lên phía bên phải của tim và vào phổi. Điều này được ', n.when_to_see = 'Thuyên tắc phổi có thể đe dọa tính mạng. Tìm kiếm sự chăm sóc y tế khẩn cấp nếu bạn cảm thấy khó thở, đau ngực hoặc ngất xỉu không rõ nguyên nhân. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gử';
MERGE (n:Disease {id: 'D2475'}) SET n.id = 'D2475', n.name = 'Xơ phổi', n.name_en = 'Pulmonary fibrosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pulmonary-fibrosis/symptoms-causes/syc-20353690', n.overview = 'd mô xung quanh và giữa các túi khí gọi là phế nang trong phổi, như minh họa bên phải. Một lá phổi khỏe mạnh với các phế nang khỏe mạnh được hiển thị bên trái. Xơ phổi là một bệnh về phổi xảy ra khi m', n.when_to_see = 'Nếu bạn có các triệu chứng xơ phổi, hãy liên hệ với bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác càng sớm càng tốt. Nếu các triệu chứng của bạn trở nên tồi tệ hơn, đặc biệt là nếu chúng trở nên tồi t';
MERGE (n:Disease {id: 'D2476'}) SET n.id = 'D2476', n.name = 'Tăng huyết áp phổi', n.name_en = 'Pulmonary hypertension', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/pulmonary-hypertension/symptoms-causes/syc-20350697 | https://medlineplus.gov/ency/article/000112.htm', n.overview = 'dày lên, thu hẹp, tắc nghẽn hoặc bị phá hủy, khiến máu khó lưu thông qua phổi hơn. Kết quả là huyết áp tăng lên trong phổi. Tình trạng này được gọi là tăng huyết áp phổi. Tăng huyết áp phổi là một loạ', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào nguyên nhân gây ra tình trạng này. Thuốc điều trị IPAH có thể giúp làm chậm bệnh. Khi bệnh trở nên nặng hơn, bạn sẽ cần phải thực hiện những thay đổi trong nhà để', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bắt đầu khó thở khi hoạt động Khó thở trở nên trầm trọng hơn Bạn bị đau ngực Bạn xuất hiện các triệu chứng khác Bạn cảm thấy choáng váng hoặc chón';
MERGE (n:Disease {id: 'D2477'}) SET n.id = 'D2477', n.name = 'Bệnh nocardiosis phổi', n.name_en = 'Pulmonary nocardiosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000083.htm', n.prognosis = 'Kết quả thường tốt khi bệnh được chẩn đoán và điều trị nhanh chóng. Kết quả kém khi: Nhiễm trùng lan ra ngoài phổi. Việc điều trị bị trì hoãn. Người đó mắc một căn bệnh nghiêm trọng dẫn đến hoặc cần p', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng của chứng rối loạn này. Chẩn đoán và điều trị sớm có thể cải thiện cơ hội đạt được kết quả tốt.';
MERGE (n:Disease {id: 'D2478'}) SET n.id = 'D2478', n.name = 'Bệnh lao phổi', n.name_en = 'Pulmonary tuberculosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000077.htm', n.prognosis = 'Các triệu chứng thường cải thiện sau 2 đến 3 tuần sau khi bắt đầu điều trị. Chụp X-quang ngực sẽ không cho thấy sự cải thiện này cho đến vài tuần hoặc vài tháng sau. Triển vọng sẽ rất tốt nếu bệnh lao', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn nghĩ hoặc biết mình đã tiếp xúc với bệnh lao Bạn phát triển các triệu chứng của bệnh lao Các triệu chứng của bạn vẫn tiếp tục mặc dù đã được điều trị Các ';
MERGE (n:Disease {id: 'D2479'}) SET n.id = 'D2479', n.name = 'Bệnh van phổi', n.name_en = 'Pulmonary valve disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pulmonary-valve-disease/symptoms-causes/syc-20350654', n.overview = 'là một loại bệnh về van tim. Nó ảnh hưởng đến van giữa buồng dưới bên phải của tim và động mạch đưa máu đến phổi. Động mạch đó được gọi là động mạch phổi. Van được gọi là van phổi. Van phổi bị bệnh ho', n.when_to_see = 'Hãy hẹn khám sức khỏe nếu bạn hoặc con bạn bị: Khó thở. Đau ngực. Ngất xỉu. Gọi 911 hoặc số cấp cứu tại địa phương nếu đau ngực đột ngột hoặc không thể giải thích được. Chẩn đoán và điều trị nhanh bện';
MERGE (n:Disease {id: 'D2480'}) SET n.id = 'D2480', n.name = 'Hẹp van phổi', n.name_en = 'Pulmonary valve stenosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pulmonary-valve-stenosis/symptoms-causes/syc-20377034', n.overview = 'là tình trạng hẹp van giữa buồng tim phía dưới bên phải và động mạch phổi. Khi van tim bị hẹp, các vạt van có thể trở nên dày hoặc cứng. Điều này làm giảm lưu lượng máu qua van. Hẹp phổi Trong hẹp phổ', n.when_to_see = 'Hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn bị: Khó thở. Đau ngực. Ngất xỉu. Chẩn đoán và điều trị kịp thời chứng hẹp van động mạch phổi có thể giúp giảm ngu';
MERGE (n:Disease {id: 'D2481'}) SET n.id = 'D2481', n.name = 'Bệnh tắc tĩnh mạch phổi', n.name_en = 'Pulmonary veno-occlusive disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000075.htm', n.prognosis = 'Kết quả thường rất kém ở trẻ sơ sinh, tỷ lệ sống sót chỉ sau vài tuần. Sự sống sót ở người lớn có thể là vài tháng đến vài năm.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của chứng rối loạn này.';
MERGE (n:Disease {id: 'D2482'}) SET n.id = 'D2482', n.name = 'Hẹp van động mạch phổi', n.name_en = 'Pulmonic valve stenosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001096.htm', n.prognosis = 'Người mắc bệnh nhẹ hiếm khi nặng hơn. Tuy nhiên, những người mắc bệnh từ trung bình đến nặng sẽ nặng hơn. Kết quả thường rất tốt khi phẫu thuật hoặc nong bóng thành công. Các khuyết tật tim bẩm sinh k', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có các triệu chứng hẹp van động mạch phổi. Bạn đã được điều trị hoặc bị hẹp van phổi không được điều trị và bị sưng (mắt cá chân, chân hoặc bụng),';
MERGE (n:Disease {id: 'D2483'}) SET n.id = 'D2483', n.name = 'Xung - giới hạn', n.name_en = 'Pulse - bounding', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003077.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu cường độ hoặc nhịp mạch của bạn tăng đột ngột và không biến mất. Điều này rất quan trọng khi: Bạn có các triệu chứng khác cùng với nh';
MERGE (n:Disease {id: 'D2484'}) SET n.id = 'D2484', n.name = 'Đồng tử - trắng', n.name_en = 'Pupil - white', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003315.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nhận thấy bất kỳ thay đổi màu nào ở mắt đồng tử hoặc giác mạc của mắt.';
MERGE (n:Disease {id: 'D2485'}) SET n.id = 'D2485', n.name = 'Ban xuất huyết', n.name_en = 'Purpura', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003232.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn để lấy hẹn nếu bạn có dấu hiệu ban xuất huyết.';
MERGE (n:Disease {id: 'D2486'}) SET n.id = 'D2486', n.name = 'Hẹp môn vị', n.name_en = 'Pyloric stenosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pyloric-stenosis/symptoms-causes/syc-20351416', n.overview = 'Pylorus dạ dày cho đến khi sẵn sàng cho giai đoạn tiếp theo của quá trình tiêu hóa. Van hẹp môn vị dày lên, ngăn chặn thức ăn đi vào ruột non của bé. Hẹp môn vị (pie-LOHR-ik stuh-NOH-sis) là tình trạn', n.when_to_see = 'Các bệnh khác có triệu chứng như hẹp môn vị. Điều quan trọng là có được chẩn đoán nhanh chóng và chính xác. Hãy đưa bé đi khám bác sĩ nếu bé: Nôn mửa sau khi bú. Lại đói ngay sau khi nôn. Có vẻ ít hoạ';
MERGE (n:Disease {id: 'D2487'}) SET n.id = 'D2487', n.name = 'Hẹp môn vị ở trẻ sơ sinh', n.name_en = 'Pyloric stenosis in infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000970.htm', n.prognosis = 'Phẫu thuật thường làm giảm tất cả các triệu chứng. Ngay sau vài giờ sau phẫu thuật, trẻ sơ sinh có thể bắt đầu bú ít và thường xuyên.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có các triệu chứng của tình trạng này.';
MERGE (n:Disease {id: 'D2488'}) SET n.id = 'D2488', n.name = 'Pyloroplasty', n.name_en = 'Pyloroplasty', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002922.htm', n.overview = 'Phẫu thuật được thực hiện trong khi bạn đang được gây mê toàn thân (ngủ và không đau). Nếu bạn phẫu thuật mở, bác sĩ phẫu thuật: Thực hiện một vết phẫu thuật lớn ở bụng của bạn để mở khu vực đó. Cắt q', n.prognosis = 'Hầu hết mọi người đều hồi phục nhanh chóng và hoàn toàn. Thời gian nằm viện trung bình là 2 đến 3 ngày. Có khả năng bạn có thể từ từ bắt đầu chế độ ăn kiêng bình thường sau vài tuần.';
MERGE (n:Disease {id: 'D2489'}) SET n.id = 'D2489', n.name = 'Viêm da mủ hoại thư', n.name_en = 'Pyoderma gangrenosum', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/pyoderma-gangrenosum/symptoms-causes/syc-20350386', n.overview = 'Viêm da mủ hoại thư tiến triển có thể gây ra các vết loét hở, đau đớn có viền màu xanh hoặc tím. Pyoderma gangrenosum (pie-o-DUR-muh gang-ruh-NO-sum) là một tình trạng hiếm gặp gây ra vết loét lớn, đa', n.when_to_see = 'Hãy nói chuyện với chuyên gia chăm sóc sức khỏe nếu bạn có vết thương ngoài da đau đớn và phát triển nhanh chóng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2490'}) SET n.id = 'D2490', n.name = 'U hạt sinh mủ', n.name_en = 'Pyogenic granuloma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001464.htm', n.prognosis = 'Hầu hết các u hạt sinh mủ đều có thể được loại bỏ. Một vết sẹo có thể vẫn còn sau khi điều trị. Có khả năng cao vấn đề sẽ quay trở lại nếu toàn bộ tổn thương không được loại bỏ hoặc phá hủy trong quá ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có vết sưng trên da dễ chảy máu hoặc thay đổi diện mạo.';
MERGE (n:Disease {id: 'D2491'}) SET n.id = 'D2491', n.name = 'Áp xe gan sinh mủ', n.name_en = 'Pyogenic liver abscess', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000261.htm', n.prognosis = 'Tình trạng này có thể đe dọa tính mạng. Nguy cơ tử vong cao hơn ở những người bị áp xe gan nhiều.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có: Bất kỳ triệu chứng nào của chứng rối loạn này Đau bụng dữ dội Lẫn lộn hoặc giảm ý thức Sốt cao không biến mất Các triệu chứng mới';
MERGE (n:Disease {id: 'D2492'}) SET n.id = 'D2492', n.name = 'Thiếu pyruvate kinase', n.name_en = 'Pyruvate kinase deficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001197.htm', n.prognosis = 'Kết quả sẽ khác nhau. Một số người có ít hoặc không có triệu chứng. Những người khác có triệu chứng nghiêm trọng. Điều trị thường có thể làm cho các triệu chứng bớt nghiêm trọng hơn.', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ của bạn nếu: Bạn bị vàng da hoặc thiếu máu. Bạn có tiền sử gia đình mắc chứng rối loạn này và đang có kế hoạch sinh con. Tư vấn di truyền có thể giúp bạn biết khả năng con';
MERGE (n:Disease {id: 'D2493'}) SET n.id = 'D2493', n.name = 'Sốt Q', n.name_en = 'Q fever', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000611.htm', n.prognosis = 'Hầu hết mọi người đều khỏe hơn sau khi điều trị. Tuy nhiên, các biến chứng có thể rất nghiêm trọng và đôi khi thậm chí đe dọa tính mạng. Sốt Q phải luôn được điều trị nếu nó gây ra các triệu chứng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn xuất hiện các triệu chứng sốt Q. Đồng thời, hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn đã được điều trị bệnh sốt Q và c';
MERGE (n:Disease {id: 'D2494'}) SET n.id = 'D2494', n.name = 'Bệnh dại', n.name_en = 'Rabies', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/rabies/symptoms-causes/syc-20351821 | https://medlineplus.gov/ency/article/001334.htm', n.overview = 'là một loại vi-rút chết người lây sang người qua nước bọt của động vật bị nhiễm bệnh. Virus dại thường lây truyền qua vết cắn. Các loài động vật có nhiều khả năng truyền bệnh dại nhất ở Hoa Kỳ bao gồm', n.prognosis = 'Có thể phòng bệnh dại nếu tiêm vắc xin ngay sau khi bị cắn. Cho đến nay, không có ai ở Hoa Kỳ mắc bệnh dại khi họ được tiêm vắc xin kịp thời và thích hợp. Một khi các triệu chứng xuất hiện, người bệnh', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn bị bất kỳ động vật nào cắn hoặc tiếp xúc với động vật bị nghi mắc bệnh dại. Dựa trên vết thương của bạn và tình huống xảy ra phơi nhiễm, bạn và bác s';
MERGE (n:Disease {id: 'D2495'}) SET n.id = 'D2495', n.name = 'Rối loạn chức năng thần kinh quay', n.name_en = 'Radial nerve dysfunction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000790.htm', n.prognosis = 'Nếu có thể tìm ra nguyên nhân gây ra chứng rối loạn chức năng thần kinh và điều trị thành công thì rất có thể bạn sẽ bình phục hoàn toàn. Trong một số trường hợp, có thể mất một phần hoặc toàn bộ khả ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị chấn thương ở cánh tay và bị tê, ngứa ran, đau hoặc yếu ở phía sau cánh tay, ngón cái và 2 ngón đầu tiên của bạn.';
MERGE (n:Disease {id: 'D2496'}) SET n.id = 'D2496', n.name = 'Viêm ruột do xạ trị', n.name_en = 'Radiation enteritis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/radiation-enteritis/symptoms-causes/syc-20355409 | https://medlineplus.gov/ency/article/000300.htm', n.overview = 'là tình trạng viêm ruột xảy ra sau khi xạ trị. Viêm ruột do phóng xạ gây ra tiêu chảy, buồn nôn, nôn mửa và co thắt dạ dày ở những người được chiếu xạ vào vùng bụng, xương chậu hoặc trực tràng. Nó phổ', n.prognosis = 'Khi vùng bụng nhận được bức xạ, luôn có cảm giác buồn nôn, nôn mửa và tiêu chảy. Trong hầu hết các trường hợp, các triệu chứng sẽ thuyên giảm trong vòng 2 đến 3 tháng sau khi kết thúc điều trị. Tuy nh', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn đang xạ trị hoặc đã từng xạ trị và đang bị tiêu chảy nhiều, đau dạ dày và chuột rút.';
MERGE (n:Disease {id: 'D2497'}) SET n.id = 'D2497', n.name = 'Bệnh phóng xạ', n.name_en = 'Radiation sickness', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/radiation-sickness/symptoms-causes/syc-20377058 | https://medlineplus.gov/ency/article/000026.htm', n.overview = 'là tổn thương cơ thể do tiếp nhận một lượng lớn bức xạ trong thời gian ngắn. Đây được gọi là bệnh bức xạ cấp tính. Lượng bức xạ mà cơ thể hấp thụ, gọi là liều hấp thụ, quyết định mức độ bệnh sẽ nặng n', n.when_to_see = 'Một tai nạn hoặc một cuộc tấn công gây ra bệnh phóng xạ sẽ thu hút rất nhiều sự chú ý và quan tâm của công chúng. Nếu sự việc như vậy xảy ra, hãy nghe báo cáo trên đài phát thanh, truyền hình hoặc trự';
MERGE (n:Disease {id: 'D2498'}) SET n.id = 'D2498', n.name = 'Xạ trị', n.name_en = 'Radiation therapy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001918.htm', n.overview = 'Tế bào ung thư nhân lên nhanh hơn tế bào bình thường trong cơ thể. Vì bức xạ có hại nhất đối với các tế bào đang phát triển nhanh nên xạ trị sẽ gây tổn hại cho tế bào ung thư nhiều hơn tế bào bình thư';
MERGE (n:Disease {id: 'D2499'}) SET n.id = 'D2499', n.name = 'Phẫu thuật cắt bỏ tuyến tiền liệt triệt để', n.name_en = 'Radical prostatectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007300.htm', n.overview = 'Có 4 loại hoặc kỹ thuật chính của phẫu thuật cắt bỏ tuyến tiền liệt triệt để. Các thủ tục này mất khoảng 2 đến 4 giờ: Sau xương mu - Bác sĩ phẫu thuật của bạn sẽ thực hiện một vết cắt bắt đầu ngay dướ', n.prognosis = 'Cuộc phẫu thuật sẽ loại bỏ tất cả các tế bào ung thư. Tuy nhiên, bạn sẽ được theo dõi cẩn thận để đảm bảo ung thư không quay trở lại. Bạn nên kiểm tra sức khỏe thường xuyên, bao gồm xét nghiệm máu khá';
MERGE (n:Disease {id: 'D2500'}) SET n.id = 'D2500', n.name = 'Cắt bỏ tần số vô tuyến để điều trị chứng đau mãn tính', n.name_en = 'Radiofrequency ablation for chronic pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007820.htm', n.overview = 'Quy trình sẽ được thực hiện dưới sự hướng dẫn của tia X hoặc siêu âm, sử dụng kim, vi điện cực và dòng điện tần số vô tuyến. Thời gian thực hiện thủ tục mất khoảng 1 đến 2 giờ. Thủ tục có thể được thự', n.prognosis = 'Quy trình này có thể giúp giảm đau và có thể kéo dài đến 12 tháng và thậm chí lâu hơn.';
MERGE (n:Disease {id: 'D2501'}) SET n.id = 'D2501', n.name = 'Liệu pháp iốt phóng xạ', n.name_en = 'Radioiodine therapy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007702.htm', n.overview = 'Tuyến giáp là một tuyến hình con bướm nằm ở phía trước cổ dưới của bạn. Nó tạo ra các hormone giúp cơ thể bạn điều chỉnh quá trình trao đổi chất. Tuyến giáp của bạn cần iốt để hoạt động bình thường. I', n.prognosis = 'Các tác dụng phụ chỉ mang tính ngắn hạn và biến mất theo thời gian. Liều cao có ít nguy cơ mắc các biến chứng lâu dài bao gồm tổn thương tuyến nước bọt và nguy cơ mắc bệnh ác tính.';
MERGE (n:Disease {id: 'D2502'}) SET n.id = 'D2502', n.name = 'Hội chứng Ramsay Hunt', n.name_en = 'Ramsay Hunt syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/ramsay-hunt-syndrome/symptoms-causes/syc-20351783 | https://medlineplus.gov/ency/article/001647.htm', n.overview = ', còn được gọi là herpes zoster oticus, xảy ra khi virus varicella-zoster ảnh hưởng đến một số dây thần kinh trên mặt. Nó gây phát ban đau đớn gọi là bệnh zona. Phát ban có thể chủ yếu ở quanh tai hoặ', n.prognosis = 'Nếu dây thần kinh không bị tổn thương nhiều, bạn sẽ khỏi bệnh hoàn toàn trong vòng vài tuần. Nếu tổn thương nghiêm trọng hơn, bạn có thể không hồi phục hoàn toàn, thậm chí sau vài tháng. Nhìn chung, c', n.when_to_see = 'Hãy liên hệ với chuyên gia chăm sóc sức khỏe nếu bạn bị yếu hoặc mất khả năng cử động ở mặt hoặc nếu bạn bị phát ban đau đớn trên mặt. Bắt đầu dùng thuốc để điều trị hội chứng Ramsay Hunt sau ba ngày ';
MERGE (n:Disease {id: 'D2503'}) SET n.id = 'D2503', n.name = 'Thở nông nhanh', n.name_en = 'Rapid shallow breathing', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007198.htm', n.when_to_see = 'Gọi 911 hoặc số cấp cứu tại địa phương hoặc đến phòng cấp cứu nếu bạn thở nhanh và bạn có: Da, móng tay, nướu, môi hoặc vùng xung quanh mắt (tím tái) Đau ngực Thành ngực bị co lại theo mỗi hơi thở ( c';
MERGE (n:Disease {id: 'D2504'}) SET n.id = 'D2504', n.name = 'Phát ban - trẻ dưới 2 tuổi', n.name_en = 'Rash - child under 2 years', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003259.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của con bạn nếu con bạn bị: Sốt hoặc các triệu chứng không giải thích được liên quan đến phát ban Bất kỳ vùng nào trông ướt, rỉ nước hoặc đỏ, là dấu hiệu nhiễm trùng P';
MERGE (n:Disease {id: 'D2505'}) SET n.id = 'D2505', n.name = 'Sốt do chuột cắn', n.name_en = 'Rat-bite fever', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001348.htm', n.prognosis = 'Triển vọng sẽ rất tốt nếu được điều trị sớm. Nếu không được điều trị, tỷ lệ tử vong có thể lên tới 10% đến 15%.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn hoặc con bạn gần đây đã tiếp xúc với chuột hoặc loài gặm nhấm khác Người bị cắn có các triệu chứng sốt do chuột cắn';
MERGE (n:Disease {id: 'D2506'}) SET n.id = 'D2506', n.name = 'Hiện tượng Raynaud', n.name_en = 'Raynaud phenomenon', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000412.htm', n.prognosis = 'Kết quả sẽ khác nhau. Nó phụ thuộc vào nguyên nhân của vấn đề và mức độ nghiêm trọng của nó.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn có tiền sử hiện tượng Raynaud và bộ phận cơ thể bị ảnh hưởng (tay, chân hoặc bộ phận khác) bị nhiễm trùng hoặc phát triển vết loét. Ngón tay của bạn đổi m';
MERGE (n:Disease {id: 'D2507'}) SET n.id = 'D2507', n.name = 'Bệnh Raynaud', n.name_en = 'Raynaud\'s disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/raynauds-disease/symptoms-causes/syc-20363571', n.overview = 'Bệnh Raynaud (ray-NOSE) khiến một số vùng trên cơ thể - chẳng hạn như ngón tay và ngón chân - cảm thấy tê và lạnh khi phản ứng với nhiệt độ lạnh hoặc căng thẳng. Trong bệnh Raynaud, các mạch máu nhỏ c', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn ngay lập tức nếu bạn có tiền sử bệnh Raynaud nghiêm trọng và bị đau hoặc nhiễm trùng ở một trong các ngón tay hoặc ngón chân bị ảnh hưởng. Yêu cầu một cuộc';
MERGE (n:Disease {id: 'D2508'}) SET n.id = 'D2508', n.name = 'Viêm khớp phản ứng', n.name_en = 'Reactive arthritis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/reactive-arthritis/symptoms-causes/syc-20354838 | https://medlineplus.gov/ency/article/000440.htm', n.overview = 'là tình trạng gây đau và sưng khớp, còn gọi là viêm, sau khi bị nhiễm trùng ở một bộ phận khác của cơ thể. Nhiễm trùng thường bắt đầu ở ruột, bộ phận sinh dục hoặc đường tiết niệu. Tình trạng này thườ', n.prognosis = 'Viêm khớp phản ứng có thể khỏi sau vài tuần, nhưng cũng có thể kéo dài vài tháng và cần dùng thuốc trong thời gian đó. Các triệu chứng có thể quay trở lại sau nhiều năm ở một nửa số người mắc bệnh này', n.when_to_see = 'Nếu bạn bị đau khớp trong vòng một tháng sau khi bị tiêu chảy hoặc nhiễm trùng bộ phận sinh dục, hãy liên hệ với chuyên gia chăm sóc sức khỏe của bạn. Các vị trí viêm Sưng đau, còn gọi là viêm, thường';
MERGE (n:Disease {id: 'D2509'}) SET n.id = 'D2509', n.name = 'Rối loạn gắn bó phản ứng', n.name_en = 'Reactive attachment disorder', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/reactive-attachment-disorder/symptoms-causes/syc-20352939', n.overview = 'là một tình trạng hiếm gặp nhưng nghiêm trọng, trong đó trẻ sơ sinh hoặc trẻ nhỏ không thiết lập được sự gắn bó lành mạnh với cha mẹ hoặc người chăm sóc. Rối loạn gắn bó phản ứng có thể phát triển nếu', n.when_to_see = 'Hãy cân nhắc việc đánh giá nếu con bạn có bất kỳ dấu hiệu đáng lo ngại nào tồn tại theo thời gian. Một số dấu hiệu có thể xảy ra ở những trẻ không mắc chứng rối loạn gắn bó phản ứng hoặc mắc chứng rối';
MERGE (n:Disease {id: 'D2510'}) SET n.id = 'D2510', n.name = 'Rối loạn gắn bó phản ứng ở giai đoạn sơ sinh hoặc thời thơ ấu', n.name_en = 'Reactive attachment disorder of infancy or early childhood', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001547.htm', n.prognosis = 'Sự can thiệp đúng đắn có thể cải thiện kết quả.', n.when_to_see = 'Chứng rối loạn này thường được xác định khi cha mẹ (hoặc cha mẹ tương lai) có nguy cơ cao bỏ bê con mình hoặc khi cha mẹ nuôi gặp khó khăn trong việc đối phó với đứa con mới nhận nuôi. Nếu gần đây bạn';
MERGE (n:Disease {id: 'D2511'}) SET n.id = 'D2511', n.name = 'Nhận biết trường hợp cấp cứu y tế', n.name_en = 'Recognizing medical emergencies', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001927.htm', n.overview = 'Theo Trường Cao đẳng Bác sĩ Cấp cứu Hoa Kỳ, sau đây là những dấu hiệu cảnh báo về trường hợp cấp cứu y tế. Ở người lớn: Chảy máu không ngừng Các vấn đề về hô hấp (khó thở, hụt hơi) Thay đổi trạng thái';
MERGE (n:Disease {id: 'D2512'}) SET n.id = 'D2512', n.name = 'Vắc xin zoster (bệnh zona) tái tổ hợp, RZV - những điều bạn cần biết', n.name_en = 'Recombinant zoster (shingles) vaccine, RZV - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007736.htm', n.overview = 'Tại sao phải tiêm phòng? Vắc-xin zoster tái tổ hợp (bệnh zona) có thể ngăn ngừa bệnh zona. Bệnh zona (còn gọi là herpes zoster, hoặc chỉ zoster) là tình trạng phát ban da gây đau đớn, thường có mụn nư';
MERGE (n:Disease {id: 'D2513'}) SET n.id = 'D2513', n.name = 'Phục hồi sau đột quỵ', n.name_en = 'Recovering after stroke', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007419.htm', n.overview = 'NƠI SỐNG SAU ĐỘT QUỴ Hầu hết mọi người sẽ cần phục hồi chức năng sau đột quỵ (phục hồi chức năng) để giúp họ phục hồi sau khi xuất viện. Phục hồi sau đột quỵ sẽ giúp bạn lấy lại khả năng chăm sóc bản ';
MERGE (n:Disease {id: 'D2514'}) SET n.id = 'D2514', n.name = 'Chảy máu trực tràng', n.name_en = 'Rectal bleeding', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007741.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu có: Máu tươi trong phân Đau bụng liên quan đến máu hoặc chất nhầy có máu trong phân Thay đổi màu sắc của phân Đau ở vùng hậu môn khi ';
MERGE (n:Disease {id: 'D2515'}) SET n.id = 'D2515', n.name = 'Ung thư trực tràng', n.name_en = 'Rectal cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/rectal-cancer/symptoms-causes/syc-20352884', n.overview = 'ntestine. Ung thư trực tràng bắt đầu khi các tế bào ở trực tràng phát triển. Ung thư trực tràng là một loại ung thư bắt đầu từ sự phát triển của các tế bào ở trực tràng. Trực tràng là vài inch cuối cù', n.when_to_see = 'Hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với thông tin được gửi cho yêu cầu này.
 Xem lại/cập nhật thôn';
MERGE (n:Disease {id: 'D2516'}) SET n.id = 'D2516', n.name = 'Sa trực tràng', n.name_en = 'Rectal prolapse', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/rectal-prolapse/symptoms-causes/syc-20352837 | https://medlineplus.gov/ency/article/001132.htm', n.overview = 'bị kéo dài và nhô ra khỏi hậu môn. Sa trực tràng xảy ra khi trực tràng tuột ra khỏi hậu môn và có thể nhìn thấy được bên ngoài cơ thể. Mặc dù sa trực tràng có thể gây đau nhưng hiếm khi phải cấp cứu y', n.prognosis = 'Ở trẻ em, điều trị nguyên nhân sẽ chữa khỏi bệnh sa trực tràng. Ở người lớn, phẫu thuật thường chữa khỏi bệnh sa tử cung. Khi sa trực tràng không được điều trị, táo bón và mất kiểm soát ruột có thể ph', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu bị sa trực tràng.';
MERGE (n:Disease {id: 'D2517'}) SET n.id = 'D2517', n.name = 'Sửa chữa sa trực tràng', n.name_en = 'Rectal prolapse repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002932.htm', n.overview = 'Sa trực tràng có thể là một phần, chỉ liên quan đến lớp lót bên trong của ruột ( niêm mạc ). Hoặc, nó có thể toàn bộ, liên quan đến toàn bộ thành trực tràng. Đối với hầu hết người lớn, phẫu thuật được', n.prognosis = 'Phẫu thuật thường có tác dụng tốt trong việc sửa chữa sa tạng. Táo bón và không tự chủ có thể là vấn đề đối với một số người.';
MERGE (n:Disease {id: 'D2518'}) SET n.id = 'D2518', n.name = 'Rò trực tràng âm đạo', n.name_en = 'Rectovaginal fistula', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/rectovaginal-fistula/symptoms-causes/syc-20377108', n.overview = 'Rò trực tràng âm đạo là một kết nối không nên tồn tại giữa phần dưới của ruột già - trực tràng hoặc hậu môn - và âm đạo. Nội dung trong ruột có thể rò rỉ qua lỗ rò, khiến khí hoặc phân đi qua âm đạo. ', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ triệu chứng nào của lỗ rò trực tràng âm đạo. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cậ';
MERGE (n:Disease {id: 'D2519'}) SET n.id = 'D2519', n.name = 'Ung thư vú tái phát', n.name_en = 'Recurrent breast cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/recurrent-breast-cancer/symptoms-causes/syc-20377135', n.overview = 'là ung thư vú tái phát sau lần điều trị ban đầu. Mặc dù việc điều trị ban đầu nhằm mục đích loại bỏ tất cả các tế bào ung thư, một số ít có thể trốn tránh được việc điều trị và sống sót. Những tế bào ', n.when_to_see = 'Sau khi quá trình điều trị ung thư vú của bạn kết thúc, bác sĩ có thể sẽ lập lịch khám theo dõi cho bạn. Trong các lần khám tiếp theo, bác sĩ sẽ kiểm tra bất kỳ triệu chứng hoặc dấu hiệu tái phát ung ';
MERGE (n:Disease {id: 'D2520'}) SET n.id = 'D2520', n.name = 'Vết bớt màu đỏ', n.name_en = 'Red birthmarks', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001440.htm', n.prognosis = 'Các vết bớt hiếm khi gây ra vấn đề, ngoài những thay đổi về ngoại hình. Nhiều vết bớt sẽ tự biến mất khi trẻ đến tuổi đi học, nhưng một số vết bớt là vĩnh viễn. Các mô hình phát triển sau đây là điển ', n.when_to_see = 'Yêu cầu nhà cung cấp dịch vụ của bạn xem xét tất cả các vết bớt.';
MERGE (n:Disease {id: 'D2521'}) SET n.id = 'D2521', n.name = 'Bệnh thận trào ngược', n.name_en = 'Reflux nephropathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000459.htm', n.prognosis = 'Kết quả sẽ khác nhau, tùy thuộc vào mức độ nghiêm trọng của chứng trào ngược. Một số người mắc bệnh thận trào ngược sẽ không bị mất chức năng thận theo thời gian, mặc dù thận của họ đã bị tổn thương. ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn: Có các triệu chứng của bệnh thận trào ngược Có các triệu chứng mới khác Đang sản xuất ít nước tiểu hơn bình thường';
MERGE (n:Disease {id: 'D2522'}) SET n.id = 'D2522', n.name = 'Ngộ độc chất làm lạnh', n.name_en = 'Refrigerant poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002736.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào mức độ nghiêm trọng của vụ ngộ độc và tốc độ nhận được trợ giúp y tế. Tổn thương phổi nghiêm trọng có thể xảy ra. Sống sót qua 72 giờ thường có nghĩa là';
MERGE (n:Disease {id: 'D2523'}) SET n.id = 'D2523', n.name = 'Sốt tái phát', n.name_en = 'Relapsing fever', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001350.htm', n.prognosis = 'Những người mắc bệnh này bị hôn mê, viêm tim, các vấn đề về gan hoặc viêm phổi có nhiều khả năng tử vong hơn. Nếu điều trị sớm, tỷ lệ tử vong sẽ giảm.', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị sốt sau khi trở về sau chuyến đi. Các bệnh nhiễm trùng có thể xảy ra cần được điều tra kịp thời.';
MERGE (n:Disease {id: 'D2524'}) SET n.id = 'D2524', n.name = 'Rối loạn hành vi giấc ngủ REM', n.name_en = 'REM sleep behavior disorder', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/rem-sleep-behavior-disorder/symptoms-causes/syc-20352920', n.overview = 'Rối loạn hành vi giấc ngủ chuyển động mắt nhanh (REM) là một chứng rối loạn giấc ngủ trong đó cơ thể bạn thực hiện những giấc mơ sống động, thường khó chịu bằng âm thanh giọng nói và các cử động tay c', n.when_to_see = 'Nếu bạn có bất kỳ triệu chứng nào ở trên hoặc đang gặp các vấn đề khác về giấc ngủ, hãy nói chuyện với bác sĩ của bạn. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2525'}) SET n.id = 'D2525', n.name = 'Các mẹo ghi nhớ', n.name_en = 'Remembering tips', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002046.htm', n.overview = 'Quên tên của một người bạn mới gặp, nơi bạn đậu xe, nơi bạn sử dụng hàng ngày hoặc số điện thoại bạn đã gọi nhiều lần trước đây có thể khiến bạn lo lắng và sợ hãi. Khi bạn già đi, bộ não của bạn sẽ kh';
MERGE (n:Disease {id: 'D2526'}) SET n.id = 'D2526', n.name = 'Hẹp động mạch thận', n.name_en = 'Renal artery stenosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/renal-artery-stenosis/symptoms-causes/syc-20352777', n.overview = 'h các động mạch dẫn đến thận bị thu hẹp. Kết quả là lượng máu đến thận không đủ. Hẹp động mạch thận là khi một hoặc nhiều động mạch mang máu đến thận bị thu hẹp. Chúng được gọi là động mạch thận. Động', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng kéo dài khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2527'}) SET n.id = 'D2527', n.name = 'Ung thư biểu mô tế bào thận', n.name_en = 'Renal cell carcinoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000516.htm', n.prognosis = 'Đôi khi, cả hai quả thận đều bị ảnh hưởng. Ung thư lây lan dễ dàng, thường xuyên nhất là đến phổi và các cơ quan khác. Ở khoảng 1/4 số người, ung thư đã lan rộng (di căn) tại thời điểm chẩn đoán. Tình', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn bất cứ khi nào bạn nhìn thấy máu trong nước tiểu. Đồng thời liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có bất kỳ triệu chứng nào khác của chứng rối l';
MERGE (n:Disease {id: 'D2528'}) SET n.id = 'D2528', n.name = 'Hoại tử nhú thận', n.name_en = 'Renal papillary necrosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000488.htm', n.prognosis = 'Một người hoạt động tốt như thế nào tùy thuộc vào nguyên nhân gây ra tình trạng này. Nếu nguyên nhân có thể được kiểm soát, tình trạng này có thể tự biến mất. Đôi khi, những người mắc bệnh này sẽ bị s', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để lấy hẹn nếu: Bạn có nước tiểu có máu Bạn phát triển các triệu chứng khác của hoại tử nhú thận, đặc biệt là sau khi dùng thuốc giảm đau không kê đơn';
MERGE (n:Disease {id: 'D2529'}) SET n.id = 'D2529', n.name = 'Ung thư xương chậu hoặc niệu quản thận', n.name_en = 'Renal pelvis or ureter cancer', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000525.htm', n.prognosis = 'Kết quả khác nhau, tùy thuộc vào vị trí của khối u và liệu ung thư có lan rộng hay không. Ung thư chỉ ở thận hoặc niệu quản có thể được chữa khỏi bằng phẫu thuật. Ung thư đã lan sang các cơ quan khác ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có bất kỳ triệu chứng nào được liệt kê ở trên.';
MERGE (n:Disease {id: 'D2530'}) SET n.id = 'D2530', n.name = 'Huyết khối tĩnh mạch thận', n.name_en = 'Renal vein thrombosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000513.htm', n.prognosis = 'Huyết khối tĩnh mạch thận thường thuyên giảm theo thời gian mà không gây tổn thương thận lâu dài.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng huyết khối tĩnh mạch thận. Nếu bạn đã từng bị huyết khối tĩnh mạch thận, hãy liên hệ với nhà cung cấp dịch vụ ';
MERGE (n:Disease {id: 'D2531'}) SET n.id = 'D2531', n.name = 'Tăng huyết áp do mạch máu thận', n.name_en = 'Renovascular hypertension', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000204.htm', n.when_to_see = 'Hãy hẹn gặp bác sĩ nếu bạn cho rằng mình bị cao huyết áp. Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị tăng huyết áp tái tạo và các triệu chứng trở nên tồi tệ hơn hoặc không cải thiện khi điều ';
MERGE (n:Disease {id: 'D2532'}) SET n.id = 'D2532', n.name = 'Sửa chữa ngón tay hoặc ngón chân có màng', n.name_en = 'Repair of webbed fingers or toes', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002969.htm', n.overview = 'Phẫu thuật được thực hiện theo cách sau: Có thể gây mê toàn thân. Điều này có nghĩa là con bạn đang ngủ và sẽ không cảm thấy đau. Hoặc gây tê vùng (tủy sống và ngoài màng cứng) để làm tê phần chi bị ả', n.prognosis = 'Việc sửa chữa thường thành công. Khi các ngón tay nối nhau có chung một móng tay, hiếm khi có thể tạo ra hai móng tay trông bình thường. Một móng tay sẽ trông bình thường hơn móng kia. Một số trẻ cần ';
MERGE (n:Disease {id: 'D2533'}) SET n.id = 'D2533', n.name = 'Việc cấy lại các ngón tay', n.name_en = 'Replantation of digits', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002967.htm', n.overview = 'Phẫu thuật được thực hiện như sau: Sẽ được gây mê toàn thân. Điều này có nghĩa là người đó sẽ ngủ và không thể cảm thấy đau. Hoặc gây tê vùng (tủy sống và ngoài màng cứng) sẽ được thực hiện để làm tê ', n.prognosis = 'Trẻ em là đối tượng phù hợp hơn cho phẫu thuật cấy ghép vì khả năng chữa lành và tái tạo mô tốt hơn. Việc trồng lại phần bị cắt cụt được thực hiện tốt nhất trong vòng 6 giờ sau khi bị thương. Nhưng vi';
MERGE (n:Disease {id: 'D2534'}) SET n.id = 'D2534', n.name = 'Các bệnh phải báo cáo', n.name_en = 'Reportable diseases', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001929.htm', n.overview = 'Tất cả các tiểu bang của Hoa Kỳ đều có danh sách các bệnh phải báo cáo. Trách nhiệm của nhà cung cấp dịch vụ của bạn, chứ không phải của bạn, là báo cáo các trường hợp mắc các bệnh này. Nhiều bệnh tro';
MERGE (n:Disease {id: 'D2535'}) SET n.id = 'D2535', n.name = 'Đau chi còn sót lại', n.name_en = 'Residual limb pain', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/residual-limb-pain/symptoms-causes/syc-20541403', n.overview = 'là một loại đau được cảm nhận ở phần cánh tay hoặc chân còn lại sau khi cánh tay hoặc chân bị cắt bỏ, gọi là cắt cụt chi. Hơn một nửa số người bị cắt cụt chi sẽ gặp phải loại đau này. Đôi khi được gọi';
MERGE (n:Disease {id: 'D2536'}) SET n.id = 'D2536', n.name = 'Nhiễm toan hô hấp', n.name_en = 'Respiratory acidosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000092.htm', n.prognosis = 'Bạn làm tốt thế nào còn tùy thuộc vào bệnh gây nhiễm toan hô hấp.', n.when_to_see = 'Nhiễm toan hô hấp cấp tính nặng là một trường hợp cấp cứu y tế. Tìm kiếm sự trợ giúp y tế ngay lập tức nếu bạn có các triệu chứng của tình trạng này. Hãy gọi cho nhà cung cấp dịch vụ chăm sóc sức khỏe';
MERGE (n:Disease {id: 'D2537'}) SET n.id = 'D2537', n.name = 'Nhiễm kiềm hô hấp', n.name_en = 'Respiratory alkalosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000111.htm', n.prognosis = 'Triển vọng phụ thuộc vào tình trạng gây ra nhiễm kiềm hô hấp.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có bất kỳ triệu chứng nào của bệnh phổi, chẳng hạn như ho kéo dài (mãn tính) hoặc khó thở.';
MERGE (n:Disease {id: 'D2538'}) SET n.id = 'D2538', n.name = 'Virus hợp bào hô hấp (RSV)', n.name_en = 'Respiratory syncytial virus (RSV)', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/respiratory-syncytial-virus/symptoms-causes/syc-20353098 | https://medlineplus.gov/ency/article/001564.htm', n.overview = 'gây nhiễm trùng phổi và đường hô hấp. Bệnh phổ biến đến mức hầu hết trẻ em đều bị nhiễm vi-rút khi được 2 tuổi. Vi-rút hợp bào hô hấp (sin-SISH-ul) cũng có thể lây nhiễm cho người lớn. Ở người lớn và ', n.prognosis = 'Hầu hết người lớn và trẻ em đều hồi phục sau RSV. Các yếu tố nguy cơ gây ra RSV nghiêm trọng ở người lớn bao gồm: Tuổi lớn Bệnh tim hoặc bệnh phổi hoặc các tình trạng bệnh lý khác Hệ thống miễn dịch y', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế ngay lập tức nếu con bạn - hoặc bất kỳ ai có nguy cơ bị nhiễm RSV nghiêm trọng - khó thở, sốt cao hoặc da có màu xanh, đặc biệt là ở môi và móng tay.';
MERGE (n:Disease {id: 'D2539'}) SET n.id = 'D2539', n.name = 'Kháng thể phòng ngừa virus hợp bào hô hấp (RSV) - những điều bạn cần biết', n.name_en = 'Respiratory syncytial virus (RSV) preventive antibody - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007806.htm', n.overview = 'Tại sao nên chủng ngừa bằng kháng thể phòng ngừa RSV? Kháng thể phòng ngừa virus hợp bào hô hấp (RSV) có thể ngăn ngừa bệnh phổi nghiêm trọng do RSV gây ra. RSV là một loại virus đường hô hấp phổ biến';
MERGE (n:Disease {id: 'D2540'}) SET n.id = 'D2540', n.name = 'Hội chứng chân không yên', n.name_en = 'Restless legs syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/restless-legs-syndrome/symptoms-causes/syc-20377168 | https://medlineplus.gov/ency/article/000807.htm', n.overview = '(RLS) là tình trạng gây ra cảm giác muốn cử động chân rất mạnh. Việc muốn di chuyển thường là do cảm giác khó chịu ở chân. Nó thường xảy ra vào buổi tối hoặc ban đêm khi ngồi hoặc nằm. Di chuyển giúp ', n.prognosis = 'RLS không nguy hiểm. Tuy nhiên, nó có thể gây khó chịu, khiến bạn khó ngủ và ảnh hưởng đến chất lượng cuộc sống.', n.when_to_see = 'Nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của hội chứng chân không yên. RLS có thể cản trở giấc ngủ của bạn, gây buồn ngủ ban ngày và ảnh hưởng đến chất lượng cuộc';
MERGE (n:Disease {id: 'D2541'}) SET n.id = 'D2541', n.name = 'Bệnh cơ tim hạn chế', n.name_en = 'Restrictive cardiomyopathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000189.htm', n.prognosis = 'Những người mắc bệnh này thường bị suy tim nặng hơn. Các vấn đề về nhịp tim hoặc van tim "bị rò rỉ" cũng có thể xảy ra. Những người mắc bệnh cơ tim hạn chế có thể là ứng cử viên được ghép tim. Triển v', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của bệnh cơ tim hạn chế.';
MERGE (n:Disease {id: 'D2542'}) SET n.id = 'D2542', n.name = 'Tắc động mạch võng mạc', n.name_en = 'Retinal artery occlusion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001028.htm', n.prognosis = 'Những người bị tắc nghẽn động mạch võng mạc có thể không lấy lại được thị lực.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn bị mờ hoặc mất thị lực đột ngột.';
MERGE (n:Disease {id: 'D2543'}) SET n.id = 'D2543', n.name = 'Bong võng mạc', n.name_en = 'Retinal detachment', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/retinal-detachment/symptoms-causes/syc-20351344 | https://medlineplus.gov/ency/article/001027.htm', n.overview = 'trong đó lớp mô mỏng ở phía sau mắt, được gọi là võng mạc, bị kéo ra khỏi vị trí thông thường. Các tế bào võng mạc tách ra khỏi lớp mạch máu cung cấp oxy và chất dinh dưỡng cho mắt. Các triệu chứng bo', n.prognosis = 'Tình trạng của bạn như thế nào sau khi bong võng mạc tùy thuộc vào vị trí, mức độ bong ra và điều trị sớm. Nếu hoàng điểm không bị tổn thương thì triển vọng điều trị có thể rất tốt. Việc sửa chữa thàn', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe ngay nếu bạn có bất kỳ triệu chứng nào của bong võng mạc. Tình trạng này là một trường hợp khẩn cấp có thể gây mất thị lực kéo dài. Phút khám bệnh của Mayo: Ph';
MERGE (n:Disease {id: 'D2544'}) SET n.id = 'D2544', n.name = 'Sửa chữa bong võng mạc', n.name_en = 'Retinal detachment repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002960.htm', n.overview = 'Hầu hết các hoạt động sửa chữa bong võng mạc đều khẩn cấp. Nếu phát hiện thấy lỗ hoặc vết rách trên võng mạc trước khi võng mạc bong ra, bác sĩ nhãn khoa có thể đóng các lỗ đó bằng tia laser. Thủ tục ', n.prognosis = 'Trong hầu hết các trường hợp, võng mạc có thể được gắn lại chỉ bằng một thao tác. Tuy nhiên, một số người sẽ cần phẫu thuật nhiều lần. Hơn 9 trong số 10 phân đội có thể được sửa chữa. Việc không sửa c';
MERGE (n:Disease {id: 'D2545'}) SET n.id = 'D2545', n.name = 'Bệnh võng mạc', n.name_en = 'Retinal diseases', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/retinal-diseases/symptoms-causes/syc-20355825', n.overview = 'Các bộ phận của mắt và trung tâm của võng mạc. Điểm vàng khỏe mạnh cho phép tầm nhìn trung tâm rõ ràng. Hoàng điểm được tạo thành từ các tế bào nhạy cảm với ánh sáng dày đặc gọi là tế bào hình nón và ', n.when_to_see = 'Điều quan trọng là phải chú ý đến bất kỳ thay đổi nào về thị lực của bạn và nhanh chóng tìm kiếm sự chăm sóc. Tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn đột nhiên bị nổi, chớp mắt hoặc giảm thị lự';
MERGE (n:Disease {id: 'D2546'}) SET n.id = 'D2546', n.name = 'Tắc tĩnh mạch võng mạc', n.name_en = 'Retinal vein occlusion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007330.htm', n.prognosis = 'Kết quả sẽ khác nhau. Những người bị tắc tĩnh mạch võng mạc thường lấy lại được thị lực hữu ích. Điều quan trọng là phải quản lý đúng cách các tình trạng như phù hoàng điểm và bệnh tăng nhãn áp. Tuy n', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn bị mờ hoặc mất thị lực đột ngột.';
MERGE (n:Disease {id: 'D2547'}) SET n.id = 'D2547', n.name = 'Viêm võng mạc sắc tố', n.name_en = 'Retinitis pigmentosa', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001029.htm', n.prognosis = 'Tình trạng rối loạn sẽ tiếp tục tiến triển chậm. Mù hoàn toàn là không phổ biến.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn gặp vấn đề về thị lực ban đêm hoặc bạn phát triển các triệu chứng khác của chứng rối loạn này.';
MERGE (n:Disease {id: 'D2548'}) SET n.id = 'D2548', n.name = 'U nguyên bào võng mạc', n.name_en = 'Retinoblastoma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/retinoblastoma/symptoms-causes/syc-20351008 | https://medlineplus.gov/ency/article/001030.htm', n.overview = 'Giải phẫu của mắt e có đường kính khoảng 1 inch (2,5 cm). Nó nhận được hàng triệu thông tin về thế giới bên ngoài, được bộ não của bạn xử lý nhanh chóng. U nguyên bào võng mạc là một loại ung thư mắt ', n.prognosis = 'Nếu ung thư chưa lan ra ngoài mắt thì hầu hết mọi người đều có thể chữa khỏi. Tuy nhiên, việc chữa trị có thể cần phải điều trị tích cực và thậm chí phải cắt bỏ mắt để thành công. Nếu ung thư đã lan r', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn nhận thấy bất kỳ thay đổi nào ở mắt của con bạn khiến bạn lo lắng. Yêu cầu cuộc hẹn';
MERGE (n:Disease {id: 'D2549'}) SET n.id = 'D2549', n.name = 'Bệnh võng mạc ở trẻ sinh non', n.name_en = 'Retinopathy of prematurity', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001618.htm', n.prognosis = 'Hầu hết trẻ sơ sinh bị giảm thị lực nghiêm trọng liên quan đến ROP đều gặp các vấn đề khác liên quan đến sinh non. Họ có thể cần nhiều phương pháp điều trị khác nhau. Khoảng 1 trong 10 trẻ sơ sinh có ';
MERGE (n:Disease {id: 'D2550'}) SET n.id = 'D2550', n.name = 'Tinh hoàn co rút', n.name_en = 'Retractile testicle', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/retractile-testicle/symptoms-causes/syc-20377197', n.overview = 'Tinh hoàn co rút là tinh hoàn có thể di chuyển qua lại giữa bìu và háng. Khi tinh hoàn co rút nằm ở háng, nó có thể dễ dàng được dẫn bằng tay vào vị trí thích hợp trong bìu - túi da treo phía sau dươn', n.when_to_see = 'Trong quá trình kiểm tra sức khỏe trẻ sơ sinh định kỳ và kiểm tra sức khỏe trẻ em hàng năm, chuyên gia chăm sóc sức khỏe sẽ kiểm tra tinh hoàn để xác định xem chúng có di chuyển xuống và phát triển ph';
MERGE (n:Disease {id: 'D2551'}) SET n.id = 'D2551', n.name = 'Xuất tinh ngược', n.name_en = 'Retrograde ejaculation', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/retrograde-ejaculation/symptoms-causes/syc-20354890 | https://medlineplus.gov/ency/article/001282.htm', n.overview = 'xảy ra khi tinh dịch đi vào bàng quang thay vì thoát ra ngoài qua dương vật khi đạt cực khoái. Mặc dù bạn vẫn đạt cực khoái nhưng bạn có thể xuất tinh rất ít hoặc không có tinh dịch. Điều này đôi khi ', n.prognosis = 'Nếu vấn đề xảy ra do thuốc, xuất tinh bình thường thường sẽ quay trở lại sau khi ngừng thuốc. Xuất tinh ngược do phẫu thuật hoặc tiểu đường thường không thể khắc phục được. Điều này thường không phải ', n.when_to_see = 'Xuất tinh ngược không có hại và chỉ cần điều trị nếu bạn đang muốn làm cha. Tuy nhiên, nếu bạn đạt cực khoái khô, hãy đến gặp bác sĩ để chắc chắn rằng tình trạng của bạn không phải do vấn đề tiềm ẩn c';
MERGE (n:Disease {id: 'D2552'}) SET n.id = 'D2552', n.name = 'Xơ hóa sau phúc mạc', n.name_en = 'Retroperitoneal fibrosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000463.htm', n.prognosis = 'Triển vọng sẽ phụ thuộc vào mức độ của vấn đề và mức độ tổn thương ở thận. Tổn thương thận có thể là tạm thời hoặc vĩnh viễn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị đau bụng dưới hoặc đau sườn và lượng nước tiểu ít hơn.';
MERGE (n:Disease {id: 'D2553'}) SET n.id = 'D2553', n.name = 'Viêm sau phúc mạc', n.name_en = 'Retroperitoneal inflammation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001255.htm', n.prognosis = 'Bạn xử lý tình trạng này tốt như thế nào tùy thuộc vào nguyên nhân cơ bản. Nó có thể dẫn đến suy thận.';
MERGE (n:Disease {id: 'D2554'}) SET n.id = 'D2554', n.name = 'Áp xe sau họng', n.name_en = 'Retropharyngeal abscess', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000984.htm', n.prognosis = 'Điều quan trọng là phải nhận được trợ giúp y tế ngay lập tức. Tình trạng này có thể dẫn đến tắc nghẽn đường thở. Đây là một trường hợp cấp cứu y tế đe dọa tính mạng. Với việc điều trị kịp thời, bệnh n', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc con bạn bị sốt cao kèm theo đau họng dữ dội. Nhận trợ giúp y tế ngay lập tức nếu bạn gặp: Khó thở Âm thanh thở the thé (thở rít) Co rút các cơ';
MERGE (n:Disease {id: 'D2555'}) SET n.id = 'D2555', n.name = 'Phẫu thuật tuyến giáp sau xương ức', n.name_en = 'Retrosternal thyroid surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007558.htm', n.overview = 'Bướu cổ sau xương ức luôn được cân nhắc ở những người có khối u ở cổ. Bướu cổ sau xương ức thường không có triệu chứng trong nhiều năm. Nó thường được phát hiện khi chụp X-quang ngực hoặc chụp CT vì l', n.prognosis = 'Kết quả của cuộc phẫu thuật này thường rất tốt. Hầu hết mọi người cần phải uống thuốc hormone tuyến giáp (thay thế hormone tuyến giáp) trong suốt quãng đời còn lại khi toàn bộ tuyến bị cắt bỏ.';
MERGE (n:Disease {id: 'D2556'}) SET n.id = 'D2556', n.name = 'Tử cung lộn ngược', n.name_en = 'Retroversion of the uterus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001506.htm', n.prognosis = 'Trong hầu hết các trường hợp, tình trạng này không gây ra vấn đề gì.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn liên tục bị đau hoặc khó chịu vùng chậu.';
MERGE (n:Disease {id: 'D2557'}) SET n.id = 'D2557', n.name = 'Hội chứng Rett', n.name_en = 'Rett syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/rett-syndrome/symptoms-causes/syc-20377227 | https://medlineplus.gov/ency/article/001536.htm', n.overview = 'là một rối loạn phát triển và thần kinh di truyền hiếm gặp ảnh hưởng đến cách phát triển của não. Rối loạn này gây ra sự mất dần dần các kỹ năng vận động và ngôn ngữ. Hội chứng Rett chủ yếu ảnh hưởng ', n.prognosis = 'Bệnh dần dần nặng hơn cho đến tuổi thiếu niên. Sau đó, các triệu chứng có thể cải thiện. Ví dụ, các cơn co giật hoặc các vấn đề về hô hấp có xu hướng giảm bớt ở tuổi thiếu niên. Sự chậm phát triển khá', n.when_to_see = 'Các dấu hiệu và triệu chứng của hội chứng Rett có thể khó phát hiện ở giai đoạn đầu. Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn ngay lập tức nếu bạn bắt đầu nhận thấy các vấn đề về';
MERGE (n:Disease {id: 'D2558'}) SET n.id = 'D2558', n.name = 'Thay khớp vai toàn phần ngược', n.name_en = 'Reverse total shoulder replacement', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007796.htm', n.overview = 'Bạn sẽ được gây mê trước khi phẫu thuật. Hai loại gây mê có thể được sử dụng: Gây mê toàn thân, có nghĩa là bạn sẽ bất tỉnh và không thể cảm thấy đau. Gây tê vùng để làm tê vùng cánh tay và vai của bạ', n.prognosis = 'Phẫu thuật thay khớp vai toàn phần đảo ngược giúp giảm đau và cứng khớp cho nhiều người. Bạn sẽ có thể tiếp tục hầu hết các hoạt động hàng ngày của mình mà không gặp nhiều vấn đề. Khớp vai mới của bạn';
MERGE (n:Disease {id: 'D2559'}) SET n.id = 'D2559', n.name = 'Hội chứng Reye', n.name_en = 'Reye syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001565.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào mức độ nghiêm trọng của tình trạng hôn mê cũng như các yếu tố khác. Kết quả dành cho những người sống sót qua giai đoạn cấp tính có thể tốt.', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi ngay đến số điện thoại cấp cứu tại địa phương (chẳng hạn như 911) nếu con bạn bị: Lú lẫn Hôn mê Những thay đổi tâm thần khác';
MERGE (n:Disease {id: 'D2560'}) SET n.id = 'D2560', n.name = 'Sự không tương thích của Rh', n.name_en = 'Rh incompatibility', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001600.htm', n.prognosis = 'Dự kiến ​​sẽ phục hồi hoàn toàn đối với trường hợp không tương thích Rh ở mức độ nhẹ.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nghĩ hoặc biết mình đang mang thai và chưa gặp nhà cung cấp dịch vụ.';
MERGE (n:Disease {id: 'D2561'}) SET n.id = 'D2561', n.name = 'Tiêu cơ vân', n.name_en = 'Rhabdomyolysis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000473.htm', n.prognosis = 'Kết quả phụ thuộc vào mức độ tổn thương của thận. Suy thận cấp xảy ra ở nhiều người. Việc điều trị ngay sau khi tiêu cơ vân sẽ làm giảm nguy cơ tổn thương thận vĩnh viễn. Những người mắc bệnh nhẹ hơn ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng tiêu cơ vân.';
MERGE (n:Disease {id: 'D2562'}) SET n.id = 'D2562', n.name = 'Rhabdomyosarcoma', n.name_en = 'Rhabdomyosarcoma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/rhabdomyosarcoma/symptoms-causes/syc-20390962 | https://medlineplus.gov/ency/article/001429.htm', n.overview = 'là một loại ung thư hiếm gặp bắt đầu từ sự phát triển của các tế bào trong mô mềm. Các mô mềm hỗ trợ và kết nối các cơ quan và các bộ phận khác của cơ thể. Rhabdomyosarcoma thường bắt đầu ở mô cơ. Mặc', n.prognosis = 'Với phương pháp điều trị tích cực, hầu hết trẻ em mắc bệnh rhabdomyosarcoma đều có thể sống sót lâu dài. Việc chữa khỏi bệnh phụ thuộc vào loại khối u cụ thể, vị trí của nó và mức độ lan rộng của nó.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn có các triệu chứng của bệnh rhabdomyosarcoma.';
MERGE (n:Disease {id: 'D2563'}) SET n.id = 'D2563', n.name = 'Sốt thấp khớp', n.name_en = 'Rheumatic fever', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/rheumatic-fever/symptoms-causes/syc-20354588 | https://medlineplus.gov/ency/article/003940.htm', n.overview = 'là một bệnh viêm nhiễm có thể phát triển khi bệnh viêm họng liên cầu khuẩn hoặc sốt ban đỏ không được điều trị đúng cách. Viêm họng liên cầu khuẩn và sốt đỏ tươi là do nhiễm vi khuẩn streptococcus (st', n.prognosis = 'Sốt thấp khớp có thể gây ra các vấn đề nghiêm trọng về tim và tổn thương tim.', n.when_to_see = 'Điều trị viêm họng liên cầu đúng cách có thể ngăn ngừa sốt thấp khớp. Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu xảy ra bất kỳ triệu chứng nào sau đây của bệnh viêm họng liên cầu khuẩn: Đau họng xuấ';
MERGE (n:Disease {id: 'D2564'}) SET n.id = 'D2564', n.name = 'Viêm khớp dạng thấp', n.name_en = 'Rheumatoid arthritis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/rheumatoid-arthritis/symptoms-causes/syc-20353648 | https://medlineplus.gov/ency/article/000431.htm', n.overview = 'đau và sưng tấy. Khi mô lót các khớp, gọi là màng hoạt dịch, bị viêm và dày hơn, chất lỏng sẽ tích tụ. Kết quả là các khớp có thể bị uốn cong, gọi là biến dạng. Viêm khớp dạng thấp là một tình trạng đ', n.prognosis = 'Việc RA của bạn có tiến triển hay không phụ thuộc vào mức độ nghiêm trọng của các triệu chứng và phản ứng của bạn với việc điều trị. Điều quan trọng là phải bắt đầu điều trị càng sớm càng tốt. Cần phả', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị đau và sưng khớp liên tục mà không thuyên giảm sau vài tuần. Viêm khớp dạng thấp Hiển thị bản ghi video Viêm khớp dạng thấp Vivien Williams:';
MERGE (n:Disease {id: 'D2565'}) SET n.id = 'D2565', n.name = 'Bệnh phổi dạng thấp', n.name_en = 'Rheumatoid lung disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000113.htm', n.prognosis = 'Kết quả có liên quan đến chứng rối loạn tiềm ẩn cũng như loại và mức độ nghiêm trọng của bệnh phổi. Trong trường hợp nặng, ghép phổi có thể được xem xét. Điều này phổ biến hơn trong các trường hợp viê', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu bạn bị viêm khớp dạng thấp và bạn bị khó thở không rõ nguyên nhân hoặc tình trạng khó thở cơ bản trở nên trầm trọng hơn.';
MERGE (n:Disease {id: 'D2566'}) SET n.id = 'D2566', n.name = 'Bệnh viêm phổi dạng thấp', n.name_en = 'Rheumatoid pneumoconiosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000137.htm', n.prognosis = 'RP hiếm khi gây khó thở hoặc tàn tật nghiêm trọng do các vấn đề về phổi.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn để lấy hẹn nếu bạn có các triệu chứng của RP và tiếp xúc với bụi than. Nói chuyện với nhà cung cấp của bạn về việc chủng ngừa cúm và viêm phổi. Nếu bạn đã được chẩ';
MERGE (n:Disease {id: 'D2567'}) SET n.id = 'D2567', n.name = 'Rhinophyma', n.name_en = 'Rhinophyma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001037.htm', n.prognosis = 'Rhinophyma có thể được điều trị bằng phẫu thuật. Tình trạng này có thể quay trở lại.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng của bệnh viêm mũi và muốn trao đổi về cách điều trị.';
MERGE (n:Disease {id: 'D2568'}) SET n.id = 'D2568', n.name = 'Nâng mũi', n.name_en = 'Rhinoplasty', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002983.htm', n.overview = 'có thể được thực hiện dưới hình thức gây tê cục bộ hoặc gây mê toàn thân, tùy thuộc vào mức độ của quy trình và sở thích của mỗi người. Nó được thực hiện tại văn phòng bác sĩ phẫu thuật, bệnh viện hoặ', n.prognosis = 'Quá trình phục hồi hoàn toàn phải mất một năm, nhưng hầu hết tình trạng sưng tấy sẽ thuyên giảm sau 2 đến 3 tháng. Chữa bệnh là một quá trình chậm rãi và từ từ. Đầu mũi có thể bị sưng và tê trong vài ';
MERGE (n:Disease {id: 'D2569'}) SET n.id = 'D2569', n.name = 'Ngộ độc lá đại hoàng', n.name_en = 'Rhubarb leaves poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002876.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào lượng chất độc nuốt vào và tốc độ điều trị. Bạn nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Các triệu chứng kéo dài từ 1 đến 3 ngày và có thể';
MERGE (n:Disease {id: 'D2570'}) SET n.id = 'D2570', n.name = 'Đau lồng ngực', n.name_en = 'Ribcage pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003109.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để đặt lịch hẹn nếu bạn không biết nguyên nhân gây ra cơn đau hoặc nếu cơn đau không biến mất.';
MERGE (n:Disease {id: 'D2571'}) SET n.id = 'D2571', n.name = 'Còi xương', n.name_en = 'Rickets', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/rickets/symptoms-causes/syc-20351943 | https://medlineplus.gov/ency/article/000344.htm', n.overview = 'là tình trạng xương mềm và yếu ở trẻ em, thường do thiếu vitamin D hoặc canxi quá mức và kéo dài. Các vấn đề di truyền hiếm gặp cũng có thể gây ra bệnh còi xương. Vitamin D giúp cơ thể trẻ hấp thụ can', n.prognosis = 'Tình trạng rối loạn có thể được khắc phục bằng cách thay thế vitamin D và khoáng chất. Các kết quả xét nghiệm và chụp X-quang thường cải thiện sau khoảng 1 tuần. Một số trường hợp có thể cần liều lượn', n.when_to_see = 'Hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu con bạn bị đau xương, yếu cơ hoặc dị dạng xương rõ ràng. Nếu bạn lo lắng rằng trẻ sơ sinh của bạn không nhận đủ vitamin D, đặc biệt nếu chún';
MERGE (n:Disease {id: 'D2572'}) SET n.id = 'D2572', n.name = 'Rickettsialpox', n.name_en = 'Rickettsialpox', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001351.htm', n.prognosis = 'Dự kiến ​​sẽ hồi phục hoàn toàn khi dùng kháng sinh theo hướng dẫn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc con bạn có các triệu chứng của bệnh đậu mùa rickettsialpox.';
MERGE (n:Disease {id: 'D2573'}) SET n.id = 'D2573', n.name = 'Nấm ngoài da', n.name_en = 'Ringworm', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001439.htm';
MERGE (n:Disease {id: 'D2574'}) SET n.id = 'D2574', n.name = 'Nấm ngoài da (cơ thể)', n.name_en = 'Ringworm (body)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ringworm-body/symptoms-causes/syc-20353780', n.overview = 'Nấm ngoài da trên cơ thể (tinea corporis) là tình trạng phát ban do nhiễm nấm. Đó thường là những vết phát ban ngứa, hình tròn với vùng da rõ hơn ở giữa. Nấm ngoài da có tên như vậy vì vẻ ngoài của nó', n.when_to_see = 'Hãy nói chuyện với bác sĩ nếu bạn bị phát ban mà không cải thiện trong vòng hai tuần sau khi sử dụng sản phẩm chống nấm không kê đơn. Bạn có thể cần thuốc theo toa.';
MERGE (n:Disease {id: 'D2575'}) SET n.id = 'D2575', n.name = 'Nấm ngoài da (da đầu)', n.name_en = 'Ringworm (scalp)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ringworm-scalp/symptoms-causes/syc-20354918', n.overview = 'Nấm ngoài da đầu (tinea capitis) là tình trạng phát ban do nhiễm nấm. Nó thường gây ra các mảng ngứa, bong vảy, hói trên đầu. Nấm ngoài da có tên như vậy vì hình dạng tròn của nó. Không có sâu có liên', n.when_to_see = 'Một số tình trạng ảnh hưởng đến da đầu có thể có biểu hiện tương tự. Hãy đưa con bạn đi khám bác sĩ nếu con bạn bị rụng tóc, đóng vảy hoặc ngứa da đầu hoặc có biểu hiện bất thường khác trên da đầu. Đi';
MERGE (n:Disease {id: 'D2576'}) SET n.id = 'D2576', n.name = 'Nấm ngoài da trên cơ thể', n.name_en = 'Ringworm of the body', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000877.htm', n.prognosis = 'Nấm ngoài da thường biến mất trong vòng 4 tuần khi sử dụng kem chống nấm. Nhiễm trùng có thể lan đến bàn chân, da đầu, háng hoặc móng tay.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bệnh hắc lào không thuyên giảm khi tự chăm sóc.';
MERGE (n:Disease {id: 'D2577'}) SET n.id = 'D2577', n.name = 'Nấm ngoài da đầu', n.name_en = 'Ringworm of the scalp', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000878.htm', n.prognosis = 'Có thể khó thoát khỏi bệnh hắc lào. Ngoài ra, vấn đề có thể quay trở lại sau khi được điều trị. Trong nhiều trường hợp, tình trạng này sẽ tự thuyên giảm sau tuổi dậy thì.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng nấm ngoài da đầu và việc chăm sóc tại nhà là không đủ để thoát khỏi tình trạng này.';
MERGE (n:Disease {id: 'D2578'}) SET n.id = 'D2578', n.name = 'Rủi ro của thuốc lá', n.name_en = 'Risks of tobacco', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002032.htm', n.overview = 'Thuốc lá là một loại cây. Lá của nó được hun khói, nhai hoặc ngửi để có nhiều tác dụng khác nhau. Thuốc lá có chứa hóa chất nicotin, một chất gây nghiện. Khói thuốc lá chứa hơn 7.000 hóa chất, ít nhất';
MERGE (n:Disease {id: 'D2579'}) SET n.id = 'D2579', n.name = 'Phẫu thuật bằng robot', n.name_en = 'Robotic surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007339.htm', n.overview = 'Thông thường, bạn sẽ được gây mê toàn thân để bạn có thể ngủ và không bị đau. Bác sĩ phẫu thuật ngồi ở trạm máy tính và chỉ đạo chuyển động của robot. Những dụng cụ phẫu thuật nhỏ được gắn vào cánh ta', n.prognosis = 'Vết cắt phẫu thuật nhỏ hơn so với phẫu thuật mở truyền thống. Lợi ích bao gồm: Phục hồi nhanh hơn Ít đau và chảy máu Ít nguy cơ nhiễm trùng Thời gian nằm viện ngắn hơn Vết sẹo nhỏ hơn';
MERGE (n:Disease {id: 'D2580'}) SET n.id = 'D2580', n.name = 'Sốt đốm Rocky Mountain', n.name_en = 'Rocky Mountain spotted fever', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000654.htm', n.prognosis = 'Điều trị thường chữa khỏi bệnh nhiễm trùng. Khoảng 3% số người mắc bệnh này sẽ tử vong.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng sau khi tiếp xúc với bọ ve hoặc vết cắn của bọ ve. Các biến chứng của RMSF không được điều trị thường đe dọa tính mạng.';
MERGE (n:Disease {id: 'D2581'}) SET n.id = 'D2581', n.name = 'Điều trị tủy', n.name_en = 'Root canal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007275.htm', n.overview = 'Nha sĩ sẽ dùng gel bôi ngoài da và kim để đặt thuốc gây tê (gây tê) xung quanh chiếc răng xấu. Bạn có thể cảm thấy hơi châm chích khi kim được đưa vào. Tiếp theo, nha sĩ sẽ dùng một mũi khoan cực nhỏ ', n.prognosis = 'Bạn có thể bị đau hoặc nhức sau khi thực hiện thủ thuật. Một loại thuốc chống viêm không kê đơn, chẳng hạn như ibuprofen, có thể giúp giảm bớt sự khó chịu. Hầu hết mọi người có thể trở lại thói quen b';
MERGE (n:Disease {id: 'D2582'}) SET n.id = 'D2582', n.name = 'Rosacea', n.name_en = 'Rosacea', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/rosacea/symptoms-causes/syc-20353815 | https://medlineplus.gov/ency/article/000879.htm', n.overview = 'trên làn da trắng có má, mũi và mặt trung tâm đỏ, có những vết sưng nhỏ màu đỏ hoặc vết sưng có mủ trong đó. Bệnh rosacea trên da nâu có thể khó nhìn thấy trên da nâu và da đen. Theo dõi các triệu chứ', n.prognosis = 'Rosacea là một tình trạng vô hại nhưng có thể khiến bạn tự ti hoặc xấu hổ. Nó không thể chữa khỏi nhưng có thể được kiểm soát bằng điều trị.', n.when_to_see = 'Nếu bạn có các triệu chứng liên tục ở mặt hoặc mắt, hãy đến gặp chuyên gia chăm sóc sức khỏe để được chẩn đoán và điều trị. Các chuyên gia về da còn được gọi là bác sĩ da liễu. Yêu cầu một cuộc hẹn Có';
MERGE (n:Disease {id: 'D2583'}) SET n.id = 'D2583', n.name = 'Roseola', n.name_en = 'Roseola', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/roseola/symptoms-causes/syc-20377283 | https://medlineplus.gov/ency/article/000968.htm', n.overview = 'là một bệnh nhiễm trùng phổ biến thường ảnh hưởng đến trẻ em dưới 2 tuổi. Bệnh này do một loại vi-rút lây lan từ người sang người gây ra. Nó có thể gây sốt cao, sau đó phát ban nhưng không ngứa hoặc đ', n.when_to_see = 'Tìm kiếm sự chăm sóc y tế ngay lập tức Con bạn có thể bị co giật (co giật do sốt) nếu sốt cao hoặc tăng đột ngột. Nếu con bạn bị co giật không rõ nguyên nhân, hãy tìm sự chăm sóc y tế ngay lập tức. Gọ';
MERGE (n:Disease {id: 'D2584'}) SET n.id = 'D2584', n.name = 'Chấn thương chóp xoay', n.name_en = 'Rotator cuff injury', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/rotator-cuff-injury/symptoms-causes/syc-20350225', n.overview = 'Các loại chấn thương chóp xoay có thể từ viêm đơn giản đến rách gân hoàn toàn. Vòng bít xoay là một nhóm cơ và gân bao quanh khớp vai. Các cơ này giữ chắc phần xương của xương cánh tay trên trong hốc ', n.when_to_see = 'Chuyên gia chăm sóc sức khỏe gia đình của bạn có thể đánh giá tình trạng đau vai ngắn hạn. Hãy gặp nhóm chăm sóc của bạn ngay lập tức nếu bạn bị yếu ngay lập tức ở cánh tay sau một chấn thương. Yêu cầ';
MERGE (n:Disease {id: 'D2585'}) SET n.id = 'D2585', n.name = 'Các vấn đề về chóp xoay', n.name_en = 'Rotator cuff problems', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000438.htm', n.prognosis = 'Với bệnh viêm gân chóp xoay, nghỉ ngơi, tập thể dục và các biện pháp tự chăm sóc khác thường cải thiện hoặc thậm chí làm giảm các triệu chứng. Việc này có thể mất vài tuần hoặc vài tháng. Một số người', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị đau vai liên tục. Đồng thời liên hệ với nhà cung cấp của bạn nếu các triệu chứng không cải thiện khi điều trị.';
MERGE (n:Disease {id: 'D2586'}) SET n.id = 'D2586', n.name = 'Sửa chữa vòng bít xoay', n.name_en = 'Rotator cuff repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007207.htm', n.overview = 'Vòng bít xoay là một nhóm cơ và gân tạo thành một vòng bít trên khớp vai. Những cơ và gân này giữ cánh tay trong khớp và giúp khớp vai cử động một cách phối hợp và không gây đau đớn. Các gân có thể bị', n.prognosis = 'Phẫu thuật để sửa chữa chóp xoay bị rách thường thành công trong việc giảm đau ở vai. Thủ tục có thể không phải lúc nào cũng trả lại sức mạnh cho vai. Sửa chữa vòng quay có thể cần thời gian hồi phục ';
MERGE (n:Disease {id: 'D2587'}) SET n.id = 'D2587', n.name = 'Rotavirus', n.name_en = 'Rotavirus', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/rotavirus/symptoms-causes/syc-20351300', n.overview = 'là một loại vi trùng được gọi là virus. Bệnh do virus này được gọi là nhiễm rotavirus. Nhiễm trùng rotavirus thường ảnh hưởng đến trẻ em dưới 5 tuổi. Nhiễm trùng gây ra phân lỏng, gọi là tiêu chảy. Ro', n.when_to_see = 'Trẻ em Gọi cho chuyên gia chăm sóc sức khỏe của con bạn nếu con bạn có bất kỳ dấu hiệu nào sau đây: Tiêu chảy trong hơn 24 giờ. Sốt từ 102 độ F (38,9 độ C) trở lên. Sốt từ 100,4 độ F (38 độ C) trở lên';
MERGE (n:Disease {id: 'D2588'}) SET n.id = 'D2588', n.name = 'Vắc xin Rotavirus - những điều bạn cần biết', n.name_en = 'Rotavirus vaccine - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007608.htm', n.overview = '1. Tại sao phải tiêm phòng? Vắc-xin rotavirus có thể ngăn ngừa bệnh rotavirus. Rotavirus thường gây tiêu chảy nặng, chảy nước, chủ yếu ở trẻ sơ sinh và trẻ nhỏ. Nôn mửa và sốt cũng thường gặp ở trẻ nh';
MERGE (n:Disease {id: 'D2589'}) SET n.id = 'D2589', n.name = 'Vắc xin RSV (vi rút hợp bào hô hấp) - những điều bạn cần biết', n.name_en = 'RSV (respiratory syncytial virus) vaccine - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007797.htm', n.overview = 'Tại sao phải tiêm phòng? Vắc-xin RSV có thể ngăn ngừa bệnh đường hô hấp dưới do virus hợp bào hô hấp (RSV) gây ra. RSV là một loại virus đường hô hấp phổ biến thường gây ra các triệu chứng nhẹ giống n';
MERGE (n:Disease {id: 'D2590'}) SET n.id = 'D2590', n.name = 'Ngộ độc xi măng cao su', n.name_en = 'Rubber cement poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002820.htm', n.prognosis = 'Sức khoẻ của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt hoặc cho một lượng nhỏ x';
MERGE (n:Disease {id: 'D2591'}) SET n.id = 'D2591', n.name = 'Rubella', n.name_en = 'Rubella', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/rubella/symptoms-causes/syc-20377310 | https://medlineplus.gov/ency/article/001574.htm', n.overview = 'là một bệnh nhiễm virus dễ lây sang người khác, gọi là bệnh truyền nhiễm. Nó được biết đến nhiều nhất bởi sự phát ban của nó. Nó còn được gọi là bệnh sởi Đức hoặc bệnh sởi ba ngày. Nhiễm trùng này gây', n.prognosis = 'Rubella thường là một bệnh nhiễm trùng nhẹ. Sau khi bị nhiễm bệnh, con người có khả năng miễn dịch với căn bệnh này suốt đời.', n.when_to_see = 'Liên hệ với chuyên gia chăm sóc sức khỏe của bạn nếu bạn cho rằng bạn hoặc con bạn có thể đã tiếp xúc với vi-rút gây ra bệnh sởi Đức hoặc nếu bạn thấy các triệu chứng của bệnh sởi Đức. Nếu bạn đang ng';
MERGE (n:Disease {id: 'D2592'}) SET n.id = 'D2592', n.name = 'Hội chứng Rubinstein-Taybi', n.name_en = 'Rubinstein-Taybi syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001249.htm', n.prognosis = 'Một số trẻ có thể học đọc ở trình độ tiểu học. Phần lớn trẻ em chậm phát triển vận động, nhưng trung bình chúng học đi khi được 2 tuổi rưỡi.', n.when_to_see = 'Bạn nên hẹn gặp bác sĩ di truyền nếu nhà cung cấp dịch vụ của bạn phát hiện thấy các dấu hiệu của RTS.';
MERGE (n:Disease {id: 'D2593'}) SET n.id = 'D2593', n.name = 'Rối loạn nhai lại', n.name_en = 'Rumination disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001539.htm', n.prognosis = 'Trong một số trường hợp, chứng nhai lại sẽ tự biến mất và trẻ sẽ ăn uống bình thường trở lại mà không cần điều trị. Trong các trường hợp khác, điều trị là cần thiết.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu trẻ có vẻ liên tục khạc nhổ, nôn mửa hoặc nhai lại thức ăn.';
MERGE (n:Disease {id: 'D2594'}) SET n.id = 'D2594', n.name = 'Hội chứng nhai lại', n.name_en = 'Rumination syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/rumination-syndrome/symptoms-causes/syc-20377330', n.overview = 'là tình trạng một người nào đó liên tục nôn ra thức ăn chưa tiêu hóa hoặc đã tiêu hóa một phần từ dạ dày. Thức ăn trào ngược sau đó được nhai lại và nuốt hoặc nhổ ra. Những người mắc hội chứng nhai lạ', n.when_to_see = 'Hãy tham khảo ý kiến ​​chuyên gia chăm sóc sức khỏe nếu bạn hoặc con bạn thường xuyên nôn ra thức ăn. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2595'}) SET n.id = 'D2595', n.name = 'Vỡ màng nhĩ', n.name_en = 'Ruptured eardrum', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001038.htm', n.prognosis = 'Lỗ thủng ở màng nhĩ thường tự lành trong vòng 2 tháng nếu là lỗ nhỏ. Tình trạng mất thính giác sẽ diễn ra trong thời gian ngắn nếu vết đứt lành hoàn toàn. Hiếm khi, các vấn đề khác có thể xảy ra, chẳn', n.when_to_see = 'Nếu cơn đau và các triệu chứng của bạn cải thiện sau khi màng nhĩ bị vỡ, bạn có thể đợi đến ngày hôm sau để gặp bác sĩ. Liên hệ với nhà cung cấp dịch vụ của bạn ngay sau khi màng nhĩ bị vỡ nếu bạn: Rấ';
MERGE (n:Disease {id: 'D2596'}) SET n.id = 'D2596', n.name = 'Vỡ màng nhĩ (màng nhĩ đục lỗ)', n.name_en = 'Ruptured eardrum (perforated eardrum)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ruptured-eardrum/symptoms-causes/syc-20351879', n.overview = 'Màng nhĩ bị vỡ, còn gọi là thủng màng nhĩ, là một lỗ hoặc vết rách trên mô mỏng, còn gọi là màng nhĩ, giữa ống tai và tai giữa. Màng nhĩ bị thủng có thể gây mất thính lực. Nó cũng có thể làm tăng nguy', n.when_to_see = 'Hãy hẹn khám bác sĩ nếu bạn có triệu chứng thủng màng nhĩ.';
MERGE (n:Disease {id: 'D2597'}) SET n.id = 'D2597', n.name = 'Lá lách bị vỡ', n.name_en = 'Ruptured spleen', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ruptured-spleen/symptoms-causes/syc-20352317', n.overview = 'bên trái của bạn. Lá lách bị vỡ có thể giải phóng một lượng lớn máu vào khoang dạ dày. Lá lách bị vỡ là một trường hợp cấp cứu y tế xảy ra do bề mặt lá lách của bạn bị vỡ. Lá lách của bạn, nằm ngay dư', n.when_to_see = 'Lá lách bị vỡ là một trường hợp cấp cứu y tế. Tìm kiếm sự chăm sóc khẩn cấp sau khi bị thương nếu các dấu hiệu và triệu chứng cho thấy bạn có thể bị vỡ lá lách. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2598'}) SET n.id = 'D2598', n.name = 'Ngộ độc gói', n.name_en = 'Sachet poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002716.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng nội dung trong gói họ nuốt và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Túi không được coi là rất độc hại.';
MERGE (n:Disease {id: 'D2599'}) SET n.id = 'D2599', n.name = 'Lúm đồng tiền cùng', n.name_en = 'Sacral dimple', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sacral-dimple/symptoms-causes/syc-20377353', n.overview = 'Lúm đồng tiền cùng là một vết lõm hoặc vết lõm trên da ở vùng lưng dưới xuất hiện khi mới sinh ở một số trẻ. Nó thường ở ngay phía trên nếp nhăn giữa mông. Hầu hết các lúm đồng tiền đều vô hại và khôn';
MERGE (n:Disease {id: 'D2600'}) SET n.id = 'D2600', n.name = 'Viêm cùng chậu', n.name_en = 'Sacroiliitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sacroiliitis/symptoms-causes/syc-20350747', n.overview = 'Các khớp cùng chậu ở cột sống. Hai khớp này được tạo thành từ cấu trúc xương phía trên xương cụt, được gọi là xương cùng và phần trên cùng của xương chậu, được gọi là xương chậu. Các khớp cùng chậu hỗ';
MERGE (n:Disease {id: 'D2601'}) SET n.id = 'D2601', n.name = 'Lái xe an toàn cho thanh thiếu niên', n.name_en = 'Safe driving for teens', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001930.htm', n.overview = 'CAM KẾT VỀ AN TOÀN Thanh thiếu niên cũng cần cam kết trở thành người lái xe an toàn và có trách nhiệm để cải thiện tỷ lệ có lợi cho họ. Lái xe liều lĩnh vẫn là mối nguy hiểm đối với thanh thiếu niên -';
MERGE (n:Disease {id: 'D2602'}) SET n.id = 'D2602', n.name = 'Tình dục an toàn', n.name_en = 'Safe sex', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001949.htm', n.overview = 'Nhiễm trùng lây truyền qua đường tình dục (STI) là một bệnh nhiễm trùng có thể lây sang người khác thông qua quan hệ tình dục. STI bao gồm: Chlamydia Mụn rộp sinh dục Mụn cóc sinh dục Bệnh lậu Viêm ga';
MERGE (n:Disease {id: 'D2603'}) SET n.id = 'D2603', n.name = 'Sỏi ống nước bọt', n.name_en = 'Salivary duct stones', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001039.htm', n.prognosis = 'Hầu hết, sỏi ống nước bọt chỉ gây đau hoặc khó chịu nhưng đôi khi có thể bị nhiễm trùng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của sỏi ống nước bọt.';
MERGE (n:Disease {id: 'D2604'}) SET n.id = 'D2604', n.name = 'Nhiễm trùng tuyến nước bọt', n.name_en = 'Salivary gland infections', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001041.htm', n.prognosis = 'Hầu hết các bệnh nhiễm trùng tuyến nước bọt đều tự khỏi hoặc được chữa khỏi bằng cách điều trị. Một số bệnh nhiễm trùng sẽ quay trở lại. Các biến chứng không phổ biến.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Các triệu chứng của nhiễm trùng tuyến nước bọt Nhiễm trùng tuyến nước bọt và các triệu chứng trở nên trầm trọng hơn Nhận trợ giúp y tế ngay lập';
MERGE (n:Disease {id: 'D2605'}) SET n.id = 'D2605', n.name = 'Các khối u tuyến nước bọt', n.name_en = 'Salivary gland tumors', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/salivary-gland-cancer/symptoms-causes/syc-20354151 | https://medlineplus.gov/ency/article/001040.htm', n.overview = 'Các tuyến nước bọt Các tuyến này là tuyến mang tai, tuyến dưới lưỡi và tuyến dưới hàm. Mỗi tuyến có một ống riêng, gọi là ống dẫn, dẫn từ tuyến đến miệng. Các khối u tuyến nước bọt là sự phát triển củ', n.prognosis = 'Hầu hết các khối u tuyến nước bọt đều không phải ung thư và phát triển chậm. Loại bỏ khối u bằng phẫu thuật thường chữa khỏi bệnh. Trong một số ít trường hợp, khối u là ung thư và cần phải điều trị th', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Có một vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin được đ';
MERGE (n:Disease {id: 'D2606'}) SET n.id = 'D2606', n.name = 'Viêm ruột do vi khuẩn Salmonella', n.name_en = 'Salmonella enterocolitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000294.htm', n.prognosis = 'Ở những người khỏe mạnh, các triệu chứng sẽ biến mất sau 2 đến 5 ngày, nhưng chúng có thể kéo dài từ 1 đến 2 tuần. Những người đã được điều trị bệnh Salmonella có thể tiếp tục thải vi khuẩn ra ngoài t', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Có máu hoặc mủ trong phân của bạn. Bạn bị tiêu chảy và không thể uống nước do buồn nôn hoặc nôn. Bạn bị sốt trên 101°F (38,3°C) và tiêu chảy. Bạn có d';
MERGE (n:Disease {id: 'D2607'}) SET n.id = 'D2607', n.name = 'Nhiễm khuẩn Salmonella', n.name_en = 'Salmonella infection', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/salmonella/symptoms-causes/syc-20355329', n.overview = '(salmonellosis) là một bệnh do vi khuẩn phổ biến ảnh hưởng đến đường ruột. Vi khuẩn Salmonella thường sống trong ruột động vật và con người và thải ra ngoài qua phân. Con người bị nhiễm bệnh thường xu', n.when_to_see = 'Hầu hết mọi người không cần phải đi khám khi bị nhiễm khuẩn salmonella vì nó sẽ tự khỏi trong vòng vài ngày. Tuy nhiên, nếu người bị ảnh hưởng là trẻ sơ sinh, trẻ nhỏ, người lớn tuổi hoặc người có hệ ';
MERGE (n:Disease {id: 'D2608'}) SET n.id = 'D2608', n.name = 'Sarcoidosis', n.name_en = 'Sarcoidosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/sarcoidosis/symptoms-causes/syc-20350358 | https://medlineplus.gov/ency/article/000076.htm', n.overview = 'là tình trạng gây ra các tập hợp nhỏ tế bào hệ thống miễn dịch ở bất kỳ bộ phận nào của cơ thể. Những bộ sưu tập nhỏ này tạo thành các cục sưng đỏ, gọi là u hạt. U hạt thường xảy ra nhất ở phổi và các', n.prognosis = 'Nhiều người mắc bệnh sacoidosis không bị bệnh nặng và sẽ khỏi bệnh mà không cần điều trị. Có tới một nửa số người mắc bệnh sẽ khỏi bệnh sau 3 năm mà không cần điều trị. Những người có phổi bị ảnh hưởn', n.when_to_see = 'Hãy gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có các triệu chứng có thể là bệnh sarcoidosis. "Trải nghiệm của tôi tại Mayo đã giúp tôi có mặt ở đây vì các cháu của mình." — Jim, bệnh n';
MERGE (n:Disease {id: 'D2609'}) SET n.id = 'D2609', n.name = 'Sarcoma', n.name_en = 'Sarcoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sarcoma/symptoms-causes/syc-20351048', n.overview = 'đề cập đến một nhóm bệnh ung thư rộng lớn bắt đầu ở xương và mô mềm. Các mô mềm kết nối, hỗ trợ và bao quanh các cấu trúc khác của cơ thể. Các mô mềm bao gồm cơ, mỡ, mạch máu, dây thần kinh, gân và ni', n.when_to_see = 'Đặt lịch hẹn với bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác để biết các triệu chứng khiến bạn lo lắng. Khi nào cần đi khám bác sĩ Nếu bạn có những triệu chứng khiến bạn lo lắng, hãy đi khám. Gửi yê';
MERGE (n:Disease {id: 'D2610'}) SET n.id = 'D2610', n.name = 'Quá liều dầu xá xị', n.name_en = 'Sassafras oil overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002687.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng dầu xá xị nuốt vào và tốc độ điều trị được tiếp nhận nhanh như thế nào. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Dầu Sassafras rất độc hại. ';
MERGE (n:Disease {id: 'D2611'}) SET n.id = 'D2611', n.name = 'Cảm giác no - sớm', n.name_en = 'Satiety - early', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003127.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Cảm giác kéo dài vài ngày đến vài tuần và không thuyên giảm. Bạn giảm cân mà không cần cố gắng. Bạn có phân sẫm màu. Bạn bị buồn nôn và nôn, đau bụng ';
MERGE (n:Disease {id: 'D2612'}) SET n.id = 'D2612', n.name = 'Bệnh ghẻ', n.name_en = 'Scabies', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/scabies/symptoms-causes/syc-20377378 | https://medlineplus.gov/ency/article/000830.htm', n.overview = 'phát ban trên da. Một con ve nhỏ tên là Sarcoptes scabiei gây ra bệnh này. Con ve chui vào da, gây ngứa dữ dội. Nhu cầu gãi có thể mạnh hơn vào ban đêm. Bệnh ghẻ có thể lây lan qua tiếp xúc gần gũi, l', n.prognosis = 'Ngứa có thể tiếp tục trong 2 tuần hoặc hơn sau khi kết thúc điều trị. Nó rất có thể sẽ biến mất nếu bạn tuân theo kế hoạch điều trị của nhà cung cấp. Hầu hết các trường hợp ghẻ có thể được chữa khỏi m', n.when_to_see = 'Nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của bệnh ghẻ. Nhiều tình trạng da, chẳng hạn như viêm da hoặc chàm, cũng gây ngứa và nổi mụn nhỏ trên da. Chuyên gia chăm';
MERGE (n:Disease {id: 'D2613'}) SET n.id = 'D2613', n.name = 'Hội chứng bỏng da', n.name_en = 'Scalded skin syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001352.htm', n.prognosis = 'Dự kiến ​​sẽ phục hồi hoàn toàn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn hoặc đến phòng cấp cứu nếu bạn có các triệu chứng của chứng rối loạn này.';
MERGE (n:Disease {id: 'D2614'}) SET n.id = 'D2614', n.name = 'Cân', n.name_en = 'Scales', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003226.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu các triệu chứng trên da của bạn tiếp tục và các biện pháp tự chăm sóc không giúp ích.';
MERGE (n:Disease {id: 'D2615'}) SET n.id = 'D2615', n.name = 'Chỉnh sửa sẹo', n.name_en = 'Scar revision', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002991.htm', n.overview = 'Mô sẹo hình thành khi da lành lại sau chấn thương (chẳng hạn như tai nạn) hoặc phẫu thuật. Có bao nhiêu vết sẹo phụ thuộc vào: Kích thước, độ sâu và vị trí của vết thương Tuổi của bạn Đặc điểm của da,';
MERGE (n:Disease {id: 'D2616'}) SET n.id = 'D2616', n.name = 'Sốt đỏ tươi', n.name_en = 'Scarlet fever', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/scarlet-fever/symptoms-causes/syc-20377406 | https://medlineplus.gov/ency/article/000974.htm', n.overview = 'là một bệnh do vi khuẩn phát triển ở một số người bị viêm họng liên cầu khuẩn. Còn được gọi là bệnh sẹo ban đỏ, bệnh ban đỏ có đặc điểm là phát ban đỏ tươi bao phủ hầu hết cơ thể. Sốt đỏ tươi hầu như ', n.prognosis = 'Với việc điều trị bằng kháng sinh thích hợp, các triệu chứng của bệnh ban đỏ sẽ nhanh chóng thuyên giảm. Tuy nhiên, phát ban có thể kéo dài tới 2 đến 3 tuần trước khi biến mất hoàn toàn.', n.when_to_see = 'Nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn bị đau họng với: Sốt 100,4 F (38,0 C) trở lên Các tuyến sưng hoặc đau ở cổ Phát ban đỏ Các dấu hiệu và triệu chứng cần đánh gi';
MERGE (n:Disease {id: 'D2617'}) SET n.id = 'D2617', n.name = 'Bệnh sán máng', n.name_en = 'Schistosomiasis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001321.htm', n.prognosis = 'Điều trị trước khi xảy ra tổn thương nặng hoặc biến chứng nặng thường mang lại kết quả tốt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn phát triển các triệu chứng của bệnh sán máng, đặc biệt nếu bạn: Đã đi đến khu vực nhiệt đới hoặc cận nhiệt đới nơi bệnh được biết là tồn tại Đã tiế';
MERGE (n:Disease {id: 'D2618'}) SET n.id = 'D2618', n.name = 'Rối loạn tâm thần phân liệt', n.name_en = 'Schizoaffective disorder', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/schizoaffective-disorder/symptoms-causes/syc-20354504 | https://medlineplus.gov/ency/article/000930.htm', n.overview = 'là một tình trạng sức khỏe tâm thần được biểu hiện bằng sự kết hợp của các triệu chứng tâm thần phân liệt, chẳng hạn như ảo giác và ảo tưởng, cũng như các triệu chứng rối loạn tâm trạng, chẳng hạn như', n.prognosis = 'Những người mắc chứng rối loạn tâm thần phân liệt có nhiều khả năng quay trở lại mức độ chức năng trước đây hơn những người mắc hầu hết các chứng rối loạn tâm thần khác. Nhưng thường cần phải điều trị', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn hoặc ai đó bạn biết đang gặp phải bất kỳ vấn đề nào sau đây: Trầm cảm với cảm giác tuyệt vọng hoặc bất lực Không có khả năng chăm sóc các nhu cầu cá nhân c';
MERGE (n:Disease {id: 'D2619'}) SET n.id = 'D2619', n.name = 'Rối loạn nhân cách phân liệt', n.name_en = 'Schizoid personality disorder', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/schizoid-personality-disorder/symptoms-causes/syc-20354414 | https://medlineplus.gov/ency/article/000920.htm', n.overview = 'là tình trạng một người thể hiện rất ít, nếu có, sự quan tâm và khả năng hình thành mối quan hệ với người khác. Một người rất khó thể hiện đầy đủ các cung bậc cảm xúc. Nếu bạn mắc chứng rối loạn nhân ', n.prognosis = 'Rối loạn nhân cách phân liệt là một căn bệnh lâu dài (mãn tính) thường không cải thiện nhiều theo thời gian. Sự cô lập xã hội thường ngăn cản người đó yêu cầu giúp đỡ hoặc hỗ trợ. Việc hạn chế kỳ vọng', n.when_to_see = 'Những người mắc chứng rối loạn nhân cách phân liệt thường chỉ tìm cách điều trị cho một vấn đề liên quan, chẳng hạn như trầm cảm. Nếu ai đó thúc giục bạn tìm kiếm sự giúp đỡ về các triệu chứng thường ';
MERGE (n:Disease {id: 'D2620'}) SET n.id = 'D2620', n.name = 'Tâm thần phân liệt', n.name_en = 'Schizophrenia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/schizophrenia/symptoms-causes/syc-20354443 | https://medlineplus.gov/ency/article/000928.htm', n.overview = 'là một tình trạng sức khỏe tâm thần nghiêm trọng ảnh hưởng đến cách mọi người suy nghĩ, cảm nhận và hành xử. Nó có thể dẫn đến sự kết hợp của ảo giác, ảo tưởng, suy nghĩ và hành vi vô tổ chức. Ảo giác', n.prognosis = 'Triển vọng khó dự đoán. Hầu hết thời gian, các triệu chứng sẽ cải thiện khi dùng thuốc. Nhưng nhiều người có thể gặp khó khăn khi hoạt động. Họ có nguy cơ bị bệnh tái phát nhiều lần, đặc biệt là trong', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu bạn (hoặc một thành viên trong gia đình): Nghe thấy những giọng nói bảo bạn làm tổn thương bản thân hoặc người khác Có nhu cầu làm tổn thương bản thân hoặc người k';
MERGE (n:Disease {id: 'D2621'}) SET n.id = 'D2621', n.name = 'Kiểm tra độ tuổi đi học hoặc chuẩn bị thủ tục', n.name_en = 'School age test or procedure preparation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002058.htm', n.overview = 'Biết rằng con bạn có thể sẽ khóc. Ngay cả khi bạn chuẩn bị, con bạn vẫn có thể cảm thấy khó chịu hoặc đau đớn. Hãy thử sử dụng trò chơi để chứng minh điều gì sẽ xảy ra trong quá trình kiểm tra. Làm nh';
MERGE (n:Disease {id: 'D2622'}) SET n.id = 'D2622', n.name = 'Sự phát triển của trẻ ở độ tuổi đi học', n.name_en = 'School-age children development', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002017.htm', n.overview = 'PHÁT TRIỂN THỂ CHẤT Trẻ ở độ tuổi đi học thường có kỹ năng vận động trơn tru và mạnh mẽ. Tuy nhiên, khả năng phối hợp (đặc biệt là mắt-tay), sức bền, khả năng giữ thăng bằng và thể chất của họ khác nh';
MERGE (n:Disease {id: 'D2623'}) SET n.id = 'D2623', n.name = 'Schwannomatosis', n.name_en = 'Schwannomatosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/schwannomatosis/symptoms-causes/syc-20567542', n.overview = 'là một tình trạng hiếm gặp. Nó gây ra các khối u phát triển chậm gọi là schwannomas hình thành trên vỏ thần kinh. Khối u bao thần kinh ngoại biên bắt đầu ở lớp bao phủ các dây thần kinh bên ngoài não ', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe nếu bạn có các triệu chứng của bệnh schwannomatosis, chẳng hạn như đau liên tục, tê, yếu hoặc thăng bằng mới hoặc thay đổi thính giác. Việc kiểm tra sớm có thể';
MERGE (n:Disease {id: 'D2624'}) SET n.id = 'D2624', n.name = 'Đau thần kinh tọa', n.name_en = 'Sciatica', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/sciatica/symptoms-causes/syc-20377435 | https://medlineplus.gov/ency/article/000686.htm', n.overview = 'Dây thần kinh tọa ở vùng lưng dưới. Dây thần kinh tọa kéo dài từ mông xuống mỗi chân. Đau thần kinh tọa đề cập đến cơn đau di chuyển dọc theo đường đi của dây thần kinh tọa. Dây thần kinh hông đi từ m', n.prognosis = 'Thông thường, bệnh đau thần kinh tọa sẽ tự thuyên giảm. Nhưng việc nó quay trở lại là chuyện bình thường.', n.when_to_see = 'Đau thần kinh tọa nhẹ thường biến mất theo thời gian. Gọi cho chuyên gia chăm sóc chính của bạn nếu các biện pháp tự chăm sóc không làm giảm các triệu chứng. Cũng gọi nếu cơn đau kéo dài hơn một tuần,';
MERGE (n:Disease {id: 'D2625'}) SET n.id = 'D2625', n.name = 'Bệnh xơ cứng bì tiểu đường', n.name_en = 'Scleredema diabeticorum', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007749.htm', n.prognosis = 'Tình trạng này không thể chữa khỏi. Điều trị có thể cải thiện chuyển động và hơi thở.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn: Gặp khó khăn trong việc điều chỉnh lượng đường trong máu Nhận thấy các triệu chứng của chứng phù nề Nếu bạn bị phù nề, hãy liên hệ với nhà cung cấp dị';
MERGE (n:Disease {id: 'D2626'}) SET n.id = 'D2626', n.name = 'Viêm củng mạc', n.name_en = 'Scleritis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001003.htm', n.prognosis = 'Trong hầu hết các trường hợp, viêm củng mạc sẽ khỏi sau khi điều trị. Nhưng nó có thể quay trở lại. Nếu có rối loạn gây viêm củng mạc, nó có thể nghiêm trọng. Tuy nhiên, nó có thể không được phát hiện', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ hoặc bác sĩ nhãn khoa nếu bạn có các triệu chứng của bệnh viêm củng mạc.';
MERGE (n:Disease {id: 'D2627'}) SET n.id = 'D2627', n.name = 'Bệnh xơ cứng bì', n.name_en = 'Scleroderma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/scleroderma/symptoms-causes/syc-20351952 | https://medlineplus.gov/ency/article/000429.htm', n.overview = '(sklair-oh-DUR-muh), còn được gọi là bệnh xơ cứng hệ thống, là một nhóm bệnh hiếm gặp liên quan đến tình trạng da cứng và căng. Xơ cứng bì cũng có thể gây ra các vấn đề về mạch máu, các cơ quan nội tạ', n.prognosis = 'Ở một số người, các triệu chứng phát triển nhanh chóng trong vài năm đầu và tiếp tục trở nên tồi tệ hơn. Tuy nhiên, ở hầu hết mọi người, bệnh chỉ trở nên nặng hơn một cách từ từ. Những người chỉ có tr', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn phát triển hiện tượng Raynaud, da ngày càng dày lên hoặc khó nuốt.';
MERGE (n:Disease {id: 'D2628'}) SET n.id = 'D2628', n.name = 'Viêm đường mật xơ cứng', n.name_en = 'Sclerosing cholangitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000285.htm', n.prognosis = 'Mức độ khỏe mạnh của mỗi người là khác nhau. Bệnh có xu hướng trở nên nặng hơn theo thời gian. Đôi khi người ta phát triển: Cổ trướng (tích tụ chất lỏng trong khoảng trống giữa niêm mạc bụng và các cơ';
MERGE (n:Disease {id: 'D2629'}) SET n.id = 'D2629', n.name = 'Viêm mạc treo xơ cứng', n.name_en = 'Sclerosing mesenteritis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sclerosing-mesenteritis/symptoms-causes/syc-20355087', n.overview = 'Mạc treo bám vào thành bụng và giữ cố định. Viêm mạc treo xơ cứng là tình trạng mô giữ ruột non tại chỗ, được gọi là mạc treo, bị viêm và hình thành mô sẹo. Tình trạng này còn được gọi là viêm mô mỡ m';
MERGE (n:Disease {id: 'D2630'}) SET n.id = 'D2630', n.name = 'Vẹo cột sống', n.name_en = 'Scoliosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/scoliosis/symptoms-causes/syc-20350716 | https://medlineplus.gov/ency/article/001241.htm', n.overview = '-out S. Lưng trên cong ra ngoài và lưng dưới hơi cong vào trong. Nhìn từ phía sau, cột sống điển hình trông giống như một đường thẳng từ gốc cổ đến xương cụt. Chứng vẹo cột sống khiến cột sống cong sa', n.prognosis = 'Tình trạng của một người bị chứng vẹo cột sống phụ thuộc vào loại, nguyên nhân và mức độ nghiêm trọng của đường cong. Tình trạng cong vẹo càng nghiêm trọng thì khả năng bệnh sẽ càng trầm trọng hơn sau', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe của con bạn nếu bạn thấy dấu hiệu vẹo cột sống ở con mình. Đường cong nhẹ có thể hình thành từ từ và không gây đau. Bạn và con bạn có thể không biết nó ở đó. Đ';
MERGE (n:Disease {id: 'D2631'}) SET n.id = 'D2631', n.name = 'Phẫu thuật vẹo cột sống ở trẻ em', n.name_en = 'Scoliosis surgery in children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007383.htm', n.overview = 'Trước khi phẫu thuật, con bạn sẽ được gây mê toàn thân. Đây là những loại thuốc đưa trẻ vào giấc ngủ sâu và không còn cảm giác đau đớn trong quá trình phẫu thuật. Trong quá trình phẫu thuật, bác sĩ ph', n.prognosis = 'Cột sống của con bạn sẽ trông thẳng hơn nhiều sau khi phẫu thuật. Vẫn sẽ có một số đường cong. Phải mất ít nhất 3 tháng để các xương cột sống kết hợp tốt với nhau. Sẽ mất từ ​​1 đến 2 năm để chúng hợp';
MERGE (n:Disease {id: 'D2632'}) SET n.id = 'D2632', n.name = 'Cá bọ cạp đốt', n.name_en = 'Scorpion fish sting', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002849.htm', n.prognosis = 'Quá trình phục hồi thường mất khoảng 24 đến 48 giờ. Kết quả thường phụ thuộc vào lượng nọc độc xâm nhập vào cơ thể, vị trí vết đốt và thời gian điều trị. Tình trạng tê hoặc ngứa ran có thể kéo dài vài';
MERGE (n:Disease {id: 'D2633'}) SET n.id = 'D2633', n.name = 'Bọ cạp đốt', n.name_en = 'Scorpion sting', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/scorpion-stings/symptoms-causes/syc-20353859', n.overview = 'Vỏ cây bọ cạp ở phía tây Hoa Kỳ. Bọ cạp đốt rất đau nhưng hiếm khi nguy hiểm đến tính mạng. Người lớn khỏe mạnh thường không cần điều trị vết đốt của bọ cạp. Trẻ nhỏ và người lớn tuổi có nguy cơ bị bi', n.when_to_see = 'Hãy liên hệ ngay với trung tâm kiểm soát chất độc tại địa phương nếu trẻ bị bọ cạp đốt. Để liên hệ với trung tâm kiểm soát chất độc ở Hoa Kỳ, hãy gọi tới Trợ giúp về chất độc theo số 800-222-1222. Ngo';
MERGE (n:Disease {id: 'D2634'}) SET n.id = 'D2634', n.name = 'Bọ cạp', n.name_en = 'Scorpions', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002850.htm', n.prognosis = 'Tử vong do bọ cạp đốt hiếm khi xảy ra ở những người trên 6 tuổi. Nếu các triệu chứng nhanh chóng trở nên tồi tệ hơn trong vòng 2 đến 4 giờ đầu sau khi bị đốt thì nhiều khả năng sẽ có kết quả xấu. Các ';
MERGE (n:Disease {id: 'D2635'}) SET n.id = 'D2635', n.name = 'Cạo', n.name_en = 'Scrape', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007212.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Vết cạo có bụi bẩn và các mảnh vụn khác nằm sâu bên trong. Vết xước rất lớn. Vết xước trông như thể bị nhiễm trùng. Các dấu hiệu nhi';
MERGE (n:Disease {id: 'D2636'}) SET n.id = 'D2636', n.name = 'Scrofula', n.name_en = 'Scrofula', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001354.htm', n.prognosis = 'Khi điều trị, mọi người thường hồi phục hoàn toàn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn bị sưng hoặc có một nhóm vết sưng ở cổ. Scrofula có thể xảy ra ở trẻ em chưa tiếp xúc với người mắc bệnh lao.';
MERGE (n:Disease {id: 'D2637'}) SET n.id = 'D2637', n.name = 'Khối bìu', n.name_en = 'Scrotal masses', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/scrotal-masses/symptoms-causes/syc-20352604 | https://medlineplus.gov/ency/article/001283.htm', n.overview = 'là các khối u hoặc sưng tấy ở bìu, túi da giữ tinh hoàn. Khối bìu có thể là: Sự tích tụ chất lỏng. Sự phát triển của mô không đều. Các bộ phận bên trong bìu bị sưng, viêm hoặc cứng lại. Điều quan trọn', n.prognosis = 'Hầu hết các tình trạng gây ra khối bìu đều có thể điều trị dễ dàng. Ngay cả ung thư tinh hoàn cũng có tỷ lệ chữa khỏi cao nếu được phát hiện và điều trị sớm. Yêu cầu bác sĩ kiểm tra bất kỳ khối u bìu ', n.when_to_see = 'Nhận chăm sóc y tế khẩn cấp nếu bạn bị đau đột ngột ở bìu. Một số vấn đề cần được điều trị ngay lập tức để giúp ngăn ngừa tổn thương vĩnh viễn ở tinh hoàn. Hãy đến gặp chuyên gia chăm sóc sức khỏe nếu';
MERGE (n:Disease {id: 'D2638'}) SET n.id = 'D2638', n.name = 'Sưng bìu', n.name_en = 'Scrotal swelling', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003161.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn nhận thấy bất kỳ vết sưng bìu không rõ nguyên nhân. Vết sưng tấy rất đau. Bạn có một khối u ở tinh hoàn.';
MERGE (n:Disease {id: 'D2639'}) SET n.id = 'D2639', n.name = 'Rối loạn cảm xúc theo mùa', n.name_en = 'Seasonal affective disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001532.htm', n.prognosis = 'Kết quả điều trị thường tốt. Nhưng một số người lại bị SAD suốt đời.', n.when_to_see = 'Nếu bạn hoặc ai đó bạn biết đang nghĩ đến việc tự tử, hãy gọi hoặc nhắn tin tới 988 hoặc trò chuyện 988lifeline.org. Bạn cũng có thể gọi 1-800-273-8255 (1-800-273-TALK). Đường dây nóng tự tử và khủng ';
MERGE (n:Disease {id: 'D2640'}) SET n.id = 'D2640', n.name = 'Rối loạn cảm xúc theo mùa (SAD)', n.name_en = 'Seasonal affective disorder (SAD)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/seasonal-affective-disorder/symptoms-causes/syc-20364651', n.overview = 'là một loại trầm cảm có liên quan đến sự thay đổi theo mùa - SAD bắt đầu và kết thúc vào cùng một thời điểm hàng năm. Nếu bạn giống như hầu hết những người mắc SAD, các triệu chứng của bạn bắt đầu vào', n.when_to_see = 'Có những ngày bạn cảm thấy chán nản là điều bình thường. Nhưng nếu bạn cảm thấy chán nản nhiều ngày liên tục và không thể có động lực để thực hiện các hoạt động mà bạn thường yêu thích, hãy đến gặp nh';
MERGE (n:Disease {id: 'D2641'}) SET n.id = 'D2641', n.name = 'U tuyến bã nhờn', n.name_en = 'Sebaceous adenoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002292.htm', n.overview = 'U tuyến bã nhờn là một vết sưng nhỏ. Thường chỉ có một và nó thường được tìm thấy trên mặt, da đầu, bụng, lưng hoặc ngực. Nó xảy ra thường xuyên nhất ở những người từ 60 tuổi trở lên. Hiếm khi, nó có ';
MERGE (n:Disease {id: 'D2642'}) SET n.id = 'D2642', n.name = 'Ung thư biểu mô bã nhờn', n.name_en = 'Sebaceous carcinoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sebaceous-carcinoma/symptoms-causes/syc-20577038', n.overview = 'bắt đầu từ tuyến dầu trên da của bạn. Nó thường ảnh hưởng đến mí mắt và có thể gây ra cục u hoặc dày da. Ung thư biểu mô bã nhờn là một loại ung thư hiếm gặp bắt đầu từ tuyến dầu trên da. Ung thư biểu', n.when_to_see = 'Đặt lịch hẹn với bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập ';
MERGE (n:Disease {id: 'D2643'}) SET n.id = 'D2643', n.name = 'Viêm da tiết bã', n.name_en = 'Seborrheic dermatitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/seborrheic-dermatitis/symptoms-causes/syc-20352710 | https://medlineplus.gov/ency/article/000963.htm', n.overview = 'ở mặt gây phát ban dạng mảng dầu có vảy màu vàng hoặc trắng. Phát ban có thể trông đậm hơn hoặc nhạt hơn ở những người có làn da nâu hoặc đen và đỏ hơn ở những người có làn da trắng. Viêm da tiết bã (', n.prognosis = 'Viêm da tiết bã là một tình trạng mãn tính (suốt đời) đến rồi đi nhưng có thể kiểm soát được bằng cách điều trị. Mức độ nghiêm trọng của viêm da tiết bã có thể được giảm bớt bằng cách kiểm soát các yế', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn khó chịu đến mức mất ngủ hoặc bị phân tâm khỏi các công việc hàng ngày. Tình trạng của bạn khiến bạn cảm thấy xấu hổ hoặc lo lắng. Bạn n';
MERGE (n:Disease {id: 'D2644'}) SET n.id = 'D2644', n.name = 'Bệnh dày sừng tiết bã', n.name_en = 'Seborrheic keratosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/seborrheic-keratosis/symptoms-causes/syc-20353878 | https://medlineplus.gov/ency/article/000884.htm', n.overview = 'Bệnh dày sừng tiết bã (seb-o-REE-ik ker-uh-TOE-sis) là một bệnh phát triển ở da không phải ung thư (lành tính) phổ biến. Mọi người có xu hướng nhận được nhiều hơn khi họ già đi. Keratoses tiết bã thườ', n.prognosis = 'Việc loại bỏ các khối tăng trưởng rất đơn giản và thường không để lại sẹo. Bạn có thể có những mảng da sáng hơn, nơi các khối u trên thân đã bị loại bỏ. Sự tăng trưởng thường không quay trở lại sau kh', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh dày sừng tiết bã. Đồng thời, hãy liên hệ nếu bạn có các triệu chứng mới, chẳng hạn như: Sự thay đổi về hình dáng của sự';
MERGE (n:Disease {id: 'D2645'}) SET n.id = 'D2645', n.name = 'Quá liều Secobarbital', n.name_en = 'Secobarbital overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002544.htm', n.prognosis = 'Tình trạng sức khỏe của người đó phụ thuộc vào mức độ nghiêm trọng của quá liều và tốc độ điều trị được tiếp nhận. Nếu được điều trị thích hợp, mọi người có thể hồi phục sau 1 đến 5 ngày. Những người ';
MERGE (n:Disease {id: 'D2646'}) SET n.id = 'D2646', n.name = 'Tăng huyết áp thứ phát', n.name_en = 'Secondary hypertension', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/secondary-hypertension/symptoms-causes/syc-20350679', n.overview = 'Huyết áp cao thứ phát (tăng huyết áp thứ phát) là huyết áp cao do một tình trạng bệnh lý khác gây ra. Nó có thể được gây ra bởi các tình trạng ảnh hưởng đến thận, động mạch, tim hoặc hệ thống nội tiết', n.when_to_see = 'Nếu bạn mắc một tình trạng có thể gây tăng huyết áp thứ phát, bạn có thể cần kiểm tra huyết áp thường xuyên hơn. Hãy hỏi nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn về tần suất kiểm tra huyết áp củ';
MERGE (n:Disease {id: 'D2647'}) SET n.id = 'D2647', n.name = 'Bệnh Parkinson thứ phát', n.name_en = 'Secondary parkinsonism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000759.htm', n.prognosis = 'Không giống như bệnh Parkinson, một số loại bệnh Parkinson thứ phát có thể ổn định hoặc thậm chí cải thiện nếu nguyên nhân cơ bản được điều trị. Một số vấn đề về não, chẳng hạn như bệnh thể Lewy, khôn', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Các triệu chứng của bệnh Parkinson thứ phát phát triển, quay trở lại hoặc trở nên trầm trọng hơn. Các triệu chứng mới xuất hiện, bao gồm lú lẫn và cử ';
MERGE (n:Disease {id: 'D2648'}) SET n.id = 'D2648', n.name = 'Bệnh amyloidosis hệ thống thứ phát', n.name_en = 'Secondary systemic amyloidosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000585.htm', n.prognosis = 'Sức khoẻ của một người phụ thuộc vào cơ quan nào bị ảnh hưởng. Nó cũng phụ thuộc vào việc liệu căn bệnh gây ra nó có thể được kiểm soát hay không. Nếu bệnh liên quan đến tim và thận, nó có thể dẫn đến', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng của tình trạng này. Sau đây là những triệu chứng nghiêm trọng cần được chăm sóc y tế kịp thời: Chảy máu Nhịp tim không đều Tê Khó thở Sư';
MERGE (n:Disease {id: 'D2649'}) SET n.id = 'D2649', n.name = 'Động kinh', n.name_en = 'Seizures', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/seizure/symptoms-causes/syc-20365711 | https://medlineplus.gov/ency/article/003200.htm', n.overview = 'Cơn động kinh là sự bùng nổ đột ngột của hoạt động điện trong não. Nó có thể gây ra những thay đổi trong hành vi, cử động, cảm xúc và mức độ ý thức. Động kinh được định nghĩa là có hai hoặc nhiều cơn ', n.when_to_see = 'Tìm kiếm sự trợ giúp y tế ngay lập tức nếu bạn bị co giật hoặc nếu bạn thấy ai đó bị co giật và bất kỳ điều nào sau đây xảy ra: Cơn co giật kéo dài hơn năm phút. Người đó không thở sau khi cơn động ki';
MERGE (n:Disease {id: 'D2650'}) SET n.id = 'D2650', n.name = 'Thiếu IgA chọn lọc', n.name_en = 'Selective deficiency of IgA', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001476.htm', n.prognosis = 'Thiếu IgA chọn lọc có xu hướng ít nghiêm trọng hơn nhiều bệnh suy giảm miễn dịch khác. Nhiều người bị thiếu IgA chọn lọc không có triệu chứng gì cả. Một số người bị thiếu hụt IgA sẽ tự phục hồi và sản', n.when_to_see = 'Những người bị thiếu hụt IgA nên liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của họ nếu họ có các triệu chứng nhiễm trùng hoặc các triệu chứng về đường ruột.';
MERGE (n:Disease {id: 'D2651'}) SET n.id = 'D2651', n.name = 'Chứng câm có chọn lọc', n.name_en = 'Selective mutism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001546.htm', n.prognosis = 'Trẻ mắc hội chứng này có thể có những kết quả khác nhau. Một số có thể cần tiếp tục điều trị chứng nhút nhát và lo âu xã hội cho đến tuổi thiếu niên và có thể là đến tuổi trưởng thành.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có các triệu chứng của chứng câm có chọn lọc và triệu chứng này đang ảnh hưởng đến trường học và các hoạt động xã hội.';
MERGE (n:Disease {id: 'D2652'}) SET n.id = 'D2652', n.name = 'Tự gây thương tích/cắt', n.name_en = 'Self-injury/cutting', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/self-injury/symptoms-causes/syc-20350950', n.overview = 'Tự gây thương tích không tự sát, thường được gọi đơn giản là tự gây thương tích, là hành động cố ý làm hại cơ thể của chính bạn, chẳng hạn như bằng cách cắt hoặc đốt chính mình. Nó thường không có ngh', n.when_to_see = 'Nếu bạn đang tự làm mình bị thương, dù chỉ ở mức độ nhẹ hoặc nếu bạn có ý nghĩ làm hại bản thân, hãy liên hệ để được giúp đỡ. Bất kỳ hình thức tự gây thương tích nào đều là dấu hiệu của những yếu tố g';
MERGE (n:Disease {id: 'D2653'}) SET n.id = 'D2653', n.name = 'Bệnh đa dây thần kinh cảm giác vận động', n.name_en = 'Sensorimotor polyneuropathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000750.htm', n.prognosis = 'Trong một số trường hợp, bạn có thể phục hồi hoàn toàn sau bệnh lý thần kinh ngoại biên nếu nhà cung cấp dịch vụ của bạn có thể tìm ra nguyên nhân và điều trị thành công và nếu tổn thương không ảnh hư', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu bạn mất khả năng vận động hoặc cảm giác ở một bộ phận cơ thể. Chẩn đoán và điều trị sớm làm tăng cơ hội kiểm soát các triệu chứng.';
MERGE (n:Disease {id: 'D2654'}) SET n.id = 'D2654', n.name = 'Điếc thần kinh giác quan', n.name_en = 'Sensorineural deafness', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003291.htm';
MERGE (n:Disease {id: 'D2655'}) SET n.id = 'D2655', n.name = 'Rối loạn lo âu chia ly', n.name_en = 'Separation anxiety disorder', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/separation-anxiety-disorder/symptoms-causes/syc-20377455', n.overview = 'Lo lắng chia ly là giai đoạn điển hình của nhiều trẻ sơ sinh và trẻ mới biết đi. Trẻ nhỏ thường có giai đoạn lo lắng hoặc đau khổ khi phải xa cha mẹ hoặc người chăm sóc chính. Ví dụ về điều này có thể', n.when_to_see = 'Rối loạn lo âu chia ly thường không khỏi nếu không điều trị và có thể dẫn đến rối loạn hoảng sợ và các rối loạn lo âu khác khi trưởng thành. Nếu bạn lo lắng về nỗi lo lắng khi bị chia ly của con mình,';
MERGE (n:Disease {id: 'D2656'}) SET n.id = 'D2656', n.name = 'Lo lắng về sự chia ly ở trẻ em', n.name_en = 'Separation anxiety in children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001542.htm', n.prognosis = 'Trẻ nhỏ có các triệu chứng cải thiện sau 2 tuổi là bình thường, ngay cả khi một số lo lắng quay trở lại sau đó khi bị căng thẳng. Khi lo lắng về sự chia ly xảy ra ở tuổi thiếu niên, nó có thể báo hiệu', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu con bạn mắc chứng lo âu chia ly nghiêm trọng sau 2 tuổi.';
MERGE (n:Disease {id: 'D2657'}) SET n.id = 'D2657', n.name = 'Nhiễm trùng huyết', n.name_en = 'Sepsis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/sepsis/symptoms-causes/syc-20351214 | https://medlineplus.gov/ency/article/000666.htm', n.overview = 'là một tình trạng nghiêm trọng trong đó cơ thể phản ứng không đúng cách với nhiễm trùng. Quá trình chống nhiễm trùng tác động lên cơ thể, khiến các cơ quan hoạt động kém. Nhiễm trùng huyết có thể tiến', n.prognosis = 'Nhiễm trùng huyết thường đe dọa tính mạng, đặc biệt ở những người có hệ miễn dịch yếu hoặc mắc bệnh ( mãn tính) lâu dài. Tổn thương do giảm lưu lượng máu đến các cơ quan quan trọng như não, tim và thậ', n.when_to_see = 'Bất kỳ nhiễm trùng nào cũng có thể dẫn đến nhiễm trùng huyết. Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn có các triệu chứng nhiễm trùng huyết hoặc nhiễm trùng hoặc vết thương không thu';
MERGE (n:Disease {id: 'D2658'}) SET n.id = 'D2658', n.name = 'Viêm khớp nhiễm trùng', n.name_en = 'Septic arthritis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/bone-and-joint-infections/symptoms-causes/syc-20350755 | https://medlineplus.gov/ency/article/000430.htm', n.overview = 'là một bệnh nhiễm trùng gây đau ở khớp. Nó có thể đến từ vi trùng di chuyển trong máu từ một bộ phận khác của cơ thể. Viêm khớp nhiễm trùng cũng có thể xảy ra khi một vết thương xuyên qua da, chẳng hạ', n.prognosis = 'Phục hồi tốt nếu điều trị bằng kháng sinh kịp thời. Nếu điều trị bị trì hoãn, tổn thương khớp vĩnh viễn có thể xảy ra.', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn nếu cơn đau dữ dội ở khớp xuất hiện nhanh chóng. Điều trị nhanh có thể giúp giảm bớt tổn thương khớp. Nếu bạn đã được thay khớp, hãy đến gặp chuyên gia';
MERGE (n:Disease {id: 'D2659'}) SET n.id = 'D2659', n.name = 'Sốc nhiễm trùng', n.name_en = 'Septic shock', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000668.htm', n.prognosis = 'Sốc nhiễm trùng có tỷ lệ tử vong cao. Tỷ lệ tử vong phụ thuộc vào độ tuổi và sức khỏe tổng thể của người đó, nguyên nhân gây nhiễm trùng, số lượng cơ quan bị suy giảm và liệu pháp điều trị y tế được b', n.when_to_see = 'Hãy đến thẳng phòng cấp cứu nếu bạn xuất hiện các triệu chứng sốc nhiễm trùng.';
MERGE (n:Disease {id: 'D2660'}) SET n.id = 'D2660', n.name = 'Phẫu thuật tạo hình vách ngăn', n.name_en = 'Septoplasty', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003012.htm', n.overview = 'Hầu hết mọi người đều được gây mê toàn thân để tạo hình vách ngăn. Bạn sẽ ngủ và không bị đau. Một số người thực hiện phẫu thuật dưới hình thức gây tê cục bộ, làm tê vùng đó để giảm đau. Bạn sẽ tỉnh t', n.prognosis = 'Hầu hết các thủ thuật tạo hình vách ngăn đều có thể làm thẳng vách ngăn. Hơi thở thường được cải thiện.';
MERGE (n:Disease {id: 'D2661'}) SET n.id = 'D2661', n.name = 'Hội chứng serotonin', n.name_en = 'Serotonin syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/serotonin-syndrome/symptoms-causes/syc-20354758 | https://medlineplus.gov/ency/article/007272.htm', n.overview = 'là một phản ứng thuốc nghiêm trọng. Nguyên nhân là do các loại thuốc làm tăng nồng độ serotonin trong cơ thể. Serotonin là một chất hóa học mà cơ thể sản xuất một cách tự nhiên. Nó cần thiết cho các t', n.prognosis = 'Mọi người có thể trở nên nặng hơn từ từ và có thể bị bệnh nặng nếu không được điều trị nhanh chóng. Không được điều trị, SS có thể gây tử vong. Khi được điều trị, các triệu chứng thường biến mất sau c', n.when_to_see = 'Nếu bạn nghi ngờ mình có thể mắc hội chứng serotonin sau khi bắt đầu dùng một loại thuốc mới hoặc tăng liều lượng của loại thuốc bạn đang dùng, hãy gọi ngay cho nhà cung cấp dịch vụ chăm sóc sức khỏe ';
MERGE (n:Disease {id: 'D2662'}) SET n.id = 'D2662', n.name = 'Khối u tế bào Sertoli-Leydig', n.name_en = 'Sertoli-Leydig cell tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001172.htm', n.prognosis = 'Điều trị sớm sẽ mang lại kết quả tốt. Đặc điểm nữ tính thường trở lại sau phẫu thuật. Nhưng đặc điểm của nam giới được giải quyết chậm hơn. Đối với các khối u ở giai đoạn tiến triển hơn, triển vọng ké';
MERGE (n:Disease {id: 'D2663'}) SET n.id = 'D2663', n.name = 'Bệnh huyết thanh', n.name_en = 'Serum sickness', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000820.htm', n.prognosis = 'Các triệu chứng thường biến mất trong vòng vài ngày.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn đã nhận được thuốc hoặc kháng huyết thanh trong 4 tuần qua và có các triệu chứng của bệnh huyết thanh.';
MERGE (n:Disease {id: 'D2664'}) SET n.id = 'D2664', n.name = 'Hội chứng hô hấp cấp tính nặng (SARS)', n.name_en = 'Severe acute respiratory syndrome (SARS)', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/sars/symptoms-causes/syc-20351765 | https://medlineplus.gov/ency/article/007192.htm', n.overview = 'là một bệnh truyền nhiễm do vi-rút Corona gây ra. Đó là một căn bệnh ảnh hưởng đến phổi và đường hô hấp, còn được gọi là bệnh hô hấp. Vi-rút Corona gây ra bệnh SARS được gọi là SARS-CoV-1. Nó xuất hiệ', n.prognosis = 'Trong đợt bùng phát năm 2003, tỷ lệ tử vong do SARS là 9% đến 12% trong số những người được chẩn đoán. Ở những người trên 65 tuổi, tỷ lệ tử vong cao hơn 50%. Bệnh nhẹ hơn ở người trẻ tuổi. Ở nhóm dân ', n.when_to_see = 'SARS là một căn bệnh nghiêm trọng có thể dẫn đến tử vong. Nếu bạn có bất kỳ triệu chứng nào của nhiễm trùng đường hô hấp, hãy gọi ngay cho thành viên nhóm chăm sóc sức khỏe của bạn. Đồng thời, hãy gọi';
MERGE (n:Disease {id: 'D2665'}) SET n.id = 'D2665', n.name = 'Đau đầu khi quan hệ tình dục', n.name_en = 'Sex headaches', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sex-headaches/symptoms-causes/syc-20377477', n.overview = 'Trong một số trường hợp hiếm hoi, đau đầu có thể do hoạt động tình dục gây ra - đặc biệt là khi đạt cực khoái. Bạn có thể nhận thấy cơn đau âm ỉ ở đầu và cổ tăng lên khi hưng phấn tình dục tăng lên. H', n.when_to_see = 'Đau đầu khi quan hệ tình dục thường không phải là nguyên nhân đáng lo ngại. Nhưng hãy tham khảo ý kiến ​​nhà cung cấp dịch vụ chăm sóc sức khoẻ của bạn ngay lập tức nếu bạn bị đau đầu khi hoạt động tì';
MERGE (n:Disease {id: 'D2666'}) SET n.id = 'D2666', n.name = 'Tính trạng trội liên kết với giới tính', n.name_en = 'Sex-linked dominant', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002050.htm', n.overview = 'Sự di truyền của một bệnh, tình trạng hoặc đặc điểm cụ thể phụ thuộc vào loại nhiễm sắc thể bị ảnh hưởng. Nó có thể là nhiễm sắc thể thường hoặc nhiễm sắc thể giới tính. Nó còn phụ thuộc vào tính trạn';
MERGE (n:Disease {id: 'D2667'}) SET n.id = 'D2667', n.name = 'Bệnh lặn liên kết với giới tính', n.name_en = 'Sex-linked recessive', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002051.htm', n.overview = 'Các bệnh lặn liên kết với X thường xảy ra ở nam giới. Con đực chỉ có một nhiễm sắc thể X. Một gen lặn trên nhiễm sắc thể X đó sẽ gây ra bệnh. Nhiễm sắc thể Y là nửa còn lại của cặp gen XY ở nam giới. ';
MERGE (n:Disease {id: 'D2668'}) SET n.id = 'D2668', n.name = 'Tấn công tình dục - phòng ngừa', n.name_en = 'Sexual assault - prevention', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007461.htm', n.overview = 'Theo các chuyên gia y tế, tất cả chúng ta đều có vai trò trong việc giúp ngăn chặn tấn công tình dục. Mọi người nên thực hiện các bước để chống lại bạo lực tình dục trong cộng đồng. Hãy lên tiếng. Nếu';
MERGE (n:Disease {id: 'D2669'}) SET n.id = 'D2669', n.name = 'Bạo lực tình dục', n.name_en = 'Sexual violence', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001955.htm', n.overview = 'Tấn công tình dục, lạm dụng tình dục, loạn luân và cưỡng hiếp đều là các loại bạo lực tình dục. Bạo lực tình dục là một vấn đề sức khỏe cộng đồng nghiêm trọng. Nó ảnh hưởng đến mọi người: Tuổi tác Giớ';
MERGE (n:Disease {id: 'D2670'}) SET n.id = 'D2670', n.name = 'Các bệnh lây truyền qua đường tình dục (STD)', n.name_en = 'Sexually transmitted diseases (STDs)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sexually-transmitted-diseases-stds/symptoms-causes/syc-20351240', n.overview = 'là do các bệnh lây truyền qua đường tình dục (STIs) gây ra. Chúng lây lan chủ yếu qua quan hệ tình dục. STI là do vi khuẩn, vi rút hoặc ký sinh trùng gây ra. Nhiễm trùng lây truyền qua đường tình dục ', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe ngay lập tức nếu: Bạn đang hoạt động tình dục và có thể đã tiếp xúc với một bệnh lây truyền qua đường tình dục. Bạn có các triệu chứng của bệnh lây truyền qua ';
MERGE (n:Disease {id: 'D2671'}) SET n.id = 'D2671', n.name = 'Hội chứng Sezary', n.name_en = 'Sezary syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sezary-syndrome/symptoms-causes/syc-20594049', n.overview = 'là một loại ung thư hạch ảnh hưởng đến da và các bộ phận khác của cơ thể. Ung thư hạch là bệnh ung thư xảy ra trong hệ bạch huyết, một phần của hệ thống miễn dịch chống vi trùng của cơ thể. Hội chứng ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2672'}) SET n.id = 'D2672', n.name = 'Hội chứng trẻ bị lắc', n.name_en = 'Shaken baby syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/shaken-baby-syndrome/symptoms-causes/syc-20366619 | https://medlineplus.gov/ency/article/007578.htm', n.overview = 'là một chấn thương não nghiêm trọng do lắc mạnh trẻ sơ sinh hoặc trẻ mới biết đi. Nó còn được gọi là chấn thương đầu do lạm dụng, hội chứng rung lắc, chấn thương đầu hoặc hội chứng trẻ sơ sinh bị chấn', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu trẻ có bất kỳ dấu hiệu hoặc triệu chứng nào ở trên, bất kể chúng nhẹ hay nặng. Cũng hãy gọi nếu bạn cho rằng trẻ mắc hội chứng trẻ bị';
MERGE (n:Disease {id: 'D2673'}) SET n.id = 'D2673', n.name = 'Dầu gội - nuốt', n.name_en = 'Shampoo - swallowing', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002737.htm', n.prognosis = 'Dầu gội thường không độc. Hầu hết mọi người đều hồi phục hoàn toàn.';
MERGE (n:Disease {id: 'D2674'}) SET n.id = 'D2674', n.name = 'Ngộ độc kem cạo râu', n.name_en = 'Shaving cream poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002717.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào lượng kem cạo râu họ nuốt hoặc dính vào mắt và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Kem cạo râu không độc ';
MERGE (n:Disease {id: 'D2675'}) SET n.id = 'D2675', n.name = 'Hội chứng Sheehan', n.name_en = 'Sheehan syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001175.htm', n.prognosis = 'Triển vọng với việc chẩn đoán và điều trị sớm là rất tốt.';
MERGE (n:Disease {id: 'D2676'}) SET n.id = 'D2676', n.name = 'Ngộ độc shellac', n.name_en = 'Shellac poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002821.htm', n.prognosis = 'Isopropanol và metanol cực độc. Chỉ cần 2 thìa canh (14,8 ml) metanol có thể giết chết một đứa trẻ, trong khi từ 2 đến 8 ounce (59 đến 236 mL) có thể gây tử vong cho người lớn. Sức khoẻ của một người ';
MERGE (n:Disease {id: 'D2677'}) SET n.id = 'D2677', n.name = 'Dị ứng động vật có vỏ', n.name_en = 'Shellfish allergy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/shellfish-allergy/symptoms-causes/syc-20377503', n.overview = 'là một phản ứng không điển hình của hệ thống miễn dịch của cơ thể đối với protein ở một số động vật biển. Động vật biển thuộc nhóm động vật có vỏ bao gồm động vật giáp xác và động vật thân mềm. Ví dụ ', n.when_to_see = 'Hãy tìm cách điều trị khẩn cấp nếu bạn xuất hiện các dấu hiệu hoặc triệu chứng của sốc phản vệ. Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe hoặc chuyên gia về dị ứng nếu bạn có các triệu chứng dị ứ';
MERGE (n:Disease {id: 'D2678'}) SET n.id = 'D2678', n.name = 'Nhiễm Shigella', n.name_en = 'Shigella infection', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/shigella/symptoms-causes/syc-20377529', n.overview = 'là một căn bệnh ảnh hưởng đến đường ruột. Một tên khác cho nó là bệnh shigella. Nguyên nhân là do một nhóm vi trùng gọi là vi khuẩn shigella gây ra. Trẻ em dưới 5 tuổi có nhiều khả năng bị nhiễm khuẩn', n.when_to_see = 'Hãy gọi cho chuyên gia chăm sóc sức khỏe của bạn hoặc tìm kiếm sự chăm sóc khẩn cấp nếu bạn hoặc con bạn bị: Tiêu chảy ra máu. Tiêu chảy gây sụt cân và mất nước. Tiêu chảy kèm theo sốt từ 102 độ F (39';
MERGE (n:Disease {id: 'D2679'}) SET n.id = 'D2679', n.name = 'Bệnh Shigellosis', n.name_en = 'Shigellosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000295.htm', n.prognosis = 'Nhiễm trùng có thể nhẹ và tự khỏi. Hầu hết mọi người, ngoại trừ trẻ suy dinh dưỡng và những người có hệ miễn dịch yếu, thường hồi phục hoàn toàn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu tình trạng tiêu chảy không cải thiện, nếu có máu trong phân hoặc nếu có dấu hiệu mất nước. Hãy đến phòng cấp cứu nếu những triệu chứng này xảy ra ở ngư';
MERGE (n:Disease {id: 'D2680'}) SET n.id = 'D2680', n.name = 'Nẹp Shin', n.name_en = 'Shin splints', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/shin-splints/symptoms-causes/syc-20354105', n.overview = 'là tình trạng đau dọc theo xương ống chân, còn gọi là xương chày. Xương chày là xương lớn ở phía trước cẳng chân. Nẹp ống chân thường gặp ở các vận động viên chạy bộ, vũ công và quân nhân. Được biết đ', n.when_to_see = 'Hãy gọi cho chuyên gia chăm sóc sức khỏe của bạn nếu việc nghỉ ngơi, chườm đá và thuốc giảm đau mà bạn có thể mua mà không cần đơn thuốc không làm giảm cơn đau ống chân của bạn.';
MERGE (n:Disease {id: 'D2681'}) SET n.id = 'D2681', n.name = 'Bệnh zona', n.name_en = 'Shingles', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/shingles/symptoms-causes/syc-20353054 | https://medlineplus.gov/ency/article/000858.htm', n.overview = 'là một bệnh nhiễm virus gây phát ban đau đớn. Bệnh zona có thể xảy ra bất cứ nơi nào trên cơ thể bạn. Nó thường trông giống như một dải mụn nước bao quanh bên trái hoặc bên phải thân mình. Bệnh zona l', n.prognosis = 'Bệnh zona thường khỏi sau 2 đến 3 tuần và hiếm khi tái phát. Nếu vi-rút ảnh hưởng đến các dây thần kinh điều khiển chuyển động (dây thần kinh vận động), bạn có thể bị yếu hoặc tê liệt tạm thời hoặc vĩ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn càng sớm càng tốt nếu bạn nghi ngờ bệnh zona, đặc biệt trong các tình huống sau: Đau và phát ban xảy ra gần mắt. Nếu không được điều trị,';
MERGE (n:Disease {id: 'D2682'}) SET n.id = 'D2682', n.name = 'Sốc', n.name_en = 'Shock', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000039.htm', n.when_to_see = 'Hãy gọi 911 hoặc số khẩn cấp tại địa phương bất cứ khi nào một người có triệu chứng sốc. Ở bên cạnh người đó và làm theo các bước sơ cứu cho đến khi có trợ giúp y tế.';
MERGE (n:Disease {id: 'D2683'}) SET n.id = 'D2683', n.name = 'Hội chứng ruột ngắn', n.name_en = 'Short bowel syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/short-bowel-syndrome/symptoms-causes/syc-20355091 | https://medlineplus.gov/ency/article/000237.htm', n.overview = 'là tình trạng cơ thể không thể hấp thụ đủ chất dinh dưỡng từ thực phẩm do một phần ruột non bị thiếu hoặc bị tổn thương. Ruột non là nơi hầu hết các chất dinh dưỡng bạn ăn được hấp thụ vào cơ thể tron', n.prognosis = 'Tình trạng có thể cải thiện theo thời gian nếu là do phẫu thuật. Sự hấp thụ chất dinh dưỡng có thể dần dần trở nên tốt hơn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn xuất hiện các triệu chứng của hội chứng ruột ngắn, đặc biệt là sau khi bạn đã phẫu thuật ruột.';
MERGE (n:Disease {id: 'D2684'}) SET n.id = 'D2684', n.name = 'Tầm vóc thấp', n.name_en = 'Short stature', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003271.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu con bạn có vẻ thấp hơn nhiều so với hầu hết trẻ em cùng tuổi hoặc nếu chúng có vẻ đã ngừng phát triển.';
MERGE (n:Disease {id: 'D2685'}) SET n.id = 'D2685', n.name = 'Nội soi khớp vai', n.name_en = 'Shoulder arthroscopy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007206.htm', n.overview = 'Vòng bít xoay là một nhóm cơ và các gân của chúng tạo thành một vòng bít trên khớp vai. Những cơ và gân này giữ cánh tay ở khớp vai. Điều này cũng giúp vai di chuyển theo các hướng khác nhau. Các gân ', n.prognosis = 'thường ít đau và cứng khớp hơn, ít biến chứng hơn, thời gian nằm viện ngắn hơn (nếu có) và phục hồi nhanh hơn so với phẫu thuật mở. Nếu bạn đã phẫu thuật, cơ thể bạn cần thời gian để lành lại, ngay cả';
MERGE (n:Disease {id: 'D2686'}) SET n.id = 'D2686', n.name = 'Đau vai', n.name_en = 'Shoulder pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003171.htm', n.when_to_see = 'Đau vai trái đột ngột đôi khi có thể là dấu hiệu của cơn đau tim. Gọi 911 hoặc số điện thoại khẩn cấp tại địa phương nếu bạn bị áp lực đột ngột hoặc đau dữ dội ở vai, đặc biệt nếu cơn đau chạy từ ngực';
MERGE (n:Disease {id: 'D2687'}) SET n.id = 'D2687', n.name = 'Thay khớp vai', n.name_en = 'Shoulder replacement', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007387.htm', n.overview = 'Bạn sẽ được gây mê trước ca phẫu thuật này. Có thể sử dụng hai loại gây mê: Gây mê toàn thân, nghĩa là bạn sẽ bất tỉnh và không thể cảm thấy đau. Gây tê vùng để làm tê vùng cánh tay và vai của bạn để ', n.prognosis = 'Phẫu thuật thay khớp vai giúp giảm đau và cứng khớp cho hầu hết mọi người. Bạn sẽ có thể tiếp tục các hoạt động bình thường hàng ngày của mình mà không gặp nhiều vấn đề. Nhiều người có thể quay lại ch';
MERGE (n:Disease {id: 'D2688'}) SET n.id = 'D2688', n.name = 'Hội chứng bệnh xoang', n.name_en = 'Sick sinus syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/sick-sinus-syndrome/symptoms-causes/syc-20377554 | https://medlineplus.gov/ency/article/000161.htm', n.overview = 'là một loại rối loạn nhịp tim. Nó ảnh hưởng đến máy điều hòa nhịp tim tự nhiên của tim (nút xoang), cơ quan điều khiển nhịp tim. Hội chứng bệnh xoang gây ra nhịp tim chậm, tạm dừng (thời gian dài giữa', n.prognosis = 'Hội chứng thường tiến triển nhất. Điều này có nghĩa là nó trở nên tồi tệ hơn theo thời gian trong hầu hết các trường hợp. Triển vọng dài hạn là tuyệt vời cho những người được cấy ghép máy tạo nhịp tim', n.when_to_see = 'Hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ dấu hiệu hoặc triệu chứng nào của hội chứng bệnh xoang. Nhiều tình trạng bệnh lý có thể gây ra những vấn đề này. Điề';
MERGE (n:Disease {id: 'D2689'}) SET n.id = 'D2689', n.name = 'Bệnh thiếu máu hồng cầu hình liềm', n.name_en = 'Sickle cell anemia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sickle-cell-anemia/symptoms-causes/syc-20355876', n.overview = 'là một trong nhóm bệnh rối loạn di truyền được gọi là bệnh hồng cầu hình liềm. Nó ảnh hưởng đến hình dạng của các tế bào hồng cầu, mang oxy đến tất cả các bộ phận của cơ thể. Các tế bào hồng cầu thườn', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn ngay lập tức nếu bạn hoặc con bạn có các triệu chứng thiếu máu hồng cầu hình liềm, bao gồm sốt hoặc đột quỵ. Nhiễm trùng thường bắt đầu bằng sốt và có thể ';
MERGE (n:Disease {id: 'D2690'}) SET n.id = 'D2690', n.name = 'Bệnh hồng cầu hình liềm', n.name_en = 'Sickle cell disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000527.htm', n.prognosis = 'Trước đây, những người mắc bệnh hồng cầu hình liềm thường tử vong ở độ tuổi từ 20 đến 40. Nhờ chăm sóc hiện đại, hiện nay con người có thể sống đến 50 tuổi trở lên. Nguyên nhân tử vong bao gồm suy nội', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có: Bất kỳ triệu chứng nhiễm trùng nào (sốt, đau nhức cơ thể, nhức đầu, mệt mỏi) Các cơn đau Đau đớn và cương cứng lâu dài (ở nam giớ';
MERGE (n:Disease {id: 'D2691'}) SET n.id = 'D2691', n.name = 'Viêm tuyến giáp thầm lặng', n.name_en = 'Silent thyroiditis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000388.htm', n.prognosis = 'Viêm tuyến giáp thầm lặng thường tự khỏi trong vòng 1 năm. Giai đoạn cấp tính thường kết thúc trong vòng 3 tháng. Một số người phát triển bệnh suy giáp theo thời gian. Họ cần được điều trị bằng thuốc ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng của tình trạng này.';
MERGE (n:Disease {id: 'D2692'}) SET n.id = 'D2692', n.name = 'Bệnh bụi phổi silic', n.name_en = 'Silicosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000134.htm', n.prognosis = 'Kết quả khác nhau, tùy thuộc vào mức độ tổn thương ở phổi.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn nghi ngờ rằng mình đã tiếp xúc với silica tại nơi làm việc và bạn có vấn đề về hô hấp. Bị bệnh bụi phổi silic khiến bạn dễ bị nhiễm trùng phổi hơn. Nếu bạn';
MERGE (n:Disease {id: 'D2693'}) SET n.id = 'D2693', n.name = 'Hội chứng Silver-Russell', n.name_en = 'Silver-Russell syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001209.htm', n.prognosis = 'Trẻ lớn hơn và người lớn không biểu hiện các đặc điểm điển hình rõ ràng như trẻ sơ sinh hoặc trẻ nhỏ. Trí thông minh có thể bình thường, mặc dù người đó có thể bị khuyết tật về học tập. Có thể có dị t', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu có dấu hiệu SRS phát triển. Đảm bảo chiều cao và cân nặng của con bạn được đo trong mỗi lần khám sức khỏe cho trẻ. Nhà cung cấp d';
MERGE (n:Disease {id: 'D2694'}) SET n.id = 'D2694', n.name = 'Bướu cổ đơn giản', n.name_en = 'Simple goiter', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001178.htm', n.prognosis = 'Bướu cổ đơn giản có thể tự biến mất hoặc có thể trở nên to hơn. Theo thời gian, tuyến giáp có thể ngừng sản xuất đủ hormone tuyến giáp. Tình trạng này được gọi là suy giáp. Trong một số trường hợp, bư', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn thấy bất kỳ vết sưng nào ở phía trước cổ hoặc bất kỳ triệu chứng nào khác của bướu cổ.';
MERGE (n:Disease {id: 'D2695'}) SET n.id = 'D2695', n.name = 'Phẫu thuật cắt bỏ tuyến tiền liệt đơn giản', n.name_en = 'Simple prostatectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007416.htm', n.overview = 'Bạn sẽ được gây mê toàn thân (ngủ, không đau) hoặc gây tê tủy sống (an thần, tỉnh táo, không đau). Thủ tục mất khoảng 2 đến 4 giờ. Bác sĩ phẫu thuật sẽ thực hiện một vết cắt phẫu thuật ở bụng dưới của', n.prognosis = 'Nhiều nam giới hồi phục sau khoảng 6 tuần. Bạn có thể đi tiểu bình thường mà không bị rỉ nước tiểu.';
MERGE (n:Disease {id: 'D2696'}) SET n.id = 'D2696', n.name = 'Tăng bạch cầu ái toan đơn thuần ở phổi', n.name_en = 'Simple pulmonary eosinophilia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000105.htm', n.prognosis = 'Bệnh thường tự khỏi mà không cần điều trị. Nếu cần điều trị, phản ứng thường tốt. Tuy nhiên, bệnh có thể tái phát, đặc biệt nếu tình trạng bệnh không có nguyên nhân cụ thể và cần được điều trị bằng co', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng có thể liên quan đến chứng rối loạn này.';
MERGE (n:Disease {id: 'D2697'}) SET n.id = 'D2697', n.name = 'Một nếp nhăn ở lòng bàn tay', n.name_en = 'Single palmar crease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003290.htm';
MERGE (n:Disease {id: 'D2698'}) SET n.id = 'D2698', n.name = 'Đau đầu xoang', n.name_en = 'Sinus headaches', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sinus-headaches/symptoms-causes/syc-20377580', n.overview = 'là những cơn đau đầu có thể khiến bạn cảm thấy giống như bị nhiễm trùng xoang (viêm xoang). Bạn có thể cảm thấy áp lực xung quanh mắt, má và trán. Có lẽ đầu bạn nhức nhối. Tuy nhiên, cơn đau này thực ', n.when_to_see = 'Hãy tham khảo ý kiến ​​nhà cung cấp của bạn nếu: Các triệu chứng đau đầu của bạn xảy ra hơn 15 ngày một tháng hoặc cần dùng thuốc giảm đau thường xuyên có sẵn mà không cần đơn thuốc Bạn bị đau đầu dữ ';
MERGE (n:Disease {id: 'D2699'}) SET n.id = 'D2699', n.name = 'Viêm xoang', n.name_en = 'Sinusitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000647.htm', n.prognosis = 'Hầu hết các bệnh nhiễm trùng xoang đều có thể được chữa khỏi bằng các biện pháp tự chăm sóc và điều trị y tế. Nếu bạn bị các cơn tái phát nhiều lần, bạn nên kiểm tra các nguyên nhân như polyp mũi hoặc', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Các triệu chứng của bạn kéo dài hơn 10 đến 14 ngày hoặc bạn bị cảm lạnh nặng hơn sau 7 ngày. Bạn bị đau đầu dữ dội và không thuyên giảm khi dùng thuốc';
MERGE (n:Disease {id: 'D2700'}) SET n.id = 'D2700', n.name = 'Hội chứng Sjogren', n.name_en = 'Sjogren syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/sjogrens-syndrome/symptoms-causes/syc-20353216 | https://medlineplus.gov/ency/article/000456.htm', n.overview = 'Hội chứng Sjogren (SHOW-grin) là một tình trạng mãn tính đang diễn ra của hệ thống miễn dịch. Nó còn được gọi là bệnh Sjogren. Hai triệu chứng phổ biến nhất là khô mắt và khô miệng. Trong tình trạng t', n.prognosis = 'Căn bệnh này thường không đe dọa đến tính mạng. Kết quả phụ thuộc vào những bệnh khác mà bạn mắc phải. Có nguy cơ mắc bệnh ung thư hạch và tử vong sớm cao hơn khi hội chứng Sjögren hoạt động mạnh tron', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của hội chứng Sjögren.';
MERGE (n:Disease {id: 'D2701'}) SET n.id = 'D2701', n.name = 'Các bất thường về xương chân tay', n.name_en = 'Skeletal limb abnormalities', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003170.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ lo ngại nào về chiều dài hoặc hình dáng của chi.';
MERGE (n:Disease {id: 'D2702'}) SET n.id = 'D2702', n.name = 'Da - ẩm ướt', n.name_en = 'Skin - clammy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003216.htm', n.when_to_see = 'Tìm trợ giúp y tế ngay lập tức nếu người đó có bất kỳ dấu hiệu hoặc triệu chứng nào sau đây: Tình trạng y tế hoặc khả năng suy nghĩ bị thay đổi Đau ngực, bụng hoặc lưng hoặc khó chịu Đau đầu Đi ra máu';
MERGE (n:Disease {id: 'D2703'}) SET n.id = 'D2703', n.name = 'Áp xe da', n.name_en = 'Skin abscess', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000863.htm', n.prognosis = 'Hầu hết các bệnh áp xe da đều có thể chữa khỏi nếu điều trị đúng cách. Nhiễm trùng do MRSA gây ra đáp ứng với các loại kháng sinh cụ thể.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có bất kỳ dấu hiệu nhiễm trùng da nào, bao gồm: Chảy dịch dưới bất kỳ hình thức nào Sốt Đau Đỏ Sưng Liên hệ với nhà cung cấp của bạn ngay lập tức nếu b';
MERGE (n:Disease {id: 'D2704'}) SET n.id = 'D2704', n.name = 'Da đỏ bừng/đỏ bừng', n.name_en = 'Skin blushing/flushing', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003241.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị đỏ bừng liên tục, đặc biệt nếu bạn có các triệu chứng khác (chẳng hạn như tiêu chảy).';
MERGE (n:Disease {id: 'D2705'}) SET n.id = 'D2705', n.name = 'Ung thư da', n.name_en = 'Skin cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/skin-cancer/symptoms-causes/syc-20377605', n.overview = 'Khối u ác tính có hình dạng hoặc màu sắc. Khối u ác tính này có sự thay đổi màu sắc và đường viền không đều, cả hai đều là dấu hiệu cảnh báo khối u ác tính. Ung thư da là bệnh ung thư bắt đầu từ sự ph', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn nhận thấy bất kỳ thay đổi nào trên làn da khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. X';
MERGE (n:Disease {id: 'D2706'}) SET n.id = 'D2706', n.name = 'Chăm sóc da và chứng tiểu không tự chủ', n.name_en = 'Skin care and incontinence', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003976.htm', n.overview = 'Những người gặp khó khăn trong việc kiểm soát nước tiểu hoặc đại tiện (được gọi là chứng tiểu không tự chủ) có nguy cơ mắc các vấn đề về da. Các vùng da bị ảnh hưởng nhiều nhất là gần mông, hông, bộ p';
MERGE (n:Disease {id: 'D2707'}) SET n.id = 'D2707', n.name = 'Những dấu hiệu về da ở trẻ sơ sinh', n.name_en = 'Skin findings in newborns', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002301.htm', n.overview = 'Da của trẻ sơ sinh khỏe mạnh khi mới sinh có: Da màu đỏ đậm hoặc tím và bàn tay và bàn chân hơi xanh. Da sẫm màu trước khi trẻ sơ sinh trút hơi thở đầu tiên (khi trẻ cất tiếng khóc mạnh mẽ đầu tiên). ';
MERGE (n:Disease {id: 'D2708'}) SET n.id = 'D2708', n.name = 'Ghép da', n.name_en = 'Skin graft', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002982.htm', n.overview = 'Phẫu thuật này thường được thực hiện khi bạn đang được gây mê toàn thân. Điều đó có nghĩa là bạn sẽ ngủ và không bị đau. Làn da khỏe mạnh được lấy từ một nơi trên cơ thể bạn gọi là nơi hiến tặng. Hầu ', n.prognosis = 'Hầu hết các ca ghép da đều thành công, nhưng một số không lành lại. Bạn có thể cần các thủ tục bổ sung để có được kết quả mong muốn.';
MERGE (n:Disease {id: 'D2709'}) SET n.id = 'D2709', n.name = 'Tổn thương da do blastomycosis', n.name_en = 'Skin lesion of blastomycosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000865.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào dạng bệnh blastomycosis và hệ thống miễn dịch của bạn. Những người có hệ thống miễn dịch bị ức chế có thể cần điều trị lâu dài để ngăn ngừa các triệu chứng quay t', n.when_to_see = 'Một số vấn đề về da do bệnh blastomycosis có thể tương tự như các vấn đề về da do các bệnh khác gây ra. Hãy cho nhà cung cấp dịch vụ của bạn biết nếu bạn phát triển bất kỳ vấn đề đáng lo ngại nào về d';
MERGE (n:Disease {id: 'D2710'}) SET n.id = 'D2710', n.name = 'Loại bỏ tổn thương da', n.name_en = 'Skin lesion removal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007673.htm', n.overview = 'Hầu hết các quy trình loại bỏ tổn thương đều được thực hiện dễ dàng tại văn phòng của nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn hoặc văn phòng y tế ngoại trú. Bạn có thể cần gặp nhà cung cấp dịch', n.prognosis = 'Việc loại bỏ các tổn thương có tác dụng tốt đối với nhiều người. Một số tổn thương trên da, chẳng hạn như mụn cóc, có thể cần được điều trị nhiều lần.';
MERGE (n:Disease {id: 'D2711'}) SET n.id = 'D2711', n.name = 'Các khối u trên da', n.name_en = 'Skin lumps', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003279.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có cục u hoặc sưng tấy không rõ nguyên nhân.';
MERGE (n:Disease {id: 'D2712'}) SET n.id = 'D2712', n.name = 'Căng da', n.name_en = 'Skin turgor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003281.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Độ đàn hồi da kém xảy ra kèm theo nôn mửa, tiêu chảy hoặc sốt. Da rất chậm trở lại bình thường hoặc da “đóng lều” khi kiểm tra. Điều này có thể cho th';
MERGE (n:Disease {id: 'D2713'}) SET n.id = 'D2713', n.name = 'Các khối u nền sọ', n.name_en = 'Skull base tumors', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/skull-base-tumors/symptoms-causes/syc-20581941', n.overview = 'là những khối u hình thành ở vùng hộp sọ, ngay sau mắt và mũi, bên dưới não. Nền sọ là nơi các mạch máu và dây thần kinh quan trọng kết hợp với tủy sống. Nền sọ cũng ngăn cách não với cổ. Các khối u c', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2714'}) SET n.id = 'D2714', n.name = 'Gãy xương sọ', n.name_en = 'Skull fracture', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000060.htm', n.when_to_see = 'Nhà cung cấp sẽ thực hiện kiểm tra thể chất. Hệ thống thần kinh của người đó sẽ được kiểm tra. Có thể có những thay đổi về kích thước đồng tử, khả năng tư duy, sự phối hợp và phản xạ của người đó. Nhậ';
MERGE (n:Disease {id: 'D2715'}) SET n.id = 'D2715', n.name = 'Chứng ngưng thở khi ngủ', n.name_en = 'Sleep apnea', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sleep-apnea/symptoms-causes/syc-20377631', n.overview = 'là một tình trạng nghiêm trọng có thể khiến bạn ngừng thở và bắt đầu thở nhiều lần trong khi ngủ. Những người mắc bệnh này ngáy to và cảm thấy mệt mỏi ngay cả sau một đêm ngủ đủ giấc. Các loại ngưng t', n.when_to_see = 'Ngáy to có thể là dấu hiệu của một vấn đề tiềm ẩn nghiêm trọng, nhưng không phải ai mắc chứng ngưng thở khi ngủ cũng ngáy. Nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu bạn có triệu chứng ng';
MERGE (n:Disease {id: 'D2716'}) SET n.id = 'D2716', n.name = 'Rối loạn giấc ngủ', n.name_en = 'Sleep disorders', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/sleep-disorders/symptoms-causes/syc-20354018 | https://medlineplus.gov/ency/article/000800.htm', n.overview = 'là tình trạng làm thay đổi cách bạn ngủ. Nếu bạn bị rối loạn giấc ngủ, bạn có thể không ngủ đủ giấc hoặc không cảm thấy được nghỉ ngơi khi thức dậy. Bạn có thể rất buồn ngủ vào ban ngày. Bạn có thể có', n.when_to_see = 'Bất cứ ai cũng có thể thỉnh thoảng có một đêm khó ngủ. Nhưng hãy nói chuyện với bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn thường xuyên khó ngủ đủ giấc, nếu bạn không cảm thấy được nghỉ ngơ';
MERGE (n:Disease {id: 'D2717'}) SET n.id = 'D2717', n.name = 'Rối loạn giấc ngủ ở người lớn tuổi', n.name_en = 'Sleep disorders in older adults', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000064.htm', n.prognosis = 'Đối với hầu hết mọi người, giấc ngủ được cải thiện khi điều trị. Tuy nhiên, những người khác có thể tiếp tục bị gián đoạn giấc ngủ.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn để lấy hẹn nếu việc thiếu ngủ hoặc ngủ quá nhiều ảnh hưởng đến cuộc sống hàng ngày.';
MERGE (n:Disease {id: 'D2718'}) SET n.id = 'D2718', n.name = 'Chứng tê liệt khi ngủ', n.name_en = 'Sleep paralysis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000801.htm', n.when_to_see = 'Hãy thảo luận về tình trạng của bạn với nhà cung cấp dịch vụ nếu bạn bị bóng đè nhiều lần. Chúng có thể là do một vấn đề y tế cần được xét nghiệm thêm.';
MERGE (n:Disease {id: 'D2719'}) SET n.id = 'D2719', n.name = 'Nỗi kinh hoàng khi ngủ (nỗi kinh hoàng về đêm)', n.name_en = 'Sleep terrors (night terrors)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sleep-terrors/symptoms-causes/syc-20353524', n.overview = 'Nỗi kinh hoàng khi ngủ là những lúc la hét hoặc khóc, sợ hãi tột độ và đôi khi vẫy tay và chân khi chưa hoàn toàn tỉnh táo. Còn được gọi là nỗi kinh hoàng về đêm, nỗi kinh hoàng khi ngủ có thể dẫn đến', n.when_to_see = 'Đôi khi nỗi kinh hoàng khi ngủ thường không phải là nguyên nhân đáng lo ngại. Nếu con bạn mắc chứng sợ hãi khi ngủ, bạn có thể chỉ cần đề cập đến chúng khi khám sức khỏe định kỳ cho trẻ. Nhưng nếu bạn';
MERGE (n:Disease {id: 'D2720'}) SET n.id = 'D2720', n.name = 'Bệnh ngủ', n.name_en = 'Sleeping sickness', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001362.htm', n.prognosis = 'Nếu không điều trị, tử vong có thể xảy ra trong vòng 6 tháng do suy tim hoặc do T. b. rhodesiense bị nhiễm trùng. T.b. gambiense gây ra bệnh ngủ và nhanh chóng trở nên nặng hơn, thường trong vài tuần.', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ của bạn ngay nếu bạn có các triệu chứng, đặc biệt nếu bạn đã đi du lịch đến những nơi phổ biến bệnh. Điều quan trọng là phải bắt đầu điều trị càng sớm càng tốt.';
MERGE (n:Disease {id: 'D2721'}) SET n.id = 'D2721', n.name = 'Mộng du', n.name_en = 'Sleepwalking', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/sleepwalking/symptoms-causes/syc-20353506 | https://medlineplus.gov/ency/article/000808.htm', n.overview = ', còn được gọi là chứng mộng du, là tình trạng mọi người thức dậy và đi lại trong khi đang ngủ. Nó phổ biến ở trẻ em hơn người lớn. Trẻ em thường hết mộng du khi đến tuổi thiếu niên. Chứng mộng du thỉ', n.prognosis = 'Mộng du thường giảm dần khi trẻ lớn lên. Nó thường không biểu thị một rối loạn nghiêm trọng, mặc dù nó có thể là triệu chứng của các rối loạn khác. Việc người mộng du thực hiện các hoạt động nguy hiểm', n.when_to_see = 'Những cơn mộng du thỉnh thoảng không phải là nguyên nhân đáng lo ngại. Chúng thường tự biến mất. Bạn có thể chỉ cần đề cập đến chứng mộng du khi khám sức khỏe định kỳ hoặc khám sức khỏe cho trẻ. Hãy đ';
MERGE (n:Disease {id: 'D2722'}) SET n.id = 'D2722', n.name = 'Trượt đầu xương đùi', n.name_en = 'Slipped capital femoral epiphysis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000972.htm', n.prognosis = 'Kết quả điều trị thường tốt nhất. Trong một số ít trường hợp, khớp hông có thể bị mòn dù đã được chẩn đoán và điều trị kịp thời.', n.when_to_see = 'Nếu con bạn bị đau liên tục hoặc có các triệu chứng khác của chứng rối loạn này, hãy cho trẻ nằm xuống ngay và nằm yên cho đến khi bạn được trợ giúp y tế.';
MERGE (n:Disease {id: 'D2723'}) SET n.id = 'D2723', n.name = 'Hội chứng trượt xương sườn', n.name_en = 'Slipping rib syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007765.htm', n.prognosis = 'Cơn đau thường biến mất hoàn toàn theo thời gian, mặc dù cơn đau có thể trở nên mãn tính. Tiêm hoặc phẫu thuật có thể được yêu cầu trong một số trường hợp.', n.when_to_see = 'Bạn nên liên hệ ngay với nhà cung cấp dịch vụ của mình nếu bạn gặp: Chấn thương ở ngực Đau ở ngực dưới hoặc bụng trên Khó thở hoặc hụt ​​hơi Đau trong các hoạt động hàng ngày Gọi 911 hoặc số cấp cứu t';
MERGE (n:Disease {id: 'D2724'}) SET n.id = 'D2724', n.name = 'Vi khuẩn ruột non phát triển quá mức', n.name_en = 'Small bowel bacterial overgrowth', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000222.htm';
MERGE (n:Disease {id: 'D2725'}) SET n.id = 'D2725', n.name = 'Ung thư ruột non', n.name_en = 'Small bowel cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/small-bowel-cancer/symptoms-causes/syc-20352497', n.overview = 'Ruột non e của ruột non. Ruột non có ba phần - tá tràng, hỗng tràng và hồi tràng. Nó chạy từ dạ dày đến ruột già. Ung thư ruột non là một loại ung thư bắt đầu từ sự phát triển của các tế bào trong ruộ';
MERGE (n:Disease {id: 'D2726'}) SET n.id = 'D2726', n.name = 'Sa ruột non (enterocele)', n.name_en = 'Small bowel prolapse (enterocele)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/enterocele/symptoms-causes/syc-20377661', n.overview = 'sa ruột (enterocele) xảy ra khi các cơ và mô giữ ruột (ruột non) ở vị trí bên trong khoang chậu bị suy yếu, khiến ruột non tụt xuống và phình ra vào âm đạo. Sa ruột non, còn gọi là enterocele (EN-tur-', n.when_to_see = 'Hãy đi khám bác sĩ nếu bạn phát triển các dấu hiệu hoặc triệu chứng sa sút khiến bạn khó chịu. Yêu cầu một cuộc hẹn Có vấn đề với
