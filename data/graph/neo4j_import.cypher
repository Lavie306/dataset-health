MERGE (n:Disease {id: 'D1960'}) SET n.id = 'D1960', n.name = 'Bệnh Moyamoya', n.name_en = 'Moyamoya disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/moyamoya-disease/symptoms-causes/syc-20355586', n.overview = 'hẹp và thậm chí có thể đóng lại, dẫn đến giảm lượng máu giàu oxy đến não. Việc thiếu lưu lượng máu lên não có thể gây ra đột quỵ và các triệu chứng khác. Bệnh Moyamoya là một tình trạng mạch máu hiếm ', n.when_to_see = 'Tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn nhận thấy bất kỳ triệu chứng nào của đột quỵ hoặc đột quỵ nhỏ, ngay cả khi các triệu chứng đó dường như đến rồi đi hoặc biến mất. Để kiểm tra các dấu hiệ';
