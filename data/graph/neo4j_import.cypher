MERGE (n:Disease {id: 'D0621'}) SET n.id = 'D0621', n.name = 'Viêm túi mật mãn tính', n.name_en = 'Chronic cholecystitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000217.htm', n.prognosis = 'Cắt túi mật là một thủ thuật phổ biến với rủi ro thấp.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của viêm túi mật.';
MERGE (n:Disease {id: 'D0622'}) SET n.id = 'D0622', n.name = 'Ho mãn tính', n.name_en = 'Chronic cough', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/chronic-cough/symptoms-causes/syc-20351575', n.overview = 'Ho mãn tính là cơn ho kéo dài tám tuần hoặc lâu hơn ở người lớn hoặc bốn tuần ở trẻ em. Ho mãn tính không chỉ gây khó chịu. Nó có thể làm gián đoạn giấc ngủ của bạn và khiến bạn cảm thấy rất mệt mỏi. ', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe nếu bạn bị ho kéo dài nhiều tuần, đặc biệt là ho có đờm hoặc máu, làm rối loạn giấc ngủ hoặc ảnh hưởng đến việc học tập hoặc làm việc. Yêu cầu một cuộc hẹn Có ';
MERGE (n:Disease {id: 'D0623'}) SET n.id = 'D0623', n.name = 'Đau đầu mãn tính hàng ngày', n.name_en = 'Chronic daily headaches', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/chronic-daily-headaches/symptoms-causes/syc-20370891', n.overview = 'Hầu hết mọi người thỉnh thoảng bị đau đầu. Nhưng nếu bạn bị đau đầu nhiều ngày hơn thì bạn có thể bị đau đầu mãn tính hàng ngày. Thay vì một loại đau đầu cụ thể, đau đầu mãn tính hàng ngày bao gồm nhi', n.when_to_see = 'Đau đầu thường xuyên là phổ biến và thường không cần chăm sóc y tế. Tuy nhiên, hãy tham khảo ý kiến bác sĩ nếu: Bạn thường bị đau đầu từ hai lần trở lên mỗi tuần Bạn dùng thuốc giảm đau hầu hết các ng';
MERGE (n:Disease {id: 'D0624'}) SET n.id = 'D0624', n.name = 'Hội chứng khoang gắng sức mãn tính', n.name_en = 'Chronic exertional compartment syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/chronic-exertional-compartment-syndrome/symptoms-causes/syc-20350830', n.overview = 'là một tình trạng thần kinh và cơ do tập thể dục gây ra, gây đau, sưng tấy và đôi khi khiến các cơ bị ảnh hưởng ở chân hoặc cánh tay bị tàn tật. Bất cứ ai cũng có thể phát triển tình trạng này, nhưng ', n.when_to_see = 'Nếu bạn tái phát các cơn đau, sưng tấy, suy nhược, mất cảm giác hoặc đau nhức bất thường khi tập thể dục hoặc tham gia các hoạt động thể thao, hãy nói chuyện với bác sĩ. Đôi khi hội chứng khoang gắng ';
MERGE (n:Disease {id: 'D0625'}) SET n.id = 'D0625', n.name = 'Bệnh u hạt mãn tính', n.name_en = 'Chronic granulomatous disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/chronic-granulomatous-disease/symptoms-causes/syc-20355817 | https://medlineplus.gov/ency/article/001239.htm', n.overview = 'Bệnh u hạt mãn tính (gran-u-LOM-uh-tus) (CGD) là một tình trạng di truyền trong đó các tế bào bạch cầu chống nhiễm trùng không hoạt động bình thường. Những tế bào bạch cầu này được gọi là thực bào. Kh', n.prognosis = 'Phương pháp điều trị bằng kháng sinh dài hạn có thể giúp giảm nhiễm trùng, nhưng tử vong sớm có thể xảy ra do nhiễm trùng phổi tái phát.', n.when_to_see = 'Nếu bạn cho rằng mình hoặc con bạn mắc một loại bệnh viêm phổi do nấm do ở gần lá, lớp phủ hoặc cỏ khô chết, hãy đi chăm sóc y tế ngay lập tức. Nếu bạn hoặc con bạn thường xuyên bị nhiễm trùng và có c';
MERGE (n:Disease {id: 'D0626'}) SET n.id = 'D0626', n.name = 'Nổi mề đay mãn tính', n.name_en = 'Chronic hives', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/chronic-hives/symptoms-causes/syc-20352719', n.overview = 'Nổi mề đay, ngứa ngáy. Phát ban còn được gọi là mày đay. Phát ban - còn được gọi là nổi mề đay (ur-tih-KAR-e-uh) - là một phản ứng ở da gây ra các vết mẩn ngứa. Phát ban mãn tính là những vết sưng kéo', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn bị phát ban nặng hoặc nổi mề đay kéo dài hơn một vài ngày.';
MERGE (n:Disease {id: 'D0627'}) SET n.id = 'D0627', n.name = 'Bệnh đa dây thần kinh mất myelin do viêm mãn tính', n.name_en = 'Chronic inflammatory demyelinating polyneuropathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000777.htm', n.prognosis = 'Kết quả sẽ khác nhau. Rối loạn có thể tiếp tục lâu dài hoặc bạn có thể có các triệu chứng lặp đi lặp lại. Có thể phục hồi hoàn toàn nhưng mất chức năng thần kinh vĩnh viễn không phải là hiếm.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị mất vận động hoặc mất cảm giác ở bất kỳ vùng nào trên cơ thể, đặc biệt là nếu các triệu chứng của bạn trở nên tồi tệ hơn.';
MERGE (n:Disease {id: 'D0628'}) SET n.id = 'D0628', n.name = 'Bệnh thận mãn tính', n.name_en = 'Chronic kidney disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/chronic-kidney-disease/symptoms-causes/syc-20354521 | https://medlineplus.gov/ency/article/000471.htm', n.overview = 'Bệnh thận là gì? Chuyên gia giải thích Tìm hiểu thêm từ bác sĩ thận Andrew Bentall, M.D. Hiển thị bản ghi video Bệnh thận là gì? Một chuyên gia giải thích tôi là bác sĩ Andrew Bentall, bác sĩ thận tại', n.prognosis = 'Nhiều người không được chẩn đoán mắc bệnh CKD cho đến khi họ mất hầu hết chức năng thận. Không có cách chữa trị bệnh CKD. Liệu nó có trở nên trầm trọng hơn thành ESRD hay không và diễn biến nhanh như ', n.when_to_see = 'Nếu bạn có tình trạng sức khỏe liên tục làm tăng nguy cơ mắc bệnh thận, chuyên gia chăm sóc sức khỏe chính của bạn có thể muốn theo dõi sức khỏe thận của bạn. Bị huyết áp cao, tiểu đường hoặc bệnh tự ';
MERGE (n:Disease {id: 'D0629'}) SET n.id = 'D0629', n.name = 'Bệnh bạch cầu lymphocytic mãn tính', n.name_en = 'Chronic lymphocytic leukemia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/chronic-lymphocytic-leukemia/symptoms-causes/syc-20352428', n.overview = '(CLL) là một loại bệnh bạch cầu. Bệnh bạch cầu là bệnh ung thư ảnh hưởng đến máu và tủy xương. Tủy xương là mô xốp bên trong xương, nơi tạo ra các tế bào máu. Thuật ngữ "mãn tính" trong bệnh bạch cầu ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0630'}) SET n.id = 'D0630', n.name = 'Bệnh bạch cầu lymphocytic mãn tính (CLL)', n.name_en = 'Chronic lymphocytic leukemia (CLL)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000532.htm', n.prognosis = 'Nhà cung cấp dịch vụ của bạn có thể thảo luận với bạn về triển vọng của CLL dựa trên giai đoạn của nó và mức độ đáp ứng với điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn phát triển các hạch bạch huyết sưng to hoặc mệt mỏi không rõ nguyên nhân, bầm tím, đổ mồ hôi quá nhiều hoặc sụt cân.';
MERGE (n:Disease {id: 'D0631'}) SET n.id = 'D0631', n.name = 'Rối loạn máy giật cơ hoặc giọng nói mãn tính', n.name_en = 'Chronic motor or vocal tic disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000745.htm', n.prognosis = 'Trẻ em mắc chứng rối loạn này ở độ tuổi từ 6 đến 8 thường có kết quả rất tốt. Các triệu chứng có thể kéo dài từ 4 đến 6 năm và sau đó dừng lại ở tuổi thiếu niên mà không cần điều trị. Khi rối loạn bắt', n.when_to_see = 'Thông thường, bạn không cần phải đến gặp nhà cung cấp dịch vụ để phát hiện chứng giật trừ khi nó nghiêm trọng hoặc làm gián đoạn cuộc sống hàng ngày. Nếu bạn không thể biết liệu chuyển động của bạn ho';
MERGE (n:Disease {id: 'D0632'}) SET n.id = 'D0632', n.name = 'Bệnh bạch cầu tủy xương mãn tính', n.name_en = 'Chronic myelogenous leukemia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/chronic-myelogenous-leukemia/symptoms-causes/syc-20352417', n.overview = ', còn được gọi là CML , là một loại ung thư tủy xương hiếm gặp. Tủy xương là mô xốp bên trong xương, nơi tạo ra các tế bào máu. CML làm tăng số lượng tế bào bạch cầu trong máu. Thuật ngữ "mãn tính" tr', n.when_to_see = 'Hãy hẹn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ triệu chứng dai dẳng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0633'}) SET n.id = 'D0633', n.name = 'Bệnh bạch cầu tủy xương mãn tính (CML)', n.name_en = 'Chronic myelogenous leukemia (CML)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000570.htm', n.prognosis = 'Các loại thuốc nhắm mục tiêu, chẳng hạn như thuốc ức chế tyrosine kinase, đã cải thiện đáng kể triển vọng cho những người mắc CML. Hầu hết mọi người có thể duy trì tình trạng thuyên giảm, thường được ';
MERGE (n:Disease {id: 'D0634'}) SET n.id = 'D0634', n.name = 'Bệnh phổi tắc nghẽn mãn tính (COPD)', n.name_en = 'Chronic obstructive pulmonary disease (COPD)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000091.htm', n.prognosis = 'COPD là một bệnh mãn tính (mãn tính). Bệnh sẽ trở nặng nhanh hơn nếu bạn không ngừng hút thuốc. Nếu bạn bị COPD nặng, bạn sẽ khó thở khi thực hiện hầu hết các hoạt động. Bạn có thể phải nhập viện thườ', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn cảm thấy khó thở tăng nhanh.';
MERGE (n:Disease {id: 'D0635'}) SET n.id = 'D0635', n.name = 'Viêm tụy mãn tính', n.name_en = 'Chronic pancreatitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000221.htm', n.prognosis = 'Đây là một căn bệnh nghiêm trọng có thể dẫn đến tàn tật và tử vong. Bạn có thể giảm nguy cơ bằng cách tránh uống rượu.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn xuất hiện các triệu chứng của viêm tụy Bạn bị viêm tụy và các triệu chứng của bạn trở nên trầm trọng hơn hoặc không cải thiện khi điều trị';
MERGE (n:Disease {id: 'D0636'}) SET n.id = 'D0636', n.name = 'Đau vùng chậu mãn tính', n.name_en = 'Chronic pelvic pain', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/chronic-pelvic-pain/symptoms-causes/syc-20354368', n.overview = 'là cơn đau ở vùng dưới rốn và giữa hai hông kéo dài sáu tháng hoặc lâu hơn. Đau vùng chậu mãn tính có thể có nhiều nguyên nhân. Nó có thể là triệu chứng của một căn bệnh khác, hoặc nó có thể là một tì', n.when_to_see = 'Nói chung, hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn nếu cơn đau làm gián đoạn cuộc sống hàng ngày của bạn hoặc nếu các triệu chứng của bạn dường như trở nên tồi tệ hơn. Yêu cầu một cuộc hẹn Có';
MERGE (n:Disease {id: 'D0637'}) SET n.id = 'D0637', n.name = 'Viêm xoang mãn tính', n.name_en = 'Chronic sinusitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/chronic-sinusitis/symptoms-causes/syc-20351661', n.overview = 'polyp mũi hoặc sưng niêm mạc xoang có thể gây viêm xoang mãn tính. Các triệu chứng có thể bao gồm nghẹt mũi hoặc nghẹt mũi khiến khó thở bằng mũi, đau và sưng quanh mắt, má, mũi hoặc trán. Viêm xoang ', n.when_to_see = 'Yêu cầu một cuộc hẹn Chẩn đoán & điều trị Ngày 19 tháng 9 năm 2023 In Hiển thị tài liệu tham khảo Ferri FF. Viêm xoang. Trong: Cố vấn lâm sàng của Ferri 2023. Elsevier; 2023. Truy cập ngày 2 tháng 2 n';
MERGE (n:Disease {id: 'D0638'}) SET n.id = 'D0638', n.name = 'Tụ máu dưới màng cứng mãn tính', n.name_en = 'Chronic subdural hematoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000781.htm', n.prognosis = 'Các khối máu tụ dưới màng cứng mãn tính gây ra các triệu chứng thường không tự lành theo thời gian. Họ thường phải phẫu thuật, đặc biệt khi có vấn đề về thần kinh, co giật hoặc đau đầu mãn tính.', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu bạn hoặc thành viên gia đình có triệu chứng tụ máu dưới màng cứng mãn tính. Ví dụ: nếu bạn thấy các triệu chứng lú lẫn, suy nhược hoặc tê vài tuần';
MERGE (n:Disease {id: 'D0639'}) SET n.id = 'D0639', n.name = 'Viêm tuyến giáp mãn tính (bệnh Hashimoto)', n.name_en = 'Chronic thyroiditis (Hashimoto disease)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000371.htm', n.prognosis = 'Bệnh ổn định nhiều năm. Nếu nó tiến triển chậm đến thiếu hụt hormone tuyến giáp (suy giáp), nó có thể được điều trị bằng liệu pháp thay thế hormone.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của bệnh viêm tuyến giáp mãn tính hoặc suy giáp.';
MERGE (n:Disease {id: 'D0640'}) SET n.id = 'D0640', n.name = 'Bệnh não chấn thương mãn tính', n.name_en = 'Chronic traumatic encephalopathy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/chronic-traumatic-encephalopathy/symptoms-causes/syc-20370921', n.overview = ', còn được gọi là CTE, là một bệnh về não có thể do chấn thương đầu nhiều lần. Nó gây ra cái chết của các tế bào thần kinh trong não, được gọi là thoái hóa. CTE trở nên tồi tệ hơn theo thời gian. Cách', n.when_to_see = 'CTE được cho là phát triển trong nhiều năm sau những chấn thương não lặp đi lặp lại, có thể nhẹ hoặc nặng. Hãy gặp chuyên gia chăm sóc sức khỏe của bạn trong những tình huống sau: Ý nghĩ tự tử. Nghiên';
MERGE (n:Disease {id: 'D0641'}) SET n.id = 'D0641', n.name = 'Hội chứng Churg-Strauss', n.name_en = 'Churg-Strauss syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/churg-strauss-syndrome/symptoms-causes/syc-20353760', n.overview = 'Bệnh u hạt bạch cầu ái toan kèm viêm đa mạch, gọi tắt là EGPA, là một tình trạng hiếm gặp gây viêm ở các mạch máu cỡ nhỏ đến trung bình. Tình trạng viêm này có thể làm giảm lưu lượng máu đến các cơ qu', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị hen suyễn hoặc dị ứng mũi đột nhiên trở nên trầm trọng hơn. Hãy đến gặp chuyên gia chăm sóc sức khỏe nếu bạn bị khó thở hoặc sổ mũi không khỏi, ';
MERGE (n:Disease {id: 'D0642'}) SET n.id = 'D0642', n.name = 'Hội chứng Chylomicronemia', n.name_en = 'Chylomicronemia syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000405.htm', n.prognosis = 'Chế độ ăn ít chất béo có thể làm giảm các triệu chứng một cách đáng kể.', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế ngay nếu bạn bị đau bụng hoặc các dấu hiệu cảnh báo khác của viêm tụy. Liên hệ với nhà cung cấp của bạn nếu bạn có tiền sử cá nhân hoặc gia đình có mức chất béo trung tín';
MERGE (n:Disease {id: 'D0643'}) SET n.id = 'D0643', n.name = 'Cắt bao quy đầu', n.name_en = 'Circumcision', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002998.htm', n.overview = 'Nhà cung cấp dịch vụ chăm sóc sức khỏe thường sẽ làm tê dương vật bằng gây tê cục bộ trước khi thủ thuật bắt đầu. Thuốc gây tê có thể được tiêm vào gốc dương vật, trong trục hoặc bôi dưới dạng kem. Có', n.prognosis = 'Cắt bao quy đầu được coi là một thủ thuật rất an toàn cho cả trẻ sơ sinh và trẻ lớn.';
MERGE (n:Disease {id: 'D0644'}) SET n.id = 'D0644', n.name = 'Xơ gan', n.name_en = 'Cirrhosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cirrhosis/symptoms-causes/syc-20351487 | https://medlineplus.gov/ency/article/000255.htm', n.overview = 'Xơ gan là gì? Chuyên gia của Mayo Clinic giải thích Tìm hiểu thêm về bệnh xơ gan từ bác sĩ chuyên khoa gan cấy ghép Sumera Ilyas, M.B.B.S. Hiển thị bản ghi cho video Xơ gan là gì? Chuyên gia của Mayo ', n.prognosis = 'Xơ gan là do gan bị sẹo. Trong hầu hết các trường hợp, gan không thể lành hoặc trở lại chức năng bình thường một khi tổn thương nghiêm trọng. Xơ gan có thể dẫn đến các biến chứng nghiêm trọng.', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào đã nêu ở trên. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin được đánh ';
MERGE (n:Disease {id: 'D0645'}) SET n.id = 'D0645', n.name = 'Đau cách hồi', n.name_en = 'Claudication', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/claudication/symptoms-causes/syc-20370952', n.overview = 'là cơn đau do lưu lượng máu đến cơ quá ít trong khi tập luyện. Thông thường, cơn đau xảy ra ở chân sau khi đi bộ với tốc độ nhất định và trong một khoảng thời gian nhất định. Nhưng nó phụ thuộc vào lư', n.when_to_see = 'Hãy nói chuyện với thành viên trong nhóm chăm sóc của bạn nếu bạn bị đau ở chân hoặc tay khi tập thể dục. Đau cách hồi có thể dẫn đến một chu kỳ làm sức khỏe tim và mạch máu xấu đi. Ví dụ, cơn đau có ';
MERGE (n:Disease {id: 'D0646'}) SET n.id = 'D0646', n.name = 'Bàn chân có móng vuốt', n.name_en = 'Claw foot', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003168.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn cho rằng mình có thể bị móng vuốt.';
MERGE (n:Disease {id: 'D0647'}) SET n.id = 'D0647', n.name = 'Bàn tay có móng vuốt', n.name_en = 'Claw hand', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003169.htm', n.when_to_see = 'Nếu tình trạng này là bẩm sinh, nó thường được chẩn đoán khi sinh. Nếu bạn nhận thấy bàn tay có móng vuốt đang phát triển, hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn.';
MERGE (n:Disease {id: 'D0648'}) SET n.id = 'D0648', n.name = 'Sứt môi và hở hàm ếch', n.name_en = 'Cleft lip and cleft palate', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cleft-palate/symptoms-causes/syc-20370985', n.overview = 'Sứt môi không hoàn toàn khi thai nhi đang phát triển trong bụng mẹ. Sứt môi có thể chỉ xảy ra ở một bên (một bên) hoặc cả hai bên (song phương). Trẻ bị sứt môi cũng có thể bị sứt môi ở vòm miệng gọi l', n.when_to_see = 'Sứt môi, hở hàm ếch có thể được phát hiện khi mới sinh hoặc có thể phát hiện trên siêu âm trước khi sinh. Chuyên gia chăm sóc sức khỏe của bạn có thể bắt đầu điều phối việc chăm sóc vào thời điểm đó. ';
MERGE (n:Disease {id: 'D0649'}) SET n.id = 'D0649', n.name = 'Sửa sứt môi và hở hàm ếch', n.name_en = 'Cleft lip and palate repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002979.htm', n.overview = 'Sứt môi là một dị tật bẩm sinh: Sứt môi có thể chỉ là một vết khía nhỏ trên môi. Nó cũng có thể là một vết nứt hoàn toàn ở môi kéo dài đến tận gốc mũi. Hở hàm ếch có thể ở một hoặc cả hai bên vòm miện', n.prognosis = 'Hầu hết trẻ sơ sinh đều lành bệnh mà không gặp vấn đề gì. Con bạn sẽ chăm sóc như thế nào sau khi vết thương lành lại thường phụ thuộc vào mức độ nghiêm trọng của khiếm khuyết đó. Con bạn có thể cần m';
MERGE (n:Disease {id: 'D0650'}) SET n.id = 'D0650', n.name = 'Chứng loạn dưỡng xương sọ', n.name_en = 'Cleidocranial dysostosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001589.htm', n.prognosis = 'Trong hầu hết các trường hợp, các triệu chứng về xương gây ra một số vấn đề. Chăm sóc răng miệng thích hợp là quan trọng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Tiền sử gia đình mắc chứng loạn dưỡng xương sọ và đang có kế hoạch sinh con. Trẻ có triệu chứng tương tự.';
MERGE (n:Disease {id: 'D0651'}) SET n.id = 'D0651', n.name = 'Ngộ độc thuốc nhuộm vải', n.name_en = 'Cloth dye poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002784.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Người đó nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nếu ngộ độc liên quan đến chất';
MERGE (n:Disease {id: 'D0652'}) SET n.id = 'D0652', n.name = 'Giác mạc đục', n.name_en = 'Cloudy cornea', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003317.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bề mặt bên ngoài của mắt bạn có mây. Bạn có vấn đề với tầm nhìn của bạn. Lưu ý: Bạn sẽ cần gặp bác sĩ nhãn khoa (bác sĩ nhãn khoa) để biết các vấn đề ';
MERGE (n:Disease {id: 'D0653'}) SET n.id = 'D0653', n.name = 'Ngón tay hoặc ngón chân dùi trống', n.name_en = 'Clubbing of the fingers or toes', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003282.htm', n.when_to_see = 'Nếu bạn nhận thấy việc đánh dùi cui, hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn.';
MERGE (n:Disease {id: 'D0654'}) SET n.id = 'D0654', n.name = 'Bàn chân khoèo', n.name_en = 'Clubfoot', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/clubfoot/symptoms-causes/syc-20350860 | https://medlineplus.gov/ency/article/001228.htm', n.overview = 'o, vòm bàn chân có thể được nâng lên và gót chân quay vào trong. Bàn chân thường được cố định ở vị trí này. Nếu không điều trị, trẻ có thể đi bằng một bên hoặc phía trên bàn chân. Bàn chân khoèo mô tả', n.prognosis = 'Kết quả điều trị thường tốt.', n.when_to_see = 'Nếu con bạn đang được điều trị bàn chân khoèo, hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Các ngón chân sưng lên, chảy máu hoặc đổi màu khi được bó bột. Bột bó bột có vẻ gây đau đớn nhiều Các n';
MERGE (n:Disease {id: 'D0655'}) SET n.id = 'D0655', n.name = 'Sửa chữa bàn chân khoèo', n.name_en = 'Clubfoot repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002964.htm', n.overview = 'Loại phẫu thuật được thực hiện tùy thuộc vào: Mức độ nghiêm trọng của bàn chân khoèo Tuổi của con bạn Những phương pháp điều trị nào khác mà con bạn đã thực hiện Con bạn sẽ được gây mê toàn thân (ngủ ', n.prognosis = 'Sau khi hồi phục sau phẫu thuật, bàn chân của con bạn sẽ ở vị trí tốt hơn rất nhiều. Con bạn sẽ có thể có một cuộc sống bình thường, năng động, bao gồm cả việc chơi thể thao. Nhưng bàn chân có thể cứn';
MERGE (n:Disease {id: 'D0656'}) SET n.id = 'D0656', n.name = 'Đau đầu từng cụm', n.name_en = 'Cluster headache', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cluster-headache/symptoms-causes/syc-20352080 | https://medlineplus.gov/ency/article/000786.htm', n.overview = 'là một loại đau đầu hiếm gặp và nghiêm trọng, gây đau dữ dội ở một bên đầu hoặc xung quanh mắt. Đây thường là loại đau đầu đau đớn nhất. Bạn có thể bị đau đầu nhiều lần trong thời gian ngắn. Điều này ', n.prognosis = 'Đau đầu từng cơn không đe dọa đến tính mạng. Chúng thường không gây ra những thay đổi vĩnh viễn cho não. Nhưng chúng diễn ra lâu dài (mãn tính) và thường gây đau đớn đến mức ảnh hưởng đến công việc và', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe nếu bạn mới bắt đầu bị đau đầu từng cơn. Nhóm chăm sóc của bạn có thể loại trừ các bệnh khác và đề xuất phương pháp điều trị. Ngay cả cơn đau đầu dữ dội cũng k';
MERGE (n:Disease {id: 'D0657'}) SET n.id = 'D0657', n.name = 'CMV - viêm dạ dày ruột/viêm đại tràng', n.name_en = 'CMV - gastroenteritis/colitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000667.htm', n.prognosis = 'Ở những người có hệ thống miễn dịch khỏe mạnh, trong hầu hết các trường hợp, các triệu chứng sẽ biến mất mà không cần điều trị. Các triệu chứng nghiêm trọng hơn ở những người có hệ miễn dịch suy yếu. ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của viêm dạ dày ruột/viêm đại tràng CMV.';
MERGE (n:Disease {id: 'D0658'}) SET n.id = 'D0658', n.name = 'Viêm phổi do CMV', n.name_en = 'CMV pneumonia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000664.htm', n.prognosis = 'Thuốc kháng vi-rút ngăn vi-rút tự sao chép nhưng không tiêu diệt vi-rút. CMV ức chế hệ thống miễn dịch và có thể làm tăng nguy cơ mắc các bệnh nhiễm trùng khác. Nồng độ oxy trong máu thấp ở người bị v', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng viêm phổi do CMV.';
MERGE (n:Disease {id: 'D0659'}) SET n.id = 'D0659', n.name = 'Viêm võng mạc CMV', n.name_en = 'CMV retinitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000665.htm', n.prognosis = 'Ngay cả khi được điều trị, bệnh vẫn có thể trở nặng đến mức mù lòa. Sự tiến triển này có thể xảy ra do vi-rút trở nên kháng thuốc kháng vi-rút nên thuốc không còn hiệu quả hoặc do hệ thống miễn dịch c', n.when_to_see = 'Nếu các triệu chứng trở nên trầm trọng hơn hoặc không cải thiện khi điều trị hoặc nếu các triệu chứng mới phát triển, hãy liên hệ với nhà cung cấp của bạn. Những người nhiễm HIV/AIDS (đặc biệt là nhữn';
MERGE (n:Disease {id: 'D0660'}) SET n.id = 'D0660', n.name = 'Bệnh bụi phổi của công nhân than', n.name_en = 'Coal worker\'s pneumoconiosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000130.htm', n.prognosis = 'Kết quả của hình thức đơn giản thường tốt. Nó hiếm khi gây tàn tật hoặc tử vong. Dạng phức tạp có thể gây khó thở và trầm trọng hơn theo thời gian.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn bị ho, khó thở, sốt hoặc các dấu hiệu khác của nhiễm trùng phổi, đặc biệt nếu bạn cho rằng mình bị cúm. Vì phổi của bạn đã bị tổn thương nên v';
MERGE (n:Disease {id: 'D0661'}) SET n.id = 'D0661', n.name = 'Hẹp eo động mạch chủ', n.name_en = 'Coarctation of the aorta', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/coarctation-of-the-aorta/symptoms-causes/syc-20352529 | https://medlineplus.gov/ency/article/000191.htm', n.overview = 'bị thu hẹp ở một phần động mạch chính của cơ thể, được gọi là động mạch chủ. Tim phải bơm mạnh hơn để đưa máu qua động mạch chủ và đến phần còn lại của cơ thể. Hẹp eo động mạch chủ (ko-ahrk-TAY-shun) ', n.prognosis = 'Hẹp eo động mạch chủ có thể chữa khỏi bằng phẫu thuật. Các triệu chứng nhanh chóng thuyên giảm sau phẫu thuật. Tuy nhiên, nguy cơ tử vong do các vấn đề về tim tăng lên ở những người đã được phẫu thuật', n.when_to_see = 'Nhận trợ giúp y tế ngay lập tức nếu có bất kỳ cơn đau ngực dữ dội nào hoặc không thể giải thích được. Đồng thời nhận trợ giúp y tế cho các triệu chứng sau: Ngất xỉu. Khó thở đột ngột. Huyết áp cao khô';
MERGE (n:Disease {id: 'D0662'}) SET n.id = 'D0662', n.name = 'Ngộ độc coban', n.name_en = 'Cobalt poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002495.htm', n.prognosis = 'Những người bị bệnh do tiếp xúc với một lượng lớn coban trong một lần thường hồi phục và không có biến chứng lâu dài. Các triệu chứng và vấn đề liên quan đến ngộ độc coban lâu dài hiếm khi hồi phục đư';
MERGE (n:Disease {id: 'D0663'}) SET n.id = 'D0663', n.name = 'Ngộ độc cocaine', n.name_en = 'Cocaine intoxication', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000946.htm', n.prognosis = 'Triển vọng phụ thuộc vào lượng cocaine được sử dụng và cơ quan nào bị ảnh hưởng. Tổn thương vĩnh viễn có thể xảy ra, có thể gây ra: Động kinh, đột quỵ và liệt Lo lắng mãn tính và rối loạn tâm thần (rố';
MERGE (n:Disease {id: 'D0664'}) SET n.id = 'D0664', n.name = 'Cai cocaine', n.name_en = 'Cocaine withdrawal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000947.htm', n.prognosis = 'Nghiện cocaine rất khó điều trị và có thể tái phát. Việc điều trị nên bắt đầu với lựa chọn ít hạn chế nhất. Chăm sóc ngoại trú cũng hiệu quả như chăm sóc nội trú đối với hầu hết mọi người. Việc cai co', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn sử dụng cocaine và cần trợ giúp để ngừng sử dụng nó. Nếu bạn hoặc ai đó bạn biết đang nghĩ đến việc tự tử, hãy gọi điện hoặc nhắn';
MERGE (n:Disease {id: 'D0665'}) SET n.id = 'D0665', n.name = 'Cấy ốc tai điện tử', n.name_en = 'Cochlear implant', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007203.htm', n.overview = 'Cấy ốc tai điện tử không giống như máy trợ thính. Nó được cấy ghép bằng phẫu thuật và hoạt động theo một cách khác. Có nhiều loại cấy ốc tai điện tử khác nhau. Tuy nhiên, chúng thường được tạo thành t';
MERGE (n:Disease {id: 'D0666'}) SET n.id = 'D0666', n.name = 'Quá liều codeine', n.name_en = 'Codeine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002613.htm', n.prognosis = 'Codeine thường được kết hợp với các loại thuốc khác, chẳng hạn như acetaminophen. Vì vậy, tác dụng có hại của các loại thuốc khác cũng phải được điều trị. Có thể bị sốc, viêm phổi nặng, tổn thương não';
MERGE (n:Disease {id: 'D0667'}) SET n.id = 'D0667', n.name = 'Không dung nạp lạnh', n.name_en = 'Cold intolerance', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003095.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn không dung nạp lạnh lâu dài hoặc quá mức.';
MERGE (n:Disease {id: 'D0668'}) SET n.id = 'D0668', n.name = 'Vết loét lạnh', n.name_en = 'Cold sore', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cold-sore/symptoms-causes/syc-20371017', n.overview = 'là một cụm mụn nước chứa đầy chất lỏng. Quá trình lành vết thương thường xảy ra sau hai đến ba tuần mà không để lại sẹo. Vết loét lạnh đôi khi được gọi là mụn nước sốt. Các vết loét lạnh, hoặc mụn nướ', n.when_to_see = 'Vết loét lạnh thường tự khỏi mà không cần điều trị. Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn có hệ thống miễn dịch yếu. Các vết loét lạnh không lành trong vòng hai tuần. Các tri';
MERGE (n:Disease {id: 'D0669'}) SET n.id = 'D0669', n.name = 'Nổi mề đay lạnh', n.name_en = 'Cold urticaria', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cold-urticaria/symptoms-causes/syc-20371046', n.overview = '(ur-tih-KAR-e-uh) là một phản ứng xuất hiện trong vòng vài phút sau khi da tiếp xúc với lạnh. Các vết mẩn ngứa, còn gọi là phát ban, phát sinh trên vùng da bị ảnh hưởng. Các triệu chứng ở người bị nổi', n.when_to_see = 'Nếu bạn có phản ứng trên da sau khi tiếp xúc với nhiệt độ lạnh, hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn. Ngay cả khi các phản ứng nhẹ, chuyên gia chăm sóc sức khỏe của bạn sẽ muốn loại trừ cá';
MERGE (n:Disease {id: 'D0670'}) SET n.id = 'D0670', n.name = 'Ngộ độc kem dưỡng da sóng lạnh', n.name_en = 'Cold wave lotion poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002693.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào hoặc tiếp xúc và tốc độ điều trị được tiếp nhận như thế nào. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Các vấn đề về da sẽ ';
MERGE (n:Disease {id: 'D0671'}) SET n.id = 'D0671', n.name = 'Cảm lạnh và cúm – kháng sinh', n.name_en = 'Colds and flu – antibiotics', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002070.htm', n.overview = 'Thuốc kháng sinh chống lại các bệnh nhiễm trùng do vi khuẩn gây ra. Họ không điều trị các bệnh nhiễm trùng do virus gây ra. Cảm lạnh và cúm là do virus gây ra. Nếu bạn bị nhiễm virus, thuốc kháng sinh';
MERGE (n:Disease {id: 'D0672'}) SET n.id = 'D0672', n.name = 'Viêm đại tràng', n.name_en = 'Colitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001125.htm', n.prognosis = 'Triển vọng phụ thuộc vào nguyên nhân của sự cố. Bệnh Crohn là một bệnh mãn tính không có cách chữa trị nhưng có thể kiểm soát được. Các tác nhân sinh học rất hiệu quả trong việc kiểm soát các triệu ch', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn có các triệu chứng như: Đau bụng không thuyên giảm Máu trong phân hoặc phân có màu đen Tiêu chảy hoặc nôn mửa không hết Sưng bụng';
MERGE (n:Disease {id: 'D0673'}) SET n.id = 'D0673', n.name = 'Xẹp phổi (tràn khí màng phổi)', n.name_en = 'Collapsed lung (pneumothorax)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000087.htm', n.prognosis = 'Nếu bạn bị xẹp phổi tự phát, bạn có nhiều khả năng sẽ bị xẹp phổi khác trong tương lai nếu bạn: Cao và gầy Tiếp tục hút thuốc Đã từng bị xẹp phổi hai lần trong quá khứ Bạn khỏe như thế nào sau khi bị ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng xẹp phổi, đặc biệt nếu bạn đã từng mắc bệnh này trước đây.';
MERGE (n:Disease {id: 'D0674'}) SET n.id = 'D0674', n.name = 'Sinh viên đại học và bệnh cúm', n.name_en = 'College students and the flu', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007446.htm', n.overview = 'CÁC TRIỆU CHỨNG CỦA CÚM LÀ GÌ? Một sinh viên đại học bị cúm thường sẽ bị sốt từ 100°F (37,8°C) trở lên và đau họng hoặc ho. Các triệu chứng khác có thể bao gồm: Ớn lạnh Tiêu chảy Mệt mỏi Đau đầu Chảy ';
MERGE (n:Disease {id: 'D0675'}) SET n.id = 'D0675', n.name = 'Coloboma của mống mắt', n.name_en = 'Coloboma of the iris', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003318.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu: Bạn nhận thấy con mình có một cái gì đó giống như một lỗ trên mống mắt hoặc đồng tử có hình dạng bất thường. Tầm nhìn của con bạ';
MERGE (n:Disease {id: 'D0676'}) SET n.id = 'D0676', n.name = 'Ngộ độc nước hoa', n.name_en = 'Cologne poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002694.htm', n.prognosis = 'Sức khoẻ của một người phụ thuộc vào lượng nước hoa nuốt vào và tốc độ điều trị được tiếp nhận như thế nào. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Ngộ độc nước hoa có thể khiến một ';
MERGE (n:Disease {id: 'D0677'}) SET n.id = 'D0677', n.name = 'Ung thư đại tràng', n.name_en = 'Colon cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/colon-cancer/symptoms-causes/syc-20353669', n.overview = 'xam toàn bộ đại tràng sử dụng ống dài, linh hoạt có gắn camera là một cách để phát hiện ung thư đại tràng và polyp. Kỳ thi này được gọi là nội soi. Ung thư ruột kết là sự phát triển của các tế bào bắt', n.when_to_see = 'Nếu bạn nhận thấy các triệu chứng kéo dài khiến bạn lo lắng, hãy đặt lịch hẹn với chuyên gia chăm sóc sức khỏe. Yêu cầu một cuộc hẹn Khi nào cần gặp bác sĩ Nếu bạn có các triệu chứng khiến bạn lo lắng';
MERGE (n:Disease {id: 'D0678'}) SET n.id = 'D0678', n.name = 'Sàng lọc ung thư ruột kết', n.name_en = 'Colon cancer screening', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002071.htm', n.overview = 'XÉT NGHIỆM SÀNG LỌC Có một số cách để sàng lọc ung thư ruột kết. Xét nghiệm phân: Polyp ở đại tràng và ung thư nhỏ có thể gây chảy máu một lượng nhỏ mà không thể nhìn thấy bằng mắt thường. Nhưng máu t';
MERGE (n:Disease {id: 'D0679'}) SET n.id = 'D0679', n.name = 'Polyp đại tràng', n.name_en = 'Colon polyps', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/colon-polyps/symptoms-causes/syc-20352875', n.overview = 'Polyp đại tràng là một khối tế bào nhỏ hình thành trên niêm mạc đại tràng. Hầu hết các polyp đại tràng đều vô hại. Nhưng theo thời gian, một số polyp đại tràng có thể biến thành ung thư đại trực tràng', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn bị: Đau bụng. Máu trong phân. Thay đổi thói quen đại tiện kéo dài hơn một tuần. Giảm cân xảy ra mà không cần cố gắng. Bạn nên được kiểm tra ung thư đại trự';
MERGE (n:Disease {id: 'D0680'}) SET n.id = 'D0680', n.name = 'Bệnh mù màu', n.name_en = 'Color blindness', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/color-blindness/symptoms-causes/syc-20354988 | https://medlineplus.gov/ency/article/001002.htm', n.overview = 'Giải phẫu của mắt e có đường kính khoảng 1 inch (2,5 cm). Nó nhận được hàng triệu thông tin về thế giới bên ngoài, được bộ não của bạn xử lý nhanh chóng. Bệnh mù màu là tình trạng mắt mà một người khô', n.prognosis = 'Mù màu là bệnh kéo dài suốt đời. Hầu hết mọi người đều có thể thích nghi với nó.', n.when_to_see = 'Nếu bạn nghi ngờ mình có vấn đề khi phân biệt một số màu nhất định hoặc khả năng nhìn màu của bạn thay đổi, hãy đến gặp bác sĩ nhãn khoa để kiểm tra. Điều quan trọng là trẻ em phải được khám mắt toàn ';
MERGE (n:Disease {id: 'D0681'}) SET n.id = 'D0681', n.name = 'Sốt ve Colorado', n.name_en = 'Colorado tick fever', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000675.htm', n.prognosis = 'CTF thường tự biến mất và không nguy hiểm.';
MERGE (n:Disease {id: 'D0682'}) SET n.id = 'D0682', n.name = 'Ung thư đại trực tràng', n.name_en = 'Colorectal cancer', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000262.htm', n.prognosis = 'Khi điều trị, các bệnh ung thư ở giai đoạn 0, I, II và III thường được chữa khỏi, mặc dù các giai đoạn ung thư cao hơn ít có khả năng được chữa khỏi. Trong hầu hết các trường hợp, ung thư giai đoạn IV', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có: Phân đen, giống như hắc ín Máu khi đi đại tiện Thay đổi thói quen đại tiện Sụt cân không rõ nguyên nhân';
MERGE (n:Disease {id: 'D0683'}) SET n.id = 'D0683', n.name = 'Polyp đại trực tràng', n.name_en = 'Colorectal polyps', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000266.htm', n.prognosis = 'Triển vọng sẽ rất tốt nếu các polyp được loại bỏ. Polyp không được cắt bỏ có thể phát triển thành ung thư theo thời gian.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Máu khi đi tiêu Thay đổi thói quen đại tiện';
MERGE (n:Disease {id: 'D0684'}) SET n.id = 'D0684', n.name = 'Cắt bỏ ruột non', n.name_en = 'Colostomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002942.htm', n.overview = 'Thủ thuật này thường được thực hiện sau: Cắt bỏ ruột Chấn thương ở ruột Việc mở thông ruột non có thể là ngắn hạn hoặc vĩnh viễn. Hậu môn nhân tạo được thực hiện trong khi bạn đang được gây mê toàn th', n.prognosis = 'Trước khi bạn xuất viện, y tá hậu môn nhân tạo sẽ hướng dẫn bạn về chế độ ăn uống và cách chăm sóc hậu môn giả của bạn.';
MERGE (n:Disease {id: 'D0685'}) SET n.id = 'D0685', n.name = 'Hôn mê', n.name_en = 'Coma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/coma/symptoms-causes/syc-20371099', n.overview = 'là tình trạng mất ý thức kéo dài. Nó có thể có nhiều nguyên nhân, bao gồm chấn thương đầu, đột quỵ, u não hoặc nhiễm độc ma túy hoặc rượu. Tình trạng hôn mê thậm chí có thể do một căn bệnh tiềm ẩn nào', n.when_to_see = 'Hôn mê là một trường hợp cấp cứu y tế. Tìm kiếm sự chăm sóc y tế ngay lập tức cho người đang hôn mê.';
MERGE (n:Disease {id: 'D0686'}) SET n.id = 'D0686', n.name = 'Cảm lạnh thông thường', n.name_en = 'Common cold', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/common-cold/symptoms-causes/syc-20351605 | https://medlineplus.gov/ency/article/000678.htm', n.overview = 'Cảm lạnh thông thường là một căn bệnh ảnh hưởng đến mũi và họng của bạn. Thông thường, nó vô hại nhưng có thể bạn sẽ không cảm thấy như vậy. Vi trùng được gọi là virus gây cảm lạnh thông thường. Thông', n.prognosis = 'Chất lỏng chảy ra từ mũi của bạn sẽ đặc hơn theo thời gian. Nó có thể chuyển sang màu vàng hoặc xanh trong vòng vài ngày. Điều này là bình thường và không phải là lý do để dùng kháng sinh. Hầu hết các', n.when_to_see = 'Dành cho người lớn. Thông thường, bạn không cần chăm sóc y tế khi bị cảm lạnh thông thường. Nhưng hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có: Các triệu chứng trở nên trầm trọng ';
MERGE (n:Disease {id: 'D0687'}) SET n.id = 'D0687', n.name = 'Cảm lạnh thông thường ở trẻ sơ sinh', n.name_en = 'Common cold in babies', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/common-cold-in-babies/symptoms-causes/syc-20351651', n.overview = 'Cảm lạnh thông thường ở trẻ là tình trạng nhiễm virus ở mũi và họng. Nghẹt mũi và chảy nước mũi là triệu chứng chính của cảm lạnh. Tất cả trẻ sơ sinh đều có khả năng bị cảm lạnh thông thường. Đó một p', n.when_to_see = 'Hệ thống miễn dịch của trẻ cần có thời gian để trưởng thành. Hầu hết cảm lạnh không gây ra vấn đề gì. Cảm lạnh không có biến chứng sẽ khỏi trong vòng 10 đến 14 ngày. Nhưng điều quan trọng là phải xem ';
MERGE (n:Disease {id: 'D0688'}) SET n.id = 'D0688', n.name = 'Rối loạn chức năng thần kinh mác thường gặp', n.name_en = 'Common peroneal nerve dysfunction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000791.htm', n.prognosis = 'Kết quả phụ thuộc vào nguyên nhân của vấn đề. Điều trị thành công nguyên nhân có thể làm giảm rối loạn chức năng, nhưng có thể mất vài tháng để chức năng của dây thần kinh được cải thiện. Tổn thương t', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng rối loạn chức năng thần kinh mác thông thường.';
MERGE (n:Disease {id: 'D0689'}) SET n.id = 'D0689', n.name = 'Suy giảm miễn dịch biến đổi phổ biến', n.name_en = 'Common variable immunodeficiency', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/common-variable-immunodeficiency/symptoms-causes/syc-20355821', n.overview = ', còn được gọi là CVID, là một chứng rối loạn hệ thống miễn dịch khiến lượng protein trong cơ thể giúp chống lại nhiễm trùng ở mức thấp. Những người bị CVID bị nhiễm trùng nhiều lần ở tai, xoang và hệ';
MERGE (n:Disease {id: 'D0690'}) SET n.id = 'D0690', n.name = 'Mụn cóc thông thường', n.name_en = 'Common warts', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/common-warts/symptoms-causes/syc-20371125', n.overview = 'e những vết sưng nhỏ, sần sùi, sờ vào thấy thô ráp. Mụn cóc thông thường là những khối da nhỏ, sần sùi, thường xuất hiện ở ngón tay hoặc bàn tay. Chúng thô ráp khi chạm vào và thường có những chấm đen', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe để điều trị mụn cóc thông thường nếu: Các khối u phát triển gây đau, chảy máu, bỏng rát hoặc ngứa. Bạn đã cố gắng điều trị mụn cóc nhưng chúng vẫn tồn tại, lan';
MERGE (n:Disease {id: 'D0691'}) SET n.id = 'D0691', n.name = 'Viêm phổi mắc phải tại cộng đồng ở người lớn', n.name_en = 'Community-acquired pneumonia in adults', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000145.htm', n.prognosis = 'Khi điều trị, hầu hết mọi người sẽ cải thiện nhanh chóng và cảm thấy gần như trở lại bình thường trong vòng 2 tuần. Người lớn tuổi hoặc người bệnh nặng có thể cần điều trị lâu hơn. Những người có nhiề', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Ho tiết ra chất nhầy có máu hoặc màu rỉ sét Các triệu chứng thở (hô hấp) trở nên tồi tệ hơn Đau ngực trở nên tồi tệ hơn khi bạn ho hoặc hít vào Thở';
MERGE (n:Disease {id: 'D0692'}) SET n.id = 'D0692', n.name = 'Hội chứng khoang', n.name_en = 'Compartment syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001224.htm', n.prognosis = 'Với chẩn đoán và điều trị kịp thời, tiên lượng sẽ rất tốt và các cơ cũng như dây thần kinh bên trong khoang sẽ hồi phục. Tuy nhiên, triển vọng tổng thể được xác định bởi chấn thương dẫn đến hội chứng.', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu bạn bị chấn thương và bị sưng hoặc đau dữ dội mà không cải thiện khi dùng thuốc giảm đau.';
MERGE (n:Disease {id: 'D0693'}) SET n.id = 'D0693', n.name = 'Hội chứng đau cục bộ phức tạp', n.name_en = 'Complex regional pain syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/crps-complex-regional-pain-syndrome/symptoms-causes/syc-20371151 | https://medlineplus.gov/ency/article/007184.htm', n.overview = '(CRPS) là một dạng đau mãn tính thường ảnh hưởng đến cánh tay hoặc chân. CRPS thường phát triển sau chấn thương, phẫu thuật, đột quỵ hoặc đau tim. Cơn đau không tương xứng với mức độ nghiêm trọng của ', n.prognosis = 'Triển vọng sẽ tốt hơn nếu được chẩn đoán sớm. Nếu bác sĩ của bạn chẩn đoán tình trạng bệnh ở giai đoạn đầu, đôi khi các dấu hiệu của bệnh có thể biến mất (thuyên giảm) và có thể cử động bình thường. N', n.when_to_see = 'Nếu bạn cảm thấy đau liên tục, dữ dội ảnh hưởng đến một chi và khiến việc chạm hoặc cử động chi đó dường như không thể chịu đựng được, hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn để xác';
MERGE (n:Disease {id: 'D0694'}) SET n.id = 'D0694', n.name = 'Nỗi đau buồn phức tạp', n.name_en = 'Complicated grief', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/complicated-grief/symptoms-causes/syc-20360374', n.overview = 'Mất đi người thân là một trong những trải nghiệm đau buồn nhất và thật không may, là trải nghiệm phổ biến mà mọi người phải đối mặt. Hầu hết những người trải qua nỗi đau buồn và mất mát thông thường đ', n.when_to_see = 'Hãy liên hệ với bác sĩ hoặc chuyên gia sức khỏe tâm thần nếu bạn đau buồn tột độ và các vấn đề về chức năng không cải thiện ít nhất một năm sau khi người thân yêu của bạn qua đời.';
MERGE (n:Disease {id: 'D0695'}) SET n.id = 'D0695', n.name = 'Gãy xương do nén ở lưng', n.name_en = 'Compression fractures of the back', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000443.htm', n.prognosis = 'Hầu hết các trường hợp gãy xương do nén do chấn thương sẽ lành sau 8 đến 10 tuần nếu nghỉ ngơi, đeo nẹp và dùng thuốc giảm đau. Tuy nhiên, quá trình phục hồi có thể mất nhiều thời gian hơn nếu phẫu th', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị đau lưng và bạn nghĩ rằng mình có thể bị gãy xương do nén. Các triệu chứng của bạn ngày càng trầm trọng hơn hoặc bạn gặp vấn đề trong việc kiểm';
MERGE (n:Disease {id: 'D0696'}) SET n.id = 'D0696', n.name = 'Cưỡng bức cờ bạc', n.name_en = 'Compulsive gambling', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/compulsive-gambling/symptoms-causes/syc-20355178 | https://medlineplus.gov/ency/article/001520.htm', n.overview = ', còn được gọi là chứng rối loạn cờ bạc, là sự thôi thúc không thể kiểm soát được để tiếp tục cờ bạc bất chấp tổn thất mà nó phải trả cho cuộc sống của bạn. Cờ bạc có nghĩa là bạn sẵn sàng mạo hiểm th', n.prognosis = 'Giống như chứng rối loạn sử dụng rượu hoặc chất kích thích, chứng nghiện cờ bạc là một chứng rối loạn lâu dài và có xu hướng trở nên tồi tệ hơn nếu không được điều trị. Ngay cả khi đã điều trị, việc b', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe hoặc chuyên gia sức khỏe tâm thần của bạn nếu bạn tin rằng mình có các triệu chứng nghiện cờ bạc. Nếu bạn hoặc ai đó bạn biết đang nghĩ đến việc ';
MERGE (n:Disease {id: 'D0697'}) SET n.id = 'D0697', n.name = 'Hành vi tình dục cưỡng bức', n.name_en = 'Compulsive sexual behavior', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/compulsive-sexual-behavior/symptoms-causes/syc-20360434', n.overview = 'đôi khi được gọi là cuồng dâm hoặc nghiện tình dục. Đó là sự tập trung cao độ vào những tưởng tượng, sự thôi thúc hoặc hành vi tình dục không thể kiểm soát được. Điều này gây ra đau khổ và các vấn đề ', n.when_to_see = 'Hãy yêu cầu trợ giúp nếu bạn cảm thấy mình mất kiểm soát hành vi tình dục của mình, đặc biệt nếu hành vi của bạn gây ra vấn đề cho bạn hoặc người khác. Hành vi tình dục cưỡng bức có xu hướng trở nên t';
MERGE (n:Disease {id: 'D0698'}) SET n.id = 'D0698', n.name = 'Chấn động', n.name_en = 'Concussion', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/concussion/symptoms-causes/syc-20355594', n.overview = 'Chấn động não là một chấn thương sọ não nhẹ ảnh hưởng đến chức năng não. Các ảnh hưởng thường ngắn hạn và có thể bao gồm đau đầu và khó tập trung, trí nhớ, thăng bằng, tâm trạng và giấc ngủ. Chấn động', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe trong vòng 1 đến 2 ngày nếu: Bạn hoặc con bạn bị chấn thương ở đầu, ngay cả khi không cần chăm sóc khẩn cấp. Trẻ em và thanh thiếu niên cần gặp chuyên gia chăm sóc';
MERGE (n:Disease {id: 'D0699'}) SET n.id = 'D0699', n.name = 'Bao cao su - dành cho nam', n.name_en = 'Condoms - male', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/004001.htm', n.overview = 'Bao cao su dành cho nam là một lớp vỏ mỏng vừa khít với dương vật đang cương cứng của nam giới . Bao cao su được làm từ: Da động vật (Loại này không bảo vệ chống lại sự lây lan của nhiễm trùng.) Cao s';
MERGE (n:Disease {id: 'D0700'}) SET n.id = 'D0700', n.name = 'Rối loạn hành vi', n.name_en = 'Conduct disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000919.htm', n.prognosis = 'Trẻ em có các triệu chứng nghiêm trọng hoặc thường xuyên và không thể hoàn thành việc điều trị có xu hướng có triển vọng kém nhất.', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe nếu con bạn: Thường xuyên gặp rắc rối Tâm trạng thất thường Đang bắt nạt người khác hoặc tàn ác với động vật Đang là nạn nhân Có vẻ hung hăng quá mức Điề';
MERGE (n:Disease {id: 'D0701'}) SET n.id = 'D0701', n.name = 'Nhầm lẫn', n.name_en = 'Confusion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003205.htm', n.when_to_see = 'Gọi 911 hoặc số cấp cứu tại địa phương nếu tình trạng lú lẫn xảy ra đột ngột hoặc có các triệu chứng khác, chẳng hạn như: Da lạnh hoặc ẩm ướt Chóng mặt hoặc cảm thấy ngất xỉu Mạch nhanh Sốt Đau đầu Th';
MERGE (n:Disease {id: 'D0702'}) SET n.id = 'D0702', n.name = 'Tăng sản thượng thận bẩm sinh', n.name_en = 'Congenital adrenal hyperplasia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/congenital-adrenal-hyperplasia/symptoms-causes/syc-20355205 | https://medlineplus.gov/ency/article/000411.htm', n.overview = 'Tuyến thượng thận sản sinh ra các hormone giúp điều hòa quá trình trao đổi chất, hệ thống miễn dịch, huyết áp và các chức năng quan trọng khác. Mặc dù nhỏ nhưng những tuyến này kiểm soát phần lớn nhữn', n.prognosis = 'Hầu hết những người mắc chứng rối loạn này phải dùng thuốc suốt đời. Họ thường có sức khỏe tốt. Tuy nhiên, chúng có thể ngắn hơn người lớn bình thường, ngay cả khi được điều trị. In some cases, CAH ca', n.when_to_see = 'Thông thường, CAH cổ điển được phát hiện khi mới sinh thông qua các xét nghiệm sàng lọc sơ sinh định kỳ. Hoặc nó được phát hiện khi bộ phận sinh dục bên ngoài của em bé trông không bình thường. CAH cũ';
MERGE (n:Disease {id: 'D0703'}) SET n.id = 'D0703', n.name = 'Thiếu hụt antitrombin III bẩm sinh', n.name_en = 'Congenital antithrombin III deficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000558.htm', n.prognosis = 'Hầu hết mọi người đều có kết quả tốt nếu tiếp tục dùng thuốc chống đông máu.', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của tình trạng này.';
MERGE (n:Disease {id: 'D0704'}) SET n.id = 'D0704', n.name = 'Đục thủy tinh thể bẩm sinh', n.name_en = 'Congenital cataract', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001615.htm', n.prognosis = 'Loại bỏ đục thủy tinh thể bẩm sinh thường là một thủ thuật an toàn và hiệu quả. Trẻ sẽ cần được theo dõi để phục hồi thị lực. Hầu hết trẻ sơ sinh bị đục thủy tinh thể bẩm sinh ở một mắt đều mắc chứng ', n.when_to_see = 'Hãy đặt lịch hẹn khẩn cấp với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu: Bạn nhận thấy đồng tử của một hoặc cả hai mắt có màu trắng hoặc đục. Đứa trẻ dường như bỏ qua một phần thế giới th';
MERGE (n:Disease {id: 'D0705'}) SET n.id = 'D0705', n.name = 'Cytomegalovirus bẩm sinh', n.name_en = 'Congenital cytomegalovirus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001343.htm', n.prognosis = 'Hầu hết trẻ sơ sinh có triệu chứng nhiễm trùng khi sinh sẽ có những bất thường về thần kinh sau này khi lớn lên. Hầu hết trẻ sơ sinh không có triệu chứng khi sinh sẽ KHÔNG gặp phải những vấn đề này. M', n.when_to_see = 'Hãy đưa con bạn đi kiểm tra ngay nếu nhà cung cấp dịch vụ không khám con bạn ngay sau khi sinh và bạn nghi ngờ con mình bị: Đầu nhỏ Các triệu chứng khác của CMV bẩm sinh Nếu con bạn bị CMV bẩm sinh, đ';
MERGE (n:Disease {id: 'D0706'}) SET n.id = 'D0706', n.name = 'Thoát vị cơ hoành bẩm sinh (CDH)', n.name_en = 'Congenital diaphragmatic hernia (CDH)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/congenital-diaphragmatic-hernia/symptoms-causes/syc-20544249', n.overview = 'là một tình trạng hiếm gặp xảy ra ở trẻ trước khi sinh. Nó xảy ra sớm trong thai kỳ khi cơ hoành của em bé - cơ ngăn cách ngực với bụng - không hoạt động như bình thường. Điều này để lại một lỗ trên c', n.when_to_see = 'CDH có thể được tìm thấy khi siêu âm thai nhi định kỳ. Nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn có thể thảo luận về các lựa chọn điều trị với bạn. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0707'}) SET n.id = 'D0707', n.name = 'Sửa chữa thoát vị cơ hoành bẩm sinh', n.name_en = 'Congenital diaphragmatic hernia repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002936.htm', n.overview = 'Cho đến khi phẫu thuật được thực hiện và thường là một thời gian sau đó, gần như tất cả trẻ sơ sinh đều cần máy thở để cải thiện lượng oxy. Nhiều trẻ sơ sinh mắc CDH sẽ cần oxy hóa qua màng ngoài cơ t', n.prognosis = 'Kết quả của cuộc phẫu thuật này phụ thuộc vào mức độ phát triển của phổi của bé. Một số em bé có các vấn đề y tế khác, đặc biệt là về tim, não, cơ và khớp, thường ảnh hưởng đến khả năng hoạt động của ';
MERGE (n:Disease {id: 'D0708'}) SET n.id = 'D0708', n.name = 'Thiếu fibrinogen bẩm sinh', n.name_en = 'Congenital fibrinogen deficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001313.htm', n.prognosis = 'Chảy máu quá nhiều là tình trạng thường gặp ở tình trạng này. Những đợt này có thể nghiêm trọng hoặc thậm chí gây tử vong. Chảy máu trong não là nguyên nhân hàng đầu gây tử vong ở những người mắc chứn', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn hoặc tìm kiếm sự chăm sóc khẩn cấp nếu bạn bị chảy máu quá nhiều. Hãy báo cho bác sĩ phẫu thuật trước khi phẫu thuật nếu bạn biết hoặc nghi ngờ mình mắc ch';
MERGE (n:Disease {id: 'D0709'}) SET n.id = 'D0709', n.name = 'Dị tật tim bẩm sinh - phẫu thuật chỉnh sửa', n.name_en = 'Congenital heart defect - corrective surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002948.htm', n.overview = 'Có rất nhiều loại phẫu thuật tim nhi. Thắt ống động mạch (PDA): Trước khi sinh, em bé có một mạch máu chạy giữa động mạch chủ (động mạch chính đến cơ thể) và động mạch phổi (động mạch chính đến phổi),';
MERGE (n:Disease {id: 'D0710'}) SET n.id = 'D0710', n.name = 'Dị tật tim bẩm sinh ở trẻ em', n.name_en = 'Congenital heart defects in children', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/congenital-heart-defects-children/symptoms-causes/syc-20350074', n.overview = 'Dị tật tim bẩm sinh là vấn đề về cấu trúc tim của trẻ khi sinh ra. Một số dị tật tim bẩm sinh ở trẻ em rất đơn giản và không cần điều trị. Những người khác phức tạp hơn. Trẻ có thể cần thực hiện nhiều', n.when_to_see = 'Dị tật tim bẩm sinh nghiêm trọng thường được chẩn đoán trước hoặc ngay sau khi trẻ chào đời. Nếu bạn cho rằng con mình có các triệu chứng của bệnh tim, hãy gọi cho chuyên gia chăm sóc sức khỏe của con';
MERGE (n:Disease {id: 'D0711'}) SET n.id = 'D0711', n.name = 'Bệnh tim bẩm sinh', n.name_en = 'Congenital heart disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001114.htm';
MERGE (n:Disease {id: 'D0712'}) SET n.id = 'D0712', n.name = 'Bệnh tim bẩm sinh ở người lớn', n.name_en = 'Congenital heart disease in adults', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/adult-congenital-heart-disease/symptoms-causes/syc-20355456', n.overview = 'Bệnh tim bẩm sinh là một hoặc nhiều vấn đề về cấu trúc của tim xuất hiện ngay từ khi sinh ra. Bẩm sinh có nghĩa là bạn được sinh ra với tình trạng này. Bệnh tim bẩm sinh có thể làm thay đổi cách máu c', n.when_to_see = 'Nhận trợ giúp y tế khẩn cấp nếu bạn bị đau ngực hoặc khó thở không rõ nguyên nhân. Hẹn khám sức khỏe nếu: Bạn có các triệu chứng của bệnh tim bẩm sinh ở người trưởng thành. Bạn đã được điều trị dị tật';
MERGE (n:Disease {id: 'D0713'}) SET n.id = 'D0713', n.name = 'Hội chứng nhược cơ bẩm sinh', n.name_en = 'Congenital myasthenic syndromes', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/congenital-myasthenic-syndrome/symptoms-causes/syc-20354754', n.overview = 'là một nhóm các tình trạng di truyền hiếm gặp do sự thay đổi gen dẫn đến yếu cơ, tình trạng này trở nên trầm trọng hơn khi hoạt động thể chất. Bất kỳ cơ nào được sử dụng để vận động đều có thể bị ảnh ', n.when_to_see = 'Hãy nói chuyện với bác sĩ nếu bạn quan sát thấy bất kỳ dấu hiệu nào được liệt kê ở trên ở con bạn hoặc nếu bạn lo lắng về các dấu hiệu hoặc triệu chứng của chính mình. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0714'}) SET n.id = 'D0714', n.name = 'Hội chứng thận hư bẩm sinh', n.name_en = 'Congenital nephrotic syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001576.htm', n.prognosis = 'Tình trạng này thường dẫn đến nhiễm trùng, suy dinh dưỡng và suy thận. Nó có thể dẫn đến tử vong trước 5 tuổi và nhiều trẻ em chết trong năm đầu tiên. Hội chứng thận hư bẩm sinh có thể được kiểm soát ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có các triệu chứng của hội chứng thận hư bẩm sinh.';
MERGE (n:Disease {id: 'D0715'}) SET n.id = 'D0715', n.name = 'Khiếm khuyết chức năng tiểu cầu bẩm sinh', n.name_en = 'Congenital platelet function defects', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000582.htm', n.prognosis = 'Không có cách chữa trị rối loạn chức năng tiểu cầu bẩm sinh. Hầu hết thời gian, điều trị có thể kiểm soát chảy máu.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị chảy máu hoặc bầm tím và không biết nguyên nhân. Chảy máu không đáp ứng với phương pháp kiểm soát thông thường.';
MERGE (n:Disease {id: 'D0716'}) SET n.id = 'D0716', n.name = 'Thiếu protein C hoặc S bẩm sinh', n.name_en = 'Congenital protein C or S deficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000559.htm', n.prognosis = 'Kết quả thường tốt khi điều trị, nhưng các triệu chứng có thể quay trở lại, đặc biệt nếu ngừng dùng thuốc làm loãng máu.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có triệu chứng đông máu trong tĩnh mạch (sưng và đỏ ở chân).';
MERGE (n:Disease {id: 'D0717'}) SET n.id = 'D0717', n.name = 'Rubella bẩm sinh', n.name_en = 'Congenital rubella', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001658.htm', n.prognosis = 'Kết quả của trẻ mắc bệnh rubella bẩm sinh phụ thuộc vào mức độ nghiêm trọng của vấn đề. Các khuyết tật về tim thường có thể được sửa chữa. Tổn thương hệ thần kinh là vĩnh viễn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn có lo ngại về bệnh sởi Đức bẩm sinh. Bạn không chắc liệu mình đã tiêm vắc xin sởi hay chưa. Bạn hoặc con bạn cần tiêm vắc-xin rubella.';
MERGE (n:Disease {id: 'D0718'}) SET n.id = 'D0718', n.name = 'Bệnh giang mai bẩm sinh', n.name_en = 'Congenital syphilis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001344.htm', n.prognosis = 'Nhiều trẻ sơ sinh bị nhiễm bệnh sớm trong thai kỳ đều chết non. Điều trị cho bà mẹ tương lai làm giảm nguy cơ mắc bệnh giang mai bẩm sinh ở trẻ sơ sinh. Những em bé bị nhiễm bệnh khi đi qua đường sinh', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có các dấu hiệu hoặc triệu chứng của tình trạng này. Nếu bạn nghĩ rằng mình có thể mắc bệnh giang mai và đang mang thai (hoặc';
MERGE (n:Disease {id: 'D0719'}) SET n.id = 'D0719', n.name = 'Bệnh toxoplasmosis bẩm sinh', n.name_en = 'Congenital toxoplasmosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001360.htm', n.prognosis = 'Kết quả phụ thuộc vào mức độ của tình trạng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn đang mang thai và cho rằng mình có nguy cơ bị nhiễm trùng. (Ví dụ: mèo có thể bị nhiễm toxoplasmosis nếu bạn dọn dẹp hộp vệ sinh cho mèo.) Hãy liên';
MERGE (n:Disease {id: 'D0720'}) SET n.id = 'D0720', n.name = 'Cặp song sinh dính liền', n.name_en = 'Conjoined twins', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/conjoined-twins/symptoms-causes/syc-20353910', n.overview = '. Những cặp song sinh dính liền này được nối ở ngực (ngực). Họ có trái tim riêng biệt nhưng có chung các cơ quan khác nhau. Cặp song sinh dính liền là hai em bé được sinh ra có mối liên hệ về thể chất';
MERGE (n:Disease {id: 'D0721'}) SET n.id = 'D0721', n.name = 'Viêm kết mạc hoặc đau mắt đỏ', n.name_en = 'Conjunctivitis or pink eye', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001010.htm', n.prognosis = 'Kết quả điều trị nhiễm trùng do vi khuẩn thường tốt nhất khi điều trị bằng kháng sinh sớm. Bệnh đau mắt đỏ (viêm kết mạc do vi-rút) có thể dễ dàng lây lan ra toàn bộ hộ gia đình hoặc lớp học nhưng dự ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Các triệu chứng của bạn kéo dài hơn 3 hoặc 4 ngày. Tầm nhìn của bạn bị ảnh hưởng. Bạn có độ nhạy sáng. Bạn bị đau mắt nghiêm trọng hoặc trở nên tồi tệ hơn. Mí';
MERGE (n:Disease {id: 'D0722'}) SET n.id = 'D0722', n.name = 'Thuốc an thần còn tỉnh cho các thủ tục phẫu thuật', n.name_en = 'Conscious sedation for surgical procedures', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007409.htm', n.overview = 'Y tá, nhà cung cấp dịch vụ chăm sóc sức khỏe hoặc nha sĩ sẽ cho bạn thuốc an thần còn tỉnh trong bệnh viện hoặc phòng khám ngoại trú. Hầu hết thời gian, đó sẽ không phải là bác sĩ gây mê. Thuốc sẽ nha', n.prognosis = 'Thuốc an thần còn tỉnh nói chung là an toàn và là một lựa chọn cho các thủ tục hoặc xét nghiệm chẩn đoán.';
MERGE (n:Disease {id: 'D0723'}) SET n.id = 'D0723', n.name = 'Táo bón', n.name_en = 'Constipation', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/constipation/symptoms-causes/syc-20354253', n.overview = 'là vấn đề liên quan đến việc đi đại tiện. Táo bón thường có nghĩa là đi đại tiện ít hơn ba lần một tuần hoặc gặp khó khăn khi đi đại tiện. Táo bón là tình trạng khá phổ biến. Việc thiếu chất xơ, chất ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị táo bón kèm theo bất kỳ tình trạng nào sau đây: Các triệu chứng kéo dài hơn ba tuần. Các triệu chứng gây khó khăn cho hoạt động hàng ngày. C';
MERGE (n:Disease {id: 'D0724'}) SET n.id = 'D0724', n.name = 'Táo bón ở trẻ em', n.name_en = 'Constipation in children', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/constipation-in-children/symptoms-causes/syc-20354242', n.overview = 'là một vấn đề thường gặp. Trẻ bị táo bón có nhu động ruột không thường xuyên hoặc phân khô, cứng. Các nguyên nhân phổ biến bao gồm tập đi vệ sinh sớm và thay đổi chế độ ăn uống. May mắn thay, hầu hết ', n.when_to_see = 'Táo bón ở trẻ em thường không nghiêm trọng. Tuy nhiên, táo bón mãn tính có thể dẫn đến các biến chứng hoặc báo hiệu một tình trạng tiềm ẩn. Đưa con bạn đến bác sĩ nếu tình trạng táo bón kéo dài hơn ha';
MERGE (n:Disease {id: 'D0725'}) SET n.id = 'D0725', n.name = 'Táo bón ở trẻ sơ sinh và trẻ nhỏ', n.name_en = 'Constipation in infants and children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003125.htm', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu: Trẻ sơ sinh (trừ những trẻ chỉ được bú sữa mẹ) không đi tiêu trong 3 ngày và bị nôn mửa hoặc cáu kỉnh. Đồng thời, hãy liên ';
MERGE (n:Disease {id: 'D0726'}) SET n.id = 'D0726', n.name = 'Quyền và biện pháp bảo vệ người tiêu dùng', n.name_en = 'Consumer rights and protections', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001947.htm', n.overview = 'QUYỀN VÀ BẢO VỆ Dưới đây là những cách mà luật chăm sóc sức khỏe bảo vệ người tiêu dùng. Bạn phải được bảo hiểm, ngay cả khi bạn có bệnh từ trước. Không có chương trình bảo hiểm nào có thể từ chối bạn';
MERGE (n:Disease {id: 'D0727'}) SET n.id = 'D0727', n.name = 'Quá liều Contac', n.name_en = 'Contac overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002616.htm', n.prognosis = 'Loại quá liều này có xu hướng nhẹ. Tuy nhiên, nếu người đó nuốt đủ sản phẩm, các biến chứng nghiêm trọng (chẳng hạn như tổn thương gan) có thể xảy ra. Đây là từ chất acetaminophen trong sản phẩm. Tình';
MERGE (n:Disease {id: 'D0728'}) SET n.id = 'D0728', n.name = 'Viêm da tiếp xúc', n.name_en = 'Contact dermatitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/contact-dermatitis/symptoms-causes/syc-20352742 | https://medlineplus.gov/ency/article/000869.htm', n.overview = 'không có màu da. Viêm da tiếp xúc có thể xuất hiện dưới dạng phát ban ngứa. Viêm da tiếp xúc là tình trạng phát ban ngứa do tiếp xúc trực tiếp với một chất hoặc phản ứng dị ứng với nó. Phát ban không ', n.prognosis = 'Viêm da tiếp xúc sẽ khỏi mà không có biến chứng trong 2 hoặc 3 tuần trong hầu hết các trường hợp. Tuy nhiên, nó có thể quay trở lại nếu không thể xác định và tránh được chất gây ra nó. Bạn có thể cần ', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Phát ban ngứa đến mức bạn không thể ngủ hoặc đi lại trong ngày Phát ban nghiêm trọng hoặc lan rộng Bạn lo lắng về hình thức phát ban của mìn';
MERGE (n:Disease {id: 'D0729'}) SET n.id = 'D0729', n.name = 'Biến dạng co rút', n.name_en = 'Contracture deformity', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003185.htm', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Co cứng dường như đang phát triển. Bạn nhận thấy khả năng di chuyển khớp giảm.';
MERGE (n:Disease {id: 'D0730'}) SET n.id = 'D0730', n.name = 'COPD', n.name_en = 'COPD', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/copd/symptoms-causes/syc-20353679', n.overview = 'Bệnh phổi tắc nghẽn mạn tính (COPD) là một tình trạng bệnh phổi đang diễn ra do phổi bị tổn thương. Tổn thương dẫn đến sưng tấy và kích ứng, còn gọi là viêm, bên trong đường thở làm hạn chế luồng khôn', n.when_to_see = 'Hãy nói chuyện với bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu các triệu chứng của bạn không thuyên giảm khi điều trị hoặc nếu các triệu chứng trở nên tồi tệ hơn. Ngoài ra, hãy nói chuyện với ch';
MERGE (n:Disease {id: 'D0731'}) SET n.id = 'D0731', n.name = 'Ngộ độc đồng', n.name_en = 'Copper poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002496.htm', n.prognosis = 'Ngộ độc đồng đột ngột (cấp tính) rất hiếm xảy ra. Tuy nhiên, các vấn đề sức khỏe nghiêm trọng do tiếp xúc lâu dài với đồng có thể xảy ra. Ngộ độc nặng có thể gây suy gan và tử vong. Trong trường hợp n';
MERGE (n:Disease {id: 'D0732'}) SET n.id = 'D0732', n.name = 'Cor pulmonale', n.name_en = 'Cor pulmonale', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000129.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào nguyên nhân gây bệnh tâm phế của bạn. Khi bệnh tình của bạn trở nên trầm trọng hơn, bạn sẽ cần phải thay đổi ngôi nhà của mình để có thể quản lý tốt nhất có thể. ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị khó thở hoặc đau ngực.';
MERGE (n:Disease {id: 'D0733'}) SET n.id = 'D0733', n.name = 'Chấn thương giác mạc', n.name_en = 'Corneal injury', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001017.htm', n.prognosis = 'Hầu hết các vết thương chỉ ảnh hưởng đến bề mặt giác mạc sẽ lành rất nhanh sau khi điều trị. Mắt sẽ trở lại bình thường trong vòng 2 đến 3 ngày. Đối với những vết thương nghiêm trọng hơn hoặc khi vết ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu vết thương không khá hơn sau 2 đến 3 ngày điều trị.';
MERGE (n:Disease {id: 'D0734'}) SET n.id = 'D0734', n.name = 'Ghép giác mạc', n.name_en = 'Corneal transplant', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003008.htm', n.overview = 'Rất có thể bạn sẽ tỉnh táo trong quá trình cấy ghép. Bạn sẽ nhận được thuốc để giúp bạn thư giãn. Gây tê cục bộ (thuốc gây tê) sẽ được tiêm quanh mắt của bạn để ngăn chặn cơn đau và ngăn cản chuyển độ', n.prognosis = 'Việc phục hồi thị lực hoàn toàn có thể mất tới một năm. Điều này là do cần có thời gian để vết sưng giảm đi. Hầu hết những người được ghép giác mạc thành công sẽ có thị lực tốt trong nhiều năm. Nếu bạ';
MERGE (n:Disease {id: 'D0735'}) SET n.id = 'D0735', n.name = 'Loét và nhiễm trùng giác mạc', n.name_en = 'Corneal ulcers and infections', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001032.htm', n.prognosis = 'Nhiều người hồi phục hoàn toàn và chỉ có một sự thay đổi nhỏ về thị lực. Tuy nhiên, loét hoặc nhiễm trùng giác mạc có thể gây tổn thương lâu dài và ảnh hưởng đến thị lực.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có các triệu chứng loét giác mạc hoặc nhiễm trùng. Bạn đã được chẩn đoán mắc bệnh này và các triệu chứng của bạn trở nên tồi tệ hơn sau khi điều t';
MERGE (n:Disease {id: 'D0736'}) SET n.id = 'D0736', n.name = 'Ngô và vết chai', n.name_en = 'Corns and calluses', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/corns-and-calluses/symptoms-causes/syc-20355946 | https://medlineplus.gov/ency/article/001232.htm', n.overview = 'là những lớp da dày, cứng phát triển khi da cố gắng tự bảo vệ mình trước ma sát hoặc áp lực. Chúng thường hình thành ở bàn chân và ngón chân hoặc bàn tay và ngón tay. Nếu khỏe mạnh, bạn không cần điều', n.prognosis = 'Ngô và vết chai hiếm khi nghiêm trọng. Chúng sẽ cải thiện nếu được điều trị thích hợp và không gây ra vấn đề lâu dài.', n.when_to_see = 'Nếu vết chai hoặc vết chai trở nên rất đau hoặc bị viêm, hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Nếu bạn mắc bệnh tiểu đường hoặc lưu lượng máu kém, hãy tìm kiếm sự chăm sóc y tế t';
MERGE (n:Disease {id: 'D0737'}) SET n.id = 'D0737', n.name = 'Bệnh động mạch vành', n.name_en = 'Coronary artery disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/coronary-artery-disease/symptoms-causes/syc-20350613', n.overview = '(CAD) là một loại bệnh tim phổ biến. Nó ảnh hưởng đến các mạch máu chính cung cấp máu cho tim, được gọi là động mạch vành. Trong CAD, lưu lượng máu đến cơ tim bị giảm. Sự tích tụ chất béo, cholesterol', n.when_to_see = 'Nếu bạn cho rằng mình đang bị đau tim, hãy gọi ngay 911 hoặc số khẩn cấp tại địa phương. Nếu bạn không thể tiếp cận các dịch vụ y tế khẩn cấp, hãy nhờ ai đó đưa bạn đến bệnh viện gần nhất. Chỉ tự lái ';
MERGE (n:Disease {id: 'D0738'}) SET n.id = 'D0738', n.name = 'Rò động mạch vành', n.name_en = 'Coronary artery fistula', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007315.htm', n.prognosis = 'Trẻ em được phẫu thuật hầu hết đều có kết quả tốt, mặc dù một tỷ lệ nhỏ có thể phải phẫu thuật lại. Hầu hết những người mắc bệnh này đều có tuổi thọ bình thường.', n.when_to_see = 'Lỗ rò động mạch vành thường được bác sĩ chẩn đoán khi khám. Liên hệ với nhà cung cấp của bạn nếu trẻ sơ sinh của bạn có các triệu chứng của tình trạng này.';
MERGE (n:Disease {id: 'D0739'}) SET n.id = 'D0739', n.name = 'Co thắt động mạch vành', n.name_en = 'Coronary artery spasm', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000159.htm', n.prognosis = 'Co thắt động mạch vành là một tình trạng lâu dài ( mãn tính ). Tuy nhiên, điều trị thường giúp kiểm soát các triệu chứng. Rối loạn này có thể là dấu hiệu cho thấy bạn có nguy cơ cao bị đau tim hoặc nh', n.when_to_see = 'Hãy gọi ngay số điện thoại cấp cứu tại địa phương (chẳng hạn như 911) hoặc đến phòng cấp cứu của bệnh viện nếu bạn có tiền sử đau thắt ngực và cơn đau ngực do bị đè nén hoặc bị ép chặt không thuyên gi';
MERGE (n:Disease {id: 'D0740'}) SET n.id = 'D0740', n.name = 'Bệnh tim mạch vành', n.name_en = 'Coronary heart disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007115.htm', n.prognosis = 'Mọi người đều hồi phục khác nhau. Một số người có thể giữ sức khỏe bằng cách thay đổi chế độ ăn uống, ngừng hút thuốc và dùng thuốc theo chỉ định. Những người khác có thể cần các thủ tục y tế như nong', n.when_to_see = 'Nếu bạn có bất kỳ yếu tố rủi ro nào đối với CHD, hãy trao đổi với nhà cung cấp dịch vụ của bạn về các bước phòng ngừa và điều trị có thể. Gọi cho nhà cung cấp của bạn, gọi đến số khẩn cấp tại địa phươ';
MERGE (n:Disease {id: 'D0741'}) SET n.id = 'D0741', n.name = 'Vi-rút Corona', n.name_en = 'Coronavirus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007767.htm', n.prognosis = 'Cảm lạnh thông thường do virus Corona thường tự khỏi. Nhiễm trùng coronavirus nặng có thể phải nhập viện và hỗ trợ hô hấp. Hiếm khi, một số trường hợp nhiễm virus Corona nghiêm trọng có thể dẫn đến tử', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu bạn: Tiếp xúc với người bị nhiễm vi-rút Corona Đi du lịch đến một nơi bùng phát bệnh nhiễm vi-rút Corona và phát triển các triệu chứng cảm lạnh thông thường, khó t';
MERGE (n:Disease {id: 'D0742'}) SET n.id = 'D0742', n.name = 'Bệnh vi-rút Corona 2019 (Covid-19)', n.name_en = 'Coronavirus disease 2019 (COVID-19)', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/coronavirus/symptoms-causes/syc-20479963 | https://medlineplus.gov/ency/article/007768.htm', n.overview = ', là một căn bệnh do vi-rút gây ra. Loại virus này được gọi là hội chứng hô hấp cấp tính nặng do virus Corona 2 hay phổ biến hơn là SARS-CoV-2. Nó bắt đầu lây lan vào cuối năm 2019 và trở thành đại dị', n.when_to_see = 'Những người có nguy cơ cao mắc bệnh nghiêm trọng có thể được dùng thuốc để ngăn chặn sự lây lan của vi rút COVID-19 trong cơ thể. Hoặc nhóm chăm sóc sức khỏe của bạn có thể lập kế hoạch kiểm tra thườn';
MERGE (n:Disease {id: 'D0743'}) SET n.id = 'D0743', n.name = 'Thoái hóa vỏ não (hội chứng vỏ não)', n.name_en = 'Corticobasal degeneration (corticobasal syndrome)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/corticobasal-degeneration/symptoms-causes/syc-20354767', n.overview = 'Thoái hóa vỏ não hay còn gọi là hội chứng vỏ não là một căn bệnh hiếm gặp khiến các vùng não bị co lại. Theo thời gian, các tế bào thần kinh bị phá vỡ và chết. Thoái hóa Corticobasal ảnh hưởng đến vùn';
MERGE (n:Disease {id: 'D0744'}) SET n.id = 'D0744', n.name = 'Quá liều corticosteroid', n.name_en = 'Corticosteroids overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002582.htm', n.prognosis = 'Hầu hết những người sử dụng corticosteroid quá liều đều có những thay đổi nhỏ về chất lỏng và chất điện giải trong cơ thể. Nếu họ có những thay đổi về nhịp tim, tình trạng của họ có thể nghiêm trọng h';
MERGE (n:Disease {id: 'D0745'}) SET n.id = 'D0745', n.name = 'Phẫu thuật thẩm mỹ tai', n.name_en = 'Cosmetic ear surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002988.htm', n.overview = 'có thể được thực hiện tại phòng khám của bác sĩ phẫu thuật, phòng khám ngoại trú hoặc bệnh viện. Nó có thể được thực hiện dưới hình thức gây tê cục bộ, làm tê vùng xung quanh tai. Bạn cũng có thể nhận', n.prognosis = 'Sẹo rất nhẹ và ẩn trong nếp nhăn sau tai. Có thể cần thực hiện quy trình thứ hai nếu tai lại thò ra ngoài.';
MERGE (n:Disease {id: 'D0746'}) SET n.id = 'D0746', n.name = 'Viêm sụn sườn', n.name_en = 'Costochondritis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/costochondritis/symptoms-causes/syc-20371175 | https://medlineplus.gov/ency/article/000164.htm', n.overview = '(kos-toe-kon-DRY-tis) là tình trạng viêm sụn nối xương sườn với xương ức, được gọi là xương ức. Cơn đau do viêm sụn sườn có thể giống như cơn đau tim hoặc các bệnh tim khác. Viêm sụn sườn Viêm sụn sườ', n.prognosis = 'Cơn đau do viêm sụn sườn thường biến mất sau vài ngày hoặc vài tuần.', n.when_to_see = 'Hãy gọi 911 hoặc số cấp cứu tại địa phương hoặc đến phòng cấp cứu tại địa phương ngay nếu bạn bị đau ngực. Cơn đau do viêm sụn sườn có thể tương tự như cơn đau tim. Nếu bạn đã được chẩn đoán mắc bệnh ';
MERGE (n:Disease {id: 'D0747'}) SET n.id = 'D0747', n.name = 'Ho', n.name_en = 'Cough', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003072.htm', n.when_to_see = 'Gọi 911 hoặc số cấp cứu tại địa phương nếu bạn có: Khó thở hoặc khó thở Nổi mề đay hoặc sưng mặt hoặc cổ họng và khó nuốt Liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu bạn bị ho và bất kỳ dấu hiệu';
MERGE (n:Disease {id: 'D0748'}) SET n.id = 'D0748', n.name = 'Đau đầu do ho', n.name_en = 'Cough headaches', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/primary-cough-headaches/symptoms-causes/syc-20371200', n.overview = 'là một loại đau đầu do ho và các dạng căng thẳng khác gây ra. Điều này có thể bao gồm hắt hơi, xì mũi, cười, khóc, hát, cúi xuống hoặc đi tiêu. Đau đầu khi ho khá hiếm gặp. Có hai loại: đau đầu do ho ', n.when_to_see = 'Hãy tham khảo ý kiến ​​bác sĩ hoặc nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn bị đau đầu đột ngột sau khi ho - đặc biệt nếu cơn đau đầu mới xuất hiện, thường xuyên hoặc nghiêm trọng hoặc bạn có bấ';
MERGE (n:Disease {id: 'D0749'}) SET n.id = 'D0749', n.name = 'Ho ra máu', n.name_en = 'Coughing up blood', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003073.htm', n.when_to_see = 'Nhận trợ giúp y tế ngay lập tức nếu bạn ho ra máu và bị: Ho ra nhiều hơn một vài muỗng cà phê máu Có máu trong nước tiểu hoặc phân Đau ngực Chóng mặt Sốt Chóng mặt Khó thở nghiêm trọng';
MERGE (n:Disease {id: 'D0750'}) SET n.id = 'D0750', n.name = 'Các triệu chứng của COVID-19', n.name_en = 'COVID-19 symptoms', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007770.htm', n.when_to_see = 'Bạn nên liên hệ với nhà cung cấp của mình ngay lập tức: Nếu bạn có các triệu chứng và nghĩ rằng mình có thể mắc bệnh COVID-19 Nếu bạn mắc bệnh COVID-19 và bạn thuộc nhóm được cho dùng thuốc kháng vi-r';
MERGE (n:Disease {id: 'D0751'}) SET n.id = 'D0751', n.name = 'Vắc xin COVID-19 - những điều bạn cần biết', n.name_en = 'COVID-19 vaccine - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007804.htm', n.overview = 'Tại sao nên tiêm vắc xin? Vắc-xin ngừa COVID-19 có thể ngăn ngừa bệnh COVID-19. Tiêm vắc-xin có thể giúp giảm mức độ nghiêm trọng của bệnh COVID-19 nếu bạn bị bệnh. COVID-19 do một loại vi-rút Corona ';
MERGE (n:Disease {id: 'D0752'}) SET n.id = 'D0752', n.name = 'Vắc-xin COVID-19', n.name_en = 'COVID-19 vaccines', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007775.htm', n.overview = 'CÁCH VẮC-XIN COVID-19 HOẠT ĐỘNG Vắc-xin COVID-19 bảo vệ mọi người khỏi bị nhiễm COVID-19 và khỏi mắc các triệu chứng nghiêm trọng hơn nếu họ mắc phải COVID-19. Những loại vắc xin này dạy cho cơ thể bạ';
MERGE (n:Disease {id: 'D0753'}) SET n.id = 'D0753', n.name = 'Vắc xin COVID-19 cho trẻ em từ 6 tháng tuổi trở lên', n.name_en = 'COVID-19 vaccines for children ages 6 months and older', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007780.htm', n.overview = 'Vắc xin COVID-19 bảo vệ mọi người khỏi bị nhiễm COVID-19 . Những loại vắc-xin này dạy cho cơ thể con bạn cách bảo vệ chống lại vi-rút SARS-CoV-2, nguyên nhân gây ra COVID-19. TẠI SAO TRẺ EM VÀ THANH T';
MERGE (n:Disease {id: 'D0754'}) SET n.id = 'D0754', n.name = 'CPR - người lớn và trẻ em sau khi bắt đầu dậy thì', n.name_en = 'CPR - adult and child after onset of puberty', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000013.htm', n.when_to_see = 'Các bước cần thực hiện nếu bạn ở cùng với người khác hoặc nếu bạn ở một mình: Nếu bạn được trợ giúp, hãy yêu cầu một người gọi 911 hoặc số khẩn cấp tại địa phương trong khi một người khác bắt đầu hô h';
MERGE (n:Disease {id: 'D0755'}) SET n.id = 'D0755', n.name = 'CPR - trẻ sơ sinh', n.name_en = 'CPR - infant', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000011.htm', n.when_to_see = 'Các bước cần thực hiện nếu bạn ở cùng người khác hoặc nếu bạn ở một mình với trẻ sơ sinh: Nếu bạn được trợ giúp, hãy yêu cầu một người gọi 911 hoặc số khẩn cấp tại địa phương trong khi người khác bắt ';
MERGE (n:Disease {id: 'D0756'}) SET n.id = 'D0756', n.name = 'CPR - trẻ nhỏ (từ 1 tuổi đến khi bắt đầu dậy thì)', n.name_en = 'CPR - young child (age 1 year to onset of puberty)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000012.htm', n.when_to_see = 'Các bước cần thực hiện nếu bạn ở cùng với người khác hoặc nếu bạn ở một mình với trẻ em: Nếu bạn được trợ giúp, hãy yêu cầu một người gọi 911 hoặc số khẩn cấp tại địa phương trong khi một người khác b';
MERGE (n:Disease {id: 'D0757'}) SET n.id = 'D0757', n.name = 'Mũ nôi', n.name_en = 'Cradle cap', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cradle-cap/symptoms-causes/syc-20350396 | https://medlineplus.gov/ency/article/007582.htm', n.overview = 'trên làn da trắng bị ảnh hưởng bởi các mảng vảy trên da đầu của em bé. Bạn có thể nhận thấy những mảng da dày, màu vàng. Các miếng dán có thể giòn hoặc nhờn. Mũ nôi trên Da đầu đen xuất hiện dưới dạng', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu: Vảy trên da đầu của con bạn hoặc các triệu chứng da khác không biến mất hoặc trở nên tồi tệ hơn sau khi chăm sóc tại nhà Miếng d';
MERGE (n:Disease {id: 'D0758'}) SET n.id = 'D0758', n.name = 'Bệnh đơn dây thần kinh sọ III', n.name_en = 'Cranial mononeuropathy III', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000698.htm', n.prognosis = 'Một số người sẽ đáp ứng với điều trị. Ở một số trường hợp khác, tình trạng sụp mắt vĩnh viễn hoặc mất khả năng cử động của mắt sẽ xảy ra. Các nguyên nhân như sưng não do khối u hoặc đột quỵ, hoặc chứn', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị song thị và tình trạng này không biến mất sau vài phút, đặc biệt nếu bạn cũng bị sụp mí mắt.';
MERGE (n:Disease {id: 'D0759'}) SET n.id = 'D0759', n.name = 'Bệnh đơn dây thần kinh sọ III - bệnh tiểu đường', n.name_en = 'Cranial mononeuropathy III - diabetic type', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000692.htm', n.prognosis = 'Tiên lượng tốt. Nhiều người sẽ khỏe hơn sau 3 đến 6 tháng. Tuy nhiên, một số người bị yếu cơ mắt vĩnh viễn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị song thị và tình trạng này không biến mất sau vài phút, đặc biệt nếu bạn cũng bị sụp mí mắt.';
MERGE (n:Disease {id: 'D0760'}) SET n.id = 'D0760', n.name = 'Bệnh đơn dây thần kinh sọ VI', n.name_en = 'Cranial mononeuropathy VI', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000690.htm', n.prognosis = 'Điều trị nguyên nhân có thể cải thiện được tình trạng. Sự phục hồi thường xảy ra trong vòng 3 tháng ở người lớn tuổi bị tăng huyết áp hoặc tiểu đường. Cơ hội phục hồi ít hơn trong trường hợp dây thần ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn bị song thị.';
MERGE (n:Disease {id: 'D0761'}) SET n.id = 'D0761', n.name = 'Các khớp sọ', n.name_en = 'Cranial sutures', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002320.htm', n.overview = 'Hộp sọ của trẻ sơ sinh được tạo thành từ 6 xương sọ (hộp sọ) riêng biệt: Xương trán Xương chẩm Hai xương đỉnh Hai xương thái dương Những xương này được giữ với nhau bằng các mô chắc chắn, dạng sợi, đà';
MERGE (n:Disease {id: 'D0762'}) SET n.id = 'D0762', n.name = 'U sọ hầu tuyến', n.name_en = 'Craniopharyngioma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/craniopharyngioma/symptoms-causes/syc-20581521 | https://medlineplus.gov/ency/article/000345.htm', n.overview = 'và vùng dưới đồi nằm trong não và kiểm soát việc sản xuất hormone. U sọ hầu là một loại u não không phải ung thư hiếm gặp. U sọ hầu bắt đầu khi các tế bào gần tuyến yên của não phát triển. Tuyến yên t', n.prognosis = 'Nhìn chung, triển vọng là tốt. Có 80% đến 90% cơ hội chữa khỏi nếu khối u có thể được loại bỏ hoàn toàn bằng phẫu thuật hoặc điều trị bằng xạ trị liều cao. Nếu khối u quay trở lại, nó thường sẽ quay t', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu có các triệu chứng sau: Nhức đầu, lú lẫn, buồn ngủ, buồn nôn, nôn hoặc các vấn đề về thăng bằng (dấu hiệu tăng áp lực lên não) Không theo kịp việc đến trường G';
MERGE (n:Disease {id: 'D0763'}) SET n.id = 'D0763', n.name = 'Chứng dính khớp sọ', n.name_en = 'Craniosynostosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/craniosynostosis/symptoms-causes/syc-20354513 | https://medlineplus.gov/ency/article/001590.htm', n.overview = 'Các khớp sọ và thóp l Các khớp được làm bằng mô sợi mềm dẻo. Chúng giữ các xương sọ của em bé lại với nhau. Những đường khâu gặp nhau ở thóp, những điểm mềm trên đầu em bé. Các mũi khâu vẫn linh hoạt ', n.prognosis = 'Sức khỏe của trẻ tốt như thế nào phụ thuộc vào: Số lượng mũi khâu Sức khỏe tổng thể của trẻ Trẻ mắc bệnh này được phẫu thuật sẽ có kết quả tốt trong hầu hết các trường hợp, đặc biệt là khi tình trạng ', n.when_to_see = 'Bác sĩ nhi khoa hoặc chuyên gia chăm sóc sức khỏe khác theo dõi sự phát triển đầu của con bạn khi khám sức khỏe cho trẻ. Nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu bạn lo lắng về sự phát ';
MERGE (n:Disease {id: 'D0764'}) SET n.id = 'D0764', n.name = 'Sửa chữa khớp sọ', n.name_en = 'Craniosynostosis repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007364.htm', n.overview = 'Phẫu thuật này được thực hiện trong phòng mổ dưới gây mê toàn thân. Điều này có nghĩa là con bạn sẽ ngủ và không cảm thấy đau. Một phần hoặc toàn bộ tóc sẽ bị cạo. Phẫu thuật tiêu chuẩn được gọi là sử', n.prognosis = 'Trong hầu hết các trường hợp, kết quả của việc sửa chữa chứng dính khớp sọ là tốt.';
MERGE (n:Disease {id: 'D0765'}) SET n.id = 'D0765', n.name = 'Craniotabes', n.name_en = 'Craniotabes', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001591.htm', n.prognosis = 'Complete healing is expected.', n.when_to_see = 'Vấn đề này thường được phát hiện nhiều nhất khi trẻ được khám trong quá trình kiểm tra sức khỏe trẻ. Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn nhận thấy con mình có dấu hiệu bị bệ';
MERGE (n:Disease {id: 'D0766'}) SET n.id = 'D0766', n.name = 'Phát ban lan rộng', n.name_en = 'Creeping eruption', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001454.htm', n.prognosis = 'Vụ phun trào leo thang thường tự biến mất sau nhiều tuần đến nhiều tháng. Điều trị bằng thuốc chống ký sinh trùng giúp nhiễm trùng khỏi nhanh hơn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc con bạn có vết loét trên da: Ngứa như rắn Di chuyển từ vùng này sang vùng khác';
MERGE (n:Disease {id: 'D0767'}) SET n.id = 'D0767', n.name = 'Bệnh Creutzfeldt-Jakob', n.name_en = 'Creutzfeldt-Jakob disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/creutzfeldt-jakob-disease/symptoms-causes/syc-20371226 | https://medlineplus.gov/ency/article/000788.htm', n.overview = 'Bệnh Creutzfeldt-Jakob (KROITS-felt YAH-kobe), còn được gọi là CJD, là một chứng rối loạn não hiếm gặp dẫn đến chứng mất trí nhớ. Nó thuộc về một nhóm bệnh ở người và động vật được gọi là rối loạn pri', n.prognosis = 'Kết quả của CJD rất kém. Những người mắc bệnh CJD lẻ tẻ không thể tự chăm sóc bản thân trong vòng 6 tháng hoặc ít hơn sau khi các triệu chứng bắt đầu. Rối loạn này gây tử vong trong thời gian ngắn, th', n.when_to_see = 'CJD không phải là trường hợp cấp cứu y tế. Tuy nhiên, chẩn đoán và điều trị sớm có thể giúp kiểm soát các triệu chứng dễ dàng hơn, giúp mọi người có thời gian đưa ra chỉ dẫn trước và chuẩn bị cho giai';
MERGE (n:Disease {id: 'D0768'}) SET n.id = 'D0768', n.name = 'Hội chứng Cri du chat', n.name_en = 'Cri du chat syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001593.htm', n.prognosis = 'Khuyết tật trí tuệ là tình trạng phổ biến. Một nửa số trẻ mắc hội chứng này học đủ kỹ năng ngôn ngữ để giao tiếp. Tiếng kêu giống như tiếng mèo trở nên ít được chú ý hơn theo thời gian.', n.when_to_see = 'Hội chứng này thường được chẩn đoán nhất khi mới sinh. Nhà cung cấp của bạn sẽ thảo luận về các triệu chứng của con bạn với bạn. Điều quan trọng là tiếp tục thăm khám thường xuyên với các nhà cung cấp';
MERGE (n:Disease {id: 'D0769'}) SET n.id = 'D0769', n.name = 'Hội chứng Crigler-Najjar', n.name_en = 'Crigler-Najjar syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001127.htm', n.prognosis = 'Các dạng bệnh nhẹ hơn (loại II) không gây tổn thương gan hoặc thay đổi suy nghĩ trong thời thơ ấu. Những người bị ảnh hưởng ở dạng nhẹ vẫn bị vàng da, nhưng họ có ít triệu chứng hơn và ít tổn thương n', n.when_to_see = 'Hãy tìm kiếm sự tư vấn về di truyền nếu bạn dự định có con và có tiền sử cá nhân hoặc gia đình mắc bệnh Crigler-Najjar. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khoẻ của bạn nếu bạn hoặc trẻ sơ s';
MERGE (n:Disease {id: 'D0770'}) SET n.id = 'D0770', n.name = 'Bệnh Crohn', n.name_en = 'Crohn disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000249.htm', n.prognosis = 'Không có cách chữa trị bệnh Crohn. Tuy nhiên, mục tiêu của việc điều trị là làm dịu cơn bệnh và giữ cho nó im lặng. Phẫu thuật được sử dụng trong những tình huống cụ thể nhưng không chữa khỏi bệnh Cro', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn: Đau bụng dữ dội Không thể kiểm soát bệnh tiêu chảy bằng cách thay đổi chế độ ăn uống và dùng thuốc Đã giảm cân hoặc con bạn mắc bệnh Crohn k';
MERGE (n:Disease {id: 'D0771'}) SET n.id = 'D0771', n.name = 'Croup', n.name_en = 'Croup', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/croup/symptoms-causes/syc-20350348 | https://medlineplus.gov/ency/article/000959.htm', n.overview = 'đề cập đến tình trạng nhiễm trùng đường hô hấp trên, đường hô hấp trên trở nên hẹp lại, khiến bạn khó thở hơn. Croup cũng gây ra tiếng ho giống như tiếng sủa. Ho và các dấu hiệu, triệu chứng khác của ', n.prognosis = 'Croup thường nhẹ nhưng vẫn có thể nguy hiểm. Nó thường biến mất sau 3 đến 7 ngày. Trong một số trường hợp viêm thanh quản nghiêm trọng không cần chăm sóc tại phòng cấp cứu, một đợt ngắn glucocorticoid', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu các triệu chứng nghiêm trọng, trầm trọng hơn, kéo dài hơn 3 đến 5 ngày hoặc không đáp ứng với điều trị tại nhà. Hãy tìm kiếm sự c';
MERGE (n:Disease {id: 'D0772'}) SET n.id = 'D0772', n.name = 'Khóc khi còn nhỏ', n.name_en = 'Crying in infancy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002397.htm', n.overview = 'Tiếng khóc là giao tiếp bằng lời nói đầu tiên của trẻ sơ sinh. Đó là một thông điệp khẩn cấp hoặc đau khổ. Âm thanh là cách tự nhiên để đảm bảo rằng người lớn chăm sóc trẻ càng nhanh càng tốt. Hầu hết';
MERGE (n:Disease {id: 'D0773'}) SET n.id = 'D0773', n.name = 'Cryoglobulinemia', n.name_en = 'Cryoglobulinemia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cryoglobulinemia/symptoms-causes/syc-20371244 | https://medlineplus.gov/ency/article/000540.htm', n.overview = 'là một nhóm bệnh hiếm gặp, được gọi là viêm mạch. Viêm mạch gây kích ứng và sưng tấy, gọi là viêm, các mạch máu. Cryoglobulin là những protein không điển hình trong máu. Đối với những người mắc bệnh c', n.prognosis = 'Trong hầu hết các trường hợp, bệnh cryoglobulin máu hỗn hợp không dẫn đến tử vong. Triển vọng có thể kém nếu thận bị ảnh hưởng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn xuất hiện các triệu chứng của bệnh cryoglobulin máu. Bạn bị viêm gan C và phát triển các triệu chứng của bệnh cryoglobulin máu. Bạn bị bệnh huyết ';
MERGE (n:Disease {id: 'D0774'}) SET n.id = 'D0774', n.name = 'Liệu pháp áp lạnh cho da', n.name_en = 'Cryotherapy for the skin', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007506.htm', n.overview = 'Liệu pháp áp lạnh được thực hiện bằng cách sử dụng tăm bông nhúng vào nitơ lỏng hoặc đầu dò có nitơ lỏng chảy qua. Thủ tục được thực hiện tại văn phòng của nhà cung cấp dịch vụ chăm sóc sức khỏe của b', n.prognosis = 'Vùng được điều trị có thể có màu đỏ sau khi thực hiện. Một vết phồng rộp thường sẽ hình thành trong vòng vài giờ. Nó có thể trông trong suốt hoặc có màu đỏ hoặc tím. Bạn có thể bị đau nhẹ trong tối đa';
MERGE (n:Disease {id: 'D0775'}) SET n.id = 'D0775', n.name = 'Cryptococcosis', n.name_en = 'Cryptococcosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001328.htm', n.prognosis = 'Sự liên quan đến hệ thần kinh trung ương thường gây tử vong hoặc dẫn đến tổn thương vĩnh viễn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn phát triển các triệu chứng của bệnh cryptococcosis, đặc biệt nếu bạn có hệ thống miễn dịch suy yếu.';
MERGE (n:Disease {id: 'D0776'}) SET n.id = 'D0776', n.name = 'Viêm ruột do Cryptosporidium', n.name_en = 'Cryptosporidium enteritis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000617.htm', n.prognosis = 'Ở người khỏe mạnh, nhiễm trùng sẽ khỏi nhưng có thể kéo dài đến một tháng. Ở những người có hệ miễn dịch suy yếu, tiêu chảy kéo dài có thể gây sụt cân và suy dinh dưỡng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị tiêu chảy phân nước không hết trong vòng vài ngày, đặc biệt nếu bạn có hệ thống miễn dịch suy yếu.';
MERGE (n:Disease {id: 'D0777'}) SET n.id = 'D0777', n.name = 'Rò rỉ CSF', n.name_en = 'CSF leak', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001068.htm', n.prognosis = 'Triển vọng thường tốt tùy thuộc vào nguyên nhân. Hầu hết các trường hợp đều tự lành mà không có triệu chứng kéo dài. Nếu rò rỉ CSF tiếp tục quay trở lại, áp suất cao của CSF (não úng thủy) có thể là n', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị đau đầu nặng hơn khi ngồi dậy, đặc biệt nếu gần đây bạn bị chấn thương đầu, phẫu thuật hoặc sinh con liên quan đến gây tê ngoài màng cứng. Bạn ';
MERGE (n:Disease {id: 'D0778'}) SET n.id = 'D0778', n.name = 'Rò rỉ CSF (Rò rỉ dịch não tủy)', n.name_en = 'CSF leak (Cerebrospinal fluid leak)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/csf-leak/symptoms-causes/syc-20522246', n.overview = 'Dịch não tủy (CSF) bao quanh não và tủy sống và cung cấp một lớp đệm để bảo vệ chúng khỏi bị thương. Có ba lớp bao quanh tủy sống và não. Khi có một lỗ hoặc vết rách ở lớp ngoài cùng thì sẽ xảy ra rò ';
MERGE (n:Disease {id: 'D0779'}) SET n.id = 'D0779', n.name = 'Độ cong của dương vật', n.name_en = 'Curvature of the penis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001278.htm', n.prognosis = 'Tình trạng có thể trở nên nặng hơn và khiến bạn không thể giao hợp được. Bất lực cũng có thể xảy ra.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có triệu chứng cong dương vật. Cương cứng là đau đớn. Bạn bị đau nhói ở dương vật khi giao hợp, sau đó là sưng và bầm tím dương vật.';
MERGE (n:Disease {id: 'D0780'}) SET n.id = 'D0780', n.name = 'Bệnh Cushing', n.name_en = 'Cushing disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000348.htm', n.prognosis = 'Nếu không được điều trị, bệnh Cushing có thể gây bệnh nặng, thậm chí tử vong. Việc loại bỏ khối u có thể giúp bệnh nhân hồi phục hoàn toàn nhưng khối u có thể phát triển trở lại.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu bạn phát triển các triệu chứng của bệnh Cushing. Nếu bạn đã cắt bỏ khối u tuyến yên, hãy gọi cho bác sĩ nếu bạn có dấu hiệu biến chứng, bao gồm các dấu hiệu cho th';
MERGE (n:Disease {id: 'D0781'}) SET n.id = 'D0781', n.name = 'Hội chứng Cushing', n.name_en = 'Cushing syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cushing-syndrome/symptoms-causes/syc-20351310 | https://medlineplus.gov/ency/article/000410.htm', n.overview = 'khiến khuôn mặt tròn trịa, tăng cân quanh bụng và lưng trên, tay và chân gầy hơn, dễ bầm tím và rạn da. Hội chứng Cushing xảy ra khi cơ thể có quá nhiều hormone cortisol trong thời gian dài. Điều này ', n.prognosis = 'Việc loại bỏ khối u có thể dẫn đến sự hồi phục hoàn toàn, nhưng có khả năng tình trạng bệnh sẽ quay trở lại. Khả năng sống sót của người mắc hội chứng Cushing do khối u gây ra phụ thuộc vào loại khối ', n.when_to_see = 'Gọi cho nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của hội chứng Cushing, đặc biệt nếu bạn đang dùng thuốc glucocorticoid để điều trị các vấn đề sức khỏe như hen suyễn, ';
MERGE (n:Disease {id: 'D0782'}) SET n.id = 'D0782', n.name = 'Hội chứng Cushing do khối u tuyến thượng thận', n.name_en = 'Cushing syndrome due to adrenal tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000407.htm', n.prognosis = 'Những người có khối u tuyến thượng thận được phẫu thuật sẽ có triển vọng tốt hơn. Đối với ung thư tuyến thượng thận, phẫu thuật đôi khi không thể thực hiện được. Khi phẫu thuật được thực hiện, không p', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn phát triển bất kỳ triệu chứng nào của hội chứng Cushing.';
MERGE (n:Disease {id: 'D0783'}) SET n.id = 'D0783', n.name = 'Ung thư hạch tế bào B ở da', n.name_en = 'Cutaneous B-cell lymphoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cutaneous-b-cell-lymphoma/symptoms-causes/syc-20577439', n.overview = 'một loại ung thư bắt đầu từ các tế bào bạch cầu và tấn công da. Nó xuất hiện chủ yếu ở da đầu, mặt, trán và thân. Ung thư hạch tế bào B ở da là một loại ung thư hiếm gặp bắt đầu từ các tế bào bạch cầu', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0784'}) SET n.id = 'D0784', n.name = 'Thẻ da', n.name_en = 'Cutaneous skin tag', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000848.htm', n.prognosis = 'Một miếng da dư thường vô hại ( lành tính ). Nó có thể bị kích ứng nếu quần áo cọ xát vào nó. Trong hầu hết các trường hợp, sự tăng trưởng thường không phát triển trở lại sau khi bị loại bỏ. Tuy nhiên', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu thẻ da thay đổi hoặc nếu bạn muốn xóa nó. Đừng tự cắt nó, vì nó có thể chảy máu rất nhiều.';
MERGE (n:Disease {id: 'D0785'}) SET n.id = 'D0785', n.name = 'U lympho tế bào T ở da', n.name_en = 'Cutaneous T-cell lymphoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cutaneous-t-cell-lymphoma/symptoms-causes/syc-20351056', n.overview = 'là một loại ung thư hiếm gặp bắt đầu từ các tế bào bạch cầu. Ung thư ảnh hưởng đến các tế bào bạch cầu gọi là tế bào T, còn gọi là tế bào lympho T. Những tế bào này giúp hệ thống miễn dịch chống lại v', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có các triệu chứng khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D0786'}) SET n.id = 'D0786', n.name = 'Ngộ độc chất tẩy biểu bì', n.name_en = 'Cuticle remover poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002695.htm', n.prognosis = 'Một người khỏe mạnh như thế nào tùy thuộc vào lượng chất tẩy lớp biểu bì mà họ nuốt vào và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Loại ngộ độc này có thể gâ';
MERGE (n:Disease {id: 'D0787'}) SET n.id = 'D0787', n.name = 'Vết cắt và vết thương thủng', n.name_en = 'Cuts and puncture wounds', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000043.htm', n.when_to_see = 'Hãy gọi 911 hoặc số điện thoại cấp cứu tại địa phương nếu: Chảy máu nghiêm trọng hoặc không thể cầm được (ví dụ: sau 10 phút bị ép). Người đó không thể cảm nhận được vùng bị thương hoặc nó không hoạt ';
MERGE (n:Disease {id: 'D0788'}) SET n.id = 'D0788', n.name = 'Ngộ độc Cyanoacrylate', n.name_en = 'Cyanoacrylates poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002894.htm', n.prognosis = 'Tình trạng của một người có khỏe mạnh hay không phụ thuộc vào lượng cyanoacrylate đã nuốt vào và tốc độ điều trị được tiếp nhận như thế nào. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. C';
MERGE (n:Disease {id: 'D0789'}) SET n.id = 'D0789', n.name = 'Bệnh tim tím tái', n.name_en = 'Cyanotic heart disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001104.htm', n.prognosis = 'Triển vọng phụ thuộc vào chứng rối loạn cụ thể và mức độ nghiêm trọng của nó.', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu con bạn có: Da xanh (tím tái) hoặc da xám Khó thở Đau ngực hoặc các cơn đau khác Chóng mặt, ngất xỉu hoặc tim đập nhanh Các ';
MERGE (n:Disease {id: 'D0790'}) SET n.id = 'D0790', n.name = 'Hội chứng nôn theo chu kỳ', n.name_en = 'Cyclic vomiting syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cyclic-vomiting-syndrome/symptoms-causes/syc-20352161', n.overview = 'là tình trạng gây ra các cơn buồn nôn và nôn dữ dội đột ngột. Các đợt bệnh có thể kéo dài hàng giờ hoặc hàng ngày và xen kẽ với các giai đoạn không có triệu chứng có thể kéo dài vài tuần đến vài tháng', n.when_to_see = 'Hãy gọi cho chuyên gia chăm sóc sức khỏe nếu bạn thấy máu trong chất nôn của bạn hoặc con bạn. Nôn liên tục có thể gây mất nước nghiêm trọng, đe dọa tính mạng. Hãy gọi cho chuyên gia y tế nếu bạn hoặc';
MERGE (n:Disease {id: 'D0791'}) SET n.id = 'D0791', n.name = 'Cyclothymia (rối loạn cyclothymic)', n.name_en = 'Cyclothymia (cyclothymic disorder)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cyclothymia/symptoms-causes/syc-20371275', n.overview = 'Cyclothymia (sy-kloe-THIE-me-uh), còn được gọi là rối loạn cyclothymic, là một chứng rối loạn tâm trạng hiếm gặp. Cyclothymia gây ra những thăng trầm về cảm xúc, nhưng chúng không nghiêm trọng như rối', n.when_to_see = 'Nếu bạn có bất kỳ triệu chứng nào của chứng tâm tính xoay chuyển, hãy tìm kiếm sự trợ giúp y tế càng sớm càng tốt. Cyclothymia thường không tự khỏi. Nếu bạn ngần ngại tìm cách điều trị, hãy lấy hết ca';
MERGE (n:Disease {id: 'D0792'}) SET n.id = 'D0792', n.name = 'Rối loạn tâm trạng chu kỳ', n.name_en = 'Cyclothymic disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001550.htm', n.prognosis = 'Chưa đến một nửa số người mắc chứng rối loạn tâm tính chu kỳ tiếp tục phát triển chứng rối loạn lưỡng cực. Ở những người khác, chứng tâm tính xoay chuyển tiếp tục như một tình trạng mãn tính hoặc biến', n.when_to_see = 'Hãy liên hệ với chuyên gia sức khỏe tâm thần nếu bạn hoặc người thân có những giai đoạn trầm cảm và phấn khích xen kẽ không biến mất và ảnh hưởng đến công việc, trường học hoặc đời sống xã hội. Nếu bạ';
MERGE (n:Disease {id: 'D0793'}) SET n.id = 'D0793', n.name = 'Quá liều Cyproheptadine', n.name_en = 'Cyproheptadine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002617.htm', n.prognosis = 'Nếu người đó sống sót sau 24 giờ đầu tiên, khả năng sống sót là có thể. Rất ít người thực sự chết vì dùng thuốc kháng histamine quá liều. Thuốc kháng histamine liều rất cao có thể gây rối loạn nhịp ti';
MERGE (n:Disease {id: 'D0794'}) SET n.id = 'D0794', n.name = 'Xơ nang', n.name_en = 'Cystic fibrosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cystic-fibrosis/symptoms-causes/syc-20353700 | https://medlineplus.gov/ency/article/000107.htm', n.overview = 'Xơ nang là gì? Chuyên gia của Mayo Clinic giải thích Tìm hiểu thêm từ bác sĩ phổi Sarah Chalmers, M.D. Hiển thị bản ghi video Bệnh xơ nang là gì? Một chuyên gia của Mayo Clinic giải thích Xin chào. Tô', n.prognosis = 'Hầu hết trẻ em bị CF đều có sức khỏe tốt cho đến khi trưởng thành. Các em có thể tham gia hầu hết các hoạt động và đi học. Nhiều thanh niên có CF học xong đại học hoặc tìm được việc làm. Bệnh phổi cuố', n.when_to_see = 'Nếu bạn hoặc con bạn có các triệu chứng của bệnh xơ nang - hoặc nếu ai đó trong gia đình bạn mắc bệnh CF - hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn về việc xét nghiệm tình trạng này. Hẹ';
MERGE (n:Disease {id: 'D0795'}) SET n.id = 'D0795', n.name = 'U nang hygroma', n.name_en = 'Cystic hygroma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000148.htm', n.prognosis = 'Triển vọng là tốt nếu phẫu thuật có thể loại bỏ hoàn toàn các mô bất thường. Trong trường hợp không thể loại bỏ hoàn toàn, u nang thường quay trở lại. Kết quả lâu dài cũng có thể phụ thuộc vào những b', n.when_to_see = 'Nếu bạn nhận thấy có khối u ở cổ hoặc cổ của con bạn, hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn.';
MERGE (n:Disease {id: 'D0796'}) SET n.id = 'D0796', n.name = 'Bệnh giun sán', n.name_en = 'Cysticercosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000627.htm', n.prognosis = 'Triển vọng là tốt, trừ khi tổn thương gây mù, suy tim hoặc tổn thương não. Đây là những biến chứng hiếm gặp.', n.when_to_see = 'Nếu bạn có bất kỳ triệu chứng nào của bệnh giun sán, hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn.';
MERGE (n:Disease {id: 'D0797'}) SET n.id = 'D0797', n.name = 'Cystinuria', n.name_en = 'Cystinuria', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000346.htm', n.prognosis = 'Cystinuria là một tình trạng mãn tính kéo dài suốt đời. Nếu không điều trị, sỏi thường quay trở lại. Tuy nhiên, tình trạng này hiếm khi dẫn đến suy thận. Nó không ảnh hưởng đến các cơ quan khác.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của sỏi đường tiết niệu.';
MERGE (n:Disease {id: 'D0798'}) SET n.id = 'D0798', n.name = 'Viêm bàng quang', n.name_en = 'Cystitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cystitis/symptoms-causes/syc-20371306', n.overview = '(sis-TIE-tis) là thuật ngữ y học chỉ tình trạng viêm bàng quang. Viêm là khi một phần cơ thể bạn bị sưng và nóng. Nó cũng có thể đau đớn. Thông thường, viêm bàng quang xảy ra khi có nhiễm trùng do vi ', n.when_to_see = 'Nhận trợ giúp y tế ngay lập tức nếu bạn có các dấu hiệu và triệu chứng thường gặp của nhiễm trùng thận. Chúng bao gồm: Đau lưng hoặc đau bên hông Sốt và ớn lạnh Buồn nôn và nôn Nếu bạn đi tiểu gấp, th';
MERGE (n:Disease {id: 'D0799'}) SET n.id = 'D0799', n.name = 'Viêm bàng quang - cấp tính', n.name_en = 'Cystitis - acute', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000526.htm', n.prognosis = 'Hầu hết các trường hợp viêm bàng quang đều gây khó chịu nhưng sẽ tự khỏi sau khi điều trị mà không để lại biến chứng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn: Có các triệu chứng của bệnh viêm bàng quang Đã được chẩn đoán và các triệu chứng trở nên trầm trọng hơn Phát triển các triệu chứng mới như sốt, đa';
MERGE (n:Disease {id: 'D0800'}) SET n.id = 'D0800', n.name = 'Viêm bàng quang - không nhiễm trùng', n.name_en = 'Cystitis - noninfectious', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000514.htm', n.prognosis = 'Hầu hết các trường hợp viêm bàng quang đều gây khó chịu nhưng các triệu chứng thường thuyên giảm theo thời gian. Các triệu chứng có thể cải thiện nếu bạn có thể xác định và tránh các tác nhân kích thí', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn có các triệu chứng của bệnh viêm bàng quang Bạn đã được chẩn đoán mắc bệnh viêm bàng quang và các triệu chứng của bạn trở nên tr';
MERGE (n:Disease {id: 'D0801'}) SET n.id = 'D0801', n.name = 'Nhiễm Cytomegalovirus (CMV)', n.name_en = 'Cytomegalovirus (CMV) infection', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cmv/symptoms-causes/syc-20355358 | https://medlineplus.gov/ency/article/000568.htm', n.overview = 'Nhiễm cytomegalovirus (CMV) là tình trạng do một loại virus thông thường gây ra. Virus CMV tồn tại trong cơ thể suốt đời sau khi bị nhiễm bệnh. CMV lây lan từ người này sang người khác qua dịch cơ thể', n.prognosis = 'Kết quả điều trị là tốt. Các triệu chứng có thể thuyên giảm sau vài tuần đến vài tháng.', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu: Bạn có hệ miễn dịch yếu và có các triệu chứng nhiễm CMV. Nếu không điều trị, nhiễm CMV có thể nghiêm trọng hoặc thậm chí gây tử vong đối với một số ng';
MERGE (n:Disease {id: 'D0802'}) SET n.id = 'D0802', n.name = 'D và C', n.name_en = 'D and C', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002914.htm', n.overview = ', còn được gọi là cạo tử cung, có thể được thực hiện tại bệnh viện hoặc tại phòng khám khi bạn đang được gây mê toàn thân hoặc cục bộ. Nhà cung cấp dịch vụ chăm sóc sức khỏe sẽ đưa một dụng cụ gọi là ';
MERGE (n:Disease {id: 'D0803'}) SET n.id = 'D0803', n.name = 'Viêm dacryoaden', n.name_en = 'Dacryoadenitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001625.htm', n.prognosis = 'Hầu hết mọi người sẽ hồi phục hoàn toàn sau bệnh viêm dacryoaden. Đối với các nguyên nhân nghiêm trọng hơn, chẳng hạn như bệnh sarcoidosis, triển vọng phụ thuộc vào căn bệnh gây ra tình trạng này.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu sưng hoặc đau tăng lên mặc dù đã điều trị.';
MERGE (n:Disease {id: 'D0804'}) SET n.id = 'D0804', n.name = 'Gàu', n.name_en = 'Dandruff', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dandruff/symptoms-causes/syc-20353850', n.overview = 'là một tình trạng phổ biến khiến những mảng da khô nhỏ bong ra khỏi da đầu. Nó không truyền nhiễm hoặc có hại. Nhưng nó có thể gây xấu hổ và khó điều trị. Bạn có thể điều trị gàu nhẹ bằng cách gội đầu', n.when_to_see = 'Gàu thường không cần điều trị y tế. Nhưng nếu việc sử dụng thường xuyên dầu gội trị gàu không cải thiện, hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin';
MERGE (n:Disease {id: 'D0805'}) SET n.id = 'D0805', n.name = 'Viêm bao gân De Quervain', n.name_en = 'De Quervain tenosynovitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/de-quervain-tenosynovitis/symptoms-causes/syc-20371332', n.overview = '(dih-kwer-VAIN ten-oh-sine-oh-VIE-tis) là một tình trạng đau đớn ảnh hưởng đến gân ở phía ngón tay cái của cổ tay. Nếu bạn bị viêm bao gân De Quervain, bạn thường cảm thấy đau khi xoay cổ tay, nắm chặ', n.when_to_see = 'Hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu bạn vẫn bị đau hoặc gặp khó khăn khi sử dụng ngón tay cái sau khi thử các cách sau: Để ngón cái nghỉ ngơi và tránh các hoạt động gây đau. Ch';
MERGE (n:Disease {id: 'D0806'}) SET n.id = 'D0806', n.name = 'Tư thế mất não', n.name_en = 'Decerebrate posture', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003299.htm', n.when_to_see = 'Tư thế bất thường do bất kỳ nguyên nhân nào loại thường xảy ra với mức độ tỉnh táo giảm. Bất cứ ai có tư thế bất thường đều cần được chăm sóc y tế khẩn cấp.';
MERGE (n:Disease {id: 'D0807'}) SET n.id = 'D0807', n.name = 'Tư thế mất vỏ', n.name_en = 'Decorticate posture', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003300.htm', n.when_to_see = 'Tư thế bất thường thường thuộc bất kỳ loại nào xảy ra với mức độ tỉnh táo giảm. Bất cứ ai có tư thế bất thường đều cần được chăm sóc y tế khẩn cấp.';
MERGE (n:Disease {id: 'D0808'}) SET n.id = 'D0808', n.name = 'Giảm tỉnh táo', n.name_en = 'Decreased alertness', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003202.htm', n.when_to_see = 'Nhận trợ giúp y tế nếu ai đó bị giảm tỉnh táo mà không thể giải thích được. Gọi 911 hoặc số khẩn cấp tại địa phương nếu tình trạng tỉnh táo bình thường không nhanh chóng trở lại.';
MERGE (n:Disease {id: 'D0809'}) SET n.id = 'D0809', n.name = 'Kích thích não sâu', n.name_en = 'Deep brain stimulation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007453.htm', n.overview = 'Hệ thống DBS bao gồm bốn phần: Một hoặc nhiều dây cách điện được gọi là dây dẫn hoặc điện cực, được đặt vào não Các neo để cố định dây dẫn vào hộp sọ Bộ kích thích thần kinh, giúp phát ra dòng điện. M', n.prognosis = 'Những người có DBS thường tiến triển tốt trong quá trình phẫu thuật. Nhiều người có sự cải thiện lớn về triệu chứng và chất lượng cuộc sống. Hầu hết mọi người vẫn cần dùng thuốc nhưng với liều lượng t';
MERGE (n:Disease {id: 'D0810'}) SET n.id = 'D0810', n.name = 'Huyết khối tĩnh mạch sâu', n.name_en = 'Deep vein thrombosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000156.htm', n.prognosis = 'DVT thường biến mất mà không có vấn đề gì, nhưng tình trạng này có thể quay trở lại. Các triệu chứng có thể xuất hiện ngay lập tức hoặc bạn có thể không phát triển chúng trong một hoặc nhiều năm sau đ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của DVT. Hãy đến phòng cấp cứu hoặc gọi số cấp cứu tại địa phương (chẳng hạn như 911) nếu bạn bị DVT và bạn phát triển: Đau ngực';
MERGE (n:Disease {id: 'D0811'}) SET n.id = 'D0811', n.name = 'Huyết khối tĩnh mạch sâu (DVT)', n.name_en = 'Deep vein thrombosis (DVT)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/deep-vein-thrombosis/symptoms-causes/syc-20352557', n.overview = 'xảy ra khi cục máu đông (huyết khối) hình thành ở một hoặc nhiều tĩnh mạch sâu trong cơ thể, thường là ở chân. Huyết khối tĩnh mạch sâu có thể gây đau chân hoặc sưng tấy. Đôi khi không có triệu chứng ', n.when_to_see = 'Nếu bạn xuất hiện các triệu chứng của huyết khối tĩnh mạch sâu (DVT), hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Nếu bạn xuất hiện các triệu chứng của thuyên tắc phổi (PE) - một b';
MERGE (n:Disease {id: 'D0812'}) SET n.id = 'D0812', n.name = 'Mất nước', n.name_en = 'Dehydration', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/dehydration/symptoms-causes/syc-20354086 | https://medlineplus.gov/ency/article/000982.htm', n.overview = 'xảy ra khi cơ thể sử dụng hoặc mất nhiều chất lỏng hơn lượng nó lấy vào. Khi đó cơ thể không có đủ nước và các chất lỏng khác để thực hiện công việc bình thường. Không thay thế chất lỏng bị mất dẫn đế', n.prognosis = 'Nếu nhận thấy dấu hiệu mất nước và điều trị nhanh chóng thì bạn nên bình phục hoàn toàn.', n.when_to_see = 'Bạn nên gọi 911 hoặc số khẩn cấp tại địa phương nếu: Người đó bất tỉnh bất cứ lúc nào. Có bất kỳ thay đổi nào khác về mức độ tỉnh táo của người đó (ví dụ: lú lẫn hoặc co giật). Người đó bị sốt trên 10';
MERGE (n:Disease {id: 'D0813'}) SET n.id = 'D0813', n.name = 'Xuất tinh chậm', n.name_en = 'Delayed ejaculation', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/delayed-ejaculation/symptoms-causes/syc-20371358 | https://medlineplus.gov/ency/article/001954.htm', n.overview = 'là tình trạng phải mất một thời gian dài hưng phấn tình dục mới đạt đến cao trào và phóng tinh dịch ra khỏi dương vật, gọi là xuất tinh. Một số người bị xuất tinh chậm không thể xuất tinh được. Xuất t', n.prognosis = 'Điều trị thường cần khoảng 12 đến 18 buổi. Tỷ lệ thành công trung bình là 70% đến 80%. Bạn sẽ có kết quả tốt hơn nếu: Bạn có quá khứ từng trải nghiệm tình dục thỏa mãn. Vấn đề đã không xảy ra trong mộ', n.when_to_see = 'Chuyên gia chăm sóc sức khỏe chính của bạn là nơi tốt để bắt đầu khi bạn bị chậm xuất tinh. Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu: Xuất tinh chậm là một vấn đề đối với bạn hoặc bạn tình của';
MERGE (n:Disease {id: 'D0814'}) SET n.id = 'D0814', n.name = 'Chậm tăng trưởng', n.name_en = 'Delayed growth', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003021.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn lo lắng về sự phát triển của con bạn. Đánh giá y tế rất quan trọng ngay cả khi bạn cho rằng sự chậm phát triển hoặc các vấn đề về cảm xúc có thể góp phần k';
MERGE (n:Disease {id: 'D0815'}) SET n.id = 'D0815', n.name = 'Dậy thì muộn ở bé trai', n.name_en = 'Delayed puberty in boys', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007695.htm', n.prognosis = 'Dậy thì muộn diễn ra trong gia đình sẽ tự khỏi. Điều trị bằng hormone sinh dục nam có thể kích thích dậy thì. Hormon cũng có thể được cung cấp nếu cần thiết để cải thiện khả năng sinh sản.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Con bạn có tốc độ tăng trưởng chậm Tuổi dậy thì không bắt đầu trước 14 tuổi Tuổi dậy thì bắt đầu nhưng không tiến triển bình thường Có thể nên giới thiệu ';
MERGE (n:Disease {id: 'D0816'}) SET n.id = 'D0816', n.name = 'Dậy thì muộn ở bé gái', n.name_en = 'Delayed puberty in girls', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007694.htm', n.prognosis = 'Dậy thì muộn diễn ra trong gia đình sẽ tự khỏi. Một số cô gái mắc một số bệnh lý nhất định, chẳng hạn như những cô gái bị tổn thương buồng trứng, có thể cần phải sử dụng hormone suốt đời.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Con bạn có tốc độ tăng trưởng chậm Tuổi dậy thì không bắt đầu trước 13 tuổi Tuổi dậy thì bắt đầu nhưng không tiến triển bình thường Có thể nên giới thiệu đến bác ';
MERGE (n:Disease {id: 'D0817'}) SET n.id = 'D0817', n.name = 'Giai đoạn ngủ bị trì hoãn', n.name_en = 'Delayed sleep phase', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/delayed-sleep-phase/symptoms-causes/syc-20353340', n.overview = 'là tình trạng ảnh hưởng đến đồng hồ sinh học bên trong cơ thể, được gọi là nhịp sinh học. Những người có giai đoạn ngủ muộn có kiểu ngủ xảy ra muộn hơn hai giờ hoặc hơn so với kiểu ngủ thông thường. H', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn có các triệu chứng dai dẳng của giai đoạn ngủ muộn. Hoặc hẹn khám cho con nếu bạn cho rằng con mình có những triệu chứng này và chúng không biến mất. Ngoài';
MERGE (n:Disease {id: 'D0818'}) SET n.id = 'D0818', n.name = 'Mê sảng', n.name_en = 'Delirium', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/delirium/symptoms-causes/syc-20371386 | https://medlineplus.gov/ency/article/000740.htm', n.overview = 'là một sự thay đổi nghiêm trọng về khả năng tinh thần. Nó khiến con người trở nên bối rối và không nhận thức được xung quanh. Tình trạng này diễn ra nhanh chóng. Thông thường, các triệu chứng xuất hiệ', n.prognosis = 'Các tình trạng cấp tính gây mê sảng có thể xảy ra cùng với các chứng rối loạn ( mãn tính ) lâu dài gây ra chứng mất trí nhớ . Hội chứng não cấp tính có thể hồi phục bằng cách điều trị nguyên nhân. Mê ', n.when_to_see = 'Nếu một thành viên trong gia đình, bạn bè hoặc người mà bạn hỗ trợ có triệu chứng mê sảng, hãy nói chuyện với chuyên gia chăm sóc sức khỏe của người đó càng sớm càng tốt, đặc biệt nếu có các triệu chứ';
MERGE (n:Disease {id: 'D0819'}) SET n.id = 'D0819', n.name = 'Cơn mê sảng', n.name_en = 'Delirium tremens', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000766.htm', n.prognosis = 'Mê sảng run là tình trạng nghiêm trọng và có thể đe dọa tính mạng. Một số triệu chứng liên quan đến cai rượu có thể kéo dài một năm hoặc hơn, bao gồm: Tâm trạng thất thường Cảm thấy mệt mỏi Mất ngủ', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn có các triệu chứng. Mê sảng run rẩy là một tình trạng khẩn cấp. Nếu bạn đến bệnh viện vì lý do khác, hãy nói với nhà cung cấp ';
MERGE (n:Disease {id: 'D0820'}) SET n.id = 'D0820', n.name = 'Bệnh mất trí nhớ', n.name_en = 'Dementia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/dementia/symptoms-causes/syc-20352013 | https://medlineplus.gov/ency/article/000739.htm', n.overview = 'mô tả một nhóm các triệu chứng ảnh hưởng đến trí nhớ, tư duy và khả năng xã hội. Các triệu chứng can thiệp vào cuộc sống hàng ngày của một người. Chứng mất trí nhớ không phải là một bệnh cụ thể. Một s', n.prognosis = 'Những người mắc MCI không phải lúc nào cũng mắc chứng mất trí nhớ. Khi chứng mất trí xảy ra, nó thường trở nên tồi tệ hơn theo thời gian. Chứng mất trí nhớ thường làm giảm chất lượng cuộc sống và tuổi', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn hoặc người thân gặp vấn đề về trí nhớ hoặc có các triệu chứng sa sút trí tuệ khác. Điều quan trọng là phải xác định nguyên nhân. Một số tình trạng bệnh lý ';
MERGE (n:Disease {id: 'D0821'}) SET n.id = 'D0821', n.name = 'Chứng mất trí nhớ - chăm sóc tại nhà', n.name_en = 'Dementia - home care', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007428.htm', n.overview = 'Người thân mắc chứng mất trí nhớ sẽ cần được hỗ trợ tại nhà khi bệnh trở nên trầm trọng hơn. Bạn có thể giúp đỡ bằng cách cố gắng hiểu cách người mắc chứng sa sút trí tuệ nhìn nhận thế giới của họ. Hã';
MERGE (n:Disease {id: 'D0822'}) SET n.id = 'D0822', n.name = 'Sa sút trí tuệ do nguyên nhân chuyển hóa', n.name_en = 'Dementia due to metabolic causes', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000683.htm', n.prognosis = 'Kết quả khác nhau, tùy thuộc vào nguyên nhân gây ra chứng mất trí nhớ và mức độ tổn thương não.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu các triệu chứng trở nên tồi tệ hơn hoặc tiếp tục. Đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu có sự thay đổi độ';
MERGE (n:Disease {id: 'D0823'}) SET n.id = 'D0823', n.name = 'Sốt xuất huyết', n.name_en = 'Dengue fever', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/dengue-fever/symptoms-causes/syc-20353078 | https://medlineplus.gov/ency/article/001374.htm', n.overview = 'Sốt xuất huyết (DENG-gey) là một bệnh do muỗi truyền xảy ra ở các vùng nhiệt đới và cận nhiệt đới trên thế giới. Sốt xuất huyết nhẹ gây sốt cao và có các triệu chứng giống cúm. Dạng sốt xuất huyết nặn', n.prognosis = 'Các trường hợp sốt xuất huyết nhẹ thường kéo dài một tuần hoặc hơn. Mặc dù khó chịu nhưng sốt xuất huyết nhẹ không gây tử vong. Những người mắc bệnh này sẽ hồi phục hoàn toàn. Ở một số nước Mỹ Latinh ', n.when_to_see = 'Sốt xuất huyết nặng là một trường hợp cấp cứu y tế đe dọa tính mạng. Tìm kiếm sự chăm sóc y tế ngay lập tức nếu gần đây bạn đã đến khu vực được biết là có dịch sốt xuất huyết, bạn bị sốt và xuất hiện ';
MERGE (n:Disease {id: 'D0824'}) SET n.id = 'D0824', n.name = 'Chăm sóc nha khoa - người lớn', n.name_en = 'Dental care - adult', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001957.htm', n.overview = 'CÁCH CHĂM SÓC RĂNG CỦA BẠN Răng khỏe sẽ sạch và không bị sâu răng. Nướu khỏe mạnh có màu hồng, săn chắc và không chảy máu. Để duy trì răng và nướu khỏe mạnh, hãy làm theo các bước sau: Dùng chỉ nha kh';
MERGE (n:Disease {id: 'D0825'}) SET n.id = 'D0825', n.name = 'Chăm sóc nha khoa - trẻ em', n.name_en = 'Dental care - child', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002213.htm', n.overview = 'Con bạn phải có răng và nướu khỏe mạnh để có sức khỏe tổng thể tốt. Răng bị thương, bị bệnh hoặc kém phát triển có thể dẫn đến: Dinh dưỡng kém Nhiễm trùng đau đớn và nguy hiểm Các vấn đề về phát triển';
MERGE (n:Disease {id: 'D0826'}) SET n.id = 'D0826', n.name = 'Sâu răng', n.name_en = 'Dental cavities', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001055.htm', n.prognosis = 'Điều trị thường cứu được răng. Việc điều trị sẽ ít đau đớn và ít tốn kém hơn nếu được thực hiện sớm. Bạn có thể cần thuốc gây tê và thuốc giảm đau theo toa để giảm đau trong hoặc sau khi làm răng. Oxi', n.when_to_see = 'Hãy liên hệ với nha sĩ nếu bạn bị đau răng, khó chịu hoặc nhìn thấy các đốm đen trên răng. Hãy đến gặp nha sĩ để được làm sạch và kiểm tra định kỳ nếu bạn chưa gặp nha sĩ trong 6 tháng qua.';
MERGE (n:Disease {id: 'D0827'}) SET n.id = 'D0827', n.name = 'Mão răng', n.name_en = 'Dental crowns', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007631.htm', n.overview = 'Để bọc mão răng thường phải mất hai lần khám nha khoa. Ở lần khám đầu tiên, nha sĩ sẽ: Gây tê răng cũng như các răng lân cận và nướu xung quanh răng sắp bọc mão để bạn không cảm thấy gì. Loại bỏ bất k', n.prognosis = 'Khi đội mão răng, bạn sẽ cảm thấy thoải mái hơn khi nhai và trông nó sẽ đẹp. Hầu hết các mão răng phải tồn tại ít nhất 5 năm và có thể tồn tại lâu nhất là 15 đến 20 năm.';
MERGE (n:Disease {id: 'D0828'}) SET n.id = 'D0828', n.name = 'Các vấn đề về răng giả', n.name_en = 'Denture problems', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002037.htm', n.overview = 'Răng giả không vừa khít có thể gây khó chịu hoặc kích ứng khi di chuyển. Chúng được gọi là vết đau. Chất kết dính răng giả có thể giúp giảm chuyển động này. Cấy ghép nha khoa có thể được khuyến khích ';
MERGE (n:Disease {id: 'D0829'}) SET n.id = 'D0829', n.name = 'Ngộ độc chất khử mùi', n.name_en = 'Deodorant poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002696.htm', n.prognosis = 'Một người khỏe mạnh đến mức nào tùy thuộc vào lượng chất độc nuốt vào và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Ngộ độc nặng khó có thể xảy ra.';
MERGE (n:Disease {id: 'D0830'}) SET n.id = 'D0830', n.name = 'Rối loạn nhân cách phụ thuộc', n.name_en = 'Dependent personality disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000941.htm', n.prognosis = 'Những cải thiện thường chỉ thấy được khi điều trị lâu dài.', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ của bạn hoặc chuyên gia sức khỏe tâm thần nếu bạn hoặc con bạn có các triệu chứng rối loạn nhân cách phụ thuộc. Nếu bạn hoặc ai đó bạn biết đang nghĩ đến việc tự tử, hãy g';
MERGE (n:Disease {id: 'D0831'}) SET n.id = 'D0831', n.name = 'Rối loạn phi cá nhân hóa-mất thực tế', n.name_en = 'Depersonalization-derealization disorder', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/depersonalization-derealization-disorder/symptoms-causes/syc-20352911', n.overview = 'xảy ra khi bạn luôn hoặc thường xuyên cảm thấy rằng bạn đang nhìn chính mình từ bên ngoài cơ thể hoặc bạn cảm thấy rằng mọi thứ xung quanh mình không có thật - hoặc cả hai. Cảm giác mất cá nhân hóa và', n.when_to_see = 'Việc trải qua cảm giác mất cá nhân hóa hoặc mất thực tế là phổ biến và không phải lúc nào cũng là nguyên nhân gây lo ngại. Nhưng cảm giác tách rời và bóp méo môi trường xung quanh bạn đang diễn ra hoặ';
MERGE (n:Disease {id: 'D0832'}) SET n.id = 'D0832', n.name = 'Ngộ độc thuốc làm rụng lông', n.name_en = 'Depilatory poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002697.htm', n.prognosis = 'Đây có thể là một vụ ngộ độc rất nghiêm trọng. Một người khỏe mạnh đến mức nào tùy thuộc vào lượng chất độc họ nuốt vào và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng';
MERGE (n:Disease {id: 'D0833'}) SET n.id = 'D0833', n.name = 'Trầm cảm', n.name_en = 'Depression', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003213.htm', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Bạn nghe thấy những giọng nói không có ở đó. Bạn thường xuyên khóc mà không có lý do. Chứng trầm cảm của bạn đã ảnh hưởng đến công việc, trường học hoặc cuộc sống';
MERGE (n:Disease {id: 'D0834'}) SET n.id = 'D0834', n.name = 'Trầm cảm (rối loạn trầm cảm nặng)', n.name_en = 'Depression (major depressive disorder)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/depression/symptoms-causes/syc-20356007', n.overview = 'Trầm cảm là gì? Một chuyên gia của Mayo Clinic giải thích. Tìm hiểu thêm về trầm cảm từ Craig Sawchuk, Tiến sĩ, L.P., nhà tâm lý học lâm sàng tại Mayo Clinic. Hiển thị bản ghi cho video Trầm cảm là gì', n.when_to_see = 'Nếu bạn cảm thấy chán nản, hãy hẹn gặp bác sĩ hoặc chuyên gia sức khỏe tâm thần càng sớm càng tốt. Nếu bạn ngần ngại tìm cách điều trị, hãy nói chuyện với bạn bè hoặc người thân, bất kỳ chuyên gia chă';
MERGE (n:Disease {id: 'D0835'}) SET n.id = 'D0835', n.name = 'Trầm cảm ở người lớn tuổi', n.name_en = 'Depression in older adults', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001521.htm', n.prognosis = 'Trầm cảm thường đáp ứng với điều trị. Kết quả thường tốt hơn cho những người có khả năng tiếp cận các dịch vụ xã hội, gia đình và bạn bè, những người có thể giúp họ duy trì hoạt động và gắn kết. Biến ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn tiếp tục cảm thấy buồn, vô dụng hoặc vô vọng hoặc nếu bạn thường xuyên khóc. Đồng thời, hãy gọi nếu bạn gặp khó khăn trong việc đối phó với những căng thẳn';
MERGE (n:Disease {id: 'D0836'}) SET n.id = 'D0836', n.name = 'Mài mòn da', n.name_en = 'Dermabrasion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002987.htm', n.overview = 'thường được thực hiện bởi bác sĩ, bác sĩ phẫu thuật thẩm mỹ hoặc bác sĩ phẫu thuật da liễu. Thủ tục này diễn ra tại phòng khám của bác sĩ hoặc phòng khám ngoại trú. Bạn có thể sẽ tỉnh táo. Một loại th', n.prognosis = 'Nếu da của bạn vẫn đỏ và sưng sau khi quá trình lành vết thương bắt đầu, đó có thể là dấu hiệu cho thấy sẹo bất thường đang hình thành. Hãy cho bác sĩ của bạn nếu điều này xảy ra. Điều trị có thể có s';
MERGE (n:Disease {id: 'D0837'}) SET n.id = 'D0837', n.name = 'Tăng hắc tố da', n.name_en = 'Dermal melanocytosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001472.htm', n.prognosis = 'Những vết bớt là vết bớt bình thường thường mờ đi sau một vài năm. Họ hầu như luôn biến mất ở tuổi thiếu niên.', n.when_to_see = 'Tất cả các vết bớt phải được bác sĩ kiểm tra trong quá trình khám trẻ sơ sinh định kỳ.';
MERGE (n:Disease {id: 'D0838'}) SET n.id = 'D0838', n.name = 'Viêm da', n.name_en = 'Dermatitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dermatitis-eczema/symptoms-causes/syc-20352380', n.overview = 'là một tình trạng phổ biến gây sưng tấy và kích ứng da. Nó có nhiều nguyên nhân và hình thức và thường liên quan đến ngứa, khô da hoặc phát ban. Hoặc nó có thể khiến da bị phồng rộp, rỉ nước, đóng vảy', n.when_to_see = 'Hãy gặp bác sĩ nếu: Bạn cảm thấy khó chịu đến mức tình trạng này ảnh hưởng đến giấc ngủ và các hoạt động hàng ngày. Da của bạn bị đau. Bạn bị nhiễm trùng da - hãy tìm những vệt mới, mủ, vảy màu vàng. ';
MERGE (n:Disease {id: 'D0839'}) SET n.id = 'D0839', n.name = 'Viêm da herpetiformis', n.name_en = 'Dermatitis herpetiformis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001480.htm', n.prognosis = 'Bệnh có thể được kiểm soát tốt bằng điều trị. Nếu không điều trị, có thể có nguy cơ mắc ung thư đường ruột đáng kể.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn vẫn bị phát ban dù đã điều trị.';
MERGE (n:Disease {id: 'D0840'}) SET n.id = 'D0840', n.name = 'Dermatofibrosarcoma protuberans', n.name_en = 'Dermatofibrosarcoma protuberans', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dermatofibrosarcoma-protuberans/symptoms-causes/syc-20576872', n.overview = 'arcoma protuberans phát triển, các khối mô (protuberans) có thể hình thành gần bề mặt da. Giải phẫu da các tuyến, nang lông, tế bào hắc tố và mạch máu. Dermatofibrosarcoma protuberans (DFSP) là một lo', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có các triệu chứng liên tục khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0841'}) SET n.id = 'D0841', n.name = 'Dermatographia (Dermatographism)', n.name_en = 'Dermatographia (Dermatographism)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dermatographia/symptoms-causes/syc-20371411', n.overview = 'Dermatographia bám vào da của bạn gây ra các đường nổi lên, viêm ở nơi bạn gãi. Mặc dù không nghiêm trọng nhưng nó có thể gây khó chịu. Bệnh da liễu là tình trạng gãi nhẹ trên da gây ra các đường hoặc', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu các triệu chứng làm phiền bạn. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin được đánh ';
MERGE (n:Disease {id: 'D0842'}) SET n.id = 'D0842', n.name = 'Viêm da cơ', n.name_en = 'Dermatomyositis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/dermatomyositis/symptoms-causes/syc-20353188 | https://medlineplus.gov/ency/article/000839.htm', n.overview = '(dur-muh-toe-my-uh-SY-tis) là tình trạng sưng tấy và kích ứng, gọi là viêm, tấn công các mô của cơ thể. Viêm da cơ gây yếu cơ và phát ban trên da. Tình trạng này, còn được gọi là tình trạng tự miễn dị', n.prognosis = 'Điều quan trọng là bạn phải được nhà cung cấp dịch vụ chăm sóc sức khỏe theo dõi khi bị viêm da cơ. Bệnh nặng có thể dẫn đến tàn tật và đôi khi có thể dẫn đến tử vong. Các triệu chứng có thể biến mất ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn bị yếu cơ hoặc phát ban mà không rõ nguyên nhân.';
MERGE (n:Disease {id: 'D0843'}) SET n.id = 'D0843', n.name = 'Quá liều desipramine hydrochloride', n.name_en = 'Desipramine hydrochloride overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002626.htm', n.prognosis = 'Quá liều desipramine hydrochloride có thể rất nghiêm trọng. Những người nuốt quá nhiều loại thuốc này hầu như luôn phải nhập viện. Tình trạng sức khỏe của một người sẽ phụ thuộc vào lượng thuốc được n';
MERGE (n:Disease {id: 'D0844'}) SET n.id = 'D0844', n.name = 'Khối u desmoid', n.name_en = 'Desmoid tumors', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/desmoid-tumors/symptoms-causes/syc-20355083', n.overview = 'là sự tăng trưởng không phải ung thư xảy ra trong mô liên kết. Khối u desmoid thường xảy ra nhất ở bụng, cánh tay và chân. Một thuật ngữ khác cho khối u desmoid là u xơ tích cực. Một số khối u desmoid', n.when_to_see = 'Hãy hẹn gặp bác sĩ nếu bạn có bất kỳ dấu hiệu hoặc triệu chứng dai dẳng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0845'}) SET n.id = 'D0845', n.name = 'Khối u tế bào tròn nhỏ Desmoplastic', n.name_en = 'Desmoplastic small round cell tumors', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dsrct/symptoms-causes/syc-20355405', n.overview = 'Desmoplastic (des-moe-PLAS-tik) Khối u tế bào tròn nhỏ (DSRCT) là một loại ung thư thường bắt đầu ở vùng bụng. Đôi khi loại ung thư này có thể xảy ra ở các bộ phận khác của cơ thể. Các khối u tế bào t', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có bất kỳ dấu hiệu và triệu chứng dai dẳng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0846'}) SET n.id = 'D0846', n.name = 'Ngộ độc chất tẩy rửa', n.name_en = 'Detergent poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002777.htm', n.prognosis = 'Tình trạng của người đó phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Người đó nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải những chất độc như ';
MERGE (n:Disease {id: 'D0847'}) SET n.id = 'D0847', n.name = 'Rối loạn phối hợp phát triển', n.name_en = 'Developmental coordination disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001533.htm', n.prognosis = 'Sức khỏe của trẻ phụ thuộc vào mức độ nghiêm trọng của chứng rối loạn. Rối loạn không trở nên tồi tệ hơn theo thời gian. Nó thường tiếp tục đến tuổi trưởng thành.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn lo lắng về sự phát triển của con mình.';
MERGE (n:Disease {id: 'D0848'}) SET n.id = 'D0848', n.name = 'Sự khác biệt về phát triển của đường sinh dục nữ', n.name_en = 'Developmental differences of the female genital tract', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001497.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có: Bộ phận sinh dục không giống nam hay nữ hoặc có các đặc điểm của cả hai đặc điểm của Nam giới Đau vùng chậu hàng tháng và';
MERGE (n:Disease {id: 'D0849'}) SET n.id = 'D0849', n.name = 'Chứng loạn sản xương hông phát triển', n.name_en = 'Developmental dysplasia of the hip', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000971.htm', n.prognosis = 'Nếu phát hiện chứng loạn sản xương hông trong vài tháng đầu đời, bệnh này hầu như luôn có thể được điều trị thành công bằng thiết bị định vị (nẹp). Trong một số trường hợp, cần phải phẫu thuật để đưa ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nghi ngờ hông của con bạn không được đặt đúng vị trí.';
MERGE (n:Disease {id: 'D0850'}) SET n.id = 'D0850', n.name = 'Rối loạn ngôn ngữ biểu cảm phát triển', n.name_en = 'Developmental expressive language disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001544.htm', n.prognosis = 'Trẻ hồi phục bao nhiêu tùy thuộc vào mức độ nghiêm trọng của chứng rối loạn. Với những yếu tố có thể khắc phục được, chẳng hạn như thiếu hụt vitamin, bệnh nhân có thể hồi phục gần như hoàn toàn. Trẻ e', n.when_to_see = 'Nếu bạn lo lắng về sự phát triển ngôn ngữ của con mình, hãy cho chúng kiểm tra.';
