MERGE (n:Disease {id: 'D0967'}) SET n.id = 'D0967', n.name = 'Tai - bị tắc ở độ cao', n.name_en = 'Ear - blocked at high altitudes', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002077.htm', n.overview = 'Ống eustachian là phần kết nối giữa tai giữa (khoảng trống phía sau màng nhĩ) với mặt sau của mũi và phần trên họng. Cấu trúc này kết nối không gian tai giữa với thế giới bên ngoài. Nuốt hoặc ngáp sẽ ';
MERGE (n:Disease {id: 'D0968'}) SET n.id = 'D0968', n.name = 'Chấn thương khí áp tai', n.name_en = 'Ear barotrauma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001064.htm', n.prognosis = 'Barotrauma thường là một tình trạng lành tính, tự giới hạn và đáp ứng với việc tự chăm sóc. Mất thính giác hầu như luôn luôn là tạm thời.', n.when_to_see = 'Hãy thử các biện pháp chăm sóc tại nhà trước. Liên hệ với nhà cung cấp dịch vụ của bạn nếu cảm giác khó chịu không giảm sau vài giờ. Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị chấn thương khí';
MERGE (n:Disease {id: 'D0969'}) SET n.id = 'D0969', n.name = 'Dịch tiết từ tai', n.name_en = 'Ear discharge', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003042.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Chất dịch có màu trắng, vàng, trong hoặc có máu. Việc xả thải là kết quả của một chấn thương. Việc xả thải đã kéo dài hơn 5 ngày. Có';
MERGE (n:Disease {id: 'D0970'}) SET n.id = 'D0970', n.name = 'Trường hợp khẩn cấp về tai', n.name_en = 'Ear emergencies', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000052.htm', n.when_to_see = 'Một số triệu chứng có thể cho thấy tai bạn đã bị thương nặng. Hãy gặp nhà cung cấp nếu bạn gặp: Đau tai Âm thanh ù tai Chóng mặt (chóng mặt) Mất thính lực Chảy nước hoặc máu từ tai Cú đánh gần đây vào';
MERGE (n:Disease {id: 'D0971'}) SET n.id = 'D0971', n.name = 'Nhiễm trùng tai (tai giữa)', n.name_en = 'Ear infection (middle ear)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ear-infections/symptoms-causes/syc-20351616', n.overview = 'Nhiễm trùng tai, còn được gọi là viêm tai giữa cấp tính, là tình trạng nhiễm trùng vùng chứa đầy không khí phía sau màng nhĩ, được gọi là tai giữa. Trẻ em có nhiều khả năng bị nhiễm trùng tai hơn ngườ', n.when_to_see = 'Nhiều tình trạng có triệu chứng nhiễm trùng tai. Điều quan trọng là có được chẩn đoán tốt và điều trị kịp thời. Hãy gọi cho chuyên gia chăm sóc sức khỏe của con bạn nếu có các triệu chứng nghiêm trọng';
MERGE (n:Disease {id: 'D0972'}) SET n.id = 'D0972', n.name = 'Nhiễm trùng tai - cấp tính', n.name_en = 'Ear infection - acute', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000638.htm', n.prognosis = 'Thông thường, nhiễm trùng tai là một vấn đề nhỏ nhưng sẽ thuyên giảm. Nhiễm trùng tai có thể được điều trị nhưng chúng có thể tái phát trong tương lai. Hầu hết trẻ em sẽ bị mất thính lực nhẹ trong thờ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị sưng sau tai. Các triệu chứng của bạn trở nên tồi tệ hơn, ngay cả khi điều trị. Bạn bị sốt cao hoặc đau dữ dội. Cơn đau dữ dội đột ngột dừng lạ';
MERGE (n:Disease {id: 'D0973'}) SET n.id = 'D0973', n.name = 'Nhiễm trùng tai - mãn tính', n.name_en = 'Ear infection - chronic', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000619.htm', n.prognosis = 'Nhiễm trùng tai mãn tính thường đáp ứng với điều trị. Tuy nhiên, con bạn có thể cần tiếp tục dùng thuốc trong vài tháng. Nhiễm trùng tai mãn tính không đe dọa đến tính mạng. Tuy nhiên, chúng có thể gâ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn hoặc con bạn có dấu hiệu nhiễm trùng tai mãn tính Nhiễm trùng tai không đáp ứng với điều trị Các triệu chứng mới phát triển trong hoặc sau khi điề';
MERGE (n:Disease {id: 'D0974'}) SET n.id = 'D0974', n.name = 'Thẻ tai', n.name_en = 'Ear tag', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003304.htm', n.when_to_see = 'Nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn thường sẽ tìm thấy thẻ da trong lần khám sức khỏe đầu tiên cho trẻ. Tuy nhiên, hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn';
MERGE (n:Disease {id: 'D0975'}) SET n.id = 'D0975', n.name = 'Đặt ống tai', n.name_en = 'Ear tube insertion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003015.htm', n.overview = 'Khi trẻ đang ngủ và không bị đau ( gây mê toàn thân ), một vết phẫu thuật nhỏ sẽ được thực hiện ở màng nhĩ. Bất kỳ chất lỏng nào tích tụ phía sau màng nhĩ sẽ được loại bỏ bằng lực hút qua vết cắt này.', n.prognosis = 'Sau thủ thuật này, hầu hết các bậc cha mẹ đều báo cáo rằng con họ: Ít bị nhiễm trùng tai Phục hồi nhanh hơn sau khi bị nhiễm trùng Có thính giác tốt hơn Nếu các ống này không tự rơi ra sau một vài năm';
MERGE (n:Disease {id: 'D0976'}) SET n.id = 'D0976', n.name = 'Ráy tai', n.name_en = 'Ear wax', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000979.htm', n.prognosis = 'Tai có thể lại bị tắc do ráy tai trong tương lai. Mất thính giác thường là tạm thời. Trong hầu hết các trường hợp, thính giác sẽ phục hồi hoàn toàn sau khi loại bỏ vật cản. Người sử dụng máy trợ thính', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ của bạn nếu tai bạn bị tắc bằng ráy tai và bạn không thể loại bỏ ráy tai. Đồng thời, hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị tắc nghẽn ráy tai và xuất hiện';
MERGE (n:Disease {id: 'D0977'}) SET n.id = 'D0977', n.name = 'Đau tai', n.name_en = 'Earache', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003046.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Con bạn bị sốt cao, đau dữ dội hoặc có vẻ ốm hơn bình thường do nhiễm trùng tai. Con bạn có các triệu chứng mới như chóng mặt, nhức ';
MERGE (n:Disease {id: 'D0978'}) SET n.id = 'D0978', n.name = 'Sửa chữa màng nhĩ', n.name_en = 'Eardrum repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003014.htm', n.overview = 'Hầu hết người lớn (và tất cả trẻ em) đều được gây mê toàn thân cho cuộc phẫu thuật này. Điều này có nghĩa là bạn sẽ ngủ và không thể cảm thấy đau. Đôi khi, gây tê cục bộ được sử dụng cùng với thuốc kh', n.prognosis = 'Trong hầu hết các trường hợp, cơn đau và các triệu chứng đều thuyên giảm hoàn toàn. Mất thính giác là nhỏ. Kết quả có thể không tốt nếu xương ở tai giữa cần được tái tạo cùng với màng nhĩ.';
MERGE (n:Disease {id: 'D0979'}) SET n.id = 'D0979', n.name = 'Nếp nhăn dái tai', n.name_en = 'Earlobe creases', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003045.htm', n.when_to_see = 'Trong hầu hết các trường hợp, nhà cung cấp dịch vụ chăm sóc sức khỏe sẽ nhận thấy dái tai có nếp nhăn khi kiểm tra định kỳ. Hãy trao đổi với bác sĩ nếu bạn lo ngại rằng nếp nhăn ở dái tai của con bạn ';
MERGE (n:Disease {id: 'D0980'}) SET n.id = 'D0980', n.name = 'Sự tắc nghẽn ráy tai', n.name_en = 'Earwax blockage', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/earwax-blockage/symptoms-causes/syc-20353004', n.overview = 'xảy ra khi ráy tai, được gọi là ráy tai, tích tụ trong tai của bạn hoặc trở nên quá khó để rửa sạch một cách tự nhiên. Ráy tai là một phần hữu ích và tự nhiên trong cơ chế phòng vệ của cơ thể bạn. Nó ', n.when_to_see = 'Sự tắc nghẽn do ráy tai không có triệu chứng đôi khi có thể tự khỏi. Nhưng nếu bạn có các dấu hiệu và triệu chứng tắc nghẽn ráy tai, hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn. Các dấu hi';
MERGE (n:Disease {id: 'D0981'}) SET n.id = 'D0981', n.name = 'Rối loạn ăn uống', n.name_en = 'Eating disorders', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/eating-disorders/symptoms-causes/syc-20353603', n.overview = 'là tình trạng sức khỏe nghiêm trọng ảnh hưởng đến cả sức khỏe thể chất và tinh thần của bạn. Những tình trạng này bao gồm các vấn đề về cách bạn suy nghĩ về thực phẩm, việc ăn uống, cân nặng và hình d', n.when_to_see = 'Chứng rối loạn ăn uống có thể khó tự mình kiểm soát hoặc khắc phục. Bạn càng được điều trị sớm thì khả năng phục hồi hoàn toàn càng cao. Đôi khi mọi người có thể có vấn đề về hành vi ăn uống tương tự ';
MERGE (n:Disease {id: 'D0982'}) SET n.id = 'D0982', n.name = 'Bệnh do vi rút Ebola', n.name_en = 'Ebola virus disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001339.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn đã đi du lịch đến Tây Phi và: Biết rằng bạn đã tiếp xúc với Ebola Bạn xuất hiện các triệu chứng của chứng rối loạn này, bao gồm cả sốt Việc điều tr';
MERGE (n:Disease {id: 'D0983'}) SET n.id = 'D0983', n.name = 'Dị tật Ebstein', n.name_en = 'Ebstein anomaly', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/ebsteins-anomaly/symptoms-causes/syc-20352127 | https://medlineplus.gov/ency/article/007321.htm', n.overview = 'lúc mới sinh. Điều này có nghĩa đó là một khuyết tật tim bẩm sinh. Van ba lá không hình thành như bình thường. Van tim cũng nằm ở vị trí thấp hơn bình thường. Tình trạng này có thể xảy ra với một lỗ g', n.prognosis = 'Nói chung, các triệu chứng phát triển càng sớm thì bệnh càng nặng. Một số người có thể không có triệu chứng hoặc có triệu chứng rất nhẹ. Những người khác có thể xấu đi theo thời gian, phát triển màu x', n.when_to_see = 'Tình trạng bệnh tim nghiêm trọng ở trẻ thường được chẩn đoán khi sinh hoặc trong khi mang thai. Hẹn khám sức khỏe nếu bạn hoặc con bạn có các triệu chứng của bệnh tim. Những triệu chứng này bao gồm cả';
MERGE (n:Disease {id: 'D0984'}) SET n.id = 'D0984', n.name = 'Bệnh Echinococcosis', n.name_en = 'Echinococcosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000676.htm', n.prognosis = 'Nếu u nang đáp ứng với thuốc uống thì kết quả có thể sẽ tốt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn phát triển các triệu chứng của chứng rối loạn này.';
MERGE (n:Disease {id: 'D0985'}) SET n.id = 'D0985', n.name = 'Virus ECHO', n.name_en = 'ECHO virus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001340.htm', n.prognosis = 'Những người mắc các loại bệnh ít nghiêm trọng hơn sẽ hồi phục hoàn toàn mà không cần điều trị. Nhiễm trùng các cơ quan như tim có thể gây bệnh nặng và có thể gây tử vong.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ triệu chứng nào được liệt kê ở trên.';
MERGE (n:Disease {id: 'D0986'}) SET n.id = 'D0986', n.name = 'Sản giật', n.name_en = 'Eclampsia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000899.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn hoặc đến phòng cấp cứu nếu bạn có bất kỳ triệu chứng sản giật hoặc tiền sản giật nào. Các triệu chứng khẩn cấp bao gồm co giật hoặc giảm tỉnh táo. Hãy tìm ';
MERGE (n:Disease {id: 'D0987'}) SET n.id = 'D0987', n.name = 'Ecthyma', n.name_en = 'Ecthyma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000864.htm', n.prognosis = 'Ecthyma đôi khi có thể để lại sẹo.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh ecthyma.';
MERGE (n:Disease {id: 'D0988'}) SET n.id = 'D0988', n.name = 'Chứng loạn sản ngoài da', n.name_en = 'Ectodermal dysplasias', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001469.htm', n.prognosis = 'Nếu bạn mắc một biến thể phổ biến của chứng loạn sản ngoài tử cung, điều này sẽ không làm giảm tuổi thọ của bạn. Tuy nhiên, bạn có thể cần chú ý đến sự thay đổi nhiệt độ và các vấn đề khác liên quan đ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có các triệu chứng của chứng loạn sản ngoài da.';
MERGE (n:Disease {id: 'D0989'}) SET n.id = 'D0989', n.name = 'Hội chứng Cushing ngoài tử cung', n.name_en = 'Ectopic Cushing syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000406.htm', n.prognosis = 'Phẫu thuật cắt bỏ khối u có thể giúp bệnh nhân hồi phục hoàn toàn. Nhưng có khả năng khối u sẽ quay trở lại.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của hội chứng Cushing.';
MERGE (n:Disease {id: 'D0990'}) SET n.id = 'D0990', n.name = 'Nhịp tim lạc nhịp', n.name_en = 'Ectopic heartbeat', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001100.htm', n.prognosis = 'Trong một số trường hợp, nhịp tim ngoài tử cung có thể có nghĩa là bạn có nguy cơ cao hơn bị nhịp tim bất thường nghiêm trọng, chẳng hạn như nhịp tim nhanh thất .', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn tiếp tục cảm thấy tim mình đập thình thịch hoặc đập nhanh ( đánh trống ngực ). Bạn bị đánh trống ngực kèm theo đau ngực hoặc các triệu chứng khác.';
MERGE (n:Disease {id: 'D0991'}) SET n.id = 'D0991', n.name = 'Mang thai ngoài tử cung', n.name_en = 'Ectopic pregnancy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/ectopic-pregnancy/symptoms-causes/syc-20372088 | https://medlineplus.gov/ency/article/000895.htm', n.overview = 'Quá trình mang thai bắt đầu bằng trứng được thụ tinh. Thông thường, trứng đã thụ tinh sẽ bám vào niêm mạc tử cung. Mang thai ngoài tử cung xảy ra khi trứng được thụ tinh làm tổ và phát triển bên ngoài', n.prognosis = 'Nếu được chẩn đoán sớm thì việc điều trị rất hiệu quả. Điều quan trọng là phải tìm kiếm sự chăm sóc sớm bất cứ khi nào bạn tin rằng mình có thể mang thai để bác sĩ có thể xác định vị trí của thai kỳ. ', n.when_to_see = 'Tìm kiếm trợ giúp y tế khẩn cấp nếu bạn có bất kỳ dấu hiệu hoặc triệu chứng nào của thai ngoài tử cung, bao gồm: Đau bụng hoặc vùng chậu dữ dội kèm theo chảy máu âm đạo Chóng mặt hoặc ngất xỉu Đau vai';
MERGE (n:Disease {id: 'D0992'}) SET n.id = 'D0992', n.name = 'Ectropion', n.name_en = 'Ectropion', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/ectropion/symptoms-causes/syc-20351164 | https://medlineplus.gov/ency/article/001007.htm', n.overview = 'của mí mắt bị xệ xuống, mắt bạn không thể hoàn toàn khi chớp mắt, điều này có thể khiến mắt bị khô và khó chịu. Ectropion (ek-TROH-pee-on) là tình trạng mí mắt của bạn hướng ra ngoài. Điều này khiến b', n.prognosis = 'Kết quả điều trị thường rất tốt.', n.when_to_see = 'Hãy gặp bác sĩ nếu mắt bạn liên tục chảy nước hoặc bị kích ứng, hoặc mí mắt của bạn dường như bị chảy xệ hoặc sụp xuống. Hãy tìm kiếm sự chăm sóc ngay lập tức nếu bạn được chẩn đoán mắc bệnh ectropion';
MERGE (n:Disease {id: 'D0993'}) SET n.id = 'D0993', n.name = 'Phù', n.name_en = 'Edema', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/edema/symptoms-causes/syc-20366493', n.overview = 'là tình trạng sưng tấy do có quá nhiều chất lỏng bị mắc kẹt trong các mô của cơ thể. Phù nề có thể ảnh hưởng đến bất kỳ bộ phận nào của cơ thể. Nhưng nó có nhiều khả năng xuất hiện ở chân và bàn chân ', n.when_to_see = 'Hãy hẹn khám với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu da bị sưng, căng hoặc bóng hoặc da có lúm đồng tiền sau khi bị ấn vào. Hãy gặp bác sĩ ngay vì: Khó thở. Nhịp tim không đều. Đau ngực. Đây có';
MERGE (n:Disease {id: 'D0994'}) SET n.id = 'D0994', n.name = 'Dị ứng trứng', n.name_en = 'Egg allergy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/egg-allergy/symptoms-causes/syc-20372115', n.overview = 'Trứng là một trong những thực phẩm phổ biến nhất gây dị ứng ở trẻ em. Các triệu chứng dị ứng trứng thường bắt đầu vài phút đến vài giờ sau khi ăn trứng hoặc thực phẩm có trứng. Các triệu chứng từ nhẹ ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn hoặc con bạn có các triệu chứng ngay sau khi ăn trứng hoặc thực phẩm làm từ trứng. Nếu có thể, hãy gặp chuyên gia chăm sóc sức khỏe khi phản ứng dị ứng xảy';
MERGE (n:Disease {id: 'D0995'}) SET n.id = 'D0995', n.name = 'Hội chứng Ehlers-Danlos', n.name_en = 'Ehlers-Danlos syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/ehlers-danlos-syndrome/symptoms-causes/syc-20362125 | https://medlineplus.gov/ency/article/001468.htm', n.overview = 'là một nhóm các rối loạn di truyền ảnh hưởng đến các mô liên kết của bạn - chủ yếu là da, khớp và thành mạch máu. Mô liên kết là một hỗn hợp phức tạp của protein và các chất khác cung cấp sức mạnh và ', n.prognosis = 'Những người mắc EDS thường có tuổi thọ bình thường. Trí tuệ là bình thường. Những người mắc loại EDS mạch máu hiếm gặp có nguy cơ bị vỡ cơ quan chính hoặc mạch máu cao hơn. Những người này có nguy cơ ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn để lấy hẹn nếu gia đình bạn có tiền sử mắc bệnh EDS và bạn lo lắng về rủi ro của mình hoặc đang có ý định lập gia đình. Liên hệ với nhà cung cấp của bạn để lấy hẹn';
MERGE (n:Disease {id: 'D0996'}) SET n.id = 'D0996', n.name = 'Ehrlichiosis', n.name_en = 'Ehrlichiosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001381.htm', n.prognosis = 'Ehrlichiosis hiếm khi gây tử vong. Với thuốc kháng sinh, mọi người thường cải thiện tình trạng trong vòng 24 đến 48 giờ. Việc phục hồi có thể mất tới 3 tuần.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị bệnh sau khi bị bọ ve đốt gần đây hoặc nếu bạn đã đến những khu vực thường có bọ ve. Hãy chắc chắn nói với nhà cung cấp của bạn về việc tiếp xúc';
MERGE (n:Disease {id: 'D0997'}) SET n.id = 'D0997', n.name = 'Ehrlichiosis và anaplasmosis', n.name_en = 'Ehrlichiosis and anaplasmosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ehrlichiosis/symptoms-causes/syc-20372142', n.overview = 'là những bệnh tương tự do ve gây ra, gây ra các triệu chứng giống cúm, bao gồm sốt, đau cơ và đau đầu. Các dấu hiệu và triệu chứng của bệnh ehrlichiosis và bệnh anaplasmosis thường xuất hiện trong vòn', n.when_to_see = 'Thời gian từ khi bị cắn đến khi có dấu hiệu và triệu chứng thường là từ 5 đến 14 ngày. Nếu bạn phát triển bất kỳ dấu hiệu hoặc triệu chứng nào sau khi bị bọ ve cắn hoặc sau khi tiếp xúc với bọ ve, hãy';
MERGE (n:Disease {id: 'D0998'}) SET n.id = 'D0998', n.name = 'Hội chứng Eisenmenger', n.name_en = 'Eisenmenger syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/eisenmenger-syndrome/symptoms-causes/syc-20350580 | https://medlineplus.gov/ency/article/007317.htm', n.overview = 'ám chỉ có một lỗ giữa hai buồng tim. Lỗ này được gọi là thông liên thất. Nó khiến máu chảy đến động mạch của phổi nhiều hơn. Cuối cùng, lưu lượng máu tăng thêm khiến các mạch máu cứng lại và thu hẹp, ', n.prognosis = 'Tình trạng sức khỏe của người bị ảnh hưởng phụ thuộc vào việc có mắc phải tình trạng bệnh lý nào khác hay không và độ tuổi mà huyết áp cao phát triển trong phổi. Những người mắc bệnh này có thể sống t', n.when_to_see = 'Nếu bạn có bất kỳ triệu chứng nào của hội chứng Eisenmenger, hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn. Đặt lịch hẹn ngay cả khi bạn chưa bao giờ được chẩn đoán mắc bệnh tim. Nhận trợ giúp y tế';
MERGE (n:Disease {id: 'D0999'}) SET n.id = 'D0999', n.name = 'Đau khuỷu tay', n.name_en = 'Elbow pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003172.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn bị viêm gân kéo dài mà không cải thiện khi chăm sóc tại nhà. Cơn đau là do chấn thương khuỷu tay trực tiếp. Có sự biến dạng rõ r';
MERGE (n:Disease {id: 'D1000'}) SET n.id = 'D1000', n.name = 'Thay khớp khuỷu', n.name_en = 'Elbow replacement', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007258.htm', n.overview = 'Khớp khuỷu nối ba xương: Xương cánh tay ở cánh tay trên Xương trụ và xương quay ở cánh tay dưới (cẳng tay) Khớp khuỷu tay nhân tạo có hai hoặc ba cuống làm bằng kim loại chất lượng cao. Một bản lề bằn', n.prognosis = 'Phẫu thuật thay khớp khuỷu tay giúp giảm đau cho hầu hết mọi người. Nó cũng có thể làm tăng phạm vi chuyển động của khớp khuỷu tay của bạn. Phẫu thuật thay khớp khuỷu tay lần thứ hai thường không thàn';
MERGE (n:Disease {id: 'D1001'}) SET n.id = 'D1001', n.name = 'Chấn thương do điện', n.name_en = 'Electrical injury', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000053.htm', n.when_to_see = 'Hãy gọi 911 hoặc số điện thoại khẩn cấp tại địa phương nếu có người bị thương do điện.';
MERGE (n:Disease {id: 'D1002'}) SET n.id = 'D1002', n.name = 'Đốt điện', n.name_en = 'Electrocauterization', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002359.htm', n.overview = '(hoặc đốt điện) thường được sử dụng trong quá trình phẫu thuật để loại bỏ các mô không mong muốn hoặc có hại. Nó cũng có thể được sử dụng để đốt và làm kín các mạch máu. Điều này giúp giảm hoặc ngừng ';
MERGE (n:Disease {id: 'D1003'}) SET n.id = 'D1003', n.name = 'Liệu pháp sốc điện', n.name_en = 'Electroconvulsive therapy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007474.htm', n.overview = 'Trong ECT, dòng điện sẽ gây ra cơn động kinh trong não. Các bác sĩ tin rằng hoạt động co giật có thể giúp não "tái tạo" chính nó, giúp giảm các triệu chứng. ECT nói chung là an toàn và hiệu quả. ECT t', n.prognosis = 'Một số người cho biết có cảm giác lú lẫn và đau đầu nhẹ sau ECT. Những triệu chứng này chỉ nên kéo dài trong một thời gian ngắn.';
MERGE (n:Disease {id: 'D1004'}) SET n.id = 'D1004', n.name = 'Ngộ độc tai voi', n.name_en = 'Elephant ear poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002867.htm', n.prognosis = 'Nếu tiếp xúc với miệng của người đó không nghiêm trọng, các triệu chứng thường hết trong vòng vài ngày. Đối với những người tiếp xúc nhiều với cây, thời gian phục hồi lâu hơn có thể cần thiết. Trong m';
MERGE (n:Disease {id: 'D1005'}) SET n.id = 'D1005', n.name = 'Huyết áp tăng', n.name_en = 'Elevated blood pressure', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/prehypertension/symptoms-causes/syc-20376703', n.overview = 'là huyết áp cao hơn một chút so với mức được coi là lý tưởng. Huyết áp được đo bằng milimet thủy ngân (mm Hg). Trường Cao đẳng Tim mạch Hoa Kỳ và Hiệp hội Tim mạch Hoa Kỳ chia huyết áp thành bốn loại ', n.when_to_see = 'Nên kiểm tra huyết áp của trẻ trong các lần khám sức khỏe định kỳ bắt đầu từ 3 tuổi. Nếu trẻ bị huyết áp cao, nên đo huyết áp ở mỗi lần khám tái khám. Người lớn từ 18 tuổi trở lên nên kiểm tra huyết á';
MERGE (n:Disease {id: 'D1006'}) SET n.id = 'D1006', n.name = 'Hội chứng Ellis-van Creveld', n.name_en = 'Ellis-van Creveld syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001667.htm', n.prognosis = 'Nhiều trẻ mắc bệnh này chết khi còn nhỏ. Thông thường điều này là do ngực nhỏ hoặc khuyết tật tim. Thai chết lưu là phổ biến. Kết quả phụ thuộc vào hệ thống cơ thể nào có liên quan và mức độ liên quan', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có các triệu chứng của hội chứng này. Nếu bạn có tiền sử gia đình mắc hội chứng EVC và con bạn có bất kỳ triệu chứng nào, hãy';
MERGE (n:Disease {id: 'D1007'}) SET n.id = 'D1007', n.name = 'Các khối u phôi', n.name_en = 'Embryonal tumors', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/embryonal-tumor/symptoms-causes/syc-20579617', n.overview = 'là sự phát triển của các tế bào xảy ra trong não. Sự tăng trưởng liên quan đến các tế bào còn sót lại từ quá trình phát triển của bào thai, được gọi là tế bào phôi thai. Khối u phôi là một loại ung th', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1008'}) SET n.id = 'D1008', n.name = 'Chọc thủng đường thở khẩn cấp', n.name_en = 'Emergency airway puncture', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003017.htm', n.overview = 'được thực hiện trong tình huống khẩn cấp, khi có người bị nghẹn và mọi nỗ lực hỗ trợ hô hấp khác đều thất bại. Một cây kim hoặc ống rỗng có thể được đưa vào cổ họng, ngay dưới quả táo (sụn tuyến giáp)', n.prognosis = 'Tình trạng của người đó tốt như thế nào tùy thuộc vào nguyên nhân gây tắc nghẽn đường thở và người đó nhận được hỗ trợ hô hấp thích hợp nhanh đến mức nào. Việc chọc thủng đường thở khẩn cấp chỉ cung c';
MERGE (n:Disease {id: 'D1009'}) SET n.id = 'D1009', n.name = 'Tránh thai khẩn cấp', n.name_en = 'Emergency contraception', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007014.htm', n.overview = 'rất có thể ngăn ngừa mang thai giống như thuốc tránh thai thông thường: Bằng cách ngăn chặn hoặc trì hoãn việc rụng trứng từ buồng trứng của phụ nữ Bằng cách ngăn chặn tinh trùng thụ tinh với trứng Ha';
MERGE (n:Disease {id: 'D1010'}) SET n.id = 'D1010', n.name = 'Khí thũng', n.name_en = 'Emphysema', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/emphysema/symptoms-causes/syc-20355555', n.overview = 'phế nang bị tổn thương, khiến chúng cuối cùng bị vỡ. Điều này tạo ra một không gian không khí lớn hơn thay vì nhiều không gian nhỏ và làm giảm diện tích bề mặt có sẵn để trao đổi oxy và carbon dioxide', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị khó thở mà không thể giải thích được trong vài tháng, đặc biệt nếu nó trở nên tồi tệ hơn hoặc nếu nó khiến bạn không thể thực hiện các hoạt động';
MERGE (n:Disease {id: 'D1011'}) SET n.id = 'D1011', n.name = 'Hội chứng hố yên rỗng', n.name_en = 'Empty sella syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000349.htm', n.prognosis = 'Hội chứng sella rỗng nguyên phát không gây ra vấn đề sức khỏe và không ảnh hưởng đến tuổi thọ.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng bất thường về chức năng tuyến yên, chẳng hạn như các vấn đề về chu kỳ kinh nguyệt hoặc bất lực.';
MERGE (n:Disease {id: 'D1012'}) SET n.id = 'D1012', n.name = 'Viêm mủ màng phổi', n.name_en = 'Empyema', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000123.htm', n.prognosis = 'Khi bệnh viêm mủ mủ làm biến chứng viêm phổi, nguy cơ tổn thương phổi vĩnh viễn và tử vong sẽ tăng lên. Cần điều trị lâu dài bằng kháng sinh và dẫn lưu. Nói chung, hầu hết mọi người đều hồi phục hoàn ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của bệnh viêm mủ màng phổi.';
MERGE (n:Disease {id: 'D1013'}) SET n.id = 'D1013', n.name = 'Viêm não', n.name_en = 'Encephalitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/encephalitis/symptoms-causes/syc-20356136 | https://medlineplus.gov/ency/article/001415.htm', n.overview = '(en-sef-uh-LIE-tis) là tình trạng viêm não. Nó có thể do nhiễm virus hoặc vi khuẩn hoặc do các tế bào miễn dịch tấn công nhầm vào não. Các loại virus có thể dẫn đến viêm não có thể lây lan qua côn trù', n.prognosis = 'Kết quả sẽ khác nhau. Một số trường hợp nhẹ và ngắn, người bệnh sẽ hồi phục hoàn toàn. Các trường hợp khác rất nghiêm trọng và có thể xảy ra các vấn đề vĩnh viễn hoặc tử vong. Giai đoạn cấp tính thườn', n.when_to_see = 'Hãy nhận sự chăm sóc y tế ngay lập tức nếu bạn gặp bất kỳ triệu chứng nào nghiêm trọng hơn liên quan đến viêm não. Đau đầu dữ dội, sốt và thay đổi ý thức cần được chăm sóc khẩn cấp. Trẻ sơ sinh và trẻ';
MERGE (n:Disease {id: 'D1014'}) SET n.id = 'D1014', n.name = 'Encopresis', n.name_en = 'Encopresis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/encopresis/symptoms-causes/syc-20354494 | https://medlineplus.gov/ency/article/001570.htm', n.overview = '(en-ko-PREE-sis) là hiện tượng phân lặp đi lặp lại vào quần áo ở trẻ đã được tập đi vệ sinh. Việc đi đại tiện thường không thể kiểm soát được. Encopresis thường xảy ra khi phân bị ảnh hưởng tích tụ tr', n.prognosis = 'Hầu hết trẻ em đều đáp ứng tốt với điều trị. Encopresis thường tái phát nên một số trẻ cần được điều trị liên tục.', n.when_to_see = 'Hãy gọi cho nhóm chăm sóc sức khỏe của con bạn nếu con bạn đã được huấn luyện đi vệ sinh và bắt đầu gặp một hoặc nhiều triệu chứng liệt kê ở trên.';
MERGE (n:Disease {id: 'D1015'}) SET n.id = 'D1015', n.name = 'Bệnh thận giai đoạn cuối', n.name_en = 'End-stage kidney disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000500.htm', n.prognosis = 'Bệnh thận giai đoạn cuối dẫn đến tử vong nếu bạn không chạy thận nhân tạo hoặc ghép thận. Cả hai phương pháp điều trị này đều có rủi ro. Kết quả là khác nhau đối với mỗi người.';
MERGE (n:Disease {id: 'D1016'}) SET n.id = 'D1016', n.name = 'Khiếm khuyết đệm nội tâm mạc', n.name_en = 'Endocardial cushion defect', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007324.htm', n.prognosis = 'Tình trạng sức khỏe của em bé phụ thuộc vào: Mức độ nghiêm trọng của ECD Sức khỏe tổng thể của con bạn Bệnh phổi đã phát triển chưa Nhiều trẻ sống cuộc sống năng động, bình thường sau khi ECD được điề', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu con bạn: Dễ mệt mỏi Khó thở Da hoặc môi hơi xanh. Đồng thời, hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nế';
MERGE (n:Disease {id: 'D1017'}) SET n.id = 'D1017', n.name = 'Viêm nội tâm mạc', n.name_en = 'Endocarditis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/endocarditis/symptoms-causes/syc-20352576 | https://medlineplus.gov/ency/article/001098.htm', n.overview = 'là tình trạng viêm đe dọa tính mạng ở lớp lót bên trong buồng và van tim. Lớp lót này được gọi là nội tâm mạc. Viêm nội tâm mạc thường do nhiễm trùng. Vi khuẩn, nấm hoặc vi trùng khác xâm nhập vào máu', n.prognosis = 'Việc điều trị viêm nội tâm mạc ngay lập tức sẽ cải thiện cơ hội đạt được kết quả tốt. Các vấn đề nghiêm trọng hơn có thể phát triển bao gồm: Áp xe não Tổn thương thêm van tim, gây suy tim Lây nhiễm tr', n.when_to_see = 'Nếu bạn có các triệu chứng của viêm nội tâm mạc, hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn càng sớm càng tốt - đặc biệt nếu bạn bị dị tật tim bẩm sinh hoặc có tiền sử viêm nội tâm mạc';
MERGE (n:Disease {id: 'D1018'}) SET n.id = 'D1018', n.name = 'Viêm nội tâm mạc - trẻ em', n.name_en = 'Endocarditis - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007680.htm', n.prognosis = 'Việc điều trị viêm nội tâm mạc ngay lập tức sẽ cải thiện cơ hội loại bỏ nhiễm trùng và ngăn ngừa các biến chứng.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu bạn nhận thấy các triệu chứng sau trong hoặc sau khi điều trị: Máu trong nước tiểu Đau ngực Mệt mỏi Sốt Tê Yếu Giảm cân mà không thay';
MERGE (n:Disease {id: 'D1019'}) SET n.id = 'D1019', n.name = 'Các tuyến nội tiết', n.name_en = 'Endocrine glands', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002351.htm', n.overview = 'Tăng tiết là khi một tuyến tiết ra quá nhiều hormone. Giảm tiết là khi lượng hormone được giải phóng quá thấp. Có nhiều loại rối loạn có thể xảy ra khi lượng hormone được giải phóng quá nhiều hoặc quá';
MERGE (n:Disease {id: 'D1020'}) SET n.id = 'D1020', n.name = 'Cắt bỏ nội mạc tử cung', n.name_en = 'Endometrial ablation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007632.htm', n.overview = 'là một thủ thuật được sử dụng để điều trị chảy máu bất thường bằng cách phá hủy mô trong niêm mạc tử cung. Mô có thể được loại bỏ bằng cách sử dụng: Sóng vô tuyến tần số cao Năng lượng laser Chất lỏng', n.prognosis = 'Lớp niêm mạc tử cung của bạn sẽ lành lại bằng sẹo. Phụ nữ thường sẽ ít chảy máu kinh nguyệt hơn sau thủ thuật này. Có tới 30% đến 50% phụ nữ sẽ ngừng kinh hoàn toàn. Kết quả này có nhiều khả năng xảy ';
MERGE (n:Disease {id: 'D1021'}) SET n.id = 'D1021', n.name = 'Ung thư nội mạc tử cung', n.name_en = 'Endometrial cancer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/endometrial-cancer/symptoms-causes/syc-20352461 | https://medlineplus.gov/ency/article/000910.htm', n.overview = 'tử cung, được gọi là nội mạc tử cung. Ung thư nội mạc tử cung là một loại ung thư bắt đầu bằng sự phát triển của các tế bào trong tử cung. Tử cung là cơ quan vùng chậu hình quả lê rỗng, nơi diễn ra qu', n.prognosis = 'Ung thư nội mạc tử cung thường được chẩn đoán ở giai đoạn đầu. Nếu ung thư không lan rộng, 95% phụ nữ còn sống sau 5 năm điều trị. Nếu ung thư đã lan đến các cơ quan ở xa, khoảng 25% phụ nữ vẫn còn số', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn gặp bất kỳ triệu chứng nào khiến bạn lo lắng. Có một vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin được đánh dấu bên dưới';
MERGE (n:Disease {id: 'D1022'}) SET n.id = 'D1022', n.name = 'Polyp nội mạc tử cung', n.name_en = 'Endometrial polyps', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007636.htm', n.prognosis = 'Trong một số ít trường hợp, polyp có thể quay trở lại sau khi điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị: Chảy máu kinh nguyệt không đều hoặc có thể dự đoán được Chảy máu kinh nguyệt kéo dài hoặc nhiều Chảy máu giữa các kỳ kinh Chả';
MERGE (n:Disease {id: 'D1023'}) SET n.id = 'D1023', n.name = 'Lạc nội mạc tử cung', n.name_en = 'Endometriosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/endometriosis/symptoms-causes/syc-20354656 | https://medlineplus.gov/ency/article/000915.htm', n.overview = 'Lạc nội mạc tử cung là gì? Chuyên gia của Mayo Clinic giải thích Tìm hiểu thêm về bệnh lạc nội mạc tử cung từ Megan Wasson, D.O., bác sĩ phẫu thuật phụ khoa xâm lấn tối thiểu tại Mayo Clinic. Hiển thị', n.prognosis = 'Không có cách chữa trị lạc nội mạc tử cung. Liệu pháp hormone có thể giúp giảm triệu chứng, nhưng các triệu chứng thường quay trở lại khi ngừng điều trị. Điều trị bằng phẫu thuật có thể giúp giảm triệ', n.when_to_see = 'Hãy gặp thành viên trong nhóm chăm sóc sức khỏe của bạn nếu bạn cho rằng mình có thể có các triệu chứng của lạc nội mạc tử cung. Lạc nội mạc tử cung có thể là một thách thức để quản lý. Bạn có thể kiể';
MERGE (n:Disease {id: 'D1024'}) SET n.id = 'D1024', n.name = 'Viêm nội mạc tử cung', n.name_en = 'Endometritis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001484.htm', n.prognosis = 'Trong hầu hết các trường hợp, tình trạng này sẽ khỏi khi dùng kháng sinh. Viêm nội mạc tử cung không được điều trị có thể dẫn đến nhiễm trùng và biến chứng nghiêm trọng hơn. Hiếm khi, nó có thể liên q', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của viêm nội mạc tử cung. Gọi ngay nếu các triệu chứng xảy ra sau: Sinh con Sẩy thai Phá thai Đặt vòng tránh thai Phẫu thuật liê';
MERGE (n:Disease {id: 'D1025'}) SET n.id = 'D1025', n.name = 'Viêm nội nhãn', n.name_en = 'Endophthalmitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001626.htm';
MERGE (n:Disease {id: 'D1026'}) SET n.id = 'D1026', n.name = 'Phẫu thuật cắt giao cảm lồng ngực qua nội soi', n.name_en = 'Endoscopic thoracic sympathectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007291.htm', n.overview = 'Bạn sẽ được gây mê toàn thân trước khi phẫu thuật. Điều này sẽ khiến bạn ngủ ngon và không bị đau. Phẫu thuật thường được thực hiện theo cách sau: Bác sĩ phẫu thuật thực hiện 2 hoặc 3 vết cắt nhỏ (vết', n.prognosis = 'Cuộc phẫu thuật này có thể cải thiện chất lượng cuộc sống cho hầu hết mọi người. Nó không có tác dụng tốt đối với những người bị đổ mồ hôi nách rất nhiều. Một số người nhận thấy đổ mồ hôi ở những vị t';
MERGE (n:Disease {id: 'D1027'}) SET n.id = 'D1027', n.name = 'Đặt ống nội khí quản', n.name_en = 'Endotracheal intubation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003449.htm', n.overview = 'Dù bạn tỉnh (có ý thức) hay không tỉnh (bất tỉnh), bạn sẽ được cung cấp thuốc để đưa ống vào dễ dàng và thoải mái hơn. Bạn cũng có thể nhận được thuốc để thư giãn. Nhà cung cấp dịch vụ chăm sóc sức kh', n.prognosis = 'Triển vọng sẽ phụ thuộc vào lý do cần thực hiện thủ tục.';
MERGE (n:Disease {id: 'D1028'}) SET n.id = 'D1028', n.name = 'Thuyên tắc nội mạch', n.name_en = 'Endovascular embolization', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007277.htm', n.overview = 'Bạn có thể được gây mê toàn thân (ngủ và không đau) và đặt ống thở. Hay bạn có thể được cho thuốc để thư giãn, nhưng bạn sẽ không ngủ được. Một vết cắt phẫu thuật nhỏ sẽ được thực hiện ở vùng háng hoặ', n.prognosis = 'Tốc độ hồi phục của bạn phụ thuộc vào sức khỏe tổng thể, mức độ nghiêm trọng của tình trạng bệnh lý của bạn và các yếu tố khác. Trong hầu hết các trường hợp, thuyên tắc nội mạch là một thủ thuật thành';
MERGE (n:Disease {id: 'D1029'}) SET n.id = 'D1029', n.name = 'Viêm amidan phì đại', n.name_en = 'Enlarged adenoids', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001649.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn khó thở bằng mũi hoặc các triệu chứng khác của chứng phì đại vòm họng.';
MERGE (n:Disease {id: 'D1030'}) SET n.id = 'D1030', n.name = 'Vú to ở nam giới (gynecomastia)', n.name_en = 'Enlarged breasts in men (gynecomastia)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/gynecomastia/symptoms-causes/syc-20351793', n.overview = 'th gynecomastia, mô bên trong tuyến vú phát triển. Điều này có thể khiến ngực trông giống phụ nữ. Gynecomastia (guy-nuh-koh-MAS-tee-uh) là sự gia tăng số lượng mô tuyến vú ở bé trai hoặc nam giới. Sự ', n.when_to_see = 'Hãy gặp thành viên trong nhóm chăm sóc sức khỏe của bạn nếu bạn bị: Sưng. Đau hoặc dịu dàng. Chất lỏng chảy ra từ một hoặc cả hai núm vú. Điều này được gọi là xả núm vú. Một cục cứng hoặc cứng. Da lõm';
MERGE (n:Disease {id: 'D1031'}) SET n.id = 'D1031', n.name = 'Tim to', n.name_en = 'Enlarged heart', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/enlarged-heart/symptoms-causes/syc-20355436', n.overview = 'Tim to (tim to) không phải là một căn bệnh mà là dấu hiệu của một tình trạng khác. Thuật ngữ "tim to" dùng để chỉ tình trạng tim to được thấy trong bất kỳ xét nghiệm hình ảnh nào, bao gồm cả chụp X-qu', n.when_to_see = 'Tim to có thể dễ điều trị hơn khi được phát hiện sớm. Nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn lo lắng về trái tim của mình. Gọi 911 hoặc số điện thoại khẩn cấp tại địa ph';
MERGE (n:Disease {id: 'D1032'}) SET n.id = 'D1032', n.name = 'Gan to', n.name_en = 'Enlarged liver', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/enlarged-liver/symptoms-causes/syc-20372167 | https://medlineplus.gov/ency/article/003275.htm', n.overview = 'Gan to thường là dấu hiệu của một tình trạng bệnh lý tiềm ẩn, chẳng hạn như bệnh gan, suy tim sung huyết hoặc ung thư. Thuật ngữ y học cho gan to là gan to (hep-uh-toe-MEG-uh-le). Việc quản lý bao gồm', n.when_to_see = 'Tình trạng này thường được nhà cung cấp phát hiện nhất. Bạn có thể không nhận thấy gan hoặc lá lách bị sưng.';
MERGE (n:Disease {id: 'D1033'}) SET n.id = 'D1033', n.name = 'Tuyến tiền liệt phì đại', n.name_en = 'Enlarged prostate', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000381.htm', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn có: Nước tiểu ít hơn bình thường Sốt hoặc ớn lạnh Đau lưng, đau bên hông hoặc đau bụng Máu hoặc mủ trong nước tiểu. Đồng thời, hãy liên hệ với nhà';
MERGE (n:Disease {id: 'D1034'}) SET n.id = 'D1034', n.name = 'Lá lách to (lách to)', n.name_en = 'Enlarged spleen (splenomegaly)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/enlarged-spleen/symptoms-causes/syc-20354326', n.overview = 'Lá lách to bằng nắm tay của bạn. Nhưng một số tình trạng, bao gồm bệnh gan và một số bệnh ung thư, có thể khiến lá lách của bạn to ra. Lá lách của bạn là một cơ quan nằm ngay dưới lồng xương sườn bên ', n.when_to_see = 'Hãy đến gặp bác sĩ kịp thời nếu bạn bị đau ở bụng trên bên trái, đặc biệt nếu nó nghiêm trọng hoặc cơn đau trở nên tồi tệ hơn khi bạn hít một hơi thật sâu. Yêu cầu một cuộc hẹn Có vấn đề với
 thông ti';
MERGE (n:Disease {id: 'D1035'}) SET n.id = 'D1035', n.name = 'Viêm ruột', n.name_en = 'Enteritis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001149.htm', n.prognosis = 'Các triệu chứng thường biến mất mà không cần điều trị trong vài ngày ở những người khỏe mạnh.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Bạn bị mất nước. Tiêu chảy không hết sau 3 đến 4 ngày. Bạn bị sốt trên 101°F (38,3°C). Bạn có máu trong phân Bạn bị đau bụng dữ dội';
MERGE (n:Disease {id: 'D1036'}) SET n.id = 'D1036', n.name = 'Entropion', n.name_en = 'Entropion', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/entropion/symptoms-causes/syc-20351125 | https://medlineplus.gov/ency/article/001008.htm', n.overview = 'một, được quay vào trong khiến lông mi cọ vào nhãn cầu, gây khó chịu. Entropion (en-TROH-pee-on) là tình trạng mí mắt của bạn quay vào trong khiến lông mi và da cọ sát vào bề mặt mắt. Điều này gây ra ', n.prognosis = 'Triển vọng thường tốt nhất nếu tình trạng này được điều trị trước khi tổn thương mắt xảy ra.', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc ngay lập tức nếu bạn được chẩn đoán mắc bệnh quặm mi và bạn gặp phải: Đỏ mắt ngày càng tăng nhanh Đau Nhạy cảm với ánh sáng Giảm thị lực Đây là những dấu hiệu và triệu chứng c';
MERGE (n:Disease {id: 'D1037'}) SET n.id = 'D1037', n.name = 'Viêm thực quản tăng bạch cầu ái toan', n.name_en = 'Eosinophilic esophagitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/eosinophilic-esophagitis/symptoms-causes/syc-20372197 | https://medlineplus.gov/ency/article/007717.htm', n.overview = ', được gọi là viêm, của các mô lót thực quản. Một ống dài, linh hoạt có gắn camera, gọi là ống nội soi, có thể được sử dụng để quan sát bên trong thực quản. Hình ảnh nội soi của viêm thực quản tăng bạ', n.prognosis = 'Viêm thực quản tăng bạch cầu ái toan là một căn bệnh lâu dài (mãn tính) xuất hiện và biến mất trong suốt cuộc đời của một người.', n.when_to_see = 'Tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn bị đau ngực, đặc biệt nếu bạn cũng bị khó thở hoặc đau hàm hoặc cánh tay. Đây có thể là triệu chứng của cơn đau tim. Hẹn gặp nhà cung cấp dịch vụ chăm só';
MERGE (n:Disease {id: 'D1038'}) SET n.id = 'D1038', n.name = 'Viêm cân bạch cầu ái toan', n.name_en = 'Eosinophilic fasciitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000447.htm', n.prognosis = 'Trong hầu hết các trường hợp, tình trạng này sẽ biến mất trong vòng 1 đến 3 năm. Tuy nhiên, các triệu chứng có thể kéo dài hơn hoặc quay trở lại.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của chứng rối loạn này.';
MERGE (n:Disease {id: 'D1039'}) SET n.id = 'D1039', n.name = 'Ependymoma', n.name_en = 'Ependymoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ependymoma/symptoms-causes/syc-20580744', n.overview = 'là sự phát triển của các tế bào hình thành trong não hoặc tủy sống. Các tế bào tạo thành một khối gọi là khối u. Ependymoma bắt đầu trong các tế bào biểu mô. Những tế bào này xếp dọc các lối đi mang d', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1040'}) SET n.id = 'D1040', n.name = 'Nếp gấp Epicanthal', n.name_en = 'Epicanthal folds', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003030.htm', n.when_to_see = 'Đặc điểm này thường được thấy nhất trước hoặc trong lần khám sức khỏe đầu tiên cho trẻ. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy nếp gấp trên mắt của con bạn và khô';
MERGE (n:Disease {id: 'D1041'}) SET n.id = 'D1041', n.name = 'U nang biểu bì', n.name_en = 'Epidermoid cyst', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000842.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nhận thấy bất kỳ sự phát triển mới nào trong cơ thể mình. Mặc dù u nang biểu bì không gây hại nhưng bác sĩ nên kiểm tra bạn để tìm dấu hiệu ung thư';
MERGE (n:Disease {id: 'D1042'}) SET n.id = 'D1042', n.name = 'Ly thượng bì bọng nước', n.name_en = 'Epidermolysis bullosa', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/epidermolysis-bullosa/symptoms-causes/syc-20361062 | https://medlineplus.gov/ency/article/001457.htm', n.overview = 'Ly thượng bì bọng nước nối biểu bì bọng nước có thể xuất hiện khi mới sinh. Các vết loét lớn, hở là phổ biến và có thể dẫn đến nhiễm trùng và mất nước trong cơ thể. Kết quả là, các dạng bệnh nghiêm tr', n.prognosis = 'Triển vọng phụ thuộc vào mức độ nghiêm trọng của bệnh. Nhiễm trùng các vùng phồng rộp là phổ biến. Các dạng EB nhẹ cải thiện theo độ tuổi. Các dạng EB rất nghiêm trọng có tỷ lệ tử vong rất cao. Ở các ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn nổi mụn nước mà không rõ lý do. Đối với trẻ sơ sinh, phồng rộp nghiêm trọng có thể đe dọa tính mạng. Tìm kiếm sự chă';
MERGE (n:Disease {id: 'D1043'}) SET n.id = 'D1043', n.name = 'Viêm mào tinh hoàn', n.name_en = 'Epididymitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/epididymitis/symptoms-causes/syc-20363853 | https://medlineplus.gov/ency/article/001279.htm', n.overview = '(ep-ih-did-uh-MY-tis) là tình trạng viêm ống cuộn, được gọi là mào tinh hoàn, ở phía sau tinh hoàn. Mào tinh hoàn lưu trữ và vận chuyển tinh trùng. Males of any age can get epididymitis. Viêm mào tinh', n.prognosis = 'Viêm mào tinh hoàn thường thuyên giảm khi điều trị bằng kháng sinh. Trong hầu hết các trường hợp, không có vấn đề gì về tình dục hoặc sinh sản lâu dài. Tuy nhiên, tình trạng này có thể quay trở lại.', n.when_to_see = 'Đừng bỏ qua tình trạng đau hoặc sưng bìu. Điều này có thể được gây ra bởi một số điều kiện. Một số trong số họ cần được điều trị ngay lập tức để tránh tổn thương vĩnh viễn. Nếu bạn bị đau dữ dội ở bìu';
MERGE (n:Disease {id: 'D1044'}) SET n.id = 'D1044', n.name = 'Áp xe ngoài màng cứng', n.name_en = 'Epidural abscess', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001416.htm', n.prognosis = 'Chẩn đoán và điều trị sớm sẽ cải thiện đáng kể cơ hội đạt được kết quả tốt. Một khi tình trạng yếu, tê liệt hoặc thay đổi cảm giác xảy ra, cơ hội phục hồi chức năng bị mất sẽ giảm đi rất nhiều. Tổn th', n.when_to_see = 'Áp xe ngoài màng cứng là một trường hợp cấp cứu y tế. Đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn có triệu chứng áp xe tủy sống.';
MERGE (n:Disease {id: 'D1045'}) SET n.id = 'D1045', n.name = 'Epidural hematoma', n.name_en = 'Epidural hematoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001412.htm', n.prognosis = 'EDH có nguy cơ tử vong cao nếu không được can thiệp phẫu thuật kịp thời. Ngay cả khi được chăm sóc y tế kịp thời, vẫn có nguy cơ tử vong và tàn tật đáng kể.', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu xuất hiện các triệu chứng của EDH. Chấn thương cột sống thường xảy ra với chấn thương đầu. Nếu bạn phải di chuyển người đó trước k';
MERGE (n:Disease {id: 'D1046'}) SET n.id = 'D1046', n.name = 'Tiêm ngoài màng cứng để điều trị đau lưng', n.name_en = 'Epidural injections for back pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007485.htm', n.overview = 'ESI được thực hiện tại bệnh viện hoặc phòng khám ngoại trú. Quy trình thực hiện như sau: Bạn thay áo choàng. Sau đó bạn nằm úp mặt trên bàn chụp X-quang. Nếu tư thế này gây đau, bạn có thể ngồi dậy ho', n.prognosis = 'ESI cung cấp khả năng giảm đau ngắn hạn cho ít nhất một nửa số người nhận được nó. Các triệu chứng có thể thuyên giảm trong vài tuần đến vài tháng, nhưng hiếm khi kéo dài đến một năm. Thủ tục này khôn';
MERGE (n:Disease {id: 'D1047'}) SET n.id = 'D1047', n.name = 'Viêm nắp thanh quản', n.name_en = 'Epiglottitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/epiglottitis/symptoms-causes/syc-20372227 | https://medlineplus.gov/ency/article/000605.htm', n.overview = 'Giải phẫu họng, amidan và nắp thanh quản. Viêm nắp thanh quản xảy ra khi nắp thanh quản - một "nắp" sụn nhỏ bao phủ khí quản - sưng lên. Sự sưng tấy ngăn chặn luồng không khí vào phổi. Viêm nắp thanh ', n.prognosis = 'Viêm nắp thanh quản có thể là một trường hợp khẩn cấp đe dọa tính mạng. Với điều trị thích hợp, kết quả thường là tốt.', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế ngay lập tức hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu một người bị khó thở. Khó thở là một dấu hiệu muộn nhưng quan trọng. Co thắt có thể khiến đường thở đóng lại ';
MERGE (n:Disease {id: 'D1048'}) SET n.id = 'D1048', n.name = 'Bệnh động kinh', n.name_en = 'Epilepsy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/epilepsy/symptoms-causes/syc-20350093 | https://medlineplus.gov/ency/article/000694.htm', n.overview = 'Giải thích về bệnh động kinh Hãy lắng nghe chuyên gia Lily Wong-Kisiel, M.D., tìm hiểu những điều cơ bản về bệnh động kinh. Hiển thị bản ghi cho video Giải thích về bệnh động kinh Phòng khám Mayo Giải', n.prognosis = 'Một số người bị động kinh có thể giảm hoặc thậm chí ngừng dùng thuốc chống động kinh sau khi không bị động kinh trong vài năm. Một số loại bệnh động kinh ở trẻ em sẽ biến mất hoặc cải thiện theo độ tu', n.when_to_see = 'Tìm kiếm sự trợ giúp y tế ngay lập tức nếu bất kỳ điều nào sau đây xảy ra với cơn động kinh: Cơn động kinh kéo dài hơn năm phút. Hơi thở hoặc ý thức không trở lại sau khi cơn động kinh dừng lại. Cơn c';
MERGE (n:Disease {id: 'D1049'}) SET n.id = 'D1049', n.name = 'Bệnh động kinh ở trẻ em', n.name_en = 'Epilepsy in children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007681.htm', n.prognosis = 'Hầu hết trẻ em bị động kinh đều có cuộc sống bình thường. Một số loại bệnh động kinh ở trẻ em sẽ biến mất hoặc cải thiện theo độ tuổi, thường ở độ tuổi thanh thiếu niên hoặc độ tuổi 20. Nếu con bạn kh', n.when_to_see = 'Hãy gọi 911 hoặc số cấp cứu tại địa phương nếu: Đây là lần đầu tiên con bạn bị co giật Cơn động kinh xảy ra ở trẻ không đeo vòng tay ID y tế (có hướng dẫn giải thích những việc cần làm) Nếu con bạn đã';
MERGE (n:Disease {id: 'D1050'}) SET n.id = 'D1050', n.name = 'Viêm màng cứng', n.name_en = 'Episcleritis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001019.htm', n.prognosis = 'Viêm màng cứng thường được cải thiện mà không cần điều trị. Tuy nhiên, việc điều trị có thể làm cho các triệu chứng biến mất sớm hơn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng viêm màng cứng kéo dài hơn 2 tuần. Hãy kiểm tra lại nếu cơn đau của bạn trở nên tồi tệ hơn hoặc bạn có vấn đề ';
MERGE (n:Disease {id: 'D1051'}) SET n.id = 'D1051', n.name = 'Epispadias', n.name_en = 'Epispadias', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001285.htm', n.prognosis = 'Phẫu thuật có thể giúp người bệnh kiểm soát dòng nước tiểu. Nó cũng sẽ khắc phục sự xuất hiện của bộ phận sinh dục.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ câu hỏi nào về hình dáng bên ngoài hoặc chức năng của bộ phận sinh dục hoặc đường tiết niệu của con bạn.';
MERGE (n:Disease {id: 'D1052'}) SET n.id = 'D1052', n.name = 'Sarcoma biểu mô', n.name_en = 'Epithelioid sarcoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/epithelioid-sarcoma/symptoms-causes/syc-20577574', n.overview = 'là một loại ung thư hiếm gặp bắt đầu từ sự phát triển của các tế bào trong mô mềm. Nó có thể xảy ra bất cứ nơi nào trên cơ thể. Nó thường bắt đầu dưới da ở ngón tay, bàn tay, cẳng tay, đầu gối hoặc cẳ';
MERGE (n:Disease {id: 'D1053'}) SET n.id = 'D1053', n.name = 'Biểu mô', n.name_en = 'Epithelium', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002363.htm', n.overview = 'Tế bào biểu mô giúp bảo vệ hoặc bao bọc các cơ quan. Hầu hết sản xuất chất nhầy hoặc chất tiết khác. Một số loại tế bào biểu mô có những sợi lông nhỏ gọi là lông mao, giúp loại bỏ các chất lạ. Các tế ';
MERGE (n:Disease {id: 'D1054'}) SET n.id = 'D1054', n.name = 'Thao tác Epley', n.name_en = 'Epley maneuver', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007662.htm', n.overview = 'BPPV xảy ra khi những mảnh canxi nhỏ (ống tủy) giống như xương vỡ ra và trôi nổi bên trong các ống nhỏ ở tai trong của bạn. Điều này sẽ gửi những thông điệp khó hiểu đến não về vị trí của cơ thể, gây ', n.prognosis = 'Hầu hết việc điều trị sẽ chữa khỏi bệnh BPPV. Đôi khi, chứng chóng mặt có thể quay trở lại sau một vài tuần. Khoảng một nửa thời gian, BPPV sẽ quay trở lại. Nếu điều này xảy ra, bạn sẽ cần phải được đ';
MERGE (n:Disease {id: 'D1055'}) SET n.id = 'D1055', n.name = 'Ngọc trai Epstein', n.name_en = 'Epstein pearls', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001603.htm', n.prognosis = 'Ngọc trai Epstein biến mất trong vòng 1 đến 2 tuần sau khi sinh.', n.when_to_see = 'Nếu bạn lo lắng về ngọc trai Epstein ở trẻ sơ sinh, hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn khi khám sức khỏe định kỳ cho trẻ.';
MERGE (n:Disease {id: 'D1056'}) SET n.id = 'D1056', n.name = 'ERCP', n.name_en = 'ERCP', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007479.htm', n.overview = 'Một đường truyền tĩnh mạch (IV) được đặt vào cánh tay của bạn. Bạn sẽ nằm sấp hoặc nghiêng bên trái để kiểm tra. Thuốc để thư giãn hoặc an thần bạn sẽ được cung cấp qua IV. Đôi khi, người ta cũng sử d';
MERGE (n:Disease {id: 'D1057'}) SET n.id = 'D1057', n.name = 'Rối loạn cương dương', n.name_en = 'Erectile dysfunction', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/erectile-dysfunction/symptoms-causes/syc-20355776', n.overview = 'Rối loạn cương dương là gì? Chuyên gia của Mayo Clinic giải thích Tìm hiểu thêm từ Matthew Ziegelmann, M.D. Hiển thị bản ghi video Rối loạn cương dương là gì? Chuyên gia của Mayo Clinic giải thích tôi', n.when_to_see = 'Chuyên gia chăm sóc sức khỏe chính của bạn là nơi tốt để bắt đầu khi bạn gặp vấn đề về cương dương. Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu: Bạn lo lắng về khả năng cương cứng của mình hoặc b';
MERGE (n:Disease {id: 'D1058'}) SET n.id = 'D1058', n.name = 'Các vấn đề về cương cứng', n.name_en = 'Erection problems', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007617.htm', n.prognosis = 'Nhiều nam giới khắc phục vấn đề cương cứng bằng cách thay đổi lối sống, điều trị hoặc cả hai. Đối với những trường hợp nghiêm trọng hơn, bạn và bạn tình có thể phải điều chỉnh mức độ ảnh hưởng của ED ', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Vấn đề không biến mất khi thay đổi lối sống Vấn đề bắt đầu sau một chấn thương hoặc phẫu thuật tuyến tiền liệt Bạn có các triệu chứng khác, chẳng hạn như đau thắt';
MERGE (n:Disease {id: 'D1059'}) SET n.id = 'D1059', n.name = 'Bệnh xanthomatosis phun trào', n.name_en = 'Eruptive xanthomatosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007746.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn: Kiểm soát bệnh tiểu đường kém Nhận thấy các vết sưng màu đỏ vàng trên da';
MERGE (n:Disease {id: 'D1060'}) SET n.id = 'D1060', n.name = 'Erysipelas', n.name_en = 'Erysipelas', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000618.htm', n.prognosis = 'Với việc điều trị, kết quả sẽ tốt. Có thể mất vài tuần để da trở lại bình thường. Lột da là điều bình thường khi da lành lại.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị lở loét trên da hoặc các triệu chứng khác của bệnh quầng.';
MERGE (n:Disease {id: 'D1061'}) SET n.id = 'D1061', n.name = 'Erysipeloid', n.name_en = 'Erysipeloid', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000632.htm', n.prognosis = 'Erysipeloid có thể tự khỏi. Nó hiếm khi lây lan. Nếu nó lan rộng, màng tim có thể bị nhiễm trùng. Tình trạng này được gọi là viêm nội tâm mạc.';
MERGE (n:Disease {id: 'D1062'}) SET n.id = 'D1062', n.name = 'Hồng ban đa dạng', n.name_en = 'Erythema multiforme', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000851.htm', n.prognosis = 'Dạng EM nhẹ thường thuyên giảm sau 2 đến 6 tuần, nhưng vấn đề có thể quay trở lại.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn ngay nếu bạn có các triệu chứng của EM.';
MERGE (n:Disease {id: 'D1063'}) SET n.id = 'D1063', n.name = 'Erythema nodosum', n.name_en = 'Erythema nodosum', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000881.htm', n.prognosis = 'Erythema nodosum gây khó chịu nhưng không nguy hiểm trong hầu hết các trường hợp. Các triệu chứng thường biến mất trong vòng khoảng 6 tuần nhưng có thể quay trở lại.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của ban đỏ nút.';
MERGE (n:Disease {id: 'D1064'}) SET n.id = 'D1064', n.name = 'Ban đỏ nhiễm độc', n.name_en = 'Erythema toxicum', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001458.htm', n.prognosis = 'Phát ban thường biến mất trong vòng 2 tuần. Nó thường biến mất hoàn toàn khi được 4 tháng tuổi.', n.when_to_see = 'Hãy thảo luận về tình trạng bệnh với bác sĩ của con bạn trong quá trình khám định kỳ nếu bạn lo lắng.';
MERGE (n:Disease {id: 'D1065'}) SET n.id = 'D1065', n.name = 'Erythrasma', n.name_en = 'Erythrasma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001470.htm', n.prognosis = 'Tình trạng này sẽ biến mất sau khi điều trị.', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng của bệnh ban đỏ.';
MERGE (n:Disease {id: 'D1066'}) SET n.id = 'D1066', n.name = 'Erythroderma', n.name_en = 'Erythroderma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001610.htm', n.prognosis = 'Trong trường hợp nghiêm trọng, người bệnh cần được điều trị tại bệnh viện.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn ngay lập tức nếu: Các triệu chứng trở nên tồi tệ hơn hoặc không thuyên giảm, ngay cả khi đã điều trị. Bạn phát triển các tổn thương mới.';
MERGE (n:Disease {id: 'D1067'}) SET n.id = 'D1067', n.name = 'Erythroplasia of Queyrat', n.name_en = 'Erythroplasia of Queyrat', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001300.htm', n.prognosis = 'Tiên lượng chữa khỏi là rất tốt trong hầu hết các trường hợp.', n.when_to_see = 'Bạn nên liên hệ với nhà cung cấp dịch vụ của mình nếu bạn bị phát ban hoặc vết loét trên cơ quan sinh dục không biến mất.';
MERGE (n:Disease {id: 'D1068'}) SET n.id = 'D1068', n.name = 'Esophageal atresia', n.name_en = 'Esophageal atresia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000961.htm', n.prognosis = 'Chẩn đoán sớm sẽ có cơ hội đạt được kết quả tốt hơn.', n.when_to_see = 'Rối loạn này thường được chẩn đoán ngay sau khi sinh. Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bé ngay lập tức nếu bé nôn liên tục sau khi bú hoặc nếu bé bị khó thở.';
MERGE (n:Disease {id: 'D1069'}) SET n.id = 'D1069', n.name = 'Ung thư thực quản', n.name_en = 'Esophageal cancer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/esophageal-cancer/symptoms-causes/syc-20356084 | https://medlineplus.gov/ency/article/000283.htm', n.overview = 'Thực quản dạ dày. Các vòng cơ co lại và giãn ra để cho phép thức ăn và chất lỏng đi qua phần trên và phần dưới. Ung thư thực quản bắt đầu từ thực quản. Nó có thể xảy ra bất cứ nơi nào dọc theo thực qu', n.prognosis = 'Khi ung thư chưa lan ra ngoài thực quản, phẫu thuật có thể nâng cao cơ hội sống sót. Khi ung thư đã lan sang các khu vực khác của cơ thể, việc chữa trị thường là không thể. Điều trị nhằm mục đích làm ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
';
MERGE (n:Disease {id: 'D1070'}) SET n.id = 'D1070', n.name = 'Thủng thực quản', n.name_en = 'Esophageal perforation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000231.htm', n.prognosis = 'Tình trạng bệnh có thể tiến triển thành sốc hoặc thậm chí tử vong nếu không được điều trị. Outlook sẽ hoạt động tốt nếu sự cố được phát hiện trong vòng 24 giờ kể từ khi sự cố xảy ra. Hầu hết mọi người', n.when_to_see = 'Hãy báo ngay cho nhà cung cấp dịch vụ của bạn nếu bạn bị đau ngực hoặc khó thở khi đã nhập viện. Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu: Gần đây bạn đã phẫu thuật hoặc đ';
MERGE (n:Disease {id: 'D1071'}) SET n.id = 'D1071', n.name = 'Co thắt thực quản', n.name_en = 'Esophageal spasm', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000289.htm', n.prognosis = 'Cơn co thắt thực quản có thể đến rồi đi (không liên tục) hoặc kéo dài (mạn tính). Thuốc có thể giúp giảm triệu chứng trong nhiều trường hợp. Tuy nhiên, các phương pháp điều trị khác có thể cần thiết, ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng co thắt thực quản không biến mất. Các triệu chứng thực sự có thể là do vấn đề về tim. Nhà cung cấp của bạn có ';
MERGE (n:Disease {id: 'D1072'}) SET n.id = 'D1072', n.name = 'Hẹp thực quản - lành tính', n.name_en = 'Esophageal stricture - benign', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000207.htm', n.prognosis = 'Tình trạng nghiêm ngặt có thể quay trở lại trong tương lai. Điều này có thể yêu cầu giãn nở lặp lại.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn gặp vấn đề về nuốt mà không biến mất.';
MERGE (n:Disease {id: 'D1073'}) SET n.id = 'D1073', n.name = 'Giãn tĩnh mạch thực quản', n.name_en = 'Esophageal varices', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/esophageal-varices/symptoms-causes/syc-20351538', n.overview = 'anh thực quản. Chúng thường do lưu lượng máu qua tĩnh mạch cửa bị hạn chế. Tĩnh mạch cửa mang máu từ ruột, tuyến tụy và lá lách đến gan. Giãn tĩnh mạch thực quản là tình trạng các tĩnh mạch giãn rộng ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có các triệu chứng khiến bạn lo lắng. Nếu bạn đã được chẩn đoán mắc bệnh gan, hãy hỏi chuyên gia chăm sóc về nguy cơ bị giãn tĩnh mạch thực quản và nhữ';
MERGE (n:Disease {id: 'D1074'}) SET n.id = 'D1074', n.name = 'Cắt thực quản - xâm lấn tối thiểu', n.name_en = 'Esophagectomy - minimally invasive', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007396.htm', n.overview = 'Trong phẫu thuật cắt thực quản xâm lấn tối thiểu, các vết cắt phẫu thuật nhỏ (vết mổ) được thực hiện ở bụng trên, ngực hoặc cổ của bạn. Một ống nội soi (nội soi) và các dụng cụ phẫu thuật được đưa vào', n.prognosis = 'Nhiều người hồi phục tốt sau phẫu thuật này và có thể có chế độ ăn uống khá bình thường. Sau khi hồi phục, họ có thể sẽ cần ăn khẩu phần nhỏ hơn và ăn thường xuyên hơn. Nếu bạn đã phẫu thuật ung thư, ';
MERGE (n:Disease {id: 'D1075'}) SET n.id = 'D1075', n.name = 'Cắt thực quản - mở', n.name_en = 'Esophagectomy - open', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007397.htm', n.overview = 'Trong phẫu thuật cắt thực quản mở, một hoặc nhiều vết cắt phẫu thuật lớn (vết mổ) được thực hiện ở bụng, ngực hoặc cổ của bạn. Một cách khác để cắt bỏ thực quản là nội soi. Phẫu thuật được thực hiện t', n.prognosis = 'Nhiều người hồi phục tốt sau phẫu thuật này và có thể ăn uống bình thường. Sau khi hồi phục, họ có thể sẽ phải ăn khẩu phần nhỏ hơn và ăn thường xuyên hơn. Nếu bạn đã phẫu thuật ung thư, hãy nói chuyệ';
MERGE (n:Disease {id: 'D1076'}) SET n.id = 'D1076', n.name = 'Viêm thực quản', n.name_en = 'Esophagitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/esophagitis/symptoms-causes/syc-20361224 | https://medlineplus.gov/ency/article/001153.htm', n.overview = 'là hiện tượng sưng tấy và kích thích, gọi là viêm, ở các mô lót thực quản. Thực quản là ống cơ mang thức ăn và đồ uống từ miệng đến dạ dày. Viêm thực quản (uh-sof-uh-JIE-tis) có thể gây đau, khó nuốt.', n.prognosis = 'Trong hầu hết các trường hợp, các rối loạn gây sưng tấy và viêm đường ống dẫn thức ăn sẽ đáp ứng với điều trị.', n.when_to_see = 'Hầu hết các triệu chứng của viêm thực quản có thể do một số tình trạng khác nhau ảnh hưởng đến hệ tiêu hóa gây ra. Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu các triệu chứng: Kéo dài hơn một vài';
MERGE (n:Disease {id: 'D1077'}) SET n.id = 'D1077', n.name = 'Tăng tiểu cầu thiết yếu', n.name_en = 'Essential thrombocythemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000543.htm', n.prognosis = 'Kết quả có thể khác nhau. Hầu hết mọi người có thể trải qua thời gian dài mà không có biến chứng và có tuổi thọ bình thường. Ở một số ít người, biến chứng do chảy máu và cục máu đông có thể gây ra vấn', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị chảy máu không rõ nguyên nhân kéo dài hơn bình thường. Bạn nhận thấy đau ngực, đau chân, lú lẫn, suy nhược, tê hoặc các triệu chứng mới khác.';
MERGE (n:Disease {id: 'D1078'}) SET n.id = 'D1078', n.name = 'Run vô căn', n.name_en = 'Essential tremor', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/essential-tremor/symptoms-causes/syc-20350534 | https://medlineplus.gov/ency/article/000762.htm', n.overview = 'là một tình trạng của hệ thần kinh, còn được gọi là tình trạng thần kinh. Nó gây ra sự rung chuyển nhịp nhàng mà bạn không thể kiểm soát được. Run vô căn có thể ảnh hưởng đến hầu hết mọi bộ phận trên ', n.prognosis = 'ET không phải là vấn đề nguy hiểm. Nhưng một số người cảm thấy những cơn chấn động gây khó chịu và xấu hổ. Trong một số trường hợp, nó có thể nghiêm trọng đến mức cản trở công việc, viết lách, ăn uống', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị cơn run mới Cơn run của bạn khiến bạn khó thực hiện các hoạt động hàng ngày Bạn bị tác dụng phụ của các loại thuốc dùng để điều trị cơn run của';
MERGE (n:Disease {id: 'D1079'}) SET n.id = 'D1079', n.name = 'Esthesioneuroblastoma', n.name_en = 'Esthesioneuroblastoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/esthesioneuroblastoma/symptoms-causes/syc-20351075', n.overview = '(es-thee-zee-o-noo-row-blas-TOE-muh) là một loại ung thư hiếm gặp bắt đầu ở phần trên bên trong mũi, được gọi là khoang mũi. U nguyên bào thần kinh còn được gọi là u nguyên bào thần kinh khứu giác. Un', n.when_to_see = 'Hãy hẹn gặp nhóm chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng kéo dài khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin đượ';
MERGE (n:Disease {id: 'D1080'}) SET n.id = 'D1080', n.name = 'Quá liều estrogen', n.name_en = 'Estrogen overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002584.htm', n.prognosis = 'Các triệu chứng nghiêm trọng rất khó xảy ra.';
MERGE (n:Disease {id: 'D1081'}) SET n.id = 'D1081', n.name = 'Ngộ độc ethanol', n.name_en = 'Ethanol poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002644.htm', n.prognosis = 'Sống sót sau 24 giờ sau cơn say thường có nghĩa là người đó sẽ hồi phục. Hội chứng cai nghiện có thể phát triển khi nồng độ cồn trong máu giảm xuống, vì vậy người đó cần được theo dõi và giữ an toàn t';
MERGE (n:Disease {id: 'D1082'}) SET n.id = 'D1082', n.name = 'Viêm màng sàng', n.name_en = 'Ethmoiditis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001629.htm';
MERGE (n:Disease {id: 'D1083'}) SET n.id = 'D1083', n.name = 'Ngộ độc ethylene glycol', n.name_en = 'Ethylene glycol poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000774.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào tốc độ điều trị được tiếp nhận, lượng nuốt vào, các cơ quan bị ảnh hưởng và các yếu tố khác. Khi điều trị bị trì hoãn, loại ngộ độc này có thể gây tử vo';
MERGE (n:Disease {id: 'D1084'}) SET n.id = 'D1084', n.name = 'Quá liều dầu khuynh diệp', n.name_en = 'Eucalyptus oil overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002646.htm', n.prognosis = 'Sống sót sau 48 giờ thường là dấu hiệu tốt cho thấy sự phục hồi sẽ xảy ra. Nếu có bất kỳ tổn thương nào ở thận xảy ra, có thể phải mất vài tháng mới lành. Buồn ngủ có thể kéo dài trong vài ngày.';
MERGE (n:Disease {id: 'D1085'}) SET n.id = 'D1085', n.name = 'Quá liều dầu Eugenol', n.name_en = 'Eugenol oil overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002647.htm', n.prognosis = 'Sống sót sau 48 giờ thường là một dấu hiệu tốt cho thấy quá trình hồi phục sẽ diễn ra. Tuy nhiên, chấn thương vĩnh viễn là có thể.';
MERGE (n:Disease {id: 'D1086'}) SET n.id = 'D1086', n.name = 'Ewing sarcoma', n.name_en = 'Ewing sarcoma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/ewing-sarcoma/symptoms-causes/syc-20351071 | https://medlineplus.gov/ency/article/001302.htm', n.overview = 'là một loại ung thư bắt đầu bằng sự phát triển của các tế bào trong xương và mô mềm xung quanh xương. Sarcoma Ewing (Yoo-ing) chủ yếu xảy ra ở trẻ em và thanh niên, mặc dù nó có thể xảy ra ở mọi lứa t', n.prognosis = 'Trước khi điều trị, triển vọng phụ thuộc vào: Liệu khối u có lan đến các bộ phận xa của cơ thể Khối u bắt đầu ở đâu trong cơ thể Khối u lớn đến mức nào khi được chẩn đoán Liệu nồng độ lactate dehydrog', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn hoặc con bạn có các dấu hiệu và triệu chứng liên tục khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét';
MERGE (n:Disease {id: 'D1087'}) SET n.id = 'D1087', n.name = 'Khóc quá nhiều ở trẻ sơ sinh', n.name_en = 'Excessive crying in infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003023.htm', n.when_to_see = 'Liên hệ với con bạn nhà cung cấp dịch vụ nếu: Trẻ khóc quá nhiều không rõ nguyên nhân và không hết sau 1 ngày, mặc dù đã cố gắng điều trị tại nhà Trẻ có các triệu chứng khác, chẳng hạn như sốt, cùng v';
MERGE (n:Disease {id: 'D1088'}) SET n.id = 'D1088', n.name = 'Lông quá nhiều hoặc không mong muốn ở phụ nữ', n.name_en = 'Excessive or unwanted hair in women', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007622.htm', n.prognosis = 'Nang tóc phát triển khoảng 6 tháng thì rụng. Vì vậy, phải mất nhiều tháng dùng thuốc bạn mới nhận thấy sự phát triển của tóc giảm đi. Nhiều phụ nữ nhận được kết quả tốt với các bước tạm thời để loại b', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có bất kỳ dấu hiệu nào sau đây: Tóc mọc nhanh. Bạn cũng có những đặc điểm nam tính như mụn trứng cá, giọng trầm, tăng khối lượng cơ bắp, tóc mỏng t';
MERGE (n:Disease {id: 'D1089'}) SET n.id = 'D1089', n.name = 'Truyền máu trao đổi', n.name_en = 'Exchange transfusion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002923.htm', n.overview = 'Truyền máu trao đổi yêu cầu máu của người đó phải được loại bỏ và thay thế. Trong hầu hết các trường hợp, điều này liên quan đến việc đặt một hoặc nhiều ống mỏng, gọi là ống thông, vào mạch máu. Việc ';
MERGE (n:Disease {id: 'D1090'}) SET n.id = 'D1090', n.name = 'Tập thể dục và tuổi tác', n.name_en = 'Exercise and age', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002080.htm', n.overview = 'Bạn không cần phải dành hàng giờ trong phòng tập thể dục mỗi ngày để thấy được lợi ích. Vận động cơ thể chỉ cần 30 phút mỗi ngày, 5 ngày một tuần là đủ để cải thiện sức khỏe. Một chương trình tập luyệ';
MERGE (n:Disease {id: 'D1091'}) SET n.id = 'D1091', n.name = 'Tập thể dục và khả năng miễn dịch', n.name_en = 'Exercise and immunity', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007165.htm', n.overview = 'Tập thể dục giúp giảm nguy cơ mắc bệnh tim. Nó cũng giữ cho xương của bạn khỏe mạnh và chắc khỏe. Chúng tôi không biết chính xác liệu tập thể dục có làm tăng khả năng miễn dịch của bạn đối với một số ';
MERGE (n:Disease {id: 'D1092'}) SET n.id = 'D1092', n.name = 'Đau đầu khi tập thể dục', n.name_en = 'Exercise headaches', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/exercise-headaches/symptoms-causes/syc-20372276', n.overview = 'xảy ra trong hoặc sau khi tập thể dục vất vả, kéo dài. Một số hoạt động liên quan đến đau đầu khi tập thể dục bao gồm chạy, chèo thuyền, quần vợt, bơi lội và cử tạ. Các nhà cung cấp dịch vụ chăm sóc s', n.when_to_see = 'Nếu bạn bị đau đầu trong hoặc sau khi tập thể dục, hãy tham khảo ý kiến ​​nhà cung cấp của bạn. Hãy gọi cho nhà cung cấp dịch vụ của bạn ngay lập tức nếu cơn đau đầu bắt đầu đột ngột hoặc nếu đây là c';
MERGE (n:Disease {id: 'D1093'}) SET n.id = 'D1093', n.name = 'Hen suyễn do tập thể dục', n.name_en = 'Exercise-induced asthma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/exercise-induced-asthma/symptoms-causes/syc-20372300', n.overview = 'xảy ra khi đường thở bị thu hẹp hoặc co thắt trong hoặc sau khi hoạt động thể chất. Nó gây khó thở, thở khò khè, ho và các triệu chứng khác trong hoặc sau khi tập thể dục. Thuật ngữ y học cho tình trạ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của bệnh hen suyễn do tập thể dục. Một số tình trạng có thể gây ra các triệu chứng tương tự, vì vậy điều quan trọng là bạn phải ';
MERGE (n:Disease {id: 'D1094'}) SET n.id = 'D1094', n.name = 'Hội chứng Cushing ngoại sinh', n.name_en = 'Exogenous Cushing syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000389.htm', n.prognosis = 'Giảm dần lượng thuốc gây ra tình trạng này có thể giúp đảo ngược tác động của tình trạng teo tuyến thượng thận. Việc này có thể mất vài tháng cho đến một năm. Trong thời gian này, bạn có thể cần phải ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn đang dùng corticosteroid và xuất hiện các triệu chứng của hội chứng Cushing.';
MERGE (n:Disease {id: 'D1095'}) SET n.id = 'D1095', n.name = 'Thiết bị kiểm soát tình trạng tiểu không tự chủ bên ngoài', n.name_en = 'External incontinence devices', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003974.htm', n.overview = 'Có một số sản phẩm có sẵn. Các tính năng của các sản phẩm khác nhau được liệt kê dưới đây. THIẾT BỊ són phân Có nhiều loại sản phẩm để kiểm soát tình trạng tiêu chảy hoặc són phân lâu dài. Những thiết';
MERGE (n:Disease {id: 'D1096'}) SET n.id = 'D1096', n.name = 'Mắt - vật lạ trong', n.name_en = 'Eye - foreign object in', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002084.htm', n.overview = 'Mắt thường sẽ tuôn ra những vật nhỏ, như lông mi và cát, thông qua việc chớp mắt và chảy nước mắt. KHÔNG dụi mắt nếu có vật gì đó trong đó. Rửa tay trước khi kiểm tra mắt. Kiểm tra mắt ở nơi có ánh sá';
MERGE (n:Disease {id: 'D1097'}) SET n.id = 'D1097', n.name = 'Đốt mắt - ngứa và tiết dịch', n.name_en = 'Eye burning - itching and discharge', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003034.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Dịch tiết ra dày, hơi xanh hoặc giống mủ. (Điều này có thể là do viêm kết mạc do vi khuẩn.) Bạn bị đau mắt quá mức hoặc nhạy cảm với ánh sáng. Tầm nhì';
MERGE (n:Disease {id: 'D1098'}) SET n.id = 'D1098', n.name = 'Các trường hợp cấp cứu về mắt', n.name_en = 'Eye emergencies', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000054.htm', n.when_to_see = 'Tìm kiếm sự chăm sóc y tế khẩn cấp nếu: Có vẻ như có vết xước, vết cắt hoặc vật gì đó đã đi vào (xuyên thủng) nhãn cầu. Bất kỳ hóa chất nào đều lọt vào mắt. Mắt bị đau và đỏ. Buồn nôn hoặc nhức đầu xả';
MERGE (n:Disease {id: 'D1099'}) SET n.id = 'D1099', n.name = 'Phao mắt', n.name_en = 'Eye floaters', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/eye-floaters/symptoms-causes/syc-20372346 | https://medlineplus.gov/ency/article/002085.htm', n.overview = 'Những đốm bay lơ lửng mà đôi khi bạn nhìn thấy trước mắt không phải ở trên bề mặt mắt mà ở bên trong chúng. Chúng được tạo thành từ những mảnh vụn tế bào trôi dạt trong chất lỏng (thủy tinh thể) ở phí', n.when_to_see = 'Liên hệ với bác sĩ chuyên khoa mắt ngay lập tức nếu bạn nhận thấy: Nhiều ruồi bay trong mắt hơn bình thường Sự xuất hiện đột ngột của ruồi bay mới Ánh sáng lóe lên trong mắt giống như ruồi bay Một tấm';
MERGE (n:Disease {id: 'D1100'}) SET n.id = 'D1100', n.name = 'Khối u ác tính ở mắt', n.name_en = 'Eye melanoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/eye-melanoma/symptoms-causes/syc-20372371', n.overview = 'Nơi xảy ra khối u ác tính ở mắt nằm ở lớp giữa của mắt, được gọi là màng bồ đào. Các bộ phận của màng bồ đào của mắt có thể phát triển khối u ác tính bao gồm phần màu của mắt (mống mắt), cấu trúc xung', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào của khối u ác tính ở mắt. Nếu bạn nhận thấy những thay đổi đột ngột trong tầm nhìn của mình, hãy tìm kiếm sự chăm sóc y tế kh';
MERGE (n:Disease {id: 'D1101'}) SET n.id = 'D1101', n.name = 'Sửa chữa cơ mắt', n.name_en = 'Eye muscle repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002961.htm', n.overview = 'Mục tiêu của phẫu thuật này là khôi phục cơ mắt về vị trí thích hợp. Điều này sẽ giúp mắt di chuyển chính xác. Eye muscle surgery is most often done on children. Tuy nhiên, người lớn có vấn đề về mắt ', n.prognosis = 'Phẫu thuật cơ mắt không khắc phục được tình trạng thị lực kém của mắt lười (nhược thị). Con bạn có thể phải đeo kính hoặc miếng che mắt. Nói chung, trẻ càng nhỏ khi phẫu thuật được thực hiện thì kết q';
MERGE (n:Disease {id: 'D1102'}) SET n.id = 'D1102', n.name = 'Đau mắt', n.name_en = 'Eye pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003032.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Cơn đau nghiêm trọng (gọi ngay) hoặc cơn đau kéo dài hơn 2 ngày Bạn bị giảm thị lực cùng với đau mắt Bạn mắc các bệnh mãn tính như v';
MERGE (n:Disease {id: 'D1103'}) SET n.id = 'D1103', n.name = 'Đỏ mắt', n.name_en = 'Eye redness', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003031.htm', n.when_to_see = 'Hãy đến bệnh viện hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu: Mắt bạn đỏ sau khi bị vết thương xuyên thấu. Bạn bị đau đầu kèm theo mờ mắt hoặc lú lẫn. Bạn đang nhìn thấy quầng sáng xung quanh đèn';
MERGE (n:Disease {id: 'D1104'}) SET n.id = 'D1104', n.name = 'Vết sưng ở mí mắt', n.name_en = 'Eyelid bump', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001009.htm', n.prognosis = 'Mụn lẹo thường tự khỏi. Tuy nhiên, họ có thể quay trở lại. Nếu có viêm bờ mi, việc điều trị có thể giúp ngăn ngừa bệnh lẹo mắt tái phát. Kết quả hầu như luôn luôn xuất sắc với cách điều trị đơn giản. ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn có vấn đề về thị lực. Vết sưng ở mí mắt trở nên trầm trọng hơn hoặc không cải thiện trong vòng một hoặc hai tuần sau khi tự chăm sóc. Các vết sưng hoặc vế';
MERGE (n:Disease {id: 'D1105'}) SET n.id = 'D1105', n.name = 'Sụp mí mắt', n.name_en = 'Eyelid drooping', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001018.htm', n.prognosis = 'Tình trạng sụp mí mắt có thể xảy ra liên tục, xấu đi theo thời gian (tiến triển) hoặc đến rồi đi (không liên tục). Kết quả mong đợi phụ thuộc vào nguyên nhân gây ra chứng sụp mi. Trong hầu hết các trư', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe hoặc bác sĩ nhãn khoa của bạn nếu: Sụp mí mắt ảnh hưởng đến ngoại hình hoặc thị lực của bạn. Một mí mắt đột ngột sụp xuống hoặc khép lại. Nó có l';
MERGE (n:Disease {id: 'D1106'}) SET n.id = 'D1106', n.name = 'Nâng mí mắt', n.name_en = 'Eyelid lift', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002977.htm', n.overview = 'Phẫu thuật cắt mí mắt được thực hiện tại phòng khám của bác sĩ phẫu thuật. Hoặc, nó được thực hiện như một cuộc phẫu thuật ngoại trú tại một trung tâm phẫu thuật. Quy trình được thực hiện như sau: Bạn', n.prognosis = 'Sẹo có thể còn hơi hồng trong 6 tháng hoặc hơn sau phẫu thuật. Chúng sẽ mờ dần thành một đường trắng mỏng gần như vô hình và ẩn trong nếp mí mắt tự nhiên. Vẻ ngoài tỉnh táo và trẻ trung hơn thường kéo';
MERGE (n:Disease {id: 'D1107'}) SET n.id = 'D1107', n.name = 'Co giật mí mắt', n.name_en = 'Eyelid twitch', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000756.htm', n.prognosis = 'Triển vọng phụ thuộc vào loại hoặc nguyên nhân cụ thể gây co giật mí mắt. Trong hầu hết các trường hợp, các cơn co giật sẽ dừng lại trong vòng một tuần.', n.when_to_see = 'Hãy hẹn gặp nhà cung cấp dịch vụ chăm sóc chính hoặc bác sĩ nhãn khoa của bạn (bác sĩ nhãn khoa hoặc bác sĩ đo thị lực) nếu: Co giật mí mắt không biến mất trong vòng 1 tuần Co giật đóng hoàn toàn mí m';
MERGE (n:Disease {id: 'D1108'}) SET n.id = 'D1108', n.name = 'Mắt - phồng', n.name_en = 'Eyes - bulging', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003033.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có mắt lồi và nguyên nhân vẫn chưa được chẩn đoán. Mắt lồi đi kèm với các triệu chứng khác, chẳng hạn như đau hoặc sốt. Nhà cung cấp sẽ hỏi về bện';
MERGE (n:Disease {id: 'D1109'}) SET n.id = 'D1109', n.name = 'Mỏi mắt', n.name_en = 'Eyestrain', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/eyestrain/symptoms-causes/syc-20372397', n.overview = 'là một tình trạng phổ biến xảy ra khi mắt bạn mệt mỏi do sử dụng nhiều, chẳng hạn như khi lái xe đường dài hoặc nhìn chằm chằm vào màn hình máy tính và các thiết bị kỹ thuật số khác. Mỏi mắt có thể gâ', n.when_to_see = 'Hãy gặp bác sĩ chuyên khoa mắt nếu các bước tự chăm sóc không làm giảm mỏi mắt của bạn. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin được đánh dấ';
MERGE (n:Disease {id: 'D1110'}) SET n.id = 'D1110', n.name = 'Đau mặt', n.name_en = 'Face pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003027.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Đau mặt kèm theo đau ngực, vai, cổ hoặc cánh tay. Điều này có thể có nghĩa là một cơn đau tim. Gọi 911 hoặc số khẩn cấp tại địa phương. Cơn đau nhói, nặng hơn';
MERGE (n:Disease {id: 'D1111'}) SET n.id = 'D1111', n.name = 'Ngộ độc bột bôi mặt', n.name_en = 'Face powder poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002700.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng bột bôi mặt họ nuốt vào và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Bột đắp mặt không độc lắm nên có khả năng hồi p';
MERGE (n:Disease {id: 'D1112'}) SET n.id = 'D1112', n.name = 'Căng da mặt', n.name_en = 'Facelift', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002989.htm', n.overview = 'Phẫu thuật căng da mặt có thể được thực hiện một mình hoặc kết hợp với việc định hình lại mũi , căng da trán hoặc phẫu thuật mí mắt . Trong khi bạn buồn ngủ và không đau (thuốc an thần có ý thức), hoặ', n.prognosis = 'Hầu hết mọi người đều hài lòng với kết quả. Bạn sẽ bị sưng, bầm tím, đổi màu da, đau và tê trong vòng 10 đến 14 ngày hoặc lâu hơn sau khi phẫu thuật. Hầu hết các vết sẹo phẫu thuật đều ẩn ở chân tóc h';
MERGE (n:Disease {id: 'D1113'}) SET n.id = 'D1113', n.name = 'Liệt dây thần kinh mặt do chấn thương khi sinh', n.name_en = 'Facial nerve palsy due to birth trauma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001425.htm', n.prognosis = 'Tình trạng này thường tự khỏi sau vài tháng.', n.when_to_see = 'Nhà cung cấp dịch vụ của bạn thường sẽ chẩn đoán tình trạng này khi trẻ sơ sinh đang nằm viện. Những trường hợp nhẹ chỉ liên quan đến môi dưới có thể không được chú ý khi sinh. Cha mẹ, ông bà hoặc ngư';
MERGE (n:Disease {id: 'D1114'}) SET n.id = 'D1114', n.name = 'Liệt mặt', n.name_en = 'Facial paralysis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003028.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị yếu hoặc tê ở mặt. Tìm kiếm sự trợ giúp y tế khẩn cấp ngay lập tức nếu bạn có những triệu chứng này cùng với đau đầu dữ dội, co giật hoặc mù lòa';
MERGE (n:Disease {id: 'D1115'}) SET n.id = 'D1115', n.name = 'Sưng mặt', n.name_en = 'Facial swelling', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003105.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn bị: Sưng mặt đột ngột, đau hoặc nghiêm trọng Sưng mặt kéo dài một thời gian, đặc biệt nếu tình trạng trở nên trầm trọng hơn theo thời gian Kh';
MERGE (n:Disease {id: 'D1116'}) SET n.id = 'D1116', n.name = 'Máy giật cơ mặt', n.name_en = 'Facial tics', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001410.htm', n.prognosis = 'Những cơn giật cơ đơn giản thời thơ ấu sẽ tự biến mất trong khoảng thời gian vài tháng. Tics mãn tính có thể tiếp tục trong một thời gian dài hơn.', n.when_to_see = 'Hãy hẹn gặp nhà cung cấp dịch vụ của bạn nếu chứng máy giật: Ảnh hưởng đến nhiều nhóm cơ dai dẳng Có nghiêm trọng';
MERGE (n:Disease {id: 'D1117'}) SET n.id = 'D1117', n.name = 'Chấn thương mặt', n.name_en = 'Facial trauma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001062.htm', n.prognosis = 'Hầu hết những người không bị tắc nghẽn đường thở đều có kết quả rất tốt nếu được điều trị thích hợp. Có thể cần phải phẫu thuật thêm sau 6 đến 12 tháng để điều chỉnh những thay đổi về ngoại hình.', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn bị thương nặng ở mặt.';
MERGE (n:Disease {id: 'D1118'}) SET n.id = 'D1118', n.name = 'Bệnh loạn dưỡng cơ vùng mặt', n.name_en = 'Facioscapulohumeral muscular dystrophy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000707.htm', n.prognosis = 'Khuyết tật thường nhẹ. Tuổi thọ thường không bị ảnh hưởng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu các triệu chứng của tình trạng này phát triển. Tư vấn di truyền được khuyến khích cho các cặp vợ chồng có tiền sử gia đình mắc bệnh này muốn có con.';
MERGE (n:Disease {id: 'D1119'}) SET n.id = 'D1119', n.name = 'Rối loạn giả tạo', n.name_en = 'Factitious disorder', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/factitious-disorder/symptoms-causes/syc-20356028', n.overview = ', trước đây gọi là hội chứng Munchausen, là một tình trạng sức khỏe tâm thần nghiêm trọng trong đó mọi người lừa dối người khác bằng cách giả vờ ốm. Họ làm điều này bằng cách giả mạo các triệu chứng, ', n.when_to_see = 'Những người mắc chứng rối loạn giả tưởng có thể biết nguy cơ bị thương hoặc thậm chí tử vong khi họ tự làm tổn thương bản thân hoặc tìm cách điều trị không cần thiết. Nhưng họ gặp khó khăn trong việc ';
MERGE (n:Disease {id: 'D1120'}) SET n.id = 'D1120', n.name = 'Bệnh cường giáp giả tạo', n.name_en = 'Factitious hyperthyroidism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000309.htm', n.prognosis = 'Bệnh cường giáp giả sẽ tự khỏi khi bạn ngừng dùng hoặc giảm liều lượng hormone tuyến giáp.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh cường giáp.';
MERGE (n:Disease {id: 'D1121'}) SET n.id = 'D1121', n.name = 'Thiếu yếu tố V', n.name_en = 'Factor V deficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000550.htm', n.prognosis = 'Triển vọng sẽ tốt nếu được chẩn đoán và điều trị thích hợp.', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn bị mất máu kéo dài hoặc không rõ nguyên nhân.';
MERGE (n:Disease {id: 'D1122'}) SET n.id = 'D1122', n.name = 'Yếu tố V Leiden', n.name_en = 'Factor V Leiden', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/factor-v-leiden/symptoms-causes/syc-20372423', n.overview = '(FAK-tur five LIDE-n) là sự đột biến của một trong những yếu tố đông máu trong máu. Đột biến này có thể làm tăng nguy cơ phát triển cục máu đông bất thường, phổ biến nhất là ở chân hoặc phổi. Hầu hết ', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn có các dấu hiệu hoặc triệu chứng của DVT hoặc tắc mạch phổi. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1123'}) SET n.id = 'D1123', n.name = 'Thiếu yếu tố VII', n.name_en = 'Factor VII deficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000548.htm', n.prognosis = 'Bạn có thể mong đợi một kết quả tốt nếu được điều trị thích hợp. Thiếu yếu tố VII di truyền là tình trạng kéo dài suốt đời. Triển vọng về tình trạng thiếu yếu tố VII mắc phải phụ thuộc vào nguyên nhân', n.when_to_see = 'Hãy điều trị khẩn cấp ngay nếu bạn bị chảy máu nghiêm trọng, không rõ nguyên nhân.';
MERGE (n:Disease {id: 'D1124'}) SET n.id = 'D1124', n.name = 'Thiếu yếu tố X', n.name_en = 'Factor X deficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000553.htm', n.prognosis = 'Kết quả sẽ tốt nếu tình trạng nhẹ hoặc bạn được điều trị. Thiếu yếu tố X di truyền là tình trạng kéo dài suốt đời. Triển vọng thiếu hụt yếu tố X mắc phải phụ thuộc vào nguyên nhân. Nếu nguyên nhân là ', n.when_to_see = 'Nhận trợ giúp y tế khẩn cấp nếu bạn bị mất máu nghiêm trọng hoặc không rõ nguyên nhân.';
MERGE (n:Disease {id: 'D1125'}) SET n.id = 'D1125', n.name = 'Thiếu yếu tố XII (yếu tố Hageman)', n.name_en = 'Factor XII (Hageman factor) deficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000545.htm', n.prognosis = 'Kết quả dự kiến ​​sẽ tốt nếu không cần điều trị.', n.when_to_see = 'Nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn thường phát hiện ra tình trạng này khi thực hiện các xét nghiệm khác trong phòng thí nghiệm.';
MERGE (n:Disease {id: 'D1126'}) SET n.id = 'D1126', n.name = 'Chậm phát triển', n.name_en = 'Failure to thrive', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000991.htm', n.prognosis = 'Sự tăng trưởng và phát triển bình thường có thể bị ảnh hưởng nếu con bạn không phát triển tốt trong thời gian dài. Sự tăng trưởng và phát triển bình thường có thể tiếp tục nếu con bạn không phát triển', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn để lấy hẹn nếu con bạn có vẻ không phát triển bình thường.';
MERGE (n:Disease {id: 'D1127'}) SET n.id = 'D1127', n.name = 'Ngất xỉu', n.name_en = 'Fainting', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003092.htm', n.when_to_see = 'Gọi 911 hoặc số cấp cứu tại địa phương nếu người bị ngất: Ngã từ trên cao, đặc biệt nếu bị thương hoặc chảy máu Không tỉnh táo nhanh chóng (trong vòng vài phút) Đang mang thai Trên 50 tuổi Bị tiểu đườ';
MERGE (n:Disease {id: 'D1128'}) SET n.id = 'D1128', n.name = 'Bệnh đa polyp tuyến gia đình', n.name_en = 'Familial adenomatous polyposis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/familial-adenomatous-polyposis/symptoms-causes/syc-20372443', n.overview = '(FAP) là một tình trạng di truyền hiếm gặp do khiếm khuyết trong gen adenomatous polyposis coli (APC). Hầu hết mọi người đều thừa hưởng gen từ cha mẹ. Nhưng đối với 25 đến 30 phần trăm số người, đột b';
MERGE (n:Disease {id: 'D1129'}) SET n.id = 'D1129', n.name = 'Tăng lipid máu kết hợp mang tính chất gia đình', n.name_en = 'Familial combined hyperlipidemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000396.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào: Tình trạng được chẩn đoán sớm đến mức nào Khi bạn bắt đầu điều trị Bạn tuân thủ kế hoạch điều trị của mình tốt đến mức nào Nếu không điều trị, đau tim hoặc đột q', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn bị đau ngực hoặc các dấu hiệu cảnh báo khác về cơn đau tim. Liên hệ với nhà cung cấp của bạn nếu bạn có tiền sử cá nhân hoặc gia đình có mức choleste';
MERGE (n:Disease {id: 'D1130'}) SET n.id = 'D1130', n.name = 'Chứng mất tự chủ gia đình', n.name_en = 'Familial dysautonomia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001387.htm', n.prognosis = 'Những tiến bộ trong chẩn đoán và điều trị đang làm tăng tỷ lệ sống sót. Khoảng một nửa số trẻ sinh ra mắc chứng FD sẽ sống đến tuổi 30.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu các triệu chứng thay đổi hoặc trở nên trầm trọng hơn. Một cố vấn di truyền có thể giúp hướng dẫn bạn về tình trạng bệnh và hướng dẫn bạn đến các nhóm hỗ trợ tr';
MERGE (n:Disease {id: 'D1131'}) SET n.id = 'D1131', n.name = 'Rối loạn betalipoprotein máu gia đình', n.name_en = 'Familial dysbetalipoproteinemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000402.htm', n.prognosis = 'Những người mắc bệnh này có nguy cơ mắc bệnh động mạch vành và bệnh mạch máu ngoại biên tăng lên đáng kể. Với việc điều trị, hầu hết mọi người đều có thể giảm đáng kể mức cholesterol và chất béo trung', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn được chẩn đoán mắc chứng rối loạn này và: Các triệu chứng mới xuất hiện. Các triệu chứng không cải thiện khi điều trị. Các triệu chứng trở nên tồi ';
MERGE (n:Disease {id: 'D1132'}) SET n.id = 'D1132', n.name = 'Tăng cholesterol máu gia đình', n.name_en = 'Familial hypercholesterolemia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/familial-hypercholesterolemia/symptoms-causes/syc-20353755 | https://medlineplus.gov/ency/article/000392.htm', n.overview = 'là một tình trạng di truyền ảnh hưởng đến cách cơ thể xử lý cholesterol. Kết quả là, những người bị tăng cholesterol máu mang tính chất gia đình có nguy cơ mắc bệnh tim cao hơn và nguy cơ bị đau tim s', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào mức độ bạn tuân thủ chặt chẽ lời khuyên điều trị của nhà cung cấp dịch vụ và mức độ phản ứng của bạn với phương pháp điều trị được đề xuất. Thay đổi chế độ ăn uốn', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn bị đau ngực hoặc các dấu hiệu cảnh báo khác về cơn đau tim. Liên hệ với nhà cung cấp của bạn nếu bạn có tiền sử cá nhân hoặc gia đình có mức choleste';
MERGE (n:Disease {id: 'D1133'}) SET n.id = 'D1133', n.name = 'Tăng triglycerid máu mang tính chất gia đình', n.name_en = 'Familial hypertriglyceridemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000397.htm', n.prognosis = 'Giảm cân và kiểm soát bệnh tiểu đường sẽ giúp cải thiện kết quả.';
MERGE (n:Disease {id: 'D1134'}) SET n.id = 'D1134', n.name = 'Thiếu lipoprotein lipase gia đình', n.name_en = 'Familial lipoprotein lipase deficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000408.htm', n.prognosis = 'Những người mắc bệnh này tuân theo chế độ ăn rất ít chất béo có thể sống đến tuổi trưởng thành.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn để kiểm tra xem có ai đó trong gia đình bạn bị thiếu hụt lipoprotein lipase hay không. Tư vấn di truyền được khuyến khích cho bất kỳ ai có tiền sử gia đình';
MERGE (n:Disease {id: 'D1135'}) SET n.id = 'D1135', n.name = 'Sốt Địa Trung Hải gia đình', n.name_en = 'Familial Mediterranean fever', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/familial-mediterranean-fever/symptoms-causes/syc-20372470 | https://medlineplus.gov/ency/article/000363.htm', n.overview = '(FMF) là một rối loạn tự viêm di truyền gây ra sốt tái phát và viêm đau vùng bụng, ngực và khớp. FMF là một chứng rối loạn di truyền thường xảy ra ở những người gốc Địa Trung Hải - bao gồm những người', n.prognosis = 'Hiện chưa có phương pháp chữa khỏi bệnh FMF. Hầu hết mọi người tiếp tục bị các cơn, nhưng số lượng và mức độ nghiêm trọng của các cơn là khác nhau ở mỗi người.', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn bị sốt đột ngột kèm theo đau bụng, ngực và khớp.';
MERGE (n:Disease {id: 'D1136'}) SET n.id = 'D1136', n.name = 'Thiếu máu Fanconi', n.name_en = 'Fanconi anemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000334.htm', n.prognosis = 'The survival rates khác nhau từ người này sang người khác. Triển vọng kém ở những người có lượng máu thấp. Các phương pháp điều trị mới và cải tiến, chẳng hạn như cấy ghép tủy xương, có khả năng cải t';
MERGE (n:Disease {id: 'D1137'}) SET n.id = 'D1137', n.name = 'Hội chứng Fanconi', n.name_en = 'Fanconi syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000333.htm', n.prognosis = 'Tiên lượng phụ thuộc vào bệnh lý có từ trước.', n.when_to_see = 'Liên hệ với bạn nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn bị mất nước hoặc yếu cơ.';
MERGE (n:Disease {id: 'D1138'}) SET n.id = 'D1138', n.name = 'Viễn thị', n.name_en = 'Farsightedness', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/farsightedness/symptoms-causes/syc-20372495 | https://medlineplus.gov/ency/article/001020.htm', n.overview = ', còn gọi là viễn thị, là một tình trạng thị lực phổ biến trong đó các vật ở xa nhìn rõ nhưng vật thể trông mờ. Người bị viễn thị nặng chỉ có thể nhìn rõ các vật ở xa. Những người bị viễn thị nhẹ có t', n.prognosis = 'Kết quả dự kiến ​​sẽ tốt.', n.when_to_see = 'Nếu tật viễn thị của bạn nặng đến mức bạn không thể thực hiện một công việc tốt như mong muốn hoặc nếu chất lượng thị lực ảnh hưởng đến việc bạn thích thú với các hoạt động, hãy đến gặp bác sĩ nhãn kh';
MERGE (n:Disease {id: 'D1139'}) SET n.id = 'D1139', n.name = 'Mệt mỏi', n.name_en = 'Fatigue', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003088.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn ngay lập tức nếu bạn có bất kỳ dấu hiệu nào sau đây: Nhầm lẫn hoặc chóng mặt Tầm nhìn mờ Ít hoặc không có nước tiểu Sưng và tăng cân gần đây Có ý nghĩ làm hại ';
MERGE (n:Disease {id: 'D1140'}) SET n.id = 'D1140', n.name = 'Bệnh gan nhiễm mỡ (MASLD)', n.name_en = 'Fatty liver disease (MASLD)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/fatty-liver-disease-masld/symptoms-causes/syc-20354567', n.overview = 'Bệnh gan nhiễm mỡ gan atty (phía dưới) xuất hiện to hơn và đổi màu. Các mẫu mô cho thấy có nhiều mỡ hơn trong bệnh gan nhiễm mỡ, trong khi tình trạng viêm và sẹo tiến triển được thấy ở viêm gan nhiễm ', n.when_to_see = 'Hãy hẹn gặp một thành viên trong nhóm chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng kéo dài khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cậ';
MERGE (n:Disease {id: 'D1141'}) SET n.id = 'D1141', n.name = 'Sốt co giật', n.name_en = 'Febrile seizure', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/febrile-seizure/symptoms-causes/syc-20372522', n.overview = 'Sốt co giật là tình trạng co giật ở trẻ do sốt. Sốt thường do nhiễm trùng. Sốt co giật xảy ra ở trẻ nhỏ, khỏe mạnh, phát triển bình thường và trước đó không có bất kỳ triệu chứng thần kinh nào. Thật đ', n.when_to_see = 'Hãy gặp bác sĩ của con bạn càng sớm càng tốt sau cơn co giật do sốt đầu tiên của con bạn, ngay cả khi nó chỉ kéo dài vài giây. Gọi xe cứu thương để đưa con bạn đến phòng cấp cứu nếu cơn động kinh kéo ';
MERGE (n:Disease {id: 'D1142'}) SET n.id = 'D1142', n.name = 'Ứ đọng phân', n.name_en = 'Fecal impaction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000230.htm', n.prognosis = 'Với việc điều trị, kết quả sẽ tốt.', n.when_to_see = 'Hãy cho nhà cung cấp dịch vụ của bạn biết nếu bạn bị tiêu chảy mãn tính hoặc đại tiện không tự chủ sau một thời gian dài bị táo bón. Đồng thời, hãy báo cho nhà cung cấp dịch vụ chăm sóc sức khỏe của b';
MERGE (n:Disease {id: 'D1143'}) SET n.id = 'D1143', n.name = 'Cấy ghép hệ vi sinh vật trong phân', n.name_en = 'Fecal microbiota transplant', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007703.htm', n.overview = 'FMT liên quan đến việc thu thập phân từ một người hiến tặng khỏe mạnh. Nhà cung cấp dịch vụ chăm sóc sức khoẻ của bạn sẽ yêu cầu bạn xác định một nhà tài trợ. Hầu hết mọi người chọn một thành viên tro', n.prognosis = 'Phương pháp điều trị này rất an toàn, hiệu quả và chi phí thấp. FMT hỗ trợ bằng cách đưa hệ vi sinh vật bình thường trở lại thông qua phân của người hiến tặng. Điều này lần lượt giúp phục hồi chức năn';
MERGE (n:Disease {id: 'D1144'}) SET n.id = 'D1144', n.name = 'Việc đặt ống nuôi ăn - phẫu thuật thông dạ dày', n.name_en = 'Feeding tube insertion - gastrostomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002937.htm', n.overview = 'Việc đặt ống nuôi ăn qua thông dạ dày được thực hiện một phần bằng thủ thuật gọi là nội soi . Đây là phương pháp quan sát bên trong cơ thể bằng cách sử dụng một ống linh hoạt có gắn một camera nhỏ ở đ', n.prognosis = 'Dạ dày và bụng sẽ lành sau 5 đến 7 ngày. Đau vừa phải có thể được điều trị bằng thuốc. Việc cho ăn sẽ bắt đầu từ từ với chất lỏng trong và tăng dần.';
MERGE (n:Disease {id: 'D1145'}) SET n.id = 'D1145', n.name = 'Hội chứng Felty', n.name_en = 'Felty syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000445.htm', n.prognosis = 'Tuy nhiên, việc điều trị RA sẽ cải thiện hội chứng Felty.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn xuất hiện các triệu chứng của chứng rối loạn này.';
MERGE (n:Disease {id: 'D1146'}) SET n.id = 'D1146', n.name = 'Bao cao su nữ', n.name_en = 'Female condoms', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/004002.htm', n.overview = 'Bao cao su nữ bảo vệ khỏi mang thai. Nó cũng bảo vệ chống lại các bệnh nhiễm trùng lây lan khi quan hệ tình dục, bao gồm cả HIV. Tuy nhiên, người ta cho rằng nó không có tác dụng tốt như bao cao su na';
MERGE (n:Disease {id: 'D1147'}) SET n.id = 'D1147', n.name = 'Vô sinh nữ', n.name_en = 'Female infertility', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/female-infertility/symptoms-causes/syc-20354308', n.overview = 'Vô sinh được định nghĩa là cố gắng mang thai bằng quan hệ tình dục thường xuyên, không được bảo vệ trong ít nhất một năm nhưng không thành công. Vô sinh là do yếu tố nữ chiếm khoảng 1/3 trường hợp và ', n.when_to_see = 'Thời điểm tìm kiếm sự trợ giúp có thể tùy thuộc vào độ tuổi của bạn: Cho đến 35 tuổi, hầu hết các bác sĩ khuyên bạn nên cố gắng mang thai ít nhất một năm trước khi xét nghiệm hoặc điều trị. Nếu bạn ở ';
MERGE (n:Disease {id: 'D1148'}) SET n.id = 'D1148', n.name = 'Chứng hói đầu ở nữ', n.name_en = 'Female pattern baldness', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001173.htm', n.prognosis = 'Chứng hói đầu ở nữ giới thường không phải là dấu hiệu của chứng rối loạn bệnh lý tiềm ẩn. Rụng tóc có thể ảnh hưởng đến lòng tự trọng và gây lo lắng. Rụng tóc thường là vĩnh viễn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị rụng tóc và tình trạng này vẫn tiếp tục, đặc biệt nếu bạn cũng bị ngứa, kích ứng da hoặc các triệu chứng khác. Có thể có nguyên nhân y tế nào đó';
MERGE (n:Disease {id: 'D1149'}) SET n.id = 'D1149', n.name = 'Rối loạn chức năng tình dục nữ', n.name_en = 'Female sexual dysfunction', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/female-sexual-dysfunction/symptoms-causes/syc-20372549', n.overview = 'là một thuật ngữ y tế chỉ các vấn đề tình dục đang diễn ra khiến bạn hoặc bạn tình của bạn khó chịu. Các vấn đề có thể liên quan đến phản ứng tình dục, ham muốn, cực khoái hoặc đau khi quan hệ. Nhiều ', n.when_to_see = 'Nếu các vấn đề tình dục ảnh hưởng đến mối quan hệ của bạn hoặc làm bạn lo lắng, hãy hẹn gặp một thành viên trong nhóm chăm sóc sức khỏe của bạn. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi ';
MERGE (n:Disease {id: 'D1150'}) SET n.id = 'D1150', n.name = 'Thoát vị đùi', n.name_en = 'Femoral hernia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001136.htm', n.prognosis = 'Khả năng thoát vị đùi tái phát sau phẫu thuật là rất thấp. Nếu ruột hoặc các mô khác bị kẹt, có thể cần phải cắt bỏ một phần ruột.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn hoặc đến phòng cấp cứu ngay nếu: Bạn đột nhiên bị đau ở vùng thoát vị và khối thoát vị không thể đẩy trở lại bụng bằng áp lực nhẹ. Bạn bị buồn nôn, nôn hoặ';
MERGE (n:Disease {id: 'D1151'}) SET n.id = 'D1151', n.name = 'Sửa chữa thoát vị xương đùi', n.name_en = 'Femoral hernia repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007399.htm', n.overview = 'Trong quá trình phẫu thuật để sửa chữa thoát vị, mô phồng lên được đẩy trở lại vào. Vùng yếu được khâu kín hoặc tăng cường. Việc sửa chữa này có thể được thực hiện bằng phẫu thuật mở hoặc nội soi. Bạn', n.prognosis = 'Kết quả của ca phẫu thuật này thường rất tốt. Ở một số người, chứng thoát vị quay trở lại.';
MERGE (n:Disease {id: 'D1152'}) SET n.id = 'D1152', n.name = 'Rối loạn chức năng thần kinh đùi', n.name_en = 'Femoral nerve dysfunction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000687.htm', n.prognosis = 'Nếu xác định được nguyên nhân gây rối loạn chức năng thần kinh xương đùi và điều trị thành công thì có thể hồi phục hoàn toàn. Trong một số trường hợp, có thể mất một phần hoặc toàn bộ khả năng vận độ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng rối loạn chức năng thần kinh xương đùi.';
MERGE (n:Disease {id: 'D1153'}) SET n.id = 'D1153', n.name = 'Quá liều canxi fenoprofen', n.name_en = 'Fenoprofen calcium overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002649.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào mức độ canxi fenoprofen đã được nuốt và việc điều trị được thực hiện nhanh chóng như thế nào. Nhận được sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Q';
MERGE (n:Disease {id: 'D1154'}) SET n.id = 'D1154', n.name = 'Hội chứng rượu bào thai', n.name_en = 'Fetal alcohol syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/fetal-alcohol-syndrome/symptoms-causes/syc-20352901 | https://medlineplus.gov/ency/article/000911.htm', n.overview = 'là tình trạng ở trẻ do tiếp xúc với rượu trong thời kỳ mang thai của người mẹ. Uống rượu khi mang thai có thể khiến trẻ bị khuyết tật về hành vi, học tập, tư duy và phát triển thể chất. Các triệu chứn', n.prognosis = 'Kết quả đối với trẻ sơ sinh mắc FAS là khác nhau. Hầu như không có đứa trẻ nào trong số này có sự phát triển trí não bình thường. Trẻ sơ sinh và trẻ em mắc FAS có nhiều vấn đề khác nhau và khó kiểm so', n.when_to_see = 'Nếu bạn đang mang thai và không thể ngừng uống rượu, hãy hỏi bác sĩ sản khoa, bác sĩ chăm sóc chính hoặc chuyên gia chăm sóc sức khỏe khác để được giúp đỡ. Bạn cũng có thể chọn nói chuyện với chuyên g';
MERGE (n:Disease {id: 'D1155'}) SET n.id = 'D1155', n.name = 'Fetal development', n.name_en = 'Fetal development', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002398.htm', n.overview = 'WEEK BY WEEK CHANGES Gestation is the period of time between conception and birth when a baby grows and develops inside the mother\'s womb. Vì không thể biết chính xác thời điểm thụ thai nên tuổi thai';
MERGE (n:Disease {id: 'D1156'}) SET n.id = 'D1156', n.name = 'Thai to', n.name_en = 'Fetal macrosomia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/fetal-macrosomia/symptoms-causes/syc-20372579', n.overview = 'là tình trạng thai nhi, được gọi là thai nhi, lớn hơn nhiều so với mức trung bình. Một bào thai được chẩn đoán mắc bệnh thai to được ước tính nặng hơn 8 pound, 13 ounce (4.000 gram) ở bất kỳ giai đoạn';
MERGE (n:Disease {id: 'D1157'}) SET n.id = 'D1157', n.name = 'Sốt', n.name_en = 'Fever', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/fever/symptoms-causes/syc-20352759 | https://medlineplus.gov/ency/article/003090.htm', n.overview = 'Sốt là hiện tượng nhiệt độ cơ thể tăng lên tạm thời. Đó là một phần của phản ứng tổng thể từ hệ thống miễn dịch của cơ thể. Sốt thường do nhiễm trùng. Đối với hầu hết trẻ em và người lớn, sốt có thể g', n.when_to_see = 'Liên hệ ngay với nhà cung cấp dịch vụ của con bạn nếu con bạn: Từ 3 tháng tuổi trở xuống và có nhiệt độ trực tràng từ 100,4°F (38°C) trở lên Từ 3 đến 12 tháng tuổi và bị sốt từ 102,2°F (39°C) trở lên ';
MERGE (n:Disease {id: 'D1158'}) SET n.id = 'D1158', n.name = 'Tiêu sợi huyết - nguyên phát hoặc thứ phát', n.name_en = 'Fibrinolysis - primary or secondary', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000577.htm';
MERGE (n:Disease {id: 'D1159'}) SET n.id = 'D1159', n.name = 'U xơ tuyến', n.name_en = 'Fibroadenoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/fibroadenoma/symptoms-causes/syc-20352752', n.overview = 'U xơ tuyến (fy-broe-ad-uh-NO-muh) là một khối u vú rắn chắc. Khối u vú này không phải là ung thư. U xơ tuyến xảy ra thường xuyên nhất ở độ tuổi từ 15 đến 35. Nhưng nó có thể được phát hiện ở mọi lứa t', n.when_to_see = 'Mô vú khỏe mạnh thường có cảm giác sần sùi. Hẹn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn: Phát hiện khối u vú mới Nhận thấy những thay đổi khác ở vú của bạn Phát hiện khối u vú mà bạ';
MERGE (n:Disease {id: 'D1160'}) SET n.id = 'D1160', n.name = 'U xơ tuyến vú', n.name_en = 'Fibroadenoma of the breast', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007216.htm', n.prognosis = 'Nếu khối u được giữ nguyên và theo dõi cẩn thận, nó có thể cần phải được loại bỏ sau đó nếu nó thay đổi, phát triển hoặc gây ra các triệu chứng. Trong một số ít trường hợp, khối u là ung thư và sẽ cần', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy: Bất kỳ khối u vú mới nào Một khối u vú mà nhà cung cấp dịch vụ của bạn đã kiểm tra trước đó, phát triển hoặc thay đổi ';
MERGE (n:Disease {id: 'D1161'}) SET n.id = 'D1161', n.name = 'Vú xơ hóa', n.name_en = 'Fibrocystic breasts', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/fibrocystic-breasts/symptoms-causes/syc-20350438 | https://medlineplus.gov/ency/article/000912.htm', n.overview = 'Những thay đổi về xơ nang ở vú dẫn đến sự phát triển của các túi hình tròn hoặc hình bầu dục chứa đầy chất lỏng, được gọi là u nang. Các u nang có thể làm cho ngực có cảm giác mềm, sần sùi hoặc thô rá', n.prognosis = 'Nếu kết quả khám vú và chụp quang tuyến vú của bạn cho kết quả bình thường thì bạn không cần phải lo lắng về các triệu chứng của mình. Những thay đổi về sợi xơ ở vú thường không làm tăng nguy cơ mắc b', n.when_to_see = 'Hầu hết những thay đổi về u xơ ở vú là bình thường. Tuy nhiên, hãy hẹn gặp bác sĩ nếu: Bạn phát hiện thấy một khối u vú mới hoặc dai dẳng hoặc một vùng mô vú dày lên hoặc cứng cáp hơn Bạn có một số vù';
MERGE (n:Disease {id: 'D1162'}) SET n.id = 'D1162', n.name = 'Chứng loạn sản sợi cơ', n.name_en = 'Fibromuscular dysplasia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/fibromuscular-dysplasia/symptoms-causes/syc-20352144', n.overview = 'các mô cơ và sợi trong động mạch dày lên khiến động mạch bị thu hẹp. Điều này được gọi là hẹp. Động mạch bị thu hẹp có thể làm giảm lưu lượng máu đến các cơ quan, gây tổn thương cơ quan. Động mạch đến', n.when_to_see = 'Nếu bạn mắc chứng loạn sản sợi cơ, hãy nhận trợ giúp y tế ngay lập tức nếu bạn có các triệu chứng của đột quỵ, chẳng hạn như: Thị lực thay đổi đột ngột. Thay đổi đột ngột về khả năng nói. Điểm yếu đột';
MERGE (n:Disease {id: 'D1163'}) SET n.id = 'D1163', n.name = 'Đau cơ xơ hóa', n.name_en = 'Fibromyalgia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/fibromyalgia/symptoms-causes/syc-20354780 | https://medlineplus.gov/ency/article/000427.htm', n.overview = 'là một tình trạng lâu dài gây đau nhức cơ thể lan rộng. Cơn đau xảy ra cùng với sự mệt mỏi. Nó cũng có thể liên quan đến các vấn đề về giấc ngủ, trí nhớ và tâm trạng. Các nhà nghiên cứu cho rằng chứng', n.prognosis = 'Đau cơ xơ hóa là một chứng rối loạn lâu dài. Đôi khi, các triệu chứng được cải thiện. Những lần khác, cơn đau có thể trở nên tồi tệ hơn và tiếp tục trong nhiều tháng hoặc nhiều năm.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng đau cơ xơ hóa.';
MERGE (n:Disease {id: 'D1164'}) SET n.id = 'D1164', n.name = 'Chứng loạn sản sợi', n.name_en = 'Fibrous dysplasia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001234.htm', n.prognosis = 'Triển vọng phụ thuộc vào mức độ nghiêm trọng của tình trạng và các triệu chứng xảy ra.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn có các triệu chứng của tình trạng này, chẳng hạn như gãy xương nhiều lần và biến dạng xương không rõ nguyên nhân. Các chuyên gia về chỉnh hình,';
MERGE (n:Disease {id: 'D1165'}) SET n.id = 'D1165', n.name = 'Bệnh thứ năm', n.name_en = 'Fifth disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000977.htm', n.prognosis = 'Hầu hết trẻ em và người lớn chỉ có triệu chứng nhẹ và hồi phục hoàn toàn.', n.when_to_see = 'Bạn nên liên hệ với nhà cung cấp dịch vụ của mình nếu: Con bạn có các triệu chứng của bệnh thứ năm. Bạn đang mang thai và nghĩ rằng mình có thể đã tiếp xúc với vi-rút hoặc bị phát ban.';
