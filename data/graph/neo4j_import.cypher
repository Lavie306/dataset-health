MERGE (n:Disease {id: 'D0598'}) SET n.id = 'D0598', n.name = 'Ngộ độc clo', n.name_en = 'Chlorine poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002772.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận nhanh như thế nào. Một người nhận được trợ giúp y tế càng sớm thì cơ hội phục hồi càng cao. Nuốt phải nhữ';
