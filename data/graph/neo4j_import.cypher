MERGE (n:Disease {id: 'D0943'}) SET n.id = 'D0943', n.name = 'Khô mắt', n.name_en = 'Dry eyes', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dry-eyes/symptoms-causes/syc-20371863', n.overview = 'Bệnh khô mắt là một tình trạng phổ biến xảy ra khi nước mắt của bạn không thể cung cấp đủ chất bôi trơn cho mắt. Nước mắt có thể không đủ và không ổn định vì nhiều lý do. Ví dụ, khô mắt có thể xảy ra ', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các dấu hiệu và triệu chứng khô mắt kéo dài, bao gồm mắt đỏ, khó chịu, mệt mỏi hoặc đau. Nhà cung cấp dịch vụ của bạn có thể thực hiện';
