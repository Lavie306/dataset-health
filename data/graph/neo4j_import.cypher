MERGE (n:Disease {id: 'D0854'}) SET n.id = 'D0854', n.name = 'Kỷ lục các mốc phát triển - 3 năm', n.name_en = 'Developmental milestones record - 3 years', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002014.htm', n.overview = 'Đây là những cột mốc điển hình đối với trẻ ở năm thứ 3 của cuộc đời. Hãy luôn nhớ rằng một số khác biệt là bình thường. Nếu bạn có thắc mắc về sự phát triển của con bạn, hãy liên hệ với nhà cung cấp d';
