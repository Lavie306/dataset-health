MERGE (n:Disease {id: 'D0936'}) SET n.id = 'D0936', n.name = 'Lượng đường trong máu thấp do thuốc', n.name_en = 'Drug-induced low blood sugar', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000310.htm';
MERGE (n:Disease {id: 'D0937'}) SET n.id = 'D0937', n.name = 'Lupus ban đỏ do thuốc', n.name_en = 'Drug-induced lupus erythematosus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000446.htm', n.prognosis = 'Hầu hết bệnh lupus ban đỏ do thuốc gây ra không nghiêm trọng như SLE. Các triệu chứng thường biến mất trong vòng vài ngày đến vài tuần sau khi ngừng dùng thuốc. Hiếm khi, viêm thận (viêm thận) có thể ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn phát triển các triệu chứng mới khi dùng bất kỳ loại thuốc nào được liệt kê ở trên. Các triệu chứng của bạn không thuyên giảm sau khi bạn ngừng dùng thuốc ';
MERGE (n:Disease {id: 'D0938'}) SET n.id = 'D0938', n.name = 'Bệnh phổi do thuốc', n.name_en = 'Drug-induced pulmonary disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000104.htm', n.prognosis = 'Các đợt cấp tính thường hết trong vòng 48 đến 72 giờ sau khi ngừng thuốc. Các triệu chứng mãn tính có thể mất nhiều thời gian hơn để cải thiện. Một số bệnh phổi do thuốc gây ra, chẳng hạn như xơ phổi,', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của chứng rối loạn này.';
MERGE (n:Disease {id: 'D0939'}) SET n.id = 'D0939', n.name = 'Giảm tiểu cầu do thuốc', n.name_en = 'Drug-induced thrombocytopenia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000556.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị chảy máu hoặc bầm tím không rõ nguyên nhân và đang dùng thuốc, chẳng hạn như những loại thuốc được đề cập ở trên trong phần Ng';
