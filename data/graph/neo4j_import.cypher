MERGE (n:Disease {id: 'D2382'}) SET n.id = 'D2382', n.name = 'Hội chứng sau bại liệt', n.name_en = 'Post-polio syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/post-polio-syndrome/symptoms-causes/syc-20355669', n.overview = 'là một nhóm các dấu hiệu và triệu chứng có khả năng gây tàn tật xuất hiện hàng thập kỷ sau khi mắc bệnh bại liệt ban đầu. Những dấu hiệu và triệu chứng này thường xuất hiện từ 30 đến 40 năm sau khi mắ', n.when_to_see = 'Hãy đến gặp bác sĩ nếu tình trạng suy nhược hoặc mệt mỏi ngày càng tăng. Điều quan trọng là loại trừ các nguyên nhân khác gây ra các dấu hiệu và triệu chứng của bạn và xác định xem bạn có mắc hội chứn';
MERGE (n:Disease {id: 'D2383'}) SET n.id = 'D2383', n.name = 'Rối loạn căng thẳng sau chấn thương', n.name_en = 'Post-traumatic stress disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000925.htm', n.prognosis = 'PTSD có thể được điều trị. Bạn có thể tăng cơ hội đạt được kết quả tốt: Hãy gặp nhà cung cấp ngay nếu bạn cho rằng mình mắc PTSD. Hãy tham gia tích cực vào quá trình điều trị của bạn và làm theo hướng', n.when_to_see = 'Mặc dù các sự kiện đau thương có thể gây đau khổ, nhưng không phải mọi cảm giác đau khổ đều là triệu chứng của PTSD. Nói về cảm xúc của bạn với bạn bè và người thân. Nếu các triệu chứng của bạn không ';
MERGE (n:Disease {id: 'D2384'}) SET n.id = 'D2384', n.name = 'Rối loạn căng thẳng sau chấn thương (PTSD)', n.name_en = 'Post-traumatic stress disorder (PTSD)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/post-traumatic-stress-disorder/symptoms-causes/syc-20355967', n.overview = 'là một tình trạng sức khỏe tâm thần gây ra bởi một sự kiện cực kỳ căng thẳng hoặc đáng sợ - dù là một phần của nó hoặc chứng kiến ​​nó. Các triệu chứng có thể bao gồm hồi tưởng, ác mộng, lo lắng nghiê', n.when_to_see = 'Hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn hoặc chuyên gia sức khỏe tâm thần nếu bạn có những suy nghĩ và cảm xúc lo lắng về một sự kiện đau buồn trong hơn một tháng, đặc biệt nếu chúng n';
MERGE (n:Disease {id: 'D2385'}) SET n.id = 'D2385', n.name = 'Hội chứng đau sau thắt ống dẫn tinh', n.name_en = 'Post-vasectomy pain syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/post-vasectomy-pain-syndrome/symptoms-causes/syc-20527047', n.overview = 'Thắt ống dẫn tinh là một thủ thuật nhỏ ngăn chặn việc cung cấp tinh trùng cho tinh dịch. Đây là một hình thức ngừa thai phổ biến ở nam giới được thực hiện bằng cách cắt và niêm phong các ống dẫn tinh ', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn ngay lập tức nếu bạn bị đau hoặc sưng ở tinh hoàn, chảy dịch từ dương vật hoặc đau khi đi tiểu. Nhà cung cấp dịch vụ của bạn có thể điều trị nguy';
MERGE (n:Disease {id: 'D2386'}) SET n.id = 'D2386', n.name = 'Teo vỏ não sau', n.name_en = 'Posterior cortical atrophy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/posterior-cortical-atrophy/symptoms-causes/syc-20376560', n.overview = 'là hội chứng não và hệ thần kinh khiến tế bào não chết theo thời gian. Nó gây ra vấn đề về thị lực và xử lý thông tin hình ảnh. Các triệu chứng phổ biến bao gồm khó đọc, phán đoán khoảng cách và với l';
MERGE (n:Disease {id: 'D2387'}) SET n.id = 'D2387', n.name = 'Khối u hố sau', n.name_en = 'Posterior fossa tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001404.htm', n.prognosis = 'Triển vọng tốt phụ thuộc vào việc phát hiện sớm bệnh ung thư. Sự tắc nghẽn hoàn toàn dòng chảy của dịch tủy sống có thể đe dọa tính mạng. Nếu khối u được phát hiện sớm, phẫu thuật có thể giúp bệnh nhâ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị đau đầu thường xuyên kèm theo buồn nôn, nôn mửa hoặc thay đổi thị lực.';
MERGE (n:Disease {id: 'D2388'}) SET n.id = 'D2388', n.name = 'Sa âm đạo phía sau (trực tràng)', n.name_en = 'Posterior vaginal prolapse (rectocele)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/rectocele/symptoms-causes/syc-20353414', n.overview = 'sa âm đạo phía sau, còn được gọi là sa trực tràng, là khi thành mô ngăn cách trực tràng với âm đạo yếu đi hoặc rách. Khi điều này xảy ra, các mô hoặc cấu trúc ngay phía sau thành âm đạo – trong trường', n.when_to_see = 'Đôi khi, sa âm đạo phía sau không gây ra vấn đề gì. Nhưng sa âm đạo sau ở mức độ trung bình hoặc nặng có thể gây khó chịu. Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe nếu các triệu chứng của bạn ản';
MERGE (n:Disease {id: 'D2389'}) SET n.id = 'D2389', n.name = 'Đau dây thần kinh sau herpes', n.name_en = 'Postherpetic neuralgia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/postherpetic-neuralgia/symptoms-causes/syc-20376588', n.overview = '(post-hur-PET-ik noo-RAL-juh) là biến chứng phổ biến nhất của bệnh zona. Nó gây ra cảm giác đau rát ở dây thần kinh và da. Cơn đau kéo dài rất lâu sau khi vết phát ban và mụn nước của bệnh zona biến m', n.when_to_see = 'Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe khi có dấu hiệu đầu tiên của bệnh zona. Thường thì cơn đau bắt đầu trước khi bạn nhận thấy phát ban. Nguy cơ đau dây thần kinh postherpetic sẽ thấp h';
