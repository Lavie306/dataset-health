MERGE (n:Disease {id: 'D1595'}) SET n.id = 'D1595', n.name = 'Vô sinh', n.name_en = 'Infertility', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/infertility/symptoms-causes/syc-20354317 | https://medlineplus.gov/ency/article/001191.htm', n.overview = 'Nếu bạn và bạn đời đang gặp khó khăn trong việc sinh con, bạn không đơn độc. Hàng triệu người trên khắp thế giới phải đối mặt với thách thức tương tự. Vô sinh là thuật ngữ y khoa khi bạn không thể man', n.prognosis = 'Có đến 1 trong 5 cặp vợ chồng được chẩn đoán vô sinh cuối cùng vẫn có thai mà không cần điều trị. Hầu hết các cặp vợ chồng bị vô sinh đều có thai sau khi điều trị.', n.when_to_see = 'Bạn có thể không cần gặp thành viên trong nhóm chăm sóc sức khỏe của mình về vấn đề vô sinh trừ khi bạn đã cố gắng mang thai ít nhất một năm. Nhưng phụ nữ nên nói chuyện với chuyên gia chăm sóc sức kh';
MERGE (n:Disease {id: 'D1596'}) SET n.id = 'D1596', n.name = 'Bệnh viêm ruột (IBD)', n.name_en = 'Inflammatory bowel disease (IBD)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/inflammatory-bowel-disease/symptoms-causes/syc-20353315', n.overview = 'Bệnh viêm ruột Câu hỏi thường gặp Bác sĩ tiêu hóa William Faubion, M.D., trả lời các câu hỏi thường gặp nhất về bệnh viêm ruột. Hiển thị bản ghi cho video Bệnh viêm ruột Câu hỏi thường gặp {Đang phát ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn nhận thấy thói quen đại tiện của mình có sự thay đổi lâu dài hoặc nếu bạn có bất kỳ triệu chứng nào của bệnh viêm ruột. Mặc dù bệnh viêm ruột thường không ';
MERGE (n:Disease {id: 'D1597'}) SET n.id = 'D1597', n.name = 'Ung thư vú dạng viêm', n.name_en = 'Inflammatory breast cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/inflammatory-breast-cancer/symptoms-causes/syc-20355413', n.overview = 'thường xuất hiện dưới dạng vú to và da dày lên. Da có thể trông đỏ, tím hoặc bầm tím. Ung thư vú dạng viêm là một dạng ung thư vú gây sưng vú và thay đổi da. Ung thư vú dạng viêm xảy ra khi sự phát tr', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Các tình trạng khác phổ biến hơn có các triệu chứng tương tự như ung thư vú dạng viêm. Ch';
MERGE (n:Disease {id: 'D1598'}) SET n.id = 'D1598', n.name = 'Cúm (cúm)', n.name_en = 'Influenza (flu)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/flu/symptoms-causes/syc-20351719', n.overview = 'Cúm, còn được gọi là cúm, là một bệnh nhiễm trùng ở mũi, họng và phổi, là một phần của hệ hô hấp. Bệnh cúm là do virus gây ra. Vi-rút cúm khác với vi-rút "cúm dạ dày" gây tiêu chảy và nôn mửa. Hầu hết', n.when_to_see = 'Hầu hết những người mắc bệnh cúm đều có thể kiểm soát bệnh tại nhà và thường không cần gặp chuyên gia chăm sóc sức khỏe. Nếu bạn có các triệu chứng cúm và có nguy cơ bị biến chứng, hãy gặp chuyên gia ';
MERGE (n:Disease {id: 'D1599'}) SET n.id = 'D1599', n.name = 'Vắc xin cúm (cúm) (bất hoạt hoặc tái tổ hợp) - những điều bạn cần biết', n.name_en = 'Influenza (flu) vaccine (inactivated or recombinant) - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007600.htm', n.overview = 'Tại sao phải tiêm phòng? Vắc-xin cúm có thể phòng ngừa bệnh cúm (cúm). Cúm là một bệnh truyền nhiễm lây lan khắp Hoa Kỳ hàng năm, thường là từ tháng 10 đến tháng 5. Bất cứ ai cũng có thể bị cúm, nhưng';
MERGE (n:Disease {id: 'D1600'}) SET n.id = 'D1600', n.name = 'Vắc xin cúm (cúm) (sống, tiêm qua mũi) - những điều bạn cần biết', n.name_en = 'Influenza (flu) vaccine (live, intranasal) - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007601.htm', n.overview = 'Tại sao phải tiêm phòng? Vắc-xin cúm có thể ngăn ngừa bệnh cúm (cúm) Cúm là một bệnh truyền nhiễm lây lan khắp Hoa Kỳ hàng năm, thường là từ tháng 10 đến tháng 5. Bất cứ ai cũng có thể bị cúm, nhưng n';
MERGE (n:Disease {id: 'D1601'}) SET n.id = 'D1601', n.name = 'Lông mọc ngược', n.name_en = 'Ingrown hair', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ingrown-hair/symptoms-causes/syc-20373893', n.overview = 'xảy ra khi sợi lông đã bị loại bỏ bắt đầu mọc trở lại và cong vào da. Cạo, nhổ hoặc tẩy lông có thể gây ra hiện tượng này. Lông mọc ngược có thể gây ra những vết sưng nhỏ, sưng tấy trên da và có thể g', n.when_to_see = 'Thỉnh thoảng lông mọc ngược không phải là điều đáng lo ngại. Tìm kiếm sự chăm sóc y tế nếu tình trạng của bạn không thuyên giảm hoặc nếu nó gây ra vấn đề thường xuyên. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1602'}) SET n.id = 'D1602', n.name = 'Móng chân mọc ngược', n.name_en = 'Ingrown toenail', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001237.htm', n.prognosis = 'Việc điều trị thường kiểm soát tình trạng nhiễm trùng và giảm đau. Tình trạng này có thể quay trở lại nếu bạn không thực hành chăm sóc bàn chân tốt. Tình trạng này có thể trở nên nghiêm trọng ở những ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn: Không thể điều trị móng chân mọc ngược tại nhà Bị đau dữ dội, mẩn đỏ, sưng tấy hoặc sốt Bị tiểu đường, tổn thương dây thần kinh ở chân hoặc bàn ch';
MERGE (n:Disease {id: 'D1603'}) SET n.id = 'D1603', n.name = 'Thoát vị bẹn', n.name_en = 'Inguinal hernia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/inguinal-hernia/symptoms-causes/syc-20351547', n.overview = 'Thoát vị bẹn xảy ra khi mô, chẳng hạn như một phần của ruột, chọc qua một điểm yếu ở cơ bụng. Kết quả là khối phồng có thể gây đau, đặc biệt là khi ho, cúi xuống hoặc nâng vật nặng. Tuy nhiên, nhiều t', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc ngay lập tức nếu khối thoát vị chuyển sang màu đỏ, tím hoặc sẫm màu hoặc nếu bạn nhận thấy bất kỳ triệu chứng nào khác của thoát vị nghẹt. Hãy đến gặp chuyên gia chăm sóc sức ';
MERGE (n:Disease {id: 'D1604'}) SET n.id = 'D1604', n.name = 'Sửa chữa thoát vị bẹn', n.name_en = 'Inguinal hernia repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007406.htm', n.overview = 'Trong quá trình phẫu thuật để sửa chữa thoát vị, mô phồng lên sẽ được đẩy trở lại vào bụng của bạn. Thành bụng của bạn được tăng cường và hỗ trợ bằng các mũi khâu (mũi khâu) và thường là lưới. Việc sử', n.prognosis = 'Kết quả của ca phẫu thuật này thường rất tốt. Ở một số người, chứng thoát vị quay trở lại.';
MERGE (n:Disease {id: 'D1605'}) SET n.id = 'D1605', n.name = 'Rối loạn chuyển hóa di truyền', n.name_en = 'Inherited metabolic disorders', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/inherited-metabolic-disorders/symptoms-causes/syc-20352590', n.overview = 'là tình trạng bệnh lý gây ra bởi những thay đổi trong các gen cụ thể ảnh hưởng đến quá trình trao đổi chất. Những thay đổi gen khác nhau gây ra các loại rối loạn chuyển hóa di truyền khác nhau. Những ', n.when_to_see = 'Nếu bạn lo lắng về sự tăng trưởng và phát triển của con bạn hoặc sức khỏe của chính bạn, hãy nói chuyện với bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin';
MERGE (n:Disease {id: 'D1606'}) SET n.id = 'D1606', n.name = 'Chấn thương - thận và niệu quản', n.name_en = 'Injury - kidney and ureter', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001065.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào nguyên nhân và mức độ nghiêm trọng của chấn thương. Đôi khi, thận bắt đầu hoạt động bình thường trở lại. Đôi khi, suy thận xảy ra.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng chấn thương thận hoặc niệu quản. Liên hệ với nhà cung cấp nếu bạn có tiền sử: Tiếp xúc với các chất độc hại Bệnh Nhiễm trùng Chấ';
MERGE (n:Disease {id: 'D1607'}) SET n.id = 'D1607', n.name = 'Ngộ độc mực', n.name_en = 'Ink poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002791.htm', n.prognosis = 'Tình trạng sức khỏe của người đó phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận như thế nào. Người đó nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Bởi vì m';
MERGE (n:Disease {id: 'D1608'}) SET n.id = 'D1608', n.name = 'Ngộ độc chất tẩy mực', n.name_en = 'Ink remover poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002790.htm', n.prognosis = 'Sức khỏe của người đó phụ thuộc vào lượng chất độc nuốt vào và thời gian điều trị được tiếp nhận nhanh như thế nào. Người đó nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Metanol là';
MERGE (n:Disease {id: 'D1609'}) SET n.id = 'D1609', n.name = 'Côn trùng cắn và đốt', n.name_en = 'Insect bites and stings', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000033.htm', n.when_to_see = 'Hãy gọi 911 hoặc số điện thoại khẩn cấp tại địa phương nếu người bị vết đốt có các triệu chứng sau: Khó thở, thở khò khè, hụt hơi Sưng bất cứ nơi nào trên mặt hoặc trong miệng Cổ họng thắt lại hoặc kh';
MERGE (n:Disease {id: 'D1610'}) SET n.id = 'D1610', n.name = 'Ngộ độc thuốc trừ sâu', n.name_en = 'Insecticide poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002832.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào mức độ nghiêm trọng của ngộ độc và tốc độ điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải những chất độc này có thể gây ản';
MERGE (n:Disease {id: 'D1611'}) SET n.id = 'D1611', n.name = 'Mất ngủ', n.name_en = 'Insomnia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/insomnia/symptoms-causes/syc-20355167 | https://medlineplus.gov/ency/article/000805.htm', n.overview = 'là một chứng rối loạn giấc ngủ phổ biến có thể khiến bạn khó ngủ hoặc khó duy trì giấc ngủ. Nó cũng có thể khiến bạn thức dậy quá sớm và không thể ngủ lại. Bạn có thể vẫn cảm thấy mệt mỏi khi thức dậy', n.prognosis = 'Hầu hết mọi người đều có thể ngủ được bằng cách thực hành vệ sinh giấc ngủ tốt.', n.when_to_see = 'Nếu chứng mất ngủ khiến bạn khó thực hiện các hoạt động hàng ngày, hãy đến gặp bác sĩ hoặc chuyên gia chăm sóc chính khác. Bác sĩ sẽ tìm kiếm nguyên nhân gây ra vấn đề về giấc ngủ của bạn và giúp điều';
MERGE (n:Disease {id: 'D1612'}) SET n.id = 'D1612', n.name = 'Insulinoma', n.name_en = 'Insulinoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000387.htm', n.prognosis = 'Trong hầu hết các trường hợp, khối u không phải là ung thư (lành tính) và phẫu thuật có thể chữa khỏi bệnh. Nhưng phản ứng hạ đường huyết nghiêm trọng hoặc sự lây lan của khối u ung thư sang các cơ qu', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn phát triển bất kỳ triệu chứng nào của bệnh u insulin. Động kinh và mất ý thức là một trường hợp khẩn cấp. Gọi 911 hoặc số khẩn cấ';
MERGE (n:Disease {id: 'D1613'}) SET n.id = 'D1613', n.name = 'Khuyết tật trí tuệ', n.name_en = 'Intellectual disability', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001523.htm', n.prognosis = 'Kết quả phụ thuộc vào: Mức độ nghiêm trọng và nguyên nhân gây ra tình trạng thiểu năng trí tuệ Các tình trạng khác Điều trị và liệu pháp Nhiều người có cuộc sống hiệu quả và học cách tự hoạt động. Nhữ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn có bất kỳ mối lo ngại nào về sự phát triển của con bạn Bạn nhận thấy các kỹ năng vận động hoặc ngôn ngữ của con bạn không phát triển bình thường Con bạn m';
MERGE (n:Disease {id: 'D1614'}) SET n.id = 'D1614', n.name = 'Co rút liên sườn', n.name_en = 'Intercostal retractions', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003322.htm', n.when_to_see = 'Hãy tìm kiếm sự trợ giúp y tế ngay lập tức nếu xảy ra hiện tượng co rút liên sườn. Đây có thể là dấu hiệu của đường thở bị tắc, có thể nhanh chóng đe dọa tính mạng. Đồng thời, hãy tìm kiếm sự chăm sóc';
MERGE (n:Disease {id: 'D1615'}) SET n.id = 'D1615', n.name = 'Rối loạn bùng nổ không liên tục', n.name_en = 'Intermittent explosive disorder', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/intermittent-explosive-disorder/symptoms-causes/syc-20373921', n.overview = 'liên quan đến những cơn bốc đồng, hung hãn, bạo lực hoặc những cơn bộc phát giận dữ bằng lời nói. Các phản ứng quá cực đoan đối với tình hình. Giận dữ trên đường, bạo hành gia đình, ném hoặc đập vỡ đồ', n.when_to_see = 'Nếu bạn nhận ra hành vi của chính mình trong mô tả về chứng rối loạn bùng nổ liên tục, hãy nói chuyện với bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác về các lựa chọn điều trị. Bạn cũng có thể yêu cầ';
MERGE (n:Disease {id: 'D1616'}) SET n.id = 'D1616', n.name = 'Viêm bàng quang kẽ', n.name_en = 'Interstitial cystitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/interstitial-cystitis/symptoms-causes/syc-20354357 | https://medlineplus.gov/ency/article/000477.htm', n.overview = '(in-tur-STISH-ul sis-TIE-tis) là một tình trạng mãn tính gây ra áp lực bàng quang, đau bàng quang và đôi khi là đau vùng chậu. Cơn đau dao động từ khó chịu nhẹ đến đau dữ dội. Tình trạng này là một ph', n.prognosis = 'Kết quả điều trị khác nhau. Một số người đáp ứng tốt với các phương pháp điều trị đơn giản và thay đổi chế độ ăn uống. Những người khác có thể yêu cầu điều trị rộng rãi hoặc phẫu thuật.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng của IC. Hãy chắc chắn đề cập rằng bạn nghi ngờ rối loạn này. Nó không phải lúc nào cũng dễ dàng được nhận ra hoặc chẩn đoán. Nó thường b';
MERGE (n:Disease {id: 'D1617'}) SET n.id = 'D1617', n.name = 'Viêm giác mạc kẽ', n.name_en = 'Interstitial keratitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001609.htm', n.prognosis = 'Chẩn đoán và điều trị sớm bệnh viêm giác mạc kẽ và nguyên nhân của nó có thể bảo tồn được giác mạc rõ ràng và thị lực tốt.', n.when_to_see = 'Người bị viêm giác mạc kẽ cần được theo dõi chặt chẽ bởi bác sĩ nhãn khoa và chuyên gia y tế có kiến ​​thức về bệnh lý tiềm ẩn. Người mắc bệnh này cần được kiểm tra ngay lập tức nếu: Đau trở nên trầm ';
MERGE (n:Disease {id: 'D1618'}) SET n.id = 'D1618', n.name = 'Bệnh phổi kẽ', n.name_en = 'Interstitial lung disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/interstitial-lung-disease/symptoms-causes/syc-20353108 | https://medlineplus.gov/ency/article/000128.htm', n.overview = 'Bệnh phổi kẽ (in-tur-STISH-ul), còn được gọi là ILD, mô tả một nhóm lớn các tình trạng. Hầu hết các tình trạng này gây viêm và sẹo tiến triển ở mô phổi. Là một phần của quá trình này, mô phổi dày lên ', n.prognosis = 'Cơ hội phục hồi hoặc ILD trở nên nặng hơn tùy thuộc vào nguyên nhân và mức độ nghiêm trọng của bệnh khi được chẩn đoán lần đầu. Một số người mắc ILD bị suy tim và huyết áp cao trong các mạch máu của p', n.when_to_see = 'Vào thời điểm các triệu chứng xuất hiện ở một số loại bệnh phổi kẽ, tổn thương phổi kéo dài đã xảy ra. Đó là lý do tại sao điều quan trọng là phải gặp chuyên gia chăm sóc sức khỏe của bạn khi có dấu h';
MERGE (n:Disease {id: 'D1619'}) SET n.id = 'D1619', n.name = 'Viêm thận kẽ', n.name_en = 'Interstitial nephritis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000464.htm', n.prognosis = 'Thông thường, viêm thận kẽ là một rối loạn ngắn hạn. Trong một số ít trường hợp, nó có thể gây tổn thương vĩnh viễn, bao gồm suy thận lâu dài (mãn tính). Viêm thận kẽ cấp tính có thể nặng hơn và có nh', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của viêm thận kẽ. Nếu bạn bị viêm thận kẽ, hãy liên hệ với bác sĩ nếu bạn gặp các triệu chứng mới, đặc biệt nếu bạn kém tỉnh táo';
MERGE (n:Disease {id: 'D1620'}) SET n.id = 'D1620', n.name = 'Intertrigo', n.name_en = 'Intertrigo', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003223.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Tình trạng này không biến mất, ngay cả khi được chăm sóc tốt tại nhà. Vùng da bị ảnh hưởng lan rộng ra ngoài nếp gấp da.';
MERGE (n:Disease {id: 'D1621'}) SET n.id = 'D1621', n.name = 'Thiếu máu cục bộ đường ruột', n.name_en = 'Intestinal ischemia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/intestinal-ischemia/symptoms-causes/syc-20373946', n.overview = 'Đại tràng và ruột non là những bộ phận của đường tiêu hóa, có nhiệm vụ xử lý các loại thực phẩm bạn ăn. Ruột lấy chất dinh dưỡng từ thức ăn. Những gì không được ruột hấp thụ sẽ di chuyển dọc theo đườn', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn bị đau bụng đột ngột và dữ dội. Cơn đau khiến bạn cảm thấy tồi tệ đến mức không thể ngồi yên hoặc tìm một tư thế ổn định là trường hợp cấp cứu y tế. ';
MERGE (n:Disease {id: 'D1622'}) SET n.id = 'D1622', n.name = 'Tắc ruột', n.name_en = 'Intestinal obstruction', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/intestinal-obstruction/symptoms-causes/syc-20351460', n.overview = 'là tình trạng tắc nghẽn khiến thức ăn hoặc chất lỏng không thể đi qua ruột non hoặc ruột già (đại tràng) của bạn. Nguyên nhân gây tắc ruột có thể bao gồm các dải mô xơ (dính) ở bụng hình thành sau phẫ', n.when_to_see = 'Do các biến chứng nghiêm trọng có thể phát triển từ đường ruột tắc nghẽn, hãy tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn bị đau bụng dữ dội hoặc các triệu chứng khác của tắc ruột.';
MERGE (n:Disease {id: 'D1623'}) SET n.id = 'D1623', n.name = 'Tắc ruột và tắc ruột', n.name_en = 'Intestinal obstruction and Ileus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000260.htm', n.prognosis = 'Kết quả phụ thuộc vào nguyên nhân gây tắc nghẽn. Hầu hết thời gian, nguyên nhân được điều trị thành công.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn: Không thể đại tiện hoặc ra khí Có bụng sưng (chướng) không biến mất Tiếp tục nôn mửa Đau bụng không rõ nguyên nhân và không biến mất';
MERGE (n:Disease {id: 'D1624'}) SET n.id = 'D1624', n.name = 'Việc sửa chữa tắc nghẽn đường ruột', n.name_en = 'Intestinal obstruction repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002927.htm', n.overview = 'được thực hiện trong khi bạn đang được gây mê toàn thân. Điều này có nghĩa là bạn đang ngủ và không cảm thấy đau. Bác sĩ phẫu thuật sẽ rạch bụng bạn để xem ruột của bạn. Đôi khi, phẫu thuật có thể đượ', n.prognosis = 'Kết quả thường tốt nếu tắc nghẽn được điều trị trước khi lưu lượng máu qua ruột bị ảnh hưởng. Những người đã trải qua nhiều cuộc phẫu thuật vùng bụng có thể hình thành mô sẹo. Họ có nhiều khả năng bị ';
MERGE (n:Disease {id: 'D1625'}) SET n.id = 'D1625', n.name = 'Giả tắc nghẽn đường ruột', n.name_en = 'Intestinal pseudo-obstruction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000253.htm', n.prognosis = 'Hầu hết các trường hợp giả tắc nghẽn cấp tính sẽ thuyên giảm sau vài ngày điều trị. Ở dạng bệnh mãn tính, các triệu chứng có thể quay trở lại và trở nên trầm trọng hơn trong nhiều năm. Nếu ruột giãn r', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị đau bụng không thuyên giảm hoặc có các triệu chứng khác của chứng rối loạn này.';
MERGE (n:Disease {id: 'D1626'}) SET n.id = 'D1626', n.name = 'Khối máu tụ nội sọ', n.name_en = 'Intracranial hematoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/intracranial-hematoma/symptoms-causes/syc-20356145', n.overview = 'Khối máu tụ nội sọ là sự tích tụ máu trong hộp sọ. Máu có thể tích tụ trong mô não hoặc bên dưới hộp sọ, đè lên não. Nguyên nhân thường do mạch máu bị vỡ trong não. Nó cũng có thể do chấn thương đầu d', n.when_to_see = 'Khối máu tụ nội sọ có thể đe dọa tính mạng và cần được điều trị khẩn cấp. Tìm kiếm sự chăm sóc y tế ngay lập tức sau một cú đánh vào đầu nếu bạn hoặc ai đó bạn biết gặp phải tình trạng: Mất ý thức. Mộ';
MERGE (n:Disease {id: 'D1627'}) SET n.id = 'D1627', n.name = 'Dị tật tĩnh mạch nội sọ', n.name_en = 'Intracranial venous malformations', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/intracranial-venous-malformations/symptoms-causes/syc-20353336', n.overview = 'là các tĩnh mạch trong não có kích thước lớn bất thường. Những tĩnh mạch lớn hơn này không có khả năng gây ra triệu chứng hoặc ảnh hưởng đến hoạt động của tĩnh mạch. Một số người có thể bị dị dạng tĩn', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế nếu bạn có bất kỳ triệu chứng nào của dị tật tĩnh mạch nội sọ.';
MERGE (n:Disease {id: 'D1628'}) SET n.id = 'D1628', n.name = 'U nhú trong ống', n.name_en = 'Intraductal papilloma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001238.htm', n.prognosis = 'Phần lớn, u nhú nội ống dường như không làm tăng nguy cơ phát triển ung thư vú. Kết quả là tuyệt vời cho những người có một u nhú. Nguy cơ mắc bệnh ung thư có thể cao hơn đối với: Phụ nữ có nhiều u nh', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nhận thấy có dịch tiết ở vú hoặc khối u ở vú.';
MERGE (n:Disease {id: 'D1629'}) SET n.id = 'D1629', n.name = 'Trong tử cung', n.name_en = 'Intrauterine', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002389.htm', n.overview = 'Một em bé lớn lên bên trong bụng mẹ hoặc tử cung của người mẹ. Điều này được gọi là mang thai trong tử cung. Dụng cụ tử cung (DCTC) là một vật được đặt vào tử cung để ngăn ngừa thụ thai và mang thai.';
MERGE (n:Disease {id: 'D1630'}) SET n.id = 'D1630', n.name = 'Dụng cụ tử cung (IUD)', n.name_en = 'Intrauterine devices (IUD)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007635.htm', n.overview = 'Vòng tránh thai thường được nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn đặt vào trong kỳ kinh nguyệt hàng tháng của bạn. Bất kỳ loại vòng tránh thai nào cũng có thể được đặt nhanh chóng và dễ dàng ';
MERGE (n:Disease {id: 'D1631'}) SET n.id = 'D1631', n.name = 'Hạn chế tăng trưởng trong tử cung', n.name_en = 'Intrauterine growth restriction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001500.htm', n.prognosis = 'Sau khi sinh, sự tăng trưởng và phát triển của trẻ sơ sinh phụ thuộc vào mức độ nghiêm trọng và nguyên nhân gây ra IUGR. Thảo luận về triển vọng của em bé với các nhà cung cấp của bạn.', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu bạn đang mang thai và nhận thấy con bạn cử động ít hơn bình thường. Sau khi sinh, hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn n';
MERGE (n:Disease {id: 'D1632'}) SET n.id = 'D1632', n.name = 'Xuất huyết não thất ở trẻ sơ sinh', n.name_en = 'Intraventricular hemorrhage of the newborn', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007301.htm', n.prognosis = 'Trẻ sơ sinh khỏe mạnh như thế nào tùy thuộc vào việc trẻ sinh non như thế nào và mức độ xuất huyết. Chưa đến một nửa số trẻ bị chảy máu mức độ thấp có vấn đề lâu dài. Tuy nhiên, chảy máu nghiêm trọng ', n.when_to_see = 'Các triệu chứng thần kinh hoặc sốt ở trẻ được đặt ống dẫn lưu có thể là dấu hiệu của tắc nghẽn hoặc nhiễm trùng. Em bé cần được chăm sóc y tế ngay lập tức nếu điều này xảy ra. Hầu hết các đơn vị chăm ';
MERGE (n:Disease {id: 'D1633'}) SET n.id = 'D1633', n.name = 'Tiêm nội hấp', n.name_en = 'Intravitreal injection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007629.htm', n.overview = 'Quy trình này được thực hiện tại văn phòng nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Mất khoảng 15 đến 30 phút. Thuốc nhỏ sẽ được nhỏ vào mắt bạn để mở rộng (giãn) đồng tử. Bạn sẽ nằm ngửa trong', n.prognosis = 'Triển vọng của bạn phụ thuộc chủ yếu vào tình trạng đang được điều trị. Tầm nhìn của bạn có thể vẫn ổn định hoặc cải thiện sau thủ thuật. Bạn có thể cần nhiều hơn một mũi tiêm.';
MERGE (n:Disease {id: 'D1634'}) SET n.id = 'D1634', n.name = 'Yếu tố nội tại', n.name_en = 'Intrinsic factor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002381.htm', n.overview = 'liên kết với vitamin B12 trong dạ dày. Sau khi gắn vào, yếu tố nội tại và B12 di chuyển xuống ruột để hấp thu vào máu. Vitamin B12 cần thiết cho các tế bào hồng cầu hình thành và phát triển. Một số ng';
MERGE (n:Disease {id: 'D1635'}) SET n.id = 'D1635', n.name = 'Lồng ruột', n.name_en = 'Intussusception', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/intussusception/symptoms-causes/syc-20351452', n.overview = '(in-tuh-suh-SEP-shun) là một tình trạng nghiêm trọng trong đó một phần ruột trượt vào một phần khác, giống như kính viễn vọng. Hành động kính thiên văn này thường chặn thức ăn hoặc chất lỏng đi qua. L', n.when_to_see = 'Lồng ruột cần được chăm sóc y tế khẩn cấp. Nếu bạn hoặc con bạn xuất hiện các triệu chứng liệt kê ở trên, hãy tìm sự trợ giúp y tế ngay lập tức. Ở trẻ sơ sinh, kéo đầu gối lên ngực và khóc thường là t';
MERGE (n:Disease {id: 'D1636'}) SET n.id = 'D1636', n.name = 'Lồng ruột – trẻ em', n.name_en = 'Intussusception – children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000958.htm', n.prognosis = 'Kết quả điều trị sớm sẽ tốt. Có nguy cơ vấn đề này sẽ quay trở lại. Khi xảy ra một lỗ hoặc vết rách ở ruột, nó phải được điều trị ngay lập tức. Nếu không được điều trị, lồng ruột hầu như luôn gây tử v', n.when_to_see = 'Lồng ruột là một trường hợp cấp cứu y tế. Gọi 911 hoặc số cấp cứu tại địa phương hoặc đến phòng cấp cứu ngay.';
MERGE (n:Disease {id: 'D1637'}) SET n.id = 'D1637', n.name = 'Ung thư biểu mô tiểu thùy xâm lấn', n.name_en = 'Invasive lobular carcinoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/invasive-lobular-carcinoma/symptoms-causes/syc-20373973', n.overview = 'là một loại ung thư vú bắt đầu bằng sự phát triển của các tế bào trong tuyến sản xuất sữa của vú. Những tuyến này được gọi là tiểu thùy. Ung thư xâm lấn có nghĩa là các tế bào ung thư đã vỡ ra khỏi ti', n.when_to_see = 'Đặt lịch hẹn với bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn nhận thấy có sự thay đổi ở ngực của mình. Những thay đổi cần quan sát có thể bao gồm khối u, vùng da nhăn nheo hoặc bất thường, v';
MERGE (n:Disease {id: 'D1638'}) SET n.id = 'D1638', n.name = 'Ngộ độc iốt', n.name_en = 'Iodine poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002658.htm', n.prognosis = 'Sức khỏe của một người khỏe mạnh như thế nào tùy thuộc vào lượng iốt nuốt vào và tốc độ điều trị được tiếp nhận như thế nào. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. ';
MERGE (n:Disease {id: 'D1639'}) SET n.id = 'D1639', n.name = 'Điện di ion', n.name_en = 'Iontophoresis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007293.htm', n.overview = 'Khu vực cần xử lý được đặt vào trong nước. Một dòng điện nhẹ nhàng truyền qua nước. Kỹ thuật viên cẩn thận và tăng dần dòng điện cho đến khi bạn cảm thấy hơi ngứa ran. Liệu pháp này kéo dài khoảng 30 ';
MERGE (n:Disease {id: 'D1640'}) SET n.id = 'D1640', n.name = 'Kiểm tra IQ', n.name_en = 'IQ testing', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001912.htm', n.overview = 'Nhiều bài kiểm tra IQ được sử dụng ngày nay. Việc chúng đo lường trí thông minh thực sự hay chỉ đơn giản là những khả năng nhất định vẫn còn gây tranh cãi. Bài kiểm tra IQ đo lường khả năng hoạt động ';
MERGE (n:Disease {id: 'D1641'}) SET n.id = 'D1641', n.name = 'Viêm mống mắt', n.name_en = 'Iritis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/iritis/symptoms-causes/syc-20354961', n.overview = 'Mắt có uvea và lòng trắng của mắt (củng mạc). Nó có ba phần: (1) mống mắt, là phần có màu của mắt; (2) cơ thể mi, là cấu trúc trong mắt tiết ra chất lỏng trong suốt ở phía trước mắt; và (3) màng đệm, ', n.when_to_see = 'Hãy đến gặp bác sĩ chuyên khoa mắt (bác sĩ nhãn khoa) càng sớm càng tốt nếu bạn có triệu chứng viêm mống mắt. Điều trị kịp thời giúp ngăn ngừa các biến chứng nghiêm trọng. Nếu bạn bị đau mắt và các vấ';
MERGE (n:Disease {id: 'D1642'}) SET n.id = 'D1642', n.name = 'Thiếu máu thiếu sắt', n.name_en = 'Iron deficiency anemia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/iron-deficiency-anemia/symptoms-causes/syc-20355034 | https://medlineplus.gov/ency/article/000584.htm', n.overview = 'là một loại thiếu máu phổ biến. Thiếu máu là tình trạng máu không có đủ hồng cầu khỏe mạnh. Các tế bào hồng cầu mang oxy đến các mô của cơ thể. Không nhận đủ chất sắt có thể gây thiếu sắt. Vì vậy, có ', n.prognosis = 'Với việc điều trị, kết quả có thể sẽ tốt, nhưng nó phụ thuộc vào nguyên nhân.', n.when_to_see = 'Nếu bạn hoặc con bạn gặp các triệu chứng có thể là do thiếu máu do thiếu sắt, hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn. Đừng cố gắng tự mình chẩn đoán hoặc điều trị. Và nói chuyện với chuyên g';
MERGE (n:Disease {id: 'D1643'}) SET n.id = 'D1643', n.name = 'Quá liều sắt', n.name_en = 'Iron overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002659.htm', n.prognosis = 'Có nhiều khả năng phục hồi nếu các triệu chứng của người đó biến mất 48 giờ sau khi dùng sắt quá liều. Tuy nhiên, tổn thương gan nghiêm trọng có thể xảy ra từ 2 đến 5 ngày sau khi dùng quá liều. Một s';
MERGE (n:Disease {id: 'D1644'}) SET n.id = 'D1644', n.name = 'Hội chứng thức-ngủ không đều', n.name_en = 'Irregular sleep-wake syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000806.htm', n.prognosis = 'Kết quả điều trị thường tốt. Nhưng một số người vẫn tiếp tục mắc chứng rối loạn này, ngay cả khi đã điều trị.', n.when_to_see = 'Hầu hết mọi người đôi khi bị rối loạn giấc ngủ. Nếu kiểu ngủ-thức không đều này xảy ra thường xuyên và không có nguyên nhân, hãy đến gặp nhà cung cấp dịch vụ của bạn.';
MERGE (n:Disease {id: 'D1645'}) SET n.id = 'D1645', n.name = 'Hội chứng ruột kích thích', n.name_en = 'Irritable bowel syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/irritable-bowel-syndrome/symptoms-causes/syc-20360016 | https://medlineplus.gov/ency/article/000246.htm', n.overview = '(IBS) là một tình trạng phổ biến ảnh hưởng đến dạ dày và ruột, còn được gọi là đường tiêu hóa. Các triệu chứng bao gồm chuột rút, đau bụng, đầy hơi, đầy hơi và tiêu chảy hoặc táo bón hoặc cả hai. IBS ', n.prognosis = 'IBS có thể là tình trạng kéo dài suốt đời. Đối với một số người, các triệu chứng gây tàn tật và cản trở công việc, việc đi lại và các hoạt động xã hội. Các triệu chứng thường trở nên tốt hơn khi điều ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn liên tục thay đổi thói quen đại tiện hoặc các triệu chứng khác của IBS. Chúng có thể có nghĩa là một tình trạng nghiêm trọng hơn, chẳng hạn như ung thư ruộ';
MERGE (n:Disease {id: 'D1646'}) SET n.id = 'D1646', n.name = 'Viêm đại tràng thiếu máu cục bộ', n.name_en = 'Ischemic colitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ischemic-colitis/symptoms-causes/syc-20374001', n.overview = 'Khu vực thường bị ảnh hưởng bởi viêm đại tràng thiếu máu cục bộ Viêm đại tràng thiếu máu cục bộ xảy ra khi lưu lượng máu đến một phần của ruột già, gọi là ruột kết, bị giảm. Tình trạng này có thể ảnh ', n.when_to_see = 'Tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn bị đau đột ngột, dữ dội ở vùng bụng. Cơn đau khiến bạn khó chịu đến mức không thể ngồi yên hoặc tìm một tư thế thoải mái là trường hợp cấp cứu y tế. Liên';
MERGE (n:Disease {id: 'D1647'}) SET n.id = 'D1647', n.name = 'Isopropanol alcohol poisoning', n.name_en = 'Isopropanol alcohol poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002660.htm', n.prognosis = 'Tình trạng của một người khỏe mạnh như thế nào tùy thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận nhanh như thế nào. Ai đó nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi c';
MERGE (n:Disease {id: 'D1648'}) SET n.id = 'D1648', n.name = 'Ngứa', n.name_en = 'Itching', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003217.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị ngứa: Nghiêm trọng Không thể biến mất được giải thích dễ dàng. Đồng thời, hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng kh';
MERGE (n:Disease {id: 'D1649'}) SET n.id = 'D1649', n.name = 'Ngứa da (ngứa)', n.name_en = 'Itchy skin (pruritus)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/itchy-skin/symptoms-causes/syc-20355006', n.overview = 'Ngứa da là cảm giác khó chịu khiến bạn muốn gãi. Nó còn được gọi là ngứa (proo-RIE-tus). Ngứa da thường do da khô và thường gặp ở người lớn tuổi vì da có xu hướng trở nên khô hơn theo tuổi tác. Tùy th', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn hoặc chuyên gia về bệnh ngoài da (bác sĩ da liễu) nếu ngứa: Kéo dài hơn hai tuần và không cải thiện bằng các biện pháp tự chăm sóc Nghiêm trọng v';
MERGE (n:Disease {id: 'D1650'}) SET n.id = 'D1650', n.name = 'Ngộ độc jack-in-the-pulpit', n.name_en = 'Jack-in-the-pulpit poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002870.htm', n.prognosis = 'Nếu tiếp xúc với miệng của người đó không nghiêm trọng, các triệu chứng thường hết trong vòng vài ngày. Đối với những người tiếp xúc nhiều với cây, thời gian phục hồi lâu hơn có thể cần thiết. Trong m';
MERGE (n:Disease {id: 'D1651'}) SET n.id = 'D1651', n.name = 'Vàng da', n.name_en = 'Jaundice', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000210.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị vàng da.';
MERGE (n:Disease {id: 'D1652'}) SET n.id = 'D1652', n.name = 'Bệnh vàng da và cho con bú', n.name_en = 'Jaundice and breastfeeding', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000995.htm', n.prognosis = 'Em bé sẽ bình phục hoàn toàn nếu được theo dõi và điều trị đúng cách. Bệnh vàng da sẽ biến mất sau 12 tuần tuổi.', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu bạn đang cho con bú và da hoặc mắt của bé trở nên vàng (vàng da).';
MERGE (n:Disease {id: 'D1653'}) SET n.id = 'D1653', n.name = 'Nguyên nhân vàng da', n.name_en = 'Jaundice causes', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007491.htm', n.overview = 'Vàng da thường là dấu hiệu của vấn đề ở gan, túi mật hoặc tuyến tụy. Vàng da có thể xảy ra khi có quá nhiều bilirubin tích tụ trong cơ thể. Xét nghiệm máu sẽ cho thấy nồng độ bilirubin trong máu tăng ';
MERGE (n:Disease {id: 'D1654'}) SET n.id = 'D1654', n.name = 'Các khối u và u nang hàm', n.name_en = 'Jaw tumors and cysts', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/jaw-tumors-cysts/symptoms-causes/syc-20350973', n.overview = 'là những khối u hoặc tổn thương tương đối hiếm gặp phát triển ở xương hàm hoặc các mô mềm ở miệng và mặt. Các khối u và u nang hàm – đôi khi được gọi là do răng hoặc không do răng, tùy thuộc vào nguồn', n.when_to_see = 'Nếu bạn lo lắng rằng mình có thể có các triệu chứng của khối u hoặc u nang hàm, hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc chính hoặc nha sĩ của bạn. Nhiều khi, u nang và khối u ở hàm không có t';
MERGE (n:Disease {id: 'D1655'}) SET n.id = 'D1655', n.name = 'Vết sứa đốt', n.name_en = 'Jellyfish stings', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/jellyfish-stings/symptoms-causes/syc-20353284 | https://medlineplus.gov/ency/article/002845.htm', n.overview = 'là những vấn đề khá phổ biến đối với những người bơi lội, lội nước hoặc lặn trong đại dương. Những xúc tu dài của sứa có thể tiêm nọc độc từ hàng ngàn vết đốt có gai cực nhỏ. Thông thường, vết đốt của', n.prognosis = 'Hầu hết các vết đốt của sứa sẽ cải thiện trong vòng vài giờ, nhưng một số vết đốt có thể dẫn đến kích ứng da hoặc phát ban kéo dài hàng tuần. Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn tiếp tục ', n.when_to_see = 'Hãy tìm cách điều trị khẩn cấp nếu bạn có các triệu chứng nghiêm trọng. Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu các triệu chứng của bạn trở nên trầm trọng hơn hoặc vết thương có';
MERGE (n:Disease {id: 'D1656'}) SET n.id = 'D1656', n.name = 'Ngộ độc anh đào Jerusalem', n.name_en = 'Jerusalem cherry poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002871.htm', n.prognosis = 'Tình trạng sức khỏe của bạn phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị. Bạn nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Các triệu chứng thường thuyên giảm trong vòng';
MERGE (n:Disease {id: 'D1657'}) SET n.id = 'D1657', n.name = 'Rối loạn jet lag', n.name_en = 'Jet lag disorder', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/jet-lag/symptoms-causes/syc-20374027', n.overview = 'Jet lag, còn được gọi là rối loạn jet lag, là một vấn đề về giấc ngủ tạm thời có thể ảnh hưởng đến bất kỳ ai di chuyển nhanh qua nhiều múi giờ. Cơ thể bạn có đồng hồ bên trong riêng, được gọi là nhịp ', n.when_to_see = 'Jet lag chỉ là tạm thời. Nhưng nếu bạn đi du lịch thường xuyên và bị jet lag, bạn có thể được hưởng lợi từ việc gặp chuyên gia về giấc ngủ. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1658'}) SET n.id = 'D1658', n.name = 'Ngộ độc chất tẩy rửa trang sức', n.name_en = 'Jewelry cleaner poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002793.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Người đó nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải những chất độc như v';
MERGE (n:Disease {id: 'D1659'}) SET n.id = 'D1659', n.name = 'Ngộ độc Jimsonweed', n.name_en = 'Jimsonweed poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002881.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Bạn nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Các triệu chứng kéo dài từ 1 đến 3';
MERGE (n:Disease {id: 'D1660'}) SET n.id = 'D1660', n.name = 'Jock itch', n.name_en = 'Jock itch', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/jock-itch/symptoms-causes/syc-20353807 | https://medlineplus.gov/ency/article/000876.htm', n.overview = 'h là tình trạng phát ban ngứa, thường ở háng và mặt trong đùi. Jock ngứa là một bệnh nhiễm nấm da gây phát ban ngứa ở những vùng ấm và ẩm ướt trên cơ thể. Phát ban thường ảnh hưởng đến háng và đùi tro', n.prognosis = 'Jock ngứa thường đáp ứng nhanh chóng với việc điều trị. Tình trạng này thường ít nghiêm trọng hơn các bệnh nhiễm nấm da khác, chẳng hạn như bệnh nấm bàn chân của vận động viên, nhưng có thể kéo dài.', n.when_to_see = 'Hãy đến gặp bác sĩ nếu phát ban gây đau hoặc bạn bị sốt. Và hãy tìm kiếm sự chăm sóc y tế nếu phát ban không cải thiện sau một tuần tự chăm sóc bằng loại sản phẩm chống nấm mà bạn có thể mua mà không ';
MERGE (n:Disease {id: 'D1661'}) SET n.id = 'D1661', n.name = 'Đau khớp', n.name_en = 'Joint pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003261.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị sốt không liên quan đến các triệu chứng cúm. Bạn đã giảm được 10 pound (4,5 kg) trở lên mà không cần cố gắng (giảm cân ngoài ý muốn). Cơn đau khớp ';
MERGE (n:Disease {id: 'D1662'}) SET n.id = 'D1662', n.name = 'Sưng khớp', n.name_en = 'Joint swelling', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003262.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn ngay lập tức nếu bạn bị đau khớp và sưng tấy kèm theo sốt. Đồng thời liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị: Sưng khớp không rõ nguyên nhân Sư';
MERGE (n:Disease {id: 'D1663'}) SET n.id = 'D1663', n.name = 'Juvenile angiofibroma', n.name_en = 'Juvenile angiofibroma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001572.htm', n.prognosis = 'Mặc dù không phải là ung thư nhưng u xơ mạch có thể tiếp tục phát triển và làm tổn thương các mô lân cận hoặc chảy máu. Một số có thể tự biến mất. Việc khối u quay trở lại sau phẫu thuật là điều bình ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn thường xuyên bị: Chảy máu cam Nghẹt mũi một bên';
MERGE (n:Disease {id: 'D1664'}) SET n.id = 'D1664', n.name = 'Viêm khớp tự phát thiếu niên', n.name_en = 'Juvenile idiopathic arthritis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/juvenile-idiopathic-arthritis/symptoms-causes/syc-20374082 | https://medlineplus.gov/ency/article/000451.htm', n.overview = ', trước đây gọi là viêm khớp dạng thấp thiếu niên, là loại viêm khớp phổ biến nhất ở trẻ em dưới 16 tuổi. Viêm khớp tự phát thiếu niên có thể gây đau, sưng và cứng khớp dai dẳng. Một số trẻ có thể gặp', n.prognosis = 'Trẻ em chỉ bị ảnh hưởng một vài khớp có thể không có triệu chứng trong một thời gian dài. Ở nhiều trẻ, bệnh sẽ trở nên không hoạt động và gây ra rất ít tổn thương ở khớp. Mức độ nghiêm trọng của bệnh ', n.when_to_see = 'Hãy đưa con bạn đến bác sĩ nếu trẻ bị đau khớp, sưng hoặc cứng khớp trong hơn một tuần - đặc biệt nếu trẻ bị sốt. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1665'}) SET n.id = 'D1665', n.name = 'Sarcoma Kaposi', n.name_en = 'Kaposi sarcoma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/kaposis-sarcoma/symptoms-causes/syc-20577303 | https://medlineplus.gov/ency/article/000661.htm', n.overview = 'là một loại ung thư hình thành ở niêm mạc mạch máu và mạch bạch huyết. Ung thư hình thành sự phát triển của các tế bào, được gọi là tổn thương, trên da. Các tổn thương thường hình thành ở mặt, tay và ', n.prognosis = 'Điều trị KS không cải thiện cơ hội sống sót khỏi HIV/AIDS. Triển vọng phụ thuộc vào tình trạng miễn dịch của người đó và lượng virus HIV có trong máu của họ (tải lượng virus). Nếu HIV được kiểm soát b', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có các triệu chứng khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1666'}) SET n.id = 'D1666', n.name = 'Bệnh Kawasaki', n.name_en = 'Kawasaki disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/kawasaki-disease/symptoms-causes/syc-20354598 | https://medlineplus.gov/ency/article/000989.htm', n.overview = 'gây sưng tấy, gọi là viêm, ở thành các mạch máu cỡ nhỏ đến trung bình đưa máu đi khắp cơ thể. Bệnh Kawasaki thường ảnh hưởng nhất đến động mạch tim ở trẻ em. Những động mạch này cung cấp máu giàu oxy ', n.prognosis = 'Hầu hết trẻ em đều có thể hồi phục hoàn toàn khi bệnh được phát hiện và điều trị sớm. Khoảng 1 trong 100 trẻ em chết vì các vấn đề về tim do căn bệnh này gây ra. Những người mắc bệnh Kawasaki nên siêu', n.when_to_see = 'Nếu con bạn bị sốt kéo dài hơn ba ngày, hãy liên hệ với chuyên gia chăm sóc sức khỏe của con bạn. Điều trị bệnh Kawasaki trong vòng 10 ngày kể từ khi bệnh bắt đầu có thể làm giảm nguy cơ tổn thương lâ';
MERGE (n:Disease {id: 'D1667'}) SET n.id = 'D1667', n.name = 'Sẹo lồi', n.name_en = 'Keloid scar', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/keloid-scar/symptoms-causes/syc-20520901', n.overview = 'Sẹo lồi là sẹo lồi dày. Nó có thể xảy ra ở bất cứ nơi nào bạn bị thương trên da nhưng thường hình thành ở dái tai, vai, má hoặc ngực. Nếu bạn có xu hướng phát triển sẹo lồi, bạn có thể gặp chúng ở nhi', n.when_to_see = 'Điều trị sớm có thể giúp giảm thiểu sự phát triển của sẹo lồi. Nói chuyện với bác sĩ ngay sau khi bạn nhận thấy sẹo lồi. Nếu bạn muốn điều trị bệnh đã lâu, hãy nói chuyện với bác sĩ chuyên về tình trạ';
MERGE (n:Disease {id: 'D1668'}) SET n.id = 'D1668', n.name = 'Viêm giác mạc', n.name_en = 'Keratitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/keratitis/symptoms-causes/syc-20374110', n.overview = 'là tình trạng viêm giác mạc - mô hình vòm trong suốt ở phía trước mắt bao phủ đồng tử và mống mắt. Viêm giác mạc có thể có hoặc không liên quan đến nhiễm trùng. Viêm giác mạc không nhiễm trùng có thể ', n.when_to_see = 'Nếu bạn nhận thấy bất kỳ triệu chứng nào của viêm giác mạc, hãy hẹn gặp bác sĩ chuyên khoa mắt ngay lập tức. Sự chậm trễ trong chẩn đoán và điều trị viêm giác mạc có thể dẫn đến các biến chứng nghiêm ';
MERGE (n:Disease {id: 'D1669'}) SET n.id = 'D1669', n.name = 'Keratoconus', n.name_en = 'Keratoconus', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/keratoconus/symptoms-causes/syc-20351352 | https://medlineplus.gov/ency/article/001013.htm', n.overview = 'hướng ra ngoài thành hình nón. Điều này có thể gây ra tầm nhìn mờ, méo mó. Keratoconus (ker-uh-toe-KOH-nus) là một tình trạng về mắt trong đó mặt trước hình vòm trong suốt của mắt, được gọi là giác mạ', n.prognosis = 'Trong hầu hết các trường hợp, thị lực có thể được điều chỉnh bằng kính áp tròng cứng thấm khí. Nếu cần ghép giác mạc, kết quả thường rất tốt. Tuy nhiên, thời gian phục hồi có thể kéo dài. Nhiều người ', n.when_to_see = 'Hãy gặp bác sĩ nhãn khoa nếu thị lực của bạn xấu đi nhanh chóng. Điều này có thể được gây ra bởi độ cong không đều của mắt, được gọi là loạn thị. Bác sĩ nhãn khoa của bạn cũng có thể tìm kiếm các dấu ';
MERGE (n:Disease {id: 'D1670'}) SET n.id = 'D1670', n.name = 'Keratosis obturans', n.name_en = 'Keratosis obturans', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001617.htm', n.prognosis = 'Việc theo dõi và vệ sinh thường xuyên của nhà cung cấp là rất quan trọng để tránh nhiễm trùng. Ở một số người, có thể cần phải vệ sinh suốt đời.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn cảm thấy đau tai hoặc khó nghe.';
MERGE (n:Disease {id: 'D1671'}) SET n.id = 'D1671', n.name = 'Keratosis pilaris', n.name_en = 'Keratosis pilaris', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/keratosis-pilaris/symptoms-causes/syc-20351149 | https://medlineplus.gov/ency/article/001462.htm', n.overview = 'ar ở cánh tay, chân hoặc mông. Chúng thường không đau hoặc ngứa. Keratosis pilaris (ker-uh-TOE-sis pih-LAIR-is) là một tình trạng da vô hại, gây ra các mảng khô, thô ráp và các vết sưng nhỏ, thường ở ', n.prognosis = 'Keratosis pilaris có thể mờ dần theo tuổi tác.', n.when_to_see = 'Điều trị chứng dày sừng nang lông thường không cần thiết. Nhưng nếu bạn lo lắng về làn da của mình hoặc con bạn, hãy tham khảo ý kiến ​​của nhà cung cấp dịch vụ chăm sóc sức khỏe hoặc bác sĩ chuyên kh';
MERGE (n:Disease {id: 'D1672'}) SET n.id = 'D1672', n.name = 'Ngộ độc dầu hỏa', n.name_en = 'Kerosene poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002807.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải loại chất độc này c';
MERGE (n:Disease {id: 'D1673'}) SET n.id = 'D1673', n.name = 'Quá liều ketoprofen', n.name_en = 'Ketoprofen overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002661.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng ketoprofen đã nuốt và tốc độ điều trị được tiếp nhận. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Quá liều ketoprofen nhẹ thường không gây ra v';
MERGE (n:Disease {id: 'D1674'}) SET n.id = 'D1674', n.name = 'Ung thư thận', n.name_en = 'Kidney cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/kidney-cancer/symptoms-causes/syc-20352664', n.overview = 'Ung thư thận là gì? Chuyên gia giải thích Tìm hiểu thêm từ bác sĩ chuyên khoa ung thư tiết niệu Bradley Leibovich, M.D. Hiển thị bản ghi video Ung thư thận là gì? Một chuyên gia giải thích tôi là bác ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
';
MERGE (n:Disease {id: 'D1675'}) SET n.id = 'D1675', n.name = 'U nang thận', n.name_en = 'Kidney cysts', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/kidney-cysts/symptoms-causes/syc-20374134', n.overview = 'U nang thận có đường viền rõ ràng. U nang thận thường phát triển trên bề mặt của thận. Một số có thể phát triển bên trong thận. U nang thận là những túi dịch tròn hình thành trên hoặc trong thận. Thôn', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có các triệu chứng của u nang thận.';
MERGE (n:Disease {id: 'D1676'}) SET n.id = 'D1676', n.name = 'Nhiễm trùng thận', n.name_en = 'Kidney infection', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/kidney-infection/symptoms-causes/syc-20353387', n.overview = 'Hệ tiết niệu nữ giới mắt, niệu quản, bàng quang và niệu đạo. Hệ thống tiết niệu loại bỏ chất thải ra khỏi cơ thể qua nước tiểu. Thận nằm về phía sau của bụng trên. Chúng lọc chất thải và chất lỏng từ ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn ngay nếu bạn có các triệu chứng nhiễm trùng thận. Và nếu bạn đang điều trị UTI trong hơn 2 đến 3 ngày nhưng bạn vẫn gặp các triệu chứng, hãy cho chuyên';
MERGE (n:Disease {id: 'D1677'}) SET n.id = 'D1677', n.name = 'Cắt bỏ thận', n.name_en = 'Kidney removal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003001.htm', n.overview = 'Phẫu thuật này được thực hiện tại bệnh viện khi bạn đang ngủ và không gây đau đớn (gây mê toàn thân). Thủ tục có thể mất 3 giờ hoặc hơn. Cắt thận đơn giản hoặc cắt thận hở: Bạn sẽ nằm nghiêng. Bác sĩ ', n.prognosis = 'Kết quả thường tốt nhất khi cắt bỏ một quả thận. Nếu cả hai quả thận đều bị cắt bỏ hoặc quả thận còn lại không hoạt động đủ tốt, bạn sẽ cần phải chạy thận nhân tạo hoặc ghép thận.';
MERGE (n:Disease {id: 'D1678'}) SET n.id = 'D1678', n.name = 'Sỏi thận', n.name_en = 'Kidney stones', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/kidney-stones/symptoms-causes/syc-20355755 | https://medlineplus.gov/ency/article/000458.htm', n.overview = 'Hệ tiết niệu nữ giới mắt, niệu quản, bàng quang và niệu đạo. Hệ thống tiết niệu loại bỏ chất thải ra khỏi cơ thể qua nước tiểu. Thận nằm về phía sau của bụng trên. Chúng lọc chất thải và chất lỏng từ ', n.prognosis = 'Sỏi thận gây đau đớn nhưng hầu hết có thể được loại bỏ khỏi cơ thể mà không gây ra tổn thương lâu dài. Sỏi thận thường quay trở lại. Điều này xảy ra thường xuyên hơn nếu nguyên nhân không được tìm thấ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Hãy đi khám sức khỏe ngay nếu bạn bị: Đau đến mức không thể ngồi yên hoặc tìm một tư thế thoải mái';
MERGE (n:Disease {id: 'D1679'}) SET n.id = 'D1679', n.name = 'Ghép thận', n.name_en = 'Kidney transplant', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003005.htm', n.overview = 'là một trong những ca phẫu thuật cấy ghép phổ biến nhất ở Hoa Kỳ. Cần có một quả thận được hiến tặng để thay thế công việc mà thận của bạn đã thực hiện trước đây. Thận hiến tặng có thể là từ một: Ngườ', n.prognosis = 'Hầu hết mọi người đều cảm thấy rằng họ có chất lượng cuộc sống tốt hơn sau khi cấy ghép. Những người nhận thận từ người hiến tặng còn sống có kết quả tốt hơn những người nhận thận từ người hiến tặng đ';
MERGE (n:Disease {id: 'D1680'}) SET n.id = 'D1680', n.name = 'Kleptomania', n.name_en = 'Kleptomania', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/kleptomania/symptoms-causes/syc-20364732', n.overview = '(klep-toe-MAY-nee-uh) là một chứng rối loạn sức khỏe tâm thần liên quan đến việc liên tục không thể cưỡng lại sự thôi thúc ăn trộm những món đồ mà bạn thường không thực sự cần. Thông thường những món ', n.when_to_see = 'Nếu bạn không thể ngừng trộm cắp hoặc trộm cắp trong cửa hàng, hãy tìm tư vấn y tế. Nhiều người mắc chứng trộm cắp không muốn tìm cách điều trị vì họ sợ bị bắt hoặc bỏ tù. Tuy nhiên, nhà cung cấp dịch';
MERGE (n:Disease {id: 'D1681'}) SET n.id = 'D1681', n.name = 'Hội chứng Klinefelter', n.name_en = 'Klinefelter syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/klinefelter-syndrome/symptoms-causes/syc-20353949 | https://medlineplus.gov/ency/article/000382.htm', n.overview = 'là một tình trạng phổ biến xảy ra khi một người được xác định là nam khi sinh ra có thêm một bản sao của nhiễm sắc thể giới tính X thay vì XY điển hình. Hội chứng Klinefelter là một tình trạng di truy', n.when_to_see = 'Nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu bạn nhận thấy: Phát triển chậm trong thời thơ ấu hoặc thời thơ ấu. Sự chậm tăng trưởng và phát triển có thể là dấu hiệu đầu tiên của một số tình';
MERGE (n:Disease {id: 'D1682'}) SET n.id = 'D1682', n.name = 'Hội chứng Klippel-Trenaunay', n.name_en = 'Klippel-Trenaunay syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/klippel-trenaunay/symptoms-causes/syc-20374152 | https://medlineplus.gov/ency/article/000150.htm', n.overview = 'Hội chứng Klippel-Trenaunay (klih-PEL khay-no-NAY) ― còn được gọi là KTS ― là một chứng rối loạn hiếm gặp được phát hiện khi sinh (bẩm sinh) liên quan đến các vấn đề trong quá trình phát triển của một', n.prognosis = 'Hầu hết những người bị KTS đều làm tốt, mặc dù tình trạng bệnh có thể ảnh hưởng đến ngoại hình của họ.', n.when_to_see = 'KTS thường được xác định ngay từ khi sinh ra. Điều quan trọng là phải chẩn đoán nhanh chóng, chính xác và chăm sóc thích hợp để điều trị các triệu chứng và ngăn ngừa các biến chứng. Yêu cầu một cuộc h';
MERGE (n:Disease {id: 'D1683'}) SET n.id = 'D1683', n.name = 'Nội soi khớp gối', n.name_en = 'Knee arthroscopy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002972.htm', n.overview = 'Ba loại giảm đau (gây mê) khác nhau có thể được sử dụng trong phẫu thuật nội soi khớp gối: Gây tê tại chỗ. Đầu gối của bạn có thể bị tê do dùng thuốc giảm đau. Bạn cũng có thể được cho thuốc giúp bạn ', n.prognosis = 'Quá trình hồi phục hoàn toàn sau nội soi khớp gối sẽ phụ thuộc vào loại vấn đề được điều trị. Các vấn đề như rách sụn chêm, gãy sụn, u nang Baker và các vấn đề về màng hoạt dịch thường có thể dễ dàng ';
MERGE (n:Disease {id: 'D1684'}) SET n.id = 'D1684', n.name = 'Viêm bao hoạt dịch đầu gối', n.name_en = 'Knee bursitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/knee-bursitis/symptoms-causes/syc-20355501', n.overview = 'Bao hoạt dịch đầu gối làm giảm ma sát giữa các bộ phận chuyển động trong khớp của cơ thể. Viêm bao hoạt dịch đầu gối là tình trạng sưng tấy, còn gọi là viêm, của một hoặc nhiều bao hoạt dịch ở đầu gối', n.when_to_see = 'Đôi khi, bao hoạt dịch nằm trên xương bánh chè có thể bị nhiễm trùng. Gọi cho chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị: Sốt hoặc ớn lạnh cùng với đau và sưng ở đầu gối. Sưng tấy kéo dài hoặc th';
MERGE (n:Disease {id: 'D1685'}) SET n.id = 'D1685', n.name = 'Thay khớp gối', n.name_en = 'Knee joint replacement', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002974.htm', n.overview = 'Sụn và xương bị tổn thương sẽ được loại bỏ khỏi khớp gối. Các mảnh nhân tạo sau đó được đặt vào đầu gối. Những mảnh này có thể được đặt ở những vị trí sau trong khớp gối: Đầu dưới của xương đùi -- Xươ', n.prognosis = 'Kết quả của việc thay khớp gối toàn phần thường rất xuất sắc. Hoạt động này làm giảm đau cho hầu hết mọi người. Hầu hết mọi người không cần trợ giúp khi đi lại sau khi hồi phục hoàn toàn. Hơn 90% khớp';
MERGE (n:Disease {id: 'D1686'}) SET n.id = 'D1686', n.name = 'Phẫu thuật gãy xương vi thể đầu gối', n.name_en = 'Knee microfracture surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007255.htm', n.overview = 'Bạn sẽ không cảm thấy đau đớn trong quá trình phẫu thuật. Ba loại gây mê có thể được sử dụng cho phẫu thuật nội soi khớp gối: Gây tê cục bộ - Bạn sẽ được tiêm thuốc giảm đau để làm tê đầu gối. Bạn cũn', n.prognosis = 'Nhiều người đã hồi phục tốt sau cuộc phẫu thuật này. Thời gian phục hồi có thể chậm. Nhiều người có thể quay lại chơi thể thao hoặc các hoạt động cường độ cao khác sau khoảng 9 đến 12 tháng. Các vận đ';
MERGE (n:Disease {id: 'D1687'}) SET n.id = 'D1687', n.name = 'Đau đầu gối', n.name_en = 'Knee pain', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/knee-pain/symptoms-causes/syc-20350849 | https://medlineplus.gov/ency/article/003187.htm', n.overview = 'là một triệu chứng phổ biến ảnh hưởng đến mọi người ở mọi lứa tuổi. Đau đầu gối có thể là kết quả của một chấn thương, chẳng hạn như đứt dây chằng hoặc rách sụn. Các tình trạng bệnh lý – bao gồm viêm ', n.when_to_see = 'Hãy gọi cho bác sĩ nếu bạn: Không thể chịu được trọng lượng trên đầu gối hoặc cảm thấy như thể đầu gối của bạn không ổn định hoặc bị lỏng lẻo Bị sưng đầu gối rõ rệt Không thể duỗi hoặc uốn cong hoàn t';
MERGE (n:Disease {id: 'D1688'}) SET n.id = 'D1688', n.name = 'Trật khớp xương bánh chè', n.name_en = 'Kneecap dislocation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001070.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị thương ở đầu gối và có các triệu chứng trật khớp. Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn đang điều trị trật khớp đầu gối và bạn nhận t';
MERGE (n:Disease {id: 'D1689'}) SET n.id = 'D1689', n.name = 'Gập đầu gối', n.name_en = 'Knock knees', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001263.htm', n.prognosis = 'Trẻ em thường phát triển hết tình trạng đầu gối gập ghềnh mà không cần điều trị, trừ khi nguyên nhân là do một căn bệnh nào đó. Nếu cần phẫu thuật, kết quả thường tốt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn cho rằng con mình bị tật đầu gối.';
MERGE (n:Disease {id: 'D1690'}) SET n.id = 'D1690', n.name = 'Bệnh Krabbe', n.name_en = 'Krabbe disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001198.htm', n.prognosis = 'Kết quả có thể sẽ kém. Trung bình, trẻ sơ sinh mắc bệnh Krabbe khởi phát sớm sẽ chết trước 2 tuổi. Những người mắc bệnh ở độ tuổi muộn hơn vẫn sống sót đến tuổi trưởng thành với bệnh về hệ thần kinh.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn phát triển các triệu chứng của chứng rối loạn này. Hãy đến phòng cấp cứu của bệnh viện hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu xảy ra c';
MERGE (n:Disease {id: 'D1691'}) SET n.id = 'D1691', n.name = 'Kuru', n.name_en = 'Kuru', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001379.htm', n.prognosis = 'Tử vong thường xảy ra trong vòng 1 năm sau khi có dấu hiệu đầu tiên của triệu chứng.', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ vấn đề nào về đi lại, nuốt hoặc phối hợp. Kuru cực kỳ hiếm. Nhà cung cấp của bạn sẽ kiểm tra các bệnh về hệ thần kinh khác.';
MERGE (n:Disease {id: 'D1692'}) SET n.id = 'D1692', n.name = 'Kwashiorkor', n.name_en = 'Kwashiorkor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001604.htm', n.prognosis = 'Việc điều trị sớm thường mang lại kết quả tốt. Điều trị kwashiorkor ở giai đoạn cuối sẽ cải thiện sức khỏe tổng quát của trẻ. Tuy nhiên, đứa trẻ có thể phải chịu đựng những vấn đề vĩnh viễn về thể chấ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có các triệu chứng của kwashiorkor.';
MERGE (n:Disease {id: 'D1693'}) SET n.id = 'D1693', n.name = 'Kyphoplasty', n.name_en = 'Kyphoplasty', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007511.htm', n.overview = 'được thực hiện tại bệnh viện hoặc phòng khám ngoại trú. Bạn có thể được gây tê cục bộ (tỉnh táo và không thể cảm thấy đau). Bạn cũng có thể sẽ nhận được thuốc để giúp bạn thư giãn và cảm thấy buồn ngủ', n.prognosis = 'Những người phẫu thuật tạo hình vùng gù thường ít đau hơn và chất lượng cuộc sống tốt hơn sau phẫu thuật. Họ thường cần ít thuốc giảm đau hơn và có thể di chuyển tốt hơn trước.';
MERGE (n:Disease {id: 'D1694'}) SET n.id = 'D1694', n.name = 'Kyphosis', n.name_en = 'Kyphosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/kyphosis/symptoms-causes/syc-20374205 | https://medlineplus.gov/ency/article/001240.htm', n.overview = 'là. Gù cột sống là hiện tượng lưng trên cong về phía trước quá mức. Ở người lớn tuổi, chứng gù lưng thường do xương cột sống bị yếu khiến chúng bị nén hoặc nứt. Các loại bệnh kyphosis khác có thể xuất', n.prognosis = 'Thanh thiếu niên mắc bệnh Scheuermann có xu hướng hồi phục tốt, ngay cả khi họ cần phẫu thuật. Bệnh dừng lại khi chúng ngừng phát triển. Nếu chứng gù là do bệnh thoái hóa khớp hoặc gãy xương do nén nh', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn nhận thấy đường cong tăng lên ở lưng trên hoặc ở cột sống của con bạn. Yêu cầu hẹn';
MERGE (n:Disease {id: 'D1695'}) SET n.id = 'D1695', n.name = 'Viêm mê đạo', n.name_en = 'Labyrinthitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001054.htm', n.prognosis = 'Cần có thời gian để các triệu chứng viêm mê cung biến mất hoàn toàn. Các triệu chứng nghiêm trọng thường biến mất trong vòng một tuần. Hầu hết mọi người hoàn toàn khỏe hơn trong vòng 2 đến 3 tháng. Ng', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị chóng mặt, chóng mặt, mất thăng bằng hoặc các triệu chứng khác của viêm mê đạo Bạn bị mất thính giác Gọi 911 hoặc số cấp cứu tại địa phương nếu';
MERGE (n:Disease {id: 'D1696'}) SET n.id = 'D1696', n.name = 'Ngộ độc sơn mài', n.name_en = 'Lacquer poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002794.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận nhanh như thế nào. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải n';
MERGE (n:Disease {id: 'D1697'}) SET n.id = 'D1697', n.name = 'Khối u tuyến lệ', n.name_en = 'Lacrimal gland tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001611.htm', n.prognosis = 'Triển vọng thường rất tốt đối với sự phát triển không gây ung thư. Triển vọng của bệnh ung thư phụ thuộc vào loại ung thư và giai đoạn phát hiện bệnh.';
MERGE (n:Disease {id: 'D1698'}) SET n.id = 'D1698', n.name = 'Nhiễm axit lactic', n.name_en = 'Lactic acidosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000391.htm';
MERGE (n:Disease {id: 'D1699'}) SET n.id = 'D1699', n.name = 'Không dung nạp Lactose', n.name_en = 'Lactose intolerance', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/lactose-intolerance/symptoms-causes/syc-20374232 | https://medlineplus.gov/ency/article/000276.htm', n.overview = 'là tình trạng khiến bạn khó tiêu hóa đường trong sữa và các sản phẩm từ sữa, được gọi là lactose. Những người không dung nạp lactose thường bị tiêu chảy, đầy hơi và chướng bụng sau khi ăn hoặc uống th', n.prognosis = 'Các triệu chứng thường biến mất khi bạn loại bỏ sữa, các sản phẩm từ sữa khác và các nguồn cung cấp đường lactose khác khỏi chế độ ăn uống của mình. Nếu không thay đổi chế độ ăn uống, trẻ sơ sinh hoặc', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Bạn có con nhỏ dưới 2 hoặc 3 tuổi có triệu chứng không dung nạp lactose. Con bạn phát triển chậm hoặc không tăng cân. Bạn hoặc con bạn có triệu chứng không dung n';
MERGE (n:Disease {id: 'D1700'}) SET n.id = 'D1700', n.name = 'Hội chứng nhược cơ Lambert-Eaton', n.name_en = 'Lambert-Eaton myasthenic syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000710.htm', n.prognosis = 'Các triệu chứng của LEMS có thể cải thiện bằng cách điều trị căn bệnh tiềm ẩn, ức chế hệ thống miễn dịch hoặc loại bỏ các kháng thể. Tuy nhiên, LEMS cận ung thư có thể không đáp ứng tốt với điều trị. ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu các triệu chứng của LEMS phát triển.';
MERGE (n:Disease {id: 'D1701'}) SET n.id = 'D1701', n.name = 'Lamellar ichthyosis', n.name_en = 'Lamellar ichthyosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000843.htm';
MERGE (n:Disease {id: 'D1702'}) SET n.id = 'D1702', n.name = 'Phẫu thuật cắt bỏ bản sống', n.name_en = 'Laminectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007389.htm', n.overview = 'mở ống sống của bạn để các dây thần kinh cột sống của bạn có nhiều chỗ hơn. Nó có thể được thực hiện cùng với phẫu thuật cắt bỏ đĩa đệm , phẫu thuật cắt bỏ lỗ thông , hoặc phẫu thuật ghép đốt sống . B', n.prognosis = 'Phẫu thuật cắt bỏ ống sống để điều trị chứng hẹp ống sống thường giúp giảm bớt hoàn toàn hoặc một phần các triệu chứng. Các vấn đề về cột sống trong tương lai có thể xảy ra với tất cả mọi người sau ph';
MERGE (n:Disease {id: 'D1703'}) SET n.id = 'D1703', n.name = 'Rối loạn ngôn ngữ ở trẻ em', n.name_en = 'Language disorders in children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001545.htm', n.prognosis = 'Kết quả khác nhau, tùy thuộc vào nguyên nhân. Trẻ bị chấn thương não hoặc các vấn đề về cấu trúc khác có thể gặp vấn đề lâu dài về ngôn ngữ. Các nguyên nhân khác, dễ hồi phục hơn có thể được điều trị ', n.when_to_see = 'Nếu bạn lo ngại rằng khả năng nói hoặc ngôn ngữ của con bạn bị chậm, hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn. Hỏi về việc được giới thiệu đến một nhà trị liệu ngôn ngữ và ngôn ngữ. ';
MERGE (n:Disease {id: 'D1704'}) SET n.id = 'D1704', n.name = 'Ngộ độc lanolin', n.name_en = 'Lanolin poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002663.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng lanolin đã nuốt và tốc độ điều trị được tiếp nhận. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Lanolin cấp y tế không độc lắm. Lanolin loại khô';
MERGE (n:Disease {id: 'D1705'}) SET n.id = 'D1705', n.name = 'Cắt túi mật nội soi', n.name_en = 'Laparoscopic gallbladder removal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007371.htm', n.overview = 'Phẫu thuật sử dụng nội soi là cách phổ biến nhất để cắt bỏ túi mật. Nội soi là một ống mỏng, có ánh sáng cho phép bác sĩ phẫu thuật nhìn thấy bên trong bụng của bạn. Phẫu thuật cắt bỏ túi mật được thự', n.prognosis = 'Hầu hết mọi người đều hồi phục nhanh chóng và có kết quả tốt từ quy trình này. Có thể mất đến một tuần để bạn lấy lại năng lượng bình thường.';
MERGE (n:Disease {id: 'D1706'}) SET n.id = 'D1706', n.name = 'Thắt dạ dày nội soi', n.name_en = 'Laparoscopic gastric banding', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007388.htm', n.overview = 'Bạn sẽ được gây mê toàn thân trước khi phẫu thuật này. Bạn sẽ ngủ và không thể cảm thấy đau. Phẫu thuật được thực hiện bằng cách sử dụng một chiếc máy ảnh nhỏ được đặt trong bụng của bạn. Loại phẫu th', n.prognosis = 'Quá trình giảm cân cuối cùng bằng phương pháp thắt dạ dày không lớn như các phương pháp phẫu thuật giảm cân khác. Mức giảm cân trung bình là khoảng một phần ba đến một nửa số cân nặng tăng thêm mà bạn';
MERGE (n:Disease {id: 'D1707'}) SET n.id = 'D1707', n.name = 'Cắt bỏ ruột lớn', n.name_en = 'Large bowel resection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002941.htm', n.overview = 'Bạn sẽ được gây mê toàn thân tại thời điểm phẫu thuật. Điều này sẽ giúp bạn ngủ ngon và không bị đau. Phẫu thuật có thể được thực hiện bằng nội soi, phẫu thuật mở hoặc bằng robot. Tùy thuộc vào loại p', n.prognosis = 'Hầu hết những người bị cắt bỏ ruột lớn đều hồi phục hoàn toàn. Ngay cả khi được phẫu thuật cắt bỏ ruột kết, hầu hết mọi người đều có thể thực hiện các hoạt động mà họ đã làm trước khi phẫu thuật. Điều';
MERGE (n:Disease {id: 'D1708'}) SET n.id = 'D1708', n.name = 'Lớn so với tuổi thai (LGA)', n.name_en = 'Large for gestational age (LGA)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002248.htm', n.overview = 'dùng để chỉ thai nhi hoặc trẻ sơ sinh lớn hơn dự kiến ​​​​so với độ tuổi và giới tính của chúng. Nó cũng có thể bao gồm trẻ sơ sinh có cân nặng khi sinh trên phân vị thứ 90. Phép đo LGA dựa trên tuổi ';
MERGE (n:Disease {id: 'D1709'}) SET n.id = 'D1709', n.name = 'Tổn thương dây thần kinh thanh quản', n.name_en = 'Laryngeal nerve damage', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001643.htm', n.prognosis = 'Triển vọng phụ thuộc vào nguyên nhân chấn thương. Trong một số trường hợp, dây thần kinh nhanh chóng trở lại bình thường. Tuy nhiên, đôi khi thiệt hại là vĩnh viễn.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn gặp: Khó thở (gọi ngay) Khàn giọng không rõ nguyên nhân kéo dài hơn 3 tuần';
MERGE (n:Disease {id: 'D1710'}) SET n.id = 'D1710', n.name = 'Phẫu thuật cắt thanh quản', n.name_en = 'Laryngectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007398.htm', n.overview = 'là phẫu thuật lớn được thực hiện tại bệnh viện. Trước khi phẫu thuật bạn sẽ được gây mê toàn thân. Bạn sẽ ngủ và không bị đau. Cắt thanh quản toàn phần sẽ loại bỏ toàn bộ thanh quản. Một phần họng của', n.prognosis = 'Vết thương của bạn sẽ mất khoảng 2 đến 3 tuần để lành. Bạn có thể mong đợi sự phục hồi hoàn toàn trong khoảng một tháng. Nhiều khi, việc cắt bỏ thanh quản sẽ loại bỏ toàn bộ khối u hoặc chất bị thương';
MERGE (n:Disease {id: 'D1711'}) SET n.id = 'D1711', n.name = 'Viêm thanh quản', n.name_en = 'Laryngitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/laryngitis/symptoms-causes/syc-20374262 | https://medlineplus.gov/ency/article/001385.htm', n.overview = 'là một loại sưng tấy gọi là viêm ảnh hưởng đến thanh quản. Tên y tế của hộp thoại là thanh quản. Thanh quản có thể bị viêm do sử dụng quá mức, bị kích thích hoặc nhiễm trùng. Bên trong thanh quản là d', n.prognosis = 'Viêm thanh quản không do tình trạng nghiêm trọng gây ra thường tự khỏi.', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu giọng nói của bạn bị khàn trong 2 đến 4 tuần. Ngoài ra, hãy đặt lịch hẹn nếu giọng nói của bạn có những thay đổi nghiêm trọng kéo dài hơn một vài n';
MERGE (n:Disease {id: 'D1712'}) SET n.id = 'D1712', n.name = 'Quang đông bằng laser - mắt', n.name_en = 'Laser photocoagulation - eye', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007664.htm', n.overview = 'Bác sĩ nhãn khoa của bạn sẽ thực hiện phẫu thuật này tại cơ sở ngoại trú hoặc văn phòng. Quá trình quang đông diễn ra bằng cách sử dụng tia laser để tạo ra vết bỏng cực nhỏ trong mô đích. Các đốm lase', n.prognosis = 'Phẫu thuật laser hoạt động tốt nhất trong giai đoạn đầu của tình trạng mất thị lực. Nó không thể mang lại thị lực đã mất. Tuy nhiên, nó có thể làm giảm đáng kể nguy cơ mất thị lực vĩnh viễn. Quản lý b';
MERGE (n:Disease {id: 'D1713'}) SET n.id = 'D1713', n.name = 'Phẫu thuật laser cho da', n.name_en = 'Laser surgery for the skin', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002958.htm', n.overview = 'Laser là một chùm ánh sáng có thể tập trung vào một vùng rất nhỏ. Tia laser làm nóng các tế bào cụ thể trong khu vực đang được điều trị cho đến khi chúng vỡ ra. Có một số loại laser. Mỗi tia laser có ', n.prognosis = 'Thời gian hồi phục tùy thuộc vào loại điều trị và sức khỏe tổng thể của bạn. Hãy hỏi nhà cung cấp dịch vụ của bạn trước khi điều trị xem bạn sẽ cần bao nhiêu thời gian phục hồi. Đồng thời hỏi xem bạn ';
MERGE (n:Disease {id: 'D1714'}) SET n.id = 'D1714', n.name = 'Liệu pháp laser', n.name_en = 'Laser therapy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001913.htm', n.overview = 'Laser có thể được sử dụng cho nhiều mục đích y tế. Bởi vì chùm tia laser rất nhỏ và chính xác nên nó cho phép các nhà cung cấp dịch vụ chăm sóc sức khỏe điều trị mô một cách an toàn mà không làm tổn t';
MERGE (n:Disease {id: 'D1715'}) SET n.id = 'D1715', n.name = 'Phẫu thuật mắt LASIK', n.name_en = 'LASIK eye surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007018.htm', n.overview = 'Để nhìn rõ, giác mạc và thủy tinh thể của mắt phải bẻ cong (khúc xạ) tia sáng đúng cách. Điều này cho phép hình ảnh được tập trung vào võng mạc. Nếu không, hình ảnh sẽ bị mờ. Sự mờ nhạt này được gọi l', n.prognosis = 'Hầu hết thị lực của mọi người sẽ ổn định sau vài ngày sau phẫu thuật, nhưng đối với một số người, có thể mất tới 3 đến 6 tháng. Một số ít người có thể cần phải phẫu thuật lại vì thị lực bị điều chỉnh ';
MERGE (n:Disease {id: 'D1716'}) SET n.id = 'D1716', n.name = 'Lực kéo bên', n.name_en = 'Lateral traction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002243.htm', n.overview = 'Lực kéo có thể được sử dụng để điều trị hoặc giảm bất kỳ tình trạng trật khớp hoặc gãy xương nào bằng cách tạo lực căng lên chân hoặc cánh tay bằng tạ và ròng rọc để căn chỉnh lại xương. Ví dụ, nó có ';
MERGE (n:Disease {id: 'D1717'}) SET n.id = 'D1717', n.name = 'Dị ứng mủ cao su', n.name_en = 'Latex allergy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/latex-allergy/symptoms-causes/syc-20374287', n.overview = 'là phản ứng với một số protein nhất định có trong mủ cao su tự nhiên, một sản phẩm làm từ cây cao su. Nếu bạn bị dị ứng với mủ cao su, cơ thể bạn sẽ nhầm mủ cao su là một chất có hại. Dị ứng latex có ', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế khẩn cấp nếu bạn đang gặp phải hoặc nghĩ rằng mình đang gặp phản ứng phản vệ. Nếu bạn có phản ứng ít nghiêm trọng hơn sau khi tiếp xúc với latex, hãy nói chuyện với chuyê';
MERGE (n:Disease {id: 'D1718'}) SET n.id = 'D1718', n.name = 'Dầu hoa oải hương', n.name_en = 'Lavender oil', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002711.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Dầu oải hương thường không độc ở người lớn khi';
MERGE (n:Disease {id: 'D1719'}) SET n.id = 'D1719', n.name = 'Quá liều thuốc nhuận tràng', n.name_en = 'Laxative overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002586.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào loại thuốc nhuận tràng được nuốt vào, lượng nuốt vào và thời gian trôi qua trước khi được điều trị. Quá liều thuốc nhuận tràng lần đầu hiếm khi nghiêm t';
MERGE (n:Disease {id: 'D1720'}) SET n.id = 'D1720', n.name = 'Mắt lười (nhược thị)', n.name_en = 'Lazy eye (amblyopia)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/lazy-eye/symptoms-causes/syc-20352391', n.overview = 'là tình trạng giảm thị lực ở một mắt do sự phát triển thị giác bất thường khi còn nhỏ. Con mắt yếu hơn hoặc lười biếng thường đảo hướng vào trong hoặc ra ngoài. Nhược thị thường phát triển từ sơ sinh ', n.when_to_see = 'Hãy gặp bác sĩ của con bạn nếu bạn nhận thấy mắt của trẻ bị lang thang sau vài tuần đầu đời. Kiểm tra thị lực đặc biệt quan trọng nếu có tiền sử gia đình bị lác mắt, đục thủy tinh thể ở trẻ em hoặc cá';
MERGE (n:Disease {id: 'D1721'}) SET n.id = 'D1721', n.name = 'Ngộ độc chì', n.name_en = 'Lead poisoning', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/lead-poisoning/symptoms-causes/syc-20354717 | https://medlineplus.gov/ency/article/002473.htm', n.overview = 'là kết quả của việc chì, một kim loại nặng, tích tụ trong cơ thể. Điều này thường xảy ra trong nhiều tháng hoặc nhiều năm. Ngay cả một lượng nhỏ chì cũng có thể gây ra các vấn đề sức khỏe nghiêm trọng', n.prognosis = 'Người lớn có mức độ chì cao nhẹ thường hồi phục mà không gặp vấn đề gì. Ở trẻ em, ngay cả ngộ độc chì nhẹ cũng có thể ảnh hưởng vĩnh viễn đến khả năng chú ý và chỉ số IQ. Những người có hàm lượng chì ';
MERGE (n:Disease {id: 'D1722'}) SET n.id = 'D1722', n.name = 'Học cách quản lý căng thẳng', n.name_en = 'Learn to manage stress', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001942.htm', n.overview = 'HỌC CÁCH NHẬN BIẾT CĂNG THẲNG Bước đầu tiên trong việc quản lý căng thẳng là nhận ra nó trong cuộc sống của bạn. Mọi người đều cảm thấy căng thẳng theo một cách khác nhau. Bạn có thể tức giận hoặc cáu';
MERGE (n:Disease {id: 'D1723'}) SET n.id = 'D1723', n.name = 'Phì đại thất trái', n.name_en = 'Left ventricular hypertrophy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/left-ventricular-hypertrophy/symptoms-causes/syc-20374314', n.overview = 'cúp là tình trạng thành buồng bơm chính của tim dày lên, gọi là tâm thất trái. Sự dày lên này có thể làm tăng áp lực trong tim. Tình trạng này có thể khiến tim khó bơm máu hơn. Nguyên nhân phổ biến nh', n.when_to_see = 'Tìm kiếm sự chăm sóc khẩn cấp nếu: Bạn cảm thấy đau ngực kéo dài hơn một vài phút. Bạn bị khó thở trầm trọng. Bạn bị choáng váng nghiêm trọng hoặc mất ý thức. Bạn bị đau đầu đột ngột, dữ dội, khó nói ';
MERGE (n:Disease {id: 'D1724'}) SET n.id = 'D1724', n.name = 'Kéo dài và rút ngắn chân', n.name_en = 'Leg lengthening and shortening', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002965.htm', n.overview = 'KÉO DÀI XƯƠNG Theo truyền thống, loạt phương pháp điều trị này bao gồm một số ca phẫu thuật, thời gian hồi phục lâu và một số rủi ro. Tuy nhiên, nó có thể tăng thêm chiều dài chân lên tới 6 inch (15 c', n.prognosis = 'Hạn chế sự phát triển của xương (epipsyodesis) thường thành công nhất khi được thực hiện vào đúng thời điểm trong giai đoạn tăng trưởng. Tuy nhiên, nó có thể gây ra tầm vóc ngắn. Việc rút ngắn xương c';
MERGE (n:Disease {id: 'D1725'}) SET n.id = 'D1725', n.name = 'Cắt cụt chân hoặc bàn chân', n.name_en = 'Leg or foot amputation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007365.htm', n.prognosis = 'Quá trình phục hồi và khả năng hoạt động của bạn sau khi cắt cụt phụ thuộc vào nhiều thứ. Một số trong số này là lý do phải cắt cụt chi, cho dù bạn mắc bệnh tiểu đường hay lưu lượng máu kém và tuổi tá';
MERGE (n:Disease {id: 'D1726'}) SET n.id = 'D1726', n.name = 'Bệnh Legg-Calve-Perthes', n.name_en = 'Legg-Calve-Perthes disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/legg-calve-perthes-disease/symptoms-causes/syc-20374343 | https://medlineplus.gov/ency/article/001264.htm', n.overview = 'Khớp hông he đầu xương đùi, nằm ở đầu xương đùi, gọi là xương đùi. Ổ cối, được gọi là ổ cối, là một phần của xương hông. Bệnh Legg-Calve-Perthes (LEG-kahl-VAY-PER-tuz) là một tình trạng thời thơ ấu xả', n.prognosis = 'Outlook phụ thuộc vào độ tuổi của con bạn và mức độ nghiêm trọng của bệnh. Trẻ em dưới 6 tuổi được điều trị có nhiều khả năng sẽ có khớp hông bình thường. Trẻ em trên 6 tuổi có nhiều khả năng bị biến ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu con bạn bắt đầu đi khập khiễng hoặc kêu đau hông, háng hoặc đầu gối. Nếu con bạn bị sốt hoặc không thể chịu được trọng lượng ở chân, hãy tìm kiếm s';
MERGE (n:Disease {id: 'D1727'}) SET n.id = 'D1727', n.name = 'Bệnh Legionnaires', n.name_en = 'Legionnaires\' disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/legionnaires-disease/symptoms-causes/syc-20351747 | https://medlineplus.gov/ency/article/000616.htm', n.overview = 'là một dạng nhiễm trùng phổi nghiêm trọng được gọi là viêm phổi. Nguyên nhân là do một loại vi khuẩn có tên Legionella gây ra. Hầu hết những người mắc bệnh Legionnaires đều hít phải vi khuẩn từ nước h', n.prognosis = 'Bệnh Legionnaires có thể đe dọa tính mạng. Nguy cơ tử vong cao hơn ở những người: Mắc bệnh mãn tính (mãn tính) hoặc hệ thống miễn dịch bị tổn hại Bị nhiễm bệnh khi nằm viện Là người lớn tuổi', n.when_to_see = 'Hãy hẹn khám bệnh nếu bạn cho rằng mình đã tiếp xúc với vi khuẩn Legionella. Chẩn đoán và điều trị bệnh Legionnaires càng sớm càng tốt có thể giúp rút ngắn thời gian hồi phục và ngăn ngừa các biến chứ';
MERGE (n:Disease {id: 'D1728'}) SET n.id = 'D1728', n.name = 'Leiomyosarcoma', n.name_en = 'Leiomyosarcoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/leiomyosarcoma/symptoms-causes/syc-20577215', n.overview = 'là một loại ung thư hiếm gặp bắt đầu ở mô cơ trơn. Nhiều vùng trên cơ thể có mô cơ trơn. Các khu vực có mô cơ trơn bao gồm hệ tiêu hóa, hệ tiết niệu, mạch máu và tử cung. Leiomyosarcoma thường bắt đầu', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có các triệu chứng khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1729'}) SET n.id = 'D1729', n.name = 'Bệnh leishmania', n.name_en = 'Leishmaniasis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001386.htm', n.prognosis = 'Tỷ lệ khỏi bệnh cao nếu sử dụng thuốc phù hợp, chủ yếu là khi bắt đầu điều trị trước khi nó ảnh hưởng đến hệ thống miễn dịch. Bệnh leishmania ở da có thể dẫn đến biến dạng. Tử vong thường do các biến ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh leishmania sau khi đến khu vực được biết là có bệnh xảy ra.';
MERGE (n:Disease {id: 'D1730'}) SET n.id = 'D1730', n.name = 'Bệnh phong', n.name_en = 'Leprosy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001347.htm', n.prognosis = 'Việc chẩn đoán bệnh sớm là rất quan trọng. Điều trị sớm giúp: Hạn chế tổn thương Ngăn chặn bệnh lây lan Giảm các biến chứng lâu dài', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của bệnh phong, đặc biệt nếu bạn đã tiếp xúc với người mắc bệnh phong. Các trường hợp mắc bệnh phong ở Hoa Kỳ ';
MERGE (n:Disease {id: 'D1731'}) SET n.id = 'D1731', n.name = 'Leptospirosis', n.name_en = 'Leptospirosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001376.htm', n.prognosis = 'Triển vọng nhìn chung là tốt. Tuy nhiên, một trường hợp phức tạp có thể gây tử vong nếu không được điều trị kịp thời.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ triệu chứng hoặc yếu tố nguy cơ nào đối với bệnh leptospirosis.';
MERGE (n:Disease {id: 'D1732'}) SET n.id = 'D1732', n.name = 'Hội chứng Lesch-Nyhan', n.name_en = 'Lesch-Nyhan syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001655.htm', n.prognosis = 'Kết quả có thể sẽ kém. Những người mắc hội chứng này thường cần được giúp đỡ khi đi lại và ngồi. Hầu hết đều cần xe lăn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn có dấu hiệu mắc bệnh này hoặc nếu gia đình bạn có tiền sử mắc hội chứng Lesch-Nyhan.';
MERGE (n:Disease {id: 'D1733'}) SET n.id = 'D1733', n.name = 'Bệnh bạch cầu', n.name_en = 'Leukemia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/leukemia/symptoms-causes/syc-20374373', n.overview = 'là bệnh ung thư của các mô tạo máu của cơ thể, bao gồm tủy xương và hệ bạch huyết. Có nhiều loại bệnh bạch cầu tồn tại. Một số dạng bệnh bạch cầu phổ biến hơn ở trẻ em. Các dạng bệnh bạch cầu khác xảy', n.when_to_see = 'Hãy hẹn gặp bác sĩ nếu bạn có bất kỳ dấu hiệu hoặc triệu chứng dai dẳng nào khiến bạn lo lắng. Các triệu chứng bệnh bạch cầu thường mơ hồ và không cụ thể. Bạn có thể bỏ qua các triệu chứng bệnh bạch c';
MERGE (n:Disease {id: 'D1734'}) SET n.id = 'D1734', n.name = 'Bạch sản', n.name_en = 'Leukoplakia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/leukoplakia/symptoms-causes/syc-20354405 | https://medlineplus.gov/ency/article/001046.htm', n.overview = 'e bề mặt của miệng. Nó có một số nguyên nhân có thể xảy ra, bao gồm chấn thương hoặc kích ứng lặp đi lặp lại. Nó cũng có thể là dấu hiệu của bệnh ung thư miệng hoặc là dấu hiệu của những thay đổi có t', n.prognosis = 'Leukoplakia thường vô hại. Các vết loét trong miệng thường biến mất sau vài tuần hoặc vài tháng sau khi loại bỏ nguồn gây kích ứng. Trong một số trường hợp, các mảng này có thể là dấu hiệu sớm của bện', n.when_to_see = 'Mặc dù bệnh bạch sản thường không gây khó chịu nhưng đôi khi nó có thể gợi ý một tình trạng nghiêm trọng hơn. Hãy đến gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ điều nào sau đ';
MERGE (n:Disease {id: 'D1735'}) SET n.id = 'D1735', n.name = 'Bệnh mất trí nhớ thể Lewy', n.name_en = 'Lewy body dementia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/lewy-body-dementia/symptoms-causes/syc-20352025', n.overview = ', còn được gọi là LBD, là loại bệnh mất trí nhớ phổ biến thứ hai sau bệnh Alzheimer. Sự tích tụ protein được gọi là thể Lewy phát triển trong các tế bào thần kinh trong não. Sự lắng đọng protein ảnh h';
MERGE (n:Disease {id: 'D1736'}) SET n.id = 'D1736', n.name = 'Khối u tinh hoàn tế bào Leydig', n.name_en = 'Leydig cell testicular tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000409.htm', n.prognosis = 'Ung thư tinh hoàn là một trong những bệnh ung thư có thể chữa khỏi và điều trị được. Triển vọng sẽ tồi tệ hơn nếu khối u không được phát hiện sớm.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh ung thư tinh hoàn.';
MERGE (n:Disease {id: 'D1737'}) SET n.id = 'D1737', n.name = 'Lichen planus', n.name_en = 'Lichen planus', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/lichen-planus/symptoms-causes/syc-20351378 | https://medlineplus.gov/ency/article/000867.htm', n.overview = '(LIE-kun PLAY-nus) là một tình trạng về da, tóc, móng, miệng và bộ phận sinh dục. Trên da, lichen phẳng thường xuất hiện dưới dạng các vết sưng tấy màu tím, ngứa, phẳng phát triển trong vài tuần. Ở mi', n.prognosis = 'Lichen planus thường không có hại. Thông thường, nó sẽ tốt hơn khi điều trị. Tình trạng này thường khỏi trong vòng 18 tháng nhưng có thể đến rồi đi trong nhiều năm. Nếu bệnh lichen phẳng do thuốc bạn ', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu những vết sưng nhỏ hoặc phát ban xuất hiện trên da của bạn mà không rõ lý do, chẳng hạn như tiếp xúc với cây thường xuân độc. Đồng thời, hãy ';
MERGE (n:Disease {id: 'D1738'}) SET n.id = 'D1738', n.name = 'Lichen sclerosus', n.name_en = 'Lichen sclerosus', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/lichen-sclerosus/symptoms-causes/syc-20374448', n.overview = '(LIE-kun skluh-ROW-sus) là tình trạng khiến da mỏng, loang lổ, đổi màu. Nó thường ảnh hưởng đến vùng sinh dục và hậu môn. Bất cứ ai cũng có thể mắc bệnh lichen sclerosus nhưng phụ nữ sau mãn kinh có n', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của bệnh lichen sclerosus. Nếu bạn đã được chẩn đoán mắc bệnh lichen sclerosus, hãy đến gặp nhà cung cấp dịch vụ chăm ';
MERGE (n:Disease {id: 'D1739'}) SET n.id = 'D1739', n.name = 'Lichen simplex Chronicus', n.name_en = 'Lichen simplex chronicus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000872.htm', n.prognosis = 'Bạn có thể kiểm soát LSC bằng cách giảm ngứa và kiểm soát việc gãi. Mặc dù tình trạng này có thể được điều trị nhưng nó thường tái phát. Tình trạng này có thể quay trở lại hoặc di chuyển đến các vùng ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Các triệu chứng trở nên tồi tệ hơn Bạn xuất hiện các triệu chứng mới, đặc biệt là các dấu hiệu nhiễm trùng da như đau, tấy đỏ, chảy dịch ở vùng đó hoặ';
MERGE (n:Disease {id: 'D1740'}) SET n.id = 'D1740', n.name = 'Ngộ độc chất lỏng nhẹ hơn', n.name_en = 'Lighter fluid poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002833.htm', n.prognosis = 'Khả năng của một người tùy thuộc vào về mức độ ngộ độc của họ nghiêm trọng như thế nào và họ được điều trị nhanh như thế nào. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải những ';
MERGE (n:Disease {id: 'D1741'}) SET n.id = 'D1741', n.name = 'Ngộ độc hoa huệ thung lũng', n.name_en = 'Lily of the valley poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002882.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào lượng chất độc nuốt vào và tốc độ điều trị. Bạn nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Các triệu chứng kéo dài từ 1 đến 3 ngày và có thể';
MERGE (n:Disease {id: 'D1742'}) SET n.id = 'D1742', n.name = 'Chứng loạn dưỡng cơ vùng thắt lưng', n.name_en = 'Limb-girdle muscular dystrophies', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000711.htm', n.prognosis = 'Nói chung, mọi người có xu hướng bị yếu dần dần ở các cơ bị ảnh hưởng và lan rộng. Tình trạng này gây mất khả năng vận động. Người đó có thể phải phụ thuộc vào xe lăn trong vòng 20 đến 30 năm. Yếu cơ ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn cảm thấy yếu khi đứng lên từ tư thế ngồi xổm. Liên hệ với nhà di truyền học nếu bạn hoặc thành viên gia đình được ch';
MERGE (n:Disease {id: 'D1743'}) SET n.id = 'D1743', n.name = 'Phạm vi chuyển động hạn chế', n.name_en = 'Limited range of motion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003173.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn gặp khó khăn khi di chuyển hoặc duỗi khớp.';
MERGE (n:Disease {id: 'D1744'}) SET n.id = 'D1744', n.name = 'Ung thư môi', n.name_en = 'Lip cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/lip-cancer/symptoms-causes/syc-20355079', n.overview = 'eal. Ung thư môi xảy ra trên da môi. Ung thư môi có thể xảy ra ở bất kỳ vị trí nào dọc theo môi trên hoặc dưới, nhưng phổ biến nhất là ở môi dưới. Ung thư môi được coi là một loại ung thư miệng (miệng', n.when_to_see = 'Hãy hẹn gặp bác sĩ nếu bạn có bất kỳ dấu hiệu hoặc triệu chứng dai dẳng nào khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D1745'}) SET n.id = 'D1745', n.name = 'Ngộ độc kem dưỡng ẩm môi', n.name_en = 'Lip moisturizer poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002723.htm', n.prognosis = 'Rất có khả năng phục hồi. Các thành phần thường được coi là không độc hại.';
MERGE (n:Disease {id: 'D1746'}) SET n.id = 'D1746', n.name = 'Lipoma', n.name_en = 'Lipoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/lipoma/symptoms-causes/syc-20374470', n.overview = 'Lipoma là một khối u béo, phát triển chậm, thường nằm giữa da và lớp cơ nhưng bên dưới da. Nó có cảm giác mềm mại và dẻo dai và thường không mềm. Nó cũng di chuyển với lực ấn nhẹ của ngón tay như thể ', n.when_to_see = 'U mỡ hiếm khi là một tình trạng bệnh lý nghiêm trọng. Nhưng nếu bạn nhận thấy có cục u hoặc sưng tấy ở bất cứ đâu trên cơ thể, hãy nhờ chuyên gia chăm sóc sức khỏe của bạn kiểm tra.';
MERGE (n:Disease {id: 'D1747'}) SET n.id = 'D1747', n.name = 'Liposarcoma', n.name_en = 'Liposarcoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/liposarcoma/symptoms-causes/syc-20352632', n.overview = 'ells. Nó xảy ra thường xuyên nhất ở các cơ ở tay chân hoặc bụng. Liposarcoma là một loại ung thư hiếm gặp bắt đầu từ các tế bào mỡ. Nó thường bắt đầu bằng sự phát triển của các tế bào ở bụng hoặc ở cơ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào không biến mất và khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này.';
MERGE (n:Disease {id: 'D1748'}) SET n.id = 'D1748', n.name = 'Hút mỡ', n.name_en = 'Liposuction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002985.htm', n.overview = 'là một loại phẫu thuật thẩm mỹ. Nó loại bỏ chất béo dư thừa không mong muốn để cải thiện ngoại hình cơ thể và làm mịn các hình dạng cơ thể không đều. Thủ tục này đôi khi được gọi là tạo đường nét cơ t', n.prognosis = 'Hầu hết mọi người đều hài lòng với kết quả phẫu thuật. Hình dáng cơ thể mới của bạn sẽ bắt đầu lộ rõ ​​trong vài tuần đầu tiên. Sự cải thiện sẽ rõ ràng hơn từ 4 đến 6 tuần sau phẫu thuật. Bằng cách tậ';
MERGE (n:Disease {id: 'D1749'}) SET n.id = 'D1749', n.name = 'Nhang lỏng', n.name_en = 'Liquid Incense', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002710.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng hương lỏng mà họ nuốt vào và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Lạm dụng hương lỏng cũng nguy hiểm như dùng c';
MERGE (n:Disease {id: 'D1750'}) SET n.id = 'D1750', n.name = 'Nhiễm khuẩn Listeria', n.name_en = 'Listeria infection', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/listeria-infection/symptoms-causes/syc-20355269', n.overview = 'là một căn bệnh do vi khuẩn gây ra và có thể lây lan qua nhiều loại thực phẩm. Một tên gọi khác của căn bệnh này là bệnh listeriosis. Nó có thể rất nghiêm trọng đối với phụ nữ mang thai, người trên 65', n.when_to_see = 'Nếu bạn đã ăn một loại thực phẩm đã bị thu hồi do bùng phát vi khuẩn listeria, hãy theo dõi các triệu chứng bệnh tật. Gọi cho chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị sốt, đau cơ, đau bụng hoặc';
MERGE (n:Disease {id: 'D1751'}) SET n.id = 'D1751', n.name = 'Listeriosis', n.name_en = 'Listeriosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001380.htm', n.prognosis = 'Bệnh Listeriosis ở bào thai hoặc trẻ sơ sinh thường gây tử vong. Trẻ lớn hơn và người lớn khỏe mạnh có nhiều khả năng sống sót hơn. Bệnh ít nghiêm trọng hơn nếu chỉ ảnh hưởng đến hệ tiêu hóa. Nhiễm tr', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn phát triển các triệu chứng của bệnh listeriosis.';
MERGE (n:Disease {id: 'D1752'}) SET n.id = 'D1752', n.name = 'Độc tính của lithium', n.name_en = 'Lithium toxicity', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002667.htm', n.prognosis = 'Nếu ai đó bị ngộ độc lithium cấp tính, khả năng phục hồi của họ phụ thuộc vào lượng lithium họ đã dùng và tốc độ họ nhận được trợ giúp. Những người không phát triển các triệu chứng về hệ thần kinh thư';
MERGE (n:Disease {id: 'D1753'}) SET n.id = 'D1753', n.name = 'Tán sỏi', n.name_en = 'Lithotripsy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007113.htm', n.overview = 'Tán sỏi ngoài cơ thể bằng sóng xung kích (ESWL) là loại tán sỏi phổ biến nhất. “Extracorporeal” có nghĩa là bên ngoài cơ thể. Để sẵn sàng cho thủ thuật, bạn sẽ mặc áo choàng bệnh viện và nằm trên bàn ', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào số lượng sỏi bạn có, kích thước của chúng và vị trí của chúng trong hệ thống tiết niệu của bạn. Trong hầu hết các trường hợp, tán sỏi sẽ loại bỏ tất cả các viên s';
MERGE (n:Disease {id: 'D1754'}) SET n.id = 'D1754', n.name = 'Livedo reticularis', n.name_en = 'Livedo reticularis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001478.htm', n.prognosis = 'Trong nhiều trường hợp, LR nguyên phát cải thiện hoặc biến mất theo tuổi tác. Đối với LR do một căn bệnh tiềm ẩn, triển vọng phụ thuộc vào việc bệnh được điều trị tốt như thế nào.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn mắc LR và cho rằng đó có thể là do một căn bệnh tiềm ẩn.';
MERGE (n:Disease {id: 'D1755'}) SET n.id = 'D1755', n.name = 'Ung thư gan', n.name_en = 'Liver cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/liver-cancer/symptoms-causes/syc-20353659', n.overview = 'Ung thư gan là gì? Chuyên gia giải thích Tìm hiểu thêm từ bác sĩ phẫu thuật gan Sean Cleary, M.D. Hiển thị bản ghi video Ung thư gan là gì? Một chuyên gia giải thích Phòng khám Mayo giải thích về bệnh', n.when_to_see = 'Hãy hẹn gặp bác sĩ nếu bạn gặp bất kỳ dấu hiệu hoặc triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin được đánh dấu';
MERGE (n:Disease {id: 'D1756'}) SET n.id = 'D1756', n.name = 'Ung thư gan - ung thư biểu mô tế bào gan', n.name_en = 'Liver cancer - hepatocellular carcinoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000280.htm', n.prognosis = 'Nếu không thể điều trị dứt điểm ung thư, bệnh thường gây tử vong. Nhưng khả năng sống sót có thể khác nhau, tùy thuộc vào mức độ tiến triển của ung thư và mức độ điều trị thành công.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị đau bụng liên tục, đặc biệt nếu bạn có tiền sử bệnh gan.';
MERGE (n:Disease {id: 'D1757'}) SET n.id = 'D1757', n.name = 'Bệnh gan', n.name_en = 'Liver disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/liver-problems/symptoms-causes/syc-20374502', n.overview = 'Gan nằm ở phần trên bên phải của bụng, bên dưới cơ hoành và phía trên dạ dày. Gan là một cơ quan nằm ngay dưới khung xương sườn bên phải của bụng. Nó có thể nặng tới 4 pound (1,8 kg). Gan cần thiết để', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có bất kỳ triệu chứng kéo dài nào khiến bạn lo lắng. Hãy tìm kiếm sự trợ giúp y tế ngay lập tức nếu bạn bị đau bụng dữ dội đến mức không thể đứ';
MERGE (n:Disease {id: 'D1758'}) SET n.id = 'D1758', n.name = 'Di căn gan', n.name_en = 'Liver metastases', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000277.htm', n.prognosis = 'Tình trạng của bạn tốt như thế nào tùy thuộc vào vị trí của khối u ban đầu và mức độ di căn đến gan hoặc bất kỳ nơi nào khác. Trong một số ít trường hợp, phẫu thuật cắt bỏ khối u gan có thể chữa khỏi ', n.when_to_see = 'Bất kỳ ai từng mắc một loại ung thư có thể di căn đến gan nên biết về các dấu hiệu và triệu chứng được liệt kê ở trên và liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của họ nếu có bất kỳ dấu hiệ';
MERGE (n:Disease {id: 'D1759'}) SET n.id = 'D1759', n.name = 'Đốm gan', n.name_en = 'Liver spots', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001141.htm', n.prognosis = 'Các đốm gan không gây nguy hiểm cho sức khỏe của bạn. Chúng là những thay đổi da vĩnh viễn ảnh hưởng đến vẻ ngoài của làn da bạn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có các đốm ở gan và muốn loại bỏ chúng Bạn phát triển bất kỳ triệu chứng mới nào, đặc biệt là những thay đổi về hình thức của đốm ở gan';
MERGE (n:Disease {id: 'D1760'}) SET n.id = 'D1760', n.name = 'Ghép gan', n.name_en = 'Liver transplant', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003006.htm', n.overview = 'Gan được hiến tặng có thể là của: Người hiến tặng vừa qua đời và không bị tổn thương gan. Loại người hiến tặng này được gọi là người hiến xác. Đôi khi, một người khỏe mạnh sẽ hiến một phần gan của mìn', n.prognosis = 'Những người được ghép gan có thể từ chối cơ quan mới. Điều này có nghĩa là hệ thống miễn dịch của họ coi lá gan mới như một chất lạ và cố gắng tiêu diệt nó. Để tránh bị đào thải, hầu hết những người n';
MERGE (n:Disease {id: 'D1761'}) SET n.id = 'D1761', n.name = 'Ung thư biểu mô tiểu thùy tại chỗ (LCIS)', n.name_en = 'Lobular carcinoma in situ (LCIS)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/lobular-carcinoma-in-situ/symptoms-causes/syc-20374529', n.overview = 'Ung thư biểu mô tiểu thùy tại chỗ là sự phát triển của các tế bào xảy ra ở tuyến sữa trong mô vú. Các tế bào trải qua những thay đổi khiến chúng trông khác với các tế bào thông thường. Ung thư biểu mô', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn nhận thấy có sự thay đổi ở ngực của mình. Những thay đổi có thể bao gồm một khối u, vùng da nhăn nheo hoặc bất thường, vùng dưới da dà';
MERGE (n:Disease {id: 'D1762'}) SET n.id = 'D1762', n.name = 'Quá liều Lomotil', n.name_en = 'Lomotil overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002668.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào lượng thuốc đã nuốt và tốc độ điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Có thể cần phải nằm viện để dùng thêm liều thuốc làm đ';
MERGE (n:Disease {id: 'D1763'}) SET n.id = 'D1763', n.name = 'COVID kéo dài', n.name_en = 'Long COVID', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007791.htm', n.prognosis = 'Hầu hết những người có triệu chứng vào 4 tuần sau khi nhiễm COVID-19 sẽ dần dần cải thiện. Nghiên cứu đang được tiến hành để tìm ra cách giúp những người mắc bệnh COVID kéo dài vượt qua tình trạng này', n.when_to_see = 'Bạn nên liên hệ với nhà cung cấp dịch vụ của mình nếu bạn mắc COVID-19 và bạn có các triệu chứng liên tục trong 4 tuần trở lên hoặc các triệu chứng tương tự hoặc các triệu chứng mới tái phát sau 4 tuầ';
MERGE (n:Disease {id: 'D1764'}) SET n.id = 'D1764', n.name = 'Hội chứng QT kéo dài', n.name_en = 'Long QT syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/long-qt-syndrome/symptoms-causes/syc-20352518', n.overview = '(LQTS) là một rối loạn nhịp tim gây ra nhịp tim nhanh và hỗn loạn. Nhịp tim không đều có thể đe dọa tính mạng. LQTS ảnh hưởng đến các tín hiệu điện truyền qua tim và khiến tim đập. Một số người sinh r', n.when_to_see = 'Hãy hẹn khám sức khỏe nếu bạn ngất xỉu hoặc nếu bạn cảm thấy tim đập thình thịch hoặc nhanh. Hãy cho nhóm chăm sóc sức khỏe của bạn biết nếu bạn có cha mẹ, anh chị em hoặc con mắc hội chứng QT kéo dài';
MERGE (n:Disease {id: 'D1765'}) SET n.id = 'D1765', n.name = 'Lordosis - thắt lưng', n.name_en = 'Lordosis - lumbar', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003278.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy con mình có tư thế quá mức hoặc đường cong ở lưng. Nhà cung cấp của bạn phải kiểm tra xem có vấn đề y tế nào không.';
MERGE (n:Disease {id: 'D1766'}) SET n.id = 'D1766', n.name = 'Mất chức năng não - bệnh gan', n.name_en = 'Loss of brain function - liver disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000302.htm', n.prognosis = 'Triển vọng của HE phụ thuộc vào việc quản lý nguyên nhân của HE. Các dạng rối loạn mãn tính thường tiếp tục trở nên tồi tệ hơn và quay trở lại. Hai giai đoạn đầu của bệnh có tiên lượng tốt. Giai đoạn ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn hoặc những người xung quanh nhận thấy bất kỳ vấn đề nào về trạng thái tinh thần hoặc chức năng hệ thần kinh của bạn. Điều này rất quan trọng đối với những ';
MERGE (n:Disease {id: 'D1767'}) SET n.id = 'D1767', n.name = 'Đau thắt lưng - cấp tính', n.name_en = 'Low back pain - acute', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007425.htm', n.prognosis = 'Nhiều người cảm thấy đỡ hơn trong vòng 1 tuần. Sau 4 đến 6 tuần nữa, cơn đau lưng sẽ biến mất hoàn toàn.', n.when_to_see = 'Liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu bạn gặp: Đau lưng sau một cú đánh hoặc ngã nặng Đốt khi đi tiểu hoặc có máu trong nước tiểu Tiền sử ung thư Mất kiểm soát nước tiểu hoặc phân (không t';
MERGE (n:Disease {id: 'D1768'}) SET n.id = 'D1768', n.name = 'Đau thắt lưng - mãn tính', n.name_en = 'Low back pain - chronic', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007422.htm', n.prognosis = 'Hầu hết các vấn đề về lưng đều tự khỏi. Làm theo lời khuyên của nhà cung cấp dịch vụ của bạn về các biện pháp điều trị và tự chăm sóc.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị đau lưng dữ dội mà không khỏi. Liên hệ với họ ngay nếu bạn bị tê, mất vận động, yếu hoặc thay đổi ruột hoặc bàng quang.';
MERGE (n:Disease {id: 'D1769'}) SET n.id = 'D1769', n.name = 'Kali trong máu thấp', n.name_en = 'Low blood potassium', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000479.htm', n.prognosis = 'Việc bổ sung kali thường có thể khắc phục được vấn đề. Trong những trường hợp nghiêm trọng, nếu không được điều trị thích hợp, nồng độ kali trong máu giảm nghiêm trọng có thể dẫn đến các vấn đề nghiêm', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn bị nôn mửa hoặc tiêu chảy quá mức, hoặc nếu bạn đang dùng thuốc lợi tiểu và có triệu chứng hạ kali máu.';
MERGE (n:Disease {id: 'D1770'}) SET n.id = 'D1770', n.name = 'Huyết áp thấp', n.name_en = 'Low blood pressure', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007278.htm', n.prognosis = 'Huyết áp thấp thường có thể được điều trị thành công.', n.when_to_see = 'Nếu huyết áp thấp khiến một người bất tỉnh (bất tỉnh), hãy tìm cách điều trị ngay. Hoặc gọi 911 hoặc số khẩn cấp tại địa phương. Nếu người đó không thở hoặc không có mạch, hãy bắt đầu hô hấp nhân tạo.';
MERGE (n:Disease {id: 'D1771'}) SET n.id = 'D1771', n.name = 'Huyết áp thấp (hạ huyết áp)', n.name_en = 'Low blood pressure (hypotension)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/low-blood-pressure/symptoms-causes/syc-20355465', n.overview = 'Huyết áp thấp là tình trạng lực đẩy của máu vào thành động mạch quá thấp. Nó còn được gọi là hạ huyết áp. Huyết áp được đo bằng milimet thủy ngân (mm Hg). Nói chung, huyết áp thấp là chỉ số thấp hơn 9', n.when_to_see = 'Nếu bạn có các triệu chứng huyết áp cực thấp hoặc sốc, hãy gọi 911 hoặc số khẩn cấp tại địa phương. Hầu hết các chuyên gia chăm sóc sức khỏe đều coi huyết áp là quá thấp chỉ khi nó gây ra các triệu ch';
MERGE (n:Disease {id: 'D1772'}) SET n.id = 'D1772', n.name = 'Natri máu thấp', n.name_en = 'Low blood sodium', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000394.htm', n.prognosis = 'Kết quả phụ thuộc vào tình trạng gây ra vấn đề. Hạ natri máu xảy ra dưới 48 giờ (hạ natri máu cấp tính), nguy hiểm hơn hạ natri máu diễn biến chậm theo thời gian. Khi nồng độ natri trong máu giảm chậm', n.when_to_see = 'Khi mức natri trong cơ thể bạn giảm quá nhiều, đó có thể là một trường hợp khẩn cấp đe dọa tính mạng. Hãy gọi cho nhà cung cấp của bạn ngay lập tức nếu bạn có các triệu chứng của tình trạng này.';
MERGE (n:Disease {id: 'D1773'}) SET n.id = 'D1773', n.name = 'Lượng đường trong máu thấp', n.name_en = 'Low blood sugar', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000386.htm', n.when_to_see = 'Nếu không có dấu hiệu hạ đường huyết cải thiện sau khi bạn ăn đồ ăn nhẹ có đường: Lên xe đến phòng cấp cứu. Đừng tự lái xe. Gọi 911 hoặc số điện thoại khẩn cấp tại địa phương Nhận trợ giúp y tế ngay l';
MERGE (n:Disease {id: 'D1774'}) SET n.id = 'D1774', n.name = 'Lượng đường trong máu thấp - trẻ sơ sinh', n.name_en = 'Low blood sugar - newborns', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007306.htm', n.prognosis = 'Triển vọng tốt cho trẻ sơ sinh không có triệu chứng hoặc đáp ứng tốt với điều trị. Tuy nhiên, lượng đường trong máu thấp có thể quay trở lại ở một số ít trẻ sau khi điều trị, do đó mức đường huyết sẽ ';
MERGE (n:Disease {id: 'D1775'}) SET n.id = 'D1775', n.name = 'Mức canxi thấp - trẻ sơ sinh', n.name_en = 'Low calcium level - infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007229.htm', n.prognosis = 'Các vấn đề về nồng độ canxi trong máu thấp ở trẻ sơ sinh hoặc trẻ sinh non thường không kéo dài lâu.';
MERGE (n:Disease {id: 'D1776'}) SET n.id = 'D1776', n.name = 'Sống mũi thấp', n.name_en = 'Low nasal bridge', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003056.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có thắc mắc về hình dạng mũi của con bạn.';
MERGE (n:Disease {id: 'D1777'}) SET n.id = 'D1777', n.name = 'Ham muốn tình dục thấp ở phụ nữ', n.name_en = 'Low sex drive in women', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/low-sex-drive-in-women/symptoms-causes/syc-20374554', n.overview = 'Mức độ ham muốn tình dục của phụ nữ thay đổi theo năm tháng. Việc thăng trầm xảy ra cùng lúc với sự bắt đầu hoặc kết thúc của một mối quan hệ là điều bình thường. Hoặc chúng có thể xảy ra khi có những', n.when_to_see = 'Nếu bạn lo lắng về việc mình ít ham muốn tình dục, hãy nói chuyện với bác sĩ phụ khoa hoặc chuyên gia chăm sóc sức khỏe khác. Câu trả lời có thể đơn giản như việc thay đổi loại thuốc bạn đang dùng. Ho';
MERGE (n:Disease {id: 'D1778'}) SET n.id = 'D1778', n.name = 'Số lượng tinh trùng thấp', n.name_en = 'Low sperm count', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/low-sperm-count/symptoms-causes/syc-20374585', n.overview = 'Số lượng tinh trùng thấp có nghĩa là có ít tinh trùng hơn mức thông thường trong chất lỏng gọi là tinh dịch mà dương vật tiết ra khi đạt cực khoái. Số lượng tinh trùng thấp còn được gọi là oligospermi', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn và bạn tình không thể mang thai sau một năm quan hệ tình dục thường xuyên mà không sử dụng biện pháp tránh thai. Đây là cách xác định tình trạng được gọi l';
MERGE (n:Disease {id: 'D1779'}) SET n.id = 'D1779', n.name = 'Tai lệch và tai bất thường', n.name_en = 'Low-set ears and pinna abnormalities', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003303.htm', n.when_to_see = 'kỳ thi. Việc kiểm tra này thường được thực hiện tại bệnh viện vào thời điểm sinh nở.';
MERGE (n:Disease {id: 'D1780'}) SET n.id = 'D1780', n.name = 'Vòng thực quản dưới', n.name_en = 'Lower esophageal ring', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000208.htm', n.prognosis = 'Vấn đề nuốt có thể quay trở lại. Bạn có thể cần điều trị lặp lại.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn gặp vấn đề về nuốt.';
MERGE (n:Disease {id: 'D1781'}) SET n.id = 'D1781', n.name = 'Đau thắt ngực Ludwig', n.name_en = 'Ludwig angina', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001047.htm', n.prognosis = 'Cơn đau thắt ngực Ludwig có thể đe dọa tính mạng. Nó có thể được chữa khỏi bằng cách điều trị để giữ cho đường hô hấp thông thoáng và dùng thuốc kháng sinh.', n.when_to_see = 'Khó thở là một tình huống khẩn cấp. Hãy đến phòng cấp cứu hoặc liên hệ ngay với số điện thoại khẩn cấp tại địa phương (chẳng hạn như 911). Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các t';
MERGE (n:Disease {id: 'D1782'}) SET n.id = 'D1782', n.name = 'Khối u ở bụng', n.name_en = 'Lump in the abdomen', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003277.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có khối u ở bụng, đặc biệt nếu nó trở nên lớn hơn, thay đổi màu sắc hoặc gây đau đớn. Nếu bạn bị thoát vị, hãy liên hệ với nhà cu';
MERGE (n:Disease {id: 'D1783'}) SET n.id = 'D1783', n.name = 'Ung thư phổi', n.name_en = 'Lung cancer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/lung-cancer/symptoms-causes/syc-20374620 | https://medlineplus.gov/ency/article/007270.htm', n.overview = 'r là một loại ung thư bắt đầu từ sự phát triển của các tế bào trong phổi. Phổi là hai cơ quan xốp trong ngực kiểm soát hơi thở. Ung thư phổi là nguyên nhân hàng đầu gây tử vong do ung thư trên toàn th', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào mức độ lan rộng của ung thư phổi và liệu các tế bào ung thư có những thay đổi di truyền nhất định tạo ra các phân tử mục tiêu bên trong hoặc trên tế bào hay không', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Nếu bạn hút thuốc và không thể bỏ được, hãy hẹn gặp. Chuyên gia chăm sóc sức khỏe của bạn';
MERGE (n:Disease {id: 'D1784'}) SET n.id = 'D1784', n.name = 'Ung thư phổi - tế bào nhỏ', n.name_en = 'Lung cancer - small cell', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000122.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào mức độ ung thư phổi đã lan rộng. SCLC rất nguy hiểm. Không có nhiều người mắc loại ung thư này vẫn còn sống sau 5 năm kể từ khi được chẩn đoán. Việc điều trị thườ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh ung thư phổi, đặc biệt nếu bạn hút thuốc.';
MERGE (n:Disease {id: 'D1785'}) SET n.id = 'D1785', n.name = 'Di căn phổi', n.name_en = 'Lung metastases', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000097.htm', n.prognosis = 'Hầu hết các trường hợp ung thư đã lan đến phổi khó có thể chữa khỏi. Nhưng triển vọng phụ thuộc vào bệnh ung thư chính. Trong một số trường hợp, một người có thể sống hơn 5 năm nếu bị ung thư di căn đ', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có tiền sử ung thư và phát triển bệnh: Ho ra máu Ho dai dẳng Khó thở Sụt cân không rõ nguyên nhân';
MERGE (n:Disease {id: 'D1786'}) SET n.id = 'D1786', n.name = 'Các vấn đề về phổi và sương mù núi lửa', n.name_en = 'Lung problems and volcanic smog', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007468.htm', n.overview = 'Núi lửa thải ra các đám tro, bụi, sulfur dioxide, carbon monoxide và các loại khí độc hại khác vào không khí. Sulphur dioxide là loại khí có hại nhất. Khi các chất khí này phản ứng với oxy, độ ẩm và á';
MERGE (n:Disease {id: 'D1787'}) SET n.id = 'D1787', n.name = 'Phẫu thuật phổi', n.name_en = 'Lung surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002956.htm', n.overview = 'Bạn sẽ được gây mê toàn thân trước khi phẫu thuật. Bạn sẽ ngủ và không thể cảm thấy đau. Hai cách phổ biến để thực hiện phẫu thuật phổi là phẫu thuật cắt bỏ lồng ngực và phẫu thuật nội soi lồng ngực c', n.prognosis = 'Kết quả phụ thuộc vào: Loại vấn đề đang được điều trị Bao nhiêu mô phổi (nếu có) được cắt bỏ Sức khỏe tổng thể của bạn trước khi phẫu thuật';
MERGE (n:Disease {id: 'D1788'}) SET n.id = 'D1788', n.name = 'Ghép phổi', n.name_en = 'Lung transplant', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003010.htm', n.overview = 'Trong hầu hết các trường hợp, phổi hoặc phổi mới được hiến tặng bởi một người dưới 65 tuổi và đã chết não nhưng vẫn đang được hỗ trợ sự sống. Phổi của người hiến tặng phải không có bệnh và phù hợp nhấ', n.prognosis = 'Ghép phổi là một thủ thuật quan trọng được thực hiện cho những người mắc bệnh phổi hoặc tổn thương phổi đe dọa tính mạng. Khoảng 4 trong số 5 bệnh nhân vẫn còn sống sau 1 năm cấy ghép. Khoảng ba trong';
MERGE (n:Disease {id: 'D1789'}) SET n.id = 'D1789', n.name = 'Lupus', n.name_en = 'Lupus', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/lupus/symptoms-causes/syc-20365789', n.overview = 'là tình trạng hệ thống miễn dịch của cơ thể tấn công các mô và cơ quan của chính nó. Đây được gọi là tình trạng tự miễn dịch. Lupus gây sưng tấy và kích ứng, gọi là viêm, có thể ảnh hưởng đến khớp, da', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị phát ban hoặc các triệu chứng khác khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D1790'}) SET n.id = 'D1790', n.name = 'Viêm thận lupus', n.name_en = 'Lupus nephritis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/lupus-nephritis/symptoms-causes/syc-20354335 | https://medlineplus.gov/ency/article/000481.htm', n.overview = 'ID mặt cắt thận từ máu thông qua các đơn vị lọc gọi là nephron. Mỗi nephron chứa một bộ lọc, được gọi là cầu thận. Mỗi bộ lọc có các mạch máu nhỏ gọi là mao mạch. Khi máu chảy vào cầu thận, các mảnh n', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào dạng viêm thận lupus cụ thể. Bạn có thể bị các cơn bùng phát và đôi khi không có bất kỳ triệu chứng nào. Một số người mắc bệnh này sẽ bị suy thận lâu dài (mãn tín', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có máu trong nước tiểu hoặc sưng tấy cơ thể. Nếu bạn bị viêm thận lupus, hãy liên hệ với bác sĩ nếu bạn nhận thấy lượng nước tiểu giảm.';
MERGE (n:Disease {id: 'D1791'}) SET n.id = 'D1791', n.name = 'Bệnh Lyme', n.name_en = 'Lyme disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/lyme-disease/symptoms-causes/syc-20374651 | https://medlineplus.gov/ency/article/001319.htm', n.overview = 'là một căn bệnh do vi khuẩn borrelia gây ra. Con người thường mắc bệnh Lyme do vết cắn của bọ ve mang vi khuẩn. Bọ ve có thể mang vi khuẩn borrelia sống ở hầu hết nước Mỹ. Nhưng bệnh Lyme phổ biến nhấ', n.prognosis = 'Nếu được chẩn đoán ở giai đoạn đầu, bệnh Lyme có thể được chữa khỏi bằng kháng sinh. Nếu không điều trị, các biến chứng liên quan đến khớp, tim và hệ thần kinh có thể xảy ra. Nhưng những triệu chứng n', n.when_to_see = 'Hầu hết những người mắc bệnh Lyme đều không nhớ mình đã bị bọ ve cắn. Và nhiều triệu chứng của bệnh Lyme liên quan đến các tình trạng khác. Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu b';
MERGE (n:Disease {id: 'D1792'}) SET n.id = 'D1792', n.name = 'Hệ bạch huyết', n.name_en = 'Lymph system', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002247.htm', n.overview = 'Bạch huyết là một chất lỏng trong suốt đến trắng được tạo thành từ: Tế bào bạch cầu, đặc biệt là tế bào lympho, các tế bào tấn công vi khuẩn trong máu và các mô cơ thể Chất lỏng từ ruột gọi là dưỡng t';
MERGE (n:Disease {id: 'D1793'}) SET n.id = 'D1793', n.name = 'Viêm bạch huyết', n.name_en = 'Lymphadenitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001301.htm', n.prognosis = 'Điều trị kịp thời bằng kháng sinh thường giúp bệnh nhân hồi phục hoàn toàn. Có thể mất vài tuần, thậm chí vài tháng để vết sưng biến mất.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn hoặc đến phòng cấp cứu nếu bạn có các triệu chứng viêm hạch.';
MERGE (n:Disease {id: 'D1794'}) SET n.id = 'D1794', n.name = 'Tắc nghẽn bạch huyết', n.name_en = 'Lymphatic obstruction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001117.htm', n.prognosis = 'Phù bạch huyết là một tình trạng mãn tính thường cần phải điều trị suốt đời. Trong một số trường hợp, phù bạch huyết cải thiện theo thời gian. Một số vết sưng thường là vĩnh viễn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị sưng tay, chân hoặc hạch bạch huyết không đáp ứng với điều trị hoặc biến mất.';
MERGE (n:Disease {id: 'D1795'}) SET n.id = 'D1795', n.name = 'Phù bạch huyết', n.name_en = 'Lymphedema', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/lymphedema/symptoms-causes/syc-20374682', n.overview = 'đề cập đến tình trạng sưng mô do sự tích tụ chất lỏng giàu protein thường thoát ra qua hệ thống bạch huyết của cơ thể. Nó thường ảnh hưởng nhất đến cánh tay hoặc chân, nhưng cũng có thể xảy ra ở thành', n.when_to_see = 'Hãy hẹn gặp bác sĩ nếu bạn nhận thấy sưng tấy dai dẳng ở cánh tay hoặc chân. Nếu bạn đã được chẩn đoán mắc bệnh phù bạch huyết, hãy đến gặp bác sĩ nếu kích thước của chi bị ảnh hưởng tăng đột ngột. Yê';
MERGE (n:Disease {id: 'D1796'}) SET n.id = 'D1796', n.name = 'Ung thư hạch bạch huyết', n.name_en = 'Lymphogranuloma venereum', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000634.htm', n.prognosis = 'Với việc điều trị, triển vọng sẽ tốt và có thể phục hồi hoàn toàn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn đã tiếp xúc với người có thể mắc STI, bao gồm cả LGV Bạn phát triển các triệu chứng của LGV';
MERGE (n:Disease {id: 'D1797'}) SET n.id = 'D1797', n.name = 'Ung thư hạch', n.name_en = 'Lymphoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/lymphoma/symptoms-causes/syc-20352638', n.overview = 'Ung thư hạch là gì? Một chuyên gia giải thích Tìm hiểu thêm từ bác sĩ huyết học Stephen Ansell, M.D. Hiển thị bản ghi video Ung thư hạch là gì? Một chuyên gia giải thích Xin chào. Tôi là Tiến sĩ Steph', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin được đ';
MERGE (n:Disease {id: 'D1798'}) SET n.id = 'D1798', n.name = 'Hội chứng Lynch', n.name_en = 'Lynch syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/lynch-syndrome/symptoms-causes/syc-20374714', n.overview = 'là một tình trạng di truyền làm tăng nguy cơ mắc nhiều loại ung thư, đặc biệt là ung thư ruột kết và ung thư nội mạc tử cung. Đó là một tình trạng di truyền, có nghĩa là nó được truyền qua các gia đìn', n.when_to_see = 'Nếu một thành viên trong gia đình bạn mắc hội chứng Lynch, hãy nói với chuyên gia chăm sóc sức khỏe của bạn. Yêu cầu gặp một chuyên gia về di truyền, chẳng hạn như một cố vấn di truyền. Người đó có th';
MERGE (n:Disease {id: 'D1799'}) SET n.id = 'D1799', n.name = 'Bệnh macroamylasemia', n.name_en = 'Macroamylasemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001216.htm';
MERGE (n:Disease {id: 'D1800'}) SET n.id = 'D1800', n.name = 'Macroglossia', n.name_en = 'Macroglossia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002250.htm', n.overview = 'thường được gây ra bởi sự gia tăng số lượng mô ở lưỡi chứ không phải do sự phát triển, chẳng hạn như khối u. Tình trạng này có thể gặp trong một số rối loạn di truyền hoặc bẩm sinh (tồn tại khi mới si';
MERGE (n:Disease {id: 'D1801'}) SET n.id = 'D1801', n.name = 'Đại thực bào', n.name_en = 'Macrophage', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002374.htm', n.overview = 'không di chuyển qua máu. Thay vào đó, chúng vẫn ở một bộ phận của cơ thể. Đại thực bào được tìm thấy trong nhiều cơ quan và mô, bao gồm: Não Mô vú Gan Phổi Hạch bạch huyết Nhau thai Lá lách Tonsils Đạ';
MERGE (n:Disease {id: 'D1802'}) SET n.id = 'D1802', n.name = 'Thiếu magiê', n.name_en = 'Magnesium deficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000315.htm', n.prognosis = 'Kết quả phụ thuộc vào tình trạng gây ra vấn đề và mức độ nghiêm trọng của tình trạng thiếu magie.', n.when_to_see = 'Khi mức magiê trong cơ thể bạn giảm quá nhiều, đó có thể là một trường hợp khẩn cấp đe dọa tính mạng. Liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn có các triệu chứng của tình trạng này.';
MERGE (n:Disease {id: 'D1803'}) SET n.id = 'D1803', n.name = 'Trầm cảm nặng', n.name_en = 'Major depression', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000945.htm', n.prognosis = 'Bạn có thể bắt đầu cảm thấy tốt hơn vài tuần sau khi bắt đầu điều trị. Nếu dùng thuốc, bạn sẽ phải dùng thuốc trong vài tháng để cảm thấy dễ chịu và ngăn ngừa trầm cảm quay trở lại. Nếu chứng trầm cảm', n.when_to_see = 'Nếu bạn đang nghĩ đến việc làm tổn thương bản thân hoặc người khác, hãy gọi hoặc nhắn tin tới 988 hoặc trò chuyện 988lifeline.org. Bạn cũng có thể gọi 1-800-273-8255 (1-800-273-TALK). Đường dây nóng t';
MERGE (n:Disease {id: 'D1804'}) SET n.id = 'D1804', n.name = 'Trầm cảm nặng có đặc điểm loạn thần', n.name_en = 'Major depression with psychotic features', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000933.htm', n.prognosis = 'Đây là một tình trạng nghiêm trọng. Bạn sẽ cần được điều trị ngay lập tức và được nhà cung cấp theo dõi chặt chẽ. Bạn có thể phải dùng thuốc trong thời gian dài để ngăn chặn tình trạng trầm cảm quay t', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp của bạn nếu: Bạn nghe thấy những giọng nói không có ở đó. Bạn thường xuyên khóc mà không có lý do hoặc rất ít. Chứng trầm cảm của bạn đang làm gián đoạn công việc, tr';
MERGE (n:Disease {id: 'D1805'}) SET n.id = 'D1805', n.name = 'Khả năng hấp thu kém', n.name_en = 'Malabsorption', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000299.htm', n.prognosis = 'Triển vọng phụ thuộc vào nguyên nhân gây ra tình trạng kém hấp thu.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có triệu chứng kém hấp thu.';
MERGE (n:Disease {id: 'D1806'}) SET n.id = 'D1806', n.name = 'Khó chịu', n.name_en = 'Malaise', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003089.htm', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Bạn có các triệu chứng khác kèm theo tình trạng khó chịu Tình trạng khó chịu kéo dài hơn một tuần, có hoặc không có các triệu chứng khác';
MERGE (n:Disease {id: 'D1807'}) SET n.id = 'D1807', n.name = 'Sốt rét', n.name_en = 'Malaria', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/malaria/symptoms-causes/syc-20351184 | https://medlineplus.gov/ency/article/000621.htm', n.overview = 'là bệnh do ký sinh trùng gây ra. Ký sinh trùng lây lan sang người qua vết cắn của muỗi bị nhiễm bệnh. Những người mắc bệnh sốt rét thường cảm thấy rất mệt mỏi với sốt cao và ớn lạnh. Trong khi căn bện', n.prognosis = 'Kết quả dự kiến ​​sẽ tốt ở hầu hết các trường hợp sốt rét được điều trị, nhưng lại kém ở trường hợp nhiễm falciparum có biến chứng.', n.when_to_see = 'Hãy nói chuyện với bác sĩ nếu bạn bị sốt khi sống trong hoặc sau khi đi du lịch đến vùng có nguy cơ sốt rét cao. Nếu bạn có các triệu chứng nghiêm trọng, hãy tìm kiếm sự chăm sóc y tế khẩn cấp.';
MERGE (n:Disease {id: 'D1808'}) SET n.id = 'D1808', n.name = 'Ngộ độc malathion', n.name_en = 'Malathion poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002834.htm', n.prognosis = 'Những người tiếp tục cải thiện trong 4 đến 6 giờ đầu sau khi được điều trị y tế thường hồi phục. Điều trị kéo dài thường là cần thiết để đảo ngược tình trạng ngộ độc. Điều này có thể bao gồm việc ở lạ';
MERGE (n:Disease {id: 'D1809'}) SET n.id = 'D1809', n.name = 'Suy sinh dục nam', n.name_en = 'Male hypogonadism', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/male-hypogonadism/symptoms-causes/syc-20354881 | https://medlineplus.gov/ency/article/000395.htm', n.overview = 'là tình trạng cơ thể không sản xuất đủ hormone testosterone hoặc đủ tinh trùng hoặc cả hai. Testosterone đóng vai trò quan trọng trong sự tăng trưởng và trưởng thành của nam giới ở tuổi dậy thì. Mọi n', n.prognosis = 'Nhiều dạng suy sinh dục nam không thể đảo ngược được. TRT có thể giúp đảo ngược các triệu chứng, mặc dù nó có thể không phục hồi được khả năng sinh sản. Những người đàn ông đang hóa trị liệu có thể gâ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng suy sinh dục. Ngoài ra, hãy liên hệ với nhà cung cấp của bạn nếu bạn đang sử dụng TRT và bạn cho rằng mình đang gặp phải các tác';
MERGE (n:Disease {id: 'D1810'}) SET n.id = 'D1810', n.name = 'Vô sinh nam', n.name_en = 'Male infertility', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/male-infertility/symptoms-causes/syc-20374773', n.overview = 'Gần 1 trong 7 cặp vợ chồng bị vô sinh, điều đó có nghĩa là họ không thể thụ thai mặc dù họ đã quan hệ tình dục thường xuyên và không được bảo vệ trong một năm hoặc lâu hơn. Ở một nửa số cặp vợ chồng n', n.when_to_see = 'Hãy gặp bác sĩ nếu bạn không thể thụ thai sau một năm giao hợp thường xuyên, không được bảo vệ hoặc sớm hơn nếu bạn có bất kỳ vấn đề nào sau đây: Vấn đề cương cứng hoặc xuất tinh, ham muốn tình dục th';
MERGE (n:Disease {id: 'D1811'}) SET n.id = 'D1811', n.name = 'Chứng hói đầu ở nam giới', n.name_en = 'Male pattern baldness', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001177.htm', n.prognosis = 'Chứng hói đầu ở nam giới không phải là dấu hiệu của chứng rối loạn y tế nhưng nó có thể ảnh hưởng đến lòng tự trọng hoặc gây lo lắng. Rụng tóc thường là vĩnh viễn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Tình trạng rụng tóc của bạn xảy ra theo kiểu không điển hình, bao gồm rụng tóc nhanh, rụng nhiều, rụng tóc từng mảng hoặc gãy tóc. R';
MERGE (n:Disease {id: 'D1812'}) SET n.id = 'D1812', n.name = 'Tăng huyết áp ác tính', n.name_en = 'Malignant hypertension', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000491.htm', n.prognosis = 'Nhiều hệ thống cơ thể có nguy cơ nghiêm trọng do huyết áp tăng cao. Các cơ quan bao gồm não, mắt, mạch máu, tim và thận có thể bị tổn thương. Các mạch máu của thận rất dễ bị tổn thương do huyết áp cao', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi đến số cấp cứu tại địa phương (chẳng hạn như 911) nếu bạn có các triệu chứng tăng huyết áp ác tính. Đây là một tình trạng khẩn cấp có thể đe dọa tính mạng. Liên hệ với n';
MERGE (n:Disease {id: 'D1813'}) SET n.id = 'D1813', n.name = 'Tăng thân nhiệt ác tính', n.name_en = 'Malignant hyperthermia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/malignant-hyperthermia/symptoms-causes/syc-20353750 | https://medlineplus.gov/ency/article/001315.htm', n.overview = 'là một phản ứng nghiêm trọng đối với một số loại thuốc dùng để gây mê. Phản ứng nghiêm trọng này thường bao gồm nhiệt độ cơ thể cao đến mức nguy hiểm, cơ bắp cứng hoặc co thắt, nhịp tim nhanh và các t', n.prognosis = 'Các đợt bệnh lặp đi lặp lại hoặc không được điều trị có thể gây suy thận. Các đợt không được điều trị có thể gây tử vong.', n.when_to_see = 'Nếu bạn cần phẫu thuật, hãy báo cho cả bác sĩ phẫu thuật và bác sĩ gây mê trước khi phẫu thuật nếu: Bạn biết rằng bạn hoặc một thành viên trong gia đình bạn gặp vấn đề với gây mê toàn thân Bạn biết mì';
MERGE (n:Disease {id: 'D1814'}) SET n.id = 'D1814', n.name = 'Ung thư trung biểu mô ác tính', n.name_en = 'Malignant mesothelioma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000115.htm', n.prognosis = 'Thời gian tồn tại rất khác nhau từ vài tháng đến vài năm. Triển vọng phụ thuộc vào: Vị trí của ung thư trung biểu mô Loại tế bào của ung thư trung biểu mô Giai đoạn của khối u Tuổi của người đó và sức', n.when_to_see = 'Hãy hẹn gặp nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của ung thư trung biểu mô ác tính.';
MERGE (n:Disease {id: 'D1815'}) SET n.id = 'D1815', n.name = 'Viêm tai ngoài ác tính', n.name_en = 'Malignant otitis externa', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000672.htm', n.prognosis = 'Viêm tai ngoài ác tính thường đáp ứng tốt nhất với điều trị lâu dài, đặc biệt nếu được điều trị sớm. Nó có thể trở lại trong tương lai. Trường hợp nặng có thể gây tử vong.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn xuất hiện các triệu chứng của bệnh viêm tai ngoài ác tính. Các triệu chứng vẫn tiếp tục mặc dù điều trị. Bạn phát triển các triệu chứng mới. Hãy đ';
MERGE (n:Disease {id: 'D1816'}) SET n.id = 'D1816', n.name = 'Các khối u bao thần kinh ngoại biên ác tính (MPNST)', n.name_en = 'Malignant peripheral nerve sheath tumors (MPNST)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/malignant-peripheral-nerve-sheath-tumors/symptoms-causes/syc-20362603', n.overview = 'Các khối u bao thần kinh ngoại biên ác tính là những bệnh ung thư hiếm gặp bắt đầu từ lớp niêm mạc của dây thần kinh. Những bệnh ung thư này xảy ra ở các dây thần kinh chạy từ tủy sống vào cơ thể, đượ', n.when_to_see = 'Hãy hẹn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng liên tục khiến bạn lo lắng. Các khối u vỏ thần kinh ngoại biên ác tính rất hiếm gặp, do đó, trước tiên, bác sĩ có ';
MERGE (n:Disease {id: 'D1817'}) SET n.id = 'D1817', n.name = 'U quái ác tính của trung thất', n.name_en = 'Malignant teratoma of the mediastinum', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001316.htm', n.prognosis = 'Tiên lượng phụ thuộc vào: Kích thước và vị trí của khối u Tuổi của người bệnh Ung thư có di căn sang các cơ quan khác hay không', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của u quái ác tính.';
MERGE (n:Disease {id: 'D1818'}) SET n.id = 'D1818', n.name = 'Nước mắt Mallory-Weiss', n.name_en = 'Mallory-Weiss tear', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000269.htm', n.prognosis = 'Chảy máu nhiều lần là hiếm gặp và kết quả thường tốt. Xơ gan và các vấn đề về đông máu làm cho các đợt chảy máu trong tương lai dễ xảy ra hơn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bắt đầu nôn ra máu hoặc nếu bạn đi tiêu ra máu.';
MERGE (n:Disease {id: 'D1819'}) SET n.id = 'D1819', n.name = 'Suy dinh dưỡng', n.name_en = 'Malnutrition', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000404.htm', n.prognosis = 'Triển vọng phụ thuộc vào nguyên nhân gây ra tình trạng suy dinh dưỡng. Hầu hết sự thiếu hụt dinh dưỡng có thể được khắc phục. Tuy nhiên, nếu suy dinh dưỡng là do bệnh lý gây ra thì bệnh đó phải được đ', n.when_to_see = 'Nói chuyện với nhà cung cấp của bạn về nguy cơ suy dinh dưỡng. Việc điều trị là cần thiết nếu bạn hoặc con bạn có bất kỳ thay đổi nào về khả năng hoạt động của cơ thể. Liên hệ với nhà cung cấp của bạn';
MERGE (n:Disease {id: 'D1820'}) SET n.id = 'D1820', n.name = 'Sai khớp cắn của răng', n.name_en = 'Malocclusion of teeth', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001058.htm', n.prognosis = 'Các vấn đề về chỉnh răng sẽ dễ dàng hơn, nhanh hơn và ít tốn kém hơn khi được điều trị sớm. Việc điều trị có hiệu quả tốt nhất ở trẻ em và thanh thiếu niên vì xương của chúng vẫn còn mềm và răng di ch', n.when_to_see = 'Hãy gọi cho nha sĩ nếu đau răng, đau miệng hoặc các triệu chứng mới khác phát triển trong quá trình điều trị chỉnh nha.';
MERGE (n:Disease {id: 'D1821'}) SET n.id = 'D1821', n.name = 'Giãn ống dẫn sữa', n.name_en = 'Mammary duct ectasia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mammary-duct-ectasia/symptoms-causes/syc-20374801', n.overview = '(ek-TAY-zhuh) là một tình trạng vú không phải ung thư, ảnh hưởng đến các ống dẫn sữa, được gọi là ống dẫn sữa. Nó xảy ra khi một hoặc nhiều ống dẫn sữa bên dưới núm vú của bạn mở rộng, dày lên và chứa', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn nhận thấy những thay đổi ở ngực không biến mất hoặc khiến bạn lo lắng. Một số điều cần chú ý là có khối u mới ở vú, núm vú tiết dịch đột ngột, ';
MERGE (n:Disease {id: 'D1822'}) SET n.id = 'D1822', n.name = 'Chụp quang tuyến vú - vôi hóa', n.name_en = 'Mammogram - calcifications', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002113.htm', n.overview = 'Canxi bạn ăn hoặc uống dưới dạng thuốc không gây vôi hóa ở ngực. Hầu hết các vết vôi hóa không phải là dấu hiệu của bệnh ung thư. Các nguyên nhân có thể bao gồm: Canxi lắng đọng trong các động mạch bê';
MERGE (n:Disease {id: 'D1823'}) SET n.id = 'D1823', n.name = 'U lympho tế bào vỏ', n.name_en = 'Mantle cell lymphoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mantle-cell-lymphoma/symptoms-causes/syc-20584872', n.overview = 'là một loại ung thư hạch. Ung thư hạch là bệnh ung thư ảnh hưởng đến hệ bạch huyết. Hệ bạch huyết được tạo thành từ các cơ quan, tuyến, mạch dạng ống và cụm tế bào gọi là hạch bạch huyết. Nó là một ph', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1824'}) SET n.id = 'D1824', n.name = 'Bệnh nước tiểu xi-rô phong', n.name_en = 'Maple syrup urine disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000373.htm', n.prognosis = 'Căn bệnh này có thể nguy hiểm đến tính mạng nếu không được điều trị. Ngay cả khi điều trị bằng chế độ ăn kiêng, những tình huống căng thẳng và bệnh tật vẫn có thể gây ra lượng axit amin nhất định cao.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có tiền sử gia đình mắc MSUD và đang có ý định lập gia đình. Đồng thời, hãy liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu trẻ sơ sinh của bạn có các tr';
MERGE (n:Disease {id: 'D1825'}) SET n.id = 'D1825', n.name = 'Hội chứng Marfan', n.name_en = 'Marfan syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/marfan-syndrome/symptoms-causes/syc-20350782 | https://medlineplus.gov/ency/article/000418.htm', n.overview = 'là một rối loạn di truyền ảnh hưởng đến mô liên kết - các sợi hỗ trợ và neo giữ các cơ quan cũng như các cấu trúc khác trong cơ thể bạn. Hội chứng Marfan thường ảnh hưởng nhất đến tim, mắt, mạch máu v', n.prognosis = 'Các biến chứng liên quan đến tim có thể rút ngắn tuổi thọ của những người mắc bệnh này. Tuy nhiên, nhiều người sống ở độ tuổi 60 trở lên. Chăm sóc tốt và phẫu thuật có thể kéo dài tuổi thọ hơn nữa.', n.when_to_see = 'Nếu bạn nghĩ rằng bạn hoặc con bạn có thể mắc hội chứng Marfan, hãy nói chuyện với bác sĩ hoặc bác sĩ nhi khoa. Nếu bác sĩ nghi ngờ có vấn đề, bạn có thể sẽ được giới thiệu đến bác sĩ chuyên khoa để đ';
MERGE (n:Disease {id: 'D1826'}) SET n.id = 'D1826', n.name = 'Ung thư hạch vùng cận biên', n.name_en = 'Marginal zone lymphoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/marginal-zone-lymphoma/symptoms-causes/syc-20586112', n.overview = '(MZL) là một loại ung thư hạch. Ung thư hạch là bệnh ung thư ảnh hưởng đến hệ bạch huyết. Hệ bạch huyết được tạo thành từ các cơ quan, tuyến, mạch dạng ống và cụm tế bào gọi là hạch bạch huyết. Nó là ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1827'}) SET n.id = 'D1827', n.name = 'Ngộ độc cần sa', n.name_en = 'Marijuana intoxication', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000952.htm', n.prognosis = 'Ngộ độc cần sa không biến chứng hiếm khi cần tư vấn hoặc điều trị y tế. Các cơn lo âu tái phát có thể xảy ra và cần dùng thuốc hoặc phương pháp điều trị liên tục khác. Đôi khi, các triệu chứng nghiêm ', n.when_to_see = 'Nếu ai đó đang sử dụng cần sa phát triển bất kỳ triệu chứng nhiễm độc nào, khó thở hoặc không thể tỉnh dậy, hãy gọi 911 hoặc số khẩn cấp tại địa phương. Nếu người đó đã ngừng thở hoặc không có mạch, h';
MERGE (n:Disease {id: 'D1828'}) SET n.id = 'D1828', n.name = 'Vết đốt hoặc vết cắn của động vật biển', n.name_en = 'Marine animal stings or bites', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000032.htm', n.when_to_see = 'Tìm kiếm trợ giúp y tế (gọi 911 hoặc số cấp cứu tại địa phương) nếu người đó khó thở, đau ngực, buồn nôn, nôn hoặc chảy máu không kiểm soát; nếu vết đốt bị sưng tấy hoặc đổi màu hoặc có các triệu chứn';
MERGE (n:Disease {id: 'D1829'}) SET n.id = 'D1829', n.name = 'Phẫu thuật cắt bỏ vú', n.name_en = 'Mastectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002919.htm', n.overview = 'Trước khi phẫu thuật bắt đầu, bạn sẽ được gây mê toàn thân. Điều này có nghĩa là bạn sẽ ngủ và không bị đau trong quá trình phẫu thuật. Có nhiều loại thủ thuật khác nhau. Bác sĩ phẫu thuật của bạn thự', n.prognosis = 'Hầu hết phụ nữ đều hồi phục tốt sau phẫu thuật cắt bỏ vú. Ngoài phẫu thuật, bạn có thể cần các phương pháp điều trị ung thư vú khác. Nếu liệu pháp hormone hoặc hóa trị được chỉ định, bạn sẽ gặp bác sĩ';
MERGE (n:Disease {id: 'D1830'}) SET n.id = 'D1830', n.name = 'Viêm vú', n.name_en = 'Mastitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mastitis/symptoms-causes/syc-20374829', n.overview = 'gây đỏ, sưng và đau ở một hoặc cả hai vú. Vết đỏ có thể khó nhìn thấy hơn trên da Đen hoặc nâu. Viêm vú là tình trạng sưng và tấy đỏ, gọi là viêm, ở mô vú. Nó đôi khi liên quan đến nhiễm trùng. Ngoài ', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe nếu bạn có các triệu chứng ở vú khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin được đán';
MERGE (n:Disease {id: 'D1831'}) SET n.id = 'D1831', n.name = 'Phẫu thuật cắt bỏ xương chũm', n.name_en = 'Mastoidectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003016.htm', n.overview = 'Phẫu thuật này từng là phương pháp phổ biến để điều trị nhiễm trùng ở các tế bào khí ở xương chũm. Trong hầu hết các trường hợp, tình trạng này là do nhiễm trùng tai lan đến xương trong hộp sọ. Phẫu t', n.prognosis = 'Phẫu thuật cắt bỏ xương chũm loại bỏ thành công tình trạng nhiễm trùng ở xương chũm ở hầu hết mọi người.';
MERGE (n:Disease {id: 'D1832'}) SET n.id = 'D1832', n.name = 'Viêm xương chũm', n.name_en = 'Mastoiditis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001034.htm', n.prognosis = 'Viêm xương chũm có thể chữa được. Tuy nhiên, bệnh có thể khó điều trị và có thể tái phát.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của bệnh viêm xương chũm. Đồng thời gọi nếu: Bạn bị nhiễm trùng tai không đáp ứng với điều trị hoặc kèm theo c';
MERGE (n:Disease {id: 'D1833'}) SET n.id = 'D1833', n.name = 'Rối loạn toán học', n.name_en = 'Mathematics disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001534.htm', n.prognosis = 'Can thiệp sớm sẽ cải thiện cơ hội đạt được kết quả tốt hơn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ lo ngại nào về sự phát triển của con bạn.';
MERGE (n:Disease {id: 'D1834'}) SET n.id = 'D1834', n.name = 'Thiếu MCAD', n.name_en = 'MCAD deficiency', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mcad-deficiency/symptoms-causes/syc-20353745', n.overview = 'Acyl-coenzym chuỗi trung bình Thiếu hụt dehydrogenase (MCAD) là một rối loạn di truyền khiến cơ thể bạn không thể phân hủy một số chất béo nhất định và biến chúng thành năng lượng. Sự trao đổi chất củ', n.when_to_see = 'Tại Hoa Kỳ và nhiều quốc gia khác, các chương trình sàng lọc trẻ sơ sinh kiểm tra tình trạng thiếu MCAD. Sau lần đánh giá đầu tiên, bạn có thể được giới thiệu đến một chuyên gia đánh giá và điều trị t';
MERGE (n:Disease {id: 'D1835'}) SET n.id = 'D1835', n.name = 'Hội chứng McCune-Albright', n.name_en = 'McCune-Albright syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001217.htm', n.prognosis = 'Lifespan is relatively normal.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn bắt đầu dậy thì sớm hoặc có các triệu chứng khác của hội chứng McCune-Albright. Tư vấn di truyền, và có thể cả xét nghiệm di ';
MERGE (n:Disease {id: 'D1836'}) SET n.id = 'D1836', n.name = 'Sởi', n.name_en = 'Measles', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/measles/symptoms-causes/syc-20374857 | https://medlineplus.gov/ency/article/001569.htm', n.overview = ', còn được gọi là rubeola, từng là một căn bệnh phổ biến ở trẻ em. Nguyên nhân là do một loại vi-rút lây lan dễ dàng qua không khí và bám trên các bề mặt. Vắc-xin có thể ngăn ngừa nhiễm sởi. Hầu hết m', n.prognosis = 'Những trẻ không bị biến chứng như viêm phổi thì có kết quả rất tốt.', n.when_to_see = 'Hãy gọi cho chuyên gia chăm sóc sức khỏe của bạn nếu bạn cho rằng bạn hoặc con bạn có thể đã mắc bệnh sởi. Cũng hãy gọi nếu bạn hoặc con bạn bị phát ban giống như bệnh sởi. Kiểm tra hồ sơ tiêm chủng c';
MERGE (n:Disease {id: 'D1837'}) SET n.id = 'D1837', n.name = 'Hẹp thịt', n.name_en = 'Meatal stenosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001599.htm', n.prognosis = 'Hầu hết mọi người sẽ đi tiểu bình thường sau khi điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu con bạn có các triệu chứng của chứng rối loạn này.';
MERGE (n:Disease {id: 'D1838'}) SET n.id = 'D1838', n.name = 'Máy thở cơ học - trẻ sơ sinh', n.name_en = 'Mechanical ventilator - infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007240.htm', n.overview = 'TẠI SAO SỬ DỤNG MÁY THỞ CƠ? Máy thở được sử dụng để hỗ trợ hô hấp cho trẻ sơ sinh bị bệnh hoặc sinh non. Trẻ bị bệnh hoặc sinh non thường không thể tự thở được. Họ có thể cần sự trợ giúp từ máy thở để';
MERGE (n:Disease {id: 'D1839'}) SET n.id = 'D1839', n.name = 'Phẫu thuật cắt túi thừa Meckel', n.name_en = 'Meckel diverticulectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002929.htm', n.overview = 'Bạn sẽ được gây mê toàn thân trước khi phẫu thuật. Điều này sẽ khiến bạn ngủ và không thể cảm thấy đau. Nếu bạn phẫu thuật mở: Bác sĩ phẫu thuật sẽ thực hiện một vết phẫu thuật lớn ở bụng của bạn để m', n.prognosis = 'Nhiều người thực hiện phẫu thuật này có kết quả tốt. Nhưng kết quả của bất kỳ cuộc phẫu thuật nào đều phụ thuộc vào sức khỏe tổng thể của bạn. Nói chuyện với bác sĩ phẫu thuật của bạn về kết quả mong ';
MERGE (n:Disease {id: 'D1840'}) SET n.id = 'D1840', n.name = 'Túi thừa Meckel', n.name_en = 'Meckel diverticulum', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000234.htm', n.prognosis = 'Hầu hết mọi người đều hồi phục hoàn toàn sau phẫu thuật và sẽ không gặp vấn đề gì tái phát. Các biến chứng do phẫu thuật cũng khó xảy ra.', n.when_to_see = 'Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn ngay lập tức nếu con bạn đi tiêu ra máu hoặc phân có máu hoặc liên tục bị đau bụng.';
MERGE (n:Disease {id: 'D1841'}) SET n.id = 'D1841', n.name = 'Quá liều meclofenamate', n.name_en = 'Meclofenamate overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002671.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng meclofenamate đã nuốt và tốc độ điều trị được tiếp nhận như thế nào. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Quá liều meclofenamate nhẹ thư';
MERGE (n:Disease {id: 'D1842'}) SET n.id = 'D1842', n.name = 'Hội chứng hít phân su', n.name_en = 'Meconium aspiration syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001596.htm', n.prognosis = 'Trong hầu hết các trường hợp chất lỏng có vết phân su, kết quả rất tốt và không có ảnh hưởng lâu dài đến sức khỏe. Chỉ có khoảng 5% trẻ sơ sinh có chất lỏng dính phân su sẽ mắc MAS. Trẻ sơ sinh có thể';
MERGE (n:Disease {id: 'D1843'}) SET n.id = 'D1843', n.name = 'Viêm mỏm lồi cầu trong - khuỷu tay của người chơi golf', n.name_en = 'Medial epicondylitis - golfer\'s elbow', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007638.htm', n.prognosis = 'Đau khuỷu tay thường thuyên giảm mà không cần phẫu thuật. Tuy nhiên, hầu hết những người phẫu thuật đều có thể sử dụng toàn bộ cẳng tay và khuỷu tay sau đó.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn để đặt lịch hẹn nếu: Đây là lần đầu tiên bạn gặp những triệu chứng này. Điều trị tại nhà không làm giảm các triệu chứng. Các triệu chứng trở nên trầm trọng hơn hoặ';
MERGE (n:Disease {id: 'D1844'}) SET n.id = 'D1844', n.name = 'Hội chứng dây chằng vòng cung giữa (MALS)', n.name_en = 'Median arcuate ligament syndrome (MALS)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/median-arcuate-ligament-syndrome-mals/symptoms-causes/syc-20505001', n.overview = 'Hội chứng dây chằng vòng cung giữa, còn gọi là MALS, xảy ra khi dải mô ở vùng bụng trên đè lên động mạch đưa máu đến dạ dày, lá lách và gan. Mô này được gọi là dây chằng vòng cung giữa. Động mạch được', n.when_to_see = 'Có rất nhiều nguyên nhân gây đau dạ dày khác nhau. Nếu cơn đau dạ dày của bạn vẫn tiếp tục mặc dù đã chăm sóc tại nhà, hãy gọi cho chuyên gia chăm sóc sức khỏe của bạn. Bạn cần khám sức khỏe toàn diện';
MERGE (n:Disease {id: 'D1845'}) SET n.id = 'D1845', n.name = 'Khối u trung thất', n.name_en = 'Mediastinal tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001086.htm', n.prognosis = 'Kết quả phụ thuộc vào loại khối u. Các khối u khác nhau phản ứng khác nhau với hóa trị và xạ trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy các triệu chứng của khối u trung thất.';
MERGE (n:Disease {id: 'D1846'}) SET n.id = 'D1846', n.name = 'Viêm trung thất', n.name_en = 'Mediastinitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000081.htm', n.prognosis = 'Tình trạng của một người tốt như thế nào tùy thuộc vào nguyên nhân và mức độ nghiêm trọng của bệnh viêm trung thất. Viêm trung thất sau phẫu thuật ngực rất nghiêm trọng. Có nguy cơ tử vong vì tình trạ', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn đã phẫu thuật ngực hở và phát triển: Đau ngực Ớn lạnh Chảy nước từ vết thương Sốt Khó thở Nếu bạn bị nhiễm trùng phổi hoặc sarcoidosis và phát triển bấ';
MERGE (n:Disease {id: 'D1847'}) SET n.id = 'D1847', n.name = 'Đau đầu do lạm dụng thuốc', n.name_en = 'Medication overuse headaches', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/medication-overuse-headache/symptoms-causes/syc-20377083', n.overview = 'là kết quả của việc sử dụng lâu dài các loại thuốc cần thiết để điều trị chứng đau đầu như chứng đau nửa đầu. Thỉnh thoảng dùng thuốc giảm đau để giảm đau đầu cũng không sao. Nhưng những người dùng th', n.when_to_see = 'Việc bị đau đầu là điều bình thường. Nhưng hãy đau đầu một cách nghiêm túc. Một số loại đau đầu có thể đe dọa tính mạng. Tìm kiếm sự chăm sóc y tế ngay lập tức nếu cơn đau đầu của bạn: Đột ngột và rất';
MERGE (n:Disease {id: 'D1848'}) SET n.id = 'D1848', n.name = 'U nguyên bào tủy', n.name_en = 'Medulloblastoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/medulloblastoma/symptoms-causes/syc-20579268', n.overview = '(muh-dul-o-blas-TOE-muh) là một loại ung thư, còn gọi là khối u não ác tính, bắt đầu ở phần sau và phần dưới của não. Phần não này được gọi là tiểu não. Tiểu não giúp kiểm soát sự cân bằng, chuyển độn', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn có các triệu chứng khiến bạn lo lắng, đặc biệt là những cơn đau đầu liên tục, nôn mửa nhiều lần hoặc các vấn đề mới về thăng bằng ';
MERGE (n:Disease {id: 'D1849'}) SET n.id = 'D1849', n.name = 'Viêm Meibomian', n.name_en = 'Meibomianitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001621.htm', n.prognosis = 'Viêm Meibomian không phải là tình trạng đe dọa thị lực. Tuy nhiên, nó có thể là nguyên nhân lâu dài (mãn tính) và tái phát gây kích ứng mắt. Nhiều người thấy khó chịu khi điều trị vì kết quả thường kh', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu việc điều trị không cải thiện hoặc nếu mụn lẹo phát triển.';
MERGE (n:Disease {id: 'D1850'}) SET n.id = 'D1850', n.name = 'Khối u ác tính', n.name_en = 'Melanoma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/melanoma/symptoms-causes/syc-20374884 | https://medlineplus.gov/ency/article/000850.htm', n.overview = 'es. Tế bào hắc tố là những tế bào tạo ra sắc tố tạo nên màu sắc cho da. Sắc tố đó được gọi là melanin. Hình minh họa này cho thấy các tế bào u ác tính kéo dài từ bề mặt da đến các lớp da sâu hơn. Khối', n.prognosis = 'Bạn làm tốt như thế nào phụ thuộc vào nhiều thứ, bao gồm cả việc ung thư được chẩn đoán sớm như thế nào và nó đã lan rộng bao xa. Ở giai đoạn đầu, hầu hết các khối u ác tính có thể được chữa khỏi bằng', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn nhận thấy bất kỳ thay đổi nào về da khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét';
MERGE (n:Disease {id: 'D1851'}) SET n.id = 'D1851', n.name = 'Nám', n.name_en = 'Melasma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000836.htm', n.prognosis = 'Nám da thường mờ dần sau vài tháng sau khi bạn ngừng dùng thuốc nội tiết tố hoặc kết thúc thai kỳ. Vấn đề có thể quay trở lại trong những lần mang thai sau hoặc nếu bạn sử dụng lại các loại thuốc này.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu khuôn mặt bạn bị sạm đen mà không biến mất.';
MERGE (n:Disease {id: 'D1852'}) SET n.id = 'D1852', n.name = 'Viêm cầu thận màng tăng sinh', n.name_en = 'Membranoproliferative glomerulonephritis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000475.htm', n.prognosis = 'Tình trạng bệnh thường nặng dần dần và cuối cùng dẫn đến suy thận mãn tính. Một nửa số người mắc bệnh này sẽ bị suy thận lâu dài (mãn tính) trong vòng 10 năm. Điều này có nhiều khả năng xảy ra ở những', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có các triệu chứng của tình trạng này Các triệu chứng của bạn trở nên tồi tệ hơn hoặc không biến mất Bạn xuất hiện các triệu chứng mới, bao gồm cả';
MERGE (n:Disease {id: 'D1853'}) SET n.id = 'D1853', n.name = 'Bệnh thận màng', n.name_en = 'Membranous nephropathy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000472.htm', n.prognosis = 'Triển vọng khác nhau, tùy thuộc vào lượng protein bị mất đi. Có thể có những giai đoạn không có triệu chứng và thỉnh thoảng bùng phát. Đôi khi, tình trạng này sẽ biến mất dù có hoặc không có liệu pháp', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có các triệu chứng của bệnh thận màng Các triệu chứng của bạn trở nên tồi tệ hơn hoặc không biến mất Bạn xuất hiện các triệu chứng mới Bạn đã giảm lượ';
MERGE (n:Disease {id: 'D1854'}) SET n.id = 'D1854', n.name = 'Mất trí nhớ', n.name_en = 'Memory loss', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003257.htm';
MERGE (n:Disease {id: 'D1855'}) SET n.id = 'D1855', n.name = 'Bệnh Meniere', n.name_en = 'Meniere disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000702.htm', n.prognosis = 'Bệnh Ménière thường có thể được kiểm soát bằng điều trị. Hoặc, tình trạng có thể tự tốt hơn. Trong một số trường hợp, bệnh Ménière có thể là bệnh mãn tính (dài hạn) hoặc gây tàn tật.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh Ménière hoặc nếu các triệu chứng trở nên tồi tệ hơn. Chúng bao gồm mất thính giác, ù tai hoặc chóng mặt.';
MERGE (n:Disease {id: 'D1856'}) SET n.id = 'D1856', n.name = 'U màng não', n.name_en = 'Meningioma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/meningioma/symptoms-causes/syc-20355643', n.overview = 'Màng não và tủy sống. Lớp bên trong mỏng manh là chất liệu pia. Lớp giữa là màng nhện, một cấu trúc giống như mạng chứa đầy chất lỏng làm đệm cho não. Lớp cứng bên ngoài được gọi là mater dura. U màng', n.when_to_see = 'Hầu hết các triệu chứng của u màng não phát triển chậm, nhưng đôi khi khối u cần được chăm sóc ngay lập tức. Thông thường, u màng não không gây ra bất kỳ triệu chứng nào mà bạn nhận thấy và chỉ được t';
MERGE (n:Disease {id: 'D1857'}) SET n.id = 'D1857', n.name = 'Viêm màng não', n.name_en = 'Meningitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/meningitis/symptoms-causes/syc-20350508 | https://medlineplus.gov/ency/article/000680.htm', n.overview = 'là tình trạng nhiễm trùng và sưng tấy, gọi là viêm, ở chất lỏng và màng xung quanh não và tủy sống. Những màng này được gọi là màng não. Tình trạng viêm do viêm màng não thường gây ra các triệu chứng ', n.prognosis = 'Chẩn đoán và điều trị sớm bệnh viêm màng não do vi khuẩn là điều cần thiết để ngăn ngừa tổn thương thần kinh vĩnh viễn. Viêm màng não do virus thường không nghiêm trọng và các triệu chứng sẽ biến mất ', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn hoặc ai đó trong gia đình bạn có các triệu chứng viêm màng não như: Sốt. Đau đầu dữ dội mà không biến mất. Lú lẫn. Nôn mửa. Cổ cứng. Viêm màng não do';
MERGE (n:Disease {id: 'D1858'}) SET n.id = 'D1858', n.name = 'Viêm màng não - cryptococcal', n.name_en = 'Meningitis - cryptococcal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000642.htm', n.prognosis = 'Những người khỏi bệnh viêm màng não do cryptococcus cần dùng thuốc lâu dài để ngăn ngừa nhiễm trùng quay trở lại. Những người có hệ thống miễn dịch yếu, chẳng hạn như những người nhiễm HIV/AIDS, cũng ', n.when_to_see = 'Hãy gọi 911 hoặc số khẩn cấp tại địa phương nếu bạn phát triển bất kỳ triệu chứng nghiêm trọng nào được liệt kê ở trên. Viêm màng não có thể nhanh chóng trở thành một căn bệnh đe dọa tính mạng. Gọi số';
MERGE (n:Disease {id: 'D1859'}) SET n.id = 'D1859', n.name = 'Viêm màng não - lao', n.name_en = 'Meningitis - tuberculous', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000650.htm', n.prognosis = 'Viêm màng não lao đe dọa tính mạng nếu không được điều trị. Cần theo dõi lâu dài để phát hiện nhiễm trùng tái phát.', n.when_to_see = 'Hãy gọi 911 hoặc số cấp cứu tại địa phương hoặc đến phòng cấp cứu nếu bạn nghi ngờ trẻ nhỏ bị viêm màng não có các triệu chứng sau: Vấn đề về ăn uống Khóc the thé Khó chịu Sốt dai dẳng không rõ nguyên';
MERGE (n:Disease {id: 'D1860'}) SET n.id = 'D1860', n.name = 'Sửa chữa thoát vị màng não', n.name_en = 'Meningocele repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003020.htm', n.overview = 'Thoát vị màng não gây ra một khối u bất thường ở lưng dưới. Có hai loại màng não: hở (thiếu da) và đóng (lớp da còn nguyên vẹn). Thông thường có các bộ phận của tủy sống hoặc dây thần kinh bên trong k', n.prognosis = 'Con bạn khỏe mạnh như thế nào tùy thuộc vào tình trạng ban đầu của tủy sống và dây thần kinh của chúng. Sau khi phẫu thuật thoát vị màng não, trẻ thường hồi phục rất tốt và không gặp thêm vấn đề gì về';
MERGE (n:Disease {id: 'D1861'}) SET n.id = 'D1861', n.name = 'Vắc-xin viêm màng não mô cầu ACWY - những điều bạn cần biết', n.name_en = 'Meningococcal ACWY vaccine - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007602.htm', n.overview = 'Tại sao phải tiêm phòng? Vắc xin viêm màng não mô cầu ACWY có thể giúp bảo vệ chống lại bệnh viêm màng não cầu khuẩn do các nhóm huyết thanh A, C, W và Y gây ra. Hiện có một loại vắc xin ngừa viêm màn';
MERGE (n:Disease {id: 'D1862'}) SET n.id = 'D1862', n.name = 'Vắc-xin não mô cầu B - những điều bạn cần biết', n.name_en = 'Meningococcal B vaccine - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007659.htm', n.overview = 'Tại sao phải tiêm phòng? Vắc-xin viêm màng não mô cầu B có thể giúp bảo vệ chống lại bệnh viêm màng não cầu khuẩn do nhóm huyết thanh B gây ra. Hiện có một loại vắc-xin ngừa viêm màng não cầu khuẩn kh';
MERGE (n:Disease {id: 'D1863'}) SET n.id = 'D1863', n.name = 'Viêm màng não do não mô cầu', n.name_en = 'Meningococcal meningitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000608.htm', n.prognosis = 'Điều trị sớm sẽ cải thiện kết quả. Cái chết là có thể. Trẻ nhỏ và người lớn trên 50 tuổi có nguy cơ tử vong cao nhất.', n.when_to_see = 'Hãy gọi 911 hoặc số điện thoại khẩn cấp tại địa phương hoặc đến phòng cấp cứu nếu bạn nghi ngờ trẻ nhỏ bị viêm màng não có các triệu chứng sau: Khó ăn Khóc the thé Khó chịu Sốt dai dẳng không rõ nguyê';
MERGE (n:Disease {id: 'D1864'}) SET n.id = 'D1864', n.name = 'Meningococcemia', n.name_en = 'Meningococcemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001349.htm', n.prognosis = 'Điều trị sớm mang lại kết quả tốt. Khi cú sốc phát triển, kết quả sẽ ít chắc chắn hơn. Tình trạng này đe dọa tính mạng nhất ở những người phát triển: Rối loạn chảy máu nghiêm trọng được gọi là rối loạ', n.when_to_see = 'Hãy đến phòng cấp cứu ngay nếu bạn có triệu chứng của bệnh viêm màng não mô cầu. Liên hệ với nhà cung cấp của bạn nếu bạn đã ở gần người mắc bệnh.';
MERGE (n:Disease {id: 'D1865'}) SET n.id = 'D1865', n.name = 'Ghép sụn chêm cùng loài', n.name_en = 'Meniscal allograft transplantation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007209.htm', n.overview = 'Nếu bác sĩ phẫu thuật nhận thấy bạn là ứng cử viên sáng giá cho việc ghép sụn chêm, thì chụp X-quang hoặc MRI đầu gối của bạn thường được thực hiện để xác định kích thước đầu gối của bạn để tìm ra sụn', n.prognosis = 'Ghép sụn dị sinh là một ca phẫu thuật khó và khả năng hồi phục rất khó. Nhưng đối với những người bị mất sụn chêm và bị đau thì phương pháp này có thể rất thành công. Hầu hết mọi người đều bớt đau đầu';
MERGE (n:Disease {id: 'D1866'}) SET n.id = 'D1866', n.name = 'Bệnh Menkes', n.name_en = 'Menkes disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001160.htm', n.prognosis = 'Hầu hết trẻ em mắc bệnh này đều chết trong vài năm đầu đời.', n.when_to_see = 'Hãy nói chuyện với nhà cung cấp dịch vụ của bạn nếu bạn có tiền sử gia đình mắc hội chứng Menkes và bạn dự định có con. Trẻ mắc bệnh này thường sẽ xuất hiện các triệu chứng sớm khi còn nhỏ.';
MERGE (n:Disease {id: 'D1867'}) SET n.id = 'D1867', n.name = 'Thời kỳ mãn kinh', n.name_en = 'Menopause', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/menopause/symptoms-causes/syc-20353397 | https://medlineplus.gov/ency/article/000894.htm', n.overview = 'là khi kinh nguyệt ngừng hẳn. Nó được chẩn đoán sau 12 tháng mà không có kinh nguyệt, chảy máu âm đạo hoặc ra đốm. Thời kỳ mãn kinh có thể xảy ra ở độ tuổi 40 hoặc 50. Nhưng độ tuổi trung bình ở Hoa K', n.when_to_see = 'Hãy liên tục gặp chuyên gia chăm sóc sức khỏe của bạn để được thăm khám sức khỏe và các mối quan tâm về y tế trước, trong và sau thời kỳ mãn kinh. Hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn càng';
MERGE (n:Disease {id: 'D1868'}) SET n.id = 'D1868', n.name = 'Đau bụng kinh', n.name_en = 'Menstrual cramps', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/menstrual-cramps/symptoms-causes/syc-20374938', n.overview = '(đau bụng kinh) là những cơn đau nhói hoặc chuột rút ở vùng bụng dưới. Nhiều phụ nữ bị đau bụng kinh ngay trước và trong kỳ kinh nguyệt. Đối với một số phụ nữ, cảm giác khó chịu chỉ đơn thuần là khó c', n.when_to_see = 'Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Đau bụng kinh làm gián đoạn cuộc sống của bạn mỗi tháng Các triệu chứng của bạn ngày càng trầm trọng hơn Bạn mới bắt đầu bị đau bụng kin';
MERGE (n:Disease {id: 'D1869'}) SET n.id = 'D1869', n.name = 'Bệnh tâm thần', n.name_en = 'Mental illness', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mental-illness/symptoms-causes/syc-20374968', n.overview = ', còn được gọi là rối loạn sức khỏe tâm thần, đề cập đến một loạt các tình trạng sức khỏe tâm thần — các rối loạn ảnh hưởng đến tâm trạng, suy nghĩ và hành vi của bạn. Ví dụ về bệnh tâm thần bao gồm t', n.when_to_see = 'Nếu bạn có bất kỳ dấu hiệu hoặc triệu chứng nào của bệnh tâm thần, hãy đến gặp nhà cung cấp dịch vụ chăm sóc chính hoặc chuyên gia sức khỏe tâm thần. Hầu hết các bệnh tâm thần không tự khỏi và nếu khô';
MERGE (n:Disease {id: 'D1870'}) SET n.id = 'D1870', n.name = 'Ngộ độc tinh dầu bạc hà', n.name_en = 'Menthol poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002673.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng tinh dầu bạc hà được nuốt vào và thời gian điều trị được tiếp nhận nhanh như thế nào. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải nhữ';
MERGE (n:Disease {id: 'D1871'}) SET n.id = 'D1871', n.name = 'Quá liều meperidine hydrochloride', n.name_en = 'Meperidine hydrochloride overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002676.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào lượng meperidine họ đã dùng và tốc độ điều trị của họ. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nếu có thể dùng thuốc giải độc, quá trì';
MERGE (n:Disease {id: 'D1872'}) SET n.id = 'D1872', n.name = 'Quá liều meprobamate', n.name_en = 'Meprobamate overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002677.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào lượng meprobamate nuốt vào và tốc độ điều trị được tiếp nhận như thế nào. Sự trợ giúp y tế càng sớm thì cơ hội phục hồi càng cao. Với sự chăm sóc thích ';
MERGE (n:Disease {id: 'D1873'}) SET n.id = 'D1873', n.name = 'Meralgia paresthetica', n.name_en = 'Meralgia paresthetica', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/meralgia-paresthetica/symptoms-causes/syc-20355635', n.overview = 'gây ngứa ran, tê và đau rát ở phần ngoài của đùi. Tình trạng này xảy ra do dây thần kinh bì đùi ngoài bị chèn ép, dây thần kinh này cung cấp cảm giác cho cẳng chân. Meralgia paresthetica là tình trạng';
MERGE (n:Disease {id: 'D1874'}) SET n.id = 'D1874', n.name = 'Ngộ độc merbromin', n.name_en = 'Merbromin poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002897.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng merbromin được nuốt vào và tốc độ điều trị được tiếp nhận như thế nào. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nếu người đó dùng thuốc giải';
MERGE (n:Disease {id: 'D1875'}) SET n.id = 'D1875', n.name = 'Ngộ độc thủy ngân clorua', n.name_en = 'Mercuric chloride poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002474.htm', n.prognosis = 'Điều này chất rất độc. Tình trạng sức khỏe của người đó phụ thuộc vào lượng chất độc nuốt vào, những triệu chứng nào xảy ra trong vòng 10 đến 15 phút đầu tiên sau khi nuốt phải và tốc độ điều trị được';
MERGE (n:Disease {id: 'D1876'}) SET n.id = 'D1876', n.name = 'Ngộ độc thủy ngân oxit', n.name_en = 'Mercuric oxide poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002475.htm', n.prognosis = 'Chất này rất độc. Sức khoẻ của một người phụ thuộc vào lượng chất độc được nuốt vào, những triệu chứng nào xảy ra trong vòng 10 đến 15 phút đầu tiên sau khi nuốt phải và tốc độ điều trị được tiếp nhận';
MERGE (n:Disease {id: 'D1877'}) SET n.id = 'D1877', n.name = 'Ngộ độc thủy ngân', n.name_en = 'Mercury poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002476.htm', n.prognosis = 'lâu dài Hít phải một lượng nhỏ thủy ngân nguyên tố sẽ gây ra rất ít tác dụng phụ lâu dài, nếu có. Tuy nhiên, hít thở với số lượng lớn hơn có thể dẫn đến thời gian nằm viện lâu dài. Có khả năng tổn thư';
MERGE (n:Disease {id: 'D1878'}) SET n.id = 'D1878', n.name = 'Ung thư biểu mô tế bào Merkel', n.name_en = 'Merkel cell carcinoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/merkel-cell-carcinoma/symptoms-causes/syc-20351030', n.overview = 'của bệnh ung thư da. Nó thường xuất hiện dưới dạng vết sưng trên mặt, tai hoặc cổ. Ung thư biểu mô tế bào Merkel là một loại ung thư da hiếm gặp. Nó thường xuất hiện dưới dạng vết sưng trên mặt, đầu h', n.when_to_see = 'Đặt lịch hẹn với chuyên gia chăm sóc sức khỏe nếu bạn có nốt ruồi, tàn nhang hoặc vết sưng thay đổi kích thước, hình dạng hoặc màu sắc. Ngoài ra, hãy đến gặp chuyên gia chăm sóc sức khỏe nếu vết sưng ';
MERGE (n:Disease {id: 'D1879'}) SET n.id = 'D1879', n.name = 'Ngộ độc Merthiolate', n.name_en = 'Merthiolate poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002678.htm', n.prognosis = 'Ngộ độc Merthiolate rất khó điều trị. Sức khoẻ của một người phụ thuộc vào lượng chất độc được nuốt vào và tốc độ điều trị được tiếp nhận như thế nào. Một người nhận được trợ giúp y tế càng nhanh thì ';
MERGE (n:Disease {id: 'D1880'}) SET n.id = 'D1880', n.name = 'Thiếu máu cục bộ động mạch mạc treo', n.name_en = 'Mesenteric artery ischemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001156.htm', n.prognosis = 'Triển vọng của bệnh thiếu máu cục bộ mạc treo mãn tính là tốt sau khi phẫu thuật thành công. Tuy nhiên, điều quan trọng là phải thay đổi lối sống để ngăn ngừa tình trạng xơ cứng động mạch trở nên trầm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có: Thay đổi thói quen đại tiện Sốt Buồn nôn Đau bụng dữ dội Nôn mửa Chảy máu từ trực tràng Đau bụng thường xuyên sau khi ăn';
MERGE (n:Disease {id: 'D1881'}) SET n.id = 'D1881', n.name = 'Thiếu máu cục bộ mạc treo', n.name_en = 'Mesenteric ischemia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mesenteric-ischemia/symptoms-causes/syc-20374989', n.overview = 'Tuần hoàn động mạch mạc treo điển hình và thiếu máu cục bộ mạc treo ic Tuần hoàn động mạch và thiếu máu mạc treo Trong thiếu máu mạc treo ruột, tắc nghẽn trong động mạch sẽ cắt đứt lưu lượng máu đến m', n.when_to_see = 'Nếu bạn bị đau bụng dữ dội, đột ngột kéo dài, hãy tìm kiếm sự chăm sóc y tế khẩn cấp. Nếu bạn bị đau sau khi ăn, hãy hẹn gặp ai đó trong nhóm chăm sóc sức khỏe chính của bạn. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1882'}) SET n.id = 'D1882', n.name = 'Viêm hạch mạc treo', n.name_en = 'Mesenteric lymphadenitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mesenteric-lymphadenitis/symptoms-causes/syc-20353799', n.overview = 'Mạc treo bám vào thành xung quanh vùng dạ dày và giữ nó cố định. Viêm hạch mạc treo là tình trạng sưng hạch bạch huyết ở mạc treo. Viêm hạch bạch huyết là tình trạng các cụm tế bào nhỏ hình tròn hoặc ', n.when_to_see = 'Đau vùng bụng thường gặp ở trẻ em và thanh thiếu niên. Vì vậy, thật khó để biết khi nào cần tìm tư vấn y tế. Hãy gọi ngay cho chuyên gia chăm sóc sức khỏe nếu trẻ bị: Đau đột ngột, dữ dội ở vùng dạ dà';
MERGE (n:Disease {id: 'D1883'}) SET n.id = 'D1883', n.name = 'Huyết khối tĩnh mạch mạc treo', n.name_en = 'Mesenteric venous thrombosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001157.htm', n.prognosis = 'Triển vọng phụ thuộc vào nguyên nhân gây huyết khối và bất kỳ tổn thương nào ở ruột. Việc điều trị nguyên nhân trước khi ruột chết có thể giúp bệnh nhân hồi phục tốt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị đau bụng dữ dội hoặc lặp đi lặp lại.';
MERGE (n:Disease {id: 'D1884'}) SET n.id = 'D1884', n.name = 'U trung biểu mô', n.name_en = 'Mesothelioma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/mesothelioma/symptoms-causes/syc-20375022', n.overview = 'là một loại ung thư bắt đầu từ sự phát triển của các tế bào trong trung biểu mô. Trung biểu mô là một lớp mô mỏng bao phủ nhiều cơ quan nội tạng. U trung biểu mô được phát âm là me-zoe-thee-lee-O-muh.', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
';
MERGE (n:Disease {id: 'D1885'}) SET n.id = 'D1885', n.name = 'Nhiễm toan chuyển hóa', n.name_en = 'Metabolic acidosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000335.htm', n.prognosis = 'Nhiễm toan chuyển hóa có thể nguy hiểm nếu không được điều trị. Nhiều trường hợp đáp ứng tốt với điều trị. Triển vọng sẽ phụ thuộc vào căn bệnh tiềm ẩn gây ra tình trạng này.', n.when_to_see = 'Hãy tìm kiếm sự trợ giúp y tế nếu bạn có các triệu chứng của bất kỳ bệnh nào có thể gây nhiễm toan chuyển hóa.';
MERGE (n:Disease {id: 'D1886'}) SET n.id = 'D1886', n.name = 'Bệnh thần kinh chuyển hóa', n.name_en = 'Metabolic neuropathies', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001161.htm', n.prognosis = 'Triển vọng chủ yếu phụ thuộc vào nguyên nhân gây ra rối loạn. Trong một số trường hợp, vấn đề có thể được giải quyết dễ dàng. Trong những trường hợp khác, vấn đề trao đổi chất không thể được kiểm soát';
MERGE (n:Disease {id: 'D1887'}) SET n.id = 'D1887', n.name = 'Hội chứng chuyển hóa', n.name_en = 'Metabolic syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/metabolic-syndrome/symptoms-causes/syc-20351916 | https://medlineplus.gov/ency/article/007290.htm', n.overview = 'là một nhóm các tình trạng làm tăng nguy cơ mắc bệnh tim, đột quỵ và tiểu đường tuýp 2. Những tình trạng này bao gồm huyết áp cao, lượng đường trong máu cao, quá nhiều mỡ quanh eo và mức cholesterol h', n.prognosis = 'Những người mắc hội chứng chuyển hóa có nguy cơ mắc bệnh tim, tiểu đường loại 2, đột quỵ, bệnh thận và lượng máu cung cấp đến chân kém về lâu dài.', n.when_to_see = 'Nếu bạn mắc ít nhất một tình trạng hội chứng chuyển hóa, chẳng hạn như huyết áp cao, hãy hỏi chuyên gia chăm sóc sức khỏe của bạn về việc xét nghiệm các tình trạng khác là một phần của hội chứng. Từ M';
MERGE (n:Disease {id: 'D1888'}) SET n.id = 'D1888', n.name = 'Bệnh loạn dưỡng bạch cầu dị sắc', n.name_en = 'Metachromatic leukodystrophy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/metachromatic-leukodystrophy/symptoms-causes/syc-20354733 | https://medlineplus.gov/ency/article/001205.htm', n.overview = 'là một rối loạn di truyền (di truyền) hiếm gặp khiến các chất béo (lipid) tích tụ trong tế bào, đặc biệt là ở não, tủy sống và dây thần kinh ngoại biên. Sự tích tụ này là do thiếu hụt một loại enzyme ', n.prognosis = 'MLD là một căn bệnh nghiêm trọng và trở nên nặng hơn theo thời gian. Cuối cùng, con người mất hết cơ bắp và chức năng tinh thần. Tuổi thọ khác nhau, tùy thuộc vào độ tuổi bắt đầu mắc bệnh, nhưng quá t', n.when_to_see = 'Hãy nói chuyện với bác sĩ nếu bạn quan sát thấy bất kỳ dấu hiệu nào được liệt kê ở trên hoặc nếu bạn lo lắng về các dấu hiệu hoặc triệu chứng của chính mình.';
MERGE (n:Disease {id: 'D1889'}) SET n.id = 'D1889', n.name = 'Ngộ độc chất tẩy rửa kim loại', n.name_en = 'Metal cleaner poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002812.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Nuốt phải loại chất độc này có thể gây ảnh hưởng nghiêm trọng đến nhiều bộ phận của cơ thể. Một người nh';
MERGE (n:Disease {id: 'D1890'}) SET n.id = 'D1890', n.name = 'Ngộ độc sơn kim loại', n.name_en = 'Metal polish poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002795.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải những chất độc như ';
MERGE (n:Disease {id: 'D1891'}) SET n.id = 'D1891', n.name = 'Di căn', n.name_en = 'Metastasis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002260.htm', n.overview = 'Tế bào ung thư có lan sang các bộ phận khác của cơ thể hay không phụ thuộc vào nhiều thứ, bao gồm: Loại ung thư Giai đoạn ung thư Vị trí ban đầu của ung thư Cơ chế phòng vệ tự nhiên của cơ thể bạn, ch';
MERGE (n:Disease {id: 'D1892'}) SET n.id = 'D1892', n.name = 'Ung thư tuyến tiền liệt di căn (giai đoạn 4)', n.name_en = 'Metastatic (stage 4) prostate cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/metastatic-prostate-cancer/symptoms-causes/syc-20377966', n.overview = 'Ung thư tuyến tiền liệt di căn là ung thư bắt đầu ở tuyến tiền liệt và lan sang các bộ phận khác của cơ thể. Các thuật ngữ khác cho tình trạng này bao gồm ung thư tuyến tiền liệt tiến triển và ung thư', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Nếu trước đây bạn đã được điều trị ung thư tuyến tiền liệt, hãy nói với chuyên gia chăm s';
MERGE (n:Disease {id: 'D1893'}) SET n.id = 'D1893', n.name = 'Khối u não di căn', n.name_en = 'Metastatic brain tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000769.htm', n.prognosis = 'Đối với nhiều người bị u não di căn, bệnh ung thư là không thể chữa khỏi. Tiên lượng phụ thuộc vào loại khối u và cách nó đáp ứng với điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị đau đầu dai dẳng, tình trạng mới hoặc khác lạ đối với bạn. Hãy gọi cho nhà cung cấp của bạn hoặc đến phòng cấp cứu nếu bạn hoặ';
MERGE (n:Disease {id: 'D1894'}) SET n.id = 'D1894', n.name = 'Ung thư tuyến tiền liệt kháng thiến di căn (mCRPC)', n.name_en = 'Metastatic castration-resistant prostate cancer (mCRPC)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/metastatic-castration-resistant-prostate-cancer/symptoms-causes/syc-20593191', n.overview = 'là ung thư tuyến tiền liệt đã di căn ra khỏi tuyến tiền liệt và không còn đáp ứng với các phương pháp điều trị bằng liệu pháp hormone. Liệu pháp hormone điều trị ung thư tuyến tiền liệt, còn được gọi ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D1895'}) SET n.id = 'D1895', n.name = 'Khối u màng phổi di căn', n.name_en = 'Metastatic pleural tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000117.htm', n.prognosis = 'Thời gian tồn tại rất khác nhau từ vài tháng đến vài năm. Triển vọng phụ thuộc vào: Vị trí của khối u màng phổi Loại tế bào của khối u màng phổi Giai đoạn của khối u Tuổi của người đó và sức khỏe tổng';
MERGE (n:Disease {id: 'D1896'}) SET n.id = 'D1896', n.name = 'Đau xương bàn chân', n.name_en = 'Metatarsalgia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/metatarsalgia/symptoms-causes/syc-20354790', n.overview = '(met-uh-tahr-SAL-juh) là tình trạng mà lòng bàn chân trở nên đau đớn và khó chịu. Đau xương bàn chân là kết quả của các hoạt động liên quan đến chạy và nhảy. Các nguyên nhân khác bao gồm bàn chân khôn', n.when_to_see = 'Không phải tất cả các vấn đề về chân đều cần được chăm sóc y tế. Đôi khi chân đau nhức sau một ngày dài đứng hoặc tập luyện nặng. Nhưng tốt nhất nên hành động khi chân bị đau kéo dài hơn vài ngày. Nói';
MERGE (n:Disease {id: 'D1897'}) SET n.id = 'D1897', n.name = 'Metatarsus adductus', n.name_en = 'Metatarsus adductus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001601.htm', n.prognosis = 'Kết quả hầu như luôn xuất sắc. Hầu như tất cả trẻ em đều có một bàn chân hoạt động được.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn lo lắng về hình dáng bên ngoài hoặc tính linh hoạt của bàn chân trẻ sơ sinh.';
MERGE (n:Disease {id: 'D1898'}) SET n.id = 'D1898', n.name = 'Quá liều methadone', n.name_en = 'Methadone overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002679.htm', n.prognosis = 'Khả năng phục hồi của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận như thế nào. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nếu có thể dùng thuốc giả';
MERGE (n:Disease {id: 'D1899'}) SET n.id = 'D1899', n.name = 'Quá liều methamphetamine', n.name_en = 'Methamphetamine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007480.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào lượng thuốc họ đã dùng và tốc độ điều trị của họ. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Chứng rối loạn tâm thần và ';
MERGE (n:Disease {id: 'D1900'}) SET n.id = 'D1900', n.name = 'Ngộ độc metanol', n.name_en = 'Methanol poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002680.htm', n.prognosis = 'Metanol cực độc. Chỉ cần 2 muỗng canh (30 ml) có thể gây tử vong cho trẻ. Khoảng 2 đến 8 ounce (60 đến 240 ml) có thể gây tử vong cho người lớn. Mù là tình trạng phổ biến và thường là vĩnh viễn mặc dù';
MERGE (n:Disease {id: 'D1901'}) SET n.id = 'D1901', n.name = 'Methemoglobinemia', n.name_en = 'Methemoglobinemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000562.htm', n.prognosis = 'Những người mắc bệnh MetHb và hemoglobin M loại 1 thường có kết quả tốt. MetHb loại 2 nghiêm trọng hơn. Nó thường gây tử vong trong vài năm đầu đời. Những người mắc phải MetHb thường có kết quả rất tố', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn: Gia đình có tiền sử mắc bệnh MetHb Có các triệu chứng của chứng rối loạn này Hãy gọi ngay 911 hoặc số cấp cứu tại địa phương nếu bạn bị khó thở ng';
MERGE (n:Disease {id: 'D1902'}) SET n.id = 'D1902', n.name = 'Tụ cầu vàng kháng methicillin (MRSA)', n.name_en = 'Methicillin-resistant Staphylococcus aureus (MRSA)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007261.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào mức độ nghiêm trọng của tình trạng nhiễm trùng và sức khỏe tổng thể của người đó. Viêm phổi và nhiễm trùng máu do MRSA có liên quan đến tỷ lệ tử vong ca', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu vết thương của bạn ngày càng nặng hơn thay vì lành lại.';
MERGE (n:Disease {id: 'D1903'}) SET n.id = 'D1903', n.name = 'Quá liều methyl salicylate', n.name_en = 'Methyl salicylate overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002683.htm', n.prognosis = 'Sức khỏe của một người khỏe mạnh như thế nào tùy thuộc vào lượng salicylate có trong máu và tốc độ điều trị được tiếp nhận như thế nào. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Hầu hế';
MERGE (n:Disease {id: 'D1904'}) SET n.id = 'D1904', n.name = 'Axit methylmalonic trong máu', n.name_en = 'Methylmalonic acidemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001162.htm', n.prognosis = 'Trẻ sơ sinh có thể không qua khỏi khi có triệu chứng đầu tiên của căn bệnh này. Những người sống sót thường gặp vấn đề với sự phát triển của hệ thần kinh, mặc dù sự phát triển nhận thức bình thường vẫ', n.when_to_see = 'Hãy tìm kiếm sự trợ giúp y tế ngay lập tức nếu con bạn lên cơn động kinh lần đầu tiên. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu con bạn có các dấu hiệu: Không phát triển chậm';
MERGE (n:Disease {id: 'D1905'}) SET n.id = 'D1905', n.name = 'Ngộ độc methylmercury', n.name_en = 'Methylmercury poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007763.htm', n.prognosis = 'Các triệu chứng không thể đảo ngược được. Tuy nhiên, chúng thường không trở nên tồi tệ hơn trừ khi có lần tiếp xúc mới với methylmercury hoặc người đó vẫn tiếp xúc với nguồn ban đầu. Phòng ngừa tiếp t';
MERGE (n:Disease {id: 'D1906'}) SET n.id = 'D1906', n.name = 'Rặng Metopic', n.name_en = 'Metopic ridge', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003312.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy một đường gờ dọc theo trán của trẻ sơ sinh hoặc một đường gờ hình thành trên hộp sọ. Nhà cung cấp sẽ thực hiện khám sức';
MERGE (n:Disease {id: 'D1907'}) SET n.id = 'D1907', n.name = 'Bệnh đầu nhỏ', n.name_en = 'Microcephaly', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/microcephaly/symptoms-causes/syc-20375051 | https://medlineplus.gov/ency/article/003272.htm', n.overview = '(my-kroh-SEF-uh-lee) là một tình trạng thần kinh hiếm gặp, trong đó đầu của trẻ sơ sinh nhỏ hơn nhiều so với đầu của những đứa trẻ khác cùng độ tuổi và giới tính. Đôi khi được phát hiện khi mới sinh, ', n.when_to_see = 'Thông thường, bệnh đầu nhỏ được chẩn đoán khi sinh hoặc trong các lần khám sức khỏe định kỳ cho trẻ. Nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu bạn cho rằng kích thước đầu c';
