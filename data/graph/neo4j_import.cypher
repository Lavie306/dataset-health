MERGE (n:Disease {id: 'D0603'}) SET n.id = 'D0603', n.name = 'Nghẹt thở - trẻ sơ sinh dưới 1 tuổi', n.name_en = 'Choking - infant under 1 year', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000048.htm', n.when_to_see = 'Nếu trẻ sơ sinh bị nghẹn: Hãy nhờ ai đó gọi 911 hoặc số khẩn cấp tại địa phương trong khi bạn bắt đầu sơ cứu. Nếu bạn ở một mình, hãy kêu cứu và bắt đầu sơ cứu. Luôn gọi cho nhà cung cấp dịch vụ chăm ';
MERGE (n:Disease {id: 'D0604'}) SET n.id = 'D0604', n.name = 'Nghẹt thở - người lớn bất tỉnh hoặc trẻ em trên 1 tuổi', n.name_en = 'Choking - unconscious adult or child over 1 year', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000051.htm', n.when_to_see = 'Hãy tìm kiếm sự trợ giúp y tế ngay lập tức nếu ai đó được phát hiện bất tỉnh. Nếu bạn được trợ giúp, hãy yêu cầu một người gọi 911 hoặc số khẩn cấp tại địa phương trong khi người khác bắt đầu hô hấp n';
MERGE (n:Disease {id: 'D0605'}) SET n.id = 'D0605', n.name = 'Ung thư đường mật', n.name_en = 'Cholangiocarcinoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000291.htm', n.prognosis = 'Việc loại bỏ hoàn toàn khối u cho phép một số người sống sót với khả năng khỏi bệnh hoàn toàn. Thời gian sống sót rất khác nhau từ vài tháng đến vài năm. Triển vọng phụ thuộc vào: Vị trí của CCA Loại ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị vàng da hoặc các triệu chứng khác của ung thư đường mật.';
MERGE (n:Disease {id: 'D0606'}) SET n.id = 'D0606', n.name = 'Ung thư đường mật (ung thư ống mật)', n.name_en = 'Cholangiocarcinoma (bile duct cancer)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cholangiocarcinoma/symptoms-causes/syc-20352408', n.overview = 'Túi mật và ống mật có chất lỏng màu xanh gọi là mật. Mật được tạo ra ở gan và chảy vào túi mật. Nó ở lại trong túi mật cho đến khi cần thiết để giúp tiêu hóa thức ăn. Trong khi ăn, túi mật tiết mật và', n.when_to_see = 'Hãy đi khám bác sĩ nếu bạn cảm thấy mệt mỏi kéo dài, đau bụng, vàng da hoặc các dấu hiệu và triệu chứng khác làm phiền bạn. Anh ấy hoặc cô ấy có thể giới thiệu bạn đến một chuyên gia về bệnh tiêu hóa ';
MERGE (n:Disease {id: 'D0607'}) SET n.id = 'D0607', n.name = 'Viêm đường mật', n.name_en = 'Cholangitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000290.htm', n.prognosis = 'Kết quả thường rất tốt khi điều trị nhưng lại kém khi không điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng viêm đường mật.';
MERGE (n:Disease {id: 'D0608'}) SET n.id = 'D0608', n.name = 'Viêm túi mật', n.name_en = 'Cholecystitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cholecystitis/symptoms-causes/syc-20364867', n.overview = 'Túi mật và ống mật chảy ra chất dịch màu xanh lục gọi là mật. Mật được tạo ra ở gan và chảy vào túi mật. Nó ở lại trong túi mật cho đến khi cần thiết để giúp tiêu hóa thức ăn. Trong khi ăn, túi mật ti', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng khiến bạn lo lắng. Nếu cơn đau bụng dữ dội đến mức bạn không thể ngồi yên hoặc cảm thấy thoải mái, hãy nhờ ai đó chở bạn đến';
MERGE (n:Disease {id: 'D0609'}) SET n.id = 'D0609', n.name = 'Sỏi đường mật', n.name_en = 'Choledocholithiasis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000274.htm', n.prognosis = 'Tắc nghẽn và nhiễm trùng do sỏi trong đường mật có thể đe dọa tính mạng. Hầu hết mọi trường hợp, kết quả sẽ tốt nếu vấn đề được phát hiện và điều trị sớm.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị đau bụng, có hoặc không có sốt và không rõ nguyên nhân Bạn bị vàng da Bạn có các triệu chứng khác của bệnh sỏi đường mật';
MERGE (n:Disease {id: 'D0610'}) SET n.id = 'D0610', n.name = 'Bệnh tả', n.name_en = 'Cholera', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/cholera/symptoms-causes/syc-20355287 | https://medlineplus.gov/ency/article/000303.htm', n.overview = 'là một căn bệnh do vi khuẩn gây ra. Thông thường, nó lây lan qua nước bị nhiễm vi khuẩn. Nó cũng có thể lây lan qua thực phẩm bị nhiễm độc. Bệnh tả có thể gây tiêu chảy nghiêm trọng và mất nước. Nếu k', n.prognosis = 'Mất nước nghiêm trọng có thể gây tử vong. Chăm sóc hỗ trợ là rất quan trọng. Hầu hết mọi người sẽ hồi phục hoàn toàn khi được cung cấp đủ chất lỏng.', n.when_to_see = 'Nguy cơ mắc bệnh tả ở các quốc gia phát triển là rất nhỏ. Ngay cả ở những khu vực có dịch bệnh, bạn cũng không có khả năng bị nhiễm bệnh nếu tuân theo các khuyến nghị về an toàn thực phẩm. Tuy nhiên, ';
MERGE (n:Disease {id: 'D0611'}) SET n.id = 'D0611', n.name = 'Ứ mật', n.name_en = 'Cholestasis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000215.htm', n.prognosis = 'Sức khoẻ của một người phụ thuộc vào căn bệnh gây ra tình trạng đó. Sỏi trong ống mật thông thường có thể được loại bỏ. Điều này có thể chữa khỏi chứng ứ mật. Stent có thể được đặt vào các khu vực hở ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có: Ngứa không hết Vàng da hoặc mắt Các triệu chứng khác của ứ mật';
MERGE (n:Disease {id: 'D0612'}) SET n.id = 'D0612', n.name = 'Ứ mật khi mang thai', n.name_en = 'Cholestasis of pregnancy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/cholestasis-of-pregnancy/symptoms-causes/syc-20363257', n.overview = 'Ứ mật trong gan khi mang thai, thường được gọi là ứ mật khi mang thai, là một tình trạng về gan có thể xảy ra vào cuối thai kỳ. Tình trạng này gây ngứa dữ dội nhưng không phát ban. Ngứa thường xảy ra ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc thai kỳ của bạn ngay lập tức nếu bạn bắt đầu cảm thấy ngứa liên tục hoặc cực kỳ ngứa. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu n';
MERGE (n:Disease {id: 'D0613'}) SET n.id = 'D0613', n.name = 'Cholesteatoma', n.name_en = 'Cholesteatoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001050.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu đau tai, chảy dịch từ tai hoặc các triệu chứng khác xảy ra hoặc trầm trọng hơn hoặc nếu xảy ra tình trạng mất thính lực.';
MERGE (n:Disease {id: 'D0614'}) SET n.id = 'D0614', n.name = 'Chondrosarcoma', n.name_en = 'Chondrosarcoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/chondrosarcoma/symptoms-causes/syc-20354196', n.overview = 'là một loại ung thư hiếm gặp thường bắt đầu ở xương, nhưng đôi khi có thể xảy ra ở mô mềm gần xương. Chondrosarcoma xảy ra thường xuyên nhất ở xương chậu, hông và vai. Hiếm gặp hơn, nó có thể xảy ra ở';
MERGE (n:Disease {id: 'D0615'}) SET n.id = 'D0615', n.name = 'Chọn nhà cung cấp dịch vụ chăm sóc chính', n.name_en = 'Choosing a primary care provider', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001939.htm', n.overview = 'PCP là nhà cung cấp dịch vụ chăm sóc sức khỏe chính của bạn trong các tình huống không khẩn cấp. Vai trò của PCP của bạn là: Cung cấp dịch vụ chăm sóc phòng ngừa và dạy các lựa chọn lối sống lành mạnh';
MERGE (n:Disease {id: 'D0616'}) SET n.id = 'D0616', n.name = 'Chordoma', n.name_en = 'Chordoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/chordoma/symptoms-causes/syc-20580258', n.overview = 'là một loại ung thư xương hiếm gặp bắt đầu từ xương cột sống hoặc xương sọ. U hợp âm khác với các khối u xương khác vì những lý do bao gồm nơi chúng phát triển, cách chúng bắt đầu và chúng ảnh hưởng đ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D0617'}) SET n.id = 'D0617', n.name = 'Ung thư biểu mô màng đệm', n.name_en = 'Choriocarcinoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001496.htm', n.prognosis = 'Hầu hết phụ nữ bị ung thư chưa lan rộng đều có thể chữa khỏi và vẫn có thể sinh con. Ung thư biểu mô màng đệm có thể tái phát trong vòng vài tháng đến 3 năm sau khi điều trị. Tình trạng này khó chữa h', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn xuất hiện các triệu chứng trong vòng 1 năm sau khi có nốt ruồi dạng hydatidiform hoặc mang thai.';
MERGE (n:Disease {id: 'D0618'}) SET n.id = 'D0618', n.name = 'Ung thư biểu mô đám rối màng đệm', n.name_en = 'Choroid plexus carcinoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/choroid-plexus-carcinoma/symptoms-causes/syc-20578760', n.overview = 'là một loại ung thư não hiếm gặp, chủ yếu xảy ra ở trẻ em. Ung thư biểu mô đám rối màng mạch bắt đầu khi các tế bào phát triển ở phần não gọi là đám rối màng đệm. Các tế bào trong đám rối màng mạch tạ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu con bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
