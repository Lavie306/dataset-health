MERGE (n:Disease {id: 'D1918'}) SET n.id = 'D1918', n.name = 'Độc tố của cuốn chiếu', n.name_en = 'Millipede toxin', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002846.htm', n.prognosis = 'Hầu hết các triệu chứng thường biến mất trong vòng 24 giờ sau khi tiếp xúc. Sự đổi màu nâu của da có thể tồn tại trong nhiều tháng. Phản ứng nghiêm trọng chủ yếu xảy ra khi tiếp xúc với các loài động ';
