MERGE (n:Disease {id: 'D1351'}) SET n.id = 'D1351', n.name = 'Khám sức khỏe cho phụ nữ từ 18 đến 39 tuổi', n.name_en = 'Health screenings for women ages 18 to 39', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007462.htm', n.overview = 'Ngay cả khi cảm thấy ổn, bạn vẫn nên đến gặp nhà cung cấp dịch vụ của mình để kiểm tra thường xuyên. Những chuyến thăm này có thể giúp bạn tránh được các vấn đề trong tương lai. Ví dụ, cách duy nhất đ';
