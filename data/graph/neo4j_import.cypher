MERGE (n:Disease {id: 'D2812'}) SET n.id = 'D2812', n.name = 'Phân - màu nhạt hoặc màu đất sét', n.name_en = 'Stools - pale or clay-colored', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003129.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu phân của bạn không có màu nâu bình thường trong vài ngày.';
MERGE (n:Disease {id: 'D2813'}) SET n.id = 'D2813', n.name = 'Phân – nổi', n.name_en = 'Stools – floating', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003128.htm', n.when_to_see = 'Hãy cho nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn biết nếu bạn có những thay đổi trong phân hoặc nhu động ruột. Liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn đi ngoài ra máu kèm theo sụt ';
MERGE (n:Disease {id: 'D2814'}) SET n.id = 'D2814', n.name = 'Các chương trình hỗ trợ cai thuốc lá', n.name_en = 'Stop smoking support programs', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007440.htm', n.overview = 'Bạn có thể tìm hiểu về các chương trình cai thuốc lá từ: Nhà cung cấp dịch vụ chăm sóc sức khỏe hoặc bệnh viện địa phương Chương trình bảo hiểm y tế của bạn Chủ lao động của bạn Sở y tế địa phương Đườ';
MERGE (n:Disease {id: 'D2815'}) SET n.id = 'D2815', n.name = 'Vết cắn của cò', n.name_en = 'Stork bite', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001388.htm', n.prognosis = 'Hầu hết các vết cò đốt trên mặt sẽ biến mất hoàn toàn sau khoảng 18 tháng. Cò cắn sau gáy thường không khỏi.', n.when_to_see = 'Nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nên xem xét tất cả các vết bớt trong quá trình khám sức khỏe định kỳ cho trẻ.';
MERGE (n:Disease {id: 'D2816'}) SET n.id = 'D2816', n.name = 'Lác', n.name_en = 'Strabismus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001004.htm', n.prognosis = 'Sau phẫu thuật, mắt có thể nhìn thẳng nhưng vẫn có thể có vấn đề về thị lực. Trẻ có thể vẫn gặp vấn đề về đọc ở trường. Người lớn có thể gặp khó khăn khi lái xe. Suy giảm thị lực có thể ảnh hưởng đến ', n.when_to_see = 'Strabismus cần được đánh giá kịp thời. Liên hệ với nhà cung cấp dịch vụ hoặc bác sĩ nhãn khoa của bạn nếu con bạn: Có vẻ như bị lác mắt Khiếu nại về song thị Gặp khó khăn khi nhìn Lưu ý : Các vấn đề v';
MERGE (n:Disease {id: 'D2817'}) SET n.id = 'D2817', n.name = 'Viêm họng liên cầu khuẩn', n.name_en = 'Strep throat', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/strep-throat/symptoms-causes/syc-20350338 | https://medlineplus.gov/ency/article/000639.htm', n.overview = 'là một bệnh nhiễm trùng do vi khuẩn có thể khiến cổ họng của bạn cảm thấy đau và ngứa ngáy. Viêm họng liên cầu khuẩn chỉ chiếm một phần nhỏ trong bệnh viêm họng. Nếu không được điều trị, viêm họng liê', n.prognosis = 'Các triệu chứng viêm họng liên cầu khuẩn thường thuyên giảm sau khoảng 1 tuần. Nếu không được điều trị, strep có thể dẫn đến các biến chứng nghiêm trọng.', n.when_to_see = 'Hãy gọi cho bác sĩ nếu bạn hoặc con bạn có bất kỳ dấu hiệu và triệu chứng nào sau đây: Đau họng kèm theo sưng hạch bạch huyết Đau họng kéo dài hơn 48 giờ Sốt Đau họng kèm theo phát ban Các vấn đề về h';
MERGE (n:Disease {id: 'D2818'}) SET n.id = 'D2818', n.name = 'Căng thẳng và sức khỏe của bạn', n.name_en = 'Stress and your health', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003211.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn cảm thấy quá căng thẳng hoặc nếu điều đó ảnh hưởng đến sức khỏe của bạn. Đồng thời liên hệ với nhà cung cấp của bạn nếu bạn nhận ';
MERGE (n:Disease {id: 'D2819'}) SET n.id = 'D2819', n.name = 'Gãy xương do căng thẳng', n.name_en = 'Stress fractures', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/stress-fractures/symptoms-causes/syc-20354057', n.overview = 'là những vết nứt nhỏ trong xương. Căng thẳng lặp đi lặp lại đến xương gây ra chúng. Sự căng thẳng thường đến từ việc sử dụng cùng một bộ phận cơ thể quá nhiều. Một số ví dụ bao gồm nhảy lên nhảy xuống', n.when_to_see = 'Hãy gọi cho bác sĩ nếu bạn bị đau liên tục. Nhận trợ giúp càng sớm càng tốt nếu bạn cảm thấy đau ngay cả khi nghỉ ngơi hoặc vào ban đêm. Khi những người bị gãy xương do căng thẳng được điều trị sớm, h';
MERGE (n:Disease {id: 'D2820'}) SET n.id = 'D2820', n.name = 'Căng thẳng thời thơ ấu', n.name_en = 'Stress in childhood', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002059.htm', n.overview = 'Căng thẳng có thể là phản ứng trước những thay đổi tiêu cực trong cuộc sống của trẻ. Với số lượng nhỏ, căng thẳng có thể tốt. Tuy nhiên, căng thẳng quá mức có thể ảnh hưởng đến cách trẻ suy nghĩ, hành';
MERGE (n:Disease {id: 'D2821'}) SET n.id = 'D2821', n.name = 'Căng thẳng không tự chủ', n.name_en = 'Stress incontinence', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/stress-incontinence/symptoms-causes/syc-20355727', n.overview = 'Hệ thống tiết niệu nữ mắt, niệu quản, bàng quang và niệu đạo. Hệ thống tiết niệu loại bỏ chất thải ra khỏi cơ thể qua nước tiểu. Thận nằm về phía sau của bụng trên. Chúng lọc chất thải và chất lỏng từ', n.when_to_see = 'Nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu các triệu chứng làm phiền bạn hoặc cản trở các hoạt động hàng ngày như công việc, sở thích và đời sống xã hội. Yêu cầu một cuộc hẹn Có vấn đề vớ';
MERGE (n:Disease {id: 'D2822'}) SET n.id = 'D2822', n.name = 'Tiểu không tự chủ do gắng sức', n.name_en = 'Stress urinary incontinence', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000891.htm', n.prognosis = 'Để khỏi bệnh cần có thời gian, vì vậy hãy cố gắng kiên nhẫn. Các triệu chứng thường trở nên tốt hơn với các phương pháp điều trị không phẫu thuật. Tuy nhiên, chúng sẽ không chữa khỏi chứng tiểu không ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng tiểu không tự chủ do căng thẳng và chúng làm phiền bạn.';
MERGE (n:Disease {id: 'D2823'}) SET n.id = 'D2823', n.name = 'Vết rạn da', n.name_en = 'Stretch marks', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/stretch-marks/symptoms-causes/syc-20351139 | https://medlineplus.gov/ency/article/003287.htm', n.overview = '(striae) là những vệt lõm xuất hiện ở vùng bụng, ngực, hông, mông hoặc những vị trí khác trên cơ thể. Chúng phổ biến ở phụ nữ mang thai, đặc biệt là trong ba tháng cuối. Vết rạn da không gây đau đớn h', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn lo lắng về vẻ ngoài của làn da hoặc nếu các vết rạn da bao phủ các vùng rộng của cơ thể bạn. Nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn có th';
MERGE (n:Disease {id: 'D2824'}) SET n.id = 'D2824', n.name = 'Hành lang', n.name_en = 'Stridor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003074.htm', n.when_to_see = 'Hành lang có thể là dấu hiệu của trường hợp khẩn cấp. Liên hệ với nhà cung cấp của bạn ngay lập tức nếu có tiếng thở rít không rõ nguyên nhân, đặc biệt là ở trẻ em.';
MERGE (n:Disease {id: 'D2825'}) SET n.id = 'D2825', n.name = 'Đột quỵ', n.name_en = 'Stroke', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/stroke/symptoms-causes/syc-20350113 | https://medlineplus.gov/ency/article/000726.htm', n.overview = 'Đột quỵ là gì? Chuyên gia của Mayo Clinic giải thích Tìm hiểu thêm từ nhà thần kinh học Robert D. Brown, Jr. M.D., M.P.H. Hiển thị bản ghi cho video Đột quỵ là gì? Chuyên gia của Mayo Clinic giải thíc', n.prognosis = 'Sức khoẻ của một người sau cơn đột quỵ phụ thuộc vào: Loại đột quỵ Mức độ tổn thương mô não Chức năng cơ thể bị ảnh hưởng Tốc độ điều trị ra sao Các vấn đề về di chuyển, suy nghĩ và nói chuyện thường ', n.when_to_see = 'Tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn nhận thấy bất kỳ triệu chứng nào của đột quỵ, ngay cả khi chúng dường như đến rồi đi hoặc biến mất hoàn toàn. Hãy suy nghĩ "NHANH CHÓNG" và làm như sau: ';
MERGE (n:Disease {id: 'D2826'}) SET n.id = 'D2826', n.name = 'Bệnh giun lươn', n.name_en = 'Strongyloidiasis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000630.htm', n.prognosis = 'Nếu được điều trị thích hợp, giun có thể bị tiêu diệt và có thể hồi phục hoàn toàn. Đôi khi, việc điều trị cần phải được lặp lại. Nhiễm trùng nặng (hội chứng tăng nhiễm) hoặc đã lan sang nhiều vùng tr', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn để lấy hẹn nếu bạn có các triệu chứng của bệnh giun lươn.';
MERGE (n:Disease {id: 'D2827'}) SET n.id = 'D2827', n.name = 'Nghẹt mũi hoặc sổ mũi - trẻ em', n.name_en = 'Stuffy or runny nose - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003051.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu con bạn có bất kỳ dấu hiệu nào sau đây: Nghẹt mũi kèm sưng trán, mắt, một bên mũi hoặc má hoặc bị mờ thị lực Đau họng nhiều hơn, hoặc';
MERGE (n:Disease {id: 'D2828'}) SET n.id = 'D2828', n.name = 'Nghẹt mũi hoặc chảy nước mũi - người lớn', n.name_en = 'Stuffy or runny nose – adult', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003049.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu có bất kỳ dấu hiệu nào sau đây: Nghẹt mũi kèm sưng trán, mắt, một bên mũi hoặc má hoặc xảy ra kèm theo mờ mắt Đau họng nhiều hơn, hoặc có đốm trắng hoặc và';
MERGE (n:Disease {id: 'D2829'}) SET n.id = 'D2829', n.name = 'Hội chứng Sturge-Weber', n.name_en = 'Sturge-Weber syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001426.htm', n.prognosis = 'SWS thường không đe dọa đến tính mạng. Tình trạng này cần được theo dõi thường xuyên suốt đời. Chất lượng cuộc sống của một người phụ thuộc vào việc các triệu chứng của họ (chẳng hạn như động kinh) có', n.when_to_see = 'Động kinh, các vấn đề về thị lực, tê liệt và những thay đổi về sự tỉnh táo hoặc trạng thái tinh thần có thể có nghĩa là màng não có liên quan. Những triệu chứng này cần được đánh giá ngay lập tức.';
MERGE (n:Disease {id: 'D2830'}) SET n.id = 'D2830', n.name = 'Nói lắp', n.name_en = 'Stuttering', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/stuttering/symptoms-causes/syc-20353572 | https://medlineplus.gov/ency/article/001427.htm', n.overview = 'là tình trạng giọng nói làm gián đoạn luồng lời nói bình thường. Lưu loát có nghĩa là có nhịp điệu và trôi chảy dễ dàng, trôi chảy khi nói. Với tình trạng nói lắp, tình trạng ngắt quãng diễn ra thường', n.prognosis = 'Ở hầu hết trẻ em nói lắp, giai đoạn này sẽ qua đi và khả năng nói sẽ trở lại bình thường trong vòng 3 hoặc 4 năm. Tật nói lắp có nhiều khả năng kéo dài đến tuổi trưởng thành nếu: Tình trạng này kéo dà', n.when_to_see = 'Trẻ em từ 2 đến 5 tuổi thường trải qua giai đoạn nói lắp. Đối với hầu hết trẻ em, đây là một phần của việc học nói và nó sẽ tự trở nên tốt hơn. Nhưng tình trạng nói lắp vẫn tiếp tục có thể cần được đi';
MERGE (n:Disease {id: 'D2831'}) SET n.id = 'D2831', n.name = 'Lẹo mắt (stye)', n.name_en = 'Stye (sty)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sty/symptoms-causes/syc-20378017', n.overview = 'Lẹo lẹo là một khối u đau gần mép mí mắt, có thể trông giống như mụn nhọt hoặc mụn nhọt. Mụn lẹo thường do nhiễm trùng do vi khuẩn và có thể chứa đầy mủ. Lẹo mắt thường hình thành ở bên ngoài mí mắt, ', n.when_to_see = 'Hầu hết lẹo mắt đều vô hại đối với mắt và không ảnh hưởng đến khả năng nhìn rõ. Trước tiên, hãy thử các biện pháp tự chăm sóc, chẳng hạn như đắp khăn ấm lên mí mắt đang nhắm trong 5 đến 10 phút vài lầ';
MERGE (n:Disease {id: 'D2832'}) SET n.id = 'D2832', n.name = 'Thoái hóa kết hợp bán cấp', n.name_en = 'Subacute combined degeneration', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000723.htm', n.prognosis = 'Điều trị sớm sẽ cải thiện cơ hội đạt được kết quả tốt. Tình trạng sức khỏe của một người phụ thuộc vào thời gian họ có các triệu chứng trước khi được điều trị. Nếu điều trị được thực hiện trong vòng v', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu cảm giác bất thường, yếu cơ hoặc các triệu chứng khác của SCD phát triển. Điều này đặc biệt quan trọng nếu bạn hoặc thành viên gia đình bị thiếu máu ác';
MERGE (n:Disease {id: 'D2833'}) SET n.id = 'D2833', n.name = 'Viêm não xơ cứng bán cấp', n.name_en = 'Subacute sclerosing panencephalitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001419.htm', n.prognosis = 'SSPE luôn gây tử vong. Những người mắc bệnh này chết từ 1 đến 3 năm sau khi được chẩn đoán. Một số người có thể sống sót lâu hơn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn chưa hoàn thành các mũi tiêm chủng theo lịch trình. Vắc-xin sởi được bao gồm trong vắc-xin MMR.';
MERGE (n:Disease {id: 'D2834'}) SET n.id = 'D2834', n.name = 'Viêm tuyến giáp bán cấp', n.name_en = 'Subacute thyroiditis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000375.htm', n.prognosis = 'Tình trạng sẽ tự cải thiện. Nhưng bệnh có thể kéo dài hàng tháng. Các biến chứng lâu dài hoặc nghiêm trọng không thường xuyên xảy ra. Tình trạng này không lây nhiễm. Mọi người không thể bắt nó từ bạn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn có các triệu chứng của chứng rối loạn này. Bạn bị viêm tuyến giáp và các triệu chứng không cải thiện khi điều trị.';
MERGE (n:Disease {id: 'D2835'}) SET n.id = 'D2835', n.name = 'Xuất huyết dưới nhện', n.name_en = 'Subarachnoid hemorrhage', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/subarachnoid-hemorrhage/symptoms-causes/syc-20361009 | https://medlineplus.gov/ency/article/000701.htm', n.overview = 'Xuất huyết dưới nhện là tình trạng chảy máu ở khoảng trống giữa não và các mô bao phủ não. Không gian được gọi là không gian dưới nhện. Xuất huyết dưới nhện là một loại đột quỵ. Đây là một trường hợp ', n.prognosis = 'Sức khỏe của một người bị xuất huyết dưới nhện phụ thuộc vào một số yếu tố khác nhau, bao gồm: Vị trí và lượng máu chảy Các biến chứng Tuổi già và các triệu chứng nghiêm trọng hơn có thể dẫn đến kết q', n.when_to_see = 'Xuất huyết dưới nhện là một cấp cứu y tế. Nhận sự chăm sóc y tế ngay lập tức nếu bạn bị đau đầu rất đột ngột, rất nặng hoặc nếu bạn có các triệu chứng khác của xuất huyết dưới nhện. Điều này đặc biệt ';
MERGE (n:Disease {id: 'D2836'}) SET n.id = 'D2836', n.name = 'Áp xe dưới quầng vú', n.name_en = 'Subareolar abscess', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001501.htm', n.prognosis = 'Triển vọng tốt sau khi dẫn lưu ổ áp xe.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn xuất hiện một khối u đau đớn dưới núm vú hoặc quầng vú. Điều rất quan trọng là yêu cầu bác sĩ đánh giá bất kỳ khối u nào ở vú.';
MERGE (n:Disease {id: 'D2837'}) SET n.id = 'D2837', n.name = 'Xuất huyết dưới kết mạc', n.name_en = 'Subconjunctival hemorrhage', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001616.htm', n.prognosis = 'Xuất huyết dưới kết mạc thường tự khỏi sau khoảng 2 đến 3 tuần. Lòng trắng của mắt có thể chuyển sang màu vàng khi vấn đề biến mất.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu có mảng màu đỏ tươi xuất hiện trên lòng trắng của mắt.';
MERGE (n:Disease {id: 'D2838'}) SET n.id = 'D2838', n.name = 'Xuất huyết dưới kết mạc (vỡ mạch máu ở mắt)', n.name_en = 'Subconjunctival hemorrhage (broken blood vessel in eye)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/subconjunctival-hemorrhage/symptoms-causes/syc-20353826', n.overview = 'Xuất huyết dưới kết mạc là tình trạng vỡ một mạch máu nhỏ trong mô bảo vệ che mắt. Mô trong suốt này, được gọi là kết mạc (kun-JUNK-tih-vuh), che phủ lòng trắng của mắt và viền mí mắt. Xuất huyết dưới', n.when_to_see = 'Nếu bạn thường xuyên bị xuất huyết dưới kết mạc hoặc dễ bị bầm tím hoặc chảy máu khác, hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn. Ngoài ra, hãy gặp chuyên gia y tế nếu bạn: Bị thương ở m';
MERGE (n:Disease {id: 'D2839'}) SET n.id = 'D2839', n.name = 'Tràn khí dưới da', n.name_en = 'Subcutaneous emphysema', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003286.htm', n.when_to_see = 'Hầu hết các tình trạng gây ra khí thũng dưới da đều nghiêm trọng và bạn có thể đã được bác sĩ điều trị. Đôi khi cần phải nằm viện. Điều này có nhiều khả năng hơn nếu vấn đề là do nhiễm trùng. Khi được';
MERGE (n:Disease {id: 'D2840'}) SET n.id = 'D2840', n.name = 'Máy khử rung tim cấy ghép dưới da', n.name_en = 'Subcutaneous implantable cardioverter-defibrillator', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007815.htm', n.overview = 'S-ICD được tạo thành từ các bộ phận sau: Máy tạo xung chứa pin và các mạch điện đọc hoạt động điện của tim bạn. Điện cực là một sợi dây, còn được gọi là dây dẫn, được đưa vào dưới da ở giữa ngực dọc t', n.prognosis = 'S-ICD của bạn sẽ liên tục theo dõi nhịp tim của bạn để đảm bảo chúng ổn định. Nó sẽ gây sốc cho tim khi cảm nhận được nhịp điệu đe dọa tính mạng.';
MERGE (n:Disease {id: 'D2841'}) SET n.id = 'D2841', n.name = 'Tràn dịch dưới màng cứng', n.name_en = 'Subdural effusion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001422.htm', n.prognosis = 'Dự kiến ​​sẽ phục hồi hoàn toàn sau tràn dịch dưới màng cứng. Nếu các vấn đề về hệ thần kinh tiếp tục xảy ra, chúng thường là do viêm màng não chứ không phải do tràn dịch. Thuốc kháng sinh dài hạn thư', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Con bạn gần đây đã được điều trị bệnh viêm màng não và các triệu chứng vẫn tiếp tục Xuất hiện các triệu chứng mới';
MERGE (n:Disease {id: 'D2842'}) SET n.id = 'D2842', n.name = 'Máu tụ dưới màng cứng', n.name_en = 'Subdural hematoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000713.htm', n.prognosis = 'Triển vọng phụ thuộc vào loại và vị trí chấn thương đầu, quy mô lượng máu thu thập và thời gian bắt đầu điều trị. Khối máu tụ dưới màng cứng cấp tính có tỷ lệ tử vong và chấn thương não cao. Khối máu ', n.when_to_see = 'Tụ máu dưới màng cứng là một trường hợp cấp cứu y tế. Gọi 911 hoặc số cấp cứu tại địa phương hoặc đến phòng cấp cứu sau khi bị chấn thương ở đầu. Đừng trì hoãn. Chấn thương cột sống thường xảy ra cùng';
MERGE (n:Disease {id: 'D2843'}) SET n.id = 'D2843', n.name = 'Rối loạn sử dụng chất gây nghiện', n.name_en = 'Substance use disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001522.htm', n.prognosis = 'Việc sử dụng chất gây nghiện có thể dẫn đến quá liều gây tử vong. Một số người bắt đầu sử dụng lại các chất này (tái nghiện) sau khi đã ngừng sử dụng. Các biến chứng của việc sử dụng chất gây nghiện b', n.when_to_see = 'Đặt lịch hẹn với nhà cung cấp của bạn nếu bạn hoặc thành viên gia đình đang sử dụng một chất gây nghiện và muốn dừng lại. Đồng thời liên hệ với nhà cung cấp của bạn nếu bạn bị cắt nguồn cung cấp thuốc';
MERGE (n:Disease {id: 'D2844'}) SET n.id = 'D2844', n.name = 'Phục hồi do sử dụng chất gây nghiện và chế độ ăn kiêng', n.name_en = 'Substance use recovery and diet', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002149.htm', n.overview = 'Phục hồi sau khi sử dụng chất gây nghiện cũng ảnh hưởng đến cơ thể theo nhiều cách khác nhau, bao gồm quá trình trao đổi chất (xử lý năng lượng), chức năng của các cơ quan và sức khỏe tinh thần. Tác đ';
MERGE (n:Disease {id: 'D2845'}) SET n.id = 'D2845', n.name = 'Ngừng tim đột ngột', n.name_en = 'Sudden cardiac arrest', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sudden-cardiac-arrest/symptoms-causes/syc-20350634', n.overview = '(SCA) là tình trạng mất đột ngột mọi hoạt động của tim do nhịp tim không đều. Hơi thở dừng lại. Người đó trở nên bất tỉnh. Nếu không được điều trị ngay lập tức, ngừng tim đột ngột có thể dẫn đến tử vo', n.when_to_see = 'Khi tim ngừng đập, việc thiếu máu giàu oxy có thể nhanh chóng gây tử vong hoặc tổn thương não vĩnh viễn. Gọi 911 hoặc dịch vụ y tế khẩn cấp khi có những triệu chứng sau: Đau ngực hoặc khó chịu. Cảm gi';
MERGE (n:Disease {id: 'D2846'}) SET n.id = 'D2846', n.name = 'Hội chứng đột tử ở trẻ sơ sinh', n.name_en = 'Sudden infant death syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001566.htm', n.when_to_see = 'Nếu em bé của bạn không cử động hoặc không thở, hãy bắt đầu hô hấp nhân tạo và gọi 911 hoặc số khẩn cấp tại địa phương. Cha mẹ và người chăm sóc tất cả trẻ sơ sinh và trẻ em nên được đào tạo về CPR.';
MERGE (n:Disease {id: 'D2847'}) SET n.id = 'D2847', n.name = 'Hội chứng đột tử ở trẻ sơ sinh (SIDS)', n.name_en = 'Sudden infant death syndrome (SIDS)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sudden-infant-death-syndrome/symptoms-causes/syc-20352800', n.overview = 'Hội chứng đột tử ở trẻ sơ sinh là cái chết không rõ nguyên nhân của một em bé. Em bé thường chưa đầy một tuổi và có vẻ khỏe mạnh. Nó thường xảy ra trong khi ngủ. Hội chứng đột tử ở trẻ sơ sinh còn đượ';
MERGE (n:Disease {id: 'D2848'}) SET n.id = 'D2848', n.name = 'Tự tử và hành vi tự sát', n.name_en = 'Suicide and suicidal behavior', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001554.htm', n.prognosis = 'Khoảng 10% đến 20% những người đưa ra lời đe dọa hoặc cố gắng tự kết liễu đời mình cuối cùng sẽ tự sát.', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn hoặc ai đó bạn biết đang có ý nghĩ tự tử. Người đó cần được chăm sóc sức khỏe tâm thần ngay lập tức. KHÔNG loại bỏ người đó chỉ vì c';
MERGE (n:Disease {id: 'D2849'}) SET n.id = 'D2849', n.name = 'Tự tử và ý nghĩ tự tử', n.name_en = 'Suicide and suicidal thoughts', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/suicide/symptoms-causes/syc-20378048', n.overview = 'Tự tử, tự kết liễu đời mình, là một phản ứng bi thảm trước những tình huống căng thẳng trong cuộc sống - và còn bi thảm hơn nữa vì có thể ngăn chặn được việc tự tử. Cho dù bạn đang cân nhắc việc tự tử', n.when_to_see = 'Nếu bạn có ý định tự tử, nhưng bạn không ngay lập tức nghĩ đến việc làm tổn thương bản thân: Hãy liên hệ với bạn bè hoặc người thân yêu — ngay cả khi rất khó để nói về cảm xúc của bạn Liên hệ với mục ';
MERGE (n:Disease {id: 'D2850'}) SET n.id = 'D2850', n.name = 'Ngộ độc axit sulfuric', n.name_en = 'Sulfuric acid poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002492.htm', n.prognosis = 'Sức khoẻ của một người phụ thuộc vào tốc độ pha loãng và trung hòa chất độc. Có thể bị tổn thương nặng ở miệng, cổ họng, mắt, phổi, thực quản, mũi và dạ dày. Kết quả cuối cùng phụ thuộc vào mức độ thi';
MERGE (n:Disease {id: 'D2851'}) SET n.id = 'D2851', n.name = 'Quá liều Sulindac', n.name_en = 'Sulindac overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002551.htm', n.prognosis = 'Có thể phục hồi bằng điều trị y tế kịp thời, ngoại trừ trường hợp quá liều rất lớn. Một số người có thể bị tổn thương gan hoặc thận mãn tính.';
MERGE (n:Disease {id: 'D2852'}) SET n.id = 'D2852', n.name = 'Dị ứng ánh nắng', n.name_en = 'Sun allergy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sun-allergy/symptoms-causes/syc-20378077', n.overview = 'là một thuật ngữ rộng. Nó mô tả một số tình trạng gây phát ban ngứa trên da sau khi tiếp xúc với ánh sáng mặt trời hoặc các nguồn bức xạ tia cực tím (UV) khác. Phát ban đa dạng do ánh sáng là dạng dị ', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn có phản ứng da bất thường, khó chịu sau khi ra nắng. Đối với các triệu chứng nghiêm trọng hoặc dai dẳng, bạn có thể cần gặp bác sĩ chuyên chẩn đo';
MERGE (n:Disease {id: 'D2853'}) SET n.id = 'D2853', n.name = 'Cháy nắng', n.name_en = 'Sunburn', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/sunburn/symptoms-causes/syc-20355922 | https://medlineplus.gov/ency/article/003227.htm', n.overview = 'là tình trạng da bị viêm, đau và có cảm giác nóng khi chạm vào. Nó thường xuất hiện trong vòng vài giờ sau khi ở ngoài nắng quá lâu. Bạn có thể giảm cháy nắng bằng các biện pháp tự chăm sóc đơn giản n', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn: Xuất hiện các vết phồng rộp lớn. Xuất hiện mụn nước trên mặt, tay hoặc bộ phận sinh dục. Bị sưng tấy nghiêm trọng ở vùng bị ảnh hưởng. C';
MERGE (n:Disease {id: 'D2854'}) SET n.id = 'D2854', n.name = 'Viêm tĩnh mạch huyết khối bề mặt', n.name_en = 'Superficial thrombophlebitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000199.htm', n.prognosis = 'Đây thường là tình trạng ngắn hạn, không gây biến chứng. Các triệu chứng thường biến mất sau 1 đến 2 tuần. Độ cứng của tĩnh mạch có thể tồn tại lâu hơn nữa.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của tình trạng này. Đồng thời, hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn đã mắc bệnh này và các triệu chứng củ';
MERGE (n:Disease {id: 'D2855'}) SET n.id = 'D2855', n.name = 'Núm vú thừa', n.name_en = 'Supernumerary nipples', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003110.htm', n.when_to_see = 'Hãy trao đổi với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu trẻ sơ sinh có thêm núm vú. Hãy cho nhà cung cấp biết nếu có các triệu chứng khác.';
MERGE (n:Disease {id: 'D2856'}) SET n.id = 'D2856', n.name = 'Liệt mắt trên nhân', n.name_en = 'Supranuclear ophthalmoplegia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001624.htm', n.prognosis = 'Outlook phụ thuộc vào nguyên nhân gây ra chứng liệt cơ trên nhân.';
MERGE (n:Disease {id: 'D2857'}) SET n.id = 'D2857', n.name = 'Nhịp tim nhanh trên thất', n.name_en = 'Supraventricular tachycardia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/supraventricular-tachycardia/symptoms-causes/syc-20355243', n.overview = '(SVT) là một loại nhịp tim không đều, còn được gọi là rối loạn nhịp tim. Đó là nhịp tim rất nhanh hoặc thất thường ảnh hưởng đến các buồng trên của tim. SVT còn được gọi là nhịp tim nhanh kịch phát tr', n.when_to_see = 'Nhịp tim nhanh trên thất (SVT) thường không nguy hiểm đến tính mạng trừ khi bạn bị tổn thương tim hoặc bệnh tim khác. Nhưng nếu SVT nghiêm trọng, nhịp tim không đều có thể khiến mọi hoạt động của tim ';
MERGE (n:Disease {id: 'D2858'}) SET n.id = 'D2858', n.name = 'Phẫu thuật ung thư tuyến tụy', n.name_en = 'Surgery for pancreatic cancer', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007649.htm', n.overview = 'Tuyến tụy nằm phía sau dạ dày, giữa tá tràng (phần đầu của ruột non) và lá lách, và phía trước cột sống. Nó giúp tiêu hóa thức ăn và điều chỉnh lượng đường trong máu. Tuyến tụy có ba phần gọi là đầu (', n.prognosis = 'Phẫu thuật tuyến tụy có thể có rủi ro. Nếu phẫu thuật được thực hiện, nó sẽ diễn ra tại bệnh viện nơi thực hiện nhiều thủ tục này.';
MERGE (n:Disease {id: 'D2859'}) SET n.id = 'D2859', n.name = 'Phẫu thuật u nang lông vũ', n.name_en = 'Surgery for pilonidal cyst', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007591.htm', n.overview = 'U nang lông lông bị nhiễm trùng hoặc áp xe cần phải phẫu thuật dẫn lưu. Nó sẽ không lành chỉ bằng thuốc kháng sinh. Nếu bạn tiếp tục bị nhiễm trùng, u nang lông có thể được cắt bỏ bằng phẫu thuật. Có ', n.prognosis = 'U nang lông tái phát ở khoảng một nửa số người phẫu thuật lần đầu. Ngay cả sau cuộc phẫu thuật thứ hai, nó có thể quay trở lại.';
MERGE (n:Disease {id: 'D2860'}) SET n.id = 'D2860', n.name = 'Nhiễm trùng vết thương phẫu thuật – điều trị', n.name_en = 'Surgical wound infection – treatment', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007645.htm', n.prognosis = 'Nếu nhiễm trùng vết thương không sâu lắm và vết thương hở nhỏ, bạn có thể tự chăm sóc tại nhà. Nếu vết thương bị nhiễm trùng sâu hoặc có vết thương hở lớn hơn, bạn có thể phải nằm viện ít nhất vài ngà', n.when_to_see = 'Liên hệ với bác sĩ phẫu thuật nếu vết thương phẫu thuật của bạn có bất kỳ dấu hiệu nhiễm trùng nào: Mủ hoặc dịch tiết Mùi hôi bốc ra từ vết thương Sốt, ớn lạnh Nóng khi chạm vào Đỏ Đau hoặc đau khi ch';
MERGE (n:Disease {id: 'D2861'}) SET n.id = 'D2861', n.name = 'Khối u đáng ngờ ở vú', n.name_en = 'Suspicious breast lumps', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/suspicious-breast-lumps/symptoms-causes/syc-20352786', n.overview = 'Khối u ở vú là sự phát triển của mô hình thành ở vú. Hầu hết các khối u vú không phải là bất thường hoặc ung thư. Nhưng điều quan trọng là phải nhờ chuyên gia chăm sóc sức khỏe của bạn kiểm tra chúng ', n.when_to_see = 'Hẹn khám để kiểm tra khối u ở vú, đặc biệt nếu: Khối u mới hình thành và có cảm giác cứng hoặc cố định. Khối u không biến mất sau 4 đến 6 tuần. Hoặc nó đã thay đổi về kích thước hoặc cảm giác. Bạn nhậ';
MERGE (n:Disease {id: 'D2862'}) SET n.id = 'D2862', n.name = 'Các vết khâu - có gờ', n.name_en = 'Sutures - ridged', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003308.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn nhận thấy một đường gờ dọc theo đường khâu trên đầu của con bạn. Bạn cho rằng con mình có hình dạng đầu bất thường.';
MERGE (n:Disease {id: 'D2863'}) SET n.id = 'D2863', n.name = 'Các vết khâu - tách ra', n.name_en = 'Sutures - separated', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003307.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có: Các vết khâu bị tách rời, các thóp phồng lên hoặc các tĩnh mạch trên da đầu rất rõ ràng Đỏ, sưng tấy hoặc chảy ra từ vùng';
MERGE (n:Disease {id: 'D2864'}) SET n.id = 'D2864', n.name = 'Tắc nghẽn SVC', n.name_en = 'SVC obstruction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001097.htm', n.prognosis = 'Kết quả sẽ khác nhau, tùy thuộc vào nguyên nhân và mức độ tắc nghẽn. Sự tắc nghẽn SVC do khối u gây ra là dấu hiệu cho thấy khối u đã lan rộng và nó cho thấy triển vọng lâu dài kém hơn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng tắc nghẽn SVC. Các biến chứng rất nghiêm trọng và đôi khi có thể gây tử vong.';
MERGE (n:Disease {id: 'D2865'}) SET n.id = 'D2865', n.name = 'Nuốt phấn', n.name_en = 'Swallowing chalk', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002771.htm', n.prognosis = 'Tình trạng sức khỏe của người đó phụ thuộc vào lượng phấn nuốt vào và tốc độ điều trị được tiếp nhận. Những người mắc bệnh thận có thể bị ảnh hưởng nhiều hơn nếu nuốt phải một lượng phấn rất lớn. Ngườ';
MERGE (n:Disease {id: 'D2866'}) SET n.id = 'D2866', n.name = 'Khó nuốt', n.name_en = 'Swallowing difficulty', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007543.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu vấn đề nuốt không cải thiện sau vài ngày hoặc chúng đến rồi đi. Liên hệ với nhà cung cấp của bạn ngay lập tức nếu: Bạn bị sốt hoặc khó thở. Bạn đang gi';
MERGE (n:Disease {id: 'D2867'}) SET n.id = 'D2867', n.name = 'Nuốt xà phòng', n.name_en = 'Swallowing soap', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002739.htm', n.prognosis = 'Mọi người thường hồi phục sau khi nuốt xà phòng. Tình trạng sức khỏe của một người phụ thuộc vào lượng xà phòng họ nuốt và tốc độ họ được chăm sóc y tế (nếu cần chăm sóc).';
MERGE (n:Disease {id: 'D2868'}) SET n.id = 'D2868', n.name = 'Nuốt kem chống nắng', n.name_en = 'Swallowing sunscreen', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002718.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng kem chống nắng họ nuốt và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt kem chống nắng thường chỉ gây khó chịu nhẹ ';
MERGE (n:Disease {id: 'D2869'}) SET n.id = 'D2869', n.name = 'Đổ mồ hôi', n.name_en = 'Sweating', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003218.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu đổ mồ hôi xảy ra với: Đau ngực Sốt Nhịp tim nhanh, đập mạnh Khó thở Sụt cân Những triệu chứng này có thể chỉ ra một vấn đề, chẳng hạn như';
MERGE (n:Disease {id: 'D2870'}) SET n.id = 'D2870', n.name = 'Đổ mồ hôi và mùi cơ thể', n.name_en = 'Sweating and body odor', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/sweating-and-body-odor/symptoms-causes/syc-20353895', n.overview = 'là hiện tượng thường gặp khi bạn tập thể dục hoặc ở nơi quá nóng. Chúng cũng là một phản ứng tự nhiên đối với sự thay đổi nội tiết tố và căng thẳng. Hầu hết mọi người đều có mùi cơ thể tự nhiên, ngay ', n.when_to_see = 'Hãy gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu: Bạn đột nhiên bắt đầu đổ mồ hôi nhiều hơn bình thường. Đổ mồ hôi làm gián đoạn cuộc sống hàng ngày của bạn. Bạn đổ mồ hôi đêm không rõ lý do.';
MERGE (n:Disease {id: 'D2871'}) SET n.id = 'D2871', n.name = 'Sưng', n.name_en = 'Swelling', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003103.htm', n.when_to_see = 'Nếu bạn nhận thấy bất kỳ vết sưng tấy nào không rõ nguyên nhân, hãy liên hệ với nhà cung cấp của bạn.';
MERGE (n:Disease {id: 'D2872'}) SET n.id = 'D2872', n.name = 'Tai của người bơi lội', n.name_en = 'Swimmer\'s ear', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/swimmers-ear/symptoms-causes/syc-20351682 | https://medlineplus.gov/ency/article/000622.htm', n.overview = 'là một bệnh nhiễm trùng ở ống tai ngoài. Ống tai ngoài chạy từ màng nhĩ ra bên ngoài đầu. Tai của người bơi lội thường bị nước đọng lại trong tai. Độ ẩm giúp vi khuẩn phát triển. Đưa ngón tay, tăm bôn', n.prognosis = 'Tai của người bơi lội thường sẽ tốt hơn nếu được điều trị thích hợp.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn phát triển bất kỳ triệu chứng nào về tai của người bơi lội Bạn nhận thấy có dịch chảy ra từ tai Các triệu chứng của bạn trở nên trầm trọng hơn hoặc ti';
MERGE (n:Disease {id: 'D2873'}) SET n.id = 'D2873', n.name = 'Cơn ngứa của người bơi lội', n.name_en = 'Swimmer\'s itch', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/swimmers-itch/symptoms-causes/syc-20355043', n.overview = 'các vết loét ăn sâu vào da bạn khi bạn bơi hoặc lội nước ngoài trời. Chứng ngứa của người bơi lội là tình trạng phát ban có thể xảy ra sau khi bạn đi bơi hoặc lội nước ngoài trời. Bệnh này phổ biến nh', n.when_to_see = 'Hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị phát ban sau khi bơi kéo dài hơn một tuần. Nếu bạn nhận thấy có mủ ở chỗ phát ban, hãy kiểm tra với nhà cung cấp dịch vụ ch';
MERGE (n:Disease {id: 'D2874'}) SET n.id = 'D2874', n.name = 'Ngộ độc chất tẩy rửa bể bơi', n.name_en = 'Swimming pool cleaner poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002839.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào mức độ nghiêm trọng của ngộ độc và tốc độ điều trị được tiếp nhận. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải những chất độc như vậy có th';
MERGE (n:Disease {id: 'D2875'}) SET n.id = 'D2875', n.name = 'Bệnh u hạt ở bể bơi', n.name_en = 'Swimming pool granuloma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001357.htm', n.prognosis = 'Bệnh u hạt ở bể bơi có thể được chữa khỏi bằng kháng sinh hoặc có thể tự lành. Chúng thường để lại sẹo.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn phát triển các vết mẩn đỏ trên da mà không khỏi khi điều trị tại nhà.';
MERGE (n:Disease {id: 'D2876'}) SET n.id = 'D2876', n.name = 'Đầu gối bị sưng', n.name_en = 'Swollen knee', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/swollen-knee/symptoms-causes/syc-20378129', n.overview = 'Đầu gối bị sưng xảy ra khi chất lỏng dư thừa tích tụ trong hoặc xung quanh khớp gối của bạn. Các chuyên gia chăm sóc sức khỏe có thể gọi tình trạng này là tràn dịch (uh-FU-zhun) ở khớp gối của bạn. Đầ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu các biện pháp tự chăm sóc, chẳng hạn như chườm đá và nghỉ ngơi, không cải thiện các triệu chứng. Tìm kiếm sự chăm sóc y tế ngay lập tức nếu một đầu gối';
MERGE (n:Disease {id: 'D2877'}) SET n.id = 'D2877', n.name = 'Các hạch bạch huyết bị sưng', n.name_en = 'Swollen lymph nodes', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/swollen-lymph-nodes/symptoms-causes/syc-20353902 | https://medlineplus.gov/ency/article/003097.htm', n.overview = 'thường xảy ra nhất do nhiễm trùng từ vi khuẩn hoặc vi rút. Hiếm khi, ung thư gây sưng hạch bạch huyết. Các hạch bạch huyết, còn được gọi là tuyến bạch huyết, đóng một vai trò quan trọng trong việc cơ ', n.when_to_see = 'Một số hạch bạch huyết bị sưng sẽ trở lại kích thước bình thường khi tình trạng gây ra chúng trở nên tốt hơn. Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn lo lắng hoặc nếu hạch bạch huyết bị sưng: Khô';
MERGE (n:Disease {id: 'D2878'}) SET n.id = 'D2878', n.name = 'Múa giật Sydenham', n.name_en = 'Sydenham chorea', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001358.htm', n.prognosis = 'Múa giật Sydenham thường hết sau vài tháng. Trong một số trường hợp hiếm hoi, một dạng múa giật Sydenham bất thường có thể bắt đầu sau này trong cuộc đời.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu con bạn có những cử động giật hoặc không kiểm soát được, đặc biệt nếu con bạn gần đây bị đau họng.';
MERGE (n:Disease {id: 'D2879'}) SET n.id = 'D2879', n.name = 'Hội chứng tiết hormone chống bài niệu không phù hợp', n.name_en = 'Syndrome of inappropriate antidiuretic hormone secretion', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000314.htm', n.prognosis = 'Kết quả phụ thuộc vào điều kiện gây ra sự cố. Hạ natri máu xảy ra nhanh chóng trong vòng chưa đầy 48 giờ (hạ natri máu cấp tính), nguy hiểm hơn so với hạ natri máu phát triển chậm theo thời gian. Khi ', n.when_to_see = 'Khi mức natri trong cơ thể bạn giảm quá nhiều, đó có thể là một trường hợp khẩn cấp đe dọa tính mạng. Liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn có các triệu chứng của tình trạng này.';
MERGE (n:Disease {id: 'D2880'}) SET n.id = 'D2880', n.name = 'Sarcoma hoạt dịch', n.name_en = 'Synovial sarcoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/synovial-sarcoma/symptoms-causes/syc-20577380', n.overview = 'là một loại ung thư hiếm gặp, có xu hướng xảy ra gần các khớp lớn, chủ yếu là đầu gối. Sarcoma hoạt dịch thường ảnh hưởng đến người trẻ tuổi. Sarcoma hoạt dịch bắt đầu bằng sự phát triển của các tế bà', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào không biến mất và khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2881'}) SET n.id = 'D2881', n.name = 'Bệnh giang mai', n.name_en = 'Syphilis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/syphilis/symptoms-causes/syc-20351756 | https://medlineplus.gov/ency/article/000861.htm', n.overview = 'là một bệnh nhiễm trùng do vi khuẩn gây ra. Thông thường, nó lây lan qua quan hệ tình dục. Bệnh bắt đầu bằng một vết loét thường không đau và thường xuất hiện ở bộ phận sinh dục, trực tràng hoặc miệng', n.prognosis = 'Bệnh giang mai giai đoạn một và giai đoạn hai có thể chữa khỏi nếu được chẩn đoán sớm và điều trị dứt điểm. Mặc dù bệnh giang mai thứ phát thường biến mất trong vòng vài tuần nhưng trong một số trường', n.when_to_see = 'Hãy gọi cho thành viên nhóm chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn có bất kỳ triệu chứng nào của bệnh giang mai. Chúng có thể bao gồm bất kỳ dịch tiết bất thường nào, vết loét hoặc phát ban, đ';
MERGE (n:Disease {id: 'D2882'}) SET n.id = 'D2882', n.name = 'Viêm màng não vô trùng giang mai', n.name_en = 'Syphilitic aseptic meningitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000724.htm', n.prognosis = 'Một số người có thể cần trợ giúp về ăn uống, mặc quần áo và chăm sóc bản thân. Lú lẫn và những thay đổi tâm thần khác có thể cải thiện hoặc tiếp tục lâu dài sau khi điều trị bằng kháng sinh. Bệnh gian', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn bị co giật. Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị đau đầu dữ dội kèm theo sốt hoặc các triệu chứng khác, đặc biệ';
MERGE (n:Disease {id: 'D2883'}) SET n.id = 'D2883', n.name = 'Syringomyelia', n.name_en = 'Syringomyelia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/syringomyelia/symptoms-causes/syc-20354771 | https://medlineplus.gov/ency/article/001398.htm', n.overview = 'u nang (syrinx) trong tủy sống và tủy sống Dịch não tủy thường chảy xung quanh bên ngoài não và tủy sống. Ở những người mắc bệnh syringomyelia, dịch não tủy tích tụ bên trong tủy sống và tạo thành một', n.prognosis = 'Nếu không điều trị, rối loạn có thể trở nên tồi tệ hơn rất chậm. Theo thời gian, nó có thể gây ra tình trạng khuyết tật nghiêm trọng. Phẫu thuật thường ngăn chặn tình trạng trở nên tồi tệ hơn. Chức nă', n.when_to_see = 'Nếu bạn có bất kỳ triệu chứng nào liên quan đến bệnh syringomyelia, hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn. Nếu bạn bị chấn thương tủy sống, hãy theo dõi các triệu chứng của bệnh syringomyel';
MERGE (n:Disease {id: 'D2884'}) SET n.id = 'D2884', n.name = 'Lupus ban đỏ hệ thống', n.name_en = 'Systemic lupus erythematosus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000435.htm', n.prognosis = 'Kết quả điều trị cho những người mắc SLE đã được cải thiện trong những năm gần đây. Nhiều người bị SLE có triệu chứng nhẹ. Bạn làm tốt như thế nào tùy thuộc vào mức độ nghiêm trọng của bệnh. Hầu hết n', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của SLE. Đồng thời, hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn mắc bệnh này và các triệu chứng của bạn trở nên trầm tr';
MERGE (n:Disease {id: 'D2885'}) SET n.id = 'D2885', n.name = 'Bệnh tế bào mast hệ thống', n.name_en = 'Systemic mastocytosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/systemic-mastocytosis/symptoms-causes/syc-20352859', n.overview = '(mas-to-sy-TOE-sis) là một tình trạng hiếm gặp dẫn đến có quá nhiều tế bào mast tích tụ trong cơ thể. Tế bào mast được tìm thấy trong các mô khắp cơ thể. Tế bào mast giúp hệ thống miễn dịch hoạt động ', n.when_to_see = 'Hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị đỏ bừng mặt hoặc nổi mề đay hoặc nếu bạn lo ngại về các triệu chứng khác có thể là bệnh tế bào mast. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D2886'}) SET n.id = 'D2886', n.name = 'Ung thư hạch tế bào T', n.name_en = 'T-cell lymphoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/t-cell-lymphoma/symptoms-causes/syc-20588407', n.overview = 'là một loại ung thư hạch. Ung thư hạch là bệnh ung thư ảnh hưởng đến hệ bạch huyết. Hệ bạch huyết được tạo thành từ các cơ quan, tuyến, mạch dạng ống và cụm tế bào gọi là hạch bạch huyết. Nó là một ph', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D2887'}) SET n.id = 'D2887', n.name = 'Tabes dorsalis', n.name_en = 'Tabes dorsalis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000729.htm', n.prognosis = 'Nếu không được điều trị, bệnh Tabes dorsalis có thể dẫn đến tình trạng khuyết tật.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị: Mất khả năng phối hợp Mất sức mạnh cơ bắp Mất cảm giác';
MERGE (n:Disease {id: 'D2888'}) SET n.id = 'D2888', n.name = 'Nhịp tim nhanh', n.name_en = 'Tachycardia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/tachycardia/symptoms-causes/syc-20355127', n.overview = 'tín hiệu nhịp tim, được gọi là xung, bắt đầu ở buồng trên hoặc buồng dưới của tim. Điều này khiến tim đập nhanh hơn. Nhịp tim nhanh (tak-ih-KAHR-dee-uh) là thuật ngữ y học chỉ nhịp tim trên 100 nhịp m', n.when_to_see = 'Nhiều thứ có thể gây ra nhịp tim nhanh. Nếu bạn cảm thấy tim mình đập quá nhanh, hãy hẹn khám sức khỏe. Tìm kiếm sự trợ giúp y tế ngay lập tức nếu bạn bị: Đau ngực hoặc khó chịu. Hụt hơi. Điểm yếu. Ch';
MERGE (n:Disease {id: 'D2889'}) SET n.id = 'D2889', n.name = 'Chấn thương xương cụt', n.name_en = 'Tailbone trauma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000008.htm', n.when_to_see = 'Gọi 911 hoặc số điện thoại khẩn cấp tại địa phương để được trợ giúp y tế ngay lập tức nếu: Nghi ngờ chấn thương tủy sống Người đó không thể di chuyển Đau nặng';
MERGE (n:Disease {id: 'D2890'}) SET n.id = 'D2890', n.name = 'Viêm động mạch Takayasu', n.name_en = 'Takayasu arteritis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001250.htm', n.prognosis = 'Căn bệnh này có thể gây tử vong nếu không được điều trị. Tuy nhiên, phương pháp điều trị kết hợp sử dụng thuốc và phẫu thuật đã làm giảm tỷ lệ tử vong. Người lớn có cơ hội sống sót cao hơn trẻ em.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của tình trạng này. Cần chăm sóc ngay lập tức nếu bạn bị: Mạch yếu Đau ngực Khó thở';
MERGE (n:Disease {id: 'D2891'}) SET n.id = 'D2891', n.name = 'Chăm sóc lưng tại nhà', n.name_en = 'Taking care of your back at home', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002119.htm', n.overview = 'Một lầm tưởng phổ biến về chứng đau lưng là bạn cần nghỉ ngơi và tránh hoạt động trong thời gian dài. Trên thực tế, các nhà cung cấp dịch vụ chăm sóc sức khỏe không khuyến khích nghỉ ngơi tại giường. ';
MERGE (n:Disease {id: 'D2892'}) SET n.id = 'D2892', n.name = 'Uống chất bổ sung sắt', n.name_en = 'Taking iron supplements', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007478.htm', n.overview = 'GIỚI THIỆU VỀ BỔ SUNG SẮT Chất bổ sung sắt có thể được dùng dưới dạng viên nang, viên nén, viên nhai và chất lỏng. Kích thước viên phổ biến nhất là 325 mg (sắt sunfat). Các dạng hóa học phổ biến khác ';
MERGE (n:Disease {id: 'D2893'}) SET n.id = 'D2893', n.name = 'Ngộ độc bột talc', n.name_en = 'Talcum powder poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002719.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng bột talc họ nuốt và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Hít phải bột talc có thể dẫn đến các vấn đề nghiêm trọ';
MERGE (n:Disease {id: 'D2894'}) SET n.id = 'D2894', n.name = 'Nhiễm sán dây', n.name_en = 'Tapeworm infection', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/tapeworm/symptoms-causes/syc-20378174', n.overview = 'Sán dây là một loại ký sinh trùng có thể sống và kiếm ăn trong ruột người. Đây được gọi là nhiễm trùng sán dây. Dạng sán dây còn non và không hoạt động được gọi là u nang ấu trùng. Nó có thể tồn tại ở', n.when_to_see = 'Nếu bạn gặp bất kỳ triệu chứng nào của nhiễm trùng sán dây hoặc u nang ấu trùng, hãy đi khám. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin được đ';
MERGE (n:Disease {id: 'D2895'}) SET n.id = 'D2895', n.name = 'Nhiễm sán dây - thịt bò hoặc thịt lợn', n.name_en = 'Tapeworm infection - beef or pork', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001391.htm', n.prognosis = 'Khi được điều trị, tình trạng nhiễm sán dây sẽ biến mất.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn thải ra thứ gì đó trong phân trông giống như một con giun trắng.';
MERGE (n:Disease {id: 'D2896'}) SET n.id = 'D2896', n.name = 'Nhiễm sán dây - hymenolepis', n.name_en = 'Tapeworm infection - hymenolepis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001378.htm', n.prognosis = 'Mong đợi sự phục hồi hoàn toàn sau khi điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị tiêu chảy mãn tính hoặc đau bụng.';
MERGE (n:Disease {id: 'D2897'}) SET n.id = 'D2897', n.name = 'Ngộ độc chất tẩy hắc ín', n.name_en = 'Tar remover poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002809.htm', n.prognosis = 'Tình trạng của một người phụ thuộc vào lượng chất tẩy tar được nuốt vào và tốc độ điều trị được tiếp nhận. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải những chất độc như vậy có';
MERGE (n:Disease {id: 'D2898'}) SET n.id = 'D2898', n.name = 'Vết cắn của nhện Tarantula', n.name_en = 'Tarantula spider bite', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002855.htm', n.prognosis = 'Quá trình hồi phục thường mất khoảng một tuần. Tử vong do vết cắn của nhện tarantula ở người khỏe mạnh là rất hiếm.';
MERGE (n:Disease {id: 'D2899'}) SET n.id = 'D2899', n.name = 'Rối loạn vận động muộn', n.name_en = 'Tardive dyskinesia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000685.htm', n.prognosis = 'Nếu được chẩn đoán sớm, TD có thể được phục hồi bằng cách ngừng dùng thuốc gây ra các triệu chứng. Ngay cả khi ngừng thuốc, các cử động không chủ ý có thể trở nên vĩnh viễn và trong một số trường hợp,';
MERGE (n:Disease {id: 'D2900'}) SET n.id = 'D2900', n.name = 'Hội chứng đường hầm cổ chân', n.name_en = 'Tarsal tunnel syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000792.htm', n.prognosis = 'Có thể phục hồi hoàn toàn nếu nguyên nhân gây ra hội chứng đường hầm cổ chân được tìm ra và điều trị thành công. Một số người có thể bị mất một phần hoặc toàn bộ khả năng vận động hoặc cảm giác. Đau d', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của hội chứng đường hầm cổ chân. Chẩn đoán và điều trị sớm làm tăng khả năng kiểm soát được các triệu chứng.';
MERGE (n:Disease {id: 'D2901'}) SET n.id = 'D2901', n.name = 'Suy giảm vị giác', n.name_en = 'Taste - impaired', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003050.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu vấn đề về vị giác của bạn không biến mất hoặc nếu mùi vị bất thường xảy ra cùng với các triệu chứng khác.';
MERGE (n:Disease {id: 'D2902'}) SET n.id = 'D2902', n.name = 'Bệnh Tay-Sachs', n.name_en = 'Tay-Sachs disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/tay-sachs-disease/symptoms-causes/syc-20378190 | https://medlineplus.gov/ency/article/001417.htm', n.overview = 'là một chứng rối loạn di truyền hiếm gặp được truyền từ cha mẹ sang con. Nguyên nhân là do thiếu enzyme giúp phân hủy các chất béo. Những chất béo này, được gọi là ganglioside, tích tụ đến mức độc hại', n.prognosis = 'Trẻ mắc bệnh này có các triệu chứng ngày càng nặng hơn theo thời gian. Chúng thường chết khi được 4 hoặc 5 tuổi.', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số điện thoại cấp cứu tại địa phương nếu: Con bạn lên cơn động kinh không rõ nguyên nhân Cơn động kinh khác với những cơn động kinh trước đó Trẻ khó thở Cơn độn';
MERGE (n:Disease {id: 'D2903'}) SET n.id = 'D2903', n.name = 'Vắc xin Td (uốn ván, bạch hầu) - những điều bạn cần biết', n.name_en = 'Td (tetanus, diphtheria) vaccine - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007610.htm', n.overview = 'Tại sao phải tiêm phòng? Vắc-xin Td có thể ngăn ngừa bệnh uốn ván và bạch hầu. Uốn ván xâm nhập vào cơ thể qua vết cắt hoặc vết thương. Bệnh bạch hầu lây từ người này sang người khác. Uốn ván (T) gây ';
MERGE (n:Disease {id: 'D2904'}) SET n.id = 'D2904', n.name = 'Vắc xin Tdap (uốn ván, bạch hầu và ho gà) - những điều bạn cần biết', n.name_en = 'Tdap (tetanus, diphtheria and pertussis) vaccine - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007611.htm', n.overview = 'Tại sao phải tiêm vắc xin? Thuốc chủng ngừa Tdap có thể ngừa bệnh uốn ván, bạch hầu và ho gà. Bệnh bạch hầu và ho gà lây từ người này sang người khác. Uốn ván xâm nhập vào cơ thể qua vết cắt hoặc vết ';
MERGE (n:Disease {id: 'D2905'}) SET n.id = 'D2905', n.name = 'Trầm cảm ở thanh thiếu niên', n.name_en = 'Teen depression', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/teen-depression/symptoms-causes/syc-20350985', n.overview = 'là một vấn đề sức khỏe tâm thần nghiêm trọng gây ra cảm giác buồn bã dai dẳng và mất hứng thú với các hoạt động. Nó ảnh hưởng đến cách con bạn suy nghĩ, cảm nhận và hành xử, đồng thời có thể gây ra cá', n.when_to_see = 'Nếu các dấu hiệu và triệu chứng trầm cảm tiếp tục, bắt đầu can thiệp vào cuộc sống của con bạn hoặc khiến bạn lo ngại về việc tự tử hoặc sự an toàn của con bạn, hãy nói chuyện với bác sĩ hoặc chuyên g';
MERGE (n:Disease {id: 'D2906'}) SET n.id = 'D2906', n.name = 'Thanh thiếu niên và ma túy', n.name_en = 'Teenagers and drugs', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001975.htm', n.overview = 'Trước tiên, hãy tìm hiểu về các loại ma túy khác nhau có thể được sử dụng. Thanh thiếu niên lớn tuổi có nhiều khả năng sử dụng ma túy hơn thanh thiếu niên trẻ tuổi. Cần sa (chậu, cỏ dại) vẫn còn phổ b';
MERGE (n:Disease {id: 'D2907'}) SET n.id = 'D2907', n.name = 'Nghiến răng (nghiến răng)', n.name_en = 'Teeth grinding (bruxism)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/bruxism/symptoms-causes/syc-20356095', n.overview = 'Thuật ngữ y học cho việc nghiến răng là nghiến răng (BRUK-siz-um), một tình trạng trong đó bạn ép hoặc chà xát các răng vào nhau, còn được gọi là nghiến răng. Nghiến răng là tình trạng phổ biến và có ', n.when_to_see = 'Hãy gặp nha sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có các triệu chứng có thể do nghiến răng hoặc nghiến răng hoặc nếu bạn có những lo ngại khác về răng hoặc hàm của mình. Nếu bạn nhận thấy ';
MERGE (n:Disease {id: 'D2908'}) SET n.id = 'D2908', n.name = 'Quá trình mọc răng', n.name_en = 'Teething', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002045.htm', n.overview = 'thường bắt đầu khi trẻ được 6 đến 8 tháng tuổi. Tất cả 20 chiếc răng sữa sẽ mọc đúng vị trí khi trẻ được 30 tháng tuổi. Một số trẻ không mọc răng cho đến sau 8 tháng, nhưng điều này thường là bình thư';
MERGE (n:Disease {id: 'D2909'}) SET n.id = 'D2909', n.name = 'Telangiectasia', n.name_en = 'Telangiectasia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003284.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy các mạch máu trên da, màng nhầy hoặc mắt bị giãn rộng.';
MERGE (n:Disease {id: 'D2910'}) SET n.id = 'D2910', n.name = 'Những cơn giận dữ', n.name_en = 'Temper tantrums', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001922.htm', n.overview = '(hành vi bộc phát) là điều tự nhiên trong thời thơ ấu. Việc trẻ muốn tự lập là điều bình thường khi chúng biết rằng chúng là những con người tách biệt khỏi cha mẹ. Mong muốn kiểm soát này thường biểu ';
MERGE (n:Disease {id: 'D2911'}) SET n.id = 'D2911', n.name = 'Cơn động kinh thùy thái dương', n.name_en = 'Temporal lobe seizure', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/temporal-lobe-seizure/symptoms-causes/syc-20378214', n.overview = 'bắt đầu ở thùy thái dương của não. Những khu vực này xử lý cảm xúc và rất quan trọng đối với trí nhớ ngắn hạn. Các triệu chứng của cơn động kinh thùy thái dương thường ảnh hưởng đến các chức năng này.', n.when_to_see = 'Gọi 911 hoặc số khẩn cấp tại địa phương của bạn nếu: Cơn động kinh kéo dài hơn năm phút. Hơi thở hoặc ý thức không trở lại sau khi cơn động kinh dừng lại. Cơn co giật thứ hai xảy ra ngay sau đó. Quá t';
MERGE (n:Disease {id: 'D2912'}) SET n.id = 'D2912', n.name = 'TEN', n.name_en = 'TEN', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/toxic-epidermal-necrolysis/symptoms-causes/syc-20491903', n.overview = 'Hoại tử biểu bì nhiễm độc trên lưng phụ nữ TEN khiến da bị phồng rộp, bong tróc diện rộng. Hoại tử biểu bì nhiễm độc (TEN) là một phản ứng da hiếm gặp, đe dọa tính mạng, thường do thuốc gây ra. Đó là ', n.when_to_see = 'Điều trị sớm là chìa khóa cho những người mắc hội chứng Stevens-Johnson/hoại tử biểu bì nhiễm độc (SJS/TEN). Nếu bạn có triệu chứng, hãy tìm kiếm sự chăm sóc y tế ngay lập tức. Bạn có thể sẽ cần sự ch';
MERGE (n:Disease {id: 'D2913'}) SET n.id = 'D2913', n.name = 'Viêm gân', n.name_en = 'Tendinitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/tendinitis/symptoms-causes/syc-20378243 | https://medlineplus.gov/ency/article/001229.htm', n.overview = 'Khớp vai tới tận xương. Việc sử dụng quá mức hoặc căng khớp có thể gây viêm gân và dẫn đến viêm gân. Viêm gân là tình trạng viêm của các sợi dây dày gắn cơ với xương. Những dây này được gọi là gân. Tì', n.prognosis = 'Các triệu chứng sẽ cải thiện khi được điều trị và nghỉ ngơi. Nếu chấn thương là do sử dụng quá mức, có thể cần phải thay đổi thói quen làm việc để ngăn vấn đề tái phát.', n.when_to_see = 'Hầu hết các trường hợp viêm gân đều đáp ứng với việc tự chăm sóc. Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu các triệu chứng của bạn không giảm sau vài ngày và nếu chúng cản trở cá';
MERGE (n:Disease {id: 'D2914'}) SET n.id = 'D2914', n.name = 'Bệnh lý gân', n.name_en = 'Tendinopathy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/tendinopathy/symptoms-causes/syc-20580660', n.overview = 'Khuỷu tay quần vợt, các mô giống như dây của cơ bắp tay, được gọi là gân, gắn vào một vết sưng xương ở bên ngoài khuỷu tay. Những vết rách nhỏ và sưng tấy lâu ngày, được gọi là viêm, có thể khiến gân ', n.when_to_see = 'Bạn có thể điều trị nhiều trường hợp bệnh viêm gân bằng các biện pháp tự chăm sóc, chẳng hạn như nghỉ ngơi, chườm đá và dùng thuốc giảm đau. Hãy đến gặp chuyên gia chăm sóc sức khỏe nếu các triệu chứn';
MERGE (n:Disease {id: 'D2915'}) SET n.id = 'D2915', n.name = 'Việc sửa chữa gân', n.name_en = 'Tendon repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002970.htm', n.overview = 'thường có thể được thực hiện ở cơ sở ngoại trú. Thời gian nằm viện, nếu có, rất ngắn. Việc sửa chữa gân có thể được thực hiện bằng cách sử dụng: Gây tê cục bộ (vùng phẫu thuật ngay lập tức không đau) ', n.prognosis = 'Hầu hết việc sửa chữa gân đều thành công khi áp dụng vật lý trị liệu phù hợp và liên tục.';
MERGE (n:Disease {id: 'D2916'}) SET n.id = 'D2916', n.name = 'Tenesmus', n.name_en = 'Tenesmus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003131.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn tiếp tục bị tenesmus. Đồng thời liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn bị: Đau bụng Có máu trong phân Ớn lạnh';
MERGE (n:Disease {id: 'D2917'}) SET n.id = 'D2917', n.name = 'Khuỷu tay quần vợt', n.name_en = 'Tennis elbow', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/tennis-elbow/symptoms-causes/syc-20351987 | https://medlineplus.gov/ency/article/000449.htm', n.overview = ', các mô giống như dây của cơ cẳng tay, được gọi là gân, gắn vào một vết sưng xương ở bên ngoài khuỷu tay. Những vết rách nhỏ và sưng tấy lâu ngày, được gọi là viêm, có thể khiến gân bị đứt. Điều này ', n.prognosis = 'Hầu hết các cơn đau khuỷu tay đều thuyên giảm mà không cần phẫu thuật. Nhưng hầu hết những người phẫu thuật đều có thể sử dụng toàn bộ cẳng tay và khuỷu tay sau đó.', n.when_to_see = 'Nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu các bước tự chăm sóc như nghỉ ngơi, chườm đá và thuốc giảm đau không làm giảm cơn đau và đau ở khuỷu tay của bạn. Yêu cầu một cuộc hẹn Có vấn ';
MERGE (n:Disease {id: 'D2918'}) SET n.id = 'D2918', n.name = 'Phẫu thuật khuỷu tay quần vợt', n.name_en = 'Tennis elbow surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007590.htm', n.overview = 'Phẫu thuật sửa chữa khuỷu tay quần vợt thường là phẫu thuật ngoại trú. Điều này có nghĩa là bạn sẽ không ở lại bệnh viện qua đêm. Bạn sẽ được cho thuốc (thuốc an thần) để giúp bạn thư giãn và khiến bạ', n.prognosis = 'Phẫu thuật khuỷu tay quần vợt giúp giảm đau cho hầu hết mọi người. Nhiều người có thể quay lại chơi thể thao và các hoạt động khác sử dụng khuỷu tay trong vòng 4 đến 6 tháng. Duy trì các bài tập được ';
MERGE (n:Disease {id: 'D2919'}) SET n.id = 'D2919', n.name = 'Viêm bao gân', n.name_en = 'Tenosynovitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001242.htm', n.prognosis = 'Hầu hết mọi người đều hồi phục hoàn toàn sau khi điều trị. Nếu viêm bao gân là do sử dụng quá mức và hoạt động không được dừng lại, nó có khả năng quay trở lại. Nếu gân bị tổn thương, quá trình phục h', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị đau hoặc khó duỗi thẳng khớp hoặc chi. Liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn nhận thấy một vệt đỏ trên bàn tay, cổ tay, mắt cá c';
MERGE (n:Disease {id: 'D2920'}) SET n.id = 'D2920', n.name = 'Đau đầu do căng thẳng', n.name_en = 'Tension headache', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/tension-headache/symptoms-causes/syc-20353977 | https://medlineplus.gov/ency/article/000797.htm', n.overview = 'Đau đầu do căng thẳng gây ra cơn đau từ nhẹ đến trung bình thường được mô tả là có cảm giác như có một dải băng quấn quanh đầu. Đau đầu do căng thẳng là loại đau đầu phổ biến nhất nhưng nguyên nhân củ', n.prognosis = 'Đau đầu do căng thẳng thường đáp ứng tốt với điều trị. Nhưng nếu cơn đau đầu kéo dài (mãn tính) thì chúng có thể ảnh hưởng đến cuộc sống và công việc.', n.when_to_see = 'Gọi 911 hoặc số khẩn cấp tại địa phương nếu: Bạn đang trải qua "cơn đau đầu tồi tệ nhất trong đời". Bạn có vấn đề về giọng nói, thị giác, cử động hoặc mất thăng bằng, đặc biệt nếu trước đây bạn chưa t';
MERGE (n:Disease {id: 'D2921'}) SET n.id = 'D2921', n.name = 'Khối u tinh hoàn', n.name_en = 'Testicle lump', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003162.htm', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn nhận thấy bất kỳ khối u không giải thích được hoặc bất kỳ thay đổi nào khác trong tinh hoàn của bạn.';
MERGE (n:Disease {id: 'D2922'}) SET n.id = 'D2922', n.name = 'Đau tinh hoàn', n.name_en = 'Testicle pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003160.htm', n.when_to_see = 'Đau tinh hoàn đột ngột, dữ dội cần được chăm sóc y tế ngay lập tức. Liên hệ với nhà cung cấp của bạn ngay lập tức hoặc đến phòng cấp cứu nếu: Cơn đau của bạn nghiêm trọng hoặc đột ngột. Bạn đã bị chấn';
MERGE (n:Disease {id: 'D2923'}) SET n.id = 'D2923', n.name = 'Ung thư tinh hoàn', n.name_en = 'Testicular cancer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/testicular-cancer-care/symptoms-causes/syc-20352986 | https://medlineplus.gov/ency/article/001288.htm', n.overview = 'Hệ thống sinh sản nam giới đóng vai trò lưu trữ và di chuyển tinh trùng. Tinh hoàn sản xuất tinh trùng. Chất lỏng từ túi tinh và tuyến tiền liệt trộn với tinh trùng để tạo thành tinh dịch. Dương vật x', n.prognosis = 'Ung thư tinh hoàn là một trong những bệnh ung thư có thể chữa khỏi và điều trị được. Tỷ lệ sống sót ở nam giới mắc bệnh ung thư tinh hoàn giai đoạn đầu (loại ung thư tinh hoàn ít nguy hiểm nhất) là hơ', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn phát hiện bất kỳ triệu chứng nào kéo dài hơn hai tuần. Chúng bao gồm đau, sưng hoặc vón cục ở tinh hoàn hoặc vùng háng của bạn. Yêu cầu m';
MERGE (n:Disease {id: 'D2924'}) SET n.id = 'D2924', n.name = 'Xoắn tinh hoàn', n.name_en = 'Testicular torsion', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/testicular-torsion/symptoms-causes/syc-20378270 | https://medlineplus.gov/ency/article/000517.htm', n.overview = 'xảy ra khi tinh hoàn quay, xoắn dây tinh trùng đưa máu đến bìu. Lưu lượng máu giảm gây ra đau và sưng tấy đột ngột và thường nghiêm trọng. Xoắn tinh hoàn Trong quá trình xoắn tinh hoàn, tinh hoàn sẽ x', n.prognosis = 'Tinh hoàn có thể tiếp tục hoạt động bình thường nếu tình trạng bệnh được phát hiện sớm và điều trị ngay. Khả năng phải cắt bỏ tinh hoàn sẽ tăng lên nếu lưu lượng máu giảm trong hơn 6 giờ. Tuy nhiên, đ', n.when_to_see = 'Tìm kiếm sự chăm sóc khẩn cấp khi bị đau tinh hoàn đột ngột hoặc nghiêm trọng. Điều trị kịp thời có thể ngăn ngừa tổn thương nghiêm trọng hoặc mất tinh hoàn nếu bạn bị xoắn tinh hoàn. Bạn cũng cần tìm';
MERGE (n:Disease {id: 'D2925'}) SET n.id = 'D2925', n.name = 'Sửa chữa xoắn tinh hoàn', n.name_en = 'Testicular torsion repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002994.htm', n.overview = 'Hầu hết các trường hợp, bạn sẽ được gây mê toàn thân để phẫu thuật sửa chữa xoắn tinh hoàn. Bạn sẽ ngủ và không bị đau. Để thực hiện thủ thuật: Bác sĩ phẫu thuật sẽ rạch một đường ở bìu của bạn để tiế', n.prognosis = 'Nếu phẫu thuật được thực hiện kịp thời, bạn sẽ bình phục hoàn toàn. Khi nó được thực hiện trong vòng 4 giờ sau khi các triệu chứng bắt đầu, tinh hoàn có thể được cứu trong hầu hết thời gian. Nếu phải ';
MERGE (n:Disease {id: 'D2926'}) SET n.id = 'D2926', n.name = 'Uốn ván', n.name_en = 'Tetanus', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/tetanus/symptoms-causes/syc-20351625 | https://medlineplus.gov/ency/article/000615.htm', n.overview = 'là một căn bệnh nghiêm trọng của hệ thần kinh do một loại vi khuẩn sản sinh độc tố gây ra. Bệnh gây ra các cơn co thắt cơ, đặc biệt là cơ hàm và cơ cổ. Uốn ván thường được gọi là lockjaw. Các biến chứ', n.prognosis = 'Nếu không điều trị thì cứ 4 người nhiễm bệnh thì có 1 người chết. Tỷ lệ tử vong ở trẻ sơ sinh bị uốn ván không được điều trị thậm chí còn cao hơn. Nếu được điều trị thích hợp, ít hơn 15% số người nhiễ', n.when_to_see = 'Uốn ván là một căn bệnh nguy hiểm đến tính mạng. Nếu bạn có dấu hiệu hoặc triệu chứng uốn ván, hãy tìm kiếm sự chăm sóc khẩn cấp. Nếu bạn có vết thương đơn giản, sạch sẽ - và bạn đã tiêm phòng uốn ván';
MERGE (n:Disease {id: 'D2927'}) SET n.id = 'D2927', n.name = 'Ngộ độc tetrahydrozoline', n.name_en = 'Tetrahydrozoline poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002590.htm', n.prognosis = 'Các sản phẩm có chứa tetrahydrozoline có thể tương tác với nhiều loại thuốc theo toa. Luôn đọc nhãn trước khi sử dụng bất kỳ sản phẩm không kê đơn (OTC) nào. Ở trẻ nhỏ, các tác dụng phụ nghiêm trọng c';
MERGE (n:Disease {id: 'D2928'}) SET n.id = 'D2928', n.name = 'Tứ chứng Fallot', n.name_en = 'Tetralogy of Fallot', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/tetralogy-of-fallot/symptoms-causes/syc-20353477 | https://medlineplus.gov/ency/article/001567.htm', n.overview = 'bốn thay đổi về tim xuất hiện khi mới sinh. Có một lỗ trong tim gọi là thông liên thất. Ngoài ra còn có tình trạng hẹp van phổi hoặc khu vực khác dọc theo đường đi giữa tim và phổi. Hẹp van động mạch ', n.prognosis = 'Hầu hết các trường hợp đều có thể khắc phục được bằng phẫu thuật. Những em bé được phẫu thuật thường có kết quả tốt. Hơn 90% sống sót đến tuổi trưởng thành và sống một cuộc sống năng động, khỏe mạnh v', n.when_to_see = 'Dị tật tim bẩm sinh nghiêm trọng thường được chẩn đoán trước hoặc ngay sau khi con bạn chào đời. Hãy tìm kiếm sự trợ giúp y tế nếu bạn nhận thấy con bạn có những triệu chứng sau: Khó thở. Màu xanh của';
MERGE (n:Disease {id: 'D2929'}) SET n.id = 'D2929', n.name = 'Bệnh thalassemia', n.name_en = 'Thalassemia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/thalassemia/symptoms-causes/syc-20354995 | https://medlineplus.gov/ency/article/000587.htm', n.overview = '(thal-uh-SEE-me-uh) là một bệnh rối loạn về máu. Nó được di truyền, có nghĩa là nó được truyền từ cha mẹ sang con cái thông qua gen. Gen mang thông tin có thể ảnh hưởng đến nhiều thứ, bao gồm cả việc ', n.prognosis = 'Bệnh thalassemia nặng có thể gây tử vong sớm (trong độ tuổi từ 20 đến 30) do suy tim. Việc truyền máu thường xuyên và điều trị để loại bỏ chất sắt ra khỏi cơ thể sẽ giúp cải thiện kết quả. Các dạng th', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn hoặc con bạn có các triệu chứng của bệnh thalassemia. Bạn đang được điều trị chứng rối loạn và các triệu chứng mới phát triển.';
MERGE (n:Disease {id: 'D2930'}) SET n.id = 'D2930', n.name = 'Quá liều thiazide', n.name_en = 'Thiazide overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002577.htm', n.prognosis = 'Sức khoẻ của một người phụ thuộc vào mức độ nghiêm trọng của các triệu chứng. Các vấn đề về nhịp tim có thể đe dọa tính mạng. Mọi người thường hồi phục tốt. Các triệu chứng nghiêm trọng và tử vong khó';
MERGE (n:Disease {id: 'D2931'}) SET n.id = 'D2931', n.name = 'Quá liều thioridazine', n.name_en = 'Thioridazine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002555.htm', n.prognosis = 'Phục hồi tùy thuộc vào mức độ tổn thương của cơ thể cơ thể của người đó. Sống sót qua 2 ngày thường là một dấu hiệu tốt. Các tác dụng phụ nghiêm trọng nhất thường là do tổn thương tim. Nếu tổn thương ';
MERGE (n:Disease {id: 'D2932'}) SET n.id = 'D2932', n.name = 'Khát - vắng mặt', n.name_en = 'Thirst - absent', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003086.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nhận thấy bất kỳ tình trạng thiếu khát bất thường nào.';
MERGE (n:Disease {id: 'D2933'}) SET n.id = 'D2933', n.name = 'Khát - quá mức', n.name_en = 'Thirst - excessive', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003085.htm', n.when_to_see = 'Liên hệ nhà cung cấp dịch vụ chăm sóc sức khoẻ của bạn nếu: Khát nước quá mức đang diễn ra và không giải thích được. Khát nước đi kèm với các triệu chứng không giải thích được khác, chẳng hạn như mờ m';
MERGE (n:Disease {id: 'D2934'}) SET n.id = 'D2934', n.name = 'Phình động mạch chủ ngực', n.name_en = 'Thoracic aortic aneurysm', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/thoracic-aortic-aneurysm/symptoms-causes/syc-20350188 | https://medlineplus.gov/ency/article/001119.htm', n.overview = 'một vùng bị suy yếu ở phần trên của động mạch chính của cơ thể, được gọi là động mạch chủ. Chứng phình động mạch có thể phát triển ở bất kỳ vị trí nào trong động mạch chủ, kể cả gần tim. Phình động mạ', n.prognosis = 'Triển vọng lâu dài đối với những người mắc chứng phình động mạch chủ ngực phụ thuộc vào các vấn đề y tế khác, chẳng hạn như bệnh tim, huyết áp cao và tiểu đường. Những vấn đề này có thể đã gây ra hoặc', n.when_to_see = 'Hầu hết những người bị phình động mạch chủ ngực không có triệu chứng cho đến khi xảy ra bóc tách hoặc vỡ động mạch chủ. Bóc tách động mạch chủ hoặc vỡ phình động mạch là một trường hợp cấp cứu y tế. G';
MERGE (n:Disease {id: 'D2935'}) SET n.id = 'D2935', n.name = 'Hội chứng lối thoát ngực', n.name_en = 'Thoracic outlet syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/thoracic-outlet-syndrome/symptoms-causes/syc-20353988 | https://medlineplus.gov/ency/article/001434.htm', n.overview = 'Tất cả về hội chứng lối thoát ngực (TOS): Tổng quan Hiển thị bản ghi cho video Tất cả về hội chứng lối thoát ngực (TOS): Tổng quan [PHÁT NHẠC] Tất cả về Hội chứng lối thoát ngực (TOS): Tổng quan Hội c', n.prognosis = 'Phẫu thuật cắt bỏ xương sườn thừa và phá vỡ các dải xơ chật hẹp có thể làm giảm triệu chứng ở một số người. Một số người có các triệu chứng tái phát sau phẫu thuật.', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn thường xuyên gặp bất kỳ triệu chứng nào của hội chứng lối thoát ngực. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem x';
MERGE (n:Disease {id: 'D2936'}) SET n.id = 'D2936', n.name = 'Ung thư vòm họng', n.name_en = 'Throat cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/throat-cancer/symptoms-causes/syc-20366462', n.overview = 'Các bộ phận của ống họng (hầu họng) chạy từ sau mũi xuống cổ. Cổ họng còn được gọi là họng. Nó bao gồm ba phần: vòm họng, hầu họng và thanh quản. Thanh quản còn được gọi là hạ họng. Giải phẫu họng, am', n.when_to_see = 'Hẹn gặp bác sĩ nếu bạn nhận thấy bất kỳ dấu hiệu và triệu chứng mới nào dai dẳng. Hầu hết các triệu chứng ung thư vòm họng không đặc trưng cho bệnh ung thư, vì vậy trước tiên bác sĩ có thể sẽ điều tra';
MERGE (n:Disease {id: 'D2937'}) SET n.id = 'D2937', n.name = 'Ung thư vòm họng hoặc thanh quản', n.name_en = 'Throat or larynx cancer', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001042.htm', n.prognosis = 'Ung thư vòm họng có thể chữa khỏi nếu được phát hiện sớm. Nếu ung thư chưa lan rộng (di căn) đến các mô xung quanh hoặc hạch bạch huyết ở cổ thì khoảng một nửa số bệnh nhân có thể được chữa khỏi. Nếu ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có các triệu chứng của bệnh ung thư vòm họng, đặc biệt là khàn giọng hoặc thay đổi giọng nói không có nguyên nhân rõ ràng kéo dài hơn 3 tuần Bạn p';
MERGE (n:Disease {id: 'D2938'}) SET n.id = 'D2938', n.name = 'Viêm tắc tĩnh mạch', n.name_en = 'Thromboangiitis obliterans', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000172.htm', n.prognosis = 'Các triệu chứng của bệnh viêm tắc mạch huyết khối có thể biến mất nếu người đó ngừng sử dụng thuốc lá. Những người tiếp tục sử dụng thuốc lá có thể phải cắt cụt chi nhiều lần.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn có các triệu chứng của bệnh viêm tắc mạch huyết khối. Bạn bị viêm tắc mạch huyết khối và các triệu chứng trở nên tồi tệ hơn, nga';
MERGE (n:Disease {id: 'D2939'}) SET n.id = 'D2939', n.name = 'Giảm tiểu cầu', n.name_en = 'Thrombocytopenia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000586.htm', n.prognosis = 'Kết quả phụ thuộc vào tình trạng rối loạn gây ra số lượng tiểu cầu thấp.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị chảy máu hoặc bầm tím không rõ nguyên nhân.';
MERGE (n:Disease {id: 'D2940'}) SET n.id = 'D2940', n.name = 'Giảm tiểu cầu (số lượng tiểu cầu thấp)', n.name_en = 'Thrombocytopenia (low platelet count)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/thrombocytopenia/symptoms-causes/syc-20378293', n.overview = 'Giảm tiểu cầu là số lượng tiểu cầu trong máu thấp. Tiểu cầu, còn được gọi là huyết khối, là những tế bào máu không màu giúp đông máu. Tiểu cầu cầm máu bằng cách kết tụ lại với nhau và tạo thành nút ch', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng giảm tiểu cầu. Chảy máu không ngừng là một trường hợp cấp cứu y tế. Tìm kiếm sự trợ giúp ngay lập tức khi chảy máu không thể';
MERGE (n:Disease {id: 'D2941'}) SET n.id = 'D2941', n.name = 'Tăng tiểu cầu', n.name_en = 'Thrombocytosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/thrombocytosis/symptoms-causes/syc-20378315', n.overview = 'Tiểu cầu là một phần của máu giúp hình thành cục máu đông. Tăng tiểu cầu (throm-boe-sie-TOE-sis) là một chứng rối loạn trong đó cơ thể bạn sản xuất quá nhiều tiểu cầu. Nó được gọi là tăng tiểu cầu phả';
MERGE (n:Disease {id: 'D2942'}) SET n.id = 'D2942', n.name = 'Liệu pháp tiêu huyết khối', n.name_en = 'Thrombolytic therapy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007089.htm', n.overview = 'Thuốc tiêu huyết khối được phê duyệt để điều trị cấp cứu đột quỵ và đau tim. Loại thuốc được sử dụng phổ biến nhất để điều trị tan huyết khối là chất kích hoạt plasminogen mô (tPA), nhưng các loại thu';
MERGE (n:Disease {id: 'D2943'}) SET n.id = 'D2943', n.name = 'Ban xuất huyết giảm tiểu cầu huyết khối', n.name_en = 'Thrombotic thrombocytopenic purpura', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000552.htm', n.prognosis = 'Hầu hết những người mắc TTP được trao đổi huyết tương đều hồi phục hoàn toàn. Nhưng một số người chết vì căn bệnh này, đặc biệt nếu nó không được chẩn đoán ngay. Ở những người không hồi phục, tình trạ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị chảy máu không rõ nguyên nhân.';
MERGE (n:Disease {id: 'D2944'}) SET n.id = 'D2944', n.name = 'Bệnh tưa miệng - trẻ em và người lớn', n.name_en = 'Thrush - children and adults', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000626.htm', n.prognosis = 'Bệnh tưa miệng có thể chữa được. Tuy nhiên, nếu hệ thống miễn dịch của bạn yếu, bệnh tưa miệng có thể quay trở lại hoặc gây ra những vấn đề nghiêm trọng hơn.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có vết loét giống bệnh tưa miệng. Bạn bị đau hoặc khó nuốt. Bạn có các triệu chứng của bệnh tưa miệng và bạn dương tính với HIV, đang được hóa trị';
MERGE (n:Disease {id: 'D2945'}) SET n.id = 'D2945', n.name = 'Bệnh tưa miệng ở trẻ sơ sinh', n.name_en = 'Thrush in newborns', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007615.htm', n.prognosis = 'Bệnh tưa miệng ở trẻ sơ sinh rất phổ biến và có thể điều trị dễ dàng. Hãy cho nhà cung cấp dịch vụ của con bạn biết nếu bệnh tưa miệng tiếp tục quay trở lại. Nó có thể là dấu hiệu của một vấn đề sức k', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu: Con bạn có các triệu chứng của bệnh tưa miệng Con bạn không chịu ăn Bạn có các triệu chứng nhiễm trùng nấm men ở núm vú';
MERGE (n:Disease {id: 'D2946'}) SET n.id = 'D2946', n.name = 'Viêm khớp ngón tay cái', n.name_en = 'Thumb arthritis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/thumb-arthritis/symptoms-causes/syc-20378339', n.overview = 'và khớp carpometacarpal, còn được gọi là khớp CMC, bị mòn đi. Viêm khớp ngón tay cái là phổ biến với sự lão hóa. Tình trạng này xảy ra khi sụn bị mòn khỏi các đầu xương tạo thành khớp ở gốc ngón tay c', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị sưng, cứng hoặc đau ở gốc ngón tay cái mà không biến mất. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nh';
MERGE (n:Disease {id: 'D2947'}) SET n.id = 'D2947', n.name = 'Những cơn đau đầu như sấm sét', n.name_en = 'Thunderclap headaches', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/thunderclap-headaches/symptoms-causes/syc-20378361', n.overview = 'đúng như tên gọi của chúng, đột ngột tấn công như một tiếng sấm. Cơn đau của những cơn đau đầu dữ dội này lên đến đỉnh điểm trong vòng 60 giây. Đau đầu như sét đánh không phổ biến nhưng chúng có thể c', n.when_to_see = 'Tìm kiếm sự chăm sóc y tế ngay lập tức nếu có bất kỳ cơn đau đầu nào xảy ra đột ngột và nghiêm trọng.';
MERGE (n:Disease {id: 'D2948'}) SET n.id = 'D2948', n.name = 'Ung thư tuyến giáp', n.name_en = 'Thyroid cancer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/thyroid-cancer/symptoms-causes/syc-20354161 | https://medlineplus.gov/ency/article/001213.htm', n.overview = 'Ung thư tuyến giáp là gì? Chuyên gia của Mayo Clinic giải thích Tìm hiểu thêm về ung thư tuyến giáp từ bác sĩ nội tiết Mabel Ryder, M.D. Hiển thị bản ghi video Ung thư tuyến giáp là gì? Chuyên gia của', n.when_to_see = 'Nếu bạn gặp bất kỳ dấu hiệu hoặc triệu chứng nào khiến bạn lo lắng, hãy hẹn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. ';
MERGE (n:Disease {id: 'D2949'}) SET n.id = 'D2949', n.name = 'Ung thư tuyến giáp - ung thư biểu mô tủy', n.name_en = 'Thyroid cancer - medullary carcinoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000374.htm', n.prognosis = 'Hầu hết những người mắc MTC đều sống được ít nhất 5 năm sau khi được chẩn đoán, tùy thuộc vào giai đoạn ung thư. Tỷ lệ sống sót sau 10 năm là 65%.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn có các triệu chứng của MTC.';
MERGE (n:Disease {id: 'D2950'}) SET n.id = 'D2950', n.name = 'Ung thư tuyến giáp - ung thư biểu mô nhú', n.name_en = 'Thyroid cancer - papillary carcinoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000331.htm', n.prognosis = 'Tỷ lệ sống sót đối với ung thư tuyến giáp thể nhú là rất cao. Hơn 90% người trưởng thành mắc bệnh ung thư này sống sót ít nhất 10 đến 20 năm. Tiên lượng tốt hơn ở những người dưới 40 tuổi và những ngư', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có khối u ở cổ.';
MERGE (n:Disease {id: 'D2951'}) SET n.id = 'D2951', n.name = 'Cắt bỏ tuyến giáp', n.name_en = 'Thyroid gland removal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002933.htm', n.overview = 'Tùy thuộc vào lý do bạn cắt bỏ tuyến giáp, loại phẫu thuật cắt bỏ tuyến giáp mà bạn thực hiện sẽ là: Cắt bỏ toàn bộ tuyến giáp, loại bỏ toàn bộ tuyến Cắt bỏ toàn bộ hoặc một phần tuyến giáp, loại bỏ m', n.prognosis = 'Kết quả của cuộc phẫu thuật này thường rất tốt. Hầu hết mọi người cần phải uống thuốc hormone tuyến giáp (thay thế hormone tuyến giáp) trong suốt quãng đời còn lại khi toàn bộ tuyến bị cắt bỏ.';
MERGE (n:Disease {id: 'D2952'}) SET n.id = 'D2952', n.name = 'U tuyến giáp', n.name_en = 'Thyroid nodule', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007265.htm', n.prognosis = 'Các nốt tuyến giáp không gây ung thư không đe dọa đến tính mạng. Nhiều người không cần điều trị. Các bài kiểm tra tiếp theo là đủ. Triển vọng của bệnh ung thư tuyến giáp phụ thuộc vào loại ung thư. Đố', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu bạn cảm thấy hoặc nhìn thấy một khối u ở cổ hoặc nếu bạn có bất kỳ triệu chứng nào của nhân tuyến giáp. Nếu bạn đã tiếp xúc với bức xạ ở vùng mặt hoặc cổ, hãy liên';
MERGE (n:Disease {id: 'D2953'}) SET n.id = 'D2953', n.name = 'Các nốt tuyến giáp', n.name_en = 'Thyroid nodules', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/thyroid-nodules/symptoms-causes/syc-20355262', n.overview = 'là các khối u rắn hoặc chứa đầy chất lỏng hình thành bên trong tuyến giáp. Tuyến giáp là một tuyến nhỏ nằm ở gốc cổ, ngay phía trên xương ức. Tuyến giáp Tuyến giáp nằm ở dưới cổ, ngay dưới quả táo Ada', n.when_to_see = 'Hầu hết các nốt tuyến giáp không phải là ung thư và không gây ra vấn đề gì. Nhưng nếu bạn thấy cổ bị sưng, đặc biệt là nếu nó ảnh hưởng đến việc thở hoặc nuốt, hãy đến gặp chuyên gia chăm sóc sức khỏe';
MERGE (n:Disease {id: 'D2954'}) SET n.id = 'D2954', n.name = 'Quá liều chế phẩm tuyến giáp', n.name_en = 'Thyroid preparation overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002592.htm', n.prognosis = 'Những người được điều trị nhanh chóng sẽ hồi phục tốt. Nhưng các biến chứng liên quan đến tim có thể dẫn đến tử vong. Các triệu chứng có thể không xuất hiện cho đến một tuần sau khi dùng quá liều hoặc';
MERGE (n:Disease {id: 'D2955'}) SET n.id = 'D2955', n.name = 'Bão tuyến giáp', n.name_en = 'Thyroid storm', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000400.htm', n.when_to_see = 'Đây là tình trạng khẩn cấp. Gọi 911 hoặc số khẩn cấp tại địa phương nếu bạn bị cường giáp và gặp các triệu chứng của cơn bão tuyến giáp.';
MERGE (n:Disease {id: 'D2956'}) SET n.id = 'D2956', n.name = 'Liệt chu kỳ do nhiễm độc giáp', n.name_en = 'Thyrotoxic periodic paralysis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000319.htm', n.prognosis = 'Nếu cơn tấn công không được điều trị và cơ hô hấp bị ảnh hưởng, tử vong có thể xảy ra. Các cơn đau mãn tính theo thời gian có thể dẫn đến yếu cơ. Điểm yếu này có thể tiếp tục tồn tại ngay cả giữa các ', n.when_to_see = 'Hãy gọi 911 hoặc số cấp cứu tại địa phương hoặc đến phòng cấp cứu nếu bạn bị yếu cơ trong thời gian dài. Điều này đặc biệt quan trọng nếu bạn có tiền sử gia đình bị liệt định kỳ hoặc rối loạn tuyến gi';
MERGE (n:Disease {id: 'D2957'}) SET n.id = 'D2957', n.name = 'Vết cắn của bọ ve', n.name_en = 'Tick bite', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002856.htm', n.prognosis = 'Sau khi loại bỏ bọ ve và làm sạch da, hãy quan sát khu vực phát triển vết ban tròn gọi là "ban đỏ di chuyển" trong tối đa 30 ngày sau khi bị bọ ve đốt. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức kh';
MERGE (n:Disease {id: 'D2958'}) SET n.id = 'D2958', n.name = 'Bệnh tê liệt do bọ ve', n.name_en = 'Tick paralysis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001359.htm', n.prognosis = 'Dự kiến ​​sẽ phục hồi hoàn toàn sau khi loại bỏ dấu tích.', n.when_to_see = 'Nếu con bạn đột nhiên đứng không vững hoặc yếu đi, hãy đưa trẻ đi khám ngay. Khó thở cần được chăm sóc khẩn cấp.';
MERGE (n:Disease {id: 'D2959'}) SET n.id = 'D2959', n.name = 'Loại bỏ bọ ve', n.name_en = 'Tick removal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007211.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn chưa thể xóa toàn bộ dấu tích. Đồng thời, liên hệ trong những ngày sau khi bị bọ ve cắn nếu bạn phát triển: Phát ban Các triệu chứng giống cúm, bao gồm sốt';
MERGE (n:Disease {id: 'D2960'}) SET n.id = 'D2960', n.name = 'Tinea versicolor', n.name_en = 'Tinea versicolor', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/tinea-versicolor/symptoms-causes/syc-20378385 | https://medlineplus.gov/ency/article/001465.htm', n.overview = '(TIN-ee-uh vur-si-KUL-ur) là một bệnh nhiễm trùng da phổ biến do nấm gây ra. Loại nấm này gây ra những thay đổi loang lổ về màu da. Vùng da bị ảnh hưởng có thể trông sáng hơn hoặc tối hơn vùng da khỏe', n.prognosis = 'Loại nấm gây lang ben thường dễ điều trị. Tuy nhiên, sự thay đổi màu da có thể kéo dài hàng tháng. Tình trạng này có thể tái phát khi thời tiết ấm áp.', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu: Làn da của bạn không cải thiện khi áp dụng các biện pháp tự chăm sóc. Nhiễm nấm quay trở lại. Các miếng vá bao phủ các vùng rộng lớn trên cơ thể bạn.';
MERGE (n:Disease {id: 'D2961'}) SET n.id = 'D2961', n.name = 'Ù tai', n.name_en = 'Tinnitus', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/tinnitus/symptoms-causes/syc-20350156 | https://medlineplus.gov/ency/article/003043.htm', n.overview = 'hoặc các tế bào lông bị tổn thương ở phần tai tiếp nhận âm thanh (ốc tai); thay đổi cách máu di chuyển qua các mạch máu gần đó (động mạch cảnh); các vấn đề về khớp xương hàm (khớp thái dương hàm); và ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Tiếng ồn trong tai bắt đầu sau chấn thương đầu. Tiếng ồn xảy ra kèm theo các triệu chứng không giải thích được khác, như chóng mặt, ';
MERGE (n:Disease {id: 'D2962'}) SET n.id = 'D2962', n.name = 'Lời khuyên về cách bỏ thuốc lá', n.name_en = 'Tips on how to quit smoking', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001992.htm', n.overview = 'Hầu hết những người đã bỏ thuốc lá đều không thành công ít nhất một lần trong quá khứ. Cố gắng đừng coi những nỗ lực bỏ thuốc trong quá khứ là thất bại. Hãy xem chúng như những kinh nghiệm học tập. Th';
MERGE (n:Disease {id: 'D2963'}) SET n.id = 'D2963', n.name = 'Hiệu giá', n.name_en = 'Titer', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002328.htm', n.overview = 'Đo hiệu giá máu có thể giúp xác định phương pháp điều trị y tế. Hiệu giá kháng thể cho biết liệu một người có miễn dịch với các bệnh như sởi, thủy đậu hoặc viêm gan hay không. Chúng cũng có thể giúp đ';
MERGE (n:Disease {id: 'D2964'}) SET n.id = 'D2964', n.name = 'Rối loạn TMJ', n.name_en = 'TMJ disorders', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/tmj/symptoms-causes/syc-20350941 | https://medlineplus.gov/ency/article/001227.htm', n.overview = 'Khớp thái dương hàm Khớp thái dương hàm, nằm ở mỗi bên đầu, phía trước tai của bạn. Đĩa sụn mềm có tác dụng như một lớp đệm giữa các xương của khớp, giúp khớp cử động trơn tru. Khớp thái dương hàm (te', n.prognosis = 'Đối với nhiều người, các triệu chứng chỉ thỉnh thoảng xảy ra và không kéo dài. Chúng có xu hướng biến mất theo thời gian với rất ít hoặc không cần điều trị. Hầu hết các trường hợp có thể được điều trị', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế nếu bạn bị đau hoặc nhức liên tục ở hàm xảy ra đột ngột hoặc trong khi cử động hàm hoặc nếu bạn không thể mở hoặc há hàm hoàn toàn. Nha sĩ, chuyên gia TMJ hoặc chuyên gia';
MERGE (n:Disease {id: 'D2965'}) SET n.id = 'D2965', n.name = 'Kiểm tra trẻ mới biết đi hoặc chuẩn bị thủ tục', n.name_en = 'Toddler test or procedure preparation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002056.htm', n.overview = 'Trước khi kiểm tra, hãy biết rằng con bạn có thể sẽ khóc. Ngay cả khi bạn chuẩn bị, con bạn vẫn có thể cảm thấy khó chịu hoặc đau đớn. Hãy thử sử dụng trò chơi để cho con bạn thấy điều gì sẽ xảy ra tr';
MERGE (n:Disease {id: 'D2966'}) SET n.id = 'D2966', n.name = 'Trẻ biết đi bằng đầu ngón chân', n.name_en = 'Toe walking in children', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/toe-walking/symptoms-causes/syc-20378410', n.overview = 'Việc đi bằng đầu ngón chân hoặc đầu ngón chân khá phổ biến ở trẻ mới bắt đầu biết đi. Điều này được gọi là đi bộ bằng ngón chân. Hầu hết trẻ em lớn lên sẽ vượt qua nó. Những đứa trẻ tiếp tục tập đi bằ', n.when_to_see = 'Nếu con bạn vẫn biết đi bằng ngón chân sau 2 tuổi, hãy trao đổi với chuyên gia chăm sóc sức khỏe của bạn về điều đó. Hãy hẹn khám sớm hơn nếu con bạn cũng bị căng cơ chân, cứng gân Achilles hoặc thiếu';
MERGE (n:Disease {id: 'D2967'}) SET n.id = 'D2967', n.name = 'Ngộ độc chất tẩy rửa và khử mùi bồn cầu', n.name_en = 'Toilet bowl cleaners and deodorizers poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002743.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng sản phẩm họ nuốt và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Chất tẩy rửa và khử mùi bồn cầu có thể gây ra tổn thươ';
MERGE (n:Disease {id: 'D2968'}) SET n.id = 'D2968', n.name = 'Quá liều Tolmetin', n.name_en = 'Tolmetin overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002558.htm', n.prognosis = 'Rất có khả năng phục hồi. Tuy nhiên, xuất huyết tiêu hóa có thể nghiêm trọng và cần phải truyền máu. Tổn thương thận có thể là vĩnh viễn. Một số người có thể cần nội soi, đặt một ống qua miệng đến dạ ';
MERGE (n:Disease {id: 'D2969'}) SET n.id = 'D2969', n.name = 'Ngộ độc toluene và xylene', n.name_en = 'Toluene and xylene poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002829.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào mức độ nghiêm trọng của ngộ độc và tốc độ điều trị được tiếp nhận. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Hít phải những chất này trong thời gia';
MERGE (n:Disease {id: 'D2970'}) SET n.id = 'D2970', n.name = 'Ung thư lưỡi', n.name_en = 'Tongue cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/tongue-cancer/symptoms-causes/syc-20378428', n.overview = 'là một loại ung thư bắt đầu từ sự phát triển của các tế bào trên lưỡi. Lưỡi bắt đầu ở cổ họng và kéo dài vào miệng. Nó được tạo thành từ các cơ và dây thần kinh giúp vận động và thực hiện chức năng, c', n.when_to_see = 'Hãy hẹn gặp bác sĩ, nha sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D2971'}) SET n.id = 'D2971', n.name = 'Các vấn đề về lưỡi', n.name_en = 'Tongue problems', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003047.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu vấn đề về lưỡi khiến bạn khó ăn hoặc khó thở hoặc nếu vấn đề vẫn tiếp diễn.';
MERGE (n:Disease {id: 'D2972'}) SET n.id = 'D2972', n.name = 'Buộc lưỡi', n.name_en = 'Tongue tie', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001640.htm';
MERGE (n:Disease {id: 'D2973'}) SET n.id = 'D2973', n.name = 'Dây buộc lưỡi (ankyloglossia)', n.name_en = 'Tongue-tie (ankyloglossia)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/tongue-tie/symptoms-causes/syc-20378452', n.overview = 'Dây buộc lưỡi là một dải mô ngắn, dày hoặc chặt (dây hãm lưỡi) buộc phần dưới đầu lưỡi vào sàn miệng. Nếu cần thiết, tình trạng trói lưỡi có thể được điều trị bằng phẫu thuật cắt bỏ dây hãm (frenotomy', n.when_to_see = 'Hãy đi khám bác sĩ nếu: Con bạn có dấu hiệu bịt lưỡi gây ra các vấn đề, chẳng hạn như khó bú. Một nhà nghiên cứu bệnh học về ngôn ngữ nói cho rằng khả năng nói của con bạn bị ảnh hưởng bởi tình trạng ';
MERGE (n:Disease {id: 'D2974'}) SET n.id = 'D2974', n.name = 'Cơn động kinh co cứng (grand mal)', n.name_en = 'Tonic-clonic (grand mal) seizure', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/grand-mal-seizure/symptoms-causes/syc-20363458', n.overview = 'Cơn động kinh co cứng-co giật, trước đây được gọi là cơn động kinh lớn, gây mất ý thức và co thắt cơ dữ dội. Đó là loại động kinh mà hầu hết mọi người đều hình dung khi nghĩ về các cơn động kinh. Tron', n.when_to_see = 'Gọi 911 hoặc trợ giúp y tế khẩn cấp nếu: Cơn co giật kéo dài hơn năm phút. Hơi thở hoặc ý thức không trở lại sau khi cơn động kinh dừng lại. Cơn co giật thứ hai xảy ra ngay sau đó. Bạn bị sốt cao. Bạn';
MERGE (n:Disease {id: 'D2975'}) SET n.id = 'D2975', n.name = 'Ung thư amidan', n.name_en = 'Tonsil cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/tonsil-cancer/symptoms-causes/syc-20367939', n.overview = 'Tonsil và amidan là một phần của hệ thống miễn dịch chống lại vi trùng của cơ thể. Ung thư amidan là sự phát triển của các tế bào bắt đầu ở amidan. Amidan là hai miếng đệm hình bầu dục ở phía sau miện', n.when_to_see = 'Hãy hẹn gặp bác sĩ, nha sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D2976'}) SET n.id = 'D2976', n.name = 'Cắt amiđan', n.name_en = 'Tonsillectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003013.htm', n.overview = 'Phẫu thuật được thực hiện khi con bạn đang được gây mê toàn thân. Con bạn sẽ ngủ và không bị đau. Bác sĩ phẫu thuật sẽ đặt một dụng cụ nhỏ vào miệng của con bạn để giữ nó mở ra. Sau đó, bác sĩ phẫu th', n.prognosis = 'Sau phẫu thuật, số lần nhiễm trùng họng thường thấp hơn, nhưng con bạn vẫn có thể bị nhiễm trùng.';
MERGE (n:Disease {id: 'D2977'}) SET n.id = 'D2977', n.name = 'Viêm amiđan', n.name_en = 'Tonsillitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/tonsillitis/symptoms-causes/syc-20378479 | https://medlineplus.gov/ency/article/001043.htm', n.overview = 'là tình trạng sưng và kích ứng, gọi là viêm, ở amiđan. Amidan là hai miếng mô hình bầu dục ở phía sau cổ họng. Có một amidan ở mỗi bên. Viêm amidan xảy ra chủ yếu ở trẻ em và thanh thiếu niên. Nhiễm m', n.prognosis = 'Các triệu chứng viêm amidan do liên cầu khuẩn thường sẽ thuyên giảm trong vòng 2 hoặc 3 ngày sau khi bạn bắt đầu dùng kháng sinh. Trẻ em bị viêm họng liên cầu khuẩn nên được nghỉ học hoặc giữ trẻ ở nh', n.when_to_see = 'Điều quan trọng là phải chẩn đoán nếu con bạn có các triệu chứng có thể là viêm amidan. Gọi cho chuyên gia chăm sóc sức khỏe của bạn nếu con bạn bị: Đau họng kèm theo sốt. Đau họng không khỏi trong vò';
MERGE (n:Disease {id: 'D2978'}) SET n.id = 'D2978', n.name = 'Răng - màu sắc bất thường', n.name_en = 'Tooth - abnormal colors', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003065.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Răng của bạn có màu bất thường mà không có nguyên nhân rõ ràng Màu răng bất thường vẫn tồn tại, ngay cả sau khi bạn đã vệ sinh răng kỹ';
MERGE (n:Disease {id: 'D2979'}) SET n.id = 'D2979', n.name = 'Răng - hình dạng bất thường', n.name_en = 'Tooth - abnormal shape', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003064.htm', n.when_to_see = 'Hãy nói chuyện với nha sĩ hoặc nhà cung cấp dịch vụ chăm sóc sức khỏe nếu hình dạng răng của con bạn có vẻ bất thường.';
MERGE (n:Disease {id: 'D2980'}) SET n.id = 'D2980', n.name = 'Áp xe răng', n.name_en = 'Tooth abscess', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/tooth-abscess/symptoms-causes/syc-20350901 | https://medlineplus.gov/ency/article/001060.htm', n.overview = 'Áp xe răng là một túi mủ do nhiễm trùng do vi khuẩn gây ra. Áp xe có thể xảy ra ở các khu vực khác nhau gần răng vì nhiều lý do khác nhau. Áp xe quanh chóp (per-e-AP-ih-kul) xảy ra ở đầu chân răng. Áp', n.prognosis = 'Áp xe không được điều trị có thể trở nên nặng hơn và có thể dẫn đến những biến chứng nguy hiểm đến tính mạng. Điều trị kịp thời sẽ chữa khỏi nhiễm trùng trong hầu hết các trường hợp. Chiếc răng thường', n.when_to_see = 'Hãy đến gặp nha sĩ kịp thời nếu bạn có bất kỳ dấu hiệu hoặc triệu chứng nào của áp xe răng. Nếu bạn bị sốt và sưng tấy ở mặt và không thể đến gặp nha sĩ, hãy đến phòng cấp cứu. Ngoài ra, hãy đến phòng';
MERGE (n:Disease {id: 'D2981'}) SET n.id = 'D2981', n.name = 'Nhổ răng', n.name_en = 'Tooth extraction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007630.htm', n.overview = 'Quá trình nhổ răng sẽ được thực hiện tại phòng khám nha khoa hoặc phòng khám nha khoa bệnh viện. Nó có thể liên quan đến việc loại bỏ một hoặc nhiều răng. Bạn có thể được yêu cầu dùng thuốc kháng sinh', n.prognosis = 'Mọi người đều hồi phục với tốc độ khác nhau. Sẽ mất từ ​​1 đến 2 tuần để ổ răng lành lại. Xương bị ảnh hưởng và các mô khác có thể mất nhiều thời gian hơn để lành lại. Một số người có thể có những tha';
MERGE (n:Disease {id: 'D2982'}) SET n.id = 'D2982', n.name = 'Sự hình thành răng - chậm hoặc vắng mặt', n.name_en = 'Tooth formation - delayed or absent', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003061.htm', n.when_to_see = 'Nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn chưa mọc bất kỳ chiếc răng nào trước 9 tháng tuổi.';
MERGE (n:Disease {id: 'D2983'}) SET n.id = 'D2983', n.name = 'Đau răng', n.name_en = 'Toothaches', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003067.htm', n.when_to_see = 'Tìm kiếm sự chăm sóc y tế nếu: Bạn bị đau răng nghiêm trọng Bạn bị đau răng kéo dài hơn một hoặc hai ngày Bạn bị sốt, đau tai hoặc đau khi há to miệng Lưu ý: Nha sĩ là người thích hợp để giúp bạn xem ';
MERGE (n:Disease {id: 'D2984'}) SET n.id = 'D2984', n.name = 'Quá liều kem đánh răng', n.name_en = 'Toothpaste overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002745.htm', n.prognosis = 'Những người nuốt một lượng rất lớn kem đánh răng có fluoride và sống sót sau 48 giờ thường hồi phục. Hầu hết các loại kem đánh răng không chứa fluoride đều không độc hại (không độc). Mọi người rất có ';
MERGE (n:Disease {id: 'D2985'}) SET n.id = 'D2985', n.name = 'Rách sụn chêm', n.name_en = 'Torn meniscus', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/torn-meniscus/symptoms-causes/syc-20354818', n.overview = 'Rách sụn chêm là một trong những chấn thương đầu gối phổ biến nhất. Bất kỳ hoạt động nào khiến bạn phải vặn hoặc xoay đầu gối một cách mạnh mẽ, đặc biệt là khi dồn toàn bộ trọng lượng của bạn lên đầu ', n.when_to_see = 'Hãy liên hệ với bác sĩ nếu đầu gối của bạn bị đau hoặc sưng tấy hoặc nếu bạn không thể cử động đầu gối theo những cách thông thường.';
MERGE (n:Disease {id: 'D2986'}) SET n.id = 'D2986', n.name = 'Vẹo cổ', n.name_en = 'Torticollis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000749.htm', n.prognosis = 'Tình trạng này có thể dễ điều trị hơn ở trẻ sơ sinh và trẻ nhỏ. Nếu chứng vẹo cổ trở thành mãn tính, tình trạng tê và ngứa ran có thể phát triển do áp lực lên rễ thần kinh ở cổ.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn để lấy hẹn nếu các triệu chứng không cải thiện khi điều trị hoặc nếu các triệu chứng mới phát triển. Chứng vẹo cổ xảy ra sau một chấn thương hoặc do bệnh tật có th';
MERGE (n:Disease {id: 'D2987'}) SET n.id = 'D2987', n.name = 'Phẫu thuật cắt bỏ toàn bộ đại tràng vùng bụng', n.name_en = 'Total abdominal colectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007379.htm', n.overview = 'Bạn sẽ được gây mê toàn thân trước khi phẫu thuật. Bạn sẽ ngủ và không thể cảm thấy đau. Trong quá trình phẫu thuật: Bác sĩ phẫu thuật sẽ thực hiện một vết mổ ở bụng của bạn. Bác sĩ phẫu thuật sẽ cắt ', n.prognosis = 'Sau thủ thuật này, bạn có thể sẽ đi tiêu từ 4 đến 6 lần mỗi ngày. Bạn có thể cần phải phẫu thuật nhiều hơn và cắt hồi tràng nếu bạn mắc bệnh Crohn và bệnh này lan đến trực tràng. Hầu hết những người t';
MERGE (n:Disease {id: 'D2988'}) SET n.id = 'D2988', n.name = 'Tổng lượng máu tĩnh mạch phổi hồi lưu bất thường', n.name_en = 'Total anomalous pulmonary venous return', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001115.htm', n.prognosis = 'Nếu tình trạng này không được điều trị, tim sẽ to hơn dẫn đến suy tim. Việc sửa chữa khiếm khuyết sớm mang lại kết quả tuyệt vời nếu không có tắc nghẽn tĩnh mạch phổi ở điểm nối mới vào tim. Trẻ sơ si', n.when_to_see = 'Tình trạng này có thể biểu hiện rõ ràng vào lúc sinh ra. Tuy nhiên, các triệu chứng có thể không xuất hiện cho đến sau này. Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy';
MERGE (n:Disease {id: 'D2989'}) SET n.id = 'D2989', n.name = 'Thay khớp háng toàn phần - chỉnh sửa', n.name_en = 'Total hip joint replacement - revision', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007807.htm', n.overview = 'Kết quả của phẫu thuật thay khớp háng thường rất tốt. Hầu hết các khớp háng nhân tạo có tuổi thọ từ 15 đến 20 năm trước khi chúng lỏng lẻo và cần được thay thế lại. Việc sửa đổi thay khớp háng có thể ', n.prognosis = 'Chỉnh sửa thay khớp háng toàn phần là một phẫu thuật phức tạp. Một số biến chứng thường gặp hơn sau phẫu thuật chỉnh sửa so với phẫu thuật ban đầu, chẳng hạn như: Nhiễm trùng Trật khớp Huyết khối tắc ';
MERGE (n:Disease {id: 'D2990'}) SET n.id = 'D2990', n.name = 'Thay khớp gối toàn phần - sửa đổi', n.name_en = 'Total knee joint replacement - revision', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007808.htm', n.overview = 'Kết quả của việc thay khớp gối toàn bộ thường rất tốt. Hầu hết các khớp gối nhân tạo đều có tuổi thọ từ 10 đến 15 năm. Một số có thể tồn tại tới 20 năm trước khi chúng lỏng lẻo và cần được thay thế lạ', n.prognosis = 'Chỉnh sửa thay khớp gối toàn phần là một ca phẫu thuật phức tạp. Một số biến chứng thường gặp hơn sau phẫu thuật chỉnh sửa so với phẫu thuật ban đầu, chẳng hạn như: Gãy xương Nhiễm trùng Nới lỏng và m';
MERGE (n:Disease {id: 'D2991'}) SET n.id = 'D2991', n.name = 'Dinh dưỡng toàn phần qua đường tĩnh mạch - trẻ sơ sinh', n.name_en = 'Total parenteral nutrition - infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007239.htm', n.overview = 'Trẻ sơ sinh bị bệnh hoặc sinh non có thể được cung cấp TPN trước khi bắt đầu cho ăn các chế độ ăn khác. Chúng cũng có thể có kiểu ăn này khi không thể hấp thụ chất dinh dưỡng qua đường tiêu hóa trong ';
MERGE (n:Disease {id: 'D2992'}) SET n.id = 'D2992', n.name = 'Cắt toàn bộ trực tràng và túi hậu môn-hậu môn', n.name_en = 'Total proctocolectomy and ileal-anal pouch', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007380.htm', n.overview = 'Bạn sẽ được gây mê toàn thân trước khi phẫu thuật. Bạn sẽ ngủ và không thể cảm thấy đau. Bạn có thể thực hiện thủ thuật theo một hoặc hai giai đoạn: Bác sĩ phẫu thuật sẽ thực hiện phẫu thuật cắt bụng ', n.prognosis = 'Bạn có thể sẽ đi đại tiện từ 4 đến 8 lần mỗi ngày sau cuộc phẫu thuật này. Bạn sẽ cần phải điều chỉnh lối sống của mình cho việc này. Hầu hết mọi người đều hồi phục hoàn toàn. Họ có thể thực hiện hầu ';
MERGE (n:Disease {id: 'D2993'}) SET n.id = 'D2993', n.name = 'Phẫu thuật cắt bỏ toàn bộ ruột kết và cắt hồi tràng', n.name_en = 'Total proctocolectomy with ileostomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007381.htm', n.overview = 'Bạn sẽ được gây mê toàn thân ngay trước khi phẫu thuật. Bạn sẽ ngủ và không thể cảm thấy đau. Đối với phẫu thuật cắt bỏ trực tràng: Bác sĩ phẫu thuật sẽ thực hiện một vết cắt phẫu thuật ở bụng dưới củ', n.prognosis = 'Hầu hết những người thực hiện phẫu thuật này đều có thể thực hiện hầu hết các hoạt động mà họ đã làm trước khi phẫu thuật. Điều này bao gồm hầu hết các hoạt động thể thao, du lịch, làm vườn, đi bộ đườ';
MERGE (n:Disease {id: 'D2994'}) SET n.id = 'D2994', n.name = 'Hội chứng Tourette', n.name_en = 'Tourette syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/tourette-syndrome/symptoms-causes/syc-20350465 | https://medlineplus.gov/ency/article/000733.htm', n.overview = 'Hội chứng Tourette (too-RET) là một chứng rối loạn bao gồm các chuyển động lặp đi lặp lại hoặc các âm thanh không mong muốn (tics) không thể dễ dàng kiểm soát được. Ví dụ: bạn có thể chớp mắt liên tục', n.prognosis = 'Các triệu chứng thường nặng nhất ở tuổi thiếu niên và sau đó cải thiện ở tuổi trưởng thành. Ở một số người, các triệu chứng biến mất hoàn toàn trong vài năm rồi quay trở lại. Ở một số ít người, các tr', n.when_to_see = 'Hãy đến gặp bác sĩ nhi khoa nếu bạn nhận thấy con mình có những cử động hoặc âm thanh không chủ ý. Không phải tất cả các tật máy đều chỉ ra hội chứng Tourette. Nhiều trẻ mắc chứng máy giật và tự hết s';
MERGE (n:Disease {id: 'D2995'}) SET n.id = 'D2995', n.name = 'Viêm gan nhiễm độc', n.name_en = 'Toxic hepatitis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/toxic-hepatitis/symptoms-causes/syc-20352202', n.overview = 'Gan nằm ở phần trên bên phải của bụng, bên dưới cơ hoành và phía trên dạ dày. Viêm gan nhiễm độc là tình trạng gan bị viêm do phản ứng với chất độc. Rượu, hóa chất, thuốc hoặc chất bổ sung dinh dưỡng ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe ngay nếu bạn có các triệu chứng khiến bạn lo lắng. Dùng quá nhiều một số loại thuốc, chẳng hạn như acetaminophen (Tylenol, những loại khác), có thể dẫn đến suy gan';
MERGE (n:Disease {id: 'D2996'}) SET n.id = 'D2996', n.name = 'Megacolon độc hại', n.name_en = 'Toxic megacolon', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000248.htm', n.prognosis = 'Nếu tình trạng không cải thiện có thể gây tử vong. Phẫu thuật đại tràng thường là cần thiết trong những trường hợp như vậy.', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi số cấp cứu tại địa phương (chẳng hạn như 911) nếu bạn bị đau bụng dữ dội, đặc biệt nếu bạn cũng bị: Tiêu chảy ra máu Sốt Tiêu chảy thường xuyên Nhịp tim nhanh Đau khi ấn';
MERGE (n:Disease {id: 'D2997'}) SET n.id = 'D2997', n.name = 'Bướu cổ dạng nốt độc', n.name_en = 'Toxic nodular goiter', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000317.htm', n.prognosis = 'Bướu cổ độc hại chủ yếu là bệnh của người lớn tuổi. Vì vậy, các vấn đề sức khỏe mãn tính khác có thể ảnh hưởng đến kết quả của tình trạng này. Người lớn tuổi có thể ít có khả năng chịu đựng được ảnh h', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của chứng rối loạn này được liệt kê ở trên. Làm theo hướng dẫn của nhà cung cấp của bạn cho các lần tái khám.';
MERGE (n:Disease {id: 'D2998'}) SET n.id = 'D2998', n.name = 'Hội chứng sốc nhiễm độc', n.name_en = 'Toxic shock syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/toxic-shock-syndrome/symptoms-causes/syc-20355384 | https://medlineplus.gov/ency/article/000653.htm', n.overview = 'là một biến chứng hiếm gặp của một số loại bệnh nhiễm trùng do vi khuẩn. Nó có thể gây tử vong. Vi khuẩn tụ cầu vàng hay còn gọi là vi khuẩn tụ cầu khuẩn thường gây ra hội chứng sốc nhiễm độc. Nhưng đ', n.prognosis = 'Hội chứng sốc độc có thể gây tử vong trong tối đa 50% trường hợp. Tình trạng này có thể quay trở lại ở những người sống sót.', n.when_to_see = 'Hội chứng sốc nhiễm độc là một trường hợp cấp cứu y tế. Tìm kiếm sự trợ giúp y tế ngay lập tức nếu bạn bị phát ban, sốt và cảm thấy mệt mỏi, đặc biệt là trong thời kỳ kinh nguyệt và sử dụng băng vệ si';
MERGE (n:Disease {id: 'D2999'}) SET n.id = 'D2999', n.name = 'Viêm màng hoạt dịch nhiễm độc', n.name_en = 'Toxic synovitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000981.htm', n.prognosis = 'Cơn đau hông sẽ biến mất trong vòng 7 đến 10 ngày.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn để lấy hẹn nếu: Con bạn bị đau hông không rõ nguyên nhân hoặc đi khập khiễng, có hoặc không sốt Con bạn đã được chẩn đoán mắc bệnh vi';
MERGE (n:Disease {id: 'D3000'}) SET n.id = 'D3000', n.name = 'Toxoplasmosis', n.name_en = 'Toxoplasmosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/toxoplasmosis/symptoms-causes/syc-20356249 | https://medlineplus.gov/ency/article/000637.htm', n.overview = '(tok-so-plaz-MOE-sis) là một bệnh nhiễm trùng do ký sinh trùng có tên Toxoplasma gondii. Mọi người thường bị nhiễm trùng do ăn thịt chưa nấu chín. Bạn cũng có thể bị nhiễm bệnh khi tiếp xúc với phân m', n.prognosis = 'Khi được điều trị, những người có hệ miễn dịch khỏe mạnh thường hồi phục tốt.', n.when_to_see = 'Hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn về xét nghiệm nếu bạn lo lắng về việc tiếp xúc với ký sinh trùng. Nếu bạn đang có kế hoạch mang thai hoặc đang mang thai, hãy gặp bác ';
MERGE (n:Disease {id: 'D3001'}) SET n.id = 'D3001', n.name = 'Vỡ khí quản', n.name_en = 'Tracheal rupture', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001092.htm', n.prognosis = 'Triển vọng của chấn thương do chấn thương phụ thuộc vào mức độ nghiêm trọng của các chấn thương khác. Các phẫu thuật để sửa chữa những vết thương này thường có kết quả tốt. Triển vọng luôn tốt hơn nếu', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn gặp: Bị chấn thương nặng ở ngực Hít phải dị vật Các triệu chứng của nhiễm trùng ngực Cảm giác có bọt khí bên dưới da và khó thở';
MERGE (n:Disease {id: 'D3002'}) SET n.id = 'D3002', n.name = 'Viêm khí quản', n.name_en = 'Tracheitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000988.htm', n.prognosis = 'Nếu được điều trị kịp thời, trẻ sẽ bình phục.', n.when_to_see = 'Viêm khí quản là một tình trạng y tế khẩn cấp. Hãy đến phòng cấp cứu ngay nếu con bạn bị nhiễm trùng đường hô hấp trên gần đây và đột nhiên sốt cao, ho nặng hơn hoặc khó thở.';
MERGE (n:Disease {id: 'D3003'}) SET n.id = 'D3003', n.name = 'Sửa lỗ rò khí quản và teo thực quản', n.name_en = 'Tracheoesophageal fistula and esophageal atresia repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002934.htm', n.overview = 'Thực quản là ống dẫn thức ăn từ miệng đến dạ dày. Khí quản (khí quản) là ống dẫn không khí vào và ra khỏi phổi. Các khiếm khuyết thường xảy ra cùng nhau. Chúng có thể xảy ra cùng với các vấn đề khác n', n.prognosis = 'Phẫu thuật thường có thể sửa chữa TEF và EA. Sau khi quá trình lành vết thương sau phẫu thuật hoàn tất, con bạn có thể gặp những vấn đề sau: Phần thực quản đã được sửa chữa có thể trở nên hẹp hơn. Con';
MERGE (n:Disease {id: 'D3004'}) SET n.id = 'D3004', n.name = 'Tracheomalacia', n.name_en = 'Tracheomalacia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/tracheomalacia/symptoms-causes/syc-20587222', n.overview = '(tray-key-oh-muh-LAY-shuh) là tình trạng khí quản bị xẹp hoặc tụt vào trong. Khí quản, còn gọi là khí quản, là ống đưa không khí từ miệng và mũi đến phổi. Các vòng sụn chắc chắn giữ khí quản mở trong ', n.when_to_see = 'Nếu bạn lo lắng về sự tăng trưởng và phát triển của con mình, hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn. Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu con bạn gặp: Khó thở, chẳng hạn như ';
MERGE (n:Disease {id: 'D3005'}) SET n.id = 'D3005', n.name = 'Nhuyễn khí quản - mắc phải', n.name_en = 'Tracheomalacia - acquired', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007310.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn thở theo cách bất thường. Nhuyễn khí quản có thể trở thành tình trạng khẩn cấp hoặc cấp cứu.';
MERGE (n:Disease {id: 'D3006'}) SET n.id = 'D3006', n.name = 'Nhuyễn khí quản - bẩm sinh', n.name_en = 'Tracheomalacia - congenital', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001084.htm', n.prognosis = 'Nhuyễn khí quản bẩm sinh thường tự biến mất khi trẻ được 18 đến 24 tháng tuổi. Khi sụn khỏe hơn và khí quản phát triển, tình trạng khó thở và ồn ào dần dần được cải thiện. Những người mắc bệnh nhuyễn ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn khó thở hoặc thở ồn ào. Nhuyễn khí quản có thể trở thành tình trạng khẩn cấp hoặc cấp cứu.';
MERGE (n:Disease {id: 'D3007'}) SET n.id = 'D3007', n.name = 'Mở khí quản', n.name_en = 'Tracheostomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002955.htm', n.overview = 'Gây mê toàn thân được sử dụng, trừ khi tình huống nguy cấp. Nếu điều đó xảy ra, một loại thuốc gây tê sẽ được đặt vào khu vực đó để giúp bạn cảm thấy bớt đau hơn trong quá trình thực hiện. Các loại th', n.prognosis = 'Hầu hết mọi người cần từ 1 đến 3 ngày để thích nghi với việc thở qua ống mở khí quản. Sẽ mất một thời gian để học cách giao tiếp với người khác. Lúc đầu, người đó có thể không thể nói chuyện hoặc phát';
MERGE (n:Disease {id: 'D3008'}) SET n.id = 'D3008', n.name = 'Bệnh đau mắt hột', n.name_en = 'Trachoma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/trachoma/symptoms-causes/syc-20378505 | https://medlineplus.gov/ency/article/001486.htm', n.overview = '(truh-KOH-muh) là một bệnh nhiễm trùng do vi khuẩn ảnh hưởng đến mắt của bạn. Nguyên nhân là do vi khuẩn Chlamydia trachomatis gây ra. Bệnh đau mắt hột dễ lây lan, lây lan qua tiếp xúc với mắt, mí mắt', n.prognosis = 'Kết quả sẽ rất tốt nếu bắt đầu điều trị sớm trước khi sẹo và những thay đổi ở mí mắt phát triển.', n.when_to_see = 'Hãy gọi cho bác sĩ nếu bạn hoặc con bạn bị ngứa hoặc kích ứng mắt hoặc chảy nước mắt, đặc biệt nếu bạn sống hoặc gần đây đã đi du lịch đến một khu vực thường gặp bệnh mắt hột. Bệnh đau mắt hột là một ';
MERGE (n:Disease {id: 'D3009'}) SET n.id = 'D3009', n.name = 'Lực kéo', n.name_en = 'Traction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002336.htm', n.overview = 'Xử lý lực kéo sẽ bao gồm: Mức độ căng nhất định để kéo bộ phận cơ thể, có thể di chuyển nó sang vị trí khác Thời gian sử dụng lực căng Cách để giữ lực căng ổn định ở mức mong muốn, thường dựa trên trọ';
MERGE (n:Disease {id: 'D3010'}) SET n.id = 'D3010', n.name = 'Thay van động mạch chủ qua ống thông', n.name_en = 'Transcatheter aortic valve replacement', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007684.htm', n.overview = 'Thủ tục sẽ được thực hiện tại bệnh viện. Sẽ mất khoảng 2 đến 4 giờ. Trước khi thực hiện thủ thuật TAVR, bạn có thể được gây mê toàn thân. Điều này sẽ đưa bạn vào một giấc ngủ không đau đớn. Thông thườ', n.prognosis = 'Thực hiện thủ thuật này có thể cải thiện chất lượng cuộc sống của bạn và giúp bạn sống lâu hơn nếu không thực hiện thủ thuật. Bạn có thể thở dễ dàng hơn và có nhiều năng lượng hơn. Bạn có thể làm được';
MERGE (n:Disease {id: 'D3011'}) SET n.id = 'D3011', n.name = 'Tăng bilirubin máu mang tính gia đình thoáng qua', n.name_en = 'Transient familial hyperbilirubinemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001196.htm', n.prognosis = 'Những em bé được điều trị có thể có kết quả tốt. Nếu tình trạng không được điều trị, các biến chứng nghiêm trọng sẽ phát triển. Rối loạn này có xu hướng cải thiện theo thời gian.', n.when_to_see = 'Vấn đề này thường xảy ra nhất trong vài ngày đầu sau khi sinh. Tuy nhiên, hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khoẻ của bạn nếu bạn nhận thấy da của bé chuyển sang màu vàng. Có những nguy';
MERGE (n:Disease {id: 'D3012'}) SET n.id = 'D3012', n.name = 'Chứng mất trí nhớ toàn cầu thoáng qua', n.name_en = 'Transient global amnesia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/transient-global-amnesia/symptoms-causes/syc-20378531', n.overview = 'là một giai đoạn lú lẫn xảy ra đột ngột ở một người hoàn toàn tỉnh táo. Trạng thái bối rối này không phải do một tình trạng thần kinh phổ biến hơn gây ra, chẳng hạn như động kinh hoặc đột quỵ. Trong g', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế ngay lập tức cho bất kỳ ai nhanh chóng chuyển từ nhận thức bình thường về thực tế hiện tại sang nhầm lẫn về những gì vừa xảy ra. Nếu người bị mất trí nhớ quá bối rối để c';
MERGE (n:Disease {id: 'D3013'}) SET n.id = 'D3013', n.name = 'Cơn thiếu máu cục bộ thoáng qua', n.name_en = 'Transient ischemic attack', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000730.htm', n.prognosis = 'TIA không gây tổn thương lâu dài cho não. Tuy nhiên, TIA là dấu hiệu cảnh báo bạn có thể bị đột quỵ thực sự trong những ngày hoặc tháng tới. Một số người bị TIA sẽ bị đột quỵ trong vòng 3 tháng. Một n', n.when_to_see = 'TIA là một trường hợp cấp cứu y tế. Gọi 911 hoặc số khẩn cấp tại địa phương ngay lập tức. Đừng bỏ qua các triệu chứng chỉ vì chúng biến mất. Chúng có thể là cảnh báo về một cơn đột quỵ trong tương lai';
MERGE (n:Disease {id: 'D3014'}) SET n.id = 'D3014', n.name = 'Cơn thiếu máu cục bộ thoáng qua (TIA)', n.name_en = 'Transient ischemic attack (TIA)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/transient-ischemic-attack/symptoms-causes/syc-20355679', n.overview = 'Cơn thiếu máu cục bộ thoáng qua (TIA) là một khoảng thời gian ngắn có các triệu chứng tương tự như triệu chứng của đột quỵ. Nguyên nhân là do sự tắc nghẽn lưu lượng máu đến não trong thời gian ngắn. T', n.when_to_see = 'Nếu bạn cho rằng mình đang hoặc đã từng bị cơn thiếu máu cục bộ thoáng qua, hãy tìm kiếm sự chăm sóc y tế ngay lập tức. TIA thường xảy ra vài giờ hoặc vài ngày trước khi bị đột quỵ. Được đánh giá nhan';
MERGE (n:Disease {id: 'D3015'}) SET n.id = 'D3015', n.name = 'Thở nhanh thoáng qua - trẻ sơ sinh', n.name_en = 'Transient tachypnea - newborn', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007233.htm', n.prognosis = 'Tình trạng này thường biến mất trong vòng 48 đến 72 giờ sau khi sinh. Trong hầu hết các trường hợp, trẻ sơ sinh bị TTN không gặp vấn đề gì thêm với tình trạng này. Họ sẽ không cần được chăm sóc hoặc t';
MERGE (n:Disease {id: 'D3016'}) SET n.id = 'D3016', n.name = 'Shunt hệ thống cửa trong gan xuyên tĩnh mạch cảnh (TIPS)', n.name_en = 'Transjugular intrahepatic portosystemic shunt (TIPS)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007210.htm', n.overview = 'Đây không phải là một thủ tục phẫu thuật. Nó được thực hiện bởi bác sĩ X quang can thiệp sử dụng hướng dẫn của tia X. Bác sĩ X quang là bác sĩ sử dụng các kỹ thuật hình ảnh để chẩn đoán và điều trị bệ', n.prognosis = 'Bác sĩ X quang của bạn có thể cho bạn biết ngay quy trình này hoạt động tốt như thế nào. Hầu hết mọi người đều hồi phục tốt. TIPS có tác dụng với khoảng 80% đến 90% số người mắc bệnh tăng áp lực tĩnh ';
MERGE (n:Disease {id: 'D3017'}) SET n.id = 'D3017', n.name = 'Từ chối cấy ghép', n.name_en = 'Transplant rejection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000815.htm', n.prognosis = 'Thuốc ức chế hệ thống miễn dịch có thể ngăn chặn quá trình đào thải. Hầu hết mọi người cần phải dùng những loại thuốc này suốt đời. Các đợt thải ghép cấp tính hiếm khi dẫn đến suy nội tạng. Sự đào thả', n.when_to_see = 'Sau khi cấy ghép, điều quan trọng là phải thường xuyên đến gặp bác sĩ để họ có thể theo dõi bạn và cơ quan của bạn xem có bất kỳ dấu hiệu đào thải nào không. Liên hệ với nhà cung cấp của bạn nếu cơ qu';
MERGE (n:Disease {id: 'D3018'}) SET n.id = 'D3018', n.name = 'Dịch vụ cấy ghép', n.name_en = 'Transplant services', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007457.htm', n.overview = 'Phẫu thuật cấy ghép thường được thực hiện để thay thế bộ phận cơ thể bị bệnh bằng bộ phận khỏe mạnh. Cấy ghép nội tạng rắn Tự động ghép tế bào đảo được thực hiện sau khi một người bị cắt bỏ tuyến tụy ';
MERGE (n:Disease {id: 'D3019'}) SET n.id = 'D3019', n.name = 'Chuyển vị của các động mạch lớn', n.name_en = 'Transposition of the great arteries', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/transposition-of-the-great-arteries/symptoms-causes/syc-20350589 | https://medlineplus.gov/ency/article/001568.htm', n.overview = 'Vị trí của các động mạch lớn, các động mạch chính dẫn ra khỏi tim — động mạch chủ và động mạch phổi — được hoán đổi, còn gọi là chuyển vị. Chuyển vị các động mạch lớn, còn gọi là TGA, là một tình trạn', n.prognosis = 'Các triệu chứng của trẻ sẽ cải thiện sau phẫu thuật khắc phục khuyết điểm. Hầu hết trẻ sơ sinh được chuyển đổi động mạch đều không có triệu chứng sau phẫu thuật và sống cuộc sống bình thường. Nếu khôn', n.when_to_see = 'Tình trạng này có thể được chẩn đoán trước khi sinh bằng siêu âm tim thai. Nếu không, nó thường được chẩn đoán ngay sau khi em bé chào đời. Hãy đến phòng cấp cứu hoặc gọi số khẩn cấp tại địa phương (c';
MERGE (n:Disease {id: 'D3020'}) SET n.id = 'D3020', n.name = 'Cắt bỏ tuyến tiền liệt qua niệu đạo', n.name_en = 'Transurethral resection of the prostate', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002996.htm', n.overview = 'Ca phẫu thuật mất khoảng 1 đến 2 giờ. Bạn sẽ được tiêm thuốc trước khi phẫu thuật để không cảm thấy đau. Bạn có thể được gây mê toàn thân trong trường hợp bạn đang ngủ và không đau hoặc gây tê tủy sốn', n.prognosis = 'TURP làm giảm các triệu chứng của bệnh phì đại tuyến tiền liệt trong hầu hết các trường hợp. Bạn có thể bị nóng rát khi đi tiểu, tiểu ra máu, đi tiểu thường xuyên và cần đi tiểu gấp. Điều này thường g';
MERGE (n:Disease {id: 'D3021'}) SET n.id = 'D3021', n.name = 'Viêm tủy ngang', n.name_en = 'Transverse myelitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/transverse-myelitis/symptoms-causes/syc-20354726 | https://medlineplus.gov/ency/article/007766.htm', n.overview = 'là tình trạng viêm cả hai bên của một đoạn tủy sống. Rối loạn thần kinh này thường làm hỏng vật liệu cách điện bao phủ các sợi tế bào thần kinh (myelin). Viêm tủy cắt ngang làm gián đoạn các tín hiệu ', n.prognosis = 'Triển vọng của những người bị viêm tủy cắt ngang rất khác nhau. Hầu hết sự phục hồi xảy ra trong vòng 3 tháng sau khi tình trạng này xảy ra. Đối với một số người, quá trình lành vết thương có thể mất ', n.when_to_see = 'Gọi cho bác sĩ hoặc nhận dịch vụ chăm sóc y tế khẩn cấp nếu bạn gặp các dấu hiệu và triệu chứng của viêm tủy cắt ngang. Một số rối loạn thần kinh có thể gây ra các vấn đề về cảm giác, suy nhược và rối';
MERGE (n:Disease {id: 'D3022'}) SET n.id = 'D3022', n.name = 'Cắt cụt do chấn thương', n.name_en = 'Traumatic amputation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000006.htm', n.when_to_see = 'Nếu ai đó cắt đứt chi, ngón tay, ngón chân hoặc bộ phận cơ thể khác, bạn nên gọi ngay để được trợ giúp y tế khẩn cấp.';
MERGE (n:Disease {id: 'D3023'}) SET n.id = 'D3023', n.name = 'Chấn thương sọ não', n.name_en = 'Traumatic brain injury', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/traumatic-brain-injury/symptoms-causes/syc-20378557 | https://medlineplus.gov/ency/article/000799.htm', n.overview = 'thường là kết quả của một cú đánh hoặc va đập mạnh vào đầu hoặc cơ thể. Một vật thể xuyên qua mô não, chẳng hạn như một viên đạn hoặc mảnh sọ vỡ, cũng có thể gây chấn thương sọ não. Chấn thương sọ não', n.prognosis = 'Việc chữa lành hoặc phục hồi sau TBI cần có thời gian. Có thể mất vài ngày đến vài tuần, hoặc thậm chí vài tháng. Trong thời gian đó, bạn có thể: Thu mình, dễ buồn bã, bối rối hoặc có những thay đổi t', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Chấn thương ở đầu gây ra những thay đổi về khả năng tỉnh táo. Một người có các triệu chứng đáng lo ngại khác. Các triệu chứng không biến mất hoặc không cải th';
MERGE (n:Disease {id: 'D3024'}) SET n.id = 'D3024', n.name = 'Chấn thương bàng quang và niệu đạo', n.name_en = 'Traumatic injury of the bladder and urethra', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001063.htm', n.prognosis = 'Chấn thương bàng quang và niệu đạo do chấn thương có thể nhẹ hoặc gây tử vong. Các biến chứng nghiêm trọng ngắn hạn hoặc dài hạn có thể xảy ra.', n.when_to_see = 'Hãy gọi đến số điện thoại khẩn cấp tại địa phương (911) hoặc đến phòng cấp cứu nếu bạn bị chấn thương ở bàng quang hoặc niệu đạo. Liên hệ với nhà cung cấp dịch vụ của bạn nếu các triệu chứng trở nên t';
MERGE (n:Disease {id: 'D3025'}) SET n.id = 'D3025', n.name = 'Tiêu chảy của người du lịch', n.name_en = 'Traveler\'s diarrhea', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/travelers-diarrhea/symptoms-causes/syc-20352182', n.overview = 'Đường tiêu hóa từ miệng đến hậu môn của bạn. Nó bao gồm các cơ quan cần thiết để tiêu hóa thức ăn, hấp thụ chất dinh dưỡng và xử lý chất thải. Tiêu chảy du lịch là một chứng rối loạn đường tiêu hóa th', n.when_to_see = 'Bệnh tiêu chảy của người du lịch thường tự khỏi trong vòng vài ngày. Các triệu chứng có thể kéo dài hơn và nghiêm trọng hơn nếu do một số vi khuẩn hoặc ký sinh trùng gây ra. Trong những trường hợp như';
MERGE (n:Disease {id: 'D3026'}) SET n.id = 'D3026', n.name = 'Hướng dẫn du lịch để tránh các bệnh truyền nhiễm', n.name_en = 'Traveler\'s guide to avoiding infectious diseases', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001925.htm', n.overview = 'Bạn có thể giữ sức khỏe trong suốt chuyến du lịch bằng cách thực hiện các bước phù hợp để bảo vệ bản thân trước khi đi. Bạn cũng có thể làm những việc giúp ngăn ngừa bệnh tật khi đi du lịch. Hầu hết c';
MERGE (n:Disease {id: 'D3027'}) SET n.id = 'D3027', n.name = 'Quá liều trazodone', n.name_en = 'Trazodone overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002559.htm', n.prognosis = 'Tử vong có thể do dùng quá liều, nhưng trường hợp này rất hiếm. Các vấn đề về tim và hô hấp lâu dài cũng rất hiếm. Nếu hơi thở bị ức chế trong một thời gian dài trước khi điều trị, chấn thương não có ';
MERGE (n:Disease {id: 'D3028'}) SET n.id = 'D3028', n.name = 'Hội chứng Treacher Collins', n.name_en = 'Treacher Collins syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001659.htm', n.prognosis = 'Trẻ em mắc bệnh này thường phát triển để trở thành những người trưởng thành hoạt động bình thường và có trí thông minh bình thường.', n.when_to_see = 'Tình trạng này thường thấy nhất khi mới sinh. Tư vấn di truyền có thể giúp các gia đình hiểu được tình trạng bệnh và cách chăm sóc người bệnh.';
MERGE (n:Disease {id: 'D3029'}) SET n.id = 'D3029', n.name = 'Run', n.name_en = 'Tremor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003192.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu cơn run của bạn: Tệ hơn khi nghỉ ngơi và đỡ hơn khi vận động, chẳng hạn như khi bạn với lấy thứ gì đó Kéo dài, nghiêm trọng hoặc cản trở ';
MERGE (n:Disease {id: 'D3030'}) SET n.id = 'D3030', n.name = 'Miệng rãnh', n.name_en = 'Trench mouth', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001044.htm', n.prognosis = 'Nhiễm trùng thường đáp ứng với điều trị. Rối loạn này có thể khá đau đớn cho đến khi được điều trị. Nếu miệng rãnh không được điều trị kịp thời, nhiễm trùng có thể lan sang má, môi hoặc xương hàm. Nó ', n.when_to_see = 'Liên hệ với nha sĩ nếu bạn có các triệu chứng của miệng rãnh, hoặc nếu sốt hoặc các triệu chứng mới khác phát triển.';
MERGE (n:Disease {id: 'D3031'}) SET n.id = 'D3031', n.name = 'Trichinosis', n.name_en = 'Trichinosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/trichinosis/symptoms-causes/syc-20378583 | https://medlineplus.gov/ency/article/000631.htm', n.overview = '(trik-ih-NO-sis) là một loại bệnh nhiễm trùng do ký sinh trùng giun đũa gây ra. Giun đũa ký sinh sử dụng cơ thể vật chủ để sống và sinh sản nhiều giun tròn hơn. Những ký sinh trùng này, còn được gọi l', n.prognosis = 'Hầu hết những người mắc bệnh trichinosis không có triệu chứng và nhiễm trùng sẽ tự biến mất. Nhiễm trùng nặng hơn có thể khó điều trị, đặc biệt nếu có liên quan đến phổi, tim hoặc não.', n.when_to_see = 'Nếu bạn bị bệnh trichinosis nhẹ không có triệu chứng, bạn có thể không cần chăm sóc y tế. Nếu bạn gặp vấn đề về tiêu hóa hoặc đau cơ và sưng tấy khoảng một tuần sau khi ăn thịt lợn hoặc thịt động vật ';
MERGE (n:Disease {id: 'D3032'}) SET n.id = 'D3032', n.name = 'Trichomonas', n.name_en = 'Trichomoniasis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/trichomoniasis/symptoms-causes/syc-20378609 | https://medlineplus.gov/ency/article/001331.htm', n.overview = 'là một bệnh lây truyền qua đường tình dục phổ biến. Một ký sinh trùng gây ra nó. Ký sinh trùng có thể lây lan qua việc chạm vào bộ phận sinh dục và quan hệ tình dục mà không dùng bao cao su. Ở phụ nữ,', n.prognosis = 'Nếu được điều trị thích hợp, bạn có khả năng bình phục hoàn toàn.', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có bất kỳ triệu chứng nào của bệnh trichomonas. Đồng thời, hãy nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu bạn biết rằng bạn tình bị nh';
MERGE (n:Disease {id: 'D3033'}) SET n.id = 'D3033', n.name = 'Trichorrhexis nodosa', n.name_en = 'Trichorrhexis nodosa', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001449.htm', n.prognosis = 'Cải thiện kỹ thuật chải chuốt và tránh các sản phẩm làm hỏng tóc sẽ giúp khắc phục vấn đề. Tình trạng này không nguy hiểm nhưng có thể ảnh hưởng đến lòng tự trọng của một người', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu các triệu chứng không cải thiện khi thay đổi cách chải lông và các biện pháp chăm sóc tại nhà khác';
MERGE (n:Disease {id: 'D3034'}) SET n.id = 'D3034', n.name = 'Trichotillomania', n.name_en = 'Trichotillomania', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001517.htm', n.prognosis = 'Trichotillomania bắt đầu ở trẻ nhỏ (dưới 6 tuổi) có thể tự khỏi mà không cần điều trị. Đối với hầu hết mọi người, tình trạng nhổ tóc sẽ kết thúc trong vòng 12 tháng. Đối với những người khác, trichoti';
MERGE (n:Disease {id: 'D3035'}) SET n.id = 'D3035', n.name = 'Trichotillomania (rối loạn kéo tóc)', n.name_en = 'Trichotillomania (hair-pulling disorder)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/trichotillomania/symptoms-causes/syc-20355188', n.overview = 'Trichotillomania (trik-o-til-o-MAY-nee-uh), còn được gọi là rối loạn kéo tóc, là một tình trạng sức khỏe tâm thần. Nó liên quan đến sự thôi thúc thường xuyên, lặp đi lặp lại và không thể cưỡng lại đượ', n.when_to_see = 'Nếu bạn không thể ngừng nhổ tóc hoặc do đó bạn cảm thấy xấu hổ hay xấu hổ về ngoại hình của mình, hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Trichotillomania không chỉ là một t';
MERGE (n:Disease {id: 'D3036'}) SET n.id = 'D3036', n.name = 'Chứng teo ba lá', n.name_en = 'Tricuspid atresia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/tricuspid-atresia/symptoms-causes/syc-20368392 | https://medlineplus.gov/ency/article/001110.htm', n.overview = 'là một vấn đề về tim xuất hiện khi mới sinh, được gọi là dị tật tim bẩm sinh. Van không được hình thành giữa hai buồng tim phải. Thay vào đó, một tấm mô đặc sẽ chặn dòng máu chảy giữa các buồng tim ph', n.prognosis = 'Trong hầu hết các trường hợp, phẫu thuật sẽ cải thiện tình trạng.', n.when_to_see = 'Dị tật tim bẩm sinh nghiêm trọng được chẩn đoán trước hoặc ngay sau khi con bạn chào đời. Nếu bạn nhận thấy con mình có những thay đổi về màu da, khó thở, tăng trưởng chậm hoặc tăng cân kém, hãy liên ';
MERGE (n:Disease {id: 'D3037'}) SET n.id = 'D3037', n.name = 'Hở van ba lá', n.name_en = 'Tricuspid regurgitation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000169.htm', n.prognosis = 'Phẫu thuật sửa chữa hoặc thay van thường cung cấp phương pháp chữa trị cho những người cần can thiệp. Triển vọng rất kém đối với những người bị hở van ba lá nặng có triệu chứng và không thể khắc phục ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng hở van ba lá.';
MERGE (n:Disease {id: 'D3038'}) SET n.id = 'D3038', n.name = 'Bệnh van ba lá', n.name_en = 'Tricuspid valve disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/tricuspid-valve-disease/symptoms-causes/syc-20350609', n.overview = 'Các buồng và van tim có hai ngăn trên và hai ngăn dưới. Các buồng trên, tâm nhĩ phải và trái, nhận máu đến. Các buồng dưới, tâm thất phải và trái có nhiều cơ bắp hơn, bơm máu ra khỏi tim. Van tim giúp', n.when_to_see = 'Nếu bạn có những thay đổi về nhịp tim hoặc suy nhược hoặc mệt mỏi không rõ nguyên nhân, hãy đặt lịch hẹn để kiểm tra sức khỏe. Bạn có thể được gửi đến một bác sĩ được đào tạo về bệnh tim, được gọi là ';
MERGE (n:Disease {id: 'D3039'}) SET n.id = 'D3039', n.name = 'Đau dây thần kinh sinh ba', n.name_en = 'Trigeminal neuralgia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/trigeminal-neuralgia/symptoms-causes/syc-20353344 | https://medlineplus.gov/ency/article/000742.htm', n.overview = '(try-JEM-ih-nul nu-RAL-juh) là tình trạng gây đau dữ dội tương tự như bị điện giật ở một bên mặt. Nó ảnh hưởng đến dây thần kinh sinh ba, dây truyền tín hiệu từ mặt đến não. Ngay cả những cú chạm nhẹ ', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào nguyên nhân của vấn đề. Nếu không có bệnh nào gây ra vấn đề, việc điều trị có thể giúp giảm bớt phần nào. Ở một số người, cơn đau trở nên liên tục và dữ dội.', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe nếu bạn cảm thấy đau ở mặt, đặc biệt nếu tình trạng này kéo dài hoặc tái phát sau khi đi khỏi. Đồng thời, hãy tìm kiếm sự chăm sóc y tế nếu bạn bị đau mãn tính';
MERGE (n:Disease {id: 'D3040'}) SET n.id = 'D3040', n.name = 'Ngón tay cò súng', n.name_en = 'Trigger finger', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/trigger-finger/symptoms-causes/syc-20365100', n.overview = 'khiến ngón tay bị kẹt ở tư thế cong. Nó có thể thẳng đột ngột chỉ trong tích tắc. Các ngón tay thường bị ảnh hưởng nhất là ngón đeo nhẫn và ngón cái, nhưng tình trạng này có thể ảnh hưởng đến bất kỳ n';
MERGE (n:Disease {id: 'D3041'}) SET n.id = 'D3041', n.name = 'Hội chứng Triple X', n.name_en = 'Triple X syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/triple-x-syndrome/symptoms-causes/syc-20350977', n.overview = ', còn được gọi là trisomy X hoặc 47,XXX, là một rối loạn di truyền ảnh hưởng đến khoảng 1 trên 1.000 phụ nữ. Con cái thường có hai nhiễm sắc thể X trong tất cả các tế bào - một nhiễm sắc thể X từ bố h', n.when_to_see = 'Nếu bạn lo lắng về bất kỳ dấu hiệu hoặc triệu chứng nào, hãy đặt lịch hẹn để nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe gia đình hoặc bác sĩ nhi khoa, người có thể giúp xác định nguyên nhân';
MERGE (n:Disease {id: 'D3042'}) SET n.id = 'D3042', n.name = 'Ngộ độc trisodium phosphate', n.name_en = 'Trisodium phosphate poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002489.htm', n.prognosis = 'Sức khỏe của một người như thế nào tùy thuộc vào lượng tiếp xúc với chất độc (nuốt, hít, trên da hoặc trong mắt) và tốc độ điều trị được tiếp nhận. Một người nhận được trợ giúp y tế càng nhanh thì cơ ';
MERGE (n:Disease {id: 'D3043'}) SET n.id = 'D3043', n.name = 'Trisomy 13', n.name_en = 'Trisomy 13', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001660.htm', n.prognosis = 'Hơn 90% trẻ em mắc trisomy 13 tử vong trong năm đầu tiên.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn đã có con mắc bệnh trisomy 13 và bạn dự định sinh thêm một đứa con nữa. Tư vấn di truyền có thể giúp các gia đình hiểu được tình ';
MERGE (n:Disease {id: 'D3044'}) SET n.id = 'D3044', n.name = 'Trisomy 18', n.name_en = 'Trisomy 18', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001661.htm', n.prognosis = 'Một nửa số trẻ sơ sinh mắc bệnh này không thể sống sót sau tuần đầu tiên của cuộc đời. Chín trong số mười đứa trẻ sẽ chết trước 1 tuổi. Một số trẻ em sống sót đến tuổi thiếu niên nhưng gặp phải các vấ', n.when_to_see = 'Tư vấn di truyền có thể giúp các gia đình hiểu được tình trạng bệnh, những rủi ro khi di truyền và cách chăm sóc người bệnh.';
MERGE (n:Disease {id: 'D3045'}) SET n.id = 'D3045', n.name = 'Bệnh nhiệt đới', n.name_en = 'Tropical sprue', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000275.htm', n.prognosis = 'Kết quả điều trị là tốt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Các triệu chứng của bệnh nhiệt đới trở nên trầm trọng hơn hoặc không cải thiện khi điều trị. Bạn phát triển các triệu chứng mới. Bạn';
MERGE (n:Disease {id: 'D3046'}) SET n.id = 'D3046', n.name = 'Thân chung động mạch', n.name_en = 'Truncus arteriosus', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/truncus-arteriosus/symptoms-causes/syc-20364247 | https://medlineplus.gov/ency/article/001111.htm', n.overview = 'nằm ngoài tim, thay vì hai thân riêng biệt. Ngoài ra còn có một lỗ trên thành giữa các buồng tim phía dưới, được gọi là tâm thất. Lỗ này được gọi là thông liên thất. Trong thân động mạch, máu giàu oxy', n.prognosis = 'Sửa chữa hoàn chỉnh thường mang lại kết quả tốt. Một thủ tục khác có thể cần thiết khi trẻ lớn lên, vì động mạch phổi được tái tạo sử dụng mô từ nguồn khác sẽ không phát triển cùng với trẻ. Các trường', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu trẻ sơ sinh hoặc trẻ nhỏ của bạn: Có vẻ hôn mê Có vẻ quá mệt mỏi hoặc hơi khó thở Không ăn uống tốt Có vẻ như không tăng trưởng h';
MERGE (n:Disease {id: 'D3047'}) SET n.id = 'D3047', n.name = 'Thắt ống dẫn trứng', n.name_en = 'Tubal ligation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002913.htm', n.overview = 'được thực hiện tại bệnh viện hoặc cơ sở phẫu thuật ngoại trú. Bạn có thể được gây mê toàn thân. Bạn sẽ ngủ và không thể cảm thấy đau. Hoặc, bạn sẽ tỉnh táo và được gây tê tủy sống. Bạn cũng có thể nhậ', n.prognosis = 'Hầu hết phụ nữ sẽ không gặp vấn đề gì. Thắt ống dẫn trứng là một hình thức ngừa thai hiệu quả. Nếu thủ thuật được thực hiện bằng nội soi hoặc sau khi sinh con, bạn sẽ KHÔNG cần phải làm thêm bất kỳ xé';
MERGE (n:Disease {id: 'D3048'}) SET n.id = 'D3048', n.name = 'Đảo ngược thắt ống dẫn trứng', n.name_en = 'Tubal ligation reversal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007651.htm', n.prognosis = 'Hầu hết phụ nữ không gặp vấn đề gì với chính cuộc phẫu thuật. Khoảng từ 30% đến 50% đến 70% đến 80% phụ nữ có thể mang thai. Việc phụ nữ có thai sau phẫu thuật này hay không có thể phụ thuộc vào: Tuổi';
MERGE (n:Disease {id: 'D3049'}) SET n.id = 'D3049', n.name = 'Bệnh lao', n.name_en = 'Tuberculosis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/tuberculosis/symptoms-causes/syc-20351250', n.overview = ', còn gọi là bệnh lao, là một căn bệnh nghiêm trọng chủ yếu ảnh hưởng đến phổi. Vi trùng gây bệnh lao là một loại vi khuẩn. Bệnh lao có thể lây lan khi người bệnh ho, hắt hơi hoặc hát. Điều này có thể', n.when_to_see = 'Triệu chứng của bệnh lao cũng giống như triệu chứng của nhiều bệnh khác nhau. Hãy gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng không cải thiện sau một vài ngày nghỉ ngơi. Nhận c';
MERGE (n:Disease {id: 'D3050'}) SET n.id = 'D3050', n.name = 'Bệnh xơ cứng củ', n.name_en = 'Tuberous sclerosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/tuberous-sclerosis/symptoms-causes/syc-20365969 | https://medlineplus.gov/ency/article/000787.htm', n.overview = '(TOO-bur-us skluh-ROH-sis), còn được gọi là phức hợp xơ cứng củ (TSC), là một rối loạn di truyền hiếm gặp khiến khối u phát triển ở nhiều bộ phận trên cơ thể. Những khối u này không phải là ung thư. C', n.prognosis = 'Trẻ em bị bệnh xơ cứng củ nhẹ thường có kết quả tốt nhất. Tuy nhiên, trẻ chậm phát triển trí tuệ nặng hoặc bị động kinh không kiểm soát được thường cần được hỗ trợ suốt đời. Đôi khi, khi một đứa trẻ s', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Một trong hai bên gia đình bạn có tiền sử bệnh xơ cứng củ Bạn nhận thấy các triệu chứng của bệnh xơ cứng củ ở con mình Liên hệ với chuyê';
MERGE (n:Disease {id: 'D3051'}) SET n.id = 'D3051', n.name = 'U tuyến ống của đại tràng', n.name_en = 'Tubular adenoma of the colon', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/tubular-adenoma-of-the-colon/symptoms-causes/syc-20592117', n.overview = 'U tuyến ống là một loại polyp đại tràng hình thành trên lớp lót bên trong của ruột già. Đây là loại u tuyến phổ biến nhất được tìm thấy trong quá trình nội soi và được coi là tiền ung thư. Điều này có';
MERGE (n:Disease {id: 'D3052'}) SET n.id = 'D3052', n.name = 'Bệnh sốt thỏ', n.name_en = 'Tularemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000856.htm', n.prognosis = 'Bệnh sốt thỏ gây tử vong trong khoảng 10% trường hợp không được điều trị và dưới 1% trường hợp được điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu các triệu chứng phát triển sau khi bị loài gặm nhấm cắn, vết cắn của bọ ve hoặc tiếp xúc với thịt của động vật hoang dã.';
MERGE (n:Disease {id: 'D3053'}) SET n.id = 'D3053', n.name = 'Khối u', n.name_en = 'Tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001310.htm', n.prognosis = 'Triển vọng rất khác nhau đối với các loại khối u khác nhau. Nếu khối u lành tính, tiên lượng nói chung là rất tốt. Nhưng một khối u lành tính đôi khi có thể gây ra những vấn đề nghiêm trọng, chẳng hạn';
MERGE (n:Disease {id: 'D3054'}) SET n.id = 'D3054', n.name = 'Phẫu thuật cuốn cuốn cuốn', n.name_en = 'Turbinate surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007563.htm', n.overview = 'Có một số loại phẫu thuật cuốn cuốn cuốn: Cắt cuốn cuốn cuốn: Tất cả hoặc một phần cuốn cuốn dưới được lấy ra. Điều này có thể được thực hiện theo nhiều cách khác nhau, nhưng đôi khi một thiết bị nhỏ,', n.prognosis = 'Bạn sẽ về nhà ngay trong ngày phẫu thuật. Bạn sẽ cảm thấy khó chịu và đau nhức ở mặt trong 2 hoặc 3 ngày. Mũi của bạn sẽ có cảm giác bị nghẹt cho đến khi tình trạng sưng tấy giảm bớt. Bạn có thể cảm t';
MERGE (n:Disease {id: 'D3055'}) SET n.id = 'D3055', n.name = 'Hội chứng Turner', n.name_en = 'Turner syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/turner-syndrome/symptoms-causes/syc-20360782 | https://medlineplus.gov/ency/article/000379.htm', n.overview = ', một tình trạng chỉ ảnh hưởng đến nữ giới, xảy ra khi một trong các nhiễm sắc thể X (nhiễm sắc thể giới tính) bị thiếu hoặc thiếu một phần. Hội chứng Turner có thể gây ra nhiều vấn đề về y tế và phát', n.prognosis = 'Những người mắc hội chứng Turner có thể có cuộc sống bình thường khi được nhà cung cấp dịch vụ theo dõi cẩn thận.', n.when_to_see = 'Đôi khi rất khó để phân biệt các dấu hiệu và triệu chứng của hội chứng Turner với các rối loạn khác. Điều quan trọng là phải có được chẩn đoán nhanh chóng, chính xác và chăm sóc thích hợp. Hãy đi khám';
MERGE (n:Disease {id: 'D3056'}) SET n.id = 'D3056', n.name = 'Ngộ độc dầu nhựa thông', n.name_en = 'Turpentine oil poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002746.htm', n.prognosis = 'Sức khỏe của một người nào đó phụ thuộc vào lượng nhựa thông họ nuốt và tốc độ họ nhận được nhanh như thế nào điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nhựa thông có thể gây ';
MERGE (n:Disease {id: 'D3057'}) SET n.id = 'D3057', n.name = 'Hội chứng truyền máu từ song sinh sang song sinh', n.name_en = 'Twin-to-twin transfusion syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001595.htm', n.prognosis = 'Nếu việc truyền máu song sinh ở mức độ nhẹ thì cả hai bé thường hồi phục hoàn toàn. Trường hợp nặng có thể dẫn đến cái chết của cặp song sinh.';
MERGE (n:Disease {id: 'D3058'}) SET n.id = 'D3058', n.name = 'Bệnh tiểu đường loại 1', n.name_en = 'Type 1 diabetes', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/type-1-diabetes/symptoms-causes/syc-20353011 | https://medlineplus.gov/ency/article/000305.htm', n.overview = 'Bệnh tiểu đường loại 1 là gì? Chuyên gia của Mayo Clinic giải thích Tìm hiểu thêm về bệnh tiểu đường loại 1 từ bác sĩ nội tiết Yogish Kudva, M.B.B.S. Hiển thị bản ghi cho video Bệnh tiểu đường loại 1 ', n.prognosis = 'Bệnh tiểu đường loại 1 là bệnh suốt đời và không có cách chữa trị. Kiểm soát chặt chẽ lượng đường trong máu có thể ngăn ngừa, trì hoãn và giảm thiểu các biến chứng của bệnh tiểu đường. Nhưng những vấn', n.when_to_see = 'Hãy gọi 911 hoặc số cấp cứu tại địa phương nếu bạn bị: Đau ngực hoặc tức ngực, khó thở hoặc các dấu hiệu đau thắt ngực khác Mất ý thức Động kinh Khó thở Da đỏ, đau và lan nhanh Liên hệ với nhà cung cấ';
MERGE (n:Disease {id: 'D3059'}) SET n.id = 'D3059', n.name = 'Bệnh tiểu đường loại 1 ở trẻ em', n.name_en = 'Type 1 diabetes in children', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/type-1-diabetes-in-children/symptoms-causes/syc-20355306', n.overview = 'là tình trạng cơ thể con bạn không còn sản xuất ra một loại hormone quan trọng (insulin). Con bạn cần insulin để tồn tại, vì vậy lượng insulin bị thiếu cần được thay thế bằng cách tiêm hoặc bơm insuli', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu bạn nhận thấy bất kỳ dấu hiệu hoặc triệu chứng nào của bệnh tiểu đường loại 1. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho';
MERGE (n:Disease {id: 'D3060'}) SET n.id = 'D3060', n.name = 'Bệnh tiểu đường loại 2', n.name_en = 'Type 2 diabetes', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/type-2-diabetes/symptoms-causes/syc-20351193 | https://medlineplus.gov/ency/article/000313.htm', n.overview = 'xảy ra khi cơ thể không thể sử dụng insulin một cách chính xác và lượng đường tích tụ trong máu. Nó từng được gọi là bệnh tiểu đường khởi phát ở người lớn. Theo thời gian, lượng đường trong máu cao ở ', n.prognosis = 'Bệnh tiểu đường loại 2 là một căn bệnh suốt đời và không có cách chữa trị. Một số người mắc bệnh tiểu đường loại 2 không còn cần dùng thuốc để kiểm soát lượng đường trong máu nếu họ giảm cân và trở nê', n.when_to_see = 'Gọi 911 hoặc số cấp cứu tại địa phương ngay nếu bạn bị: Đau ngực hoặc tức ngực Ngất xỉu, lú lẫn hoặc bất tỉnh Co giật Khó thở Da đỏ, đau và lan nhanh Các triệu chứng này có thể nhanh chóng trở nên tồi';
MERGE (n:Disease {id: 'D3061'}) SET n.id = 'D3061', n.name = 'Bệnh tiểu đường loại 2 ở trẻ em', n.name_en = 'Type 2 diabetes in children', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/type-2-diabetes-in-children/symptoms-causes/syc-20355318', n.overview = 'là một bệnh mãn tính ảnh hưởng đến cách cơ thể con bạn xử lý đường (glucose) làm nhiên liệu. Nếu không điều trị, chứng rối loạn này sẽ khiến đường tích tụ trong máu, có thể dẫn đến hậu quả nghiêm trọn', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu bạn nhận thấy bất kỳ dấu hiệu hoặc triệu chứng nào của bệnh tiểu đường loại 2. Nếu không được chẩn đoán, bệnh có thể gây ra thiệt hại ngh';
MERGE (n:Disease {id: 'D3062'}) SET n.id = 'D3062', n.name = 'Bệnh lưu trữ glycogen loại V', n.name_en = 'Type V glycogen storage disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000329.htm', n.prognosis = 'Những người mắc GSD V có thể sống một cuộc sống bình thường bằng cách quản lý chế độ ăn uống và hoạt động thể chất của họ.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn liên tục bị đau hoặc chuột rút cơ bắp sau khi tập thể dục, đặc biệt nếu bạn cũng có nước tiểu màu đỏ tía hoặc hồng. Hãy cân nhắc tư vấn di truyền n';
MERGE (n:Disease {id: 'D3063'}) SET n.id = 'D3063', n.name = 'Các loại nhà cung cấp dịch vụ chăm sóc sức khỏe', n.name_en = 'Types of health care providers', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001933.htm', n.overview = 'CHĂM SÓC CHÍNH Nhà cung cấp dịch vụ chăm sóc chính (PCP) là người mà bạn có thể tư vấn hoặc gặp đầu tiên để kiểm tra sức khỏe và các vấn đề về sức khỏe. PCP có thể giúp quản lý sức khỏe tổng thể của b';
MERGE (n:Disease {id: 'D3064'}) SET n.id = 'D3064', n.name = 'Sốt thương hàn', n.name_en = 'Typhoid fever', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/typhoid-fever/symptoms-causes/syc-20378661 | https://medlineplus.gov/ency/article/001332.htm', n.overview = 'là một bệnh nhiễm trùng đe dọa tính mạng, ảnh hưởng đến hàng triệu người mỗi năm. Một chủng vi khuẩn salmonella nhất định gây ra nó. Sốt thương hàn hiếm gặp ở những nơi có ít người mang vi khuẩn. Cũng', n.prognosis = 'Các triệu chứng thường cải thiện sau 2 đến 4 tuần điều trị. Kết quả có thể tốt nếu điều trị sớm nhưng sẽ kém nếu có biến chứng. Các triệu chứng có thể quay trở lại nếu việc điều trị không chữa khỏi ho', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có bất kỳ dấu hiệu nào sau đây: Bạn biết mình đã tiếp xúc với người mắc bệnh thương hàn Bạn đã đến khu vực có những người mắc bệnh thương hàn và bạn xu';
MERGE (n:Disease {id: 'D3065'}) SET n.id = 'D3065', n.name = 'Bệnh sốt phát ban', n.name_en = 'Typhus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001363.htm', n.prognosis = 'Những người mắc bệnh sốt phát ban được điều trị nhanh chóng sẽ khỏi bệnh hoàn toàn. Nếu không điều trị, tử vong có thể xảy ra, trong đó những người trên 60 tuổi có nguy cơ tử vong cao nhất. Chỉ một số', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng của bệnh sốt phát ban. Rối loạn nghiêm trọng này có thể cần được chăm sóc khẩn cấp.';
MERGE (n:Disease {id: 'D3066'}) SET n.id = 'D3066', n.name = 'Viêm loét đại tràng', n.name_en = 'Ulcerative colitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/ulcerative-colitis/symptoms-causes/syc-20353326 | https://medlineplus.gov/ency/article/000250.htm', n.overview = 'Viêm loét đại tràng là gì? Chuyên gia của Mayo Clinic giải thích Hãy lắng nghe bác sĩ tiêu hóa William Faubion, M.D., tìm hiểu những điều cơ bản về viêm loét đại tràng. Hiển thị bản ghi cho video Viêm', n.prognosis = 'Các triệu chứng nhẹ ở khoảng một nửa số người bị viêm loét đại tràng. Các triệu chứng nghiêm trọng hơn ít có khả năng đáp ứng tốt với thuốc. Việc chữa khỏi bệnh chỉ có thể thực hiện được bằng cách cắt', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn nhận thấy sự thay đổi trong thói quen đại tiện kéo dài một thời gian hoặc nếu bạn có các triệu chứng như: Đau bụng. Máu trong phân. Tiêu chảy liên tục khôn';
MERGE (n:Disease {id: 'D3067'}) SET n.id = 'D3067', n.name = 'Rối loạn chức năng dây thần kinh trụ', n.name_en = 'Ulnar nerve dysfunction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000789.htm', n.prognosis = 'Nếu có thể tìm ra nguyên nhân gây ra chứng rối loạn chức năng thần kinh và điều trị thành công thì khả năng hồi phục hoàn toàn là rất cao. Trong một số trường hợp, có thể mất một phần hoặc toàn bộ khả', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị chấn thương ở cánh tay và bị tê, ngứa ran, đau hoặc yếu ở cẳng tay, ngón đeo nhẫn và ngón út.';
MERGE (n:Disease {id: 'D3068'}) SET n.id = 'D3068', n.name = 'Đau cổ tay trụ', n.name_en = 'Ulnar wrist pain', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ulnar-wrist-pain/symptoms-causes/syc-20355510', n.overview = 'là cơn đau ở một bên cổ tay đối diện với ngón cái. Xương trụ là một trong hai xương cẳng tay. Đau cổ tay có thể khác nhau, tùy thuộc vào nguyên nhân. Đau cổ tay trụ có thể liên quan đến nhiều loại chấ';
MERGE (n:Disease {id: 'D3069'}) SET n.id = 'D3069', n.name = 'Thực phẩm siêu chế biến', n.name_en = 'Ultra-processed foods', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007847.htm', n.overview = 'Chế biến thực phẩm là bất kỳ sự thay đổi nào được thực hiện đối với thực phẩm từ trạng thái tự nhiên của nó. Nó bao gồm các quá trình như rửa, làm nóng, làm mát, nghiền, tinh chế và đóng gói. Chế biến';
MERGE (n:Disease {id: 'D3070'}) SET n.id = 'D3070', n.name = 'Thoát vị rốn', n.name_en = 'Umbilical hernia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/umbilical-hernia/symptoms-causes/syc-20378685 | https://medlineplus.gov/ency/article/000987.htm', n.overview = 'Thoát vị rốn xảy ra khi một phần ruột của bạn phình ra qua lỗ hở ở cơ bụng gần rốn (rốn). Thoát vị rốn là tình trạng phổ biến và thường vô hại. Thoát vị rốn Thoát vị rốn tạo ra một khối sưng mềm hoặc ', n.prognosis = 'Hầu hết chứng thoát vị rốn sẽ thuyên giảm mà không cần điều trị khi trẻ được 3 đến 4 tuổi. Nếu cần phẫu thuật thì thường thành công.', n.when_to_see = 'Nếu bạn nghi ngờ con mình bị thoát vị rốn, hãy nói chuyện với bác sĩ của bé. Hãy tìm kiếm sự chăm sóc khẩn cấp nếu con bạn bị thoát vị rốn và: Có vẻ đau đớn Bắt đầu nôn mửa Có cảm giác đau, sưng tấy h';
MERGE (n:Disease {id: 'D3071'}) SET n.id = 'D3071', n.name = 'Phẫu thuật thoát vị rốn', n.name_en = 'Umbilical hernia repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002935.htm', n.overview = 'Bạn có thể sẽ được gây mê toàn thân (ngủ và không đau) cho ca phẫu thuật này. Nếu thoát vị của bạn nhỏ, bạn có thể được gây tê tủy sống, gây tê ngoài màng cứng hoặc gây tê cục bộ và dùng thuốc để giúp', n.prognosis = 'Luôn có nguy cơ thoát vị quay trở lại. Đối với người khỏe mạnh, nguy cơ tái phát là rất thấp.';
MERGE (n:Disease {id: 'D3072'}) SET n.id = 'D3072', n.name = 'Bất tỉnh - sơ cứu', n.name_en = 'Unconsciousness - first aid', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000022.htm', n.when_to_see = 'Gọi 911 hoặc số cấp cứu tại địa phương nếu người đó bất tỉnh và: Không tỉnh lại nhanh chóng (trong vòng một phút) Bị ngã hoặc bị thương, đặc biệt nếu họ đang chảy máu Bị tiểu đường Bị co giật Mất kiểm';
MERGE (n:Disease {id: 'D3073'}) SET n.id = 'D3073', n.name = 'Tinh hoàn ẩn', n.name_en = 'Undescended testicle', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/undescended-testicle/symptoms-causes/syc-20351995 | https://medlineplus.gov/ency/article/000973.htm', n.overview = 'Một tinh hoàn không di chuyển xuống vị trí thích hợp trong bìu trước khi sinh được gọi là tinh hoàn ẩn. Nó còn được gọi là tinh hoàn ẩn (krip-TOR-kih-diz-um). Thông thường, đó chỉ là một tinh hoàn khô', n.prognosis = 'Hầu hết, vấn đề sẽ biến mất mà không cần điều trị. Thuốc hoặc phẫu thuật để điều chỉnh tình trạng này thành công trong hầu hết các trường hợp. Sau khi tình trạng được khắc phục, bạn nên được bác sĩ kh', n.when_to_see = 'Tinh hoàn ẩn thường được phát hiện khi khám bệnh ngay sau khi sinh. Nếu em bé của bạn có tinh hoàn ẩn, hãy hỏi tần suất khám cần phải được thực hiện. Nếu tinh hoàn không di chuyển vào bìu khi được 3 đ';
MERGE (n:Disease {id: 'D3074'}) SET n.id = 'D3074', n.name = 'Sửa chữa tinh hoàn ẩn', n.name_en = 'Undescended testicle repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003002.htm', n.overview = 'Tinh hoàn phát triển trong bụng trẻ sơ sinh khi trẻ lớn lên trong bụng mẹ. Chúng rơi xuống bìu trong những tháng cuối trước khi sinh. Trong một số trường hợp, một hoặc cả hai tinh hoàn không rơi vào đ', n.prognosis = 'Phẫu thuật có thể được thực hiện trên cơ sở ngoại trú. Nên nghỉ ngơi tại giường trong 2 đến 3 ngày đầu tiên. Tránh hoạt động gắng sức, kể cả đi xe đạp, trong ít nhất 1 tháng.';
MERGE (n:Disease {id: 'D3075'}) SET n.id = 'D3075', n.name = 'Sarcoma đa hình không phân biệt', n.name_en = 'Undifferentiated pleomorphic sarcoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/undifferentiated-pleomorphic-sarcoma/symptoms-causes/syc-20389554', n.overview = '(UPS) là một loại ung thư hiếm gặp, bắt đầu chủ yếu ở các mô mềm của cơ thể. Các mô mềm kết nối, hỗ trợ và bao quanh các cấu trúc khác của cơ thể. UPS thường xảy ra ở cánh tay hoặc chân. Ít thường xuy', n.when_to_see = 'Hãy hẹn gặp bác sĩ nếu bạn phát triển bất kỳ dấu hiệu hoặc triệu chứng dai dẳng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông t';
MERGE (n:Disease {id: 'D3076'}) SET n.id = 'D3076', n.name = 'Đau thắt ngực không ổn định', n.name_en = 'Unstable angina', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000201.htm', n.prognosis = 'Đau thắt ngực không ổn định là dấu hiệu của bệnh tim nặng hơn. Tình trạng sức khỏe của bạn phụ thuộc vào nhiều yếu tố khác nhau, bao gồm: Có bao nhiêu và động mạch nào trong tim bạn bị tắc nghẽn cũng ', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn bị đau hoặc tức ngực mới xuất hiện, không rõ nguyên nhân. Nếu bạn đã bị đau thắt ngực trước đó, hãy liên hệ với nhà cung cấp của bạn. Gọi 911 hoặc số';
MERGE (n:Disease {id: 'D3077'}) SET n.id = 'D3077', n.name = 'Ung thư niệu quản', n.name_en = 'Ureteral cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ureteral-cancer/symptoms-causes/syc-20360721', n.overview = 'Hệ tiết niệu nữ, niệu quản, bàng quang và niệu đạo. Hệ thống tiết niệu loại bỏ chất thải ra khỏi cơ thể qua nước tiểu. Thận nằm về phía sau của bụng trên. Chúng lọc chất thải và chất lỏng từ máu và tạ', n.when_to_see = 'Đặt lịch hẹn với bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng dai dẳng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D3078'}) SET n.id = 'D3078', n.name = 'Tắc nghẽn niệu quản', n.name_en = 'Ureteral obstruction', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ureteral-obstruction/symptoms-causes/syc-20354676', n.overview = 'Hệ tiết niệu nữ: mắt, niệu quản, bàng quang và niệu đạo. Hệ thống tiết niệu loại bỏ chất thải ra khỏi cơ thể qua nước tiểu. Thận nằm về phía sau của bụng trên. Chúng lọc chất thải và chất lỏng từ máu ', n.when_to_see = 'Hãy hẹn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các dấu hiệu và triệu chứng khiến bạn lo lắng. Tìm kiếm sự chăm sóc y tế nếu bạn gặp phải: Đau dữ dội đến mức bạn không thể ngồi y';
MERGE (n:Disease {id: 'D3079'}) SET n.id = 'D3079', n.name = 'Phẫu thuật tái tạo niệu quản - trẻ em', n.name_en = 'Ureteral reimplantation surgery - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007704.htm', n.overview = 'Thủ thuật này thay đổi cách nối niệu quản với bàng quang. Ca phẫu thuật diễn ra tại bệnh viện khi con bạn đang ngủ và không bị đau. Ca phẫu thuật kéo dài từ 2 đến 3 giờ. Trong quá trình phẫu thuật, bá', n.prognosis = 'Phẫu thuật thành công ở hầu hết trẻ em.';
MERGE (n:Disease {id: 'D3080'}) SET n.id = 'D3080', n.name = 'Thoát vị niệu quản', n.name_en = 'Ureterocele', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000462.htm', n.prognosis = 'Kết quả sẽ khác nhau. Thiệt hại có thể là tạm thời nếu tắc nghẽn có thể được chữa khỏi. Tuy nhiên, tổn thương thận có thể là vĩnh viễn nếu tình trạng này không biến mất. Suy thận là không phổ biến. Qu', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của bệnh thoát vị niệu quản.';
MERGE (n:Disease {id: 'D3081'}) SET n.id = 'D3081', n.name = 'Tắc nghẽn khúc nối bể thận niệu quản', n.name_en = 'Ureteropelvic junction obstruction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001267.htm', n.prognosis = 'Việc phát hiện và điều trị sớm vấn đề có thể giúp ngăn ngừa tổn thương thận trong tương lai. Tắc nghẽn UPJ được chẩn đoán trước khi sinh hoặc sớm sau khi sinh có thể tự cải thiện. Hầu hết trẻ em đều l', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu trẻ sơ sinh của bạn có: Nước tiểu có máu Sốt Khối u ở bụng Dấu hiệu đau lưng hoặc đau ở hai bên sườn (khu vực hướng về hai bên cơ thể giữa xư';
MERGE (n:Disease {id: 'D3082'}) SET n.id = 'D3082', n.name = 'Nội soi niệu quản', n.name_en = 'Ureteroscopy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007593.htm', n.overview = 'được thực hiện bằng ống soi niệu quản. Đây là một ống nhỏ (cứng hoặc dẻo) có đèn nhỏ và camera ở đầu. Thủ tục thường mất 1 giờ. Bạn được gây mê toàn thân. Đây là loại thuốc giúp bạn ngủ được. Háng và ', n.prognosis = 'Điều trị sỏi thận bằng nội soi niệu quản thường cho kết quả tốt.';
MERGE (n:Disease {id: 'D3083'}) SET n.id = 'D3083', n.name = 'Hẹp niệu đạo', n.name_en = 'Urethral stricture', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/urethral-stricture/symptoms-causes/syc-20362330 | https://medlineplus.gov/ency/article/001271.htm', n.overview = 'Hẹp niệu đạo (u-REE-thrul) liên quan đến sẹo làm thu hẹp ống dẫn nước tiểu ra khỏi cơ thể, được gọi là niệu đạo. Do tình trạng hẹp bàng quang, nước tiểu thoát ra khỏi bàng quang sẽ ít hơn. Điều này có', n.prognosis = 'Kết quả điều trị thường rất tốt. Đôi khi, việc điều trị cần phải được lặp lại để loại bỏ mô sẹo. Hẹp niệu đạo có thể chặn hoàn toàn dòng nước tiểu. Điều này có thể gây bí tiểu đột ngột. Tình trạng này', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng hẹp niệu đạo.';
MERGE (n:Disease {id: 'D3084'}) SET n.id = 'D3084', n.name = 'Viêm niệu đạo', n.name_en = 'Urethritis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000439.htm', n.prognosis = 'Với chẩn đoán và điều trị chính xác, viêm niệu đạo thường khỏi mà không gặp vấn đề gì thêm. Tuy nhiên, viêm niệu đạo có thể dẫn đến tổn thương lâu dài ở niệu đạo và mô sẹo gọi là hẹp niệu đạo. Nó cũng', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng viêm niệu đạo.';
MERGE (n:Disease {id: 'D3085'}) SET n.id = 'D3085', n.name = 'Són tiểu gấp', n.name_en = 'Urge incontinence', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001270.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào các triệu chứng, chẩn đoán và điều trị của bạn. Nhiều người phải thử các phương pháp điều trị khác nhau (một số phương pháp cùng lúc) để giảm triệu chứng. Để khỏe', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Các triệu chứng của bạn đang gây ra vấn đề cho bạn. Bạn cảm thấy khó chịu vùng chậu hoặc nóng rát khi đi tiểu.';
MERGE (n:Disease {id: 'D3086'}) SET n.id = 'D3086', n.name = 'Ống thông tiểu - trẻ sơ sinh', n.name_en = 'Urinary catheter - infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007248.htm', n.overview = 'TẠI SAO SỬ DỤNG Ống thông tiểu? Trẻ sơ sinh có thể cần ống thông tiểu khi ở bệnh viện nếu trẻ không đi tiểu nhiều. Điều này được gọi là lượng nước tiểu thấp. Trẻ sơ sinh có thể có lượng nước tiểu thấp';
MERGE (n:Disease {id: 'D3087'}) SET n.id = 'D3087', n.name = 'Ống thông tiểu', n.name_en = 'Urinary catheters', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003981.htm', n.overview = 'được sử dụng để dẫn lưu bàng quang. Nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn có thể khuyên bạn nên sử dụng ống thông nếu bạn bị: Tiểu không tự chủ (rò rỉ nước tiểu hoặc không thể kiểm soát khi đ';
MERGE (n:Disease {id: 'D3088'}) SET n.id = 'D3088', n.name = 'Tiểu không tự chủ', n.name_en = 'Urinary incontinence', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/urinary-incontinence/symptoms-causes/syc-20352808 | https://medlineplus.gov/ency/article/003142.htm', n.overview = '— mất kiểm soát bàng quang — là một vấn đề phổ biến và thường gây bối rối. Mức độ nghiêm trọng bao gồm từ việc thỉnh thoảng rò rỉ nước tiểu khi bạn ho hoặc hắt hơi cho đến việc muốn đi tiểu đột ngột v', n.when_to_see = 'Bạn có thể cảm thấy không thoải mái khi thảo luận về tình trạng tiểu không tự chủ với bác sĩ. Nhưng nếu tình trạng tiểu không tự chủ diễn ra thường xuyên hoặc ảnh hưởng đến chất lượng cuộc sống của bạ';
MERGE (n:Disease {id: 'D3089'}) SET n.id = 'D3089', n.name = 'Tiểu không tự chủ - cấy ghép tiêm', n.name_en = 'Urinary incontinence - injectable implant', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007373.htm', n.overview = 'Vật liệu được tiêm là vĩnh viễn. Coaptite và Macroplastique là ví dụ về hai thương hiệu. Bác sĩ phẫu thuật sẽ tiêm vật liệu qua kim vào thành niệu đạo của bạn. Đây là ống dẫn nước tiểu từ bàng quang r', n.prognosis = 'Bạn có thể cần tiêm thêm 2 hoặc 3 mũi nữa để có kết quả tốt. Nếu vật liệu di chuyển ra khỏi vị trí được tiêm, bạn có thể cần phải điều trị nhiều hơn trong tương lai. Cấy ghép có thể giúp ích cho hầu h';
MERGE (n:Disease {id: 'D3090'}) SET n.id = 'D3090', n.name = 'Tiểu không tự chủ - đình chỉ sau xương mu', n.name_en = 'Urinary incontinence - retropubic suspension', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007374.htm', n.overview = 'Bạn được gây mê toàn thân hoặc gây tê tủy sống trước khi bắt đầu phẫu thuật. Khi gây mê toàn thân, bạn sẽ ngủ và không cảm thấy đau. Khi gây tê tủy sống, bạn tỉnh táo nhưng bị tê từ thắt lưng trở xuốn', n.prognosis = 'Tình trạng rò rỉ nước tiểu giảm ở hầu hết phụ nữ thực hiện phẫu thuật này. Nhưng bạn vẫn có thể có một số rò rỉ. Điều này có thể là do các vấn đề khác đang gây ra tình trạng tiểu không tự chủ của bạn.';
MERGE (n:Disease {id: 'D3091'}) SET n.id = 'D3091', n.name = 'Tiểu không tự chủ - băng âm đạo không căng', n.name_en = 'Urinary incontinence - tension-free vaginal tape', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007377.htm', n.overview = 'Bạn được gây mê toàn thân hoặc gây tê tủy sống trước khi bắt đầu phẫu thuật. Khi gây mê toàn thân, bạn sẽ ngủ và không cảm thấy đau. Khi gây tê tủy sống, bạn tỉnh táo nhưng từ thắt lưng trở xuống, bạn', n.prognosis = 'Tình trạng rò rỉ nước tiểu giảm ở hầu hết phụ nữ thực hiện thủ thuật này. Nhưng bạn vẫn có thể có một số rò rỉ. Điều này có thể là do các vấn đề khác đang gây ra chứng tiểu không tự chủ của bạn. Theo ';
MERGE (n:Disease {id: 'D3092'}) SET n.id = 'D3092', n.name = 'Tiểu không tự chủ - thủ thuật đeo qua niệu đạo', n.name_en = 'Urinary incontinence - urethral sling procedures', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007376.htm', n.overview = 'Thủ thuật đeo qua âm đạo sử dụng các vật liệu khác nhau: Mô từ cơ thể của bạn Vật liệu nhân tạo (tổng hợp) được gọi là lưới Bạn được gây mê toàn thân hoặc gây tê tủy sống trước khi bắt đầu phẫu thuật.', n.prognosis = 'Tình trạng rò rỉ nước tiểu trở nên tốt hơn đối với hầu hết phụ nữ. Nhưng bạn vẫn có thể có một số rò rỉ. Điều này có thể là do các vấn đề khác đang gây ra tình trạng tiểu không tự chủ. Theo thời gian,';
MERGE (n:Disease {id: 'D3093'}) SET n.id = 'D3093', n.name = 'Nhiễm trùng đường tiết niệu (UTI)', n.name_en = 'Urinary tract infection (UTI)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/urinary-tract-infection/symptoms-causes/syc-20353447', n.overview = 'Hệ tiết niệu nữ ở mắt, niệu quản, bàng quang và niệu đạo. Hệ thống tiết niệu loại bỏ chất thải ra khỏi cơ thể qua nước tiểu. Thận nằm về phía sau của bụng trên. Chúng lọc chất thải và chất lỏng từ máu', n.when_to_see = 'Hãy liên hệ với bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có các triệu chứng của UTI. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin đư';
MERGE (n:Disease {id: 'D3094'}) SET n.id = 'D3094', n.name = 'Nhiễm trùng đường tiết niệu - người lớn', n.name_en = 'Urinary tract infection - adults', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000521.htm', n.prognosis = 'Hầu hết các trường hợp nhiễm trùng tiểu đều có thể chữa khỏi. Các triệu chứng nhiễm trùng bàng quang thường biến mất trong vòng 24 đến 48 giờ sau khi bắt đầu điều trị. Nếu bạn bị nhiễm trùng thận, có ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của UTI. Liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn có dấu hiệu nhiễm trùng thận, chẳng hạn như: Đau lưng hoặc đau bê';
MERGE (n:Disease {id: 'D3095'}) SET n.id = 'D3095', n.name = 'Nhiễm trùng đường tiết niệu - trẻ em', n.name_en = 'Urinary tract infection - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000505.htm', n.prognosis = 'Hầu hết trẻ em đều khỏi bệnh nếu được điều trị đúng cách. Trong hầu hết các trường hợp, nhiễm trùng lặp lại có thể được ngăn ngừa. Nhiễm trùng lặp đi lặp lại liên quan đến thận có thể dẫn đến tổn thươ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu các triệu chứng của con bạn tiếp tục sau khi điều trị hoặc tái phát hơn hai lần trong 6 tháng hoặc con bạn bị: Đau lưng hoặc đau sườn Nước ti';
MERGE (n:Disease {id: 'D3096'}) SET n.id = 'D3096', n.name = 'Đi tiểu nhiều hơn vào ban đêm', n.name_en = 'Urinating more at night', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003141.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Thức dậy để đi tiểu thường xuyên hơn tiếp tục trong vài ngày. Bạn cảm thấy khó chịu vì số lần phải đi tiểu trong đêm. Bạn có cảm giá';
MERGE (n:Disease {id: 'D3097'}) SET n.id = 'D3097', n.name = 'Đi tiểu - khó tiểu', n.name_en = 'Urination - difficulty with flow', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003143.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nhận thấy tình trạng tiểu khó, chảy nước dãi hoặc dòng nước tiểu yếu. Liên hệ với nhà cung cấp của bạn ngay lập tức nếu: Bạn bị sốt, nôn mửa, đau b';
MERGE (n:Disease {id: 'D3098'}) SET n.id = 'D3098', n.name = 'Đi tiểu - lượng quá nhiều', n.name_en = 'Urination - excessive amount', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003146.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn đi tiểu nhiều trong vài ngày và tình trạng này không phải do thuốc bạn dùng hoặc uống nhiều nước hơn.';
MERGE (n:Disease {id: 'D3099'}) SET n.id = 'D3099', n.name = 'Đi tiểu - đau', n.name_en = 'Urination - painful', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003145.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Có dịch tiết ra hoặc dịch tiết ra từ dương vật hoặc âm đạo của bạn. Bạn đang mang thai và đang đi tiểu đau đớn. Bạn bị đau khi đi tiểu k';
MERGE (n:Disease {id: 'D3100'}) SET n.id = 'D3100', n.name = 'Nước tiểu - màu sắc bất thường', n.name_en = 'Urine - abnormal color', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003139.htm', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có: Màu nước tiểu bất thường không thể giải thích được và không biến mất Có máu trong nước tiểu, ngay cả một lần Nước tiểu trong, màu nâu';
MERGE (n:Disease {id: 'D3101'}) SET n.id = 'D3101', n.name = 'Nước tiểu - có máu', n.name_en = 'Urine - bloody', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003138.htm', n.when_to_see = 'Bạn có thể không thấy máu trong nước tiểu vì đó là một lượng nhỏ. Điều này được gọi là tiểu máu vi thể. Nhà cung cấp của bạn có thể tìm thấy nó khi kiểm tra nước tiểu của bạn trong một cuộc khám định ';
MERGE (n:Disease {id: 'D3102'}) SET n.id = 'D3102', n.name = 'Màu nước tiểu', n.name_en = 'Urine color', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/urine-color/symptoms-causes/syc-20367333', n.overview = 'Màu nước tiểu bình thường dao động từ trong đến vàng nhạt. Nhưng một số thứ có thể thay đổi màu sắc. Ví dụ, các loại thực phẩm như củ cải đường, quả mâm xôi và đậu fava có thể khiến nước tiểu có màu h', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có: Máu trong nước tiểu. Điều này thường gặp trong nhiễm trùng đường tiết niệu và sỏi thận. Những vấn đề đó thường gây đau đớn. Chảy máu ';
MERGE (n:Disease {id: 'D3103'}) SET n.id = 'D3103', n.name = 'Mùi nước tiểu', n.name_en = 'Urine odor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007298.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có dấu hiệu nhiễm trùng đường tiết niệu với mùi nước tiểu bất thường. Chúng bao gồm: Sốt Ớn lạnh Đau rát khi đi tiểu Đau lưng';
MERGE (n:Disease {id: 'D3104'}) SET n.id = 'D3104', n.name = 'Lượng nước tiểu - giảm', n.name_en = 'Urine output - decreased', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003147.htm', n.when_to_see = 'Lượng nước tiểu giảm nhiều có thể là dấu hiệu của một tình trạng nghiêm trọng. Trong một số trường hợp, nó có thể đe dọa tính mạng. Hầu hết lượng nước tiểu có thể được phục hồi nếu được chăm sóc y tế ';
MERGE (n:Disease {id: 'D3105'}) SET n.id = 'D3105', n.name = 'Mề đay sắc tố', n.name_en = 'Urticaria pigmentosa', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001466.htm', n.prognosis = 'Mề đay sắc tố biến mất ở tuổi dậy thì ở khoảng một nửa số trẻ bị ảnh hưởng. Các triệu chứng thường thuyên giảm ở những người khác khi họ trưởng thành. Ở người lớn, nổi mề đay sắc tố có thể dẫn đến bện', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nhận thấy các triệu chứng nổi mề đay sắc tố.';
MERGE (n:Disease {id: 'D3106'}) SET n.id = 'D3106', n.name = 'Thuyên tắc động mạch tử cung', n.name_en = 'Uterine artery embolization', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007384.htm', n.overview = 'UAE được thực hiện bởi một bác sĩ được đào tạo đặc biệt gọi là bác sĩ X quang can thiệp. Bạn sẽ tỉnh táo nhưng bạn sẽ không cảm thấy đau. Điều này được gọi là thuốc an thần có ý thức. Thủ tục mất khoả', n.prognosis = 'UAE có tác dụng tốt trong việc giảm đau, áp lực và chảy máu do u xơ ở hầu hết phụ nữ thực hiện thủ thuật. UAE ít xâm lấn hơn phương pháp điều trị phẫu thuật đối với u xơ tử cung. Nhiều phụ nữ có thể t';
MERGE (n:Disease {id: 'D3107'}) SET n.id = 'D3107', n.name = 'U xơ tử cung', n.name_en = 'Uterine fibroids', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/uterine-fibroids/symptoms-causes/syc-20354288 | https://medlineplus.gov/ency/article/000914.htm', n.overview = 'là sự phát triển phổ biến của tử cung. Chúng thường xuất hiện trong những năm bạn thường có thể mang thai và sinh con. U xơ tử cung không phải là ung thư và hầu như không bao giờ chuyển thành ung thư.', n.prognosis = 'Nếu bạn bị u xơ tử cung mà không có triệu chứng, bạn có thể không cần điều trị. Nếu bạn bị u xơ, chúng có thể phát triển nếu bạn mang thai. Điều này là do lưu lượng máu tăng lên và nồng độ estrogen ca', n.when_to_see = 'Hãy đến gặp bác sĩ nếu bạn bị: Đau vùng chậu không thuyên giảm. Giai đoạn nặng nề hoặc đau đớn làm hạn chế những gì bạn có thể làm. Đốm hoặc chảy máu giữa các thời kỳ. Rắc rối làm trống bàng quang của';
MERGE (n:Disease {id: 'D3108'}) SET n.id = 'D3108', n.name = 'Polyp tử cung', n.name_en = 'Uterine polyps', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/uterine-polyps/symptoms-causes/syc-20378709', n.overview = 'là những khối u bám vào thành trong của tử cung và lan rộng vào tử cung. Polyp tử cung hay còn gọi là polyp nội mạc tử cung, hình thành do các tế bào ở niêm mạc tử cung (nội mạc tử cung) phát triển qu', n.when_to_see = 'Hãy tìm kiếm sự chăm sóc y tế nếu bạn bị: Chảy máu âm đạo sau mãn kinh. Chảy máu giữa các thời kỳ. Chảy máu kinh nguyệt không đều.';
MERGE (n:Disease {id: 'D3109'}) SET n.id = 'D3109', n.name = 'Sa tử cung', n.name_en = 'Uterine prolapse', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/uterine-prolapse/symptoms-causes/syc-20353458 | https://medlineplus.gov/ency/article/001508.htm', n.overview = 'giúp giữ tử cung ở đúng vị trí. Khi các mô hỗ trợ này căng ra và yếu đi, tử cung có thể di chuyển ra khỏi vị trí ban đầu xuống âm đạo. Đây được gọi là tử cung sa. Sa tử cung xảy ra khi các cơ và dây c', n.prognosis = 'Hầu hết phụ nữ bị sa tử cung nhẹ đều không có triệu chứng cần điều trị. Vòng đặt âm đạo có thể có hiệu quả đối với nhiều phụ nữ bị sa tử cung. Phẫu thuật thường mang lại kết quả rất tốt. Tuy nhiên, mộ', n.when_to_see = 'Hãy gặp nhà cung cấp dịch vụ chăm sóc sức khỏe để trao đổi về các lựa chọn điều trị nếu các triệu chứng sa tử cung làm phiền bạn và khiến bạn không thể thực hiện các hoạt động hàng ngày. Yêu cầu một c';
MERGE (n:Disease {id: 'D3110'}) SET n.id = 'D3110', n.name = 'Sarcoma tử cung', n.name_en = 'Uterine sarcoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007655.htm', n.prognosis = 'Tiên lượng của bạn phụ thuộc vào loại và giai đoạn sarcoma tử cung mà bạn mắc phải khi điều trị. Tỷ lệ sống sót sau 5 năm đối với sarcoma tử cung chưa lan rộng nằm trong khoảng từ 60% đến 100%, tùy th', n.when_to_see = 'Hãy gặp bác sĩ nếu bạn có bất kỳ triệu chứng nào của bệnh ung thư tử cung.';
MERGE (n:Disease {id: 'D3111'}) SET n.id = 'D3111', n.name = 'Viêm màng bồ đào', n.name_en = 'Uveitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/uveitis/symptoms-causes/syc-20378734 | https://medlineplus.gov/ency/article/001005.htm', n.overview = 'là một dạng viêm mắt ảnh hưởng đến lớp mô giữa trong mắt, được gọi là uvea. Nó có thể gây đỏ, đau, mờ mắt và nổi ruồi. Các dấu hiệu cảnh báo viêm màng bồ đào (u-vee-I-tis) thường xuất hiện đột ngột và', n.prognosis = 'Nếu được điều trị thích hợp, hầu hết các cơn viêm màng bồ đào trước sẽ biến mất sau vài ngày đến vài tuần. Tuy nhiên, vấn đề thường quay trở lại. Viêm màng bồ đào sau có thể kéo dài từ nhiều tháng đến', n.when_to_see = 'Các triệu chứng cần được chăm sóc y tế khẩn cấp là: Đau mắt Giảm thị lực';
MERGE (n:Disease {id: 'D3112'}) SET n.id = 'D3112', n.name = 'Uvulopalatopharyngoplasty (UPPP)', n.name_en = 'Uvulopalatopharyngoplasty (UPPP)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007663.htm', n.overview = 'UPPP loại bỏ mô mềm ở phía sau cổ họng. Điều này bao gồm: Toàn bộ hoặc một phần lưỡi gà (vạt mô mềm rủ xuống phía sau miệng). Các bộ phận của vòm miệng mềm và mô ở hai bên cổ họng. Amidan và vòm họng,', n.prognosis = 'Chứng ngưng thở khi ngủ ban đầu được cải thiện đối với khoảng một nửa số người thực hiện phẫu thuật này. Theo thời gian, lợi ích sẽ mất đi đối với nhiều người. Một số nghiên cứu cho thấy phẫu thuật ch';
MERGE (n:Disease {id: 'D3113'}) SET n.id = 'D3113', n.name = 'Chăm sóc sức khỏe trong kỳ nghỉ', n.name_en = 'Vacation health care', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001937.htm', n.overview = 'TRƯỚC KHI RỜI Lập kế hoạch trước có thể giúp chuyến đi của bạn suôn sẻ hơn và giúp bạn tránh được các vấn đề. Hãy trao đổi với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn hoặc đến phòng khám du lịc';
MERGE (n:Disease {id: 'D3114'}) SET n.id = 'D3114', n.name = 'Vắc xin - tiêm chủng', n.name_en = 'Vaccines - immunizations', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002024.htm', n.overview = 'CÁCH Vắc xin hoạt động Vắc xin dạy cho cơ thể bạn cách tự bảo vệ khi vi trùng, chẳng hạn như vi rút hoặc vi khuẩn xâm nhập: Vắc xin bắt chước một bệnh nhiễm trùng để kích hoạt khả năng phòng vệ tự nhi';
MERGE (n:Disease {id: 'D3115'}) SET n.id = 'D3115', n.name = 'Âm đạo', n.name_en = 'Vagina', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002342.htm', n.overview = 'Âm đạo là một ống cơ được lót bằng màng nhầy. Lỗ của nó nằm giữa niệu đạo (nơi nước tiểu rời khỏi cơ thể) và hậu môn (nơi phân rời khỏi cơ thể). Máu kinh nguyệt rời khỏi cơ thể qua âm đạo. Âm đạo cũng';
MERGE (n:Disease {id: 'D3116'}) SET n.id = 'D3116', n.name = 'Chứng bất sản âm đạo', n.name_en = 'Vaginal agenesis', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/vaginal-agenesis/symptoms-causes/syc-20355737', n.overview = '(a-JEN-uh-sis) là một chứng rối loạn hiếm gặp trong đó âm đạo không phát triển và tử cung (tử cung) chỉ có thể phát triển một phần hoặc hoàn toàn không phát triển. Tình trạng này xuất hiện trước khi s', n.when_to_see = 'Nếu bạn chưa có kinh nguyệt trước 15 tuổi, hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông t';
MERGE (n:Disease {id: 'D3117'}) SET n.id = 'D3117', n.name = 'Teo âm đạo', n.name_en = 'Vaginal atrophy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/vaginal-atrophy/symptoms-causes/syc-20352288', n.overview = 'từng là một thuật ngữ y học để chỉ tình trạng mỏng và khô lớp lót bên trong âm đạo, thường là sau khi mãn kinh. Một tên gọi khác là viêm teo âm đạo. Những thuật ngữ này không còn được sử dụng nữa. Nhữ', n.when_to_see = 'Nhiều người mắc bệnh GSM sau khi trải qua thời kỳ mãn kinh, nhưng rất ít người tìm cách điều trị. Một số người có thể cảm thấy xấu hổ khi nói chuyện với chuyên gia chăm sóc sức khỏe về các triệu chứng';
MERGE (n:Disease {id: 'D3118'}) SET n.id = 'D3118', n.name = 'Chảy máu âm đạo giữa các kỳ kinh', n.name_en = 'Vaginal bleeding between periods', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003156.htm', n.when_to_see = 'Liên hệ với nhà cung cấp của bạn nếu: Bạn đang mang thai. Có bất kỳ chảy máu không giải thích được giữa các thời kỳ. Có hiện tượng chảy máu sau mãn kinh. Có chảy máu nhiều khi có kinh. Chảy máu bất th';
MERGE (n:Disease {id: 'D3119'}) SET n.id = 'D3119', n.name = 'Chảy máu âm đạo khi mang thai', n.name_en = 'Vaginal bleeding in pregnancy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003264.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị chảy máu âm đạo khi mang thai. Hãy coi đây là một trường hợp khẩn cấp tiềm ẩn. Bạn bị chảy máu âm đạo và bị nhau thai tiền đạo (hãy đến bệnh vi';
MERGE (n:Disease {id: 'D3120'}) SET n.id = 'D3120', n.name = 'Ung thư âm đạo', n.name_en = 'Vaginal cancer', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/vaginal-cancer/symptoms-causes/syc-20352447 | https://medlineplus.gov/ency/article/001510.htm', n.overview = 'âm đạo. Âm đạo là ống cơ nối tử cung với bộ phận sinh dục bên ngoài. Ung thư âm đạo là sự phát triển của các tế bào bắt đầu ở âm đạo. Các tế bào nhân lên nhanh chóng và có thể xâm nhập và phá hủy các ', n.prognosis = 'Triển vọng của phụ nữ mắc bệnh ung thư âm đạo phụ thuộc vào kích thước, giai đoạn bệnh và loại khối u cụ thể.', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng dai dẳng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/';
MERGE (n:Disease {id: 'D3121'}) SET n.id = 'D3121', n.name = 'U nang âm đạo', n.name_en = 'Vaginal cysts', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001509.htm', n.prognosis = 'Hầu hết kết quả đều tốt. U nang thường vẫn còn nhỏ và không cần điều trị. Khi phẫu thuật cắt bỏ, các u nang thường không quay trở lại. U nang Bartholin đôi khi có thể tái phát và cần điều trị liên tục', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn cảm thấy có khối u bên trong âm đạo hoặc nhô ra khỏi âm đạo. Điều quan trọng là liên hệ với nhà cung cấp dịch vụ của bạn để kiểm ';
MERGE (n:Disease {id: 'D3122'}) SET n.id = 'D3122', n.name = 'Khô âm đạo', n.name_en = 'Vaginal dryness', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000892.htm', n.prognosis = 'Điều trị đúng cách sẽ làm giảm các triệu chứng hầu hết thời gian.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị khô âm đạo hoặc đau nhức, nóng rát, ngứa hoặc đau khi quan hệ tình dục không biến mất khi bạn sử dụng chất bôi trơn hòa tan trong nước.';
MERGE (n:Disease {id: 'D3123'}) SET n.id = 'D3123', n.name = 'Lỗ rò âm đạo', n.name_en = 'Vaginal fistula', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/vaginal-fistulas/symptoms-causes/syc-20355762', n.overview = 'Lỗ rò âm đạo là một lỗ hở bất thường hình thành giữa âm đạo và một cơ quan khác, chẳng hạn như bàng quang, đại tràng hoặc trực tràng. Chuyên gia chăm sóc sức khỏe của bạn có thể mô tả lỗ rò âm đạo là ', n.when_to_see = 'Hãy đi khám sức khỏe nếu bạn cho rằng mình có các triệu chứng của lỗ rò âm đạo. Hãy cho chuyên gia chăm sóc sức khỏe của bạn biết nếu bạn có các triệu chứng ảnh hưởng đến cuộc sống hàng ngày, các mối ';
