MERGE (n:Disease {id: 'D1218'}) SET n.id = 'D1218', n.name = 'Vết cắn của nhện mạng phễu', n.name_en = 'Funnel-web spider bite', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002844.htm', n.prognosis = 'Vết cắn của nhện mạng phễu có thể đe dọa tính mạng, đặc biệt là ở trẻ em. Họ phải được điều trị nhanh chóng bằng thuốc kháng nọc độc bởi bác sĩ có kinh nghiệm. Ngay cả khi được điều trị thích hợp và n';
MERGE (n:Disease {id: 'D1219'}) SET n.id = 'D1219', n.name = 'Ngộ độc chất đánh bóng đồ nội thất', n.name_en = 'Furniture polish poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002788.htm', n.prognosis = 'Sức khỏe của người đó phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị đã nhận được. Người đó nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải những chất độc như vậy ';
MERGE (n:Disease {id: 'D1220'}) SET n.id = 'D1220', n.name = 'Trẻ quấy khóc hoặc cáu kỉnh', n.name_en = 'Fussy or irritable child', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003214.htm', n.when_to_see = 'Là cha mẹ, bạn biết hành vi thông thường của con mình. Nếu con bạn cáu kỉnh hơn bình thường và không thể an ủi được, hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn. Theo dõi và báo';
MERGE (n:Disease {id: 'D1221'}) SET n.id = 'D1221', n.name = 'Tiết nhiều sữa', n.name_en = 'Galactorrhea', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/galactorrhea/symptoms-causes/syc-20350431', n.overview = '(guh-lack-toe-REE-uh) là dịch tiết ra màu trắng đục ở núm vú không liên quan đến việc tạo sữa cho con bú. Tiết nhiều sữa không phải là một căn bệnh. Nhưng nó có thể là dấu hiệu của một tình trạng tiềm', n.when_to_see = 'Nếu một hoặc cả hai vú liên tục tiết dịch sữa và bạn không mang thai hoặc cho con bú, hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn. Nếu việc kích thích vú, chẳng hạn như chạm vào núm vú khi quan h';
MERGE (n:Disease {id: 'D1222'}) SET n.id = 'D1222', n.name = 'Galactosemia', n.name_en = 'Galactosemia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000366.htm', n.prognosis = 'Những người được chẩn đoán sớm và tránh tuyệt đối các sản phẩm sữa và các thực phẩm khác có chứa lactose có thể sống một cuộc sống tương đối bình thường. Tuy nhiên, suy giảm tâm thần nhẹ có thể phát t', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Trẻ sơ sinh của bạn có các triệu chứng về galactose huyết Bạn có tiền sử gia đình mắc bệnh galactose huyết và đang cân nhắc việc có ';
MERGE (n:Disease {id: 'D1223'}) SET n.id = 'D1223', n.name = 'Ung thư túi mật', n.name_en = 'Gallbladder cancer', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/gallbladder-cancer/symptoms-causes/syc-20353370', n.overview = 'bắt đầu từ túi mật. Túi mật là một cơ quan nhỏ hình quả lê nằm ở phía bên phải của bụng, ngay dưới gan. Ung thư túi mật là sự phát triển của các tế bào bắt đầu trong túi mật. Túi mật là một cơ quan nh', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe nếu bạn có các triệu chứng khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin được đánh dấu';
MERGE (n:Disease {id: 'D1224'}) SET n.id = 'D1224', n.name = 'Sỏi mật', n.name_en = 'Gallstones', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/gallstones/symptoms-causes/syc-20354214 | https://medlineplus.gov/ency/article/000273.htm', n.overview = 'là sự lắng đọng dịch tiêu hóa cứng lại có thể hình thành trong túi mật của bạn. Túi mật của bạn là một cơ quan nhỏ hình quả lê nằm ở bên phải bụng, ngay dưới gan. Túi mật chứa dịch tiêu hóa gọi là mật', n.prognosis = 'Bạn có thể cần phải áp dụng chế độ ăn lỏng hoặc thực hiện các bước khác để túi mật được nghỉ ngơi sau khi điều trị. Nhà cung cấp của bạn sẽ cung cấp cho bạn hướng dẫn khi bạn rời bệnh viện. Khả năng x', n.when_to_see = 'Hẹn gặp bác sĩ nếu bạn có bất kỳ dấu hiệu hoặc triệu chứng nào khiến bạn lo lắng. Hãy tìm kiếm sự chăm sóc ngay lập tức nếu bạn xuất hiện các dấu hiệu và triệu chứng của biến chứng sỏi mật nghiêm trọn';
MERGE (n:Disease {id: 'D1225'}) SET n.id = 'D1225', n.name = 'Ganglioglioma', n.name_en = 'Ganglioglioma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ganglioglioma/symptoms-causes/syc-20598879', n.overview = 'là một khối u hiếm gặp phát triển trong não hoặc tủy sống. Nó được tạo thành từ hai loại tế bào được tìm thấy trong hệ thần kinh - tế bào thần kinh đệm và tế bào thần kinh. Ganglioglioma được phân loạ';
MERGE (n:Disease {id: 'D1226'}) SET n.id = 'D1226', n.name = 'U nang hạch', n.name_en = 'Ganglion cyst', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/ganglion-cyst/symptoms-causes/syc-20351156', n.overview = 'ở cổ tay. Chúng thường có hình tròn hoặc hình bầu dục và chứa đầy chất lỏng giống như thạch. U nang hạch là những khối u thường xuất hiện dọc theo gân hoặc khớp ở cổ tay hoặc bàn tay. Chúng cũng có th', n.when_to_see = 'Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe nếu bạn nhận thấy có khối u hoặc đau ở cổ tay, bàn tay, mắt cá chân hoặc bàn chân. Bạn có thể nhận được chẩn đoán và tìm hiểu xem bạn có cần điều trị';
MERGE (n:Disease {id: 'D1227'}) SET n.id = 'D1227', n.name = 'U nguyên bào thần kinh hạch', n.name_en = 'Ganglioneuroblastoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001436.htm', n.prognosis = 'Triển vọng phụ thuộc vào mức độ lan rộng của khối u và liệu một số khu vực của khối u có chứa các tế bào ung thư hung hãn hơn hay không.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn cảm thấy có khối u hoặc khối u phát triển trên cơ thể con bạn. Đảm bảo trẻ em được khám sức khỏe định kỳ như một phần của quá trình chăm sóc trẻ tố';
MERGE (n:Disease {id: 'D1228'}) SET n.id = 'D1228', n.name = 'Ganglioneuroma', n.name_en = 'Ganglioneuroma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001437.htm', n.prognosis = 'Hầu hết các u hạch thần kinh đều không phải ung thư. Kết quả mong đợi thường là tốt.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn hoặc con bạn có các triệu chứng có thể do loại khối u này gây ra.';
MERGE (n:Disease {id: 'D1229'}) SET n.id = 'D1229', n.name = 'Chứng hoại thư', n.name_en = 'Gangrene', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/gangrene/symptoms-causes/syc-20352567 | https://medlineplus.gov/ency/article/007218.htm', n.overview = 'là tình trạng mô cơ thể chết do thiếu lưu lượng máu hoặc nhiễm trùng vi khuẩn nghiêm trọng. Chứng hoại thư thường ảnh hưởng đến cánh tay và chân, bao gồm cả ngón chân và ngón tay. Nó cũng có thể xảy r', n.prognosis = 'Điều gì sẽ xảy ra tùy thuộc vào: Vị trí của hoại thư cơ thể Số lượng hoại thư Tình trạng chung của người đó Người đó có thể chết nếu: Điều trị bị trì hoãn Hoại tử lan rộng Người đó có các vấn đề y tế ', n.when_to_see = 'Gangrene là một tình trạng nghiêm trọng và cần được điều trị khẩn cấp. Hãy gọi cho nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn ngay lập tức nếu bạn bị đau dai dẳng, không rõ nguyên nhân ở bất kỳ vù';
MERGE (n:Disease {id: 'D1230'}) SET n.id = 'D1230', n.name = 'Đầy hơi và đau bụng', n.name_en = 'Gas and gas pains', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/gas-and-gas-pains/symptoms-causes/syc-20372709', n.overview = 'Đầy hơi trong triệu chứng tiêu hóa của bạn là một phần của quá trình tiêu hóa điển hình. Loại bỏ khí dư thừa, bằng cách ợ hơi hoặc thải khí, được gọi là trung tiện, cũng là một chức năng điển hình của', n.when_to_see = 'Hãy nói chuyện với chuyên gia chăm sóc sức khỏe nếu cơn đau do đầy hơi hoặc đầy hơi của bạn không biến mất hoặc đủ nghiêm trọng để cản trở khả năng hoạt động tốt trong cuộc sống hàng ngày của bạn. Đau';
MERGE (n:Disease {id: 'D1231'}) SET n.id = 'D1231', n.name = 'Chứng hoại thư khí', n.name_en = 'Gas gangrene', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000620.htm', n.prognosis = 'Chứng hoại thư khí thường bắt đầu đột ngột và nhanh chóng trở nên trầm trọng hơn. Nó thường gây chết người.', n.when_to_see = 'Đây là tình trạng khẩn cấp cần được chăm sóc y tế ngay lập tức. Liên hệ với nhà cung cấp của bạn nếu bạn có dấu hiệu nhiễm trùng xung quanh vết thương trên da. Hãy đến phòng cấp cứu hoặc gọi 911 hoặc ';
MERGE (n:Disease {id: 'D1232'}) SET n.id = 'D1232', n.name = 'Đầy hơi – đầy hơi', n.name_en = 'Gas – flatulence', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003124.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có: Đầy hơi và các triệu chứng khác như đau dạ dày, đau trực tràng, chảy máu trực tràng, ợ chua, buồn nôn, nôn, tiêu chảy, táo bón, s';
MERGE (n:Disease {id: 'D1233'}) SET n.id = 'D1233', n.name = 'Ngộ độc xăng', n.name_en = 'Gasoline poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002806.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Một người nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải loại chất độc này c';
MERGE (n:Disease {id: 'D1234'}) SET n.id = 'D1234', n.name = 'Cắt dạ dày', n.name_en = 'Gastrectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002945.htm', n.overview = 'Phẫu thuật được thực hiện trong khi bạn đang được gây mê toàn thân (ngủ và không đau). Bác sĩ phẫu thuật sẽ rạch một đường ở bụng và cắt bỏ toàn bộ hoặc một phần dạ dày, tùy thuộc vào lý do thực hiện ';
MERGE (n:Disease {id: 'D1235'}) SET n.id = 'D1235', n.name = 'Phẫu thuật cắt dạ dày', n.name_en = 'Gastric bypass surgery', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007199.htm', n.overview = 'Bạn sẽ được gây mê toàn thân trước khi phẫu thuật này. Bạn sẽ ngủ và không bị đau. Có 2 bước trong quá trình phẫu thuật cắt dạ dày: Bước đầu tiên làm cho dạ dày của bạn nhỏ hơn. Bác sĩ phẫu thuật sẽ s', n.prognosis = 'Hầu hết mọi người giảm khoảng 10 đến 20 lbs (4,5 đến 9 kg) mỗi tháng trong năm đầu tiên sau phẫu thuật. Quá trình giảm cân sẽ giảm dần theo thời gian. Bằng cách tuân thủ chương trình ăn kiêng và tập t';
MERGE (n:Disease {id: 'D1236'}) SET n.id = 'D1236', n.name = 'Viêm dạ dày', n.name_en = 'Gastritis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/gastritis/symptoms-causes/syc-20355807 | https://medlineplus.gov/ency/article/001150.htm', n.overview = 'Dạ dày và van môn vị c. Nó có kích thước bằng một quả dưa nhỏ, nở ra khi bạn ăn hoặc uống. Nó có thể chứa tới một gallon (khoảng 4 lít) thực phẩm hoặc chất lỏng. Khi dạ dày nghiền nát thức ăn, các cơn', n.prognosis = 'Triển vọng tùy thuộc vào nguyên nhân, nhưng thường rất tốt.', n.when_to_see = 'Gần như tất cả mọi người đều từng bị chứng khó tiêu và kích ứng dạ dày ở một thời điểm nào đó. Thông thường, chứng khó tiêu không kéo dài và không cần chăm sóc y tế. Hãy gặp chuyên gia chăm sóc sức kh';
MERGE (n:Disease {id: 'D1237'}) SET n.id = 'D1237', n.name = 'Bệnh trào ngược dạ dày thực quản', n.name_en = 'Gastroesophageal reflux disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000265.htm', n.prognosis = 'Hầu hết mọi người đều phản ứng với việc thay đổi lối sống và dùng thuốc. Tuy nhiên, nhiều người cảm thấy cần phải tiếp tục dùng thuốc để kiểm soát các triệu chứng của mình. Nếu bạn bị viêm do GERD (vi', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu các triệu chứng không cải thiện khi thay đổi lối sống hoặc dùng thuốc. Ngoài ra, hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có: Chảy máu Nghẹt thở (h';
MERGE (n:Disease {id: 'D1238'}) SET n.id = 'D1238', n.name = 'Bệnh trào ngược dạ dày thực quản (GERD)', n.name_en = 'Gastroesophageal reflux disease (GERD)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/gerd/symptoms-causes/syc-20361940', n.overview = 'Chứng ợ nóng và GERD xảy ra như thế nào khi cơ vòng ở đầu dưới của thực quản giãn ra không đúng lúc, khiến axit dạ dày trào ngược vào thực quản. Điều này có thể gây ra chứng ợ nóng và các triệu chứng ', n.when_to_see = 'Hãy tìm kiếm sự trợ giúp y tế ngay lập tức nếu bạn bị đau ngực, đặc biệt nếu bạn cũng bị khó thở hoặc đau quai hàm hoặc cánh tay. Đây có thể là triệu chứng của cơn đau tim. Hẹn gặp chuyên gia chăm sóc';
MERGE (n:Disease {id: 'D1239'}) SET n.id = 'D1239', n.name = 'Bệnh trào ngược dạ dày thực quản - trẻ em', n.name_en = 'Gastroesophageal reflux disease - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007688.htm', n.prognosis = 'Hầu hết trẻ em đáp ứng tốt với việc điều trị và thay đổi lối sống. Tuy nhiên, nhiều trẻ cần tiếp tục dùng thuốc để kiểm soát các triệu chứng. Trẻ em bị GERD có nhiều khả năng gặp vấn đề về trào ngược ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu các triệu chứng không cải thiện khi thay đổi lối sống. Đồng thời liên hệ với nhà cung cấp dịch vụ nếu trẻ có các triệu chứng sau:';
MERGE (n:Disease {id: 'D1240'}) SET n.id = 'D1240', n.name = 'Trào ngược dạ dày thực quản ở trẻ sơ sinh', n.name_en = 'Gastroesophageal reflux in infants', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001134.htm', n.prognosis = 'Hầu hết trẻ sơ sinh sẽ vượt qua tình trạng này khi lớn lên. Hiếm khi, trào ngược tiếp tục kéo dài đến thời thơ ấu và gây tổn thương thực quản.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe nếu con bạn: Nôn nhiều và thường xuyên Có các triệu chứng trào ngược khác Có vấn đề về hô hấp sau khi nôn Từ chối thức ăn và sụt hoặc không tăng ';
MERGE (n:Disease {id: 'D1241'}) SET n.id = 'D1241', n.name = 'Xuất huyết tiêu hóa', n.name_en = 'Gastrointestinal bleeding', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/gastrointestinal-bleeding/symptoms-causes/syc-20372729 | https://medlineplus.gov/ency/article/003133.htm', n.overview = 'Xuất huyết tiêu hóa (GI) là dấu hiệu của rối loạn ở đường tiêu hóa. Máu thường xuất hiện trong phân hoặc chất nôn nhưng không phải lúc nào cũng rõ ràng. Phân có thể có màu đen hoặc hắc ín. Chảy máu có', n.when_to_see = 'Nếu bạn có các triệu chứng sốc, bạn hoặc người khác nên gọi 911 hoặc số y tế khẩn cấp tại địa phương của bạn. Nếu bạn nôn ra máu, nhìn thấy máu trong phân hoặc phân đen, hắc ín, hãy tìm kiếm sự chăm s';
MERGE (n:Disease {id: 'D1242'}) SET n.id = 'D1242', n.name = 'Lỗ rò đường tiêu hóa', n.name_en = 'Gastrointestinal fistula', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001129.htm', n.prognosis = 'Triển vọng phụ thuộc vào sức khỏe tổng thể của người đó và mức độ nghiêm trọng của lỗ rò. Những người khỏe mạnh có cơ hội phục hồi rất tốt.', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị: Tiêu chảy nặng hoặc thay đổi lớn khác trong thói quen đại tiện Rò rỉ chất lỏng từ một lỗ trên bụng hoặc gần hậu môn, đặc biệt nếu';
MERGE (n:Disease {id: 'D1243'}) SET n.id = 'D1243', n.name = 'Thủng đường tiêu hóa', n.name_en = 'Gastrointestinal perforation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000235.htm', n.prognosis = 'Hầu hết các ca phẫu thuật đều thành công. Tuy nhiên, kết quả sẽ phụ thuộc vào mức độ nghiêm trọng của vết thủng và thời gian tồn tại trước khi điều trị. Sự hiện diện của các bệnh khác hoặc sốc nhiễm t', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có: Máu trong phân Thay đổi thói quen đại tiện Sốt Buồn nôn Đau bụng dữ dội Nôn Gọi 911 hoặc số cấp cứu tại địa phương ngay lập tức n';
MERGE (n:Disease {id: 'D1244'}) SET n.id = 'D1244', n.name = 'Khối u mô đệm đường tiêu hóa (GIST)', n.name_en = 'Gastrointestinal stromal tumor (GIST)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/gastrointestinal-stromal-tumors/symptoms-causes/syc-20579528', n.overview = 'Khối u mô đệm đường tiêu hóa, còn được gọi là GIST, là một loại ung thư bắt đầu trong hệ thống tiêu hóa. GIST xảy ra thường xuyên nhất ở dạ dày và ruột non. GIST là sự phát triển của các tế bào được c', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1245'}) SET n.id = 'D1245', n.name = 'Liệt dạ dày', n.name_en = 'Gastroparesis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/gastroparesis/symptoms-causes/syc-20355787 | https://medlineplus.gov/ency/article/000297.htm', n.overview = 'Dạ dày và van môn vị c. Nó có kích thước bằng một quả dưa nhỏ, nở ra khi bạn ăn hoặc uống. Nó có thể chứa tới một gallon (khoảng 4 lít) thực phẩm hoặc chất lỏng. Khi dạ dày nghiền nát thức ăn, các cơn', n.prognosis = 'Nhiều phương pháp điều trị, đặc biệt là thuốc, dường như chỉ mang lại lợi ích tạm thời hoặc có tác dụng phụ khi sử dụng trong thời gian dài. Liệt dạ dày là một tình trạng mãn tính. Việc quản lý các đợ', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 thông tin được ';
MERGE (n:Disease {id: 'D1246'}) SET n.id = 'D1246', n.name = 'Bệnh nứt bụng', n.name_en = 'Gastroschisis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000992.htm', n.prognosis = 'Bé có cơ hội phục hồi tốt nếu không có vấn đề gì khác và nếu khoang bụng đủ lớn. Một khoang bụng rất nhỏ có thể dẫn đến những biến chứng cần phải phẫu thuật nhiều hơn. Cần lập kế hoạch sinh nở cẩn thậ', n.when_to_see = 'Vấn đề này được chẩn đoán và điều trị tại bệnh viện ngay sau khi sinh. Sau khi trở về nhà, hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn xuất hiện bất kỳ triệu chứng nào s';
MERGE (n:Disease {id: 'D1247'}) SET n.id = 'D1247', n.name = 'Sửa chữa bệnh Gastroschisis', n.name_en = 'Gastroschisis repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002924.htm', n.overview = 'Mục tiêu của thủ thuật là đặt các cơ quan trở lại bụng của em bé và khắc phục khiếm khuyết. Việc sửa chữa có thể được thực hiện ngay sau khi em bé chào đời. Đây được gọi là sửa chữa chính. Hoặc, việc ', n.prognosis = 'Sau khi bạn về nhà, con bạn có thể bị tắc nghẽn trong ruột ( tắc ruột ) do đường gấp khúc hoặc vết sẹo trong ruột. Nhà cung cấp dịch vụ của bạn có thể cho bạn biết những gì cần tìm và nếu nó phát triể';
MERGE (n:Disease {id: 'D1248'}) SET n.id = 'D1248', n.name = 'Bệnh Gaucher', n.name_en = 'Gaucher disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/gauchers-disease/symptoms-causes/syc-20355546 | https://medlineplus.gov/ency/article/000564.htm', n.overview = 'Bệnh Gaucher (go-SHAY) là một tình trạng di truyền hiếm gặp dẫn đến sự tích tụ chất béo trong các mô. Sự tích tụ này gây ra tổn thương và rối loạn chức năng của các mô và cơ quan. Lá lách, gan và xươn', n.prognosis = 'Tình trạng sức khỏe của mỗi người tùy thuộc vào loại bệnh của họ. Dạng bệnh Gaucher ở trẻ sơ sinh (Loại 2) có thể dẫn đến tử vong sớm. Hầu hết trẻ em bị ảnh hưởng đều chết trước 5 tuổi. Người lớn mắc ', n.when_to_see = 'Nếu bạn hoặc con bạn có các triệu chứng liên quan đến bệnh Gaucher, hãy đặt lịch hẹn với chuyên gia chăm sóc sức khỏe của bạn. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1249'}) SET n.id = 'D1249', n.name = 'Chứng khó nuốt giới tính', n.name_en = 'Gender dysphoria', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/gender-dysphoria/symptoms-causes/syc-20475255', n.overview = 'là cảm giác đau khổ có thể xảy ra khi bản dạng giới của một người khác với giới tính được xác định khi sinh ra. Một số người chuyển giới và đa dạng giới tính mắc chứng phiền muộn giới tính tại một thờ';
MERGE (n:Disease {id: 'D1250'}) SET n.id = 'D1250', n.name = 'Gây mê toàn thân', n.name_en = 'General anesthesia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007410.htm', n.overview = 'Hầu hết các trường hợp, bác sĩ được gọi là bác sĩ gây mê sẽ gây mê cho bạn. Đôi khi, một y tá gây mê đã đăng ký được chứng nhận sẽ gây mê cho bạn. Gây mê thường liên quan đến nhiều hơn một loại thuốc.', n.prognosis = 'Gây mê toàn thân nói chung là an toàn vì có trang thiết bị, thuốc men hiện đại và tiêu chuẩn an toàn. Hầu hết mọi người hồi phục hoàn toàn và không có bất kỳ biến chứng nào.';
MERGE (n:Disease {id: 'D1251'}) SET n.id = 'D1251', n.name = 'Liệt toàn thân', n.name_en = 'General paresis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000748.htm', n.prognosis = 'Nếu không điều trị, một người có thể bị tàn tật. Những người bị nhiễm giang mai muộn có nhiều khả năng mắc các bệnh nhiễm trùng và bệnh khác.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn biết mình đã từng tiếp xúc với bệnh giang mai hoặc một bệnh lây truyền qua đường tình dục khác trong quá khứ và chưa được điều trị. Liên hệ với nhà';
MERGE (n:Disease {id: 'D1252'}) SET n.id = 'D1252', n.name = 'Rối loạn lo âu lan tỏa', n.name_en = 'Generalized anxiety disorder', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/generalized-anxiety-disorder/symptoms-causes/syc-20360803 | https://medlineplus.gov/ency/article/000917.htm', n.overview = 'Thỉnh thoảng cảm thấy lo lắng là điều bình thường, đặc biệt nếu cuộc sống của bạn căng thẳng. Tuy nhiên, sự lo lắng và lo lắng quá mức, liên tục, khó kiểm soát và cản trở các hoạt động hàng ngày có th', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào mức độ nghiêm trọng của tình trạng. Trong một số trường hợp, GAD diễn ra lâu dài và khó điều trị. Hầu hết mọi người sẽ khỏe hơn nhờ dùng thuốc hoặc liệu', n.when_to_see = 'Một số lo lắng là bình thường, nhưng hãy gặp bác sĩ nếu: Bạn cảm thấy như mình đang lo lắng quá nhiều và điều đó cản trở công việc, các mối quan hệ hoặc các phần khác trong cuộc sống của bạn Bạn cảm t';
MERGE (n:Disease {id: 'D1253'}) SET n.id = 'D1253', n.name = 'Rối loạn lo âu lan tỏa ở trẻ em', n.name_en = 'Generalized anxiety disorder in children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007687.htm', n.prognosis = 'Sức khỏe của trẻ phụ thuộc vào mức độ nghiêm trọng của tình trạng. Trong một số trường hợp, GAD diễn ra lâu dài và khó điều trị. Tuy nhiên, hầu hết trẻ em sẽ đỡ hơn khi dùng thuốc, trị liệu bằng trò c', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của con bạn nếu con bạn thường xuyên lo lắng hoặc cảm thấy lo lắng và điều đó cản trở các hoạt động hàng ngày của chúng.';
MERGE (n:Disease {id: 'D1254'}) SET n.id = 'D1254', n.name = 'Các gen', n.name_en = 'Genes', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002371.htm', n.overview = 'được tạo thành từ DNA. Các sợi DNA tạo nên một phần của nhiễm sắc thể của bạn. Nhiễm sắc thể có các chuỗi DNA phù hợp tạo ra các gen cụ thể. Ngoại trừ nhiễm sắc thể giới tính (X và Y), nhiễm sắc thể đ';
MERGE (n:Disease {id: 'D1255'}) SET n.id = 'D1255', n.name = 'Di truyền học', n.name_en = 'Genetics', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002048.htm', n.overview = 'Con người có tế bào với 46 nhiễm sắc thể. Chúng bao gồm 2 nhiễm sắc thể xác định giới tính của chúng (nhiễm sắc thể X và Y) và 22 cặp nhiễm sắc thể không giới tính (autosomal). Nam là "46,XY" và nữ là';
MERGE (n:Disease {id: 'D1256'}) SET n.id = 'D1256', n.name = 'Mụn rộp sinh dục', n.name_en = 'Genital herpes', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/genital-herpes/symptoms-causes/syc-20356161 | https://medlineplus.gov/ency/article/000857.htm', n.overview = 'là một bệnh nhiễm trùng lây truyền qua đường tình dục (STI) phổ biến. Virus herpes simplex (HSV) gây ra mụn rộp sinh dục. Mụn rộp sinh dục thường có thể lây lan qua tiếp xúc da kề da trong hoạt động t', n.prognosis = 'Một khi bạn bị nhiễm bệnh, vi-rút sẽ tồn tại trong cơ thể bạn đến hết cuộc đời. Một số người không bao giờ có một tập phim khác. Một số khác lại bùng phát thường xuyên do mệt mỏi, bệnh tật, kinh nguyệ', n.when_to_see = 'Nếu bạn nghi ngờ mình mắc bệnh mụn rộp sinh dục hoặc bất kỳ bệnh lây truyền qua đường tình dục nào khác, hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. Yêu cầu một cuộc hẹn Có vấn đề với
';
MERGE (n:Disease {id: 'D1257'}) SET n.id = 'D1257', n.name = 'Chấn thương bộ phận sinh dục', n.name_en = 'Genital injury', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000044.htm', n.when_to_see = 'Chấn thương khi ngồi trên chân là tổn thương tinh hoàn hoặc đường tiết niệu. Nhận trợ giúp y tế ngay lập tức nếu có: Sưng hoặc bầm tím nhiều Máu trong nước tiểu Khó tiểu Đi tìm trợ giúp y tế ngay nếu ';
MERGE (n:Disease {id: 'D1258'}) SET n.id = 'D1258', n.name = 'Vết loét sinh dục - nữ', n.name_en = 'Genital sores - female', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003222.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn: Phát hiện bất kỳ vết loét sinh dục nào không rõ nguyên nhân Có sự thay đổi về vết loét ở bộ phận sinh dục Bị ngứa bộ phận sinh dục m';
MERGE (n:Disease {id: 'D1259'}) SET n.id = 'D1259', n.name = 'Lở loét sinh dục - nam', n.name_en = 'Genital sores - male', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003221.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn có bất kỳ vết loét sinh dục nào không rõ nguyên nhân. Các vết loét mới xuất hiện ở các bộ phận khác trên cơ thể bạn';
MERGE (n:Disease {id: 'D1260'}) SET n.id = 'D1260', n.name = 'Mụn cóc sinh dục', n.name_en = 'Genital warts', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/genital-warts/symptoms-causes/syc-20355234 | https://medlineplus.gov/ency/article/000886.htm', n.overview = 'là một trong những loại bệnh lây truyền qua đường tình dục phổ biến nhất. Loại virus gây ra mụn cóc được gọi là papillomavirus ở người (HPV). Có nhiều loại HPV khác nhau. Và gần như tất cả những người', n.prognosis = 'Nhiều phụ nữ trẻ có quan hệ tình dục bị nhiễm vi-rút HPV. Trong nhiều trường hợp, HPV tự biến mất. Hầu hết đàn ông bị nhiễm HPV không bao giờ phát triển bất kỳ triệu chứng hoặc vấn đề nào do nhiễm trù', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn hoặc bạn tình của bạn bị nổi mụn hoặc mụn cóc ở vùng sinh dục. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/cập nhật
 th';
MERGE (n:Disease {id: 'D1261'}) SET n.id = 'D1261', n.name = 'Teo bản đồ', n.name_en = 'Geographic atrophy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/geographic-atrophy/symptoms-causes/syc-20582973', n.overview = 'là một tình trạng nghiêm trọng về mắt. Nó xảy ra ở những người mắc một bệnh về mắt khác gọi là thoái hóa điểm vàng liên quan đến tuổi tác. Bệnh này phổ biến nhất ở những người trên 60 tuổi. Theo thời ', n.when_to_see = 'Teo địa lý có thể phát triển nhanh chóng. Hãy đến gặp bác sĩ nhãn khoa ngay nếu bạn nhận thấy bất kỳ thay đổi nào sau đây: Tầm nhìn mờ hoặc méo mó tăng đột ngột. Những đốm đen mới hoặc những vùng trốn';
MERGE (n:Disease {id: 'D1262'}) SET n.id = 'D1262', n.name = 'Lưỡi địa lý', n.name_en = 'Geographic tongue', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/geographic-tongue/symptoms-causes/syc-20354396 | https://medlineplus.gov/ency/article/001049.htm', n.overview = 'có những cấu trúc giống như sợi tóc trên bề mặt lưỡi của bạn. Những cấu trúc này được gọi là nhú. Sự mất đi các nhú này xuất hiện dưới dạng các mảng màu đỏ, mịn với nhiều hình dạng và kích cỡ khác nha', n.prognosis = 'Lưỡi địa lý là một tình trạng vô hại. Nó có thể gây khó chịu và kéo dài trong một thời gian dài.', n.when_to_see = 'Bởi vì hầu hết những người bị lưỡi bản đồ không biểu hiện triệu chứng nên sẽ không cần điều trị. Nếu bạn có các triệu chứng, chúng có thể liên quan đến nhiễm nấm, vì vậy hãy đến gặp bác sĩ hoặc nha sĩ';
MERGE (n:Disease {id: 'D1263'}) SET n.id = 'D1263', n.name = 'Các khối u tế bào mầm', n.name_en = 'Germ cell tumors', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/germ-cell-tumors/symptoms-causes/syc-20352493', n.overview = 'là sự phát triển của các tế bào hình thành từ các tế bào sinh sản gọi là tế bào mầm. Trong hệ thống sinh sản nữ, tế bào mầm biến thành trứng. Trong hệ thống sinh sản nam giới, chúng biến thành tinh tr';
MERGE (n:Disease {id: 'D1264'}) SET n.id = 'D1264', n.name = 'Tuổi thai', n.name_en = 'Gestational age', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002367.htm', n.overview = 'có thể được xác định trước hoặc sau khi sinh. Trước khi sinh, nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn sẽ sử dụng siêu âm để đo kích thước đầu, bụng và xương đùi của em bé. Điều này cung cấp một';
MERGE (n:Disease {id: 'D1265'}) SET n.id = 'D1265', n.name = 'Bệnh tiểu đường thai kỳ', n.name_en = 'Gestational diabetes', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/gestational-diabetes/symptoms-causes/syc-20355339 | https://medlineplus.gov/ency/article/000896.htm', n.overview = 'là bệnh tiểu đường được chẩn đoán lần đầu tiên trong thai kỳ. Mang thai đôi khi được gọi là mang thai. Giống như các loại bệnh tiểu đường khác, bệnh tiểu đường thai kỳ ảnh hưởng đến cách các tế bào tr', n.prognosis = 'Có rất nhiều nguy cơ mắc bệnh tiểu đường khi mang thai khi lượng đường trong máu không được kiểm soát tốt. Với sự kiểm soát tốt, hầu hết các trường hợp mang thai đều có kết quả tốt. Phụ nữ mang thai m', n.when_to_see = 'Nếu có thể, hãy tìm kiếm sự chăm sóc sức khỏe khi bạn bắt đầu nghĩ đến việc cố gắng mang thai. Sau đó, chuyên gia chăm sóc sức khỏe của bạn có thể kiểm tra nguy cơ mắc bệnh tiểu đường thai kỳ và sức k';
MERGE (n:Disease {id: 'D1266'}) SET n.id = 'D1266', n.name = 'Bệnh nguyên bào nuôi thai kỳ', n.name_en = 'Gestational trophoblastic disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007333.htm', n.prognosis = 'Tiên lượng cho GTD nói chung là tốt, với tỷ lệ chữa khỏi 90% đối với hầu hết các loại bệnh nếu được điều trị thích hợp. Tuy nhiên, điều quan trọng là phải phát hiện và điều trị GTD sớm, vì bệnh sẽ khó';
MERGE (n:Disease {id: 'D1267'}) SET n.id = 'D1267', n.name = 'Hội chứng Gianotti-Crosti', n.name_en = 'Gianotti-Crosti syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001446.htm', n.prognosis = 'Phát ban thường tự biến mất sau khoảng 3 đến 8 tuần mà không cần điều trị hay biến chứng. Các điều kiện liên quan phải được theo dõi cẩn thận.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu con bạn có dấu hiệu của tình trạng này.';
MERGE (n:Disease {id: 'D1268'}) SET n.id = 'D1268', n.name = 'Viêm động mạch tế bào khổng lồ', n.name_en = 'Giant cell arteritis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/giant-cell-arteritis/symptoms-causes/syc-20372758 | https://medlineplus.gov/ency/article/000448.htm', n.overview = 'là tình trạng viêm niêm mạc động mạch của bạn. Thông thường, nó ảnh hưởng đến các động mạch ở đầu, đặc biệt là các động mạch ở thái dương. Vì lý do này, viêm động mạch tế bào khổng lồ đôi khi còn được', n.prognosis = 'Hầu hết mọi người đều hồi phục hoàn toàn nhưng có thể cần điều trị từ 1 đến 2 năm hoặc lâu hơn. Tình trạng này có thể trở lại vào một ngày sau đó. Có thể xảy ra tổn thương các mạch máu khác trong cơ t', n.when_to_see = 'Nếu bạn xuất hiện cơn đau đầu mới, dai dẳng hoặc bất kỳ dấu hiệu và triệu chứng nào được liệt kê ở trên, hãy đến gặp bác sĩ ngay lập tức. Nếu bạn được chẩn đoán mắc bệnh viêm động mạch tế bào khổng lồ';
MERGE (n:Disease {id: 'D1269'}) SET n.id = 'D1269', n.name = 'Nevus bẩm sinh khổng lồ', n.name_en = 'Giant congenital nevus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001453.htm', n.prognosis = 'Ung thư da có thể phát triển ở một số người có nốt ruồi lớn hoặc khổng lồ. Nguy cơ ung thư cao hơn đối với nevi có kích thước lớn hơn. Tuy nhiên, người ta không biết liệu việc loại bỏ nốt ruồi có làm ', n.when_to_see = 'Tình trạng này thường được chẩn đoán khi mới sinh. Nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn nếu con bạn có một vùng sắc tố lớn ở bất kỳ đâu trên da.';
MERGE (n:Disease {id: 'D1270'}) SET n.id = 'D1270', n.name = 'Nhiễm Giardia', n.name_en = 'Giardia infection', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000288.htm', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Tiêu chảy hoặc các triệu chứng khác kéo dài hơn 14 ngày Bạn có máu trong phân (bất thường) Bạn bị mất nước';
MERGE (n:Disease {id: 'D1271'}) SET n.id = 'D1271', n.name = 'Nhiễm Giardia (bệnh giardia)', n.name_en = 'Giardia infection (giardiasis)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/giardia-infection/symptoms-causes/syc-20372786', n.overview = 'Nhiễm Giardia, còn gọi là bệnh giardia, là do một loại ký sinh trùng nhỏ gây ra. Nó lây nhiễm vào một phần của hệ thống tiêu hóa gọi là ruột non. Các triệu chứng bao gồm co thắt dạ dày, đầy hơi, khó c', n.when_to_see = 'Hãy gọi cho chuyên gia chăm sóc sức khỏe của bạn nếu bạn đi ngoài phân lỏng, đau bụng, đầy hơi và khó chịu kéo dài hơn một tuần. Cũng gọi nếu bạn mất quá nhiều chất lỏng, gọi là mất nước. Hãy cho chuy';
MERGE (n:Disease {id: 'D1272'}) SET n.id = 'D1272', n.name = 'Bệnh khổng lồ', n.name_en = 'Gigantism', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001174.htm', n.prognosis = 'Phẫu thuật tuyến yên thường thành công trong việc hạn chế sản xuất GH. Điều trị sớm có thể đảo ngược nhiều thay đổi do dư thừa GH. Những ảnh hưởng lâu dài đến xương, khớp và tim là phổ biến.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu con bạn có dấu hiệu tăng trưởng quá mức.';
MERGE (n:Disease {id: 'D1273'}) SET n.id = 'D1273', n.name = 'Hội chứng Gilbert', n.name_en = 'Gilbert syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/gilberts-syndrome/symptoms-causes/syc-20372811 | https://medlineplus.gov/ency/article/000301.htm', n.overview = 'là một tình trạng gan vô hại trong đó gan không xử lý bilirubin đúng cách. Bilirubin là một chất được tạo ra do sự phân hủy của hồng cầu. Hội chứng Gilbert (zheel-BAYR) là một tình trạng di truyền đượ', n.prognosis = 'Bệnh vàng da có thể đến và đi trong suốt cuộc đời. Nó có nhiều khả năng xuất hiện trong các bệnh như cảm lạnh. Nó không gây ra vấn đề sức khỏe. Tuy nhiên, nó có thể gây nhầm lẫn kết quả xét nghiệm bện', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị vàng da hoặc đau bụng không thuyên giảm.';
MERGE (n:Disease {id: 'D1274'}) SET n.id = 'D1274', n.name = 'Viêm nướu', n.name_en = 'Gingivitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/gingivitis/symptoms-causes/syc-20354453 | https://medlineplus.gov/ency/article/001056.htm', n.overview = 'là một dạng bệnh nướu răng phổ biến và nhẹ, còn gọi là bệnh nha chu. Nó gây kích ứng, đỏ, sưng và chảy máu nướu, đây là phần nướu xung quanh chân răng. Điều quan trọng là phải coi trọng bệnh viêm nướu', n.prognosis = 'Một số người cảm thấy khó chịu khi mảng bám và cao răng được loại bỏ khỏi răng của họ. Chảy máu và đau nướu sẽ giảm trong vòng 1 hoặc 2 tuần sau khi làm sạch chuyên nghiệp và chăm sóc răng miệng tốt t', n.when_to_see = 'Hãy liên hệ với nha sĩ nếu nướu răng của bạn bị sưng đỏ, đặc biệt nếu bạn chưa vệ sinh và khám định kỳ trong 6 tháng qua.';
MERGE (n:Disease {id: 'D1275'}) SET n.id = 'D1275', n.name = 'Viêm nướu răng', n.name_en = 'Gingivostomatitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001052.htm', n.prognosis = 'Nhiễm trùng viêm nướu răng có nhiều mức độ từ nhẹ đến nặng và đau đớn. Các vết loét thường thuyên giảm sau 2 hoặc 3 tuần dù có điều trị hay không. Điều trị có thể làm giảm sự khó chịu và tăng tốc độ c', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị lở miệng và sốt hoặc có các dấu hiệu bệnh khác Vết loét miệng trở nên trầm trọng hơn hoặc không đáp ứng với điều trị trong vòng 3 tuần Bạn bị s';
MERGE (n:Disease {id: 'D1276'}) SET n.id = 'D1276', n.name = 'Glanzmann huyết khối', n.name_en = 'Glanzmann thrombasthenia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001305.htm', n.prognosis = 'Bệnh suy nhược huyết khối Glanzmann là tình trạng bệnh kéo dài suốt đời và không có cách chữa trị. Bạn nên thực hiện các bước đặc biệt để cố gắng tránh chảy máu nếu mắc phải tình trạng này. Bất cứ ai ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn bị chảy máu hoặc bầm tím không rõ nguyên nhân Chảy máu không ngừng sau khi điều trị thông thường';
MERGE (n:Disease {id: 'D1277'}) SET n.id = 'D1277', n.name = 'Bệnh tăng nhãn áp', n.name_en = 'Glaucoma', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/glaucoma/symptoms-causes/syc-20372839 | https://medlineplus.gov/ency/article/001620.htm', n.overview = 'Bệnh tăng nhãn áp góc mở tự do đi qua tiền phòng trong mắt và thoát ra qua hệ thống thoát nước, được gọi là lưới trabecular. Nếu hệ thống đó bị chặn hoặc không hoạt động tốt, áp lực bên trong mắt sẽ t', n.prognosis = 'Bệnh tăng nhãn áp góc mở không thể chữa khỏi. Bạn có thể kiểm soát nó và duy trì thị lực bằng cách làm theo chỉ dẫn của bác sĩ nhãn khoa. Bệnh tăng nhãn áp góc đóng là một trường hợp cấp cứu y tế. Bạn', n.when_to_see = 'Nếu bạn có các triệu chứng xuất hiện đột ngột, bạn có thể bị bệnh tăng nhãn áp góc đóng cấp tính. Các triệu chứng bao gồm đau đầu dữ dội và đau mắt dữ dội. Bạn cần điều trị càng sớm càng tốt. Hãy đến ';
MERGE (n:Disease {id: 'D1278'}) SET n.id = 'D1278', n.name = 'Ngộ độc men', n.name_en = 'Glaze poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002831.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào mức độ nghiêm trọng của ngộ độc và tốc độ điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Thiệt hại có thể tiếp tục xảy ra trong vài';
MERGE (n:Disease {id: 'D1279'}) SET n.id = 'D1279', n.name = 'Glioblastoma', n.name_en = 'Glioblastoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/glioblastoma/symptoms-causes/syc-20569077', n.overview = 'được gọi là tế bào hình sao hỗ trợ các tế bào thần kinh. Nó có thể hình thành trong não hoặc tủy sống. Glioblastoma là một loại ung thư não ác tính bắt đầu trong các tế bào gọi là tế bào hình sao, hỗ ', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ dấu hiệu hoặc triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1280'}) SET n.id = 'D1280', n.name = 'Tế bào thần kinh Glioma', n.name_en = 'Glioma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/glioma/symptoms-causes/syc-20350251', n.overview = 'trong não. Glioma là sự phát triển của các tế bào bắt đầu trong não hoặc tủy sống. Các tế bào trong u thần kinh đệm trông giống như các tế bào não khỏe mạnh được gọi là tế bào thần kinh đệm. Các tế bà', n.when_to_see = 'Hẹn gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có bất kỳ dấu hiệu và triệu chứng nào khiến bạn lo lắng. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được gửi cho yêu cầu này. Xem xét/';
MERGE (n:Disease {id: 'D1281'}) SET n.id = 'D1281', n.name = 'Viêm cầu thận', n.name_en = 'Glomerulonephritis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/glomerulonephritis/symptoms-causes/syc-20355705 | https://medlineplus.gov/ency/article/000484.htm', n.overview = 'ID mặt cắt thận từ máu thông qua các đơn vị lọc gọi là nephron. Mỗi nephron chứa một bộ lọc, được gọi là cầu thận. Mỗi bộ lọc có các mạch máu nhỏ gọi là mao mạch. Khi máu chảy vào cầu thận, các mảnh n', n.prognosis = 'Viêm cầu thận có thể là tạm thời và có thể hồi phục hoặc có thể nặng hơn. Viêm cầu thận tiến triển có thể dẫn đến: Suy thận mãn tính Giảm chức năng thận Bệnh thận giai đoạn cuối Nếu bạn mắc hội chứng ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn có tình trạng làm tăng nguy cơ mắc bệnh viêm cầu thận Bạn xuất hiện các triệu chứng của viêm cầu thận';
MERGE (n:Disease {id: 'D1282'}) SET n.id = 'D1282', n.name = 'Khối u cuộn mạch cảnh', n.name_en = 'Glomus jugulare tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001634.htm', n.prognosis = 'Những người phẫu thuật hoặc xạ trị thường có kết quả tốt. Hơn 90% những người có khối u cuộn dây thần kinh được chữa khỏi.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn: Gặp khó khăn khi nghe hoặc nuốt Phát triển nhịp đập trong tai Nhận thấy một khối u ở cổ Nhận thấy bất kỳ vấn đề nào với các cơ t';
MERGE (n:Disease {id: 'D1283'}) SET n.id = 'D1283', n.name = 'Khối u màng nhĩ', n.name_en = 'Glomus tympanum tumor', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001635.htm', n.prognosis = 'Những người phẫu thuật thường làm tốt. Hơn 90% số người có khối u màng nhĩ được chữa khỏi.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn nhận thấy: Khó nghe hoặc nuốt Các vấn đề với các cơ trên mặt Cảm giác mạch đập trong tai của bạn';
MERGE (n:Disease {id: 'D1284'}) SET n.id = 'D1284', n.name = 'Viêm lưỡi', n.name_en = 'Glossitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001053.htm', n.prognosis = 'Viêm bóng sẽ biến mất nếu nguyên nhân gây ra vấn đề được loại bỏ hoặc điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Các triệu chứng viêm lưỡi kéo dài hơn 10 ngày. Sưng lưỡi rất tệ. Việc thở, nói, nhai hoặc nuốt đều gây ra vấn đề. Nhận chăm sóc khẩn cấp ngay lập tức nếu sưng';
MERGE (n:Disease {id: 'D1285'}) SET n.id = 'D1285', n.name = 'Đau dây thần kinh thiệt hầu', n.name_en = 'Glossopharyngeal neuralgia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001636.htm', n.prognosis = 'Bạn làm tốt như thế nào tùy thuộc vào nguyên nhân của vấn đề và hiệu quả của lần điều trị đầu tiên. Phẫu thuật được coi là có hiệu quả đối với những người không được hưởng lợi từ thuốc.', n.when_to_see = 'Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn ngay lập tức nếu bạn có các triệu chứng của GPN. Hãy đến gặp bác sĩ chuyên khoa về đau nếu cơn đau nghiêm trọng để chắc chắn rằng bạn nhận th';
MERGE (n:Disease {id: 'D1286'}) SET n.id = 'D1286', n.name = 'Glucagonoma', n.name_en = 'Glucagonoma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000326.htm', n.prognosis = 'Khoảng 60% số khối u này là ung thư. Ung thư này thường lan đến gan. Chỉ có khoảng 20% ​​số người có thể được chữa khỏi bằng phẫu thuật. Nếu khối u chỉ nằm ở tuyến tụy và phẫu thuật cắt bỏ thành công ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn nhận thấy các triệu chứng của u glucagon.';
MERGE (n:Disease {id: 'D1287'}) SET n.id = 'D1287', n.name = 'Thiếu hụt Glucose-6-phosphate dehydrogenase', n.name_en = 'Glucose-6-phosphate dehydrogenase deficiency', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000528.htm', n.prognosis = 'Trong hầu hết các trường hợp, các đợt tan máu sẽ tự biến mất.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của tình trạng này. Liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn được chẩn đoán mắc bệnh thiếu G6PD và các';
MERGE (n:Disease {id: 'D1288'}) SET n.id = 'D1288', n.name = 'Bướu cổ', n.name_en = 'Goiter', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/goiter/symptoms-causes/syc-20351829', n.overview = 'Bướu cổ (GOI-tur) là sự phát triển không đều của tuyến giáp. Tuyến giáp là một tuyến hình con bướm nằm ở gốc cổ, ngay dưới quả táo của Adam. Bướu cổ có thể là sự phì đại toàn bộ của tuyến giáp hoặc có';
MERGE (n:Disease {id: 'D1289'}) SET n.id = 'D1289', n.name = 'Khuỷu tay của người chơi gôn', n.name_en = 'Golfer\'s elbow', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/golfers-elbow/symptoms-causes/syc-20372868', n.overview = 'là tình trạng gây đau ở vị trí gân của cơ cẳng tay bám vào vết sưng xương ở bên trong khuỷu tay của bạn. Cơn đau có thể lan vào cẳng tay và cổ tay của bạn. Khuỷu tay của người chơi gôn tương tự như kh', n.when_to_see = 'Hãy tham khảo ý kiến ​​bác sĩ nếu việc nghỉ ngơi, chườm đá và thuốc giảm đau không kê đơn không làm giảm cơn đau và nhức ở khuỷu tay của bạn. Tìm kiếm sự chăm sóc ngay lập tức nếu: Khuỷu tay của bạn n';
MERGE (n:Disease {id: 'D1290'}) SET n.id = 'D1290', n.name = 'Viêm khớp do lậu cầu', n.name_en = 'Gonococcal arthritis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000453.htm', n.prognosis = 'Các triệu chứng thường cải thiện trong vòng 1 đến 2 ngày kể từ khi bắt đầu điều trị. Sự phục hồi hoàn toàn có thể được mong đợi.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh lậu hoặc viêm khớp do lậu cầu.';
MERGE (n:Disease {id: 'D1291'}) SET n.id = 'D1291', n.name = 'Bệnh lậu', n.name_en = 'Gonorrhea', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/gonorrhea/symptoms-causes/syc-20351774 | https://medlineplus.gov/ency/article/007267.htm', n.overview = 'là bệnh lây truyền qua đường tình dục hay còn gọi là bệnh lây truyền qua đường tình dục, do vi khuẩn gây ra. Bệnh lây truyền qua đường tình dục là bệnh nhiễm trùng lây lan chủ yếu qua tiếp xúc với bộ ', n.prognosis = 'Nhiễm trùng lậu chưa lan sang các bộ phận khác của cơ thể hầu như luôn có thể được chữa khỏi bằng kháng sinh. Bệnh lậu đã lan rộng là một bệnh nhiễm trùng nghiêm trọng hơn. Hầu hết thời gian, nó sẽ tố', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh lậu. Hầu hết các phòng khám do bộ y tế tài trợ sẽ chẩn đoán và điều trị STI miễn phí.';
MERGE (n:Disease {id: 'D1292'}) SET n.id = 'D1292', n.name = 'Bệnh gút', n.name_en = 'Gout', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/gout/symptoms-causes/syc-20372897 | https://medlineplus.gov/ency/article/000422.htm', n.overview = 'là một dạng viêm khớp phổ biến và phức tạp có thể ảnh hưởng đến bất kỳ ai. Nó được đặc trưng bởi các cơn đau, sưng, tấy đỏ và đau dữ dội, đột ngột ở một hoặc nhiều khớp, thường gặp nhất là ở ngón chân', n.prognosis = 'Điều trị đúng cách các cơn cấp tính và hạ axit uric xuống mức dưới 6 mg/dL cho phép mọi người có một cuộc sống bình thường. Tuy nhiên, dạng cấp tính của bệnh có thể tiến triển thành bệnh gút mãn tính ', n.when_to_see = 'Nếu bạn bị đau đột ngột và dữ dội ở khớp, hãy gọi cho bác sĩ. Bệnh gút không được điều trị có thể dẫn đến đau nặng hơn và tổn thương khớp. Hãy tìm kiếm sự chăm sóc y tế ngay lập tức nếu bạn bị sốt và ';
MERGE (n:Disease {id: 'D1293'}) SET n.id = 'D1293', n.name = 'Bệnh ghép chống lại vật chủ', n.name_en = 'Graft-versus-host disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001309.htm', n.prognosis = 'Triển vọng phụ thuộc vào mức độ nghiêm trọng của GVHD. Những người nhận được mô và tế bào tủy xương phù hợp thường có kết quả tốt hơn. Một số trường hợp GVHD có thể gây tổn thương gan, phổi, đường tiê', n.when_to_see = 'Nếu bạn đã được ghép tủy xương, hãy liên hệ ngay với nhà cung cấp dịch vụ cấy ghép của bạn nếu bạn xuất hiện bất kỳ triệu chứng nào của GVHD hoặc các triệu chứng bất thường khác.';
MERGE (n:Disease {id: 'D1294'}) SET n.id = 'D1294', n.name = 'Viêm màng não do vi khuẩn gram âm', n.name_en = 'Gram-negative meningitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000610.htm', n.prognosis = 'Việc điều trị càng được bắt đầu sớm thì kết quả càng tốt. Nhiều người hồi phục hoàn toàn. Tuy nhiên, nhiều người bị tổn thương não vĩnh viễn hoặc chết vì loại viêm màng não này. Trẻ nhỏ và người lớn t', n.when_to_see = 'Hãy gọi 911 hoặc số điện thoại cấp cứu tại địa phương hoặc đến phòng cấp cứu nếu bạn nghi ngờ trẻ nhỏ bị viêm màng não có các triệu chứng sau: Khó ăn Khóc the thé Khó chịu Sốt dai dẳng không rõ nguyên';
MERGE (n:Disease {id: 'D1295'}) SET n.id = 'D1295', n.name = 'U hạt vòng', n.name_en = 'Granuloma annulare', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/granuloma-annulare/symptoms-causes/syc-20351319 | https://medlineplus.gov/ency/article/000833.htm', n.overview = 't gây phát ban nổi lên hoặc nổi mụn theo dạng vòng, thường ở bàn tay và bàn chân. U hạt vòng (gran-u-LOW-muh an-u-LAR-e) là một tình trạng da gây phát ban hoặc nổi mụn theo hình tròn. Loại phổ biến nh', n.prognosis = 'Trong hầu hết các trường hợp, GA sẽ biến mất mà không cần điều trị trong vòng 2 năm. Những chiếc nhẫn có thể tồn tại trong nhiều năm. Sự xuất hiện của những chiếc nhẫn mới nhiều năm sau đó không phải ', n.when_to_see = 'Hãy gọi cho nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn bị phát ban hoặc nổi mụn ở dạng vòng không biến mất trong vòng vài tuần. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1296'}) SET n.id = 'D1296', n.name = 'U hạt kèm viêm đa mạch', n.name_en = 'Granulomatosis with polyangiitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/granulomatosis-with-polyangiitis/symptoms-causes/syc-20351088 | https://medlineplus.gov/ency/article/000135.htm', n.overview = '(GPA) là một bệnh hiếm gặp gây sưng tấy, còn gọi là viêm, các mạch máu nhỏ. Tình trạng này chủ yếu ảnh hưởng đến các mạch máu ở mũi, xoang, họng, phổi và thận. Nhưng nó có thể ảnh hưởng đến bất kỳ cơ ', n.prognosis = 'Nếu không điều trị, những người mắc bệnh này ở dạng nặng có thể tử vong trong vòng vài tháng. Với việc điều trị, triển vọng của hầu hết bệnh nhân là tốt. Hầu hết những người dùng corticosteroid và các', n.when_to_see = 'Các triệu chứng GPA có thể giống như triệu chứng của một số tình trạng sức khỏe khác. Các triệu chứng ban đầu có thể giống như cảm lạnh hoặc cúm và có thể kéo dài hàng tuần hoặc lâu hơn. Hãy đến gặp c';
MERGE (n:Disease {id: 'D1297'}) SET n.id = 'D1297', n.name = 'Dị ứng cỏ', n.name_en = 'Grass allergy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002869.htm', n.prognosis = 'Thông thường không có vấn đề gì lớn trừ khi người đó bị hen suyễn hoặc phản ứng dị ứng nghiêm trọng với cỏ hoặc phương pháp điều trị bằng hóa chất. Có khả năng phục hồi. Những người bị dị ứng cỏ nghiê';
MERGE (n:Disease {id: 'D1298'}) SET n.id = 'D1298', n.name = 'Ngộ độc cỏ và cỏ dại', n.name_en = 'Grass and weed killer poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002838.htm', n.prognosis = 'Những người tiếp tục cải thiện trong 4 đến 6 giờ đầu sau khi được điều trị y tế thường hồi phục hoàn toàn. Giữ tất cả các hóa chất, chất tẩy rửa và sản phẩm công nghiệp trong hộp đựng ban đầu và được ';
MERGE (n:Disease {id: 'D1299'}) SET n.id = 'D1299', n.name = 'Bệnh Graves', n.name_en = 'Graves\' disease', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/graves-disease/symptoms-causes/syc-20356240 | https://medlineplus.gov/ency/article/000358.htm', n.overview = 'Bệnh tuyến giáp là một tình trạng của hệ thống miễn dịch ảnh hưởng đến tuyến giáp. Nó khiến cơ thể sản xuất quá nhiều hormone tuyến giáp. Tình trạng đó được gọi là cường giáp. Hormon tuyến giáp ảnh hư', n.prognosis = 'Bệnh Graves thường đáp ứng tốt với điều trị. Phẫu thuật tuyến giáp hoặc iốt phóng xạ thường sẽ khiến tuyến giáp hoạt động kém (suy giáp). Nếu không dùng đúng liều lượng hormone tuyến giáp thay thế, bệ', n.when_to_see = 'Các tình trạng bệnh lý khác có thể gây ra các triệu chứng giống như bệnh Graves. Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn có bất kỳ triệu chứng nào của bệnh Graves để được chẩn đoán nhanh chóng. T';
MERGE (n:Disease {id: 'D1300'}) SET n.id = 'D1300', n.name = 'Đau buồn', n.name_en = 'Grief', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001530.htm', n.prognosis = 'Có thể phải mất một năm hoặc lâu hơn để vượt qua cảm giác đau buồn mạnh mẽ và chấp nhận mất mát.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu: Bạn không thể đối mặt với nỗi đau Bạn đang sử dụng quá nhiều ma túy hoặc rượu bất hợp pháp Bạn trở nên rất trầm cảm Bạn bị trầm cảm lâu dài ảnh hưởng đến cuộc';
MERGE (n:Disease {id: 'D1301'}) SET n.id = 'D1301', n.name = 'Khối u ở háng', n.name_en = 'Groin lump', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003100.htm', n.when_to_see = 'Các hạch bạch huyết nhỏ có thể sờ thấy ở háng là tình trạng phổ biến, đặc biệt ở nam giới và thường là do nhiễm trùng ở chân trước đó. Hãy hẹn gặp bác sĩ nếu bạn có khối u ở háng không rõ nguyên nhân.';
MERGE (n:Disease {id: 'D1302'}) SET n.id = 'D1302', n.name = 'Đau háng', n.name_en = 'Groin pain', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003111.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu: Bạn bị đau háng liên tục mà không có lý do. Bạn bị đau rát. Bạn bị đau kèm theo sưng bìu. Cơn đau chỉ ảnh hưởng đến một tinh hoàn trong hơn 1 giờ, đặc biệ';
MERGE (n:Disease {id: 'D1303'}) SET n.id = 'D1303', n.name = 'Kiểm soát vận động thô', n.name_en = 'Gross motor control', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002368.htm', n.overview = 'là một cột mốc quan trọng trong sự phát triển của trẻ sơ sinh. Trẻ sơ sinh phát triển khả năng điều khiển vận động thô trước khi phát triển khả năng thực hiện các chuyển động nhỏ, chính xác được gọi l';
MERGE (n:Disease {id: 'D1304'}) SET n.id = 'D1304', n.name = 'Bệnh liên cầu khuẩn nhóm B', n.name_en = 'Group B strep disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/group-b-strep/symptoms-causes/syc-20351729', n.overview = 'Liên cầu khuẩn nhóm B là một loại vi khuẩn phổ biến. Một tên khác của nó là Streptococcus agalactiae. Nó thường được mang trong ruột hoặc đường sinh dục dưới. Nó thường vô hại ở người lớn khỏe mạnh. N', n.when_to_see = 'Nếu bạn có các triệu chứng nhiễm liên cầu khuẩn nhóm B, hãy gọi ngay cho thành viên nhóm chăm sóc sức khỏe của bạn. Điều này đặc biệt quan trọng nếu bạn có bất kỳ yếu tố nguy cơ nào sau đây: Bạn đang ';
MERGE (n:Disease {id: 'D1305'}) SET n.id = 'D1305', n.name = 'Nhiễm trùng huyết liên cầu nhóm B ở trẻ sơ sinh', n.name_en = 'Group B streptococcal septicemia of the newborn', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001366.htm', n.prognosis = 'Căn bệnh này có thể đe dọa tính mạng nếu không được điều trị kịp thời.', n.when_to_see = 'Bệnh này thường được chẩn đoán ngay sau khi sinh, thường là khi trẻ vẫn còn nằm viện. Tuy nhiên, nếu bạn có trẻ sơ sinh ở nhà có các triệu chứng của tình trạng này, hãy tìm kiếm trợ giúp y tế khẩn cấp';
MERGE (n:Disease {id: 'D1306'}) SET n.id = 'D1306', n.name = 'Cơn đau ngày càng tăng', n.name_en = 'Growing pains', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/growing-pains/symptoms-causes/syc-20354349', n.overview = 'thường được mô tả là đau nhức hoặc đau nhói ở chân - thường ở phía trước đùi, bắp chân, cẳng chân hoặc phía sau đầu gối. Cơn đau có xu hướng ảnh hưởng đến cả hai chân. Nó thường xảy ra vào ban đêm và ', n.when_to_see = 'Hãy nói chuyện với một thành viên trong nhóm chăm sóc sức khỏe của con bạn nếu bạn lo lắng về tình trạng đau chân của con mình. Lên lịch kiểm tra nếu cơn đau: Dai dẳng hoặc ngày càng trầm trọng hơn. H';
MERGE (n:Disease {id: 'D1307'}) SET n.id = 'D1307', n.name = 'Thiếu hụt hormone tăng trưởng - trẻ em', n.name_en = 'Growth hormone deficiency - children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001176.htm', n.prognosis = 'Tình trạng này được điều trị càng sớm thì khả năng con bạn phát triển đến chiều cao gần như bình thường của người lớn càng cao. Nhiều trẻ tăng 4 inch trở lên (in) hoặc khoảng 10 cm (cm) trong năm đầu ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của con bạn nếu chúng có vẻ thấp bé một cách bất thường so với độ tuổi của chúng.';
MERGE (n:Disease {id: 'D1308'}) SET n.id = 'D1308', n.name = 'Gãy xương sụn tăng trưởng', n.name_en = 'Growth plate fractures', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/growth-plate-fractures/symptoms-causes/syc-20351979', n.overview = 'Gãy xương sụn tăng trưởng ở xương của con bạn. Nếu vết gãy xuyên qua đĩa tăng trưởng, nó có thể dẫn đến chi ngắn hơn hoặc cong vẹo. Gãy tấm tăng trưởng ảnh hưởng đến lớp mô đang phát triển gần đầu xươ', n.when_to_see = 'Nếu nghi ngờ bé bị gãy xương, hãy đưa con đi khám bác sĩ. Đồng thời, hãy cho con bạn đánh giá nếu bạn nhận thấy sự biến dạng rõ ràng ở tay hoặc chân của con bạn hoặc nếu con bạn gặp khó khăn khi chơi ';
MERGE (n:Disease {id: 'D1309'}) SET n.id = 'D1309', n.name = 'Hội chứng Guillain-Barre', n.name_en = 'Guillain-Barre syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/guillain-barre-syndrome/symptoms-causes/syc-20362793 | https://medlineplus.gov/ency/article/000684.htm', n.overview = 'Dây thần kinh và vỏ myelin bị tổn thương. Hội chứng Guillain-Barre phá hủy lớp vỏ bảo vệ của các dây thần kinh ngoại biên, được gọi là vỏ myelin. Tổn thương này ngăn cản các dây thần kinh truyền tín h', n.prognosis = 'Quá trình phục hồi có thể mất vài tuần, vài tháng hoặc nhiều năm. Hầu hết mọi người sống sót và hồi phục hoàn toàn. Ở một số người, tình trạng yếu nhẹ có thể vẫn tồn tại. Kết quả có thể sẽ tốt khi các', n.when_to_see = 'Hãy gọi cho chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị ngứa ran nhẹ ở ngón chân hoặc ngón tay mà dường như không lan rộng hoặc trở nên tồi tệ hơn. Tìm kiếm sự trợ giúp y tế khẩn cấp nếu bạn có bấ';
MERGE (n:Disease {id: 'D1310'}) SET n.id = 'D1310', n.name = 'Gumma', n.name_en = 'Gumma', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000859.htm';
MERGE (n:Disease {id: 'D1311'}) SET n.id = 'D1311', n.name = 'Nướu - sưng', n.name_en = 'Gums - swollen', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003066.htm', n.when_to_see = 'Liên hệ với nhà cung cấp dịch vụ của bạn nếu những thay đổi ở nướu của bạn kéo dài hơn 2 tuần.';
MERGE (n:Disease {id: 'D1312'}) SET n.id = 'D1312', n.name = 'Bệnh vẩy nến thể giọt', n.name_en = 'Guttate psoriasis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000822.htm', n.prognosis = 'Bệnh vẩy nến thể giọt có thể khỏi hoàn toàn sau khi điều trị, đặc biệt là điều trị bằng liệu pháp quang trị liệu. Đôi khi, nó có thể trở thành tình trạng mãn tính (suốt đời) hoặc trở nên trầm trọng hơ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của bệnh vẩy nến thể giọt.';
MERGE (n:Disease {id: 'D1313'}) SET n.id = 'D1313', n.name = 'Viêm màng não Henzae', n.name_en = 'H influenzae meningitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000612.htm', n.prognosis = 'Viêm màng não là một bệnh nhiễm trùng nguy hiểm và có thể gây tử vong. Càng điều trị sớm thì cơ hội phục hồi càng cao. Trẻ nhỏ và người lớn trên 50 tuổi có nguy cơ tử vong cao nhất.', n.when_to_see = 'Hãy gọi 911 hoặc số điện thoại cấp cứu tại địa phương hoặc đến phòng cấp cứu nếu bạn nghi ngờ trẻ nhỏ bị viêm màng não có các triệu chứng sau: Khó ăn Khóc the thé Khó chịu Sốt dai dẳng, không rõ nguyê';
MERGE (n:Disease {id: 'D1314'}) SET n.id = 'D1314', n.name = 'Cúm H1N1 (cúm lợn)', n.name_en = 'H1N1 flu (swine flu)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/swine-flu/symptoms-causes/syc-20378103', n.overview = 'Cúm H1N1, đôi khi được gọi là cúm lợn, là một loại vi-rút cúm A. Trong mùa cúm 2009-2010, một loại vi-rút H1N1 mới bắt đầu gây bệnh ở người. Nó thường được gọi là cúm lợn và là sự kết hợp mới của các ', n.when_to_see = 'Nếu nhìn chung bạn khỏe mạnh và xuất hiện các triệu chứng cúm, hầu hết mọi người có thể không cần gặp nhà cung cấp dịch vụ chăm sóc sức khỏe. Nhưng một số người có nguy cơ cao bị biến chứng cúm. Gọi c';
MERGE (n:Disease {id: 'D1315'}) SET n.id = 'D1315', n.name = 'Quá liều thuốc đối kháng thụ thể H2', n.name_en = 'H2 receptor antagonists overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002585.htm', n.prognosis = 'Các biến chứng nghiêm trọng hiếm khi xảy ra. Nhìn chung đây là những loại thuốc an toàn, ngay cả khi dùng với liều lượng lớn. Nhiều loại thuốc trong số này có thể tương tác với các loại thuốc khác và ';
MERGE (n:Disease {id: 'D1316'}) SET n.id = 'D1316', n.name = 'Vắc xin Haemophilusenzae loại b (Hib) - những điều bạn cần biết', n.name_en = 'Haemophilus influenzae type b (Hib) vaccine - what you need to know', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007597.htm', n.overview = 'Tại sao phải tiêm phòng? Vắc-xin Hib có thể ngăn ngừa bệnh Haemophilusenzae loại b (Hib). Haemophilusenzae loại b có thể gây ra nhiều loại bệnh nhiễm trùng khác nhau. Những bệnh nhiễm trùng này thường';
MERGE (n:Disease {id: 'D1317'}) SET n.id = 'D1317', n.name = 'Ngộ độc thuốc tẩy tóc', n.name_en = 'Hair bleach poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002702.htm', n.prognosis = 'Một người có khỏe mạnh hay không phụ thuộc vào mức độ nghiêm trọng của ngộ độc và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Có thể bị tổn thương nặng ở miệng, ';
MERGE (n:Disease {id: 'D1318'}) SET n.id = 'D1318', n.name = 'Ngộ độc thuốc nhuộm tóc', n.name_en = 'Hair dye poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002703.htm', n.prognosis = 'Sức khoẻ của một người phụ thuộc vào lượng thuốc nhuộm tóc họ nuốt vào và tốc độ họ nhận được nhanh như thế nào điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Có thể bị tổn thương';
MERGE (n:Disease {id: 'D1319'}) SET n.id = 'D1319', n.name = 'Rụng tóc', n.name_en = 'Hair loss', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hair-loss/symptoms-causes/syc-20372926 | https://medlineplus.gov/ency/article/003246.htm', n.overview = '(rụng tóc) chỉ có thể ảnh hưởng đến da đầu hoặc toàn bộ cơ thể của bạn và có thể là tạm thời hoặc vĩnh viễn. Nó có thể là kết quả của di truyền, thay đổi nội tiết tố, tình trạng bệnh lý hoặc một phần ', n.when_to_see = 'Hãy đến gặp bác sĩ nếu bạn hoặc con bạn cảm thấy đau khổ vì chứng rụng tóc dai dẳng và muốn theo đuổi phương pháp điều trị. Đối với những phụ nữ đang bị rụng tóc (rụng tóc xơ hóa vùng trán), hãy trao ';
MERGE (n:Disease {id: 'D1320'}) SET n.id = 'D1320', n.name = 'Ngộ độc keo xịt tóc', n.name_en = 'Hair spray poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002705.htm', n.prognosis = 'Xịt tóc không độc hại lắm. Hầu hết các vụ ngộ độc thuốc xịt tóc đều không nghiêm trọng. Tình trạng một người khỏe mạnh như thế nào tùy thuộc vào mức độ nghiêm trọng của tình trạng ngộ độc và tốc độ họ';
MERGE (n:Disease {id: 'D1321'}) SET n.id = 'D1321', n.name = 'Ngộ độc thuốc duỗi tóc', n.name_en = 'Hair straightener poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002706.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng máy ép tóc họ nuốt và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Có thể bị tổn thương nặng ở miệng, cổ họng và dạ dày';
MERGE (n:Disease {id: 'D1322'}) SET n.id = 'D1322', n.name = 'Ngộ độc thuốc bổ tóc', n.name_en = 'Hair tonic poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002707.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng thuốc bổ tóc họ nuốt và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt phải một lượng lớn thuốc bổ tóc có thể gây su';
MERGE (n:Disease {id: 'D1323'}) SET n.id = 'D1323', n.name = 'Cấy tóc', n.name_en = 'Hair transplant', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007205.htm', n.overview = 'Trong quá trình cấy tóc, tóc sẽ được di chuyển từ vùng mọc dày đến vùng hói. Hầu hết các ca cấy tóc đều được thực hiện tại phòng khám của bác sĩ. Quy trình được thực hiện như sau: Bạn được gây tê cục ', n.prognosis = 'Hầu hết các ca cấy tóc đều cho kết quả là tóc phát triển tốt trong vòng vài tháng sau khi thực hiện. Có thể cần nhiều hơn một đợt điều trị để đạt được kết quả tốt nhất. Những sợi tóc được thay thế hầu';
MERGE (n:Disease {id: 'D1324'}) SET n.id = 'D1324', n.name = 'Bệnh bạch cầu tế bào lông', n.name_en = 'Hairy cell leukemia', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/hairy-cell-leukemia/symptoms-causes/syc-20372956 | https://medlineplus.gov/ency/article/000592.htm', n.overview = 'tế bào ung thư bạch cầu tế bào. Các tế bào ung thư bạch cầu tế bào lông trông có lông khi nhìn dưới kính hiển vi. "Sợi tóc" thực chất là những phần nhô ra khỏi tế bào. Bệnh bạch cầu tế bào tóc là bệnh', n.prognosis = 'Hầu hết những người mắc bệnh HCL có thể sống được 10 năm hoặc lâu hơn sau khi được chẩn đoán và điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn bị chảy máu nặng. Đồng thời, hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có dấu hiệu nhiễm trùng, chẳng hạn như sốt dai dẳng, ho hoặc cảm ';
MERGE (n:Disease {id: 'D1325'}) SET n.id = 'D1325', n.name = 'Ảo giác', n.name_en = 'Hallucinations', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003258.htm', n.when_to_see = 'Một người bắt đầu bị ảo giác và xa rời thực tế nên được nhà cung cấp dịch vụ chăm sóc sức khỏe của họ kiểm tra ngay lập tức. Nhiều tình trạng y tế và tâm thần có thể gây ảo giác có thể nhanh chóng trở';
MERGE (n:Disease {id: 'D1326'}) SET n.id = 'D1326', n.name = 'Ngón chân hình búa', n.name_en = 'Hammer toe', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001235.htm', n.prognosis = 'Nếu tình trạng bệnh được điều trị sớm, bạn thường có thể tránh được phẫu thuật. Điều trị sẽ làm giảm đau và các vấn đề về đi lại.', n.when_to_see = 'Nếu bạn có ngón chân hình búa, hãy liên hệ với nhà cung cấp dịch vụ của bạn: Nếu bạn có vết phồng rộp dày hoặc vết chai ở ngón chân Nếu bạn có vết loét ở ngón chân, đỏ và sưng lên Nếu cơn đau của bạn ';
MERGE (n:Disease {id: 'D1327'}) SET n.id = 'D1327', n.name = 'Sửa chữa ngón chân búa', n.name_en = 'Hammer toe repair', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007559.htm', n.overview = 'Một số loại phẫu thuật có thể sửa chữa ngón chân búa. Bác sĩ xương hoặc bàn chân của bạn sẽ giới thiệu loại phù hợp nhất với bạn. Một số phẫu thuật bao gồm: Loại bỏ các phần xương ở ngón chân Cắt hoặc';
MERGE (n:Disease {id: 'D1328'}) SET n.id = 'D1328', n.name = 'Ngón chân hình búa và ngón chân vồ', n.name_en = 'Hammertoe and mallet toe', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hammertoe-and-mallet-toe/symptoms-causes/syc-20350839', n.overview = 'Ngón chân hình búa. Ngón chân hình búa và ngón chân vồ là tình trạng bàn chân gây ra tình trạng uốn cong bất thường ở ngón chân hoặc các ngón chân. Mang giày không vừa chân có thể gây ra ngón chân hìn', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu bạn bị đau chân kéo dài ảnh hưởng đến khả năng đi lại của bạn. Yêu cầu một cuộc hẹn';
MERGE (n:Disease {id: 'D1329'}) SET n.id = 'D1329', n.name = 'Chấn thương gân kheo', n.name_en = 'Hamstring injury', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hamstring-injury/symptoms-causes/syc-20372985', n.overview = 'Chấn thương gân kheo liên quan đến việc căng hoặc kéo một trong các cơ gân kheo - nhóm ba cơ chạy dọc phía sau đùi. Các cơ này được gắn vào xương bằng gân. Các cơ gân kheo bắt đầu ở xương ngồi ở phần ', n.when_to_see = 'Căng gân kheo nhẹ có thể điều trị tại nhà. Tuy nhiên, hãy đến gặp chuyên gia chăm sóc sức khỏe nếu bạn không thể chịu được sức nặng ở chân bị thương hoặc nếu bạn không thể đi bộ quá bốn bước mà không ';
MERGE (n:Disease {id: 'D1330'}) SET n.id = 'D1330', n.name = 'Ngộ độc kem dưỡng da tay', n.name_en = 'Hand lotion poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002708.htm', n.prognosis = 'Sức khỏe của một người phụ thuộc vào lượng kem dưỡng da tay họ nuốt và tốc độ họ được điều trị. Sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Những sản phẩm này không độc lắm và rất có khả';
MERGE (n:Disease {id: 'D1331'}) SET n.id = 'D1331', n.name = 'Co thắt tay hoặc chân', n.name_en = 'Hand or foot spasms', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003194.htm', n.when_to_see = 'Nếu bạn nhận thấy các cơn co thắt tái phát ở tay hoặc chân, hãy liên hệ với nhà cung cấp dịch vụ của bạn.';
MERGE (n:Disease {id: 'D1332'}) SET n.id = 'D1332', n.name = 'Bệnh tay chân miệng', n.name_en = 'Hand-foot-and-mouth disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hand-foot-and-mouth-disease/symptoms-causes/syc-20353035', n.overview = 'là bệnh nhẹ do virus gây ra. Thông thường, một loại virus có tên coxsackievirus A16 gây ra bệnh này. Bệnh tay chân miệng thường gặp ở trẻ nhỏ. Nhưng mọi người ở mọi lứa tuổi đều có thể có được nó. Vi-', n.when_to_see = 'Thông thường, bệnh tay chân miệng là bệnh nhẹ. Nó thường chỉ gây sốt và các triệu chứng nhẹ trong vài ngày. Nhưng bạn nên gọi cho chuyên gia chăm sóc sức khỏe của con bạn vì bất kỳ lý do nào sau đây: ';
MERGE (n:Disease {id: 'D1333'}) SET n.id = 'D1333', n.name = 'Hangovers', n.name_en = 'Hangovers', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hangovers/symptoms-causes/syc-20373012', n.overview = 'Hangover là một nhóm các triệu chứng khó chịu có thể xảy ra sau khi uống quá nhiều rượu. Cảm giác tồi tệ vẫn chưa đủ tệ, việc thường xuyên say xỉn còn có liên quan đến hiệu suất kém và xung đột ở nhà,', n.when_to_see = 'Cảm giác nôn nao sau một đêm uống rượu sẽ tự biến mất. Nói chuyện với chuyên gia chăm sóc sức khỏe của bạn nếu bạn lo ngại rằng việc uống nhiều rượu thường xuyên có thể dẫn đến các vấn đề nghiêm trọng';
MERGE (n:Disease {id: 'D1334'}) SET n.id = 'D1334', n.name = 'Hantavirus', n.name_en = 'Hantavirus', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001382.htm', n.prognosis = 'Hantavirus là một bệnh nhiễm trùng nghiêm trọng và nhanh chóng trở nên nặng hơn. Suy phổi có thể xảy ra và có thể dẫn đến tử vong. Ngay cả khi được điều trị tích cực, 38% số người mắc bệnh này ở phổi ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn xuất hiện các triệu chứng giống cúm sau khi tiếp xúc với phân hoặc nước tiểu của loài gặm nhấm hoặc bụi bị nhiễm các chất này.';
MERGE (n:Disease {id: 'D1335'}) SET n.id = 'D1335', n.name = 'Hội chứng phổi Hantavirus', n.name_en = 'Hantavirus pulmonary syndrome', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hantavirus-pulmonary-syndrome/symptoms-causes/syc-20351838', n.overview = 'là một bệnh truyền nhiễm hiếm gặp, bắt đầu bằng các triệu chứng giống cúm và tiến triển nhanh chóng thành bệnh nặng hơn. Nó có thể dẫn đến các vấn đề về phổi và tim đe dọa tính mạng. Bệnh còn được gọi', n.when_to_see = 'Các dấu hiệu và triệu chứng của hội chứng phổi hantavirus có thể xấu đi đột ngột và có thể nhanh chóng đe dọa tính mạng. Nếu bạn có các triệu chứng giống cúm và ngày càng trầm trọng hơn sau vài ngày, ';
MERGE (n:Disease {id: 'D1336'}) SET n.id = 'D1336', n.name = 'Tháo bỏ phần cứng - tứ chi', n.name_en = 'Hardware removal - extremity', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007644.htm', n.overview = 'Để thực hiện thủ thuật, bạn có thể được cấp thuốc để làm tê vùng đó (gây tê cục bộ) khi bạn tỉnh. Hoặc, bạn có thể được đưa vào trạng thái ngủ để không cảm thấy gì trong quá trình phẫu thuật (gây mê t', n.prognosis = 'Hầu hết mọi người ít đau hơn và hoạt động tốt hơn sau khi tháo phần cứng.';
MERGE (n:Disease {id: 'D1337'}) SET n.id = 'D1337', n.name = 'Rối loạn Hartnup', n.name_en = 'Hartnup disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001201.htm', n.prognosis = 'Hầu hết những người mắc chứng rối loạn này đều có thể sống một cuộc sống bình thường mà không bị khuyết tật. Hiếm khi có báo cáo về bệnh hệ thần kinh nghiêm trọng và thậm chí tử vong trong các gia đìn', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng của tình trạng này, đặc biệt nếu bạn có tiền sử gia đình mắc chứng rối loạn Hartnup. Nên tư vấn di truyền nếu bạn có tiền sử cá ';
MERGE (n:Disease {id: 'D1338'}) SET n.id = 'D1338', n.name = 'Bệnh Hashimoto', n.name_en = 'Hashimoto\'s disease', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hashimotos-disease/symptoms-causes/syc-20351855', n.overview = 'là một rối loạn tự miễn dịch ảnh hưởng đến tuyến giáp. Tuyến giáp là một tuyến hình con bướm nằm ở gốc cổ, ngay dưới quả táo của Adam. Tuyến giáp sản xuất hormone giúp điều chỉnh nhiều chức năng trong', n.when_to_see = 'Các dấu hiệu và triệu chứng của bệnh Hashimoto rất khác nhau và không đặc hiệu cho chứng rối loạn này. Bởi vì những triệu chứng này có thể xuất phát từ bất kỳ rối loạn nào, điều quan trọng là phải gặp';
MERGE (n:Disease {id: 'D1339'}) SET n.id = 'D1339', n.name = 'Sốt cỏ khô', n.name_en = 'Hay fever', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/hay-fever/symptoms-causes/syc-20373039', n.overview = 'hay còn gọi là viêm mũi dị ứng, gây ra các triệu chứng giống cảm lạnh. Chúng có thể bao gồm sổ mũi, ngứa mắt, nghẹt mũi, hắt hơi và áp lực xoang. Nhưng không giống như cảm lạnh, sốt cỏ khô không phải ', n.when_to_see = 'Hãy gặp chuyên gia chăm sóc sức khỏe nếu: Bạn không thể thấy các triệu chứng sốt cỏ khô của mình thuyên giảm. Thuốc dị ứng không giúp giảm đau hoặc gây ra tác dụng phụ. Bạn mắc một tình trạng khác có ';
MERGE (n:Disease {id: 'D1340'}) SET n.id = 'D1340', n.name = 'Tái tạo đầu và mặt', n.name_en = 'Head and face reconstruction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002980.htm', n.overview = 'Việc phẫu thuật cho các dị tật ở đầu và mặt (tái tạo sọ mặt) được thực hiện như thế nào tùy thuộc vào loại và mức độ nghiêm trọng của dị tật cũng như tình trạng của người đó. Thuật ngữ y học cho phẫu ', n.prognosis = 'Bạn có thể mong đợi vẻ ngoài bình thường hơn nhiều sau phẫu thuật. Một số người cần phải thực hiện các thủ tục theo dõi trong vòng 1 đến 4 năm tới. Điều quan trọng là không chơi các môn thể thao tiếp ';
MERGE (n:Disease {id: 'D1341'}) SET n.id = 'D1341', n.name = 'Ung thư đầu và cổ', n.name_en = 'Head and neck cancers', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/head-and-neck-cancers/symptoms-causes/syc-20354171', n.overview = 'là bệnh ung thư bắt đầu ở vùng đầu và cổ. Có nhiều loại ung thư có thể xảy ra ở đầu và cổ. Mỗi loại bắt đầu bằng sự phát triển của các tế bào có thể xâm nhập và phá hủy các mô cơ thể khỏe mạnh. Ung th', n.when_to_see = 'Hãy hẹn gặp bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác nếu bạn có bất kỳ triệu chứng nào khiến bạn lo lắng.';
MERGE (n:Disease {id: 'D1342'}) SET n.id = 'D1342', n.name = 'Chu vi vòng đầu', n.name_en = 'Head circumference', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002379.htm', n.overview = 'Trong quá trình kiểm tra định kỳ, khoảng cách được đo bằng cm hoặc inch và được so sánh với: Các phép đo trước đây về chu vi vòng đầu của trẻ. Phạm vi bình thường đối với giới tính và độ tuổi của trẻ ';
MERGE (n:Disease {id: 'D1343'}) SET n.id = 'D1343', n.name = 'Chấn thương đầu - sơ cứu', n.name_en = 'Head injury - first aid', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000028.htm', n.when_to_see = 'Hãy gọi 911 hoặc số cấp cứu tại địa phương ngay nếu: Chảy máu đầu hoặc mặt nghiêm trọng. Người đó bối rối, mệt mỏi hoặc bất tỉnh. Người đó ngừng thở. Bạn nghi ngờ có chấn thương đầu hoặc cổ nghiêm trọ';
MERGE (n:Disease {id: 'D1344'}) SET n.id = 'D1344', n.name = 'Chấy', n.name_en = 'Head lice', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/head-lice/symptoms-causes/syc-20356180 | https://medlineplus.gov/ency/article/000840.htm', n.overview = 'là loài côn trùng nhỏ hút máu người, thường là từ da đầu. Những côn trùng này được tìm thấy trên toàn thế giới. Chấy lây nhiễm vào tóc ở bất kỳ độ dài và loại nào. Ở Hoa Kỳ, chấy có xu hướng ảnh hưởng', n.prognosis = 'Hầu hết chấy đều bị tiêu diệt nếu được điều trị thích hợp. Tuy nhiên, chấy rận có thể quay trở lại nếu bạn không loại bỏ chúng tận gốc.', n.when_to_see = 'Hầu hết những người có chấy không cần liên hệ với chuyên gia chăm sóc sức khỏe. Nhưng nếu bạn cho rằng mình hoặc con bạn có chấy, một thành viên trong nhóm chăm sóc sức khỏe của bạn có thể xác nhận sự';
MERGE (n:Disease {id: 'D1345'}) SET n.id = 'D1345', n.name = 'Đau đầu', n.name_en = 'Headache', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/003024.htm', n.when_to_see = 'Một số cơn đau đầu có thể là dấu hiệu của một căn bệnh nghiêm trọng hơn. Hãy tìm kiếm sự trợ giúp y tế ngay lập tức nếu có bất kỳ trường hợp nào sau đây: Đây là cơn đau đầu đầu tiên bạn gặp phải trong';
MERGE (n:Disease {id: 'D1346'}) SET n.id = 'D1346', n.name = 'Đau đầu ở trẻ em', n.name_en = 'Headaches in children', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/headaches-in-children/symptoms-causes/syc-20352099', n.overview = 'là hiện tượng phổ biến và thường không nghiêm trọng. Giống như người lớn, trẻ em có thể mắc nhiều loại đau đầu khác nhau, bao gồm đau nửa đầu hoặc đau đầu do căng thẳng, đôi khi được gọi là đau đầu do', n.when_to_see = 'Hầu hết các cơn đau đầu đều không nghiêm trọng, nhưng hãy tìm kiếm sự chăm sóc y tế kịp thời nếu con bạn bị đau đầu: Đánh thức con bạn khỏi giấc ngủ. Tệ hơn hoặc trở nên thường xuyên hơn. Thay đổi tín';
