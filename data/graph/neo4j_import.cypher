MERGE (n:Disease {id: 'D1915'}) SET n.id = 'D1915', n.name = 'Mụn thịt', n.name_en = 'Milia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001367.htm';
MERGE (n:Disease {id: 'D1916'}) SET n.id = 'D1916', n.name = 'Dị ứng sữa', n.name_en = 'Milk allergy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/milk-allergy/symptoms-causes/syc-20375101', n.overview = 'là phản ứng không điển hình của hệ thống miễn dịch đối với sữa và các sản phẩm có chứa sữa. Đây là một trong những dị ứng thực phẩm phổ biến nhất ở trẻ em. Sữa bò là nguyên nhân thông thường gây dị ứn', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe nếu bạn hoặc con bạn gặp các triệu chứng dị ứng sữa ngay sau khi uống sữa. Nếu có thể, hãy gặp chuyên gia chăm sóc trong thời gian xảy ra phản ứng dị ứng để gi';
