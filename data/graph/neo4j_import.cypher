MERGE (n:Disease {id: 'D0859'}) SET n.id = 'D0859', n.name = 'Kỷ lục các mốc phát triển - 9 tháng', n.name_en = 'Developmental milestones record - 9 months', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002009.htm', n.overview = 'Tất cả trẻ em đều phát triển khác nhau một chút. Nếu bạn lo lắng về sự phát triển của con mình, hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của con bạn. ĐẶC ĐIỂM THỂ CHẤT VÀ KỸ NĂNG VẬN ';
MERGE (n:Disease {id: 'D0860'}) SET n.id = 'D0860', n.name = 'Rối loạn đọc phát triển', n.name_en = 'Developmental reading disorder', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001406.htm', n.prognosis = 'Trợ giúp chuyên môn (được gọi là hướng dẫn khắc phục) có thể giúp cải thiện khả năng đọc và hiểu.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu con bạn có vẻ gặp khó khăn khi học đọc.';
MERGE (n:Disease {id: 'D0861'}) SET n.id = 'D0861', n.name = 'Vách ngăn lệch', n.name_en = 'Deviated septum', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/deviated-septum/symptoms-causes/syc-20351710', n.overview = 'Vách ngăn lệch xảy ra khi thành mỏng giữa hai hốc mũi, gọi là vách ngăn mũi, bị lệch sang một bên. Vách ngăn mũi lệch giữa, gọi là lệch, khiến một bên bên trong mũi nhỏ hơn. Vách ngăn lệch có thể chặn', n.when_to_see = 'Hãy đến gặp chuyên gia chăm sóc sức khỏe để biết: Lỗ mũi bị tắc không khỏi khi điều trị. Chảy máu cam thường xuyên.';
MERGE (n:Disease {id: 'D0862'}) SET n.id = 'D0862', n.name = 'Dextrocardia', n.name_en = 'Dextrocardia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007326.htm', n.prognosis = 'Trẻ sơ sinh mắc chứng bệnh tim bẩm sinh đơn giản có tuổi thọ bình thường và không gặp vấn đề gì liên quan đến vị trí của tim. Khi dextrocardia xuất hiện cùng với các khuyết tật khác ở tim và các nơi k', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn: Có vẻ bị nhiễm trùng thường xuyên Có vẻ như không tăng cân Dễ dàng bị lốp xe Tìm kiếm sự chăm sóc khẩn cấp nếu con bạn có: D';
MERGE (n:Disease {id: 'D0863'}) SET n.id = 'D0863', n.name = 'Quá liều dextromethorphan', n.name_en = 'Dextromethorphan overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002628.htm', n.prognosis = 'Thuốc này an toàn nếu bạn dùng theo chỉ dẫn. Tuy nhiên, nhiều thanh thiếu niên dùng lượng thuốc này rất cao để "cảm thấy dễ chịu" và bị ảo giác. Giống như các loại thuốc lạm dụng khác, điều này có thể';
MERGE (n:Disease {id: 'D0864'}) SET n.id = 'D0864', n.name = 'Bệnh tiểu đường', n.name_en = 'Diabetes', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/diabetes/symptoms-causes/syc-20371444 | https://medlineplus.gov/ency/article/001214.htm', n.overview = 'đề cập đến một nhóm bệnh ảnh hưởng đến cách cơ thể sử dụng lượng đường trong máu (glucose). Glucose là nguồn năng lượng quan trọng cho các tế bào tạo nên cơ và mô. Nó cũng là nguồn nhiên liệu chính củ', n.prognosis = 'Bệnh tiểu đường là căn bệnh suốt đời đối với hầu hết những người mắc bệnh này. Kiểm soát chặt chẽ lượng đường trong máu có thể ngăn ngừa hoặc trì hoãn các biến chứng của bệnh tiểu đường. Nhưng những v', n.when_to_see = 'Nếu bạn nghĩ rằng bạn hoặc con bạn có thể mắc bệnh tiểu đường. Nếu bạn nhận thấy bất kỳ triệu chứng bệnh tiểu đường nào có thể xảy ra, hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn. T';
MERGE (n:Disease {id: 'D0865'}) SET n.id = 'D0865', n.name = 'Bệnh tiểu đường và bệnh về mắt', n.name_en = 'Diabetes and eye disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001212.htm', n.prognosis = 'Kiểm soát bệnh tiểu đường của bạn có thể giúp làm chậm bệnh võng mạc tiểu đường và các vấn đề về mắt khác. Kiểm soát lượng đường trong máu (glucose) của bạn bằng cách: Ăn thực phẩm lành mạnh Tập thể d', n.when_to_see = 'Hãy liên hệ với bác sĩ nhãn khoa (bác sĩ đo thị lực hoặc bác sĩ nhãn khoa) nếu bạn mắc bệnh tiểu đường và bạn chưa gặp bác sĩ đo thị lực hoặc bác sĩ nhãn khoa trong năm qua. Liên hệ với nhà cung cấp c';
MERGE (n:Disease {id: 'D0866'}) SET n.id = 'D0866', n.name = 'Bệnh tiểu đường và bệnh thận', n.name_en = 'Diabetes and kidney disease', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000494.htm', n.prognosis = 'Bệnh thận do tiểu đường là nguyên nhân chính gây ra bệnh tật và tử vong ở những người mắc bệnh tiểu đường. Nó có thể dẫn đến nhu cầu phải chạy thận nhân tạo hoặc ghép thận.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu bạn mắc bệnh tiểu đường và chưa xét nghiệm nước tiểu để kiểm tra protein.';
MERGE (n:Disease {id: 'D0867'}) SET n.id = 'D0867', n.name = 'Bệnh tiểu đường và tổn thương thần kinh', n.name_en = 'Diabetes and nerve damage', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000693.htm', n.prognosis = 'Việc điều trị giúp giảm đau và kiểm soát một số triệu chứng. Các vấn đề khác có thể phát triển bao gồm: Nhiễm trùng bàng quang hoặc thận Loét ngón chân hoặc bàn chân do tiểu đường Tổn thương thần kinh', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn phát triển bất kỳ triệu chứng nào của bệnh thần kinh tiểu đường.';
MERGE (n:Disease {id: 'D0868'}) SET n.id = 'D0868', n.name = 'Bệnh đái tháo nhạt', n.name_en = 'Diabetes insipidus', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/diabetes-insipidus/symptoms-causes/syc-20351269 | https://medlineplus.gov/ency/article/000377.htm', n.overview = '(die-uh-BEE-teze in-SIP-uh-dus) là một vấn đề hiếm gặp khiến chất lỏng trong cơ thể mất cân bằng. Điều đó khiến cơ thể tạo ra một lượng lớn nước tiểu. Nó cũng gây ra cảm giác rất khát ngay cả khi đã u', n.prognosis = 'Kết quả phụ thuộc vào tình trạng rối loạn tiềm ẩn. Nếu được điều trị, DI không gây ra vấn đề nghiêm trọng hoặc dẫn đến tử vong sớm.', n.when_to_see = 'Hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn ngay lập tức nếu bạn nhận thấy mình đi tiểu nhiều hơn bình thường và thường xuyên rất khát. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin đượ';
MERGE (n:Disease {id: 'D0869'}) SET n.id = 'D0869', n.name = 'Hôn mê do tiểu đường', n.name_en = 'Diabetic coma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/diabetic-coma/symptoms-causes/syc-20371475', n.overview = 'Hôn mê do tiểu đường là một rối loạn đe dọa tính mạng gây bất tỉnh. Nếu bạn mắc bệnh tiểu đường, lượng đường trong máu cao đến mức nguy hiểm (tăng đường huyết) hoặc lượng đường trong máu thấp đến mức ', n.when_to_see = 'Hôn mê do tiểu đường là một trường hợp cấp cứu y tế. Nếu bạn có các triệu chứng về lượng đường trong máu cao hoặc thấp và bạn nghĩ mình có thể bất tỉnh, hãy gọi 911 hoặc số khẩn cấp tại địa phương. Nế';
MERGE (n:Disease {id: 'D0870'}) SET n.id = 'D0870', n.name = 'Hội chứng tăng thẩm thấu tăng đường huyết do tiểu đường', n.name_en = 'Diabetic hyperglycemic hyperosmolar syndrome', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000304.htm', n.prognosis = 'Những người mắc HHS thường đã bị bệnh sẵn rồi. Nếu không được điều trị ngay lập tức, có thể xảy ra co giật, hôn mê hoặc tử vong.', n.when_to_see = 'Tình trạng này là một trường hợp cấp cứu y tế. Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn xuất hiện các triệu chứng của HHS.';
MERGE (n:Disease {id: 'D0871'}) SET n.id = 'D0871', n.name = 'Hạ đường huyết do tiểu đường', n.name_en = 'Diabetic hypoglycemia', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/diabetic-hypoglycemia/symptoms-causes/syc-20371525', n.overview = 'đề cập đến lượng đường trong máu thấp ở người mắc bệnh tiểu đường. Đường huyết hay còn gọi là glucose là nguồn nhiên liệu chính cho cơ thể và não. Bạn không thể hoạt động tốt nếu lượng đường trong máu', n.when_to_see = 'Hạ đường huyết nghiêm trọng có thể dẫn đến các vấn đề y tế nghiêm trọng cần được chăm sóc khẩn cấp. Chúng bao gồm co giật và mất ý thức. Đảm bảo gia đình, bạn bè và đồng nghiệp của bạn biết phải làm g';
MERGE (n:Disease {id: 'D0872'}) SET n.id = 'D0872', n.name = 'Nhiễm toan đái tháo đường', n.name_en = 'Diabetic ketoacidosis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/diabetic-ketoacidosis/symptoms-causes/syc-20371551 | https://medlineplus.gov/ency/article/000320.htm', n.overview = 'là một tình trạng sức khỏe nghiêm trọng có thể xảy ra do bệnh tiểu đường. Nó có thể đe dọa tính mạng. Tình trạng này phát triển khi cơ thể không thể sản xuất đủ insulin. Insulin đóng vai trò quan trọn', n.prognosis = 'Hầu hết mọi người đều đáp ứng với điều trị trong vòng 24 giờ. Đôi khi, phải mất nhiều thời gian hơn để phục hồi. Nếu DKA không được điều trị, nó có thể dẫn đến bệnh nặng hoặc tử vong.', n.when_to_see = 'Nếu bạn cảm thấy ốm yếu, căng thẳng hoặc vừa mới mắc bệnh hoặc chấn thương, hãy kiểm tra lượng đường trong máu thường xuyên. Bạn cũng có thể cần kiểm tra xeton trong nước tiểu. Bạn có thể mua bộ xét n';
MERGE (n:Disease {id: 'D0873'}) SET n.id = 'D0873', n.name = 'Bệnh thận tiểu đường (bệnh thận)', n.name_en = 'Diabetic nephropathy (kidney disease)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/diabetic-nephropathy/symptoms-causes/syc-20354556', n.overview = 'Bệnh thận tiểu đường là một biến chứng nghiêm trọng của bệnh tiểu đường tuýp 1 và tiểu đường tuýp 2. Nó còn được gọi là bệnh thận tiểu đường. Tại Hoa Kỳ, khoảng 1 trong 3 người mắc bệnh tiểu đường mắc', n.when_to_see = 'Hãy hẹn gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn có các triệu chứng của bệnh thận. Nếu bạn mắc bệnh tiểu đường, hãy đến gặp chuyên gia chăm sóc sức khỏe hàng năm hoặc thường xuyên theo yêu cầu';
MERGE (n:Disease {id: 'D0874'}) SET n.id = 'D0874', n.name = 'Bệnh thần kinh tiểu đường', n.name_en = 'Diabetic neuropathy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/diabetic-neuropathy/symptoms-causes/syc-20371580', n.overview = 'là một loại tổn thương thần kinh có thể xảy ra với bệnh tiểu đường. Lượng đường trong máu, còn được gọi là glucose, trở nên cao do bệnh tiểu đường. Theo thời gian, lượng đường trong máu cao có thể làm', n.when_to_see = 'Hãy gọi cho chuyên gia chăm sóc sức khỏe của bạn để kiểm tra nếu bạn có: Một vết cắt hoặc vết loét ở bàn chân bị nhiễm trùng hoặc không lành. Nóng rát, ngứa ran, yếu hoặc đau ở tay hoặc chân khiến bạn';
MERGE (n:Disease {id: 'D0875'}) SET n.id = 'D0875', n.name = 'Bệnh võng mạc tiểu đường', n.name_en = 'Diabetic retinopathy', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/diabetic-retinopathy/symptoms-causes/syc-20371611', n.overview = 'là một biến chứng của bệnh tiểu đường ảnh hưởng đến mắt. Nguyên nhân là do tổn thương mạch máu trong mô nhạy cảm với ánh sáng ở phía sau mắt, được gọi là võng mạc. Bệnh võng mạc tiểu đường (die-uh-BET';
MERGE (n:Disease {id: 'D0876'}) SET n.id = 'D0876', n.name = 'Lọc máu - phúc mạc', n.name_en = 'Dialysis - peritoneal', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007434.htm', n.overview = 'Công việc chính của thận là loại bỏ độc tố và chất lỏng dư thừa ra khỏi máu và điều chỉnh một số khía cạnh trong cân bằng hóa học của cơ thể bạn. Nếu chất thải tích tụ trong cơ thể bạn, nó có thể nguy';
MERGE (n:Disease {id: 'D0877'}) SET n.id = 'D0877', n.name = 'Hăm tã', n.name_en = 'Diaper rash', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/diaper-rash/symptoms-causes/syc-20371636 | https://medlineplus.gov/ency/article/000964.htm', n.overview = 'là một dạng viêm da trông giống như những mảng da bị viêm ở mông, đùi và bộ phận sinh dục. Nguyên nhân có thể là do tã ướt hoặc bẩn không được thay thường xuyên. Hoặc có thể là do da nhạy cảm và bị nứ', n.prognosis = 'Phát ban thường đáp ứng tốt với điều trị.', n.when_to_see = 'Nếu vết hăm tã không cải thiện sau vài ngày điều trị tại nhà, hãy nói chuyện với bác sĩ hoặc chuyên gia chăm sóc sức khỏe khác. Bạn có thể cần thuốc theo toa để điều trị hăm tã. Hoặc phát ban có thể c';
MERGE (n:Disease {id: 'D0878'}) SET n.id = 'D0878', n.name = 'Thoát vị cơ hoành', n.name_en = 'Diaphragmatic hernia', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001135.htm', n.prognosis = 'Kết quả phẫu thuật phụ thuộc vào mức độ phát triển của phổi của bé. Nó cũng phụ thuộc vào việc có bất kỳ vấn đề bẩm sinh nào khác hay không. Thông thường, triển vọng sẽ tốt đối với những trẻ sơ sinh c';
MERGE (n:Disease {id: 'D0879'}) SET n.id = 'D0879', n.name = 'Tiêu chảy', n.name_en = 'Diarrhea', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/diarrhea/symptoms-causes/syc-20352241 | https://medlineplus.gov/ency/article/003126.htm', n.overview = 'Đại tràng và ruột non là những bộ phận của đường tiêu hóa, có nhiệm vụ xử lý các loại thực phẩm bạn ăn. Ruột lấy chất dinh dưỡng từ thức ăn. Những gì không được ruột hấp thụ sẽ di chuyển dọc theo đườn', n.when_to_see = 'Nếu bạn là người lớn, hãy đến gặp bác sĩ nếu: Bệnh tiêu chảy của bạn không thuyên giảm hoặc ngừng sau hai ngày. Bạn bị mất nước. Bạn bị đau bụng hoặc trực tràng khủng khiếp. Bạn có phân có máu hoặc đe';
MERGE (n:Disease {id: 'D0880'}) SET n.id = 'D0880', n.name = 'Diastocation trực tràng', n.name_en = 'Diastasis recti', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001602.htm', n.prognosis = 'Trong một số trường hợp, diastocation trực tràng sẽ tự lành. Diast trực tràng liên quan đến thai kỳ thường kéo dài sau khi người phụ nữ sinh con. Tập thể dục có thể giúp cải thiện tình trạng. Thoát vị', n.when_to_see = 'Hãy liên hệ ngay với nhà cung cấp dịch vụ của bạn nếu trẻ bị di căn trực tràng: Nổi mẩn đỏ hoặc đau ở bụng Nôn mửa không ngừng Khóc liên tục';
MERGE (n:Disease {id: 'D0881'}) SET n.id = 'D0881', n.name = 'Quá liều diazepam', n.name_en = 'Diazepam overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002629.htm', n.prognosis = 'Rất có thể phục hồi sau khi dùng quá liều diazepam. Các biến chứng như viêm phổi, tổn thương cơ do nằm trên bề mặt cứng trong thời gian dài hoặc tổn thương não do thiếu oxy có thể dẫn đến tàn tật vĩnh';
MERGE (n:Disease {id: 'D0882'}) SET n.id = 'D0882', n.name = 'Ngộ độc diazinon', n.name_en = 'Diazinon poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002837.htm', n.prognosis = 'Những người tiếp tục cải thiện trong 4 đến 6 giờ đầu sau khi được điều trị y tế thường hồi phục. Điều trị kéo dài thường là cần thiết để đảo ngược tình trạng ngộ độc. Điều này có thể bao gồm việc ở lạ';
MERGE (n:Disease {id: 'D0883'}) SET n.id = 'D0883', n.name = 'Quá liều natri diclofenac', n.name_en = 'Diclofenac sodium overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002630.htm', n.prognosis = 'Khả năng của một người phụ thuộc vào mức độ diclofenac natri đã được nuốt và việc điều trị được thực hiện nhanh chóng như thế nào. Nhận được sự trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Q';
MERGE (n:Disease {id: 'D0884'}) SET n.id = 'D0884', n.name = 'Ngộ độc Dieffenbachia', n.name_en = 'Dieffenbachia poisoning', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002866.htm', n.prognosis = 'Nếu tiếp xúc với miệng của người đó không nghiêm trọng, các triệu chứng thường hết trong vòng vài ngày. Đối với những người tiếp xúc nhiều với cây, thời gian phục hồi lâu hơn có thể cần thiết. Trong m';
MERGE (n:Disease {id: 'D0885'}) SET n.id = 'D0885', n.name = 'Dầu diesel', n.name_en = 'Diesel oil', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002753.htm', n.prognosis = 'Sức khỏe của người đó phụ thuộc vào lượng chất độc nuốt vào và tốc độ điều trị được tiếp nhận. Người đó nhận được trợ giúp y tế càng nhanh thì cơ hội phục hồi càng cao. Nuốt nhiên liệu diesel có thể l';
MERGE (n:Disease {id: 'D0886'}) SET n.id = 'D0886', n.name = 'Chế độ ăn kiêng và ung thư', n.name_en = 'Diet and cancer', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002096.htm', n.overview = 'DIỆT VỜI VÀ UNG THƯ VÚ Mối liên hệ giữa dinh dưỡng và ung thư vú đã được nghiên cứu kỹ lưỡng. Để giảm nguy cơ ung thư vú, Hiệp hội Ung thư Hoa Kỳ (ACS) khuyến cáo bạn: Hoạt động thể chất thường xuyên ';
MERGE (n:Disease {id: 'D0887'}) SET n.id = 'D0887', n.name = 'Hướng dẫn chế độ ăn uống cho người Mỹ 2025 - 2030', n.name_en = 'Dietary Guidelines for Americans 2025 - 2030', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002093.htm', n.overview = 'Có 5 nhóm thực phẩm chính tạo nên chế độ ăn uống lành mạnh: Protein Sữa Rau Quả Trái cây Ngũ cốc nguyên hạt Bạn nên ăn thực phẩm từ mỗi nhóm mỗi ngày. Bạn nên ăn bao nhiêu thực phẩm từ mỗi nhóm tùy th';
MERGE (n:Disease {id: 'D0888'}) SET n.id = 'D0888', n.name = 'Sự khác biệt trong quá trình phát triển giới tính', n.name_en = 'Differences of sex development', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001669.htm', n.prognosis = 'Vui lòng xem thông tin về các điều kiện riêng lẻ. Tiên lượng phụ thuộc vào nguyên nhân cụ thể của DSD. Với sự hiểu biết, hỗ trợ và điều trị thích hợp, triển vọng tổng thể là tuyệt vời.', n.when_to_see = 'Nếu bạn nhận thấy con mình có sự phát triển cơ quan sinh dục hoặc giới tính bất thường, hãy thảo luận điều này với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn.';
MERGE (n:Disease {id: 'D0889'}) SET n.id = 'D0889', n.name = 'U lympho tế bào B lớn lan tỏa', n.name_en = 'Diffuse large B-cell lymphoma', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/diffuse-large-b-cell-lymphoma/symptoms-causes/syc-20584636', n.overview = '(DLBCL) là một loại ung thư hạch. Ung thư hạch là bệnh ung thư ảnh hưởng đến hệ bạch huyết. Hệ bạch huyết được tạo thành từ các cơ quan, tuyến, mạch dạng ống và cụm tế bào gọi là hạch bạch huyết. Nó l';
MERGE (n:Disease {id: 'D0890'}) SET n.id = 'D0890', n.name = 'U thần kinh đệm đường giữa lan tỏa (DMG)', n.name_en = 'Diffuse midline glioma (DMG)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/diffuse-midline-glioma/symptoms-causes/syc-20584386', n.overview = 'là một loại u não ung thư hiếm gặp. Nó phổ biến nhất ở trẻ em trong độ tuổi từ 5 đến 10 tuổi, mặc dù nó cũng có thể ảnh hưởng đến người lớn. Tên này có nghĩa là: Khuếch tán: Các tế bào ung thư đã lan ';
MERGE (n:Disease {id: 'D0891'}) SET n.id = 'D0891', n.name = 'Hội chứng DiGeorge (hội chứng xóa 22q11.2)', n.name_en = 'DiGeorge syndrome (22q11.2 deletion syndrome)', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/digeorge-syndrome/symptoms-causes/syc-20353543', n.overview = 'Hội chứng DiGeorge hay còn gọi là hội chứng xóa 22q11.2, là tình trạng xảy ra khi thiếu một phần nhỏ của nhiễm sắc thể 22. Việc xóa này khiến một số hệ thống cơ thể phát triển kém. Thuật ngữ hội chứng', n.when_to_see = 'Các tình trạng khác có thể gây ra các triệu chứng như hội chứng xóa 22q11.2. Điều quan trọng là phải nhanh chóng có được chẩn đoán đúng nếu con bạn có bất kỳ triệu chứng nào được liệt kê ở trên. Các c';
MERGE (n:Disease {id: 'D0892'}) SET n.id = 'D0892', n.name = 'Bệnh tiêu hóa', n.name_en = 'Digestive diseases', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007447.htm', n.overview = 'Dấu hiệu đầu tiên của các vấn đề ở đường tiêu hóa thường bao gồm một hoặc nhiều triệu chứng sau: Chảy máu Đầy hơi Táo bón Tiêu chảy Ợ nóng Không tự chủ Buồn nôn và ói mửa Đau bụng Khó nuốt Tăng hoặc g';
MERGE (n:Disease {id: 'D0893'}) SET n.id = 'D0893', n.name = 'Độc tính của digitalis', n.name_en = 'Digitalis toxicity', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000165.htm', n.prognosis = 'Tình trạng sức khỏe của một người phụ thuộc vào mức độ nghiêm trọng của chất độc và liệu nó có gây ra nhịp tim không đều hay không.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn đang dùng thuốc digitalis và bạn có các triệu chứng ngộ độc.';
MERGE (n:Disease {id: 'D0894'}) SET n.id = 'D0894', n.name = 'Quá liều Dilantin', n.name_en = 'Dilantin overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002632.htm', n.prognosis = 'Triển vọng phụ thuộc vào mức độ nghiêm trọng của quá liều: Quá liều nhẹ -- Chỉ cần điều trị hỗ trợ là đủ. Có khả năng phục hồi. Quá liều vừa phải - Nếu được điều trị thích hợp, người bệnh thường hồi p';
MERGE (n:Disease {id: 'D0895'}) SET n.id = 'D0895', n.name = 'Bệnh cơ tim giãn', n.name_en = 'Dilated cardiomyopathy', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/dilated-cardiomyopathy/symptoms-causes/syc-20353149 | https://medlineplus.gov/ency/article/000168.htm', n.overview = 'là một loại bệnh về cơ tim khiến buồng tim (tâm thất) mỏng đi và căng ra, ngày càng lớn hơn. Nó thường bắt đầu trong buồng bơm chính của tim (tâm thất trái). Bệnh cơ tim giãn nở khiến tim khó bơm máu ', n.prognosis = 'Suy tim thường là một bệnh mãn tính, bệnh có thể nặng hơn theo thời gian. Một số người bị suy tim nặng, trong đó thuốc, các phương pháp điều trị khác và phẫu thuật không còn giúp ích được nữa. Nhiều n', n.when_to_see = 'Nếu bạn khó thở hoặc có các triệu chứng khác của bệnh cơ tim giãn nở, hãy đến gặp nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn càng sớm càng tốt. Gọi 911 hoặc số khẩn cấp tại địa phương nếu bạn bị đ';
MERGE (n:Disease {id: 'D0896'}) SET n.id = 'D0896', n.name = 'Quá liều dimenhydrinate', n.name_en = 'Dimenhydrinate overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002634.htm', n.prognosis = 'Có khả năng phục hồi nếu người đó sống sót sau 24 giờ đầu. Các biến chứng như viêm phổi, tổn thương cơ do nằm trên bề mặt cứng trong thời gian dài hoặc tổn thương não do thiếu oxy có thể dẫn đến tàn t';
MERGE (n:Disease {id: 'D0897'}) SET n.id = 'D0897', n.name = 'Quá liều diphenhydramine', n.name_en = 'Diphenhydramine overdose', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002636.htm', n.prognosis = 'Có khả năng phục hồi nếu người đó sống sót sau 24 giờ đầu. Các biến chứng như viêm phổi, tổn thương cơ do nằm trên bề mặt cứng trong thời gian dài hoặc tổn thương não do thiếu oxy có thể dẫn đến tàn t';
MERGE (n:Disease {id: 'D0898'}) SET n.id = 'D0898', n.name = 'Bệnh bạch hầu', n.name_en = 'Diphtheria', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/diphtheria/symptoms-causes/syc-20351897 | https://medlineplus.gov/ency/article/001608.htm', n.overview = '(dif-THEER-e-uh) là một bệnh nhiễm trùng nghiêm trọng do vi khuẩn thường ảnh hưởng đến màng nhầy của mũi và cổ họng. Bệnh bạch hầu cực kỳ hiếm gặp ở Hoa Kỳ và các nước phát triển khác nhờ việc tiêm ch', n.prognosis = 'Bạch hầu có thể nhẹ hoặc nặng. Một số người không có triệu chứng. Ở những người khác, bệnh có thể dần dần trở nên tồi tệ hơn. Quá trình phục hồi sau bệnh tật diễn ra chậm. Người ta có thể tử vong, đặc', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn ngay lập tức nếu bạn đã tiếp xúc với người mắc bệnh bạch hầu. Bệnh bạch hầu là một bệnh hiếm gặp. Đây cũng là một căn bệnh phải báo cáo và mọi trường hợp đều thườn';
MERGE (n:Disease {id: 'D0899'}) SET n.id = 'D0899', n.name = 'Nuốt chất bẩn', n.name_en = 'Dirt - swallowing', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002840.htm', n.prognosis = 'Rất có khả năng phục hồi trừ khi chất bẩn chứa thứ gì đó có thể gây ra các vấn đề về sức khỏe.';
MERGE (n:Disease {id: 'D0900'}) SET n.id = 'D0900', n.name = 'Kỷ luật ở trẻ em', n.name_en = 'Discipline in children', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002211.htm', n.overview = 'Mỗi bậc cha mẹ đều có cách nuôi dạy con riêng của mình. Bạn có thể nghiêm khắc hoặc có thể thoải mái. Điều quan trọng là: Đặt ra những kỳ vọng rõ ràng Hãy nhất quán Hãy yêu thương LỜI KHUYÊN ĐỂ KỶ LUẬ';
MERGE (n:Disease {id: 'D0901'}) SET n.id = 'D0901', n.name = 'Thay đĩa đệm - cột sống thắt lưng', n.name_en = 'Disk replacement - lumbar spine', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007745.htm', n.overview = 'Trong quá trình thay đĩa đệm toàn phần (TDR), phần bên trong của đĩa đệm cột sống bị tổn thương được thay thế bằng một đĩa đệm nhân tạo để khôi phục chuyển động bình thường của cột sống. Thông thường,', n.prognosis = 'Nguy cơ biến chứng thấp sau khi thay đĩa đệm thắt lưng. Phẫu thuật thường cải thiện khả năng vận động của xương sống tốt hơn các phẫu thuật khác (phẫu thuật cột sống). Đây là một thủ tục an toàn và gi';
MERGE (n:Disease {id: 'D0902'}) SET n.id = 'D0902', n.name = 'Phẫu thuật cắt bỏ đĩa đệm', n.name_en = 'Diskectomy', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007250.htm', n.overview = 'Bác sĩ phẫu thuật của bạn có thể thực hiện cắt bỏ đĩa đệm (cắt bỏ đĩa đệm) theo những cách khác nhau. Phẫu thuật cắt bỏ vi đĩa đệm: Khi bạn thực hiện phẫu thuật cắt bỏ vi đĩa đệm, bác sĩ phẫu thuật củ', n.prognosis = 'Hầu hết mọi người đều giảm đau và có thể di chuyển tốt hơn sau phẫu thuật. Tình trạng tê và ngứa ran sẽ thuyên giảm hoặc biến mất. Cơn đau, tê hoặc yếu của bạn có thể không thuyên giảm hoặc biến mất n';
MERGE (n:Disease {id: 'D0903'}) SET n.id = 'D0903', n.name = 'Viêm đĩa đệm', n.name_en = 'Diskitis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000993.htm', n.prognosis = 'Trẻ bị nhiễm trùng sẽ hồi phục hoàn toàn sau khi điều trị. Trong một số ít trường hợp, đau lưng mãn tính vẫn tồn tại. Trong trường hợp mắc bệnh tự miễn, kết quả phụ thuộc vào tình trạng cơ bản. Đây th', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn hoặc con bạn bị đau lưng không thuyên giảm hoặc các vấn đề về đứng và đi lại có vẻ bất thường đối với độ tuổi của trẻ.';
MERGE (n:Disease {id: 'D0904'}) SET n.id = 'D0904', n.name = 'Trật khớp vai', n.name_en = 'Dislocated shoulder', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dislocated-shoulder/symptoms-causes/syc-20371715', n.overview = 'Trật khớp vai là một chấn thương trong đó xương cánh tay trên bật ra khỏi ổ cắm hình cốc là một phần của xương bả vai. Vai là khớp linh hoạt nhất của cơ thể nên dễ bị trật khớp hơn. Nếu bạn nghi ngờ v', n.when_to_see = 'Nhận trợ giúp y tế ngay lập tức nếu vai có vẻ bị trật. Trong khi chờ chăm sóc y tế: Không di chuyển khớp. Nẹp hoặc treo khớp vai ở đúng vị trí. Đừng cố gắng di chuyển vai hoặc buộc nó trở lại vị trí c';
MERGE (n:Disease {id: 'D0905'}) SET n.id = 'D0905', n.name = 'Trật khớp', n.name_en = 'Dislocation', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000014.htm', n.when_to_see = 'Gọi 911 hoặc số cấp cứu tại địa phương ngay lập tức nếu người đó có bất kỳ dấu hiệu nào sau đây: Xương nhô ra ngoài da Đã biết hoặc nghi ngờ bị trật khớp hoặc gãy xương Vùng bên dưới khớp bị thương có';
MERGE (n:Disease {id: 'D0906'}) SET n.id = 'D0906', n.name = 'Đông máu nội mạch lan tỏa (DIC)', n.name_en = 'Disseminated intravascular coagulation (DIC)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000573.htm', n.prognosis = 'Kết quả phụ thuộc vào nguyên nhân gây ra rối loạn. DIC có thể đe dọa tính mạng.', n.when_to_see = 'Hãy đến phòng cấp cứu hoặc gọi 911 hoặc số cấp cứu tại địa phương nếu bạn bị chảy máu không ngừng.';
MERGE (n:Disease {id: 'D0907'}) SET n.id = 'D0907', n.name = 'Bệnh lao lây lan', n.name_en = 'Disseminated tuberculosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000624.htm', n.prognosis = 'Hầu hết các dạng bệnh lao lan truyền đều đáp ứng tốt với điều trị. Bộ phận cơ thể bị ảnh hưởng, chẳng hạn như xương hoặc khớp, có thể bị tổn thương vĩnh viễn do nhiễm trùng.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp của bạn nếu bạn biết hoặc nghi ngờ rằng mình đã tiếp xúc với bệnh lao. Tất cả các dạng bệnh lao và phơi nhiễm đều cần được đánh giá và điều trị kịp thời.';
MERGE (n:Disease {id: 'D0908'}) SET n.id = 'D0908', n.name = 'Rối loạn phân ly', n.name_en = 'Dissociative disorders', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/dissociative-disorders/symptoms-causes/syc-20355215', n.overview = 'là tình trạng sức khỏe tâm thần liên quan đến việc mất kết nối giữa suy nghĩ, ký ức, cảm xúc, môi trường xung quanh, hành vi và bản sắc. Những tình trạng này bao gồm việc trốn chạy khỏi thực tế theo n', n.when_to_see = 'Đôi khi các triệu chứng rối loạn phân ly xảy ra trong cơn khủng hoảng với hành vi nghiêm trọng hoặc bốc đồng. Những người có những triệu chứng này cần được chăm sóc khẩn cấp hơn và cần được chăm sóc t';
MERGE (n:Disease {id: 'D0909'}) SET n.id = 'D0909', n.name = 'Rối loạn chức năng dây thần kinh giữa ở phần xa', n.name_en = 'Distal median nerve dysfunction', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000691.htm', n.prognosis = 'Nếu nguyên nhân của rối loạn chức năng thần kinh có thể được xác định và điều trị thì rất có khả năng phục hồi hoàn toàn. Trong một số trường hợp, mất một phần hoặc hoàn toàn khả năng vận động hoặc cả', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng rối loạn chức năng thần kinh giữa ở phần xa. Chẩn đoán và điều trị sớm làm tăng cơ hội chữa khỏi hoặc kiểm soát các triệu chứng.';
MERGE (n:Disease {id: 'D0910'}) SET n.id = 'D0910', n.name = 'Nhiễm toan ở ống thận xa', n.name_en = 'Distal renal tubular acidosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000493.htm', n.prognosis = 'Chứng rối loạn này phải được điều trị để giảm tác động và biến chứng của nó, có thể là vĩnh viễn hoặc đe dọa tính mạng. Hầu hết mọi người sẽ khỏe hơn sau khi điều trị.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu bạn có các triệu chứng nhiễm toan ống thận xa. Nhận trợ giúp y tế ngay lập tức nếu bạn xuất hiện các triệu chứng khẩn cấp như: Giảm ý thức Động kinh Gi';
MERGE (n:Disease {id: 'D0911'}) SET n.id = 'D0911', n.name = 'Shunt lách xa', n.name_en = 'Distal splenorenal shunt', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007647.htm', n.overview = 'Trong DSRS, tĩnh mạch từ lá lách của bạn bị ngắt kết nối với tĩnh mạch cửa. Tĩnh mạch sau đó được gắn vào tĩnh mạch thận trái của bạn. Điều này giúp làm giảm lưu lượng máu qua tĩnh mạch cửa.', n.prognosis = 'Sau phẫu thuật DSRS, tình trạng chảy máu do giãn tĩnh mạch được kiểm soát ở hầu hết những người bị tăng áp lực tĩnh mạch cửa. Nguy cơ chảy máu trở lại cao nhất là trong tháng đầu tiên sau phẫu thuật.';
MERGE (n:Disease {id: 'D0912'}) SET n.id = 'D0912', n.name = 'Viêm túi thừa', n.name_en = 'Diverticulitis', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/diverticulitis/symptoms-causes/syc-20371758 | https://medlineplus.gov/ency/article/000257.htm', n.overview = 'Bệnh túi thừa và viêm túi thừa xảy ra khi các túi nhỏ, phồng lên (túi thừa) phát triển trong đường tiêu hóa của bạn. Khi một hoặc nhiều túi này bị viêm hoặc nhiễm trùng, tình trạng này được gọi là viê', n.prognosis = 'Thông thường, đây là một tình trạng nhẹ và đáp ứng tốt với điều trị. Một số người sẽ bị viêm túi thừa nhiều hơn một lần. Phẫu thuật có thể cần thiết trong một số trường hợp. Nhiều khi, các nhà cung cấ', n.when_to_see = 'Nhận chăm sóc y tế bất cứ khi nào bạn bị đau bụng liên tục, không rõ nguyên nhân, đặc biệt nếu bạn bị sốt và có những thay đổi đáng chú ý trong phân. Yêu cầu một cuộc hẹn Có vấn đề với
 thông tin được';
MERGE (n:Disease {id: 'D0913'}) SET n.id = 'D0913', n.name = 'Bệnh túi thừa', n.name_en = 'Diverticulosis', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007668.htm', n.prognosis = 'Hầu hết những người mắc bệnh túi thừa đều không có triệu chứng. Một khi những chiếc túi này đã hình thành, bạn sẽ có chúng suốt đời. Ít hơn 5% số người mắc bệnh này sẽ bị viêm túi thừa. Điều này xảy r', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ của bạn nếu có triệu chứng viêm túi thừa.';
MERGE (n:Disease {id: 'D0914'}) SET n.id = 'D0914', n.name = 'Chóng mặt', n.name_en = 'Dizziness', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/dizziness/symptoms-causes/syc-20371787 | https://medlineplus.gov/ency/article/003093.htm', n.overview = 'là thuật ngữ mà mọi người sử dụng để mô tả một loạt cảm giác, chẳng hạn như cảm giác ngất xỉu, choáng váng, yếu ớt hoặc loạng choạng. Cảm giác rằng bạn hoặc môi trường xung quanh bạn đang quay tròn ho', n.when_to_see = 'Nói chung, hãy đến gặp chuyên gia chăm sóc sức khỏe của bạn nếu bạn bị chóng mặt hoặc chóng mặt lặp đi lặp lại, đột ngột, nghiêm trọng hoặc kéo dài mà không có nguyên nhân rõ ràng. Nhận chăm sóc y tế ';
MERGE (n:Disease {id: 'D0915'}) SET n.id = 'D0915', n.name = 'Bác sĩ chuyên ngành y khoa (MD)', n.name_en = 'Doctor of medicine profession (MD)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/001936.htm', n.overview = 'Việc hành nghề y ở Hoa Kỳ đã có từ đầu những năm 1600. Vào đầu thế kỷ 17, hoạt động y tế ở Anh được chia thành ba nhóm: bác sĩ, bác sĩ phẫu thuật và dược sĩ. Các bác sĩ được coi là ưu tú. Họ thường có';
MERGE (n:Disease {id: 'D0916'}) SET n.id = 'D0916', n.name = 'Bác sĩ y học nắn xương', n.name_en = 'Doctor of osteopathic medicine', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/002020.htm', n.overview = 'Giống như tất cả các bác sĩ trị liệu đối chứng (hoặc MD), bác sĩ nắn xương hoàn thành 4 năm học y khoa và có thể chọn hành nghề trong bất kỳ chuyên ngành y học nào. Tuy nhiên, các bác sĩ nắn xương nhậ';
MERGE (n:Disease {id: 'D0917'}) SET n.id = 'D0917', n.name = 'Bệnh Donovanosis (u hạt inguinale)', n.name_en = 'Donovanosis (granuloma inguinale)', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/000636.htm', n.prognosis = 'Điều trị sớm giúp ngăn ngừa tổn thương mô hoặc sẹo. Nếu không được điều trị, bệnh sẽ dẫn đến tổn thương mô sinh dục.', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu: Bạn đã quan hệ tình dục với một người được biết là mắc bệnh donovanosis Bạn xuất hiện các triệu chứng của bệnh donovanosis Bạn bị lo';
MERGE (n:Disease {id: 'D0918'}) SET n.id = 'D0918', n.name = 'Vòm động mạch chủ đôi', n.name_en = 'Double aortic arch', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007316.htm', n.prognosis = 'Hầu hết trẻ em cảm thấy khỏe hơn ngay sau khi phẫu thuật, mặc dù một số trẻ có thể tiếp tục có các triệu chứng về hô hấp một thời gian sau khi phẫu thuật sửa chữa. Điều này thường xảy ra nhất là do kh', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu trẻ sơ sinh của bạn có các triệu chứng của vòm động mạch chủ đôi.';
MERGE (n:Disease {id: 'D0919'}) SET n.id = 'D0919', n.name = 'Tâm thất trái vào đôi', n.name_en = 'Double inlet left ventricle', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007327.htm', n.prognosis = 'DILV là một khuyết tật tim rất phức tạp và không dễ điều trị. Tình trạng sức khỏe của bé như thế nào tùy thuộc vào: Tình trạng chung của bé tại thời điểm chẩn đoán và điều trị. Nếu có vấn đề về tim kh', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn: Có vẻ dễ mệt mỏi Khó thở Da hoặc môi hơi xanh. Đồng thời, hãy nói chuyện với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn ';
MERGE (n:Disease {id: 'D0920'}) SET n.id = 'D0920', n.name = 'Tâm thất phải hai đường ra', n.name_en = 'Double outlet right ventricle', n.source = 'medlineplus', n.url = 'https://medlineplus.gov/ency/article/007328.htm', n.prognosis = 'Em bé hoạt động tốt như thế nào phụ thuộc vào: Kích thước và vị trí của VSD Kích thước của buồng bơm Vị trí của động mạch chủ và động mạch phổi Sự hiện diện của các biến chứng khác (chẳng hạn như hẹp ', n.when_to_see = 'Hãy liên hệ với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn nếu con bạn có vẻ dễ mệt mỏi, khó thở hoặc có da hoặc môi hơi xanh. Bạn cũng nên tham khảo ý kiến ​​của nhà cung cấp nếu em bé của bạn kh';
MERGE (n:Disease {id: 'D0921'}) SET n.id = 'D0921', n.name = 'Tử cung đôi', n.name_en = 'Double uterus', n.source = 'mayo', n.url = 'https://www.mayoclinic.org/diseases-conditions/double-uterus/symptoms-causes/syc-20352261', n.overview = 'Tử cung đôi là một tình trạng hiếm gặp xảy ra khi sinh ở một số phụ nữ. Ở bào thai nữ, tử cung ban đầu có hai ống nhỏ. Khi thai nhi lớn lên, các ống thường nối với nhau để tạo thành một cơ quan rỗng l', n.when_to_see = 'Hãy tìm tư vấn y tế nếu bạn vẫn có kinh nguyệt dù đã sử dụng băng vệ sinh. Hoặc nếu bạn bị đau dữ dội trong thời kỳ kinh nguyệt hoặc bạn bị sẩy thai nhiều lần. Yêu cầu một cuộc hẹn Có vấn đề với
 thôn';
MERGE (n:Disease {id: 'D0922'}) SET n.id = 'D0922', n.name = 'Hội chứng Down', n.name_en = 'Down syndrome', n.source = 'both', n.url = 'https://www.mayoclinic.org/diseases-conditions/down-syndrome/symptoms-causes/syc-20355977 | https://medlineplus.gov/ency/article/000997.htm', n.overview = 'Cơ sở di truyền của hội chứng Down là 23 cặp nhiễm sắc thể, tổng cộng là 46. Một nửa số nhiễm sắc thể đến từ trứng và một nửa đến từ tinh trùng. Cặp nhiễm sắc thể XY này bao gồm nhiễm sắc thể X từ trứ', n.prognosis = 'Mặc dù nhiều trẻ mắc hội chứng Down có những hạn chế về thể chất và tinh thần, nhưng các em vẫn có thể sống độc lập và có ích cho đến tuổi trưởng thành. Khoảng một nửa số trẻ mắc hội chứng Down sinh r', n.when_to_see = 'Hội chứng Down thường được chẩn đoán trước hoặc khi sinh. Nhưng nếu bạn có bất kỳ câu hỏi nào liên quan đến việc mang thai hoặc sự tăng trưởng và phát triển của con bạn, hãy nói chuyện với bác sĩ hoặc';
